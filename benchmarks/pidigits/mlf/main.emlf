-- Sequential unbounded spigot: both extract(3) and extract(4) are evaluated.
-- Arithmetic is implemented by language primitives, not a foreign pi helper.

spaces : Int -> String
spaces n = if n == 0 then "" else " " ++ spaces (n - 1)

digits : Int -> Int -> Int -> Int -> Int -> Int -> String -> IO Unit
digits wanted produced k num acc den row =
  if produced == wanted then
    if produced % 10 == 0 then return ()
    else putStrLn (row ++ spaces (10 - produced % 10) ++ "\t:" ++ showInt produced)
  else
    let
      nextK = k + 1
      twice = nextK * 2 + 1
      n = num * nextK
      a = (acc + num * 2) * twice
      d = den * twice
    in if a < n then digits wanted produced nextK n a d row
    else
      let
        q = (n * 3 + a) / d
        r = (n * 4 + a) / d
      in if q == r then
        let
          count = produced + 1
          text = row ++ showInt q
        in do
          if count % 10 == 0 then putStrLn (text ++ "\t:" ++ showInt count) else return ()
          digits wanted count nextK (n * 10) ((a - d * q) * 10) d (if count % 10 == 0 then "" else text)
      else digits wanted produced nextK n a d row

main = do
  input <- getLine
  digits (readInt input) 0 0 1 0 1 ""
