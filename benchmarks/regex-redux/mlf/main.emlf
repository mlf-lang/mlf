-- The Benchmarks Game regex-redux workload. All matching and replacement use
-- the reusable MLF regex engine, including FASTA cleanup and the five ordered
-- substitutions. The correctness oracle is a separate implementation.
module Main where
import Bootstrap.Types
import qualified Bootstrap.Std as S
import qualified Bootstrap.Regex as R

regex : String -> R.Regex
regex pattern = case R.compile pattern of
  Left message -> panic message
  Right compiled -> compiled

patterns : [] String
patterns = (:) "agggtaaa|tttaccct"
  ((:) "[cgt]gggtaaa|tttaccc[acg]"
  ((:) "a[act]ggtaaa|tttacc[agt]t"
  ((:) "ag[act]gtaaa|tttac[agt]ct"
  ((:) "agg[act]taaa|ttta[agt]cct"
  ((:) "aggg[acg]aaa|ttt[cgt]ccct"
  ((:) "agggt[cgt]aa|tt[acg]accct"
  ((:) "agggta[cgt]a|t[acg]taccct"
  ((:) "agggtaa[cgt]|[acg]ttaccct" []))))))))

substitutions : [] ((,) String String)
substitutions = (:) ((,) "tHa[Nt]" "<4>")
  ((:) ((,) "aND|caN|Ha[DS]|WaS" "<3>")
  ((:) ((,) "a[NSt]|BY" "<2>")
  ((:) ((,) "<[^>]*>" "|")
  ((:) ((,) "\\|[^|][^|]*\\|" "-") []))))

main : IO ()
main = do
  source <- getContents
  let originalLength = stringLength source
  seq originalLength (return ())
  let sequence = R.replaceAll (regex ">.*\n|\n") "" source
  let cleanedLength = stringLength sequence
  seq cleanedLength (return ())
  S.mapM_ (\pattern -> putStrLn (pattern ++ " " ++ showInt (R.countMatches (regex pattern) sequence))) patterns
  let replaced = S.foldlStrict (\text entry -> case entry of
        (,) pattern replacement -> R.replaceAll (regex pattern) replacement text) sequence substitutions
  putStrLn ""
  printInt originalLength
  printInt cleanedLength
  printInt (stringLength replaced)
