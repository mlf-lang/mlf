module Main where
import Bootstrap.Types
import qualified Bootstrap.Std as L
import qualified Bootstrap.SourceEquality as E
import qualified Bootstrap.Prelude as P
import qualified Bootstrap.Set as S

expect : Bool -> String -> IO ()
expect good label = if good then ioReturn () else panic ("prelude assertion: " ++ label)
usesPrelude : SProgram -> Bool
usesPrelude program = case P.withPrelude ImplicitPrelude program of
  (,) classes result -> S.member compareString "Monad" classes
main = do
  expect (usesPrelude (SProgram [] (SApp (SVar "return") (SIntLit 7)))) "return imports Monad"
  expect (L.not (usesPrelude (SProgram [] (SIntLit 7)))) "pure terms avoid prelude"
  expect (L.not (usesPrelude (SProgram [] (SLam "return" Nothing (SVar "return"))))) "local return shadows imported method"
  expect (L.not (usesPrelude (SClassProgram [] ((:) P.monadClass []) [] (SVar "return")))) "local Monad shadows prelude"
  expect (case P.withPrelude NoImplicitPrelude (SProgram [] (SVar "return")) of {(,) classes program -> S.null classes && E.eqSProgram program (SProgram [] (SVar "return"))}) "no implicit prelude"
  expect (usesPrelude (SProgram [] (SAnn (SVar "f") (SAnnotation [] (SQualified ((:) (SPredicate "Monad" ((:) (STVar "m") [])) []) (SArrow (STVar "a") (STVar "a"))))))) "qualified annotation imports Monad"
  expect (S.eqSet eqString (P.freeNames (SDo ((:) (SDoBind (SDefaultPattern (Just "x")) (SVar "action")) []) (SVar "x"))) (S.fromList compareString ((:) "bind" ((:) "action" [])))) "do free variable scope"
  expect (E.eqSType (SForall Flexible "a" SBottom (SArrow (STVar "a") (STVar "a"))) (SForall Flexible "a" SBottom (SArrow (STVar "a") (STVar "a")))) "structural type equality"
  expect (L.not (E.eqSType (SForall Flexible "a" SBottom (STVar "a")) (SForall Rigid "a" SBottom (STVar "a")))) "flags affect structural type equality"
  expect (L.not (E.eqSExpr (SCase (SVar "x") ((:) (SAlternative (SIntPattern 1) (SStringLit "a")) [])) (SCase (SVar "x") ((:) (SAlternative (SIntPattern 1) (SStringLit "b")) [])))) "branch body affects expression equality"
  expect (L.not (E.eqSPattern (SNestedPattern "Pair" ((:) (SDefaultPattern (Just "a")) [])) (SNestedPattern "Pair" ((:) (SDefaultPattern Nothing) [])))) "nested pattern equality"
  putStrLn "prelude-ok"
