module Main where

import Bootstrap.Types
import qualified Bootstrap.Std as L
import qualified Bootstrap.Map as M
import qualified Bootstrap.Set as S
import qualified Bootstrap.LLVM.Build as B
import qualified Bootstrap.LLVM.Codegen as C
import qualified Bootstrap.LLVM.Optimize as O

initial : B.Output
initial = B.Output 0 Nil "entry" Nil Nil M.empty M.empty S.empty M.empty S.empty S.empty S.empty M.empty true M.empty M.empty M.empty M.empty M.empty S.empty

contains : String -> String -> Bool
contains needle text = L.any (\index -> eqString needle (stringSlice text index (stringLength needle)))
  (L.range 0 (stringLength text - stringLength needle))

forceCount : List String -> Int
forceCount code = L.length (L.filter (contains "call ptr @mlf.force(") code)

assert good message = if good then putStrLn message else panic message

reuse = do
  first <- B.forceBinding (B.CGBinding "%arg" false)
  second <- B.forceBinding (B.CGBinding "%arg" false)
  lazy <- B.bindingOperand (B.CGBinding "%arg" false)
  alias <- B.forceBinding (B.CGBinding first false)
  state <- B.get
  B.cgPure (eqString first second && eqString first lazy && eqString first alias && forceCount (B.instructions state) == 1)

boundary = do
  first <- B.forceBinding (B.CGBinding "%arg" false)
  B.definition "@nested" (B.args2 "ptr %env" "ptr %arg") (B.forceBinding (B.CGBinding "%arg" false))
  after <- B.forceBinding (B.CGBinding "%arg" false)
  state <- B.get
  B.cgPure (eqString first after && forceCount (B.instructions state) == 1 && forceCount (B.definitions state) == 1)

branches = do
  B.choose "ptr" "true" (B.forceBinding (B.CGBinding "%arg" false)) (B.forceBinding (B.CGBinding "%arg" false))
  B.forceBinding (B.CGBinding "%arg" false)
  state <- B.get
  B.cgPure (forceCount (B.instructions state) == 3)

dominating = do
  first <- B.forceBinding (B.CGBinding "%arg" false)
  B.choose "ptr" "true" (B.forceBinding (B.CGBinding "%arg" false)) (B.forceBinding (B.CGBinding "%arg" false))
  after <- B.forceBinding (B.CGBinding "%arg" false)
  state <- B.get
  B.cgPure (eqString first after && forceCount (B.instructions state) == 1)

alternatives = do
  let side = XName 0 "side"
  let flag = XName 1 "flag"
  let value = XName 2 "value"
  let scope = M.fromList O.compareName (B.args3 (Pair side (B.CGBinding "%side" true))
        (Pair flag (B.CGBinding "%flag" true)) (Pair value (B.CGBinding "%value" false)))
  B.modify (B.withConstructors (M.fromList compareString (B.args2 (Pair "LeftSide" (Pair 0 0)) (Pair "RightSide" (Pair 1 0)))))
  let conditional = XEApp (XEApp (XEApp (XEPrimitive PIfThenElse) (XEVar flag)) (XEVar value)) (XEInt 0)
  let cases = B.args2 (XErasedAlternative (XConstructorPattern "LeftSide" Nil) (XEVar value))
        (XErasedAlternative (XConstructorPattern "RightSide" Nil) conditional)
  C.evaluate scope (XECase (XEVar side) cases)
  B.forceBinding (B.CGBinding "%value" false)
  state <- B.get
  B.cgPure (forceCount (B.instructions state) == 3)

check message action = case B.runBuild action initial of
  Left error -> panic error
  Right (Pair good state) -> assert good message

main = do
  check "WHNF reuse: one successful force" reuse
  check "WHNF reuse: independent definitions" boundary
  check "WHNF reuse: isolated branch paths" branches
  check "WHNF reuse: dominating branch facts" dominating
  check "WHNF reuse: isolated case paths" alternatives
