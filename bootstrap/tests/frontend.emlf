module Main where
import Bootstrap.Types
import Bootstrap.Std
import Bootstrap.Fresh
import qualified Bootstrap.Map as M
import qualified Bootstrap.Parser as P
import qualified Bootstrap.Classes as C
import qualified Bootstrap.Surface as S
import qualified Bootstrap.SourceEquality as E
import qualified Bootstrap.Unicode as U

isExpression : String -> SExpr -> Bool
isExpression source expected = case P.parseExpr "test" source of {Left _ -> false; Right actual -> E.eqSExpr actual expected}
-- Source references carry their exact scalar positions and nominal context.
sourceVar : String -> Int -> SExpr
sourceVar name column = SCallSite name (SourceSpan "main" "Main" "test" 1 column 1 (column + stringLength name)) (SVar name)
sourceString : String -> SExpr
sourceString text = SApp (SVar "$MLF.Primitive.fromString") (SApp (SPrimitive PTextToChars) (SStringLit text))
rejectExpression : String -> Bool
rejectExpression source = isLeft (P.parseExpr "test" source)
acceptProgram : String -> Bool
acceptProgram source = case P.parseProgram "test" source of {Left _ -> false; Right program -> isRight (C.lowerClasses program)}
rejectProgram : String -> Bool
rejectProgram source = case P.parseProgram "test" source of {Left _ -> true; Right program -> isLeft (C.lowerClasses program)}
int2 : Primitive -> SExpr -> SExpr -> SExpr
int2 primitive a b = SApp (SApp (SPrimitive primitive) a) b
choice : SExpr -> SExpr -> SExpr -> SExpr
choice a b c = SApp (int2 PIfThenElse a b) c
moduleTest : Bool
moduleTest = case P.parseModule "test" "module Library (f, Box(..), module Support) where\nimport qualified Support as S hiding (hidden)\ndata Box a = Box a\nf x = Box x\n" of
  Right (SourceModule path (Just name) (Just exports) imports datatypes [] [] values Nothing _) ->
    eqString path "test" && eqString name "Library" && length exports == 3 && length imports == 1 && length datatypes == 1 && length values == 1
  _ -> false
annotationTest : Bool
annotationTest = case P.parseAnnotation "exists a. forall (f : * -> *) (b >= a). f b -> a" of
  Right (SAnnotation variables ty) -> eqList eqString variables ((:) "a" []) && E.eqSType ty (SForall Flexible "f" (SBottomKind (KArrow Star Star)) (SForall Flexible "b" (STVar "a") (SArrow (STypeApp (STVar "f") (STVar "b")) (STVar "a"))))
  _ -> false
patternTest : Bool
patternTest = case P.parseExpr "test" "\\(Box (Pair x y)) -> x" of
  Right (SEquations ((:) ((,) ((:) (SNestedPattern box ((:) (SConstructorPattern pair fields) [])) []) body) [])) -> eqString box "Box" && eqString pair "Pair" && eqList (eqMaybe eqString) fields [Just "x", Just "y"] && E.eqSExpr body (sourceVar "x" 22)
  _ -> false
layoutTest : Bool
layoutTest = case P.parseProgram "test" "f x =\n  if true then\n    x\n  else\n    x\nmain = do\n  let answer = f 42\n  printInt answer\n" of
  Right (SProgram [] _) -> true
  _ -> false
surfaceTest : Bool
surfaceTest = case P.parseProgram "test" "data Option a = None | Some a\nf (Some x) = x\nf None = 0\nmain = f (Some 42)\n" of
  Left _ -> false
  Right program -> isRight (S.lowerSurface program)
recursionTest : Bool
recursionTest = case P.parseProgram "test" "f : Int -> Int\nf n = if n == 0 then 1 else f (n-1)\nmain = f 3\n" of
  Right (SProgram _ (SLetRec ((:) _ []) _)) -> true
  _ -> false
untypedRecursionTest : Bool
untypedRecursionTest = case P.parseProgram "test" "f x = f x\nmain = f 0\n" of
  Right (SProgram _ (SLetRec [((,,) name InferRecursive _)] _)) ->
    eqString name "f" && acceptProgram "f x = f x\nmain = f 0\n" && rejectProgram "f : exists a. a -> a\nf x = f x\nmain = f 0\n"
  _ -> false
methodCaptureTest : Bool
methodCaptureTest = case runFresh [] (C.instantiateMethod (M.singleton "a" (STVar "methodType0")) (SForall Flexible "b" SBottom (SArrow (STVar "b") (STVar "a")))) of
  Right (SForall _ binder _ (SArrow (STVar argument) (STVar result))) -> not (eqString binder "methodType0") && eqString binder argument && eqString result "methodType0"
  _ -> false

freshCollisionTest : Bool
freshCollisionTest = case runFresh [] (do
  first <- freshName "X1"
  freshNames 9 "unused"
  second <- freshName "X"
  freshPure ((,) first second)) of
    Right ((,) first second) -> eqString first "X10" && eqString second "X11"
    _ -> false

wideTypeCounts : Bool
wideTypeCounts = let wide = SCon "Wide" (replicate 100001 (STVar "a")) in C.typeSize wide == 100002 && C.occurrences "a" wide == 100001

cases : [] ((,) String Bool)
cases = (:) ((,) "wide type counts" wideTypeCounts) ((:) ((,) "generated name collision" freshCollisionTest) ((:) ((,) "class substitution capture" methodCaptureTest) ((:) ((,) "identity" (isExpression "\\x -> x" (SLam "x" Nothing (sourceVar "x" 7)) && isExpression "\\x->-1" (SLam "x" Nothing (SIntLit (-1))) && isExpression "\\x.-1" (SLam "x" Nothing (SIntLit (-1))))) ((:) ((,) "unicode variable" (isExpression "\\é -> é" (SLam "é" Nothing (sourceVar "é" 7)) && isExpression "λx.x" (SLam "x" Nothing (sourceVar "x" 4)))) ((:) ((,) "unicode classifiers" (U.isAlpha 233 && U.isUpper 937 && U.isLower 955 && U.isSpace 8195 && not (U.isAlpha 128013))) ((:) ((,) "nested comments" (isExpression "{- outer {- inner -} -} 42 -- tail" (SIntLit 42))) ((:) ((,) "precedence" (isExpression "x - 1 * 2" (int2 PSubInt (sourceVar "x" 1) (int2 PMulInt (SIntLit 1) (SIntLit 2))))) ((:) ((,) "conditional" (isExpression "if true then 1 else 2" (choice (SBoolLit true) (SIntLit 1) (SIntLit 2)))) ((:) ((,) "hex integer" (isExpression "0xDEAD" (SIntLit 57005))) ((:) ((,) "octal integer" (isExpression "0o177" (SIntLit 127))) ((:) ((,) "float exponent" (isExpression "1.25e2" (SDoubleLit 125.0))) ((:) ((,) "string escapes" (isExpression "\"a\\n\\x3bb\\&z\"" (sourceString "a\nλz"))) ((:) ((,) "string gap" (isExpression "\"a\\\n  \\b\"" (sourceString "ab"))) ((:) ((,) "unit" (isExpression "()" (SConstructor "()"))) ((:) ((,) "comparison non-associative" (rejectExpression "1 < 2 < 3")) ((:) ((,) "duplicate lambda parameter" (rejectExpression "\\x x -> x")) ((:) ((,) "unterminated comment" (rejectExpression "{- unfinished")) ((:) ((,) "nonfinite float" (rejectExpression "1e999")) ((:) ((,) "module grammar" moduleTest) ((:) ((,) "annotation grammar" annotationTest) ((:) ((,) "nested pattern grammar" patternTest) ((:) ((,) "layout" layoutTest) ((:) ((,) "pattern lowering" surfaceTest) ((:) ((,) "typed recursion" recursionTest) ((:) ((,) "recursive signature modes" untypedRecursionTest) ((:) ((,) "class lowering" (acceptProgram "class Describe a where { describe : a -> String }; instance Describe Int where { describe x = showInt x }; main = describe 42")) ((:) ((,) "multiparameter class" (acceptProgram "class Convert a b where { convert : a -> b }; instance Convert Int String where { convert = showInt }; main = convert 42")) ((:) ((,) "overlap rejected" (rejectProgram "class Describe a where { describe : a -> String }; instance Describe Int where { describe = showInt }; instance Describe Int where { describe = showInt }; main = describe 42")) ((:) ((,) "missing method rejected" (rejectProgram "class Describe a where { describe : a -> String }; instance Describe Int where { }; main = 42")) ((:) ((,) "cyclic superclass rejected" (rejectProgram "class B a => A a where { getA : a -> a }; class A a => B a where { getB : a -> a }; main = 42")) ((:) ((,) "nondecreasing context rejected" (rejectProgram "class C a where { get : a -> a }; instance forall a. C (Box a) => C (Box a) where { get x = x }; data Box a = Box a; main = 42")) ([]))))))))))))))))))))))))))))))))
runCases : [] ((,) String Bool) -> IO ()
runCases tests = case tests of
  [] -> putStrLn "frontend: 32 checks passed"
  (:) ((,) name success) rest -> if success then runCases rest else do {putErr ("frontend failure: " ++ name ++ "\n"); exitWith 1}
main = runCases cases
