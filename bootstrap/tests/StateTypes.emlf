module Main where
import Bootstrap.Types
import qualified Bootstrap.Std as L
import qualified Bootstrap.Compiler as C
import qualified Bootstrap.X.Pretty as XP
import qualified Bootstrap.X.Parser as Parser
import qualified Bootstrap.X.Check as Check
import qualified Bootstrap.X.Type as T
import qualified Bootstrap.X.Syntax as X

fixtures : List (Pair String String)
fixtures = (Cons (Pair "return" "runST (stReturn 42)") (Cons (Pair "bind" "runST (stBind (stReturn 4) (\\n -> stReturn (n + 3)))") (Cons (Pair "array-read" "runST (stBind (newSTArray 2 42) (\\a -> readSTArray a 1))") (Cons (Pair "array-write" "runST (stBind (newSTArray 2 0) (\\a -> stBind (writeSTArray a 1 42) (\\_ -> readSTArray a 1)))") (Cons (Pair "array-length" "runST (stBind (newSTArray 3 true) lengthSTArray)") (Cons (Pair "implicit-do" "action : forall s. ST s Int\naction = do { a <- newSTArray 2 0; writeSTArray a 1 42; readSTArray a 1 }\nmain = runST action") (Cons (Pair "implicit-return" "action : forall s. ST s Int\naction = do { a <- newSTArray 2 0; n <- readSTArray a 1; return n }\nmain = runST action") (Cons (Pair "explicit-action-signature" "let action : forall s. ST s Int = stBind (newSTArray 2 0) (\\array -> stBind (writeSTArray array 1 37) (\\_ -> readSTArray array 1)) in runST action") (Cons (Pair "polymorphic-result" "runST (stReturn ((\\x -> x) : forall a. a -> a))") (Cons (Pair "impredicative-array-functions" "data Pair a b = Pair a b; runST (stBind (newSTArray 1 ((\\x -> x) : forall a. a -> a)) (\\array -> stBind (readSTArray array 0) (\\(f : forall a. a -> a) -> stReturn (Pair (f 42) (f true)))))") (Cons (Pair "nested-independent" "runST (stBind (newSTArray 1 3) (\\a -> stBind (readSTArray a 0) (\\x -> stReturn (x + runST (stBind (newSTArray 1 4) (\\b -> readSTArray b 0))))))") (Cons (Pair "reuse-independent-allocation" "let alloc = newSTArray 1 9 in runST (stBind alloc (\\a -> readSTArray a 0)) + runST (stBind alloc (\\a -> readSTArray a 0))") (Cons (Pair "pure-io-description-result" "runST (stReturn (putStrLn \"safe description\"))") (Cons (Pair "unused-poisoned-cell" "runST (stBind (newSTArray 1 (panic \"unused\")) lengthSTArray)") (Cons (Pair "snapshot" "runST (stBind (newSTArray 1 1) (\\a -> stBind (readSTArray a 0) (\\old -> stBind (writeSTArray a 0 2) (\\_ -> stReturn old))))") (Cons (Pair "repeated-read-action" "runST (stBind (newSTArray 1 1) (\\a -> let read = readSTArray a 0 in stBind read (\\x -> stBind (writeSTArray a 0 2) (\\_ -> stBind read (\\y -> stReturn (x + y))))))") (Cons (Pair "higher-order-runner" "let runner : forall a. (forall s. ST s a) -> a = runST in runner (stReturn 7)") (Cons (Pair "primitive-shadowing" "let runST = \\x -> x in runST 7") (Cons (Pair "qualified-prelude-import" "module Main where\nimport qualified Prelude as P\nmain = P.runST (P.stBind (P.newSTArray 1 8) (\\a -> P.readSTArray a 0))") (Cons (Pair "explicit-prelude-types" "module Main where\nimport Prelude (Int, ST, STArray, runST, stBind, newSTArray, readSTArray)\naction : forall s. ST s Int\naction = stBind (newSTArray 1 7) (\\a -> readSTArray a 0)\nmain = runST action") (Cons (Pair "opaque-existential-package" "data Hidden = Hidden ((forall t. STArray t Int -> Int) -> Int); runST (stBind (newSTArray 1 0) (\\a -> stReturn (Hidden (\\(f : forall t. STArray t Int -> Int) -> f a))))") (Cons (Pair "opaque-parametric-callback" "runST (stBind (newSTArray 1 0) (\\a -> stReturn (\\(f : forall t. STArray t Int -> Int) -> f a)))") (Cons (Pair "escape-array" "runST (newSTArray 1 0)") (Cons (Pair "escape-through-bind" "runST (stBind (newSTArray 1 0) (\\a -> stReturn a))") (Cons (Pair "escape-through-data" "data Box a = Box a; runST (stBind (newSTArray 1 0) (\\a -> stReturn (Box a)))") (Cons (Pair "escape-read-action" "runST (stBind (newSTArray 1 0) (\\a -> stReturn (readSTArray a 0)))") (Cons (Pair "escape-write-action" "runST (stBind (newSTArray 1 0) (\\a -> stReturn (writeSTArray a 0 1)))") (Cons (Pair "escape-reader-closure" "runST (stBind (newSTArray 1 0) (\\a -> stReturn (\\i -> readSTArray a i)))") (Cons (Pair "nested-read-outer-region" "runST (stBind (newSTArray 1 0) (\\a -> stReturn (runST (readSTArray a 0))))") (Cons (Pair "nested-write-outer-region" "runST (stBind (newSTArray 1 0) (\\a -> stReturn (runST (writeSTArray a 0 1))))") (Cons (Pair "cross-region-read-signature" "let cross : forall s t. STArray s Int -> ST t Int = \\a -> readSTArray a 0 in 0") (Cons (Pair "cross-region-write-signature" "let cross : forall s t. STArray s Int -> ST t Unit = \\a -> writeSTArray a 0 1 in 0") (Cons (Pair "monomorphic-argument" "runST (stReturn 7 : ST Int Int)") (Cons (Pair "monomorphic-bound-argument" "(\\(action : ST Int Int) -> runST action) (stReturn 7)") (Cons (Pair "monomorphic-runner-signature" "let runner : forall s a. ST s a -> a = runST in 0") (Cons (Pair "io-as-st" "runST (ioReturn 7)") (Cons (Pair "bind-io-action" "stBind (putStrLn \"bad\") (\\_ -> stReturn 7)") (Cons (Pair "bind-io-continuation" "stBind (stReturn 7) (\\n -> printInt n)") (Cons (Pair "io-bind-st-action" "ioBind (stReturn 7) (\\n -> printInt n)") (Cons (Pair "io-array-as-st-array" "\\(a : IntArray) -> readSTArray a 0") (Cons (Pair "wrong-array-value-type" "runST (stBind (newSTArray 1 0) (\\a -> stBind (writeSTArray a 0 true) (\\_ -> readSTArray a 0)))") (Cons (Pair "polymorphic-reference-attack" "runST (stBind (newSTArray 1 (\\x -> x)) (\\a -> stBind (writeSTArray a 0 (\\x -> x + 1)) (\\_ -> stBind (readSTArray a 0) (\\f -> stReturn (f true)))))") (Cons (Pair "impredicative-reference-attack" "runST (stBind (newSTArray 1 ((\\x -> x) : forall a. a -> a)) (\\a -> stBind (writeSTArray a 0 (\\x -> x + 1)) (\\_ -> stBind (readSTArray a 0) (\\(f : forall a. a -> a) -> stReturn (f true)))))") (Cons (Pair "repackage-action-as-region-polymorphic" "runST (stBind (newSTArray 1 0) (\\a -> stReturn ((readSTArray a 0) : forall s. ST s Int)))") (Cons (Pair "existential-coercion-escape" "runST (stBind (newSTArray 1 (panic \"poly\")) (\\a -> stReturn (a : exists t. STArray t Int)))") (Cons (Pair "opaque-package-read-attack" "let hidden = runST (stBind (newSTArray 1 0) (\\a -> stReturn (\\(f : forall t. STArray t Int -> Int) -> f a))) in hidden (\\a -> runST (readSTArray a 0))") (Cons (Pair "opaque-package-write-attack" "let hidden = runST (stBind (newSTArray 1 0) (\\a -> stReturn (\\(f : forall t. STArray t Int -> Int) -> f a))) in hidden (\\a -> seq (runST (writeSTArray a 0 1)) 0)") (Cons (Pair "redefine-st" "data ST s a = Forge a; 0") (Cons (Pair "redefine-array" "data STArray s a = Forge a; 0") (Cons (Pair "construct-opaque-st" "ST 7") (Cons (Pair "construct-opaque-array" "STArray 7") (Cons (Pair "pattern-opaque-st" "case stReturn 7 of ST x -> x") (Cons (Pair "st-wrong-arity" "panic \"unused\" : ST Int") (Cons (Pair "array-wrong-arity" "panic \"unused\" : STArray Int") (Cons (Pair "st-region-wrong-kind" "panic \"unused\" : ST IO Int") (Cons (Pair "array-element-wrong-kind" "panic \"unused\" : STArray Int IO") Nil))))))))))))))))))))))))))))))))))))))))))))))))))))))))

verify result = do
  parsed <- Parser.parseTerm "<roundtrip>" (XP.prettyTerm (C.compiledTerm result))
  ty <- Check.checkClosed parsed
  if L.not (T.alphaEq ty (C.inferredType result)) then Left "xMLF roundtrip changed type"
  else if L.not (X.equalErased (X.erase parsed) (X.erase (C.compiledTerm result))) then Left "xMLF roundtrip changed erasure"
  else Right (C.sourceType result)
report : Pair String String -> IO Unit
report (Pair name source) = putStrLn (name ++ "\t" ++ (case C.compile "<fixture>" source of
  Left err -> "REJECT\t" ++ C.prettyPhase (C.phase err)
  Right result -> case verify result of
    Left err -> "FAILED\t" ++ err
    Right ty -> "ACCEPT\t" ++ ty))
targetFixtures : List (Pair String String)
targetFixtures = (Cons (Pair "rank2-runner" "primitive runST(Int)") (Cons (Pair "monomorphic-action-value" "primitive stReturn(Int, Int) 7") (Cons (Pair "rank2-region-action" "primitive runST(Int) (/\\(a1 >= bot) -> primitive stReturn(a1, Int) 7)") (Cons (Pair "monomorphic-runST-input" "primitive runST(Int) (primitive stReturn(Int, Int) 7)") (Cons (Pair "outer-forall-cannot-replace-inner" "/\\(a1 >= bot) -> \\(action_1 : ST a1 Int) -> primitive runST(Int) action_1") (Cons (Pair "io-to-st-cast" "primitive runST(Int) (/\\(a1 >= bot) -> primitive ioReturn(Int) 7)") (Cons (Pair "cross-region-read" "/\\(a1 >= bot) -> /\\(a2 >= bot) -> \\(array_1 : STArray a1 Int) -> primitive readSTArray(a2, Int) array_1 0") (Cons (Pair "cross-region-write" "/\\(a1 >= bot) -> /\\(a2 >= bot) -> \\(array_1 : STArray a1 Int) -> primitive writeSTArray(a2, Int) array_1 0 1") (Cons (Pair "unbound-region" "primitive stReturn(a999, Int) 7") (Cons (Pair "runST-extra-type-argument" "primitive runST(Int, Int)") (Cons (Pair "higher-kind-region" "primitive stReturn(IO, Int) 7") (Cons (Pair "unexecuted-array-action" "primitive readSTArray(Int, Int) (primitive newSTArray(Int, Int) 1 0) 0") Nil))))))))))))
reportTarget : Pair String String -> IO Unit
reportTarget (Pair name source) = putStrLn ("target-" ++ name ++ "\t" ++ (case Parser.parseTerm "<target>" source of
  Left error -> "PARSE\t" ++ error
  Right term -> case Check.checkClosed term of
    Left error -> "REJECT"
    Right ty -> "ACCEPT"))
main = do { L.mapM_ report fixtures; L.mapM_ reportTarget targetFixtures }
