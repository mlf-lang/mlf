module Main where
import Bootstrap.Types
import qualified Bootstrap.Std as L
import qualified Bootstrap.IntMap as IM
import qualified Bootstrap.Graph as G
import qualified Bootstrap.Graph.Solver as Solver

list2 : forall a. a -> a -> List a
list2 a b = Cons a (Cons b Nil)
list3 : forall a. a -> a -> a -> List a
list3 a b c = Cons a (Cons b (Cons c Nil))
list4 : forall a. a -> a -> a -> a -> List a
list4 a b c d = Cons a (Cons b (Cons c (Cons d Nil)))
list5 : forall a. a -> a -> a -> a -> a -> List a
list5 a b c d e = Cons a (Cons b (Cons c (Cons d (Cons e Nil))))

smallGraphs : List Graph
smallGraphs =
  L.concatMap (\top ->
    L.concatMap (\left ->
      L.concatMap (\right ->
        L.concatMap (\parent ->
          L.concatMap (\leftParent ->
            L.concatMap (\rightParent ->
              L.map (\aliases -> Graph (IM.fromList
                (list4 (Pair 0 (Node (GGen 1) Nothing Flexible))
                  (Pair 1 (Node top parent Flexible))
                  (Pair 2 (Node left leftParent Flexible))
                  (Pair 3 (Node right rightParent Rigid)))) aliases 6)
                (list2 IM.empty (IM.fromList (list2 (Pair 5 4) (Pair 4 2)))))
              (list5 Nothing (Just 0) (Just 1) (Just 2) (Just 9)))
            (list5 Nothing (Just 0) (Just 1) (Just 3) (Just 9)))
          (list3 Nothing (Just 0) (Just 2)))
        (list4 GBot (GTyCon "G" (KArrow Star Star)) (GArr 2 2) (GArr 9 9)))
      (list4 GBot (GTyCon "F" (KArrow Star Star)) (GArr 3 3) (GGen 3)))
    (list5 (GArr 2 3) (GArr 2 2) (GTyApp 2 3) (GCon "Pair" (list2 2 3)) (GArr 5 3))

variants : Graph -> List Graph
variants graph = L.concatMap (\a -> L.concatMap (\b -> L.map (\c ->
  Graph (IM.mapWithKey (\n -> \node -> Node (G.tag node) (G.binder node)
    (if n == 1 then a else if n == 2 then b else if n == 3 then c else G.flag node)) (G.nodes graph)) (G.links graph) (G.nextId graph)) (list2 Flexible Rigid)) (list2 Flexible Rigid)) (list2 Flexible Rigid)

equations : List (List (Pair Int Int))
equations = L.append
  (list5 Nil (Cons (Pair 1 2) Nil) (Cons (Pair 1 3) Nil) (Cons (Pair 2 3) Nil) (Cons (Pair 2 2) Nil))
  (list4 (Cons (Pair 0 1) Nil) (list2 (Pair 1 2) (Pair 2 3)) (list2 (Pair 2 3) (Pair 1 2)) (list2 (Pair 3 2) (Pair 2 1)))

showKind : Kind -> String
showKind kind = case kind of
  Star -> "*"
  KArrow a b -> "(" ++ showKind a ++ ">" ++ showKind b ++ ")"
showTag : GTag -> String
showTag t = case t of
  GBot -> "b"
  GBotK k -> "k" ++ showKind k
  GArr a b -> "a" ++ showInt a ++ "," ++ showInt b
  GCon c xs -> "c" ++ c ++ "[" ++ L.intercalate "," (L.map showInt xs) ++ "]"
  GTyCon c k -> "t" ++ c ++ showKind k
  GSkolem n k -> "s" ++ showInt n ++ showKind k
  GTyApp a b -> "p" ++ showInt a ++ "," ++ showInt b
  GGen n -> "g" ++ showInt n
showNode : Pair Int Node -> String
showNode (Pair n v) = showInt n ++ ":" ++ showTag (G.tag v) ++ ":" ++
  (case G.binder v of { Nothing -> "_"; Just b -> showInt b }) ++ ":" ++
  (case G.flag v of { Flexible -> "f"; Rigid -> "r" }) ++ ";"
showGraph : Graph -> String
showGraph graph = L.concatStrings (L.map showNode (IM.toList (G.nodes graph))) ++ "|" ++
  L.concatStrings (L.map (\entry -> case entry of { Pair n p -> showInt n ++ ":" ++ showInt p ++ ";" }) (IM.toList (G.links graph))) ++ "|" ++ showInt (G.nextId graph)

sameGraph : Graph -> Graph -> Bool
sameGraph a b = G.nextId a == G.nextId b && IM.eqIntMap G.equalNode (G.nodes a) (G.nodes b) && IM.eqIntMap (\x -> \y -> x == y) (G.links a) (G.links b)

forEachIO : forall a. (a -> IO Unit) -> List a -> IO Unit
forEachIO action items = case items of
  Nil -> ioReturn Unit
  Cons item rest -> ioBind (action item) (\ignored -> forEachIO action rest)

emitValidation : Graph -> IO Unit
emitValidation graph = putStr (case G.validateGraph graph of { Left error -> "x"; Right unit -> "v" })

emitUnification : Graph -> List (Pair Int Int) -> IO Unit
emitUnification graph eqs =
  let incremental = G.bindE (Solver.prepare graph) (\solver -> G.bindE (Solver.solverUnify eqs solver) Solver.finish) in
  case G.unify eqs graph of
    Left error -> case incremental of
      Left reason -> putStrLn "!"
      Right accepted -> panic ("incremental accepted rejected graph: " ++ showGraph graph)
    Right full -> case incremental of
      Left reason -> panic ("incremental rejected graph: " ++ reason ++ ": " ++ showGraph graph)
      Right compact -> if sameGraph full compact then putStrLn (showGraph full) else panic ("incremental differs: " ++ showGraph full ++ " / " ++ showGraph compact)

isValid : Graph -> Bool
isValid graph = case G.validateGraph graph of { Left error -> false; Right unit -> true }

main = do
  forEachIO emitValidation smallGraphs
  putStrLn ""
  forEachIO (\graph -> forEachIO (emitUnification graph) equations) (L.concatMap variants (L.filter isValid smallGraphs))
