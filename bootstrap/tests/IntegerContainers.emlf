module Main where
import Bootstrap.Types
import qualified Bootstrap.Std as L
import qualified Bootstrap.IntMap as IM
import qualified Bootstrap.IntSet as IS

-- Scalar arithmetic and an ordered association list are independent of the
-- specialized lookup/update workers. Both tagged and GMP-backed Int ranges
-- take part in the same mixed update sequence.
edgeKeys : List Int
edgeKeys = L.concatMap (\center -> L.map (\offset -> center + offset) (L.range (-2) 2))
  (Cons (-1267650600228229401496703205376)
  (Cons (-9223372036854775808)
  (Cons (-4611686018427387904)
  (Cons 0
  (Cons 4611686018427387904
  (Cons 9223372036854775808
  (Cons 1267650600228229401496703205376 Nil)))))))

expect : Bool -> String -> IO Unit
expect condition message = if condition then pure Unit else panic message

oracleLookup : Int -> List (Pair Int Int) -> Maybe Int
oracleLookup key entries = case entries of
  Nil -> Nothing
  Cons (Pair k v) rest -> if key == k then Just v else oracleLookup key rest

oraclePut : (Int -> Int -> Int -> Int) -> Int -> Int -> List (Pair Int Int) -> List (Pair Int Int)
oraclePut combine key value entries = case entries of
  Nil -> Cons (Pair key value) Nil
  Cons (Pair k v) rest ->
    if key < k then Cons (Pair key value) entries
    else if key == k then Cons (Pair key (combine key value v)) rest
    else Cons (Pair k v) (oraclePut combine key value rest)

oracleDelete : Int -> List (Pair Int Int) -> List (Pair Int Int)
oracleDelete key entries = case entries of
  Nil -> Nil
  Cons (Pair k v) rest -> if key == k then rest else Cons (Pair k v) (oracleDelete key rest)

equalBool : Bool -> Bool -> Bool
equalBool a b = if a then b else L.not b

matches : IntMap Int -> List (Pair Int Int) -> Int -> Bool
matches actual expected key =
  let want = oracleLookup key expected in
  L.eqMaybe eqInt (IM.lookup key actual) want &&
  equalBool (IM.member key actual) (L.isJust want) &&
  equalBool (IM.notMember key actual) (L.isNothing want) &&
  IM.findWithDefault 987654321 key actual == L.fromMaybe 987654321 want

steps : Int -> Int -> IntMap Int -> IntSet -> List (Pair Int Int) -> Bool
steps remaining seed actual keys expected = if remaining <= 0 then true else
  let key = L.index edgeKeys (seed % L.length edgeKeys) in
  let value = seed * 3 - 101 in
  let operation = seed % 4 in
  let next = if operation == 0 then IM.delete key actual else
        if operation == 1 then IM.insert key value actual else
        if operation == 2 then IM.insertWith subInt key value actual else
        IM.insertWithKey (\k fresh old -> k + fresh - old) key value actual in
  let want = if operation == 0 then oracleDelete key expected else
        oraclePut (\k fresh old -> if operation == 1 then fresh else if operation == 2 then fresh - old else k + fresh - old) key value expected in
  let nextKeys = if operation == 0 then IS.delete key keys else IS.insert key keys in
  let nextSeed = (seed * 1103515245 + 12345) % 2147483648 in
  IM.valid next && L.eqList (L.eqPair eqInt eqInt) (IM.toList next) want &&
  L.eqList eqInt (IM.elems next) (L.map L.snd want) &&
  L.eqList eqInt (IS.toList nextKeys) (L.map L.fst want) &&
  L.all (matches next want) (L.append edgeKeys (Cons (key + 1) (Cons (key - 1) Nil))) &&
  L.all (\probe -> equalBool (IS.member probe nextKeys) (L.isJust (oracleLookup probe want))) edgeKeys &&
  steps (remaining - 1) nextSeed next nextKeys want

-- These insertion orders force single-right, double-right, single-left,
-- and double-left rotations respectively. Every prefix also checks cached
-- sizes, ordering and balance; the association-list oracle is independent.
rotationPrefixes : List Int -> IntMap Int -> List (Pair Int Int) -> Bool
rotationPrefixes order tree oracle = case order of
  Nil -> true
  Cons key rest ->
    let next = IM.insert key (key * 7) tree in
    let expected = oraclePut (\k fresh old -> fresh) key (key * 7) oracle in
    IM.valid next && L.eqList (L.eqPair eqInt eqInt) (IM.toList next) expected &&
      rotationPrefixes rest next expected

rotationCase : Int -> Int -> Int -> Int -> Bool
rotationCase offset first second third =
  let order = L.map (\key -> offset + key) (Cons first (Cons second (Cons third Nil))) in
  let tree = IM.fromList (L.map (\key -> Pair key (key * 7)) order) in
  rotationPrefixes order IM.empty Nil &&
  (case tree of { IntMap raw -> case raw of { MapEmpty -> false; MapNode count key value left right -> count == 3 && key == offset + 2 } })

rotationCases : Int -> Bool
rotationCases offset = rotationCase offset 3 2 1 && rotationCase offset 3 1 2 &&
  rotationCase offset 1 2 3 && rotationCase offset 1 3 2

data Link = Link (IntMap Link)
recursiveValues : IntMap Link
recursiveValues = IM.insert 1 (Link recursiveValues) (IM.singleton 2 (Link recursiveValues))

semantics = do
  let partial = IntMap (MapNode 1 42 (panic "traversal demanded value") MapEmpty (panic "traversal demanded right branch"))
  expect (L.head (IM.keys partial) == 42) "keys retains lazy tail and stored value"
  expect (L.fst (L.head (IM.toList partial)) == 42) "toList retains lazy tail and stored value"
  expect (L.length (L.take 1 (IM.elems partial)) == 1) "elems retains lazy tail and stored value"
  expect (IM.valid IM.empty && IM.size IM.empty == 0) "empty balance"
  let one = IM.singleton 1 (panic "singleton forced a value")
  expect (IM.valid one && IM.size one == 1) "singleton balance keeps values lazy"
  expect (IM.valid (IM.insert 0 (panic "left insertion forced a value") one) && IM.valid (IM.insert 2 (panic "right insertion forced a value") one)) "one-child balance keeps values lazy"
  expect (rotationCases 0 && rotationCases 1267650600228229401496703205376 && rotationCases (-1267650600228229401496703205376)) "all rotation branches and unbounded keys"
  expect (steps 1200 17 IM.empty IS.empty Nil) "specialized integer containers differ from association-list oracle"
  expect (IM.valid (IM.fromList (L.map (\key -> Pair key key) edgeKeys))) "ascending large-key map"
  expect (IM.valid (IM.fromList (L.map (\key -> Pair key key) (L.reverse edgeKeys)))) "descending large-key map"
  expect (IS.size (IS.fromList (L.append edgeKeys edgeKeys)) == L.length edgeKeys) "set fromList duplicates"
  let duplicates = Cons (Pair 1 10) (Cons (Pair 1 20) (Cons (Pair 1 30) Nil))
  expect (IM.get 1 (IM.fromList duplicates) == 30) "fromList last key wins"
  expect (IM.get 1 (IM.fromListWith subInt duplicates) == 20) "fromListWith new old order"
  let lazy = IM.singleton 1 (panic "forced stored value")
  expect (IM.size lazy == 1 && IM.member 1 lazy && IM.notMember 2 lazy) "member and size do not demand values"
  expect (IM.size (IM.insertWith (\new old -> panic "forced combination") 1 42 lazy) == 1) "insertWith combination stays lazy"
  expect (IM.size (IM.insertWithKey (\key new old -> panic "forced keyed combination") 1 42 lazy) == 1) "insertWithKey combination stays lazy"
  expect (IM.get 1 (IM.insert 1 42 lazy) == 42) "insert discards old value"
  expect (IM.get 1 (IM.insertWith (\new old -> new) 1 42 lazy) == 42) "insertWith may discard old value"
  expect (IM.size (IM.delete 1 lazy) == 0) "delete does not demand removed value"
  expect (case IM.lookup (panic "empty lookup forced key") IM.empty of { Nothing -> true; Just _ -> false }) "empty lookup leaves key lazy"
  expect (L.not (IM.member (panic "empty map member forced key") IM.empty)) "empty map member leaves key lazy"
  expect (L.not (IS.member (panic "empty set member forced key") IS.empty)) "empty set member leaves key lazy"
  expect (IM.null (IM.delete (panic "empty delete forced key") IM.empty)) "empty delete leaves key lazy"
  expect (IM.findWithDefault (panic "found lookup forced fallback") 1 (IM.singleton 1 42) == 42) "unused fallback stays lazy"
  expect (case IM.get 1 recursiveValues of { Link tree -> IM.size tree == 2 }) "recursive values stay lazy"
  putStrLn "integer containers: 1200 mixed updates and unbounded-key/laziness checks passed"


main = semantics
