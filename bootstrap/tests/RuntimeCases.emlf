module Main where
import Bootstrap.Types
import Bootstrap.Std
import qualified Bootstrap.Runtime as R
import qualified Bootstrap.Data as D

runtimeData = case D.validateDeclarations [] of
  Left message -> panic message
  Right value -> value
evaluate term = R.evaluate runtimeData (R.REnv MapEmpty) term
erasedCall primitive arguments = foldl XEApp (XEPrimitive primitive) arguments
poison message = erasedCall PPanic ((:) (XEString message) [])
expectInteger expected term = case R.integer (evaluate term) of
  Right value -> if value == expected then return () else panic "direct primitive returned a different value"
  Left message -> panic message
expectError expected term = case evaluate term of
  Left message -> if eqString message expected then return () else panic ("direct primitive changed error: " ++ message)
  Right value -> panic "direct primitive lost its error"
primitiveApplications = do
  expectInteger 2 (erasedCall PStringLength ((:) (XEString "λ😀") []))
  expectInteger 7 (erasedCall PAddInt ((:) (XEInt 3) ((:) (XEInt 4) [])))
  expectInteger 11 (erasedCall PIfThenElse ((:) (XEBool true) ((:) (XEInt 11) ((:) (poison "unused branch") []))))
  expectInteger 13 (erasedCall PIfThenElse ((:) (XEBool false) ((:) (poison "unused branch") ((:) (XEInt 13) []))))
  let argument = XName 91 "argument"
  let identity = XEAbs argument (XEVar argument)
  expectInteger 17 (XEApp (erasedCall PSeq ((:) identity ((:) identity []))) (XEInt 17))
  expectError "first argument" (erasedCall PAddInt ((:) (poison "first argument") ((:) (poison "second argument") [])))
  expectError "direct panic" (XEApp (poison "direct panic") (XEInt 0))
  expectError "runtime application of a non-function" (erasedCall PShowInt ((:) (XEInt 3) ((:) (XEInt 4) [])))
  expectError "runtime application of a non-function" (erasedCall PGetArgCount ((:) (XEInt 0) []))
  case evaluate (erasedCall PAddInt ((:) (XEInt 19) [])) of
    Left message -> panic message
    Right partial -> case R.integer (R.apply runtimeData partial (Right (R.RInteger 23))) of
      Right value -> if value == 42 then return () else panic "partial primitive lost its captured argument"
      Left message -> panic message

intType = XCon "Int" []
unitType = XCon "()" []
ioUnit = XCon "IO" ((:) unitType [])
arrayType = XCon "IntArray" []
apps f xs = foldl XApp f xs
prim p xs = apps (XPrimitive p []) xs
integer n = XIntTerm n
print n = XApp (XPrimitive PPrintInt []) n
ret = XApp (XPrimitive PIOReturn ((:) unitType [])) (XConstructor "()" [])
thenIO a b = apps (XPrimitive PIOBind ((:) unitType ((:) unitType []))) ((:) a ((:) (XAbs (XName 900 "ignored") unitType b) []))
bindIO ty name a b = apps (XPrimitive PIOBind ((:) ty ((:) unitType []))) ((:) a ((:) (XAbs name ty b) []))
condition c a b = apps (XPrimitive PIfThenElse ((:) ioUnit [])) ((:) c ((:) a ((:) b [])))

lazyCase = XCase (XApp (XPrimitive PPanic ((:) intType [])) (XStringTerm "unforced")) ioUnit
  ((:) (XAlternative (XDefaultPattern Nothing) (XApp (XPrimitive PPutStrLn []) (XStringTerm "lazy"))) [])

countName = XName 1 "count"
nName = XName 2 "n"
countBody = XAbs nName intType
  (condition (prim PEqInt ((:) (XVarTerm nName) ((:) (integer 0) []))) ret
    (thenIO (print (XVarTerm nName))
      (XApp (XVarTerm countName) (prim PSubInt ((:) (XVarTerm nName) ((:) (integer 1) []))))))
recursive = XLetRec ((:) ((,,) countName (XArrow intType ioUnit) countBody) [])
  (XApp (XVarTerm countName) (integer 3))

arrayName = XName 3 "array"
entryName = XName 4 "entry"
arrayProgram = bindIO arrayType arrayName (prim PNewIntArray ((:) (integer 2) ((:) (integer 3) [])))
  (thenIO (prim PWriteIntArray ((:) (XVarTerm arrayName) ((:) (integer 0) ((:) (integer 9) []))))
    (bindIO intType entryName (prim PReadIntArray ((:) (XVarTerm arrayName) ((:) (integer 0) []))) (print (XVarTerm entryName))))

run program = do
  result <- R.runTerm program
  case result of
    Left message -> panic message
    Right unit -> return ()

main = do
  primitiveApplications
  run (print (integer 42))
  putStrLn "ok"
  run lazyCase
  run recursive
  run arrayProgram
  result <- R.runTerm (integer 1)
  case result of
    Left message -> putStrLn message
    Right unit -> panic "pure IO entry accepted"
  result <- R.runTerm (XApp (XPrimitive PPrintInt []) (prim PQuotInt ((:) (integer 1) ((:) (integer 0) []))))
  case result of
    Left message -> putStrLn message
    Right unit -> panic "division by zero accepted"
