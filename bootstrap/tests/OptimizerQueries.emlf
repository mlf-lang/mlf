module Main where

import Bootstrap.Types
import qualified Bootstrap.Std as L
import qualified Bootstrap.LLVM.Optimize as O
import qualified Bootstrap.X.Syntax as X

assert : Bool -> String -> IO Unit
assert good message = if good then ioReturn Unit else do
  putErr ("optimizer queries: " ++ message ++ "\n")
  exitWith 1

name n = XName n "reused"
pair a b = XEApp (XEApp (XEConstructor "Pair") a) b

function nodes = L.foldr (\n b -> XEAbs (name n) b) (XEVar (name 1)) (L.range 1 (nodes - 1))

lets : XErased -> Int
lets expression = case expression of
  XEAbs n b -> lets b
  XEApp f a -> lets f + lets a
  XELet n a b -> 1 + lets a + lets b
  XELetRec ds b -> L.length ds + L.sum (L.map (\entry -> case entry of Pair n a -> lets a) ds) + lets b
  XECase a branches -> lets a + L.sum (L.map (\branch -> case branch of XErasedAlternative p b -> lets b) branches)
  _ -> 0

checkSize nodes =
  let f = name 100 in
  let term = XELet f (function nodes) (pair (XEVar f) (XEVar f)) in
  assert (lets (O.optimize term) == (if nodes <= 24 then 0 else 1)) "inclusive lambda size boundary"

checkUses uses =
  let f = name 100 in
  let body = L.foldr pair (XEInt 42) (L.replicate uses (XEVar f)) in
  assert (lets (O.optimize (XELet f (function 80) body)) == (if uses <= 1 then 0 else 1)) "zero, one, and multiple lambda uses"

main = do
  L.mapM_ checkSize (L.range 20 28)
  L.mapM_ checkUses (L.range 0 5)
  let n = name 0
  let shadowed = XELet n (XEApp (XEConstructor "Keep") (XEInt 19)) (XELet n (XEInt 42) (XEVar n))
  assert (X.equalErased (O.optimize shadowed) (XEInt 42)) "disjoint scopes reuse an identity"
  let f = name 100
  let loop = name 101
  let argument = name 102
  let rhs = XEAbs argument (pair (XEVar f) (XEApp (XEVar loop) (XEVar argument)))
  let captured = XELet f (function 80) (XELetRec (Cons (Pair loop rhs) Nil) (pair (XEVar f) (XEVar loop)))
  assert (lets (O.optimize captured) == 2) "captured recursive uses remain shared"
  let patterned = XELet n (function 80) (XECase (XEVar (name 1))
        (Cons (XErasedAlternative (XConstructorPattern "Keep" (Cons (Just n) Nil)) (XEVar n)) Nil))
  assert (lets (O.optimize patterned) == 0) "pattern binders keep their own identity"
  let tooLarge = L.foldr (\i b -> XEAbs (name i) b) (panic "size query traversed past its budget") (L.range 1 25)
  assert (O.remainingSize 24 tooLarge < 0) "size query stops at its bound"
  let twice = XEApp (XEApp (XEVar n) (XEVar n)) (panic "occurrence query traversed past its limit")
  assert (O.occurrences 2 n twice == 2) "occurrence query stops at its limit"
  assert (O.occurrences 2 n (XEAbs n (panic "occurrence query entered a shadowed lambda")) == 0) "shadowed lambda skips its body"
  assert (O.occurrences 2 n (XELetRec (Cons (Pair n (panic "occurrence query entered a shadowed recursive RHS")) Nil) (panic "occurrence query entered a shadowed recursive body")) == 0) "shadowed recursion skips its group"
  putStrLn "optimizer queries: 22 checks passed"
