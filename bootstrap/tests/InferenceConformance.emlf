ect = \\x -> x }; inspect") (Cons (Triple "module-qualified" (Cons (Pair "A" (Pair "A.emlf" "module A (ident) where\nident x = x")) (Nil)) "module Main where\nimport qualified A as Q\nmain = Q.ident 42") (Cons (Triple "module-hidden" (Cons (Pair "A" (Pair "A.emlf" "module A (public) where\npublic = 1; private = 2")) (Nil)) "module Main where\nimport A\nmain = private") (Cons (Triple "module-reexport" (Cons (Pair "A" (Pair "A.emlf" "module A (ident) where\nident x = x")) (Cons (Pair "B" (Pair "B.emlf" "module B (module A) where\nimport A")) (Nil))) "module Main where\nimport B\nmain = ident True") (Cons (Triple "module-ambiguous" (Cons (Pair "A" (Pair "A.emlf" "module A where\nvalue = 1")) (Cons (Pair "B" (Pair "B.emlf" "module B where\nvalue = 2")) (Nil))) "module Main where\nimport A\nimport B\nmain = value") (Cons (Triple "module-cycle" (Cons (Pair "A" (Pair "A.emlf" "module A where\nimport B\na = 1")) (Cons (Pair "B" (Pair "B.emlf" "module B where\nimport A\nb = 2")) (Nil))) "module Main where\nimport A\nmain = a") (Cons (Triple "Fig12-A1" (Nil) "\\x y -> y") (Cons (Triple "Fig12-A2" (Nil) "\\(choose : forall a. a -> a -> a) ->\n\\(id : forall a. a -> a) ->\nchoose id") (Cons (Triple "Fig12-A3" (Nil) "\\(choose : forall a. a -> a -> a) ->\n\\(ids : List (forall a. a -> a)) ->\n\\(nil : forall p. List p) ->\nchoose nil ids") (Cons (Triple "Fig12-A4" (Nil) "\\(x : forall a. a -> a) -> x x") (Cons (Triple "Fig12-A5" (Nil) "\\(auto : (forall a. a -> a) -> (forall a. a -> a)) ->\n\\(id : forall a. a -> a) ->\nid auto") (Cons (Triple "Fig12-A6" (Nil) "\\(auto' : forall b. (forall a. a -> a) -> b -> b) ->\n\\(id : forall a. a -> a) ->\nid auto'") (Cons (Triple "Fig12-A7" (Nil) "\\(auto : (forall a. a -> a) -> (forall a. a -> a)) ->\n\\(choose : forall a. a -> a -> a) ->\n\\(id : forall a. a -> a) ->\nchoose id auto") (Cons (Triple "Fig12-A8" (Nil) "\\(auto' : forall b. (forall a. a -> a) -> b -> b) ->\n\\(choose : forall a. a -> a -> a) ->\n\\(id : forall a. a -> a) ->\