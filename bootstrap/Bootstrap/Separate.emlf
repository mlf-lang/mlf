module Bootstrap.Separate where

import Bootstrap.Types
import Bootstrap.Std
import Bootstrap.Fresh
import qualified Bootstrap.Map as M
import qualified Bootstrap.Set as Set
import qualified Bootstrap.Module as Modules
import qualified Bootstrap.Classes as Classes
import qualified Bootstrap.Compiler as Compiler
import qualified Bootstrap.Parser as Parser
import qualified Bootstrap.Primitive as Primitive
import qualified Bootstrap.Desugar as Desugar
import qualified Bootstrap.Surface as Surface
import qualified Bootstrap.Data as D
import qualified Bootstrap.Kind as K
import qualified Bootstrap.X.Type as T
import qualified Bootstrap.X.Syntax as X
import qualified Bootstrap.X.Check as Check
import qualified Bootstrap.X.Checked as Checked
import qualified Bootstrap.X.Parser as XP
import qualified Bootstrap.X.Pretty as Pretty

data UnitInterface = UnitInterface String (List (Pair String String)) (List Modules.Entity) (List DataDecl) (List SClassDecl) (List (Pair String SInstanceDecl)) (List (Pair String XType)) String
data UnitObject = UnitObject UnitInterface XTerm
unitName (UnitInterface n _ _ _ _ _ _ _) = n
unitDependencies (UnitInterface _ ds _ _ _ _ _ _) = ds
unitExports (UnitInterface _ _ es _ _ _ _ _) = es
unitData (UnitInterface _ _ _ ds _ _ _ _) = ds
unitClasses (UnitInterface _ _ _ _ cs _ _ _) = cs
unitInstances (UnitInterface _ _ _ _ _ is _ _) = is
unitBindings (UnitInterface _ _ _ _ _ _ bs _) = bs
unitObjectFingerprint (UnitInterface _ _ _ _ _ _ _ h) = h
objectInterface (UnitObject i _) = i
objectTerm (UnitObject _ t) = t

encodedFrom : String -> Int -> String
encodedFrom text i = if i >= stringLength text then "" else showInt (stringCodeAt text i) ++ "_" ++ encodedFrom text (i+1)
encoded text = encodedFrom text 0
stableName entity =
  if Modules.isRole Modules.BuiltinType entity || eqString (Modules.owner entity) "Prelude" && eqString (Modules.spelling entity) "Unit" then Modules.spelling entity
  else (if Modules.compareSpace (Modules.space entity) Modules.Types == 0 || (case Modules.role entity of {Modules.Constructor _ -> true; _ -> false}) then "Module_" else "module_") ++ encoded (Modules.owner entity) ++ "z_" ++ encoded (Modules.spelling entity)
mainName n = stableName (Modules.Entity n "main" Modules.Value)

hygieneName env n = M.findWithDefault compareString n n env
hygieneBind env names = do
  pairs <- mapM (\n -> do {new <- freshName "separateLocal"; freshPure (Pair n new)}) names
  freshPure (M.union compareString (M.fromList compareString pairs) env)
hygienePattern : Map String String -> SPattern -> SPattern
hygienePattern env p = case p of
  SDefaultPattern n -> SDefaultPattern (mapMaybeValue (hygieneName env) n)
  SConstructorPattern c ns -> SConstructorPattern c (map (mapMaybeValue (hygieneName env)) ns)
  SNestedPattern c ps -> SNestedPattern c (map (hygienePattern env) ps)
  SAnnotatedPattern n a -> SAnnotatedPattern (hygieneName env n) a
  _ -> p
hygieneIn : Map String String -> SExpr -> Fresh SExpr
hygieneIn env expression = case expression of
  SVar n -> freshPure (SVar (hygieneName env n))
  SLam n a b -> do
    scope <- hygieneBind env (Cons n Nil)
    body <- hygieneIn scope b
    freshPure (SLam (hygieneName scope n) a body)
  SApp f a -> do {x <- hygieneIn env f; y <- hygieneIn env a; freshPure (SApp x y)}
  SLet n a b -> do
    scope <- hygieneBind env (Cons n Nil)
    x <- hygieneIn env a
    y <- hygieneIn scope b
    freshPure (SLet (hygieneName scope n) x y)
  SAnn a t -> do {x <- hygieneIn env a; freshPure (SAnn x t)}
  SLetRec ds b -> do
    scope <- hygieneBind env (map (\(Triple n _ _) -> n) ds)
    definitions <- mapM (\(Triple n t a) -> do {x <- hygieneIn scope a; freshPure (Triple (hygieneName scope n) t x)}) ds
    body <- hygieneIn scope b
    freshPure (SLetRec definitions body)
  SCase a bs -> do
    scrutinee <- hygieneIn env a
    branches <- mapM (\(SAlternative p b) -> do
      scope <- hygieneBind env (Surface.patternVariables p)
      body <- hygieneIn scope b
      freshPure (SAlternative (hygienePattern scope p) body)) bs
    freshPure (SCase scrutinee branches)
  SEquations rows -> do
    rows2 <- mapM (\(Pair ps b) -> do
      scope <- hygieneBind env (concatMap Surface.patternVariables ps)
      body <- hygieneIn scope b
      freshPure (Pair (map (hygienePattern scope) ps) body)) rows
    freshPure (SEquations rows2)
  SDo _ _ -> hygieneIn env (Desugar.desugarDo expression)
  _ -> freshPure expression
hygiene expression = runFresh Nil (hygieneIn M.empty expression)
mapMaybeValue f value = case value of {Nothing -> Nothing; Just a -> Just (f a)}

sourceSchemeIn : Map String String -> Bool -> XType -> SType
sourceSchemeIn dictionaries qualified ty = case ty of
  XVar (XTyVar i) -> STVar ("a" ++ showInt (if i < 0 then 0 - 2*i + 1 else 2*i))
  XBot -> SBottom
  XBotKind k -> SBottomKind k
  XArrow a b -> case a of
    XCon d ts -> case if qualified then M.lookup compareString d dictionaries else Nothing of
      Just c -> let predicate = SPredicate c (map (sourceSchemeIn dictionaries false) ts) in
        case sourceSchemeIn dictionaries true b of
          SQualified ps body -> SQualified (Cons predicate ps) body
          body -> SQualified (Cons predicate Nil) body
      Nothing -> SArrow (sourceSchemeIn dictionaries false a) (sourceSchemeIn dictionaries false b)
    _ -> SArrow (sourceSchemeIn dictionaries false a) (sourceSchemeIn dictionaries false b)
  XCon c ts -> SCon c (map (sourceSchemeIn dictionaries false) ts)
  XApply a b -> STypeApp (sourceSchemeIn dictionaries false a) (sourceSchemeIn dictionaries false b)
  XForall (XTyVar i) bound body -> SForall Flexible ("a" ++ showInt (if i < 0 then 0 - 2*i + 1 else 2*i)) (sourceSchemeIn dictionaries false bound) (sourceSchemeIn dictionaries qualified body)
sourceScheme dictionaries ty = sourceSchemeIn dictionaries true ty
freshInteger : Fresh Int
freshInteger = Fresh (\count used -> Right (Triple count (count+1) used))
normalTypeIn : Map XTyVar XTyVar -> XType -> Fresh XType
normalTypeIn env ty = case ty of
  XVar a -> freshPure (XVar (M.findWithDefault T.compareTyVar a a env))
  XArrow a b -> do {x <- normalTypeIn env a; y <- normalTypeIn env b; freshPure (XArrow x y)}
  XCon c ts -> do {args <- mapM (normalTypeIn env) ts; freshPure (XCon c args)}
  XApply a b -> do {x <- normalTypeIn env a; y <- normalTypeIn env b; freshPure (XApply x y)}
  XForall a bound b -> do
    bound2 <- normalTypeIn env bound
    i <- freshInteger
    body <- normalTypeIn (M.insert T.compareTyVar a (XTyVar i) env) b
    freshPure (XForall (XTyVar i) bound2 body)
  _ -> freshPure ty
normalType ty = case runFresh Nil (normalTypeIn M.empty ty) of {Right t -> t; Left e -> panic e}

cleanSource (SourceModule path name exports imports ds cs is vs body) = do
  values <- traverseEither (\(Triple n a e) -> mapEither (Triple n a) (hygiene e)) vs
  instances <- traverseEither (\(SInstanceDecl vars context klass head methods) -> do
    methods2 <- traverseEither (\(Pair n e) -> mapEither (Pair n) (hygiene e)) methods
    Right (SInstanceDecl vars context klass head methods2)) is
  body2 <- case body of {Nothing -> Right Nothing; Just e -> mapEither Just (hygiene e)}
  Right (SourceModule path name exports imports ds cs instances values body2)
valueClosure : Map String (Triple String (Maybe SAnnotation) SExpr) -> Set String -> List String -> Set String
valueClosure values seen todo = case todo of
  Nil -> seen
  Cons n rest -> if Set.member compareString n seen then valueClosure values seen rest else case M.lookup compareString n values of
    Nothing -> valueClosure values seen rest
    Just (Triple _ _ e) -> valueClosure values (Set.insert compareString n seen) (append (Surface.freeNames e) rest)
closeInstance values (SInstanceDecl vars context klass head methods) = do
  let valueMap = M.fromList compareString (map (\v -> Pair (Modules.valueName v) v) values)
  methods2 <- traverseEither (\(Pair n e) ->
    let needed = valueClosure valueMap Set.empty (Surface.freeNames e) in
    mapEither (Pair n) (Surface.bindValues (filter (\v -> Set.member compareString (Modules.valueName v) needed) values) e)) methods
  Right (SInstanceDecl vars context klass head methods2)
stripInstance (SInstanceDecl vars context klass head methods) = SInstanceDecl vars context klass head (map (\(Pair n _) -> Pair n (SApp (SPrimitive PPanic) (SStringLit "interface method"))) methods)
sortBindings bindings = sortBy (\a b -> compareString (fst a) (fst b)) bindings

compileUnit : PreludeMode -> List UnitInterface -> SourceModule -> Either String UnitObject
compileUnit mode dependencies original = do
  let name = Modules.moduleIdentity original
  let imported = nubBy eqString (map Modules.importedModule (Modules.importsFor mode original))
  let dependencyMap = M.fromList compareString (map (\i -> Pair (unitName i) i) dependencies)
  ensure (not (eqString name "Prelude") || eqString (Modules.sourcePath original) "<Prelude>") "Prelude is a built-in module and cannot be redefined"
  ensure (not (M.member compareString name dependencyMap)) ("cyclic imports: " ++ name)
  traverseEither (\n -> ensure (M.member compareString n dependencyMap) ("missing compiled interface for " ++ n)) imported
  clean <- cleanSource original
  declared <- Modules.locals clean
  let local = if eqString name "Prelude" then Modules.union declared (Modules.interface Modules.primitiveEntities) else declared
  let public = M.fromList compareString (map (\i -> Pair (unitName i) (Modules.interface (unitExports i))) dependencies)
  env <- if eqString name "Prelude" then Right local else Modules.scope mode public clean local
  exported <- Modules.exportsFor mode clean local env
  let entities = Set.toList (Set.unions Modules.compareEntity (Cons (Modules.visible env) (Cons (Modules.visible local) (Cons (Modules.visible Modules.primitiveScope) Nil))))
  let methods = concatMap (\e -> if Modules.isRole Modules.Class e then concatMap (\inst -> map (\(Pair n _) -> Modules.Entity (Modules.owner e) n (Modules.Method (Modules.spelling e))) (Modules.instanceMethods inst)) (Modules.sourceInstances original) else Nil) entities
  let names = Modules.Names (M.fromList Modules.compareEntity (map (\e -> Pair e (stableName e)) (append entities methods)))
  Modules.Renamed ds cs is vs expression <- Modules.renameModule names local env clean
  let inheritedMain = case Set.toList (Modules.lookupEntities Modules.Terms "main" env) of
        Cons e Nil -> if not (any (\v -> eqString (Modules.valueName v) (mainName name)) vs) && Modules.isRole Modules.Value e then Cons (Triple (mainName name) Nothing (SVar (stableName e))) Nil else Nil
        _ -> Nil
  let values = case expression of {Nothing -> append vs inheritedMain; Just e -> snoc vs (Triple (mainName name) Nothing e)}
  instances <- traverseEither (closeInstance values) is
  body <- Surface.bindValues values (SConstructor "Unit")
  let allClasses = append (concatMap unitClasses dependencies) cs
  let dictionaries = M.fromList compareString (map (\c -> Pair ("Dict_" ++ Classes.className c) (Classes.className c)) allClasses)
  let externalTypes = M.fromList compareString (concatMap unitBindings dependencies)
  let externals = M.mapWithKey (\n ty -> sourceScheme (if eqString (stringSlice n 0 7) "module_" then dictionaries else M.empty) ty) externalTypes
  let ownInstances = map (\(Pair i inst) -> Pair ("instance_" ++ encoded name ++ "z_" ++ showInt i) inst) (zip (range 0 (length instances-1)) instances)
  let allInstances = append (concatMap unitInstances dependencies) ownInstances
  let program = SClassProgram (append (concatMap unitData dependencies) ds) allClasses (map snd allInstances) body
  lowered <- Classes.lowerSeparateClasses externals (map fst allInstances) program
  compiled <- mapLeft Compiler.prettyError (Compiler.finishCompilation lowered)
  Pair declarations core <- Right (case Compiler.compiledTerm compiled of {XWithData ds t -> Pair ds t; t -> Pair Nil t})
  Pair parameters implementation <- if M.null externalTypes then Right (Pair Nil core) else case core of
    XLetRec bs rest -> do
      ensure (eqList eqString (map (\(Triple n _ _) -> X.nameHint n) bs) (M.keys externalTypes)) "module import parameter order mismatch"
      traverseEither (\(Triple n t _) -> ensure (case M.lookup compareString (X.nameHint n) externalTypes of {Nothing -> false; Just expected -> T.alphaEq t expected}) ("imported scheme changed during elaboration: " ++ X.nameHint n)) bs
      Right (Pair (map (\(Triple n t _) -> Pair n t) bs) rest)
    _ -> Left "module elaboration did not retain its import parameters"
  dataEnv <- D.validateDeclarations declarations
  bindings <- collectBindings dataEnv (XEnv M.empty (M.fromList X.compareName parameters)) implementation
  let payload = XWithData declarations (foldr (\(Pair n t) b -> XAbs n t b) implementation parameters)
  let iface = UnitInterface name (map (\n -> Pair n (interfaceFingerprint (M.findWithDefault compareString (panic "missing interface") n dependencyMap))) imported)
        (sortBy (\a b -> compareString (entityEncoding a) (entityEncoding b)) (Set.toList (Modules.visible exported))) ds cs
        (map (\(Pair n i) -> Pair n (stripInstance i)) ownInstances)
        (sortBindings (map (\(Pair n t) -> Pair (X.nameHint n) (normalType t)) bindings)) (fingerprint (Pretty.prettyTerm payload))
  Check.checkClosed payload
  Right (UnitObject iface payload)

builtinPrelude = compileUnit NoImplicitPrelude Nil Modules.preludeSource
collectBindings : DataEnv -> XEnv -> XTerm -> Either String (List (Pair XName XType))
collectBindings ds env term = case term of
  XLet n rhs rest -> do
    ty <- Check.inferWithData ds env rhs
    ensure (Set.null (T.freeVars ty)) "module binding has an open type"
    remaining <- collectBindings ds (XEnv (Check.typeEnv env) (M.insert X.compareName n ty (Check.termEnv env))) rest
    Right (Cons (Pair n ty) remaining)
  XLetRec bs rest -> do
    let entries = map (\(Triple n t _) -> Pair n t) bs
    ensure (all (\p -> Set.null (T.freeVars (snd p))) entries) "module binding has an open type"
    remaining <- collectBindings ds (XEnv (Check.typeEnv env) (M.union X.compareName (M.fromList X.compareName entries) (Check.termEnv env))) rest
    Right (append entries remaining)
  XConstructor "Unit" Nil -> Right Nil
  _ -> Left "invalid module object: expected declarations ending in Unit"

pack fields = concatMapString (\s -> showInt (stringLength s) ++ ":" ++ s) fields
digitEnd : String -> Int -> Int
digitEnd text i = if i >= stringLength text then i else let c = stringCodeAt text i in if c >= 48 && c <= 57 then digitEnd text (i+1) else i
unpackFrom : String -> Int -> Either String (List String)
unpackFrom text start = if start == stringLength text then Right Nil else do
  let end = digitEnd text start
  ensure (end > start && end-start <= 9 && end < stringLength text && stringCodeAt text end == 58) "malformed module artifact framing"
  let n = readInt (stringSlice text start (end-start))
  ensure (n <= stringLength text-end-1) "truncated module artifact"
  rest <- unpackFrom text (end+1+n)
  Right (Cons (stringSlice text (end+1) n) rest)
unpack text = unpackFrom text 0
fingerprintFrom : String -> Int -> Int -> Int -> String
fingerprintFrom text i a b = if i >= stringLength text then showInt a ++ "-" ++ showInt b else
  let code = stringCodeAt text i in
  let nextA = (a * 65599 + code) % 2147483647 in
  let nextB = (b * 131 + code) % 2147483629 in
  seq nextA (seq nextB (fingerprintFrom text (i+1) nextA nextB))
fingerprint text = fingerprintFrom text 0 0 1
entityEncoding (Modules.Entity owner name role) =
  let result = case role of
        Modules.Value -> Pair "value" ""
        Modules.Datatype -> Pair "data" ""
        Modules.Class -> Pair "class" ""
        Modules.Constructor p -> Pair "constructor" p
        Modules.Method p -> Pair "method" p
        Modules.BuiltinType -> Pair "builtin" ""
        Modules.Primitive p -> Pair "primitive" (Primitive.primitiveName p)
        Modules.Boolean b -> Pair "bool" (if b then "true" else "false") in
  pack (Cons owner (Cons name (Cons (fst result) (Cons (snd result) Nil))))
noEntityArg role arg = if eqString arg "" then Right role else Left "unexpected entity argument"
decodeEntity text = do
  fields <- unpack text
  case fields of
    Cons owner (Cons name (Cons tag (Cons arg Nil))) -> do
      role <- case tag of
        "value" -> noEntityArg Modules.Value arg
        "data" -> noEntityArg Modules.Datatype arg
        "class" -> noEntityArg Modules.Class arg
        "constructor" -> Right (Modules.Constructor arg)
        "method" -> Right (Modules.Method arg)
        "builtin" -> noEntityArg Modules.BuiltinType arg
        "primitive" -> case Primitive.lookupPrimitive arg of {Nothing -> Left "unknown interface primitive"; Just p -> Right (Modules.Primitive p)}
        "bool" -> if eqString arg "true" then Right (Modules.Boolean true) else if eqString arg "false" then Right (Modules.Boolean false) else Left "unknown interface entity role"
        _ -> Left "unknown interface entity role"
      Right (Modules.Entity owner name role)
    _ -> Left "malformed interface entity"

prettySourceType : SType -> String
prettySourceType ty = case ty of
  STVar n -> n
  SBottom -> "bot"
  SBottomKind k -> "bot[" ++ K.prettyKind k ++ "]"
  SArrow a b -> "(" ++ prettySourceType a ++ " -> " ++ prettySourceType b ++ ")"
  STypeApp a b -> "(" ++ prettySourceType a ++ " " ++ prettySourceType b ++ ")"
  SCon c ts -> "(" ++ intercalate " " (Cons c (map prettySourceType ts)) ++ ")"
  SForall flag n bound body -> "(forall (" ++ n ++ (case flag of {Flexible -> " >= "; Rigid -> " > "}) ++ prettySourceType bound ++ "). " ++ prettySourceType body ++ ")"
  SQualified ps b -> "(" ++ prettyContext ps ++ prettySourceType b ++ ")"
prettyPredicate : SPredicate -> String
prettyPredicate (SPredicate c ts) = intercalate " " (Cons c (map prettySourceType ts))
prettyContext : List SPredicate -> String
prettyContext ps = if null ps then "" else "(" ++ intercalate ", " (map prettyPredicate ps) ++ ") => "
prettyParameter (Pair n k) = "(" ++ n ++ " : " ++ K.prettyKind k ++ ")"
prettyClass c = "class " ++ prettyContext (Classes.superclasses c) ++ Classes.className c ++ " " ++ intercalate " " (map prettyParameter (Classes.classParameters c)) ++ " where { " ++ intercalate "; " (map (\(Pair n ty) -> n ++ " : " ++ prettySourceType ty) (Classes.classMethods c)) ++ " };"
prettyInstance i = "instance " ++ (if null (Classes.instanceVariables i) then "" else "forall " ++ intercalate " " (map prettyParameter (Classes.instanceVariables i)) ++ ". ") ++ prettyContext (Classes.instanceContext i) ++ Classes.instanceClass i ++ " " ++ intercalate " " (map prettySourceType (Classes.instanceHead i)) ++ " where { " ++ intercalate "; " (map (\(Pair n _) -> n ++ " = panic \"interface method\"") (Classes.instanceMethods i)) ++ " };"
pairEncoding (Pair a b) = pack (Cons a (Cons b Nil))
interfaceFields i =
  let metadata = unlines (append (map D.prettyDeclaration (unitData i)) (append (map prettyClass (unitClasses i)) (map (\p -> prettyInstance (snd p)) (unitInstances i)))) in
  let bindings = pack (map (\(Pair n t) -> pairEncoding (Pair n (Pretty.prettyType (normalType t)))) (unitBindings i)) in
  Cons "MLFI-1" (Cons (unitName i) (Cons (pack (map pairEncoding (unitDependencies i))) (Cons (pack (map entityEncoding (unitExports i))) (Cons metadata (Cons (pack (map fst (unitInstances i))) (Cons bindings Nil))))))
interfaceFingerprint i = fingerprint (pack (interfaceFields i))
encodeInterface i = pack (snoc (interfaceFields i) (unitObjectFingerprint i))
decodePair text = do
  fields <- unpack text
  case fields of {Cons a (Cons b Nil) -> Right (Pair a b); _ -> Left "malformed interface pair"}
decodeInterface input = do
  fields <- unpack input
  case fields of
    Cons "MLFI-1" (Cons name (Cons deps (Cons exports (Cons metadata (Cons instanceNames (Cons bindings (Cons objectHash Nil))))))) -> do
      rawDeps <- unpack deps
      ds <- traverseEither decodePair rawDeps
      rawExports <- unpack exports
      es <- traverseEither decodeEntity rawExports
      source <- Parser.parseModule "<module interface>" ("module InterfaceMetadata where {\n" ++ metadata ++ "\n}")
      ns <- unpack instanceNames
      rawBindings <- unpack bindings
      bs <- traverseEither (\field -> do {Pair n ty <- decodePair field; t <- XP.parseType ty; Right (Pair n t)}) rawBindings
      ensure (length ns == length (Modules.sourceInstances source)) "interface instance count mismatch"
      ensure (null (Modules.sourceValues source) && null (Modules.sourceImports source)) "interface contains executable declarations"
      ensure (length ds == length (nubBy eqString (map fst ds)) && length ns == length (nubBy eqString ns) && length bs == length (nubBy eqString (map fst bs))) "duplicate interface entry"
      ensure (all (\p -> Set.null (T.freeVars (snd p))) bs) "interface has open types"
      ensure (stringLength name > 0 && stringLength objectHash > 0) "incomplete module interface"
      traverseEither validModuleName (Cons name (append (map fst ds) (map Modules.owner es)))
      let i = UnitInterface name ds es (Modules.sourceDatatypes source) (Modules.sourceClasses source) (zip ns (map stripInstance (Modules.sourceInstances source))) bs objectHash
      ensure (eqString (encodeInterface i) input) "noncanonical module interface"
      Right i
    _ -> Left "unsupported or malformed module interface (expected MLFI-1)"
validModuleName name = do
  parsed <- Parser.parseModule "<module identity>" ("module " ++ name ++ " where {}")
  ensure (eqMaybe eqString (Modules.sourceModuleName parsed) (Just name)) "invalid compiled module identity"
encodeObject (UnitObject i term) = pack (Cons "MLFO-1" (Cons (unitName i) (Cons (interfaceFingerprint i) (Cons (Pretty.prettyTerm term) Nil))))
decodeObject i input = do
  fields <- unpack input
  case fields of
    Cons "MLFO-1" (Cons name (Cons abi (Cons body Nil))) -> do
      ensure (eqString name (unitName i)) "module object name mismatch"
      ensure (eqString abi (interfaceFingerprint i)) "module object interface mismatch"
      ensure (eqString (fingerprint body) (unitObjectFingerprint i)) "module object checksum mismatch"
      term <- XP.parseTerm "<module object>" body
      Check.checkClosed term
      Right (UnitObject i term)
    _ -> Left "unsupported or malformed module object (expected MLFO-1)"

mapType : (XTyVar -> XTyVar) -> XType -> XType
mapType variable ty = case ty of
  XVar a -> XVar (variable a)
  XArrow a b -> XArrow (mapType variable a) (mapType variable b)
  XCon c ts -> XCon c (map (mapType variable) ts)
  XApply a b -> XApply (mapType variable a) (mapType variable b)
  XForall a bound b -> XForall (variable a) (mapType variable bound) (mapType variable b)
  _ -> ty
mapComputation : (XTyVar -> XTyVar) -> XComputation -> XComputation
mapComputation variable computation = case computation of
  XBottom t -> XBottom (mapType variable t)
  XHyp a -> XHyp (variable a)
  XInner p -> XInner (mapComputation variable p)
  XOuter a p -> XOuter (variable a) (mapComputation variable p)
  XIntro a -> XIntro (variable a)
  XIntroKind a k -> XIntroKind (variable a) k
  XThen a b -> XThen (mapComputation variable a) (mapComputation variable b)
  _ -> computation
mapPattern name pattern = case pattern of
  XConstructorPattern c ns -> XConstructorPattern c (map (mapMaybeValue name) ns)
  XDefaultPattern n -> XDefaultPattern (mapMaybeValue name n)
mapTerm : (XName -> XName) -> (XTyVar -> XTyVar) -> XTerm -> XTerm
mapTerm name variable term = case term of
  XVarTerm n -> XVarTerm (name n)
  XAbs n ty b -> XAbs (name n) (mapType variable ty) (mapTerm name variable b)
  XApp a b -> XApp (mapTerm name variable a) (mapTerm name variable b)
  XTypeAbs a bound b -> XTypeAbs (variable a) (mapType variable bound) (mapTerm name variable b)
  XTypeApp a p -> XTypeApp (mapTerm name variable a) (mapComputation variable p)
  XLet n a b -> XLet (name n) (mapTerm name variable a) (mapTerm name variable b)
  XLetRec bs b -> XLetRec (map (\(Triple n t a) -> Triple (name n) (mapType variable t) (mapTerm name variable a)) bs) (mapTerm name variable b)
  XPrimitive p ts -> XPrimitive p (map (mapType variable) ts)
  XConstructor c ts -> XConstructor c (map (mapType variable) ts)
  XCase a t bs -> XCase (mapTerm name variable a) (mapType variable t) (map (\(XAlternative p b) -> XAlternative (mapPattern name p) (mapTerm name variable b)) bs)
  XWithData ds b -> XWithData ds (mapTerm name variable b)
  _ -> term

-- Dense renumbering also handles valid object IDs near the parser's Int64
-- limit. Adding an offset to original IDs would overflow that wire format.
typeIdentities : XType -> Set Int -> Set Int
typeIdentities ty seen = case ty of
  XVar (XTyVar a) -> Set.insert compareInt a seen
  XArrow a b -> typeIdentities b (typeIdentities a seen)
  XCon _ ts -> foldl (\acc t -> typeIdentities t acc) seen ts
  XApply a b -> typeIdentities b (typeIdentities a seen)
  XForall (XTyVar a) bound b -> typeIdentities b (typeIdentities bound (Set.insert compareInt a seen))
  _ -> seen
computationIdentities : XComputation -> Set Int -> Set Int
computationIdentities p seen = case p of
  XBottom t -> typeIdentities t seen
  XHyp (XTyVar a) -> Set.insert compareInt a seen
  XInner q -> computationIdentities q seen
  XOuter (XTyVar a) q -> computationIdentities q (Set.insert compareInt a seen)
  XIntro (XTyVar a) -> Set.insert compareInt a seen
  XIntroKind (XTyVar a) _ -> Set.insert compareInt a seen
  XThen a b -> computationIdentities b (computationIdentities a seen)
  _ -> seen
termIdentities : XTerm -> Set Int -> Set Int
termIdentities term seen = case term of
  XVarTerm n -> Set.insert compareInt (X.nameId n) seen
  XAbs n ty b -> termIdentities b (typeIdentities ty (Set.insert compareInt (X.nameId n) seen))
  XApp a b -> termIdentities b (termIdentities a seen)
  XTypeAbs (XTyVar a) bound b -> termIdentities b (typeIdentities bound (Set.insert compareInt a seen))
  XTypeApp a p -> computationIdentities p (termIdentities a seen)
  XLet n a b -> termIdentities b (termIdentities a (Set.insert compareInt (X.nameId n) seen))
  XLetRec bs b -> termIdentities b (foldl (\acc (Triple n t a) -> termIdentities a (typeIdentities t (Set.insert compareInt (X.nameId n) acc))) seen bs)
  XPrimitive _ ts -> foldl (\acc t -> typeIdentities t acc) seen ts
  XConstructor _ ts -> foldl (\acc t -> typeIdentities t acc) seen ts
  XCase a t bs -> foldl (\acc (XAlternative p b) -> termIdentities b (foldl (\ids n -> Set.insert compareInt (X.nameId n) ids) acc (X.patternNames p))) (typeIdentities t (termIdentities a seen)) bs
  XWithData _ b -> termIdentities b seen
  _ -> seen
freshObject serial term =
  let ids = Set.toList (termIdentities term Set.empty) in
  let replacements = M.fromList compareInt (zip ids (range serial (serial+length ids-1))) in
  let rename = \n -> M.findWithDefault compareInt (panic "missing object identity") n replacements in
  Pair (serial + length ids) (mapTerm (\(XName n hint) -> XName (rename n) hint) (\(XTyVar n) -> XTyVar (rename n)) term)
splitParameters : XTerm -> Pair (List (Pair XName XType)) XTerm
splitParameters term = case term of
  XAbs n ty b -> case splitParameters b of {Pair ps rest -> Pair (Cons (Pair n ty) ps) rest}
  _ -> Pair Nil term
data LinkState = LinkState Int (Map String String) (Map String (Pair XName XType)) (List XTerm) (List DataDecl)
mergeDeclaration declarations d = case filter (\other -> eqString (D.datatypeName other) (D.datatypeName d)) declarations of
  Nil -> Right (snoc declarations d)
  Cons other Nil -> if eqString (D.prettyDeclaration other) (D.prettyDeclaration d) then Right declarations else Left ("conflicting module datatype: " ++ D.datatypeName d)
  _ -> Left ("conflicting module datatype: " ++ D.datatypeName d)
linkObject (LinkState serial done available bodies allData) (UnitObject iface original) = do
  ensure (not (M.member compareString (unitName iface) done)) ("duplicate module object: " ++ unitName iface)
  traverseEither (\(Pair n h) -> ensure (eqMaybe eqString (M.lookup compareString n done) (Just h)) ("stale or missing dependency interface: " ++ n)) (unitDependencies iface)
  Pair next term <- Right (freshObject serial original)
  Pair ds inner <- Right (case term of {XWithData ds b -> Pair ds b; _ -> Pair Nil term})
  Pair parameters implementation <- Right (splitParameters inner)
  replacements <- traverseEither (\(Pair n ty) -> case M.lookup compareString (X.nameHint n) available of
    Nothing -> Left ("unresolved module symbol: " ++ X.nameHint n)
    Just (Pair actual expected) -> do
      ensure (T.alphaEq ty expected) ("module import type mismatch: " ++ X.nameHint n)
      Right (Pair n actual)) parameters
  let substitution = M.fromList X.compareName replacements
  let linked = mapTerm (\n -> M.findWithDefault X.compareName n n substitution) (\a -> a) implementation
  dataEnv <- D.validateDeclarations ds
  own <- collectBindings dataEnv (XEnv M.empty (M.fromList X.compareName parameters)) implementation
  let expected = sortBindings (unitBindings iface)
  let actual = sortBindings (map (\(Pair n t) -> Pair (X.nameHint n) (normalType t)) own)
  ensure (eqList (\a b -> eqString (fst a) (fst b) && T.alphaEq (snd a) (snd b)) actual expected) "module object export type mismatch"
  let bindings = M.fromList compareString (map (\(Pair n t) -> Pair (X.nameHint n) (Pair n t)) own)
  ensure (all (\n -> not (M.member compareString n available)) (M.keys bindings)) "duplicate module symbol"
  combined <- foldEither mergeDeclaration allData ds
  Check.checkClosed original
  Right (LinkState next (M.insert compareString (unitName iface) (interfaceFingerprint iface) done) (M.union compareString bindings available) (snoc bodies linked) combined)
graft : XTerm -> XTerm -> Either String XTerm
graft declarations body = case declarations of
  XLet n a b -> mapEither (XLet n a) (graft b body)
  XLetRec ds b -> mapEither (XLetRec ds) (graft b body)
  XConstructor "Unit" Nil -> Right body
  _ -> Left "invalid module object declaration spine"
boundaryClosure : Map String UnitInterface -> List String -> List UnitInterface -> List String -> Either String (List UnitInterface)
boundaryClosure interfaces trail done todo = case todo of
  Nil -> Right done
  Cons n ns ->
    if elem eqString n trail then Left ("cyclic compiled imports: " ++ intercalate " -> " (snoc trail n))
    else if any (\i -> eqString n (unitName i)) done then boundaryClosure interfaces trail done ns
    else case M.lookup compareString n interfaces of
      Nothing -> Left ("missing interface: " ++ n)
      Just child -> do
        earlier <- boundaryClosure interfaces (snoc trail n) done (map fst (unitDependencies child))
        boundaryClosure interfaces trail (snoc earlier child) ns
parameterTypes : XTerm -> List (Pair String XType)
parameterTypes term = case term of
  XAbs n t b -> Cons (Pair (X.nameHint n) (normalType t)) (parameterTypes b)
  _ -> Nil
sameSignature a b = eqString (fst a) (fst b) && T.alphaEq (snd a) (snd b)
validateObjectBoundary interfaces (UnitObject iface term) = do
  let byName = M.fromList compareString (map (\i -> Pair (unitName i) i) interfaces)
  deps <- boundaryClosure byName (Cons (unitName iface) Nil) Nil (map fst (unitDependencies iface))
  let allInterfaces = snoc deps iface
  let classes = concatMap unitClasses allInterfaces
  let instances = concatMap unitInstances allInterfaces
  let declared = concatMap unitData allInterfaces
  Pair ds inner <- Right (case term of {XWithData ds b -> Pair ds b; _ -> Pair Nil term})
  ensure (eqList sameSignature (parameterTypes inner) (sortBindings (concatMap unitBindings deps))) "module object dependency parameter mismatch"
  Pair program _ <- Classes.lowerSeparateClasses M.empty (map fst instances) (SClassProgram declared classes (map snd instances) (SConstructor "Unit"))
  expectedData <- case program of {SProgram xs _ -> Right xs; _ -> Left "invalid module metadata"}
  ensure (eqList eqString (sortBy compareString (map D.prettyDeclaration ds)) (sortBy compareString (map D.prettyDeclaration expectedData))) "module object datatype interface mismatch"
linkObjects objects root = mapEither Checked.term (linkCheckedObjects objects root)
linkCheckedObjects objects root = do
  ensure (not (null objects)) "no compiled modules to link"
  traverseEither (validateObjectBoundary (map objectInterface objects)) objects
  LinkState serial _ bindings bodies declarations <- foldEither linkObject (LinkState 0 M.empty M.empty Nil Nil) objects
  entry <- linkEntry serial (map objectInterface objects) bindings root
  body <- foldEither (\body declarations -> graft declarations body) entry (reverse bodies)
  let term = XWithData declarations body
  Checked.check term

linkEntry serial interfaces available root = do
  ensure (M.member compareString (mainName root) available) ("entry module has no main binding: " ++ root)
  let byName = M.fromList compareString (map (\i -> Pair (unitName i) i) interfaces)
  reachable <- boundaryClosure byName Nil Nil (Cons root Nil)
  let classes = concatMap unitClasses reachable
  let instances = concatMap unitInstances reachable
  let dictionaries = M.fromList compareString (map (\c -> Pair ("Dict_" ++ Classes.className c) (Classes.className c)) classes)
  let signatures = M.fromList compareString (concatMap unitBindings reachable)
  let externals = M.mapWithKey (\n ty -> sourceScheme (if eqString (stringSlice n 0 7) "module_" then dictionaries else M.empty) ty) signatures
  let program = SClassProgram (concatMap unitData reachable) classes (map snd instances) (SVar (mainName root))
  lowered <- Classes.lowerSeparateClasses externals (map fst instances) program
  compiled <- mapLeft Compiler.prettyError (Compiler.finishCompilation lowered)
  removeEntryParameters signatures available (snd (freshObject serial (Compiler.compiledTerm compiled)))
removeEntryParameters : Map String XType -> Map String (Pair XName XType) -> XTerm -> Either String XTerm
removeEntryParameters signatures available term = case term of
  XWithData _ b -> removeEntryParameters signatures available b
  XTypeAbs a bound b -> mapEither (XTypeAbs a bound) (removeEntryParameters signatures available b)
  XTypeApp b p -> mapEither (\x -> XTypeApp x p) (removeEntryParameters signatures available b)
  XLetRec bs b -> do
    ensure (eqList eqString (map (\(Triple n _ _) -> X.nameHint n) bs) (M.keys signatures)) "entry parameter mismatch"
    replacements <- traverseEither (\(Triple n ty _) -> case M.lookup compareString (X.nameHint n) available of
      Nothing -> Left ("missing entry symbol: " ++ X.nameHint n)
      Just (Pair actual expected) -> do
        ensure (T.alphaEq ty expected) ("entry parameter type mismatch: " ++ X.nameHint n)
        Right (Pair n actual)) bs
    let substitution = M.fromList X.compareName replacements
    Right (mapTerm (\n -> M.findWithDefault X.compareName n n substitution) (\a -> a) b)
  _ -> Left "entry elaboration did not retain its import parameters"

readStrict path = do
  present <- fileExists path
  if present then do {text <- readFile path; ioReturn (Right text)} else ioReturn (Left ("file does not exist: " ++ path))
findInterface : List String -> IO (Either String String)
findInterface paths = case paths of
  Nil -> ioReturn (Left "cannot find compiled module interface; compile dependencies first or add -i DIR")
  Cons p ps -> do
    present <- fileExists p
    if present then ioReturn (Right p) else findInterface ps
validateDependencies dependencies iface = do
  traverseEither (\(Pair n h) -> ensure (eqMaybe eqString (lookup eqString n (map (\(Pair _ i) -> Pair (unitName i) (interfaceFingerprint i)) dependencies)) (Just h))
    ("stale dependency interface: " ++ unitName iface ++ " requires a different " ++ n ++ "; recompile " ++ unitName iface)) (unitDependencies iface)
  Right Unit
loadInterfaceGraph : List String -> List String -> List (Pair String UnitInterface) -> List String -> IO (Either String (List (Pair String UnitInterface)))
loadInterfaceGraph paths trail done todo = case todo of
  Nil -> ioReturn (Right done)
  Cons n ns ->
    if elem eqString n trail then ioReturn (Left ("cyclic compiled imports: " ++ intercalate " -> " (snoc trail n)))
    else if any (\p -> eqString (unitName (snd p)) n) done then loadInterfaceGraph paths trail done ns
    else if eqString n "Prelude" then case builtinPrelude of
      Left e -> ioReturn (Left e)
      Right (UnitObject i _) -> loadInterfaceGraph paths trail (snoc done (Pair "<Prelude>" i)) ns
    else do
      found <- findInterface (map (\p -> Modules.joinPath p (intercalate "/" (Modules.components n) ++ ".mlfi")) paths)
      case found of
        Left e -> ioReturn (Left e)
        Right path -> do
          input <- readStrict path
          case bindEither input decodeInterface of
            Left e -> ioReturn (Left (path ++ ": " ++ e))
            Right i -> if not (eqString (unitName i) n) then ioReturn (Left (path ++ ": expected interface for " ++ n)) else do
              children <- loadInterfaceGraph paths (snoc trail n) done (map fst (unitDependencies i))
              case bindEither children (\xs -> do {validateDependencies xs i; Right xs}) of
                Left e -> ioReturn (Left e)
                Right xs -> loadInterfaceGraph paths trail (snoc xs (Pair path i)) ns
loadInterfaces paths roots = loadInterfaceGraph paths Nil Nil roots
searchRoots includes file name =
  let directory = Modules.takeDirectory file in
  nubBy eqString (Cons directory (append includes (Cons (Modules.parentDirectory (length (Modules.components name)-1) directory) (Cons "." Nil))))
compileModuleFile mode includes source prefix = do
  input <- readStrict source
  case bindEither input (Parser.parseModule source) of
    Left e -> ioReturn (Left e)
    Right root -> do
      loaded <- loadInterfaces (searchRoots includes source (Modules.moduleIdentity root)) (nubBy eqString (map Modules.importedModule (Modules.importsFor mode root)))
      case bindEither loaded (\deps -> compileUnit mode (map snd deps) root) of
        Left e -> ioReturn (Left e)
        Right object -> do
          writeFile (prefix ++ ".mlfo") (encodeObject object)
          writeFile (prefix ++ ".mlfi") (encodeInterface (objectInterface object))
          ioReturn (Right Unit)
linkModuleFile includes path = do
  linked <- linkCheckedModuleFile includes path
  ioReturn (mapEither Checked.term linked)
linkCheckedModuleFile includes path = do
  input <- readStrict path
  case bindEither input decodeInterface of
    Left e -> ioReturn (Left e)
    Right root -> do
      loaded <- loadInterfaces (searchRoots includes path (unitName root)) (map fst (unitDependencies root))
      case bindEither loaded (\deps -> do {validateDependencies deps root; Right (snoc deps (Pair path root))}) of
        Left e -> ioReturn (Left e)
        Right interfaces -> do
          objects <- mapM (\(Pair file i) -> if eqString file "<Prelude>" then ioReturn builtinPrelude else do
            input <- readStrict (stringSlice file 0 (stringLength file - 5) ++ ".mlfo")
            ioReturn (bindEither input (decodeObject i))) interfaces
          ioReturn (bindEither (sequenceEither objects) (\os -> linkCheckedObjects os (unitName root)))
showInterfaceFile path = do
  input <- readStrict path
  ioReturn (do
    i <- bindEither input decodeInterface
    let names = M.fromList compareString (map (\e -> Pair (stableName e) (Modules.label e)) (unitExports i))
    let values = concatMap (\e -> if Modules.isRole Modules.Value e then case lookup eqString (stableName e) (unitBindings i) of
          Nothing -> Nil
          Just ty -> Cons (Modules.label e ++ " : " ++ Modules.displayNames names (Pretty.prettyType ty)) Nil
          else Nil) (unitExports i)
    Right (unlines (append (Cons ("module " ++ unitName i) (Cons ("interface " ++ interfaceFingerprint i) Nil)) (append (map (\(Pair n h) -> "import " ++ n ++ " " ++ h) (unitDependencies i)) values))))
