module Bootstrap.Graph where

import Bootstrap.Types
import qualified Bootstrap.Std as L
import qualified Bootstrap.Map as M
import qualified Bootstrap.IntMap as IM
import qualified Bootstrap.IntSet as IS
import qualified Bootstrap.ST as ST

-- Persistent graph operations. Identities are retained through aliases, while
-- permissions are always checked on the immutable graph before unification.
nodes : Graph -> IntMap Node
nodes (Graph ns ls fresh) = ns
links : Graph -> IntMap Int
links (Graph ns ls fresh) = ls
nextId : Graph -> Int
nextId (Graph ns ls fresh) = fresh
tag : Node -> GTag
tag (Node t b f) = t
binder : Node -> Maybe Int
binder (Node t b f) = b
flag : Node -> Flag
flag (Node t b f) = f

-- Pair fields used as strict-state accumulators must be evaluated before the
-- next fold step; forcing only the Pair constructor leaves a deferred spine.
strictPair : forall a b. a -> b -> Pair a b
strictPair a b = seq a (seq b (Pair a b))

-- Match the seed's strict graph records without making general-purpose maps
-- strict in their values (recursive runtime environments require lazy values).
forceIntMap : forall a. IntMap a -> Unit
forceIntMap (IntMap tree) = seq tree Unit

forceTag : GTag -> Unit
forceTag t = case t of
  GArr a b -> seq a (seq b Unit)
  GTyApp a b -> seq a (seq b Unit)
  GGen n -> seq n Unit
  _ -> Unit

mkNode : GTag -> Maybe Int -> Flag -> Node
mkNode t b f = seq (forceTag t) (seq b (seq f (Node t b f)))

strictNode : Node -> Node
-- Preserve the record after forcing its required fields. Reconstructing the
-- same Node here allocated a second record at every graph-map boundary.
strictNode node = case node of
  Node t b f -> seq (forceTag t) (seq b (seq f node))

mkGraph : IntMap Node -> IntMap Int -> Int -> Graph
mkGraph ns aliases fresh = seq (forceIntMap ns) (seq (forceIntMap aliases) (seq fresh (Graph ns aliases fresh)))

strictGraph : Graph -> Graph
strictGraph graph = case graph of
  Graph ns aliases fresh -> seq (forceIntMap ns) (seq (forceIntMap aliases) (seq fresh graph))

insertNodeMap : Int -> Node -> IntMap Node -> IntMap Node
insertNodeMap n value ns = let strict = strictNode value in seq strict (IM.insert n strict ns)

nodesFromList : List (Pair Int Node) -> IntMap Node
nodesFromList entries = L.foldlStrict (\ns -> \entry -> case entry of { Pair n value -> insertNodeMap n value ns }) IM.empty entries

-- Linear construction when identities are already strictly ascending. Unlike
-- the generic lazy map builder, every graph node retains strictNode's demand.
nodesFromDistinctAscList : List (Pair Int Node) -> IntMap Node
nodesFromDistinctAscList entries = case buildNodeTree (L.length entries) entries of
  Pair tree remaining -> seq tree (IntMap tree)

buildNodeTree : Int -> List (Pair Int Node) -> Pair (Map Int Node) (List (Pair Int Node))
buildNodeTree count entries = if count <= 0 then Pair MapEmpty entries else
  case buildNodeTree (quotInt count 2) entries of
    Pair left rest -> case rest of
      Nil -> panic "invalid sorted graph entries"
      Cons (Pair key value) following ->
        let node = strictNode value in seq node (
          case buildNodeTree (count - quotInt count 2 - 1) following of
            Pair right after ->
              -- Keep each completed subtree strict while consuming the list.
              -- A lazy Pair field otherwise retains a second construction
              -- spine until the final root demands all its child maps.
              let tree = M.node count key node left right in
              seq tree (Pair tree after))

mapNodeTree : (Int -> Node -> Node) -> Map Int Node -> Map Int Node
mapNodeTree action tree = case tree of
  MapEmpty -> MapEmpty
  MapNode count key value left right ->
    let result = strictNode (action key value) in
    let leftTree = mapNodeTree action left in
    let rightTree = mapNodeTree action right in
    seq result (M.node count key result leftTree rightTree)

mapNodesWithKey : (Int -> Node -> Node) -> IntMap Node -> IntMap Node
mapNodesWithKey action (IntMap tree) = let result = mapNodeTree action tree in seq result (IntMap result)

mapNodes : (Node -> Node) -> IntMap Node -> IntMap Node
mapNodes action ns = mapNodesWithKey (\n -> \value -> action value) ns

emptyGraph : Graph
emptyGraph = mkGraph IM.empty IM.empty 0

bindE : forall a b. Either String a -> (a -> Either String b) -> Either String b
bindE value action = case value of
  Left message -> Left message
  Right result -> action result

mapE : forall a b. (a -> Either String b) -> List a -> Either String (List b)
mapE action values = case values of
  Nil -> Right Nil
  Cons value rest -> bindE (action value) (\result -> bindE (mapE action rest) (\results -> Right (Cons result results)))

mapE_ : forall a b. (a -> Either String b) -> List a -> Either String Unit
mapE_ action values = case values of
  Nil -> Right Unit
  Cons value rest -> bindE (action value) (\ignored -> mapE_ action rest)

foldE : forall a b. (a -> b -> Either String a) -> a -> List b -> Either String a
foldE action initial values = case values of
  Nil -> Right initial
  Cons value rest -> bindE (action initial value) (\next -> foldE action next rest)

check : Bool -> String -> Either String Unit
check condition message = if condition then Right Unit else Left message

equalKind : Kind -> Kind -> Bool
equalKind left right = case left of
  Star -> case right of
    Star -> true
    KArrow _ _ -> false
  KArrow a b -> case right of
    Star -> false
    KArrow c d -> equalKind a c && equalKind b d

equalFlag : Flag -> Flag -> Bool
equalFlag a b = case a of
  Flexible -> case b of
    Flexible -> true
    Rigid -> false
  Rigid -> case b of
    Flexible -> false
    Rigid -> true

equalMaybeInt : Maybe Int -> Maybe Int -> Bool
equalMaybeInt a b = case a of
  Nothing -> case b of
    Nothing -> true
    Just _ -> false
  Just x -> case b of
    Nothing -> false
    Just y -> x == y

equalPermission : Permission -> Permission -> Bool
equalPermission a b = case a of
  Green -> case b of { Green -> true; _ -> false }
  Orange -> case b of { Orange -> true; _ -> false }
  Red -> case b of { Red -> true; _ -> false }
  Inert -> case b of { Inert -> true; _ -> false }

equalInts : List Int -> List Int -> Bool
equalInts xs ys = case xs of
  Nil -> case ys of { Nil -> true; Cons _ _ -> false }
  Cons x rest -> case ys of
    Nil -> false
    Cons y tail -> x == y && equalInts rest tail

equalTag : GTag -> GTag -> Bool
equalTag a b = case a of
  GBot -> case b of { GBot -> true; _ -> false }
  GBotK k -> case b of { GBotK l -> equalKind k l; _ -> false }
  GArr x y -> case b of { GArr z w -> x == z && y == w; _ -> false }
  GCon c xs -> case b of { GCon d ys -> eqString c d && equalInts xs ys; _ -> false }
  GTyCon c k -> case b of { GTyCon d l -> eqString c d && equalKind k l; _ -> false }
  GSkolem c k -> case b of { GSkolem d l -> c == d && equalKind k l; _ -> false }
  GTyApp x y -> case b of { GTyApp z w -> x == z && y == w; _ -> false }
  GGen x -> case b of { GGen y -> x == y; _ -> false }

equalNode : Node -> Node -> Bool
equalNode (Node t b f) (Node u c h) = equalTag t u && equalMaybeInt b c && equalFlag f h

prettyKind : Kind -> String
prettyKind kind = case kind of
  Star -> "*"
  KArrow a b -> (case a of { Star -> "*"; KArrow x y -> "(" ++ prettyKind a ++ ")" }) ++ " -> " ++ prettyKind b

-- Graph unification diagnostics use the seed's derived Kind representation.
kindDescription : Kind -> String
kindDescription kind = case kind of
  Star -> "Star"
  KArrow a b -> "KArrow " ++ kindArgumentDescription a ++ " " ++ kindArgumentDescription b

kindArgumentDescription : Kind -> String
kindArgumentDescription kind = case kind of
  Star -> "Star"
  KArrow a b -> "(" ++ kindDescription kind ++ ")"

applyKind : Kind -> Kind -> Either String Kind
applyKind function argument = case function of
  Star -> Left "invalid type constructor arity: a type of kind * cannot be applied"
  KArrow domain result -> if equalKind domain argument then Right result else Left ("kind mismatch: expected " ++ prettyKind domain ++ ", got " ++ prettyKind argument)

mapMaybeInt : (Int -> Int) -> Maybe Int -> Maybe Int
mapMaybeInt f value = case value of { Nothing -> Nothing; Just n -> Just (f n) }

freshId : Graph -> Pair Int Graph
freshId (Graph ns ls fresh) = Pair fresh (mkGraph ns ls (fresh + 1))

resolve : Graph -> Int -> Int
resolve graph identity = case IM.lookup identity (links graph) of
  Nothing -> identity
  Just representative -> resolve graph representative

nodeAt : Graph -> Int -> Node
nodeAt graph identity = case IM.lookup (resolve graph identity) (nodes graph) of
  Nothing -> panic ("missing graph node " ++ showInt identity)
  Just node -> node

require : Graph -> Int -> Either String Node
require graph identity = case IM.lookup (resolve graph identity) (nodes graph) of
  Nothing -> Left ("missing graph node " ++ showInt identity)
  Just node -> Right node

setNode : Int -> Node -> Graph -> Graph
setNode identity node graph = mkGraph (insertNodeMap (resolve graph identity) node (nodes graph)) (links graph) (nextId graph)

newNode : GTag -> Maybe Int -> Flag -> Graph -> Pair Int Graph
newNode t b f graph = case freshId graph of
  Pair identity next -> Pair identity (setNode identity (mkNode t b f) next)

children : GTag -> List Int
children t = case t of
  GBot -> Nil
  GBotK _ -> Nil
  GArr a b -> Cons a (Cons b Nil)
  GCon c ns -> ns
  GTyCon _ _ -> Nil
  GSkolem _ _ -> Nil
  GTyApp f a -> Cons f (Cons a Nil)
  GGen n -> Cons n Nil

mapTag : (Int -> Int) -> GTag -> GTag
mapTag f t = case t of
  GBot -> GBot
  GBotK k -> GBotK k
  GArr a b -> GArr (f a) (f b)
  GCon c ns -> GCon c (L.map f ns)
  GTyCon c k -> GTyCon c k
  GSkolem n k -> GSkolem n k
  GTyApp a b -> GTyApp (f a) (f b)
  GGen n -> GGen (f n)

bottomTag : Kind -> GTag
bottomTag kind = case kind of { Star -> GBot; _ -> GBotK kind }
isBottom : GTag -> Bool
isBottom t = case t of { GBot -> true; GBotK _ -> true; _ -> false }
isGen : GTag -> Bool
isGen t = case t of { GGen _ -> true; _ -> false }

genRoot : Graph -> Int -> Int
genRoot graph identity = case tag (nodeAt graph identity) of
  GGen root -> resolve graph root
  _ -> panic "internal invariant: expected a generalization node"

-- A cache is shared across all roots, but only completed nodes are inserted.
kindVisit : Graph -> IntSet -> IntMap Kind -> Int -> Either String (Pair Kind (IntMap Kind))
kindVisit graph path known original =
  let identity = resolve graph original in
  case IM.lookup identity known of
    Just kind -> Right (Pair kind known)
    Nothing -> if IS.member identity path then Left "infinite type (occurs check)" else
      bindE (require graph identity) (\node ->
        bindE (kindTag graph (IS.insert identity path) known (tag node)) (\answer ->
          case answer of Pair kind cache -> Right (Pair kind (IM.insert identity kind cache))))

kindTag : Graph -> IntSet -> IntMap Kind -> GTag -> Either String (Pair Kind (IntMap Kind))
kindTag graph path known t = case t of
  GBot -> Right (Pair Star known)
  GBotK k -> Right (Pair k known)
  GTyCon c k -> Right (Pair k known)
  GSkolem n k -> Right (Pair k known)
  GGen n -> kindVisit graph path known n
  GArr a b -> bindE (kindVisit graph path known a) (\first -> case first of
    Pair ka next -> bindE (kindVisit graph path next b) (\second -> case second of
      Pair kb final -> if equalKind ka Star && equalKind kb Star then Right (Pair Star final) else Left "function types require kind * arguments"))
  GCon c ns -> bindE (foldE (\cache -> \n -> bindE (kindVisit graph path cache n) (\answer -> case answer of
    Pair kind next -> if equalKind kind Star then Right next else Left "legacy type constructor has a non-* argument")) known ns) (\cache -> Right (Pair Star cache))
  GTyApp f a -> bindE (kindVisit graph path known f) (\first -> case first of
    Pair kf next -> bindE (kindVisit graph path next a) (\second -> case second of
      Pair ka final -> bindE (applyKind kf ka) (\kind -> Right (Pair kind final))))

kindsAt : Graph -> List Int -> Either String (IntMap Kind)
kindsAt graph starts = foldE (\known -> \identity -> bindE (kindVisit graph IS.empty known identity) (\answer -> case answer of Pair kind cache -> Right cache)) IM.empty starts

kindAt : Graph -> Int -> Either String Kind
kindAt graph start = bindE (kindVisit graph IS.empty IM.empty start) (\answer -> case answer of Pair kind cache -> Right kind)

reachableVisit : Graph -> IntSet -> List Int -> IntSet
reachableVisit graph seen pending = case pending of
  Nil -> seen
  Cons original rest -> let identity = resolve graph original in
    if IS.member identity seen then reachableVisit graph seen rest else
    reachableVisit graph (IS.insert identity seen) (L.append (children (tag (nodeAt graph identity))) rest)

reachable : Graph -> Int -> IntSet
reachable graph start = reachableVisit graph IS.empty (Cons start Nil)

-- Validation asks about one node. Match the seed's visited search, stopping
-- at the first successful path instead of materializing every descendant.
containsVisit : Graph -> Int -> IntSet -> List Int -> Bool
containsVisit graph wanted seen pending = case pending of
  Nil -> false
  Cons original rest -> let identity = resolve graph original in
    if identity == wanted then true else
    if IS.member identity seen then containsVisit graph wanted seen rest else
    containsVisit graph wanted (IS.insert identity seen) (L.append (children (tag (nodeAt graph identity))) rest)

structurallyContains : Graph -> Int -> Int -> Bool
structurallyContains graph parent target = containsVisit graph (resolve graph target) IS.empty (Cons parent Nil)

underBinderStep : Graph -> Int -> Maybe Int -> Bool
underBinderStep graph wanted current = case current of
  Nothing -> false
  Just parent -> if resolve graph parent == wanted then true else underBinderStep graph wanted (binder (nodeAt graph parent))

underBinder : Graph -> Int -> Int -> Bool
underBinder graph identity ancestor = underBinderStep graph (resolve graph ancestor) (binder (nodeAt graph identity))

bindingChildrenMap : Graph -> IntMap (List Int)
bindingChildrenMap graph = L.foldlStrict (\table -> \entry -> case entry of { Pair n v -> case binder v of { Nothing -> table; Just parent -> let previous = IM.findWithDefault Nil parent table in seq previous (IM.insert parent (Cons n previous) table) } }) IM.empty (IM.toList (nodes graph))

inertVisit : Graph -> IntMap (List Int) -> IntMap Bool -> Int -> Pair Bool (IntMap Bool)
inertVisit graph descendants known identity = case IM.lookup identity known of
  Just answer -> Pair answer known
  -- A bottom is never inert. Match the seed's short-circuiting conjunction:
  -- even constructing the binding index is unnecessary for this query.
  Nothing -> if isBottom (tag (nodeAt graph identity)) then
    strictPair false (IM.insert identity false known)
  else
    let flexibleChildren = L.filter (\child -> equalFlag (flag (nodeAt graph child)) Flexible) (IM.findWithDefault Nil identity descendants) in
    case L.foldlStrict (\state -> \child -> case state of { Pair answer cache -> if answer then case inertVisit graph descendants cache child of { Pair childAnswer next -> strictPair childAnswer next } else state }) (Pair true known) flexibleChildren of
      Pair answer cache -> strictPair answer (IM.insert identity answer cache)

inertNodes : Graph -> IntMap Bool
inertNodes graph =
  let descendants = bindingChildrenMap graph in
  L.foldlStrict (\known -> \n -> case inertVisit graph descendants known n of { Pair answer cache -> cache }) IM.empty (IM.keys (nodes graph))

inert : Graph -> Int -> Bool
inert graph original = case inertVisit graph (bindingChildrenMap graph) IM.empty (resolve graph original) of
  Pair answer known -> answer

flexiblePath : Graph -> Int -> Bool
flexiblePath graph identity = case nodeAt graph identity of
  Node (GGen root) b f -> true
  Node t b Rigid -> false
  Node t b Flexible -> case b of
    Nothing -> true
    Just parent -> flexiblePath graph parent

flexiblePathVisit : Graph -> IntMap Bool -> Int -> Pair Bool (IntMap Bool)
flexiblePathVisit graph known identity = case IM.lookup identity known of
  Just answer -> Pair answer known
  Nothing ->
    let answer = case nodeAt graph identity of
          Node (GGen root) b f -> Pair true known
          Node t b Rigid -> Pair false known
          Node t b Flexible -> case b of
            Nothing -> Pair true known
            Just parent -> flexiblePathVisit graph known parent in
    case answer of Pair value cache -> strictPair value (IM.insert identity value cache)

permissions : Graph -> IntMap Permission
permissions graph =
  let inertness = inertNodes graph in
  let paths = L.foldlStrict (\known -> \n -> case flexiblePathVisit graph known n of { Pair answer cache -> cache }) IM.empty (IM.keys (nodes graph)) in
  IM.mapWithKey (\n -> \v -> if IM.findWithDefault false n inertness then Inert else
    if equalFlag (flag v) Rigid then Orange else if IM.findWithDefault false n paths then Green else Red) (nodes graph)

permission : Graph -> Int -> Permission
permission graph identity = if inert graph identity then Inert else
  if equalFlag (flag (nodeAt graph identity)) Rigid then Orange else
  if flexiblePath graph identity then Green else Red

-- Validating the binding tree before using ancestry makes sparse identities
-- and disconnected cycles as safe as dense source-generated graphs.
bindingVisitIndexed : IntMap (List Int) -> Int -> Pair Int (IntMap (Pair Int Int)) -> Pair Int (IntMap (Pair Int Int))
bindingVisitIndexed descendants identity state = case state of
  Pair start known ->
    case L.foldlStrict (\current -> \n -> bindingVisitIndexed descendants n current) (strictPair (start + 1) known) (IM.findWithDefault Nil identity descendants) of
      Pair end final -> strictPair end (IM.insert identity (strictPair start end) final)

bindingVisit : Graph -> Int -> Pair Int (IntMap (Pair Int Int)) -> Pair Int (IntMap (Pair Int Int))
bindingVisit graph identity state = bindingVisitIndexed (bindingChildrenMap graph) identity state

bindingIntervals : Graph -> Either String (IntMap (Pair Int Int))
bindingIntervals graph =
  let roots = L.filter (\entry -> case entry of Pair n v -> equalMaybeInt (binder v) Nothing) (IM.toList (nodes graph)) in
  case roots of
    Cons (Pair root node) Nil ->
      bindE (mapE_ (\entry -> case entry of { Pair n v -> case binder v of { Nothing -> Right Unit; Just b -> check (IM.member b (nodes graph)) "missing binder" } }) (IM.toList (nodes graph))) (\ignored ->
          case bindingVisit graph root (Pair 0 IM.empty) of
            Pair count intervals -> if count == IM.size (nodes graph) then Right intervals else Left "cyclic binding tree")
    _ -> Left "graph must have one binding root"

intervalContains : IntMap (Pair Int Int) -> Int -> Int -> Bool
intervalContains intervals ancestor identity = case IM.lookup ancestor intervals of
  Nothing -> false
  Just (Pair start end) -> case IM.lookup identity intervals of
    Nothing -> false
    Just (Pair position ignored) -> start <= position && position < end

validateNodeBinder : Graph -> Pair Int Node -> Either String Unit
validateNodeBinder graph (Pair identity node) = case binder node of
  Nothing -> check (isGen (tag node)) "binding root must be a gen node"
  Just parent -> bindE (require graph parent) (\p -> if isGen (tag p) || L.any (\child -> resolve graph child == identity) (children (tag p)) then Right Unit else check (structurallyContains graph parent identity) "a type binder must structurally contain its node")

validateChild : Graph -> IntMap (Pair Int Int) -> Int -> Int -> Either String Unit
validateChild graph intervals parent child = bindE (require graph child) (\node ->
  if isGen (tag node) then Left "gen nodes cannot be structural children" else case binder node of
    Nothing -> Left "structural child has no binder"
    Just b -> check (intervalContains intervals b parent) "ill-dominated type graph")

validateEdges : Graph -> IntMap (Pair Int Int) -> Pair Int Node -> Either String Unit
validateEdges graph intervals (Pair identity node) =
  if isGen (tag node) && L.not (equalFlag (flag node) Flexible) then Left "gen nodes must be flexible" else
  bindE (mapE_ (validateChild graph intervals identity) (children (tag node))) (\ignored -> Right Unit)

-- A bounded span keeps local scratch storage proportional to the graph even
-- when public graph identities are sparse or arbitrary-precision integers.
denseDisjoint : forall a b. IntMap a -> IntMap b -> Bool
denseDisjoint left right = case left of
  IntMap leftTree -> case right of
    IntMap rightTree -> if IM.size left <= IM.size right then denseNoKeys leftTree rightTree else denseNoKeys rightTree leftTree

denseNoKeys : forall a b. Map Int a -> Map Int b -> Bool
denseNoKeys smaller larger = case smaller of
  MapEmpty -> true
  MapNode count key value left right ->
    L.not (IM.memberTree key larger) && denseNoKeys left larger && denseNoKeys right larger

denseBounds : Graph -> Maybe (Pair Int Int)
denseBounds graph = case IM.lookupMin (nodes graph) of
  Nothing -> Nothing
  Just (Pair low first) -> case IM.lookupMax (nodes graph) of
    Nothing -> Nothing
    Just (Pair high last) ->
      if high - low <= 8 * IM.size (nodes graph) && denseDisjoint (nodes graph) (links graph)
      then Just (Pair low high) else Nothing

readDense : forall s a. Int -> STArray s a -> Int -> ST s a
readDense low array identity = readSTArray array (identity - low)

writeDense : forall s a. Int -> STArray s a -> Int -> a -> ST s Unit
writeDense low array identity value = writeSTArray array (identity - low) value

-- The seed uses unboxed scratch integers. Keep that demand explicit while
-- the general STArray facility correctly retains lazy arbitrary element types.
writeDenseInt : forall s. Int -> STArray s Int -> Int -> Int -> ST s Unit
writeDenseInt low array identity value = seq value (writeDense low array identity value)

validateGraph : Graph -> Either String Unit
validateGraph graph = case denseBounds graph of
  Nothing -> validateSparse graph
  Just (Pair low high) -> validateDense graph low high

data DenseValidation s = DenseValidation Graph Int Int (STArray s (Maybe Node)) (STArray s (List Int)) (STArray s Int) (STArray s Kind) (STArray s Int) (STArray s Int) (STArray s Int)

validateDense : Graph -> Int -> Int -> Either String Unit
validateDense graph low high = runST (denseValidation graph low high)

denseValidation : forall s. Graph -> Int -> Int -> ST s (Either String Unit)
denseValidation graph low high =
  let count = high - low + 1 in
  stBind (newSTArray count Nothing) (\table ->
  stBind (newSTArray count Nil) (\descendants ->
  stBind (newSTArray count 0) (\colours ->
  stBind (newSTArray count Star) (\kinds ->
  stBind (newSTArray count (0 - 1)) (\starts ->
  stBind (newSTArray count (0 - 1)) (\ends ->
  stBind (newSTArray count (0 - 1)) (\visited ->
    let state = DenseValidation graph low high table descendants colours kinds starts ends visited in
    let entries = IM.toList (nodes graph) in
    stBind (denseLoadValidation low table entries) (\loaded ->
      denseValidateEntries state entries))))))))

denseGetNode : forall s. DenseValidation s -> Int -> ST s (Maybe Node)
denseGetNode (DenseValidation graph low high table descendants colours kinds starts ends visited) n =
  if n < low || high < n then stReturn Nothing else readDense low table n

denseRequire : forall s. DenseValidation s -> Int -> ST s (Either String Node)
denseRequire state n = stBind (denseGetNode state n) (\answer -> case answer of
  Nothing -> ST.failE ("missing graph node " ++ showInt n)
  Just value -> ST.pureE value)

denseCheckBinder : forall s. DenseValidation s -> Pair Int Node -> ST s (Either String Unit)
denseCheckBinder state (Pair n v) = case binder v of
  Nothing -> ST.pureE Unit
  Just b -> stBind (denseGetNode state b) (\answer -> case answer of
    Nothing -> ST.failE "missing binder"
    Just ignored -> ST.pureE Unit)

denseAddDescendant : forall s. DenseValidation s -> Pair Int Node -> ST s Unit
denseAddDescendant (DenseValidation graph low high table descendants colours kinds starts ends visited) (Pair n v) = case binder v of
  Nothing -> stReturn Unit
  Just b -> stBind (readDense low descendants b) (\previous -> writeDense low descendants b (Cons n previous))

denseBindingVisit : forall s. DenseValidation s -> Int -> Int -> ST s Int
denseBindingVisit state n position = case state of
  DenseValidation graph low high table descendants colours kinds starts ends visited ->
    stBind (writeDenseInt low starts n position) (\ignored ->
    stBind (readDense low descendants n) (\children ->
    stBind (denseBindingChildren state (position + 1) children) (\end ->
    stBind (writeDenseInt low ends n end) (\written -> stReturn end))))

denseContains : forall s. DenseValidation s -> Int -> Int -> ST s Bool
denseContains (DenseValidation graph low high table descendants colours kinds starts ends visited) ancestor n =
  stBind (readDense low starts ancestor) (\a ->
  stBind (readDense low ends ancestor) (\b ->
  stBind (readDense low starts n) (\p -> stReturn (a <= p && p < b))))

denseStructurally : forall s. DenseValidation s -> Int -> Int -> List Int -> ST s (Either String Bool)
denseStructurally state wanted stamp pending = case pending of
  Nil -> ST.pureE false
  Cons original rest -> case state of
    DenseValidation graph low high table descendants colours kinds starts ends visited ->
      let n = resolve graph original in
      if n == wanted then ST.pureE true else
        ST.bindE (denseRequire state n) (\v ->
        stBind (readDense low visited n) (\mark ->
          if mark == stamp then denseStructurally state wanted stamp rest else
            stBind (writeDenseInt low visited n stamp) (\written ->
              denseStructurally state wanted stamp (L.append (children (tag v)) rest))))

denseValidateEntries : forall s. DenseValidation s -> List (Pair Int Node) -> ST s (Either String Unit)
denseValidateEntries state entries =
  case L.filter (\entry -> case entry of Pair n v -> case binder v of { Nothing -> true; Just ignored -> false }) entries of
    Cons (Pair root value) Nil ->
      ST.bindE (denseCheckBinders state entries) (\binders ->
      stBind (denseAddDescendants state entries) (\loaded ->
      stBind (denseBindingVisit state root 0) (\count ->
        if count == L.length entries
        then denseKindEntries state entries
        else ST.failE "cyclic binding tree")))
    _ -> ST.failE "graph must have one binding root"

-- Each structural edge is checked even if the child's kind is already cached.
denseChild : forall s. DenseValidation s -> Int -> Int -> ST s (Either String Kind)
denseChild state parent original = case state of
  DenseValidation graph low high table descendants colours kinds starts ends visited ->
    let n = resolve graph original in
    ST.bindE (denseRequire state n) (\v ->
      if isGen (tag v) then ST.failE "gen nodes cannot be structural children" else
        case binder v of
          Nothing -> ST.failE "structural child has no binder"
          Just b -> stBind (denseContains state b parent) (\dominated ->
            if dominated then denseKind state n v else ST.failE "ill-dominated type graph"))

denseKindBinder : forall s. DenseValidation s -> Int -> Node -> ST s (Either String Unit)
denseKindBinder state n v = case binder v of
  Nothing -> ST.check (isGen (tag v)) "binding root must be a gen node"
  Just b -> ST.bindE (denseRequire state b) (\parent ->
    if isGen (tag parent) then ST.pureE Unit else case state of
      DenseValidation graph low high table descendants colours kinds starts ends visited ->
        if L.any (\child -> resolve graph child == n) (children (tag parent)) then ST.pureE Unit else
          stBind (readDense low starts n) (\stamp ->
          ST.bindE (denseStructurally state n stamp (Cons b Nil)) (\found ->
            ST.check found "a type binder must structurally contain its node")))

denseKind : forall s. DenseValidation s -> Int -> Node -> ST s (Either String Kind)
denseKind state n v = case state of
  DenseValidation graph low high table descendants colours kinds starts ends visited ->
    stBind (readDense low colours n) (\colour ->
      if colour == 1 then ST.failE "infinite type (occurs check)" else
      if colour == 2 then ST.liftE (readDense low kinds n) else
        stBind (writeDenseInt low colours n 1) (\active ->
        ST.bindE (denseKindBinder state n v) (\bound ->
        ST.bindE (denseTagKind state n v) (\kind ->
        stBind (writeDense low kinds n kind) (\stored ->
        stBind (writeDenseInt low colours n 2) (\complete -> ST.pureE kind))))))

denseTagKind : forall s. DenseValidation s -> Int -> Node -> ST s (Either String Kind)
denseTagKind state n v = case tag v of
  GBot -> ST.pureE Star
  GBotK kind -> ST.pureE kind
  GTyCon name kind -> ST.pureE kind
  GSkolem identity kind -> ST.pureE kind
  GGen child -> if equalFlag (flag v) Flexible then denseChild state n child else ST.failE "gen nodes must be flexible"
  GArr a b -> ST.bindE (denseChild state n a) (\ka ->
    ST.bindE (denseChild state n b) (\kb ->
      if equalKind ka Star && equalKind kb Star then ST.pureE Star
      else ST.failE "function types require kind * arguments"))
  GCon name children -> ST.bindE (denseChildKinds state n children) (\kinds ->
    if L.all (\kind -> equalKind kind Star) kinds then ST.pureE Star
    else ST.failE "legacy type constructor has a non-* argument")
  GTyApp function argument -> ST.bindE (denseChild state n function) (\kf ->
    ST.bindE (denseChild state n argument) (\ka -> stReturn (applyKind kf ka)))

validateSparse : Graph -> Either String Unit
validateSparse graph =
  bindE (kindsAt graph (IM.keys (nodes graph))) (\kinds ->
    bindE (bindingIntervals graph) (\intervals ->
      bindE (mapE_ (validateNodeBinder graph) (IM.toList (nodes graph))) (\ignored ->
        bindE (mapE_ (validateEdges graph intervals) (IM.toList (nodes graph))) (\ignored2 -> Right Unit))))

tagDescription : GTag -> String
tagDescription t = case t of
  GBot -> "Bot"
  GBotK kind -> "BotK (" ++ prettyKind kind ++ ")"
  GArr a b -> "Arr " ++ showInt a ++ " " ++ showInt b
  GCon name arguments -> "Con \"" ++ name ++ "\" [" ++ L.intercalate "," (L.map showInt arguments) ++ "]"
  GTyCon name kind -> "TyCon \"" ++ name ++ "\" (" ++ prettyKind kind ++ ")"
  GSkolem identity kind -> "Skolem " ++ showInt identity ++ " (" ++ prettyKind kind ++ ")"
  GTyApp f a -> "TyApp " ++ showInt f ++ " " ++ showInt a
  GGen n -> "Gen " ++ showInt n

typeMismatch : GTag -> GTag -> Either String (Pair GTag (List (Pair Int Int)))
typeMismatch a b = Left ("type constructor mismatch: " ++ tagDescription a ++ " versus " ++ tagDescription b)

tagEquations : GTag -> GTag -> Either String (Pair GTag (List (Pair Int Int)))
tagEquations a b = if isGen a || isGen b then Left "cannot unify generalization nodes" else
  if isBottom a then Right (Pair b Nil) else if isBottom b then Right (Pair a Nil) else case a of
    GArr x y -> case b of
      GArr z w -> Right (Pair a (Cons (Pair x z) (Cons (Pair y w) Nil)))
      _ -> typeMismatch a b
    GCon c xs -> case b of
      GCon d ys -> if eqString c d && L.length xs == L.length ys then Right (Pair a (L.zip xs ys)) else typeMismatch a b
      _ -> typeMismatch a b
    GTyCon c k -> case b of
      GTyCon d l -> if eqString c d && equalKind k l then Right (Pair a Nil) else typeMismatch a b
      _ -> typeMismatch a b
    GSkolem c k -> case b of
      GSkolem d l -> if c == d && equalKind k l then Right (Pair a Nil) else typeMismatch a b
      _ -> typeMismatch a b
    GTyApp f x -> case b of
      GTyApp h y -> Right (Pair a (Cons (Pair f h) (Cons (Pair x y) Nil)))
      _ -> typeMismatch a b
    _ -> typeMismatch a b

firstOrder : IntMap Kind -> Graph -> Pair Int Int -> Either String Graph
firstOrder kinds graph (Pair left right) =
  let a = resolve graph left in
  let b = resolve graph right in
  if a == b then Right graph else
    case IM.lookup a kinds of
      Nothing -> Left "missing unification kind"
      Just ka -> case IM.lookup b kinds of
        Nothing -> Left "missing unification kind"
        Just kb -> if L.not (equalKind ka kb) then Left ("kind mismatch during unification: " ++ kindDescription ka ++ " versus " ++ kindDescription kb) else
          bindE (tagEquations (tag (nodeAt graph a)) (tag (nodeAt graph b))) (\answer -> case answer of
            Pair newTag equations ->
              let winner = if a < b then a else b in
              let loser = if a < b then b else a in
              let old = nodeAt graph a in
              let next = mkGraph (insertNodeMap winner (mkNode newTag (binder old) (flag old)) (IM.delete loser (nodes graph))) (IM.insert loser winner (links graph)) (nextId graph) in
              foldE (firstOrder kinds) next equations)

canonicalize : Graph -> Graph
canonicalize graph = mkGraph (mapNodes (\node -> mkNode (mapTag (resolve graph) (tag node)) (binder node) (flag node)) (nodes graph)) (links graph) (nextId graph)

equationNodes : Pair Int Int -> List Int
equationNodes (Pair a b) = Cons a (Cons b Nil)

-- This query is used only after complete validation, on an alias-free graph
-- whose distinct ascending enumeration agrees with ordered-map lookup.
-- Validation already establishes the *-kind premises of arrows and legacy
-- constructors. Higher-kinded nodes, Gen roots and applications retain their
-- explicit kinds. Type-application graphs keep the existing shared kind cache,
-- avoiding repeated traversal of shared higher-kinded subgraphs.
validatedKind : Graph -> Int -> Either String Kind
validatedKind graph identity = bindE (require graph identity) (\node -> case tag node of
  GBot -> Right Star
  GBotK kind -> Right kind
  GTyCon name kind -> Right kind
  GSkolem identity kind -> Right kind
  GArr a b -> Right Star
  GCon name arguments -> Right Star
  GGen root -> validatedKind graph root
  GTyApp function argument -> kindAt graph identity)

simpleKindTag : Node -> Bool
simpleKindTag node = case tag node of
  GTyApp function argument -> false
  _ -> true

orderedSimpleKinds : List (Pair Int Node) -> Bool
orderedSimpleKinds entries = case entries of
  Nil -> true
  Cons (Pair first node) rest -> simpleKindTag node && orderedSimpleKindsAfter first rest
orderedSimpleKindsAfter : Int -> List (Pair Int Node) -> Bool
orderedSimpleKindsAfter previous entries = case entries of
  Nil -> true
  Cons (Pair next node) rest -> previous < next && simpleKindTag node && orderedSimpleKindsAfter next rest

firstOrderValidated : Graph -> Graph -> Pair Int Int -> Either String Graph
firstOrderValidated original graph (Pair left right) =
  let a = resolve graph left in
  let b = resolve graph right in
  if a == b then Right graph else
    bindE (validatedKind original a) (\ka ->
      bindE (validatedKind original b) (\kb ->
        if L.not (equalKind ka kb) then Left ("kind mismatch during unification: " ++ kindDescription ka ++ " versus " ++ kindDescription kb) else
          bindE (tagEquations (tag (nodeAt graph a)) (tag (nodeAt graph b))) (\answer -> case answer of
            Pair newTag equations ->
              let winner = if a < b then a else b in
              let loser = if a < b then b else a in
              let old = nodeAt graph a in
              let next = mkGraph (insertNodeMap winner (mkNode newTag (binder old) (flag old)) (IM.delete loser (nodes graph))) (IM.insert loser winner (links graph)) (nextId graph) in
              foldE (firstOrderValidated original) next equations)))

checkedFirstOrder : List (Pair Int Int) -> Graph -> Either String Graph
checkedFirstOrder equations before =
  if IM.null (links before) && orderedSimpleKinds (IM.toList (nodes before)) then
    -- The preceding eager kind traversal checks every input identity before
    -- any merge. Preserve that error priority even when an earlier pair would
    -- fail constructor/kind equality. All structural premises were validated.
    bindE (mapE_ (\n -> bindE (require before n) (\ignored -> Right Unit)) (L.concatMap equationNodes equations)) (\checked ->
      foldE (firstOrderValidated before) before equations)
  else bindE (kindsAt before (L.concatMap equationNodes equations)) (\kinds ->
    foldE (firstOrder kinds) before equations)

unify : List (Pair Int Int) -> Graph -> Either String Graph
unify equations before = bindE (validateGraph before) (\ignored ->
  bindE (checkedFirstOrder equations before) (\skeleton ->
    bindE (rebind before (canonicalize skeleton)) (\rebuilt ->
      bindE (validateGraph rebuilt) (\verified -> Right rebuilt))))

graftedNodes : Graph -> Graph -> IntSet
graftedNodes old skeleton = L.foldlStrict (\seen -> \entry -> case entry of { Pair n v -> if isBottom (tag v) then reachableVisit skeleton seen (children (tag (nodeAt skeleton n))) else seen }) IS.empty (IM.toList (nodes old))

classesIndex : Graph -> Graph -> IntMap (List Int)
classesIndex old skeleton = L.foldlStrict (\classes -> \n -> IM.insertWith L.append (resolve skeleton n) (Cons n Nil) classes) IM.empty (IM.keys (nodes old))

parentsIndex : Graph -> IntMap IntSet
parentsIndex graph = L.foldlStrict (\index -> \entry -> case entry of { Pair parent node -> L.foldlStrict (\known -> \child -> let identity = resolve graph child in let parents = IS.insert parent (IM.findWithDefault IS.empty identity known) in seq parents (IM.insert identity parents known)) index (children (tag node)) }) IM.empty (IM.toList (nodes graph))

flagsIndex : Graph -> IntMap (List Int) -> IntMap Flag
flagsIndex old classes = IM.map (\members -> if L.any (\n -> equalFlag (flag (nodeAt old n)) Rigid) members then Rigid else Flexible) classes

candidateIndex : Graph -> Graph -> IntMap (List Int) -> IntMap IntSet -> IntSet -> IntMap (List Int)
candidateIndex old skeleton classes parents grafted = IM.mapWithKey (\n -> \members ->
  let originalParents = L.foldlStrict (\seen -> \member -> case binder (nodeAt old member) of { Nothing -> seen; Just b -> IS.insert (resolve skeleton b) seen }) IS.empty members in
  IS.toList (if IS.member n grafted then IS.union originalParents (IM.findWithDefault IS.empty n parents) else originalParents)) classes

bindingPath : IntMap (Maybe Int) -> Int -> List Int
bindingPath tree identity = case IM.lookup identity tree of
  Nothing -> Cons identity Nil
  Just Nothing -> Cons identity Nil
  Just (Just parent) -> Cons identity (bindingPath tree parent)

commonAncestor : IntMap (Maybe Int) -> List Int -> Either String (Maybe Int)
commonAncestor tree candidates = case candidates of
  Nil -> Right Nothing
  Cons first rest -> case L.find (\candidate -> L.all (\other -> L.any (\ancestor -> ancestor == candidate) (bindingPath tree other)) rest) (bindingPath tree first) of
    Nothing -> Left "binders have no common ancestor"
    Just ancestor -> Right (Just ancestor)

buildBindingTree : IntMap (List Int) -> IntMap (List Int) -> Int -> IntMap (Maybe Int) -> IntMap Int -> IntSet -> Either String (IntMap (Maybe Int))
buildBindingTree candidates dependents total tree counts ready = case IS.minView ready of
  Nothing -> if IM.size tree == total then Right tree else Left "cyclic structure/binding dependencies"
  Just (Pair identity remaining) -> bindE (commonAncestor tree (IM.findWithDefault Nil identity candidates)) (\parent ->
    case L.foldlStrict releaseDependency (Pair counts remaining) (IM.findWithDefault Nil identity dependents) of
      Pair nextCounts nextReady -> buildBindingTree candidates dependents total (IM.insert identity parent tree) nextCounts nextReady)

releaseDependency : Pair (IntMap Int) IntSet -> Int -> Pair (IntMap Int) IntSet
releaseDependency (Pair counts ready) child =
  let count = IM.get child counts - 1 in
  strictPair (IM.insert child count counts) (if count == 0 then IS.insert child ready else ready)

rebuildBinders : IntMap (List Int) -> IntMap IntSet -> Either String (IntMap (Maybe Int))
rebuildBinders candidates dependencies =
  let counts = IM.map IS.size dependencies in
  let ready = IS.fromList (IM.keys (IM.filter (\n -> n == 0) counts)) in
  let dependents = L.foldlStrict (\index -> \entry -> case entry of { Pair n ds -> L.foldlStrict (\known -> \dependency -> IM.insertWith L.append dependency (Cons n Nil) known) index (IS.toList ds) }) IM.empty (IM.toList dependencies) in
  buildBindingTree candidates dependents (IM.size candidates) IM.empty counts ready

raisedBinderClimb : Graph -> Graph -> Int -> Maybe Int -> Either String (Maybe Int)
raisedBinderClimb old skeleton wanted current = case current of
  Nothing -> Left "a node's binder cannot be lowered"
  Just parent -> if resolve skeleton parent == wanted then Right (Just parent) else raisedBinderClimb old skeleton wanted (binder (nodeAt old parent))

raisedBinder : Graph -> Graph -> IntMap (Maybe Int) -> Pair Int Node -> Either String (Pair Int (Maybe Int))
raisedBinder old skeleton tree (Pair n v) = case IM.lookup (resolve skeleton n) tree of
  Nothing -> Left "missing rebuilt binder"
  Just Nothing -> Right (Pair n Nothing)
  Just (Just wanted) -> bindE (raisedBinderClimb old skeleton wanted (binder v)) (\parent -> Right (Pair n parent))

checkOriginalPermission : Graph -> IntMap Permission -> IntMap Permission -> IntMap Flag -> IntMap (Maybe Int) -> Pair Int Node -> Either String Unit
checkOriginalPermission skeleton oldPermissions raisedPermissions newFlags up (Pair identity node) =
  let oldPermission = IM.get identity oldPermissions in
  let raisedPermission = IM.get identity raisedPermissions in
  let image = resolve skeleton identity in
  let lifted = IM.findWithDefault Nothing identity up in
  if isBottom (tag node) && L.not (isBottom (tag (nodeAt skeleton identity))) && L.not (equalPermission oldPermission Green) then Left "cannot instantiate a rigid or protected type variable" else
  if equalPermission oldPermission Red && L.not (equalMaybeInt (binder node) lifted) then Left "cannot raise a protected type variable" else
  if equalPermission raisedPermission Red && L.not (equalFlag (flag node) (IM.get image newFlags)) then Left "cannot weaken a protected type variable" else Right Unit

checkMergePairs : IntMap Permission -> IntMap (Maybe Int) -> List Int -> Either String Unit
checkMergePairs raisedPermissions up members = case members of
  Nil -> Right Unit
  Cons first rest ->
    bindE (mapE_ (\other ->
      if equalMaybeInt (IM.findWithDefault Nothing first up) (IM.findWithDefault Nothing other up) && (equalPermission (IM.get first raisedPermissions) Red || equalPermission (IM.get other raisedPermissions) Red)
      then Left "cannot merge distinct protected type variables" else Right Unit) rest) (\ignored -> checkMergePairs raisedPermissions up rest)

rebind : Graph -> Graph -> Either String Graph
rebind old skeleton = case denseBounds old of
  Nothing -> rebindSparse old skeleton
  Just (Pair low high) -> rebindDense old skeleton low high

-- All tables share an offset. Graph identities themselves remain arbitrary
-- precision; the dense guard limits only the number of allocated cells.
data DenseRebinding s = DenseRebinding Graph Graph Int Int (STArray s (Maybe Node)) (STArray s (Maybe Node)) (STArray s Int) (STArray s (List Int)) (STArray s Flag) (STArray s (List Int)) (STArray s (Maybe Int)) (STArray s Int) (STArray s Int) (STArray s Int) (STArray s (Maybe Int)) (STArray s (Maybe Int))

rebindDense : Graph -> Graph -> Int -> Int -> Either String Graph
rebindDense old skeleton low high = runST (denseRebinding old skeleton low high)

denseRebinding : forall s. Graph -> Graph -> Int -> Int -> ST s (Either String Graph)
denseRebinding old skeleton low high =
  let count = high - low + 1 in
  stBind (newSTArray count Nothing) (\oldNodes ->
  stBind (newSTArray count Nothing) (\newNodes ->
  stBind (newSTArray count 0) (\images ->
  stBind (newSTArray count Nil) (\classes ->
  stBind (newSTArray count Flexible) (\flags ->
  stBind (newSTArray count Nil) (\parents ->
  stBind (newSTArray count Nothing) (\tree ->
  stBind (newSTArray count 0) (\depths ->
  stBind (newSTArray count 0) (\colours ->
  stBind (newSTArray count 0) (\grafted ->
  stBind (newSTArray count Nothing) (\oldBinders ->
  stBind (newSTArray count Nothing) (\raised ->
    let state = DenseRebinding old skeleton low high oldNodes newNodes images classes flags parents tree depths colours grafted oldBinders raised in
    let originals = IM.toList (nodes old) in
    let remaining = IM.toList (nodes skeleton) in
    stBind (denseLoadOriginals state originals) (\loadedOld ->
    stBind (denseLoadRemainings state remaining) (\loadedNew ->
    stBind (denseMarkOriginals state originals) (\marked ->
    ST.bindE (densePlaceEntries state remaining) (\placed ->
    ST.bindE (denseFinalNodes state remaining) (\final ->
    ST.bindE (denseRaiseOriginals state originals) (\up ->
    stBind (newDensePermissions low high oldNodes oldBinders originals) (\oldPermissions ->
    stBind (newDensePermissions low high oldNodes raised originals) (\raisedPermissions ->
    ST.bindE (denseCheckOriginals state oldPermissions raisedPermissions originals) (\checked ->
    ST.bindE (denseCheckMergeEntries low classes raised raisedPermissions remaining) (\merged ->
      ST.pureE (mkGraph (nodesFromDistinctAscList final) (links skeleton) (nextId skeleton))))))))))))))))))))))))

denseTableNode : forall s. Int -> STArray s (Maybe Node) -> Int -> ST s Node
denseTableNode low table n = stBind (readDense low table n) (\entry -> case entry of
  Nothing -> panic ("missing graph node " ++ showInt n)
  Just v -> stReturn v)

denseLoadOriginal : forall s. DenseRebinding s -> Pair Int Node -> ST s Unit
denseLoadOriginal state (Pair n v) = case state of
  DenseRebinding old skeleton low high oldNodes newNodes images classes flags parents tree depths colours grafted oldBinders raised ->
    let image = resolve skeleton n in
    stBind (writeDense low oldNodes n (Just v)) (\node ->
    stBind (writeDense low oldBinders n (binder v)) (\bound ->
    stBind (writeDense low images n image) (\mapped ->
    stBind (readDense low classes image) (\previous ->
    stBind (writeDense low classes image (Cons n previous)) (\added ->
      if equalFlag (flag v) Rigid then writeDense low flags image Rigid else stReturn Unit)))))

denseLoadRemaining : forall s. DenseRebinding s -> Pair Int Node -> ST s Unit
denseLoadRemaining state (Pair n v) = case state of
  DenseRebinding old skeleton low high oldNodes newNodes images classes flags parents tree depths colours grafted oldBinders raised ->
    stBind (writeDense low newNodes n (Just v)) (\node ->
      denseLoadParents low parents n (children (tag v)))

-- The visited array marks a union of graft descendants once, including when
-- many old bottom nodes become aliases of the same representative.
denseMarkOriginal : forall s. DenseRebinding s -> Pair Int Node -> ST s Unit
denseMarkOriginal state (Pair n v) = if L.not (isBottom (tag v)) then stReturn Unit else case state of
  DenseRebinding old skeleton low high oldNodes newNodes images classes flags parents tree depths colours grafted oldBinders raised ->
    stBind (readDense low images n) (\image ->
    stBind (denseTableNode low newNodes image) (\result ->
      denseMarks state (children (tag result))))

denseMark : forall s. DenseRebinding s -> Int -> ST s Unit
denseMark state n = case state of
  DenseRebinding old skeleton low high oldNodes newNodes images classes flags parents tree depths colours grafted oldBinders raised ->
    stBind (readDense low grafted n) (\seen ->
      if seen == 0 then stBind (writeDenseInt low grafted n 1) (\marked ->
        stBind (denseTableNode low newNodes n) (\v -> denseMarks state (children (tag v))))
      else stReturn Unit)

denseCandidates : forall s. DenseRebinding s -> List Int -> ST s (List Int)
denseCandidates state members = case members of
  Nil -> stReturn Nil
  Cons n rest -> case state of
    DenseRebinding old skeleton low high oldNodes newNodes images classes flags parents tree depths colours grafted oldBinders raised ->
      stBind (readDense low oldBinders n) (\original -> case original of
        Nothing -> denseCandidates state rest
        Just b -> stBind (readDense low images b) (\image ->
          stBind (denseCandidates state rest) (\remaining -> stReturn (Cons image remaining))))

denseParent : forall s. DenseRebinding s -> Int -> ST s (Either String Int)
denseParent state n = case state of
  DenseRebinding old skeleton low high oldNodes newNodes images classes flags parents tree depths colours grafted oldBinders raised ->
    stBind (readDense low tree n) (\parent -> case parent of
      Nothing -> ST.failE "binders have no common ancestor"
      Just b -> ST.pureE b)

denseCommon : forall s. DenseRebinding s -> Int -> Int -> ST s (Either String Int)
denseCommon state a b = if a == b then ST.pureE a else case state of
  DenseRebinding old skeleton low high oldNodes newNodes images classes flags parents tree depths colours grafted oldBinders raised ->
    stBind (readDense low depths a) (\da ->
    stBind (readDense low depths b) (\db ->
      if db < da then ST.bindE (denseParent state a) (\p -> denseCommon state p b) else
      if da < db then ST.bindE (denseParent state b) (\q -> denseCommon state a q) else
        ST.bindE (denseParent state a) (\p ->
        ST.bindE (denseParent state b) (\q -> denseCommon state p q))))

denseCommonMany : forall s. DenseRebinding s -> List Int -> ST s (Either String (Maybe Int))
denseCommonMany state candidates = case candidates of
  Nil -> ST.pureE Nothing
  Cons first rest -> ST.bindE (denseCommonFold state first rest) (\parent -> ST.pureE (Just parent))

densePlace : forall s. DenseRebinding s -> Int -> ST s (Either String Unit)
densePlace state n = case state of
  DenseRebinding old skeleton low high oldNodes newNodes images classes flags parents tree depths colours grafted oldBinders raised ->
    stBind (readDense low colours n) (\colour ->
      if colour == 1 then ST.failE "cyclic structure/binding dependencies" else
      if colour == 2 then ST.pureE Unit else
        stBind (writeDenseInt low colours n 1) (\active ->
        stBind (readDense low grafted n) (\graft ->
        stBind (readDense low parents n) (\ps ->
        stBind (readDense low classes n) (\members ->
        stBind (denseCandidates state members) (\originals ->
          let candidates = L.append originals (if graft == 0 then Nil else ps) in
          ST.bindE (densePlaces state candidates) (\placedCandidates ->
          ST.bindE (densePlaces state ps) (\placedParents ->
          ST.bindE (denseCommonMany state candidates) (\parent ->
          stBind (case parent of { Nothing -> stReturn 0; Just p -> stBind (readDense low depths p) (\depth -> stReturn (depth + 1)) }) (\depth ->
          stBind (writeDense low tree n parent) (\bound ->
          stBind (writeDenseInt low depths n depth) (\measured ->
          stBind (writeDenseInt low colours n 2) (\complete -> ST.pureE Unit)))))))))))))

denseFinalNode : forall s. DenseRebinding s -> Pair Int Node -> ST s (Either String (Pair Int Node))
denseFinalNode state (Pair n v) = case state of
  DenseRebinding old skeleton low high oldNodes newNodes images classes flags parents tree depths colours grafted oldBinders raised ->
    stBind (readDense low tree n) (\parent ->
    stBind (readDense low flags n) (\newFlag ->
      ST.pureE (Pair n (if equalMaybeInt parent (binder v) && equalFlag newFlag (flag v)
        then v else mkNode (tag v) parent newFlag))))

denseClimb : forall s. DenseRebinding s -> Int -> Maybe Int -> ST s (Either String (Maybe Int))
denseClimb state wanted current = case current of
  Nothing -> ST.failE "a node's binder cannot be lowered"
  Just b -> case state of
    DenseRebinding old skeleton low high oldNodes newNodes images classes flags parents tree depths colours grafted oldBinders raised ->
      stBind (readDense low images b) (\image ->
        if image == wanted then ST.pureE (Just b) else
          stBind (readDense low oldBinders b) (\parent -> denseClimb state wanted parent))

denseRaiseOriginal : forall s. DenseRebinding s -> Pair Int Node -> ST s (Either String Unit)
denseRaiseOriginal state (Pair n v) = case state of
  DenseRebinding old skeleton low high oldNodes newNodes images classes flags parents tree depths colours grafted oldBinders raised ->
    stBind (readDense low images n) (\image ->
    stBind (readDense low tree image) (\wanted ->
    ST.bindE (case wanted of { Nothing -> ST.pureE Nothing; Just parent -> denseClimb state parent (binder v) }) (\up ->
      ST.liftE (writeDense low raised n up))))

-- Permission components are memoized on demand, matching the seed's lazy
-- immutable array knot without exporting mutable state out of runST.
data DensePermissions s = DensePermissions Int (STArray s (Maybe Node)) (STArray s (Maybe Int)) (STArray s (List Int)) (STArray s Int) (STArray s Int) (STArray s (Maybe Permission))

newDensePermissions : forall s. Int -> Int -> STArray s (Maybe Node) -> STArray s (Maybe Int) -> List (Pair Int Node) -> ST s (DensePermissions s)
newDensePermissions low high table binding entries =
  let count = high - low + 1 in
  stBind (newSTArray count Nil) (\descendants ->
  stBind (newSTArray count (0 - 1)) (\inertness ->
  stBind (newSTArray count (0 - 1)) (\paths ->
  stBind (newSTArray count Nothing) (\permissions ->
  stBind (densePermissionChildren low binding descendants entries) (\loaded ->
      stReturn (DensePermissions low table binding descendants inertness paths permissions))))))

denseAllInert : forall s. DensePermissions s -> List Int -> ST s Bool
denseAllInert state pending = case pending of
  Nil -> stReturn true
  Cons n rest -> stBind (denseInert state n) (\answer -> if answer then denseAllInert state rest else stReturn false)

denseInert : forall s. DensePermissions s -> Int -> ST s Bool
denseInert state n = case state of
  DensePermissions low table binding descendants inertness paths permissions ->
    stBind (readDense low inertness n) (\cached ->
      if cached >= 0 then stReturn (cached == 1) else
        stBind (denseTableNode low table n) (\v ->
        stBind (if isBottom (tag v) then stReturn false else
          stBind (readDense low descendants n) (\descendants -> denseAllInert state descendants)) (\answer ->
        stBind (writeDenseInt low inertness n (if answer then 1 else 0)) (\stored -> stReturn answer))))

denseFlexiblePath : forall s. DensePermissions s -> Int -> ST s Bool
denseFlexiblePath state n = case state of
  DensePermissions low table binding descendants inertness paths permissions ->
    stBind (readDense low paths n) (\cached ->
      if cached >= 0 then stReturn (cached == 1) else
        stBind (denseTableNode low table n) (\v ->
        stBind (if isGen (tag v) then stReturn true else
          if equalFlag (flag v) Rigid then stReturn false else
            stBind (readDense low binding n) (\parent -> case parent of
              Nothing -> stReturn true
              Just b -> denseFlexiblePath state b)) (\answer ->
        stBind (writeDenseInt low paths n (if answer then 1 else 0)) (\stored -> stReturn answer))))

densePermission : forall s. DensePermissions s -> Int -> ST s Permission
densePermission state n = case state of
  DensePermissions low table binding descendants inertness paths permissions ->
    stBind (readDense low permissions n) (\cached -> case cached of
      Just value -> stReturn value
      Nothing -> stBind (denseInert state n) (\inert ->
        stBind (if inert then stReturn Inert else
          stBind (denseTableNode low table n) (\v ->
            if equalFlag (flag v) Rigid then stReturn Orange else
              stBind (denseFlexiblePath state n) (\flexible -> stReturn (if flexible then Green else Red)))) (\answer ->
        stBind (writeDense low permissions n (Just answer)) (\stored -> stReturn answer))))

denseCheckOriginal : forall s. DenseRebinding s -> DensePermissions s -> DensePermissions s -> Pair Int Node -> ST s (Either String Unit)
denseCheckOriginal state oldPermissions raisedPermissions (Pair n v) = case state of
  DenseRebinding old skeleton low high oldNodes newNodes images classes flags parents tree depths colours grafted oldBinders raised ->
    stBind (readDense low images n) (\image ->
    ST.bindE (if L.not (isBottom (tag v)) then ST.pureE Unit else
      stBind (denseTableNode low newNodes image) (\result ->
        if isBottom (tag result) then ST.pureE Unit else
          stBind (densePermission oldPermissions n) (\permission -> ST.check (equalPermission permission Green) "cannot instantiate a rigid or protected type variable"))) (\instantiated ->
    stBind (readDense low raised n) (\up ->
    ST.bindE (if equalMaybeInt (binder v) up then ST.pureE Unit else
      stBind (densePermission oldPermissions n) (\permission -> ST.check (L.not (equalPermission permission Red)) "cannot raise a protected type variable")) (\lifted ->
    stBind (readDense low flags image) (\newFlag ->
      if equalFlag (flag v) newFlag then ST.pureE Unit else
        stBind (densePermission raisedPermissions n) (\permission -> ST.check (L.not (equalPermission permission Red)) "cannot weaken a protected type variable"))))))

denseCheckMerges : forall s. Int -> STArray s (Maybe Int) -> DensePermissions s -> List Int -> ST s (Either String Unit)
denseCheckMerges low raised permissions members = case members of
  Nil -> ST.pureE Unit
  Cons first rest -> ST.bindE (denseCheckMergeRest low raised permissions first rest) (\checked ->
    denseCheckMerges low raised permissions rest)

rebindSparse : Graph -> Graph -> Either String Graph
rebindSparse old skeleton =
  let classes = classesIndex old skeleton in
  let parents = parentsIndex skeleton in
  let newFlags = flagsIndex old classes in
  let grafted = graftedNodes old skeleton in
  let candidates = candidateIndex old skeleton classes parents grafted in
  let dependencies = IM.mapWithKey (\n -> \cs -> IS.union (IS.fromList cs) (IM.findWithDefault IS.empty n parents)) candidates in
  bindE (rebuildBinders candidates dependencies) (\tree ->
    bindE (mapE (raisedBinder old skeleton tree) (IM.toList (nodes old))) (\raisedPairs ->
      -- raisedBinder retains the ascending identity from nodes old.
      let up = IM.fromDistinctAscList raisedPairs in
      let raised = mkGraph (mapNodesWithKey (\n -> \v -> mkNode (tag v) (IM.findWithDefault Nothing n up) (flag v)) (nodes old)) (links old) (nextId old) in
      let oldPermissions = permissions old in
      let raisedPermissions = permissions raised in
      bindE (mapE_ (checkOriginalPermission skeleton oldPermissions raisedPermissions newFlags up) (IM.toList (nodes old))) (\ignored ->
        bindE (mapE_ (checkMergePairs raisedPermissions up) (IM.elems classes)) (\ignored2 ->
          Right (mkGraph (mapNodesWithKey (\n -> \v -> mkNode (tag v) (IM.findWithDefault Nothing n tree) (IM.get n newFlags)) (nodes skeleton)) (links skeleton) (nextId skeleton))))))

insideScope : Graph -> Int -> IntMap (Pair Int Int) -> IntMap Bool -> Int -> Pair Bool (IntMap Bool)
insideScope graph generalization intervals known identity = case IM.lookup identity known of
  Just answer -> Pair answer known
  Nothing ->
    let answer = case binder (nodeAt graph identity) of
          Nothing -> Pair false known
          Just parent ->
            let p = resolve graph parent in
            let gen = resolve graph generalization in
            if p == gen then Pair true known else
              if IM.member gen intervals && IM.member p intervals then Pair (intervalContains intervals gen p) known else
              insideScope graph generalization intervals known p in
    case answer of Pair value cache -> strictPair value (IM.insert identity value cache)

expansionVisitCached : Graph -> Int -> IntMap (Pair Int Int) -> Pair IntSet (IntMap Bool) -> List Int -> Pair IntSet (IntMap Bool)
expansionVisitCached graph generalization intervals state pending = case pending of
  Nil -> state
  Cons original rest -> case state of
    Pair seen scopes ->
      let identity = resolve graph original in
      if IS.member identity seen then expansionVisitCached graph generalization intervals state rest else
        case insideScope graph generalization intervals scopes identity of
          Pair local known -> expansionVisitCached graph generalization intervals (Pair (IS.insert identity seen) known) (L.append (if local then children (tag (nodeAt graph identity)) else Nil) rest)

expansionVisit : Graph -> Int -> IntSet -> List Int -> IntSet
expansionVisit graph generalization seen pending = case expansionVisitCached graph generalization IM.empty (Pair seen IM.empty) pending of
  Pair visited scopes -> visited

allocateCopiesUnordered : Graph -> List Int -> Pair (IntMap Int) Graph
allocateCopiesUnordered graph originals = L.foldlStrict (\state -> \original -> case state of Pair copies current -> case freshId current of Pair fresh next -> seq fresh (strictPair (IM.insert original fresh copies) (strictGraph next))) (Pair IM.empty graph) originals

-- Expansion visits enumerate distinct ascending identities. Allocate the
-- corresponding contiguous fresh range and balanced map directly, instead
-- of rebuilding a graph wrapper and inserting into the copy map per identity.
-- The general public helper retains the preceding fold for other list orders.
ascendingCopyIdentities : List Int -> Bool
ascendingCopyIdentities originals = case originals of
 Nil -> true
 Cons first rest -> ascendingCopyIdentitiesAfter first rest
ascendingCopyIdentitiesAfter : Int -> List Int -> Bool
ascendingCopyIdentitiesAfter previous originals = case originals of
 Nil -> true
 Cons n rest -> previous < n && ascendingCopyIdentitiesAfter n rest

freshCopyEntries : Int -> List Int -> List (Pair Int Int)
freshCopyEntries first originals = case originals of
 Nil -> Nil
 Cons original rest -> seq first (Cons (Pair original first) (freshCopyEntries (first + 1) rest))

allocateCopies : Graph -> List Int -> Pair (IntMap Int) Graph
allocateCopies graph originals = case originals of
 Nil -> Pair IM.empty graph
 Cons _ _ -> if L.not (ascendingCopyIdentities originals) then allocateCopiesUnordered graph originals else
  let first = nextId graph in
  let entries = freshCopyEntries first originals in
  let copied = IM.fromDistinctAscList entries in
  let next = mkGraph (nodes graph) (links graph) (first + L.length originals) in
  seq first (strictPair copied (strictGraph next))

copyIdentity : Graph -> IntMap Int -> Int -> Int
copyIdentity graph copies identity = let canonical = resolve graph identity in IM.findWithDefault canonical canonical copies

expansionNode : Graph -> Int -> Int -> Int -> IntMap Int -> IntMap Kind -> IntMap Bool -> Int -> Node
expansionNode graph generalization destination source copies kinds scopes identity =
  let node = nodeAt graph identity in
  let copy = copyIdentity graph copies in
  let root = copy source in
  if L.not (IM.findWithDefault false identity scopes) then mkNode (bottomTag (IM.get identity kinds)) (Just destination) Flexible else
  if identity == source then mkNode (mapTag copy (tag node)) (Just destination) Flexible else
  mkNode (mapTag copy (tag node)) (mapMaybeInt (\parent -> if resolve graph parent == resolve graph generalization then root else copy parent) (binder node)) (flag node)

expand : Int -> Int -> Graph -> Either String (Pair (Triple Int (IntMap Int) (List (Pair Int Int))) Graph)
expand generalization destination graph = expandWithScopes IM.empty generalization destination graph

expandWithScopes : IntMap (Pair Int Int) -> Int -> Int -> Graph -> Either String (Pair (Triple Int (IntMap Int) (List (Pair Int Int))) Graph)
expandWithScopes intervals generalization destination graph =
  let source = genRoot graph generalization in
  case expansionVisitCached graph generalization intervals (Pair IS.empty IM.empty) (Cons source Nil) of
    Pair visited scopes ->
      let originals = IS.toList visited in
      bindE (kindsAt graph originals) (\kinds -> case allocateCopies graph originals of
        Pair copies allocated ->
          let copy = copyIdentity graph copies in
          let result = L.foldlStrict (\current -> \n -> setNode (copy n) (expansionNode graph generalization destination source copies kinds scopes n) current) allocated originals in
          let frontier = L.filter (\n -> L.not (IM.findWithDefault false n scopes)) originals in
          Right (Pair (Triple (copy source) copies (L.map (\n -> Pair n (copy n)) frontier)) result))

schemeOrExistential : Graph -> Int -> Node -> Bool
schemeOrExistential graph identity node = case binder node of
  Nothing -> false
  Just parent -> case tag (nodeAt graph parent) of
    GGen root -> identity == resolve graph root || L.not (IS.member identity (reachable graph root))
    _ -> false

normalize : Graph -> Graph
-- Solver.finishNormalized reuses validation across this transformation:
-- only non-Gen flags may change; identities, tags and binders stay intact.
normalize graph = case denseBounds graph of
  Nothing -> normalizeSparse graph
  Just (Pair low high) -> normalizeDense graph low high

normalizeSparse : Graph -> Graph
normalizeSparse graph =
  let inertness = inertNodes graph in
  -- Several nodes can share a generalization binder. Keep its structural
  -- closure lazy and share it for this immutable graph, rather than rebuilding
  -- the same reachability set for each existential check.
  let scopes = IM.map (\v -> case tag v of GGen root -> reachable graph root; _ -> IS.empty) (nodes graph) in
  let scheme = \n v -> case binder v of
        Nothing -> false
        Just parent -> case tag (nodeAt graph parent) of
          GGen root -> n == resolve graph root || L.not (IS.member n (IM.get (resolve graph parent) scopes))
          _ -> false in
  mkGraph (mapNodesWithKey (\n -> \v -> if isGen (tag v) then v else if IM.findWithDefault false n inertness || scheme n v then mkNode (tag v) (binder v) Rigid else v) (nodes graph)) (links graph) (nextId graph)

-- Normalize dense graphs with bounded scratch arrays. Only flags may change;
-- the persistent sparse path remains available for arbitrary identity spans.
data DenseNormalization s = DenseNormalization Graph Int (STArray s (Maybe Node)) (STArray s (List Int)) (STArray s Int) (STArray s Int) (STArray s Bool) (STArray s (List Int))

normalizeDense : Graph -> Int -> Int -> Graph
normalizeDense graph low high = runST (
  let count = high - low + 1 in
  stBind (newSTArray count Nothing) (\table ->
  stBind (newSTArray count Nil) (\descendants ->
  stBind (newSTArray count (0 - 1)) (\inertness ->
  stBind (newSTArray count (low - 1)) (\seen ->
  stBind (newSTArray count false) (\rigid ->
  stBind (newSTArray count Nil) (\candidates ->
    let state = DenseNormalization graph low table descendants inertness seen rigid candidates in
    let entries = IM.toList (nodes graph) in
    stBind (normalLoad state entries) (\loaded ->
    stBind (normalGather state entries) (\gathered ->
    stBind (normalScopes state entries) (\marked ->
    stBind (normalResults state entries) (\result ->
      stReturn (mkGraph (nodesFromDistinctAscList result) (links graph) (nextId graph)))))))))))))

normalLoad : forall s. DenseNormalization s -> List (Pair Int Node) -> ST s Unit
normalLoad state entries = case entries of
  Nil -> stReturn Unit
  Cons (Pair n v) rest -> case state of
    DenseNormalization graph low table descendants inertness seen rigid candidates ->
      stBind (writeDense low table n (Just v)) (\loaded ->
      stBind (if equalFlag (flag v) Rigid then stReturn Unit else case binder v of
        Nothing -> stReturn Unit
        Just parent -> stBind (readDense low descendants parent) (\previous -> writeDense low descendants parent (Cons n previous))) (\added ->
        normalLoad state rest))

normalInert : forall s. DenseNormalization s -> Int -> ST s Bool
normalInert state n = case state of
  DenseNormalization graph low table descendants inertness seen rigid candidates ->
    stBind (readDense low inertness n) (\known ->
      if known >= 0 then stReturn (known == 1) else
      stBind (denseTableNode low table n) (\v ->
      stBind (if isBottom (tag v) then stReturn false else
        stBind (readDense low descendants n) (normalAllInert state)) (\answer ->
      stBind (writeDenseInt low inertness n (if answer then 1 else 0)) (\stored -> stReturn answer))))

normalAllInert : forall s. DenseNormalization s -> List Int -> ST s Bool
normalAllInert state pending = case pending of
  Nil -> stReturn true
  Cons n rest -> stBind (normalInert state n) (\answer -> if answer then normalAllInert state rest else stReturn false)

normalGather : forall s. DenseNormalization s -> List (Pair Int Node) -> ST s Unit
normalGather state entries = case entries of
  Nil -> stReturn Unit
  Cons (Pair n v) rest -> case state of
    DenseNormalization graph low table descendants inertness seen rigid candidates ->
      stBind (if isGen (tag v) || equalFlag (flag v) Rigid then stReturn Unit else
        stBind (normalInert state n) (\inert -> if inert then writeDense low rigid n true else case binder v of
          Nothing -> stReturn Unit
          Just parent -> stBind (denseTableNode low table parent) (\scope -> case tag scope of
            GGen root -> if n == resolve graph root then writeDense low rigid n true else
              stBind (readDense low candidates parent) (\previous -> writeDense low candidates parent (Cons n previous))
            _ -> stReturn Unit))) (\gathered -> normalGather state rest)

normalScopes : forall s. DenseNormalization s -> List (Pair Int Node) -> ST s Unit
normalScopes state entries = case entries of
  Nil -> stReturn Unit
  Cons (Pair n v) rest -> case state of
    DenseNormalization graph low table descendants inertness seen rigid candidates ->
      stBind (case tag v of
        GGen root -> stBind (readDense low candidates n) (\pending -> if L.null pending then stReturn Unit else
          stBind (normalReach state n (Cons root Nil)) (\visited -> normalExistentials state n pending))
        _ -> stReturn Unit) (\marked -> normalScopes state rest)

normalReach : forall s. DenseNormalization s -> Int -> List Int -> ST s Unit
normalReach state stamp pending = case pending of
  Nil -> stReturn Unit
  Cons original rest -> case state of
    DenseNormalization graph low table descendants inertness seen rigid candidates ->
      let n = resolve graph original in
      stBind (readDense low seen n) (\previous -> if previous == stamp then normalReach state stamp rest else
      stBind (writeDenseInt low seen n stamp) (\marked ->
      stBind (denseTableNode low table n) (\v -> normalReach state stamp (L.append (children (tag v)) rest))))

normalExistentials : forall s. DenseNormalization s -> Int -> List Int -> ST s Unit
normalExistentials state stamp pending = case pending of
  Nil -> stReturn Unit
  Cons n rest -> case state of
    DenseNormalization graph low table descendants inertness seen rigid candidates ->
      stBind (readDense low seen n) (\visited ->
      stBind (writeDense low rigid n (visited /= stamp)) (\marked -> normalExistentials state stamp rest))

normalResults : forall s. DenseNormalization s -> List (Pair Int Node) -> ST s (List (Pair Int Node))
normalResults state entries = case entries of
  Nil -> stReturn Nil
  Cons (Pair n v) rest -> case state of
    DenseNormalization graph low table descendants inertness seen rigid candidates ->
      stBind (readDense low rigid n) (\changed ->
      stBind (normalResults state rest) (\tail ->
        stReturn (Cons (Pair n (if changed then mkNode (tag v) (binder v) Rigid else v)) tail)))

-- Reverse accumulation makes the postorder traversal linear in its output.
-- The public accumulator helper retains its forward-prefix contract.
orderedVisitReverse : Graph -> Pair IntSet (List Int) -> Int -> Pair IntSet (List Int)
orderedVisitReverse graph (Pair seen order) original =
  let identity = resolve graph original in
  if IS.member identity seen then Pair seen order else
    case L.foldl (orderedVisitReverse graph) (Pair (IS.insert identity seen) order) (children (tag (nodeAt graph identity))) of
      Pair visited result -> Pair visited (Cons identity result)

orderedVisit : Graph -> Pair IntSet (List Int) -> Int -> Pair IntSet (List Int)
orderedVisit graph (Pair seen prefix) original =
  case orderedVisitReverse graph (Pair seen Nil) original of
    Pair visited result -> Pair visited (L.append prefix (L.reverse result))

orderedBelow : Graph -> Int -> List Int
orderedBelow graph root = case orderedVisitReverse graph (Pair IS.empty Nil) root of Pair seen order -> L.reverse order

-- Direct loops keep the state operations visible to checked native lowering.
-- They preserve the corresponding ST library traversal order and error stops.

denseLoadValidation : forall s. Int -> STArray s (Maybe Node) -> List (Pair Int Node) -> ST s (Unit)
denseLoadValidation low table values = case values of
  Nil -> stReturn Unit
  Cons entry rest -> stBind (case entry of Pair n v -> writeDense low table n (Just v)) (\ignored -> denseLoadValidation low table rest)

denseCheckBinders : forall s. DenseValidation s -> List (Pair Int Node) -> ST s (Either String (Unit))
denseCheckBinders state values = case values of
  Nil -> ST.pureE Unit
  Cons entry rest -> ST.bindE (denseCheckBinder state entry) (\ignored -> denseCheckBinders state rest)

denseAddDescendants : forall s. DenseValidation s -> List (Pair Int Node) -> ST s (Unit)
denseAddDescendants state values = case values of
  Nil -> stReturn Unit
  Cons entry rest -> stBind (denseAddDescendant state entry) (\ignored -> denseAddDescendants state rest)

denseKindEntries : forall s. DenseValidation s -> List (Pair Int Node) -> ST s (Either String (Unit))
denseKindEntries state values = case values of
  Nil -> ST.pureE Unit
  Cons entry rest -> ST.bindE (case entry of Pair n v -> denseKind state n v) (\ignored -> denseKindEntries state rest)

denseBindingChildren : forall s. DenseValidation s -> Int -> List Int -> ST s Int
denseBindingChildren state position children = case children of
  Nil -> stReturn position
  Cons child rest -> stBind (denseBindingVisit state child position) (\next -> denseBindingChildren state next rest)

denseChildKinds : forall s. DenseValidation s -> Int -> List (Int) -> ST s (Either String (List (Kind)))
denseChildKinds state n values = case values of
  Nil -> ST.pureE Nil
  Cons entry rest -> ST.bindE (denseChild state n entry) (\answer -> ST.bindE (denseChildKinds state n rest) (\answers -> ST.pureE (Cons answer answers)))

denseLoadOriginals : forall s. DenseRebinding s -> List (Pair Int Node) -> ST s (Unit)
denseLoadOriginals state values = case values of
  Nil -> stReturn Unit
  Cons entry rest -> stBind (denseLoadOriginal state entry) (\ignored -> denseLoadOriginals state rest)

denseLoadRemainings : forall s. DenseRebinding s -> List (Pair Int Node) -> ST s (Unit)
denseLoadRemainings state values = case values of
  Nil -> stReturn Unit
  Cons entry rest -> stBind (denseLoadRemaining state entry) (\ignored -> denseLoadRemainings state rest)

denseMarkOriginals : forall s. DenseRebinding s -> List (Pair Int Node) -> ST s (Unit)
denseMarkOriginals state values = case values of
  Nil -> stReturn Unit
  Cons entry rest -> stBind (denseMarkOriginal state entry) (\ignored -> denseMarkOriginals state rest)

densePlaceEntries : forall s. DenseRebinding s -> List (Pair Int Node) -> ST s (Either String (Unit))
densePlaceEntries state values = case values of
  Nil -> ST.pureE Unit
  Cons entry rest -> ST.bindE (case entry of Pair n v -> densePlace state n) (\ignored -> densePlaceEntries state rest)

denseFinalNodes : forall s. DenseRebinding s -> List (Pair Int Node) -> ST s (Either String (List (Pair Int Node)))
denseFinalNodes state values = case values of
  Nil -> ST.pureE Nil
  Cons entry rest -> ST.bindE (denseFinalNode state entry) (\answer -> ST.bindE (denseFinalNodes state rest) (\answers -> ST.pureE (Cons answer answers)))

denseRaiseOriginals : forall s. DenseRebinding s -> List (Pair Int Node) -> ST s (Either String (Unit))
denseRaiseOriginals state values = case values of
  Nil -> ST.pureE Unit
  Cons entry rest -> ST.bindE (denseRaiseOriginal state entry) (\ignored -> denseRaiseOriginals state rest)

denseCheckOriginals : forall s. DenseRebinding s -> DensePermissions s -> DensePermissions s -> List (Pair Int Node) -> ST s (Either String (Unit))
denseCheckOriginals state oldPermissions raisedPermissions values = case values of
  Nil -> ST.pureE Unit
  Cons entry rest -> ST.bindE (denseCheckOriginal state oldPermissions raisedPermissions entry) (\ignored -> denseCheckOriginals state oldPermissions raisedPermissions rest)

denseCheckMergeEntries : forall s. Int -> STArray s (List Int) -> STArray s (Maybe Int) -> DensePermissions s -> List (Pair Int Node) -> ST s (Either String (Unit))
denseCheckMergeEntries low classes raised raisedPermissions values = case values of
  Nil -> ST.pureE Unit
  Cons entry rest -> ST.bindE (case entry of Pair n v -> stBind (readDense low classes n) (\members -> denseCheckMerges low raised raisedPermissions members)) (\ignored -> denseCheckMergeEntries low classes raised raisedPermissions rest)

denseLoadParents : forall s. Int -> STArray s (List Int) -> Int -> List (Int) -> ST s (Unit)
denseLoadParents low parents n values = case values of
  Nil -> stReturn Unit
  Cons entry rest -> stBind (stBind (readDense low parents entry) (\previous -> writeDense low parents entry (Cons n previous))) (\ignored -> denseLoadParents low parents n rest)

denseMarks : forall s. DenseRebinding s -> List (Int) -> ST s (Unit)
denseMarks state values = case values of
  Nil -> stReturn Unit
  Cons entry rest -> stBind (denseMark state entry) (\ignored -> denseMarks state rest)

densePlaces : forall s. DenseRebinding s -> List (Int) -> ST s (Either String (Unit))
densePlaces state values = case values of
  Nil -> ST.pureE Unit
  Cons entry rest -> ST.bindE (densePlace state entry) (\ignored -> densePlaces state rest)

denseCommonFold : forall s. DenseRebinding s -> Int -> List Int -> ST s (Either String Int)
denseCommonFold state initial values = case values of
  Nil -> ST.pureE initial
  Cons value rest -> ST.bindE (denseCommon state initial value) (\next -> denseCommonFold state next rest)

densePermissionChildren : forall s. Int -> STArray s (Maybe Int) -> STArray s (List Int) -> List (Pair Int Node) -> ST s (Unit)
densePermissionChildren low binding descendants values = case values of
  Nil -> stReturn Unit
  Cons entry rest -> stBind (case entry of { Pair n v -> if equalFlag (flag v) Rigid then stReturn Unit else stBind (readDense low binding n) (\parent -> case parent of { Nothing -> stReturn Unit; Just b -> stBind (readDense low descendants b) (\previous -> writeDense low descendants b (Cons n previous)) }) }) (\ignored -> densePermissionChildren low binding descendants rest)

denseCheckMergeRest : forall s. Int -> STArray s (Maybe Int) -> DensePermissions s -> Int -> List (Int) -> ST s (Either String (Unit))
denseCheckMergeRest low raised permissions first values = case values of
  Nil -> ST.pureE Unit
  Cons entry rest -> ST.bindE (stBind (readDense low raised first) (\a -> stBind (readDense low raised entry) (\b -> if L.not (equalMaybeInt a b) then ST.pureE Unit else stBind (densePermission permissions first) (\pa -> if equalPermission pa Red then ST.failE "cannot merge distinct protected type variables" else stBind (densePermission permissions entry) (\pb -> ST.check (L.not (equalPermission pb Red)) "cannot merge distinct protected type variables"))))) (\ignored -> denseCheckMergeRest low raised permissions first rest)
