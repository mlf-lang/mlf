module Bootstrap.CrateArtifact where

import Bootstrap.Types
import Bootstrap.Std
import qualified Bootstrap.Map as M
import qualified Bootstrap.Set as Set
import qualified Bootstrap.Module as Modules
import qualified Bootstrap.Classes as Classes
import qualified Bootstrap.CompilerCore as Compiler
import qualified Bootstrap.Parser as Parser
import qualified Bootstrap.Surface as Surface
import qualified Bootstrap.Data as D
import qualified Bootstrap.SourceEquality as Equality
import qualified Bootstrap.X.Syntax as X
import qualified Bootstrap.X.Type as T
import qualified Bootstrap.X.Check as Check
import qualified Bootstrap.X.Checked as Checked
import qualified Bootstrap.X.Parser as XP
import qualified Bootstrap.X.Pretty as Pretty
import qualified Bootstrap.Separate as Separate

-- Source visibility, the closed linking inventory, and checked SCC fragments
-- have deliberately separate representations. Dependencies refer to metadata
-- files, so inference never needs to open an upstream implementation object.
data CrateInterface = CrateInterface String (List (Triple String String String)) (List String) (List (Pair String (List Modules.Entity))) (List (Pair String (List String))) (List DataDecl) (List SClassDecl) (List (Pair String SInstanceDecl)) (List DataDecl) (List (Pair String XType)) String String
data CrateObject = CrateObject CrateInterface (List Separate.UnitObject) | LegacyCrateObject CrateInterface (List Separate.UnitObject)
crateId (CrateInterface n _ _ _ _ _ _ _ _ _ _ _) = n
crateDependencies (CrateInterface _ ds _ _ _ _ _ _ _ _ _ _) = ds
crateModules (CrateInterface _ _ ms _ _ _ _ _ _ _ _ _) = ms
crateExports (CrateInterface _ _ _ es _ _ _ _ _ _ _ _) = es
crateImports (CrateInterface _ _ _ _ is _ _ _ _ _ _ _) = is
crateData (CrateInterface _ _ _ _ _ ds _ _ _ _ _ _) = ds
crateClasses (CrateInterface _ _ _ _ _ _ cs _ _ _ _ _) = cs
crateInstances (CrateInterface _ _ _ _ _ _ _ is _ _ _ _) = is
crateLoweredData (CrateInterface _ _ _ _ _ _ _ _ ds _ _ _) = ds
crateBindings (CrateInterface _ _ _ _ _ _ _ _ _ bs _ _) = bs
crateEntry (CrateInterface _ _ _ _ _ _ _ _ _ _ e _) = e
crateObjectFingerprint (CrateInterface _ _ _ _ _ _ _ _ _ _ _ h) = h
objectInterface (CrateObject i _) = i
objectInterface (LegacyCrateObject i _) = i
objectFragments (CrateObject _ fs) = fs
objectFragments (LegacyCrateObject _ fs) = fs

definitionName identity entity =
  if eqString (Modules.owner entity) "Prelude" || Modules.isRole Modules.BuiltinType entity then Separate.stableName entity
  else (if Modules.compareSpace (Modules.space entity) Modules.Types == 0 || (case Modules.role entity of {Modules.Constructor _ -> true; _ -> false}) then "Module_" else "module_") ++ Separate.encoded identity ++ "z_" ++ Separate.encoded (Separate.entityEncoding entity)
startsWith prefix text = stringLength text >= stringLength prefix && eqString prefix (stringSlice text 0 (stringLength prefix))
instancePrefix identity owner = "instance_" ++ Separate.encoded identity ++ "z_" ++ Separate.encoded owner ++ "z_"
instanceName identity owner inst = instancePrefix identity owner ++ Separate.encoded (Separate.fingerprint (Separate.prettyInstance (Separate.stripInstance inst)))
instanceOwner iface symbol = case filter (\owner -> startsWith (instancePrefix (crateId iface) owner) symbol) (crateModules iface) of
  Cons owner Nil -> Right owner
  _ -> Left ("instance dictionary has no unique owning module: " ++ symbol)
entryOwner iface = case filter (\owner -> eqString (definitionName (crateId iface) (Modules.Entity owner "<crate-entry>" Modules.Value)) (crateEntry iface)) (crateModules iface) of
  Cons owner Nil -> Right owner
  _ -> Left "crate entry has no unique owning module"

sortStrings xs = sortBy compareString xs
sortPairs xs = sortBy (\a b -> compareString (fst a) (fst b)) xs
sortDependencies xs = sortBy (\(Triple a _ _) (Triple b _ _) -> compareString a b) xs
sortEntities xs = sortBy (\a b -> compareString (Separate.entityEncoding a) (Separate.entityEncoding b)) xs
sortData xs = sortBy (\a b -> compareString (D.datatypeName a) (D.datatypeName b)) xs
sortClasses xs = sortBy (\a b -> compareString (Classes.className a) (Classes.className b)) xs
encodeBindings bs = Separate.pack (map (\(Pair n ty) -> Separate.pairEncoding (Pair n (Pretty.prettyType (Separate.normalType ty)))) (sortPairs bs))
sourceMetadata ds cs instances = unlines (append (map D.prettyDeclaration (sortData ds)) (append (map Separate.prettyClass (sortClasses cs)) (map (\p -> Separate.prettyInstance (snd p)) (sortPairs instances))))
encodeExports es = Separate.pack (map (\(Pair n entities) -> Separate.pairEncoding (Pair n (Separate.pack (map Separate.entityEncoding (sortEntities entities))))) (sortPairs es))
encodeImports is = Separate.pack (map (\(Pair n imports) -> Separate.pairEncoding (Pair n (Separate.pack (sortStrings imports)))) (sortPairs is))
encodeDependency (Triple name path semantic) = Separate.pack (Cons name (Cons path (Cons semantic Nil)))

-- The ABI excludes object checksums, dependency ABI digests and private value
-- schemes. Query keys additionally record the precise schemes they consume;
-- this is necessary for a facade which merely reexports a dependency entity.
semanticFingerprint iface =
  let exported = concatMap snd (crateExports iface) in
  let publicNames = Set.fromList compareString (map (definitionName (crateId iface)) exported) in
  let public = filter (\p -> Set.member compareString (fst p) publicNames) (crateBindings iface) in
  let fields = Cons "MLF-CRATE-SEMANTICS-1" (Cons (crateId iface) (Cons (encodeExports (crateExports iface)) (Cons (encodeImports (crateImports iface)) (Cons (sourceMetadata (crateData iface) (crateClasses iface) (crateInstances iface)) (Cons (Separate.pack (map fst (sortPairs (crateInstances iface)))) (Cons (unlines (map D.prettyDeclaration (sortData (crateLoweredData iface)))) (Cons (encodeBindings public) Nil))))))) in
  Separate.fingerprint (Separate.pack fields)

interfaceFields iface = Cons "MLFCI-1" (Cons (crateId iface)
  (Cons (Separate.pack (map encodeDependency (sortDependencies (crateDependencies iface))))
  (Cons (Separate.pack (sortStrings (crateModules iface)))
  (Cons (encodeExports (crateExports iface)) (Cons (encodeImports (crateImports iface))
  (Cons (sourceMetadata (crateData iface) (crateClasses iface) (crateInstances iface))
  (Cons (Separate.pack (map fst (sortPairs (crateInstances iface))))
  (Cons (unlines (map D.prettyDeclaration (sortData (crateLoweredData iface))))
  (Cons (encodeBindings (crateBindings iface)) (Cons (crateEntry iface) (Cons (crateObjectFingerprint iface) Nil)))))))))))
encodeInterface iface = let fields = interfaceFields iface in Separate.pack (snoc fields (Separate.fingerprint (Separate.pack fields)))

decodeDependency text = do
  fields <- Separate.unpack text
  case fields of
    Cons name (Cons path (Cons semantic Nil)) -> do
      ensure (stringLength name > 0 && stringLength semantic > 0 && stringLength path > 0 && stringCodeAt path 0 == 47) "crate dependency metadata path must be absolute"
      Right (Triple name path semantic)
    _ -> Left "malformed crate dependency"
decodeExports text = do
  entries <- Separate.unpack text
  traverseEither (\entry -> do
    Pair n encoded <- Separate.decodePair entry
    fields <- Separate.unpack encoded
    entities <- traverseEither Separate.decodeEntity fields
    ensure (length entities == Set.size (Set.fromList Modules.compareEntity entities)) "duplicate crate export entity"
    Right (Pair n entities)) entries
decodeImports text = do
  entries <- Separate.unpack text
  traverseEither (\entry -> do
    Pair n encoded <- Separate.decodePair entry
    imports <- Separate.unpack encoded
    ensure (length imports == length (nubBy eqString imports)) "duplicate crate module reach entry"
    Right (Pair n imports)) entries
decodeBindings text = do
  entries <- Separate.unpack text
  traverseEither (\entry -> do {Pair n t <- Separate.decodePair entry; ty <- XP.parseType t; Right (Pair n ty)}) entries
uniqueNames label names = ensure (length names == Set.size (Set.fromList compareString names)) ("duplicate crate " ++ label)
isPrimitiveEntity entity = any (\e -> Modules.compareEntity e entity == 0) Modules.primitiveEntities
data ExportInventory = ExportInventory (Set String) (Set String) (Set String) (Set String) (Set String)
exportInventory iface = ExportInventory (Set.fromList compareString (map fst (crateBindings iface)))
  (Set.fromList compareString (map D.datatypeName (crateData iface)))
  (Set.fromList compareString (map Classes.className (crateClasses iface)))
  (Set.fromList compareString (concatMap (\d -> map D.constructorName (D.datatypeConstructors d)) (crateData iface)))
  (Set.fromList compareString (concatMap (\c -> map fst (Classes.classMethods c)) (crateClasses iface)))
validateOwnExport iface (ExportInventory values datatypes classes constructors methods) entity = if isPrimitiveEntity entity || not (elem eqString (Modules.owner entity) (crateModules iface)) then Right Unit else do
  let name = definitionName (crateId iface) entity
  let declared = case Modules.role entity of
        Modules.Value -> Set.member compareString name values
        Modules.Datatype -> Set.member compareString name datatypes
        Modules.Class -> Set.member compareString name classes
        Modules.Constructor _ -> Set.member compareString name constructors
        Modules.Method _ -> Set.member compareString name methods
        _ -> false
  ensure declared ("crate exports an undeclared entity: " ++ Modules.label entity)
validateInterface iface = do
  ensure (stringLength (crateId iface) > 0 && stringLength (crateObjectFingerprint iface) > 0) "incomplete crate metadata"
  uniqueNames "dependency" (map (\(Triple n _ _) -> n) (crateDependencies iface))
  uniqueNames "dependency path" (map (\(Triple _ path _) -> path) (crateDependencies iface))
  uniqueNames "module" (crateModules iface)
  uniqueNames "module exports" (map fst (crateExports iface))
  uniqueNames "module reach" (map fst (crateImports iface))
  uniqueNames "binding" (map fst (crateBindings iface))
  uniqueNames "instance" (map fst (crateInstances iface))
  uniqueNames "datatype" (map D.datatypeName (crateLoweredData iface))
  ensure (not (any (\(Triple n _ _) -> eqString n (crateId iface)) (crateDependencies iface))) ("cyclic crate dependency: " ++ crateId iface)
  ensure (eqList eqString (sortStrings (map fst (crateExports iface))) (sortStrings (crateModules iface))) "crate export inventory differs from owned modules"
  ensure (eqList eqString (sortStrings (map fst (crateImports iface))) (sortStrings (crateModules iface))) "crate module reach inventory differs from owned modules"
  traverseEither Separate.validModuleName (crateModules iface)
  traverseEither (\(Pair _ modules) -> traverseEither Separate.validModuleName modules) (crateImports iface)
  traverseEither (validateOwnExport iface (exportInventory iface)) (concatMap snd (crateExports iface))
  traverseEither (\(Pair n ty) -> ensure (stringLength n > 0 && Set.null (T.freeVars ty)) ("crate binding has an open type: " ++ n)) (crateBindings iface)
  traverseEither (\(Pair n inst) -> do {owner <- instanceOwner iface n; ensure (eqString n (instanceName (crateId iface) owner inst)) "unstable crate instance identity"}) (crateInstances iface)
  ensure (eqString (crateEntry iface) "" || M.member compareString (crateEntry iface) (M.fromList compareString (crateBindings iface))) "crate entry is not an owned binding"
  if eqString (crateEntry iface) "" then Right Unit else mapEither (\_ -> Unit) (entryOwner iface)
decodeInterface input = do
  fields <- Separate.unpack input
  case fields of
    Cons "MLFCI-1" (Cons identity (Cons deps (Cons modules (Cons exports (Cons imports (Cons metadata (Cons instanceNames (Cons layouts (Cons bindings (Cons entry (Cons bodyHash (Cons checksum Nil)))))))))))) -> do
      ensure (eqString checksum (Separate.fingerprint (Separate.pack (interfacePrefix fields)))) "crate metadata checksum mismatch"
      dependencies <- bindEither (Separate.unpack deps) (traverseEither decodeDependency)
      owned <- Separate.unpack modules
      exported <- decodeExports exports
      reach <- decodeImports imports
      source <- Parser.parseModule "<crate metadata>" ("module CrateMetadata where {\n" ++ metadata ++ "\n}")
      lowered <- Parser.parseModule "<crate layout metadata>" ("module CrateLayouts where {\n" ++ layouts ++ "\n}")
      names <- Separate.unpack instanceNames
      schemes <- decodeBindings bindings
      ensure (length names == length (Modules.sourceInstances source)) "crate instance metadata count mismatch"
      ensure (null (Modules.sourceValues source) && null (Modules.sourceImports source) && null (Modules.sourceValues lowered) && null (Modules.sourceImports lowered) && null (Modules.sourceClasses lowered) && null (Modules.sourceInstances lowered)) "crate metadata contains executable declarations"
      let iface = CrateInterface identity dependencies owned exported reach (Modules.sourceDatatypes source) (Modules.sourceClasses source) (zip names (map Separate.stripInstance (Modules.sourceInstances source))) (Modules.sourceDatatypes lowered) schemes entry bodyHash
      validateInterface iface
      ensure (eqString input (encodeInterface iface)) "noncanonical crate metadata"
      Right iface
    _ -> Left "unsupported or malformed crate metadata (expected MLFCI-1)"
interfacePrefix : List String -> List String
interfacePrefix fields = case fields of {Nil -> Nil; Cons a Nil -> Nil; Cons a rest -> Cons a (interfacePrefix rest)}

encodeFragment fragment = Separate.pairEncoding (Pair (Separate.encodeInterface (Separate.objectInterface fragment)) (Separate.encodeObject fragment))
-- Hash the same length-framed bytes without retaining one concatenated copy
-- of every checked fragment and its datatype context.
fingerprintPartFrom : String -> Int -> Int -> Int -> Pair Int Int
fingerprintPartFrom text index a b = if index == stringLength text then Pair a b else
  let code = stringCodeAt text index in
  let nextA = (a * 65599 + code) % 2147483647 in
  let nextB = (b * 131 + code) % 2147483629 in
  seq nextA (seq nextB (fingerprintPartFrom text (index+1) nextA nextB))
fragmentFingerprintFrom : List Separate.UnitObject -> Int -> Int -> String
fragmentFingerprintFrom fragments a b = case fragments of
  Nil -> showInt a ++ "-" ++ showInt b
  Cons fragment rest ->
    let text = encodeFragment fragment in
    case fingerprintPartFrom (showInt (stringLength text) ++ ":") 0 a b of
      Pair prefixA prefixB -> case fingerprintPartFrom text 0 prefixA prefixB of
        Pair nextA nextB -> seq nextA (seq nextB (fragmentFingerprintFrom rest nextA nextB))
legacyFragmentFingerprint fragments = fragmentFingerprintFrom fragments 0 1

-- Datatype contexts occur in thousands of SCC headers and payloads. Store
-- each canonical declaration once, retaining separate ordered references for
-- the header and payload so inconsistent objects remain invalid.
data PoolRecord = PoolRecord (List String) (List String) String
typePoolText : DataDecl -> List (Pair DataDecl String) -> Maybe String
typePoolText declaration entries = case entries of
  Nil -> Nothing
  Cons (Pair saved text) rest -> if Equality.eqDataDecl declaration saved then Just text else typePoolText declaration rest
rememberType : Map String (List (Pair DataDecl String)) -> DataDecl -> Pair (Map String (List (Pair DataDecl String))) String
rememberType pool declaration =
  let name = D.datatypeName declaration in
  let entries = M.findWithDefault compareString Nil name pool in
  case typePoolText declaration entries of
    Just text -> Pair pool text
    Nothing ->
      let text = D.prettyDeclaration declaration in
      Pair (M.insert compareString name (Cons (Pair declaration text) entries) pool) text
rememberTypes : Map String (List (Pair DataDecl String)) -> List DataDecl -> Pair (Map String (List (Pair DataDecl String))) (List String)
rememberTypes pool declarations = case declarations of
  Nil -> Pair pool Nil
  Cons declaration rest -> case rememberType pool declaration of
    Pair next text -> case rememberTypes next rest of
      Pair final texts -> Pair final (Cons text texts)
poolRecords : Map String (List (Pair DataDecl String)) -> List Separate.UnitObject -> List PoolRecord -> Pair (Map String (List (Pair DataDecl String))) (List PoolRecord)
poolRecords pool fragments done = case fragments of
  Nil -> Pair pool (reverse done)
  Cons fragment rest -> case rememberTypes pool (Separate.unitData (Separate.objectInterface fragment)) of
    Pair afterHeader header -> case rememberTypes afterHeader (Separate.objectContext fragment) of
      Pair afterBody body -> poolRecords afterBody rest (Cons (PoolRecord header body (Separate.encodeContextualObject fragment)) done)
encodePoolRecord : Map String Int -> PoolRecord -> String
encodePoolRecord numbers (PoolRecord header body contents) =
  let references = \texts -> Separate.pack (map (\text -> showInt (M.get compareString text numbers)) texts) in
  Separate.pack (Cons (references header) (Cons (references body) (Cons contents Nil)))
encodePooledPayload : List Separate.UnitObject -> String
encodePooledPayload fragments = case poolRecords M.empty fragments Nil of
  Pair inventory records ->
    let declarations = Set.toList (Set.fromList compareString (concatMap (map snd) (M.elems inventory))) in
    let numbers = M.fromList compareString (zip declarations (range 0 (length declarations-1))) in
    Separate.pack (Cons (Separate.pack declarations) (Cons (Separate.pack (map (encodePoolRecord numbers) records)) Nil))
fragmentFingerprint fragments = Separate.fingerprint (encodePooledPayload fragments)
objectFingerprint object = case object of
  CrateObject _ fragments -> fragmentFingerprint fragments
  LegacyCrateObject _ fragments -> legacyFragmentFingerprint fragments
withObjectFingerprint (CrateInterface n deps modules exports imports ds cs instances lowered bindings entry _) digest = CrateInterface n deps modules exports imports ds cs instances lowered bindings entry digest
makeObject iface fragments = CrateObject (withObjectFingerprint iface (fragmentFingerprint fragments)) fragments

-- Prelude has one shared crate identity even when several independent leaf
-- crates use it. Its bootstrap object is translated once; user crates still
-- compile their own declarations through the ordinary SCC query pipeline.
builtinPrelude = do
  let identity = "mlf:builtin-prelude:1"
  resolution <- Modules.resolveCrate NoImplicitPrelude M.empty (definitionName identity) (Cons Modules.preludeSource Nil)
  let modules = Modules.resolvedCrateModules resolution
  let sourceData = concatMap (\r -> Modules.renamedDatatypes (Modules.resolvedContents r)) modules
  let classes = concatMap (\r -> Modules.renamedClasses (Modules.resolvedContents r)) modules
  let values = concatMap (\r -> Modules.renamedValues (Modules.resolvedContents r)) modules
  instances <- traverseEither (\(Pair owner inst) -> do {closed <- Separate.closeInstance values inst; Right (Pair (instanceName identity owner inst) closed)}) (Modules.resolvedCrateInstances resolution)
  body <- Surface.bindValues values (SConstructor "Unit")
  lowered <- Classes.lowerSeparateClasses M.empty (map fst instances) (SClassProgram sourceData classes (map snd instances) body)
  compiled <- mapLeft Compiler.prettyError (Compiler.finishCompilation lowered)
  let term = Compiler.compiledTerm compiled
  let datatypes = case term of {XWithData ds _ -> ds; _ -> Nil}
  let implementation = case term of {XWithData _ b -> b; b -> b}
  dataEnv <- D.validateDeclarations datatypes
  actualBindings <- Separate.collectBindings dataEnv (XEnv M.empty M.empty) implementation
  let bindings = Separate.sortBindings (map (\(Pair n ty) -> Pair (X.nameHint n) (Separate.normalType ty)) actualBindings)
  exports <- traverseEither (\r -> mapEither (\scope -> Pair (Modules.moduleIdentity (Modules.resolvedSource r)) (Set.toList (Modules.visible scope))) (Modules.resolvedExports NoImplicitPrelude r)) modules
  let fragmentInterface = Separate.UnitInterface "Bootstrap.BuiltinPrelude" Nil Nil datatypes Nil Nil bindings (Separate.fingerprint (Pretty.prettyTerm term))
  let iface = CrateInterface identity Nil (Cons "Prelude" Nil) exports (Cons (Pair "Prelude" (Cons "Prelude" Nil)) Nil) sourceData classes (map (\(Pair n inst) -> Pair n (Separate.stripInstance inst)) instances) datatypes bindings "" "pending"
  let object = makeObject iface (Cons (Separate.UnitObject fragmentInterface term) Nil)
  validateInterface (objectInterface object)
  Right object
encodeObject object = case object of
  CrateObject iface fragments -> Separate.pack (Cons "MLFCO-2" (Cons (crateId iface) (Cons (Separate.fingerprint (encodeInterface iface)) (Cons (encodePooledPayload fragments) Nil))))
  LegacyCrateObject iface fragments -> Separate.pack (Cons "MLFCO-1" (Cons (crateId iface) (Cons (Separate.fingerprint (encodeInterface iface)) (Cons (Separate.pack (map encodeFragment fragments)) Nil))))
-- Canonical framing can be checked at the input offsets. It does not require
-- serializing a second copy of the complete implementation object.
canonicalFieldFrom : String -> Int -> Either String (Pair String Int)
canonicalFieldFrom text start = do
  let end = Separate.digitEnd text start
  ensure (end > start && end-start <= 9 && end < stringLength text && stringCodeAt text end == 58) "malformed crate object framing"
  ensure (end-start == 1 || stringCodeAt text start /= 48) "noncanonical crate object framing"
  let count = readInt (stringSlice text start (end-start))
  ensure (count <= stringLength text-end-1) "truncated crate object"
  Right (Pair (stringSlice text (end+1) count) (end+1+count))
canonicalFieldsFrom : String -> Int -> Either String (List String)
canonicalFieldsFrom text start = if start == stringLength text then Right Nil else do
  Pair field next <- canonicalFieldFrom text start
  rest <- canonicalFieldsFrom text next
  Right (Cons field rest)
canonicalFields text = canonicalFieldsFrom text 0
decodeFragment text = do
  fields <- canonicalFields text
  Pair metadata body <- case fields of {Cons metadata (Cons body Nil) -> Right (Pair metadata body); _ -> Left "malformed crate fragment"}
  iface <- Separate.decodeInterface metadata
  fragment <- Separate.decodeObject iface body
  ensure (eqString text (encodeFragment fragment)) "noncanonical crate fragment"
  Right fragment

-- Repeated contexts share canonical declaration nodes. The interface and
-- independently checked payload retain their own declaration lists; sharing
-- replaces a node only after its canonical layout agrees with the pool.
poolDeclarations : Map String (Pair String DataDecl) -> List DataDecl -> Either String (Pair (Map String (Pair String DataDecl)) (List DataDecl))
poolDeclarations pool declarations = case declarations of
  Nil -> Right (Pair pool Nil)
  Cons declaration rest -> do
    let name = D.datatypeName declaration
    let encoded = D.prettyDeclaration declaration
    Pair next shared <- case M.lookup compareString name pool of
      Nothing -> Right (Pair (M.insert compareString name (Pair encoded declaration) pool) declaration)
      Just (Pair expected shared) -> do
        ensure (eqString encoded expected) ("inconsistent crate datatype context: " ++ name)
        Right (Pair pool shared)
    Pair final pooled <- poolDeclarations next rest
    Right (Pair final (Cons shared pooled))
poolFragment pool fragment = do
  let iface = Separate.objectInterface fragment
  Pair afterHeader declarations <- poolDeclarations pool (Separate.unitData iface)
  Pair final term <- case Separate.objectTerm fragment of
    XWithData context body -> do
      Pair afterBody shared <- poolDeclarations afterHeader context
      Right (Pair afterBody (XWithData shared body))
    term -> Right (Pair afterHeader term)
  let shared = Separate.UnitInterface (Separate.unitName iface) (Separate.unitDependencies iface) (Separate.unitExports iface) declarations (Separate.unitClasses iface) (Separate.unitInstances iface) (Separate.unitBindings iface) (Separate.unitObjectFingerprint iface)
  Right (Pair final (Separate.UnitObject shared term))
decodeFragmentsFrom : String -> Int -> Map String (Pair String DataDecl) -> List Separate.UnitObject -> Either String (List Separate.UnitObject)
decodeFragmentsFrom payload start pool done = if start == stringLength payload then Right (reverse done) else do
  Pair text next <- canonicalFieldFrom payload start
  decoded <- decodeFragment text
  Pair pooled fragment <- poolFragment pool decoded
  decodeFragmentsFrom payload next pooled (Cons fragment done)
decodeTypePool : String -> Either String (Map Int DataDecl)
decodeTypePool input = do
  texts <- canonicalFields input
  ensure (eqList eqString texts (sortStrings texts)) "noncanonical crate datatype pool order"
  source <- Parser.parseModule "<crate datatype pool>" ("module CrateDataPool where {\n" ++ unlines texts ++ "\n}")
  ensure (null (Modules.sourceValues source) && null (Modules.sourceImports source) && null (Modules.sourceClasses source) && null (Modules.sourceInstances source)) "crate datatype pool contains executable declarations"
  let declarations = Modules.sourceDatatypes source
  ensure (eqList eqString texts (map D.prettyDeclaration declarations)) "noncanonical crate datatype pool declaration"
  uniqueNames "pooled datatype" (map D.datatypeName declarations)
  Right (M.fromList compareInt (zip (range 0 (length declarations-1)) declarations))
decodeTypeReferences : Map Int DataDecl -> String -> Either String (List DataDecl)
decodeTypeReferences pool input = do
  references <- canonicalFields input
  traverseEither (\reference -> do
    ensure (stringLength reference > 0 && stringLength reference <= 9 && Separate.digitEnd reference 0 == stringLength reference) "invalid crate datatype pool reference"
    let index = readInt reference
    ensure (eqString reference (showInt index)) "noncanonical crate datatype pool reference"
    case M.lookup compareInt index pool of
      Nothing -> Left "crate datatype pool reference is out of bounds"
      Just declaration -> Right declaration) references
datatypePart : DataDecl -> Pair String (Quad Int Int Int Int)
datatypePart declaration =
  let text = D.prettyDeclaration declaration in Pair text (Separate.fingerprintPart (text ++ "\n"))
contextState : Map String (Pair String (Quad Int Int Int Int)) -> List DataDecl -> Pair Int Int
contextState parts declarations = foldlStrict (\state declaration -> Separate.fingerprintAppend state (snd (M.get compareString (D.datatypeName declaration) parts))) (Pair 0 1) declarations
decodePooledFragments : Map Int DataDecl -> Map String (Pair String (Quad Int Int Int Int)) -> String -> Int -> List Separate.UnitObject -> Either String (List Separate.UnitObject)
decodePooledFragments pool parts payload start done = if start == stringLength payload then Right (reverse done) else do
  Pair record next <- canonicalFieldFrom payload start
  fields <- canonicalFields record
  case fields of
    Cons header (Cons body (Cons contents Nil)) -> do
      headerData <- decodeTypeReferences pool header
      bodyData <- decodeTypeReferences pool body
      fragment <- Separate.decodeContextualObjectAfter (contextState parts bodyData) headerData bodyData contents
      decodePooledFragments pool parts payload next (Cons fragment done)
    _ -> Left "malformed pooled crate inference fragment"
decodePooledPayload : String -> Either String (List Separate.UnitObject)
decodePooledPayload payload = do
  fields <- canonicalFields payload
  case fields of
    Cons declarations (Cons bodies Nil) -> do
      pool <- decodeTypePool declarations
      let parts = M.fromList compareString (map (\declaration -> Pair (D.datatypeName declaration) (datatypePart declaration)) (M.elems pool))
      fragments <- decodePooledFragments pool parts bodies 0 Nil
      ensure (eqString payload (encodePooledPayload fragments)) "noncanonical pooled crate object"
      Right fragments
    _ -> Left "malformed pooled crate object payload"
decodeObjectFields iface fields = do
  case fields of
    Cons "MLFCO-2" (Cons identity (Cons metadataHash (Cons payload Nil))) -> do
      ensure (eqString identity (crateId iface)) "crate object identity mismatch"
      ensure (eqString metadataHash (Separate.fingerprint (encodeInterface iface))) "crate object metadata mismatch"
      ensure (eqString (Separate.fingerprint payload) (crateObjectFingerprint iface)) "crate object checksum mismatch"
      fragments <- decodePooledPayload payload
      Right (CrateObject iface fragments)
    Cons "MLFCO-1" (Cons identity (Cons metadataHash (Cons payload Nil))) -> do
      ensure (eqString identity (crateId iface)) "crate object identity mismatch"
      ensure (eqString metadataHash (Separate.fingerprint (encodeInterface iface))) "crate object metadata mismatch"
      ensure (eqString (Separate.fingerprint payload) (crateObjectFingerprint iface)) "crate object checksum mismatch"
      Pair pool _ <- poolDeclarations M.empty (crateLoweredData iface)
      fragments <- decodeFragmentsFrom payload 0 pool Nil
      Right (LegacyCrateObject iface fragments)
    _ -> Left "unsupported or malformed crate object (expected MLFCO-2 or MLFCO-1)"
decodeObject iface input = bindEither (canonicalFields input) (decodeObjectFields iface)

dependencyId (Triple n _ _) = n
dependencyPath (Triple _ path _) = path
dependencySemantic (Triple _ _ semantic) = semantic
interfaceMap interfaces = M.fromList compareString (map (\i -> Pair (crateId i) i) interfaces)
dependencyClosure : Map String CrateInterface -> List String -> List CrateInterface -> List String -> Either String (List CrateInterface)
dependencyClosure interfaces trail done pending = case pending of
  Nil -> Right done
  Cons n rest -> if elem eqString n trail then Left ("cyclic crate dependencies: " ++ intercalate " -> " (snoc trail n))
    else if any (\i -> eqString n (crateId i)) done then dependencyClosure interfaces trail done rest
    else case M.lookup compareString n interfaces of
      Nothing -> Left ("missing crate metadata: " ++ n)
      Just iface -> do
        earlier <- dependencyClosure interfaces (snoc trail n) done (map dependencyId (crateDependencies iface))
        dependencyClosure interfaces trail (snoc earlier iface) rest
validateDependencies interfaces iface = traverseEither (\dependency -> case M.lookup compareString (dependencyId dependency) interfaces of
  Nothing -> Left ("missing crate dependency: " ++ dependencyId dependency)
  Just actual -> do
    ensure (eqString (crateId actual) (dependencyId dependency)) "crate dependency identity mismatch"
    -- Source-free relinking must retain the namespace/instance contract under
    -- which this crate was resolved, including explicit constructor/type
    -- imports which do not become term parameters. Body and private value
    -- changes are excluded from this semantic fingerprint. A fresh consumer
    -- can publish updated dependency metadata while reusing its SCC queries.
    ensure (eqString (dependencySemantic dependency) (semanticFingerprint actual))
      ("stale crate dependency interface: " ++ crateId iface ++ " requires a different " ++ dependencyId dependency ++ "; recompile " ++ crateId iface)) (crateDependencies iface)
validateExportBoundary interfaces iface = do
  let dependencies = catMaybes (map (\d -> M.lookup compareString (dependencyId d) interfaces) (crateDependencies iface))
  let accessible = concatMap (\i -> concatMap snd (crateExports i)) dependencies
  traverseEither (\entity -> ensure (isPrimitiveEntity entity || elem eqString (Modules.owner entity) (crateModules iface) || any (\e -> Modules.compareEntity e entity == 0) accessible) ("crate reexports an entity outside its dependency boundary: " ++ Modules.label entity)) (concatMap snd (crateExports iface))

-- Recreate dictionary layouts from source headers, independently of object
-- text. A forged source signature cannot authorize an unrelated nominal ABI.
validateLayouts interfaces = do
  Pair program _ <- Classes.lowerSeparateClasses M.empty (concatMap (\i -> map fst (crateInstances i)) interfaces) (SClassProgram (concatMap crateData interfaces) (concatMap crateClasses interfaces) (concatMap (\i -> map snd (crateInstances i)) interfaces) (SConstructor "Unit"))
  expected <- case program of {SProgram ds _ -> Right ds; _ -> Left "invalid crate class metadata"}
  let recorded = concatMap crateLoweredData interfaces
  ensure (eqList eqString (sortStrings (map D.prettyDeclaration expected)) (sortStrings (map D.prettyDeclaration recorded))) "crate lowered datatype metadata mismatch"
  D.validateDeclarations recorded

sameSchemes actual expected = eqList Separate.sameSignature (Separate.sortBindings actual) (Separate.sortBindings expected)
sameDeclarations actual expected = eqList eqString (sortStrings (map D.prettyDeclaration actual)) (sortStrings (map D.prettyDeclaration expected))
data FragmentState = FragmentState Int (Map String (Pair XName XType)) (List XTerm) (List DataDecl) (Set String)
fragmentBindings (FragmentState _ available _ _ _) = available
fragmentSerial (FragmentState serial _ _ _ _) = serial
fragmentBodies (FragmentState _ _ bodies _ _) = bodies
fragmentData (FragmentState _ _ _ ds _) = ds

linkFragment allowedLayouts allowedSymbols ownSchemes (FragmentState serial available bodies allData groups) fragment = do
  let recorded = Separate.objectInterface fragment
  ensure (not (Set.member compareString (Separate.unitName recorded) groups)) "duplicate crate inference fragment"
  ensure (null (Separate.unitClasses recorded) && null (Separate.unitInstances recorded) && null (Separate.unitExports recorded)) "inference fragment contains source visibility metadata"
  -- Reuse only an opaque successful independent check. Raw fragments still check here.
  Separate.objectChecked fragment
  Pair next fresh <- Right (Separate.freshObject serial (Separate.objectTerm fragment))
  let extracted = case fresh of {XWithData ds b -> Pair ds b; term -> Pair Nil term}
  let ds = fst extracted
  ensure (sameDeclarations ds (Separate.unitData recorded)) "inference fragment datatype context mismatch"
  traverseEither (\declaration -> case M.lookup compareString (D.datatypeName declaration) allowedLayouts of
    Nothing -> Left ("inference fragment has an undeclared datatype: " ++ D.datatypeName declaration)
    Just actual -> ensure (eqString (D.prettyDeclaration declaration) (fst actual)) ("inference fragment datatype layout mismatch: " ++ D.datatypeName declaration)) ds
  ensure (eqString (Separate.fingerprintAfter (contextState allowedLayouts (Separate.objectContext fragment)) (Pretty.prettyTerm (Separate.objectBody fragment))) (Separate.unitObjectFingerprint recorded)) "inference fragment checksum mismatch"
  Pair parameters implementation <- Right (Separate.splitParameters (snd extracted))
  uniqueNames "fragment parameter" (map (\p -> X.nameHint (fst p)) parameters)
  ensure (all (\p -> Set.member compareString (X.nameHint (fst p)) allowedSymbols) parameters) "crate fragment imports a symbol outside its dependency boundary"
  replacements <- traverseEither (\(Pair n ty) -> case M.lookup compareString (X.nameHint n) available of
    Nothing -> Left ("unresolved crate symbol: " ++ X.nameHint n)
    Just (Pair actual expected) -> do
      ensure (T.alphaEq ty expected) ("crate import scheme mismatch: " ++ X.nameHint n)
      Right (Pair n actual)) parameters
  dataEnv <- D.validateDeclarations ds
  own <- Separate.collectBindings dataEnv (XEnv M.empty (M.fromList X.compareName parameters)) implementation
  let actual = map (\(Pair n ty) -> Pair (X.nameHint n) (Separate.normalType ty)) own
  ensure (sameSchemes actual (Separate.unitBindings recorded)) "crate fragment binding scheme mismatch"
  traverseEither (\(Pair n ty) -> case M.lookup compareString n ownSchemes of
    Nothing -> Left ("fragment binding is not owned by crate: " ++ n)
    Just expected -> ensure (T.alphaEq ty expected) ("crate object binding scheme mismatch: " ++ n)) actual
  uniqueNames "fragment binding" (map fst actual)
  ensure (all (\(Pair n _) -> not (M.member compareString n available)) actual) "duplicate crate symbol"
  let substitution = M.fromList X.compareName replacements
  let linked = Separate.mapTerm (\n -> M.findWithDefault X.compareName n n substitution) (\a -> a) implementation
  combined <- foldEither Separate.mergeDeclaration allData ds
  let newBindings = M.fromList compareString (map (\(Pair n ty) -> Pair (X.nameHint n) (Pair n ty)) own)
  Right (FragmentState next (M.union compareString newBindings available) (Cons linked bodies) combined (Set.insert compareString (Separate.unitName recorded) groups))

linkCrate interfaces allowedLayouts state object = do
  let iface = objectInterface object
  let fragments = objectFragments object
  validateInterface iface
  ensure (eqString (objectFingerprint object) (crateObjectFingerprint iface)) "crate fragment inventory checksum mismatch"
  dependencies <- dependencyClosure interfaces (Cons (crateId iface) Nil) Nil (map dependencyId (crateDependencies iface))
  let allowedSymbols = Set.fromList compareString (map fst (concatMap crateBindings (Cons iface dependencies)))
  let before = Set.fromList compareString (M.keys (fragmentBindings state))
  let ownSchemes = M.fromList compareString (crateBindings iface)
  after <- foldEither (linkFragment allowedLayouts allowedSymbols ownSchemes) state fragments
  let own = filter (\n -> not (Set.member compareString n before)) (M.keys (fragmentBindings after))
  ensure (eqList eqString (sortStrings own) (sortStrings (map fst (crateBindings iface)))) "crate object declaration inventory mismatch"
  Right after

entrySignatures entry bindings = filter (\(Pair name _) -> eqString name entry || startsWith "select_" name || startsWith "super_" name || startsWith "instance_" name) bindings
linkEntry serial interfaces root available entry =
  if eqString entry "" then Right (XConstructor "Unit" Nil) else do
    ensure (M.member compareString entry available) ("crate has no entry symbol: " ++ entry)
    let classes = concatMap crateClasses interfaces
    owner <- entryOwner root
    let reach = Cons owner (M.findWithDefault compareString Nil owner (M.fromList compareString (crateImports root)))
    instances <- mapEither concat (traverseEither (\iface -> traverseEither (\entry -> do {moduleName <- instanceOwner iface (fst entry); Right (Pair moduleName entry)}) (crateInstances iface)) interfaces)
    let visibleInstances = map snd (filter (\(Pair moduleName _) -> elem eqString moduleName reach) instances)
    let dictionaries = M.fromList compareString (map (\c -> Pair ("Dict_" ++ Classes.className c) (Classes.className c)) classes)
    -- Entry inference instantiates one already checked value. Its closed
    -- implementation dependencies are linked above and need no fake source
    -- parameters here. Keep every generated selector/dictionary external so
    -- class translation cannot regenerate an existing support definition.
    let signatures = M.fromList compareString (entrySignatures entry (concatMap crateBindings interfaces))
    let externals = M.mapWithKey (\n ty -> Separate.sourceScheme (if eqString (stringSlice n 0 7) "module_" then dictionaries else M.empty) ty) signatures
    lowered <- Classes.lowerSeparateClasses externals (map fst visibleInstances) (SClassProgram (concatMap crateData interfaces) classes (map snd visibleInstances) (SVar entry))
    compiled <- mapLeft Compiler.prettyError (Compiler.finishCompilation lowered)
    Separate.removeEntryParameters signatures available (snd (Separate.freshObject serial (Compiler.compiledTerm compiled)))

linkCheckedObjects objects root = do
  uniqueNames "object identity" (map (\o -> crateId (objectInterface o)) objects)
  let interfaces = map objectInterface objects
  let byName = interfaceMap interfaces
  ordered <- dependencyClosure byName Nil Nil (Cons root Nil)
  traverseEither (validateDependencies byName) ordered
  traverseEither (validateExportBoundary byName) ordered
  dataEnv <- validateLayouts ordered
  let layouts = M.fromList compareString (map (\d -> Pair (D.datatypeName d) (datatypePart d)) (concatMap crateLoweredData ordered))
  let objectMap = M.fromList compareString (map (\o -> Pair (crateId (objectInterface o)) o) objects)
  state <- foldEither (\s i -> case M.lookup compareString (crateId i) objectMap of {Nothing -> Left "missing crate object"; Just o -> linkCrate byName layouts s o}) (FragmentState 0 M.empty Nil Nil Set.empty) ordered
  let rootInterface = M.findWithDefault compareString (panic "missing root crate") root byName
  entry <- linkEntry (fragmentSerial state) ordered rootInterface (fragmentBindings state) (crateEntry rootInterface)
  body <- foldEither (\body declarations -> Separate.graft declarations body) entry (fragmentBodies state)
  Checked.check (XWithData (fragmentData state) body)
linkObjects objects root = mapEither Checked.term (linkCheckedObjects objects root)

readInterface path = do
  input <- Separate.readStrict path
  ioReturn (mapLeft (\e -> path ++ ": " ++ e) (bindEither input decodeInterface))
readObject path iface = do
  input <- Separate.readStrict path
  ioReturn (mapLeft (\e -> path ++ ": " ++ e) (bindEither input (decodeObject iface)))
objectPath path = stringSlice path 0 (stringLength path - 6) ++ ".mlfco"
loadGraph : List String -> List (Pair String CrateInterface) -> List String -> IO (Either String (List (Pair String CrateInterface)))
loadGraph trail done paths = case paths of
  Nil -> ioReturn (Right done)
  Cons requested rest -> do
    present <- fileExists requested
    if not present then ioReturn (Left ("crate metadata does not exist: " ++ requested)) else do
      path <- canonicalPath requested
      if elem eqString path trail then ioReturn (Left ("cyclic crate metadata paths: " ++ intercalate " -> " (snoc trail path)))
      else if any (\p -> eqString path (fst p)) done then loadGraph trail done rest else do
        read <- readInterface path
        case read of
          Left e -> ioReturn (Left e)
          Right iface -> if any (\p -> eqString (crateId (snd p)) (crateId iface)) done then ioReturn (Left ("duplicate crate identity from different metadata paths: " ++ crateId iface)) else do
            children <- loadGraph (snoc trail path) done (map dependencyPath (crateDependencies iface))
            case bindEither children (\xs -> do {validateDependencies (interfaceMap (map snd xs)) iface; validateExportBoundary (interfaceMap (map snd xs)) iface; Right xs}) of
              Left e -> ioReturn (Left e)
              Right xs -> loadGraph trail (snoc xs (Pair path iface)) rest
loadInterfaces paths = loadGraph Nil Nil paths
linkCheckedFile path = do
  loaded <- loadInterfaces (Cons path Nil)
  case loaded of
    Left e -> ioReturn (Left e)
    Right interfaces -> do
      objects <- mapM (\(Pair metadata iface) -> readObject (objectPath metadata) iface) interfaces
      ioReturn (bindEither (sequenceEither objects) (\os -> case reverse interfaces of {Nil -> Left "no root crate metadata"; Cons (Pair _ root) _ -> linkCheckedObjects os (crateId root)}))
linkFile path = do {linked <- linkCheckedFile path; ioReturn (mapEither Checked.term linked)}
writeObject prefix object = do
  writeFile (prefix ++ ".mlfco") (encodeObject object)
  writeFile (prefix ++ ".mlfci") (encodeInterface (objectInterface object))
  ioReturn Unit
showInterfaceFile path = do
  read <- readInterface path
  ioReturn (mapEither renderInterface read)
renderInterface iface =
  let dependencies = map (\(Triple n p h) -> "dependency " ++ n ++ " " ++ p ++ " " ++ h) (crateDependencies iface) in
  let modules = concatMap (\(Pair n entities) -> Cons ("module " ++ n) (map (\e -> "  export " ++ Modules.label e) entities)) (crateExports iface) in
  unlines (Cons ("crate " ++ crateId iface) (Cons ("interface " ++ semanticFingerprint iface) (append dependencies modules)))
