module Bootstrap.SourceEquality where
import Bootstrap.Types
import qualified Bootstrap.Std as L
import qualified Bootstrap.Primitive as P

eqBool : Bool -> Bool -> Bool
eqBool a b = if a then b else L.not b

eqTriple : forall a b c. (a -> a -> Bool) -> (b -> b -> Bool) -> (c -> c -> Bool) -> Triple a b c -> Triple a b c -> Bool
eqTriple ea eb ec (Triple a b c) (Triple x y z) = ea a x && eb b y && ec c z

eqField : Field -> Field -> Bool
eqField a b = case a of
  Parameter x0 -> case b of
    Parameter y0 -> eqString x0 y0
    _ -> false
  Function x0 x1 -> case b of
    Function y0 y1 -> eqField x0 y0 && eqField x1 y1
    _ -> false
  Applied x0 x1 -> case b of
    Applied y0 y1 -> eqString x0 y0 && (L.eqList eqField) x1 y1
    _ -> false
  Application x0 x1 -> case b of
    Application y0 y1 -> eqField x0 y0 && eqField x1 y1
    _ -> false
  Quantified x0 x1 x2 -> case b of
    Quantified y0 y1 y2 -> eqString x0 y0 && L.eqKind x1 y1 && eqField x2 y2
    _ -> false

eqConstructorDecl : ConstructorDecl -> ConstructorDecl -> Bool
eqConstructorDecl a b = case a of
  ConstructorDecl x0 x1 -> case b of
    ConstructorDecl y0 y1 -> eqString x0 y0 && (L.eqList eqField) x1 y1

eqDataDecl : DataDecl -> DataDecl -> Bool
eqDataDecl a b = case a of
  DataDecl x0 x1 x2 -> case b of
    DataDecl y0 y1 y2 -> eqString x0 y0 && (L.eqList eqString) x1 y1 && (L.eqList eqConstructorDecl) x2 y2
    _ -> false
  DataDeclK x0 x1 x2 -> case b of
    DataDeclK y0 y1 y2 -> eqString x0 y0 && (L.eqList (L.eqPair eqString L.eqKind)) x1 y1 && (L.eqList eqConstructorDecl) x2 y2
    _ -> false

eqSType : SType -> SType -> Bool
eqSType a b = case a of
  STVar x0 -> case b of
    STVar y0 -> eqString x0 y0
    _ -> false
  SBottom  -> case b of
    SBottom  -> true
    _ -> false
  SBottomKind x0 -> case b of
    SBottomKind y0 -> L.eqKind x0 y0
    _ -> false
  SArrow x0 x1 -> case b of
    SArrow y0 y1 -> eqSType x0 y0 && eqSType x1 y1
    _ -> false
  SCon x0 x1 -> case b of
    SCon y0 y1 -> eqString x0 y0 && (L.eqList eqSType) x1 y1
    _ -> false
  STypeApp x0 x1 -> case b of
    STypeApp y0 y1 -> eqSType x0 y0 && eqSType x1 y1
    _ -> false
  SForall x0 x1 x2 x3 -> case b of
    SForall y0 y1 y2 y3 -> L.eqFlag x0 y0 && eqString x1 y1 && eqSType x2 y2 && eqSType x3 y3
    _ -> false
  SQualified x0 x1 -> case b of
    SQualified y0 y1 -> (L.eqList eqSPredicate) x0 y0 && eqSType x1 y1
    _ -> false

eqSAnnotation : SAnnotation -> SAnnotation -> Bool
eqSAnnotation a b = case a of
  SAnnotation x0 x1 -> case b of
    SAnnotation y0 y1 -> (L.eqList eqString) x0 y0 && eqSType x1 y1

eqSExpr : SExpr -> SExpr -> Bool
eqSExpr a b = case a of
  SVar x0 -> case b of
    SVar y0 -> eqString x0 y0
    _ -> false
  SConstructor x0 -> case b of
    SConstructor y0 -> eqString x0 y0
    _ -> false
  SLam x0 x1 x2 -> case b of
    SLam y0 y1 y2 -> eqString x0 y0 && (L.eqMaybe eqSAnnotation) x1 y1 && eqSExpr x2 y2
    _ -> false
  SApp x0 x1 -> case b of
    SApp y0 y1 -> eqSExpr x0 y0 && eqSExpr x1 y1
    _ -> false
  SLet x0 x1 x2 -> case b of
    SLet y0 y1 y2 -> eqString x0 y0 && eqSExpr x1 y1 && eqSExpr x2 y2
    _ -> false
  SAnn x0 x1 -> case b of
    SAnn y0 y1 -> eqSExpr x0 y0 && eqSAnnotation x1 y1
    _ -> false
  SIntLit x0 -> case b of
    SIntLit y0 -> eqInt x0 y0
    _ -> false
  SDoubleLit x0 -> case b of
    SDoubleLit y0 -> eqDouble x0 y0
    _ -> false
  SBoolLit x0 -> case b of
    SBoolLit y0 -> eqBool x0 y0
    _ -> false
  SStringLit x0 -> case b of
    SStringLit y0 -> eqString x0 y0
    _ -> false
  SPrimitive x0 -> case b of
    SPrimitive y0 -> P.eqPrimitive x0 y0
    _ -> false
  SCase x0 x1 -> case b of
    SCase y0 y1 -> eqSExpr x0 y0 && (L.eqList eqSAlternative) x1 y1
    _ -> false
  SDo x0 x1 -> case b of
    SDo y0 y1 -> (L.eqList eqSStatement) x0 y0 && eqSExpr x1 y1
    _ -> false
  SEquations x0 -> case b of
    SEquations y0 -> (L.eqList (L.eqPair (L.eqList eqSPattern) eqSExpr)) x0 y0
    _ -> false
  SLetRec x0 x1 -> case b of
    SLetRec y0 y1 -> (L.eqList (eqTriple eqString eqSAnnotation eqSExpr)) x0 y0 && eqSExpr x1 y1
    _ -> false
  SWanted x0 x1 -> case b of
    SWanted y0 y1 -> eqString x0 y0 && (L.eqList (L.eqPair eqEvidenceRole eqString)) x1 y1
    _ -> false
  SChecked x0 x1 -> case b of
    SChecked y0 y1 -> eqSType x0 y0 && eqSExpr x1 y1
    _ -> false

eqSPattern : SPattern -> SPattern -> Bool
eqSPattern a b = case a of
  SConstructorPattern x0 x1 -> case b of
    SConstructorPattern y0 y1 -> eqString x0 y0 && (L.eqList (L.eqMaybe eqString)) x1 y1
    _ -> false
  SDefaultPattern x0 -> case b of
    SDefaultPattern y0 -> (L.eqMaybe eqString) x0 y0
    _ -> false
  SNestedPattern x0 x1 -> case b of
    SNestedPattern y0 y1 -> eqString x0 y0 && (L.eqList eqSPattern) x1 y1
    _ -> false
  SAnnotatedPattern x0 x1 -> case b of
    SAnnotatedPattern y0 y1 -> eqString x0 y0 && eqSAnnotation x1 y1
    _ -> false
  SIntPattern x0 -> case b of
    SIntPattern y0 -> eqInt x0 y0
    _ -> false
  SStringPattern x0 -> case b of
    SStringPattern y0 -> eqString x0 y0
    _ -> false
  SBoolPattern x0 -> case b of
    SBoolPattern y0 -> eqBool x0 y0
    _ -> false

eqSAlternative : SAlternative -> SAlternative -> Bool
eqSAlternative a b = case a of
  SAlternative x0 x1 -> case b of
    SAlternative y0 y1 -> eqSPattern x0 y0 && eqSExpr x1 y1

eqSStatement : SStatement -> SStatement -> Bool
eqSStatement a b = case a of
  SDoBind x0 x1 -> case b of
    SDoBind y0 y1 -> eqSPattern x0 y0 && eqSExpr x1 y1
    _ -> false
  SDoThen x0 -> case b of
    SDoThen y0 -> eqSExpr x0 y0
    _ -> false
  SDoLet x0 x1 x2 -> case b of
    SDoLet y0 y1 y2 -> eqString x0 y0 && (L.eqMaybe eqSAnnotation) x1 y1 && eqSExpr x2 y2
    _ -> false
  SDoLetRec x0 -> case b of
    SDoLetRec y0 -> (L.eqList (eqTriple eqString eqSAnnotation eqSExpr)) x0 y0
    _ -> false

eqSPredicate : SPredicate -> SPredicate -> Bool
eqSPredicate a b = case a of
  SPredicate x0 x1 -> case b of
    SPredicate y0 y1 -> eqString x0 y0 && (L.eqList eqSType) x1 y1

eqSClassDecl : SClassDecl -> SClassDecl -> Bool
eqSClassDecl a b = case a of
  SClassDecl x0 x1 x2 x3 -> case b of
    SClassDecl y0 y1 y2 y3 -> eqString x0 y0 && (L.eqList (L.eqPair eqString L.eqKind)) x1 y1 && (L.eqList eqSPredicate) x2 y2 && (L.eqList (L.eqPair eqString eqSType)) x3 y3

eqSInstanceDecl : SInstanceDecl -> SInstanceDecl -> Bool
eqSInstanceDecl a b = case a of
  SInstanceDecl x0 x1 x2 x3 x4 -> case b of
    SInstanceDecl y0 y1 y2 y3 y4 -> (L.eqList (L.eqPair eqString L.eqKind)) x0 y0 && (L.eqList eqSPredicate) x1 y1 && eqString x2 y2 && (L.eqList eqSType) x3 y3 && (L.eqList (L.eqPair eqString eqSExpr)) x4 y4

eqEvidenceRole : EvidenceRole -> EvidenceRole -> Bool
eqEvidenceRole a b = case a of
  GivenEvidence  -> case b of
    GivenEvidence  -> true
    _ -> false
  SuperclassEvidence  -> case b of
    SuperclassEvidence  -> true
    _ -> false
  InstanceEvidence  -> case b of
    InstanceEvidence  -> true
    _ -> false

eqSProgram : SProgram -> SProgram -> Bool
eqSProgram a b = case a of
  SProgram x0 x1 -> case b of
    SProgram y0 y1 -> (L.eqList eqDataDecl) x0 y0 && eqSExpr x1 y1
    _ -> false
  SClassProgram x0 x1 x2 x3 -> case b of
    SClassProgram y0 y1 y2 y3 -> (L.eqList eqDataDecl) x0 y0 && (L.eqList eqSClassDecl) x1 y1 && (L.eqList eqSInstanceDecl) x2 y2 && eqSExpr x3 y3
    _ -> false

eqSourceModule : SourceModule -> SourceModule -> Bool
eqSourceModule a b = case a of
  SourceModule x0 x1 x2 x3 x4 x5 x6 x7 x8 -> case b of
    SourceModule y0 y1 y2 y3 y4 y5 y6 y7 y8 -> eqString x0 y0 && (L.eqMaybe eqString) x1 y1 && (L.eqMaybe (L.eqList eqExport)) x2 y2 && (L.eqList eqImport) x3 y3 && (L.eqList eqDataDecl) x4 y4 && (L.eqList eqSClassDecl) x5 y5 && (L.eqList eqSInstanceDecl) x6 y6 && (L.eqList (eqTriple eqString (L.eqMaybe eqSAnnotation) eqSExpr)) x7 y7 && (L.eqMaybe eqSExpr) x8 y8

eqImport : Import -> Import -> Bool
eqImport a b = case a of
  Import x0 x1 x2 x3 -> case b of
    Import y0 y1 y2 y3 -> eqString x0 y0 && eqBool x1 y1 && (L.eqMaybe eqString) x2 y2 && eqSelection x3 y3

eqSelection : Selection -> Selection -> Bool
eqSelection a b = case a of
  Everything  -> case b of
    Everything  -> true
    _ -> false
  Only x0 -> case b of
    Only y0 -> (L.eqList eqExport) x0 y0
    _ -> false
  Hiding x0 -> case b of
    Hiding y0 -> (L.eqList eqExport) x0 y0
    _ -> false

eqExport : Export -> Export -> Bool
eqExport a b = case a of
  ExportValue x0 -> case b of
    ExportValue y0 -> eqString x0 y0
    _ -> false
  ExportType x0 x1 -> case b of
    ExportType y0 y1 -> eqString x0 y0 && eqMembers x1 y1
    _ -> false
  ExportModule x0 -> case b of
    ExportModule y0 -> eqString x0 y0
    _ -> false

eqMembers : Members -> Members -> Bool
eqMembers a b = case a of
  Abstract  -> case b of
    Abstract  -> true
    _ -> false
  AllMembers  -> case b of
    AllMembers  -> true
    _ -> false
  Members x0 -> case b of
    Members y0 -> (L.eqList eqString) x0 y0
    _ -> false

eqPreludeMode : PreludeMode -> PreludeMode -> Bool
eqPreludeMode a b = case a of
  ImplicitPrelude  -> case b of
    ImplicitPrelude  -> true
    _ -> false
  NoImplicitPrelude  -> case b of
    NoImplicitPrelude  -> true
    _ -> false

eqType : SType -> SType -> Bool
eqType a b = eqSType a b
eqAnnotation : SAnnotation -> SAnnotation -> Bool
eqAnnotation a b = eqSAnnotation a b
eqPattern : SPattern -> SPattern -> Bool
eqPattern a b = eqSPattern a b
eqExpr : SExpr -> SExpr -> Bool
eqExpr a b = eqSExpr a b
