module Bootstrap.Data where

import Bootstrap.Types
import Bootstrap.Std
import qualified Bootstrap.Map as M
import qualified Bootstrap.Kind as K
import qualified Bootstrap.Unicode as U

datatypeName : DataDecl -> String
datatypeName (DataDecl n _ _) = n
datatypeName (DataDeclK n _ _) = n

datatypeBinders : DataDecl -> List (Pair String Kind)
datatypeBinders (DataDecl _ ps _) = map (\p -> Pair p Star) ps
datatypeBinders (DataDeclK _ ps _) = ps

datatypeParameters d = map fst (datatypeBinders d)

datatypeConstructors : DataDecl -> List ConstructorDecl
datatypeConstructors (DataDecl _ _ cs) = cs
datatypeConstructors (DataDeclK _ _ cs) = cs

constructorName (ConstructorDecl n _) = n
constructorFields (ConstructorDecl _ fs) = fs

primitiveKinds : Map String Kind
primitiveKinds = M.fromList compareString (Cons (Pair "ST" (KArrow Star (KArrow Star Star))) (Cons (Pair "STArray" (KArrow Star (KArrow Star Star))) (Cons (Pair "Int" Star) (Cons (Pair "Double" Star) (Cons (Pair "Bool" Star) (Cons (Pair "String" Star) (Cons (Pair "Unit" Star) (Cons (Pair "IntArray" Star) (Cons (Pair "DoubleArray" Star) (Cons (Pair "ByteArray" Star) (Cons (Pair "IntTable" Star) (Cons (Pair "IO" (KArrow Star Star)) Nil))))))))))))

unitDeclaration = DataDecl "Unit" Nil (Cons (ConstructorDecl "Unit" Nil) Nil)

withKinds ks = DataEnv (M.singleton "Unit" unitDeclaration) (M.singleton "Unit" (Pair unitDeclaration (ConstructorDecl "Unit" Nil))) (M.union compareString primitiveKinds (M.fromList compareString ks))
emptyDataEnv = withKinds Nil

lookupDatatype : DataEnv -> String -> Either String DataDecl
lookupDatatype (DataEnv ds _ _) n = case M.lookup compareString n ds of
  Nothing -> Left ("unknown data type: " ++ n)
  Just d -> Right d

lookupConstructor : DataEnv -> String -> Either String (Pair DataDecl ConstructorDecl)
lookupConstructor (DataEnv _ cs _) n = case M.lookup compareString n cs of
  Nothing -> Left ("unknown data constructor: " ++ n)
  Just c -> Right c

constructorKind : DataEnv -> String -> Int -> Kind
constructorKind (DataEnv _ _ ks) n fallback = case M.lookup compareString n primitiveKinds of
  Just k -> k
  Nothing -> M.findWithDefault compareString (foldr KArrow Star (replicate fallback Star)) n ks

checkArity : DataEnv -> String -> Int -> Either String Unit
checkArity (DataEnv ds _ _) n actual =
  let expected = case M.lookup compareString n primitiveKinds of
        Just k -> Just (K.kindArity k)
        Nothing -> mapOptional (\d -> length (datatypeParameters d)) (M.lookup compareString n ds)
  in case expected of
    Nothing -> Right Unit
    Just arity -> if actual == arity then Right Unit else Left ("invalid type constructor arity: " ++ n ++ " expects " ++ showInt arity ++ ", got " ++ showInt actual)

identifierTail : String -> Int -> Bool
identifierTail name i = if i >= stringLength name then true else
  let c = stringCodeAt name i in
  (U.isAlphaNum c || c == 95 || c == 39) && identifierTail name (i + 1)

identifier first name = stringLength name > 0 && first (stringCodeAt name 0) && identifierTail name 1
upper what name = if identifier U.isUpper name then Right Unit else Left ("invalid " ++ what ++ " name: " ++ name)

keywords = Cons "data" (Cons "class" (Cons "instance" (Cons "where" (Cons "case" (Cons "of" (Cons "do" (Cons "let" (Cons "in" (Cons "forall" (Cons "exists" (Cons "true" (Cons "false" (Cons "bot" Nil)))))))))))))

memberString : String -> List String -> Bool
memberString name names = any (eqString name) names

distinct : String -> List String -> Either String Unit
distinct what xs = if length xs == length (nubBy eqString xs) then Right Unit else Left ("duplicate " ++ what)

fieldKind : List DataDecl -> DataEnv -> Map String Kind -> Field -> Either String Kind
fieldKind declarations env ps field = case field of
  Parameter p -> case M.lookup compareString p ps of
    Nothing -> Left ("unbound data type parameter: " ++ p)
    Just k -> Right k
  Function a b -> do
    ka <- fieldKind declarations env ps a
    kb <- fieldKind declarations env ps b
    if K.eqKind ka Star && K.eqKind kb Star then Right Star else Left "function fields require kind * arguments"
  Applied c args -> do
    unless (M.member compareString c primitiveKinds || memberString c (map datatypeName declarations)) (Left ("unknown field type: " ++ c))
    when (length args > K.kindArity (constructorKind env c 0)) (checkArity env c (length args))
    ks <- mapM (fieldKind declarations env ps) args
    foldM K.applyKind (constructorKind env c (length args)) ks
  Application a b -> do
    ka <- fieldKind declarations env ps a
    kb <- fieldKind declarations env ps b
    K.applyKind ka kb
  Quantified a k b -> fieldKind declarations env (M.insert compareString a k ps) b

validateConstructor : List DataDecl -> DataEnv -> DataDecl -> ConstructorDecl -> Either String Unit
validateConstructor declarations env d c = do
  upper "data constructor" (constructorName c)
  when (memberString (constructorName c) (Cons "True" (Cons "False" (Cons "Unit" Nil)))) (Left "cannot redefine a primitive constructor")
  mapM_ (\field -> do
    k <- fieldKind declarations env (M.fromList compareString (datatypeBinders d)) field
    unless (K.eqKind k Star) (Left "constructor field must have kind *")) (constructorFields c)

validateDeclaration : List DataDecl -> DataEnv -> DataDecl -> Either String Unit
validateDeclaration declarations env d = do
  upper "data type" (datatypeName d)
  when (M.member compareString (datatypeName d) primitiveKinds) (Left "cannot redefine a primitive type")
  when (memberString (datatypeName d) (Cons "True" (Cons "False" Nil))) (Left "reserved data type name")
  distinct "type parameter" (datatypeParameters d)
  mapM_ (\p -> unless (identifier U.isLower p && not (memberString p keywords)) (Left ("invalid type parameter: " ++ p))) (datatypeParameters d)
  when (null (datatypeConstructors d)) (Left ("data type has no constructors: " ++ datatypeName d))
  mapM_ (validateConstructor declarations env d) (datatypeConstructors d)

validateDeclarations : List DataDecl -> Either String DataEnv
validateDeclarations ds = do
  distinct "data type" (map datatypeName ds)
  distinct "data constructor" (concatMap (\d -> map constructorName (datatypeConstructors d)) ds)
  let declarations = Cons unitDeclaration ds
  let env = DataEnv (M.fromList compareString (map (\d -> Pair (datatypeName d) d) declarations)) (M.fromList compareString (concatMap (\d -> map (\c -> Pair (constructorName c) (Pair d c)) (datatypeConstructors d)) declarations)) (M.union compareString primitiveKinds (M.fromList compareString (map (\d -> Pair (datatypeName d) (foldr (\p k -> KArrow (snd p) k) Star (datatypeBinders d))) ds)))
  mapM_ (validateDeclaration ds env) ds
  Right env

alternativeNames : List (Pair (Maybe String) Int) -> List String
alternativeNames Nil = Nil
alternativeNames (Cons (Pair Nothing _) rest) = alternativeNames rest
alternativeNames (Cons (Pair (Just c) _) rest) = Cons c (alternativeNames rest)

defaultPositions : Int -> List (Pair (Maybe String) Int) -> List Int
defaultPositions _ Nil = Nil
defaultPositions i (Cons (Pair name _) rest) = case name of
  Nothing -> Cons i (defaultPositions (i + 1) rest)
  Just _ -> defaultPositions (i + 1) rest

validDefaults defaults total = case defaults of
  Nil -> true
  Cons n Nil -> n == total - 1
  _ -> false

alternativeOwners : DataEnv -> List (Pair (Maybe String) Int) -> Either String (List DataDecl)
alternativeOwners _ Nil = Right Nil
alternativeOwners env (Cons (Pair name arity) rest) = case name of
  Nothing -> alternativeOwners env rest
  Just c -> do
    dc <- lookupConstructor env c
    let d = fst dc
    let ctor = snd dc
    unless (arity == length (constructorFields ctor)) (Left ("constructor pattern arity mismatch: " ++ c))
    ds <- alternativeOwners env rest
    Right (Cons d ds)

checkAlternatives : DataEnv -> List (Pair (Maybe String) Int) -> Either String (Maybe DataDecl)
checkAlternatives env alternatives = do
  when (null alternatives) (Left "case has no alternatives")
  let names = alternativeNames alternatives
  let defaults = defaultPositions 0 alternatives
  distinct "constructor alternative" names
  unless (validDefaults defaults (length alternatives)) (Left "a default alternative must be last and unique")
  owners <- alternativeOwners env alternatives
  case owners of
    Nil -> Right Nothing
    Cons d rest -> do
      unless (all (\other -> eqString (datatypeName d) (datatypeName other)) rest) (Left "case patterns belong to different data types")
      let missing = filter (\c -> not (memberString c names)) (map constructorName (datatypeConstructors d))
      when (null defaults && not (null missing)) (Left ("non-exhaustive case; missing: " ++ intercalate ", " missing))
      Right (Just d)

par yes text = if yes then "(" ++ text ++ ")" else text
prettyParameter : Pair String Kind -> String
prettyParameter (Pair name Star) = name
prettyParameter (Pair name kind) = "(" ++ name ++ " : " ++ K.prettyKind kind ++ ")"

prettyField : Int -> Field -> String
prettyField p field = case field of
  Parameter a -> a
  Applied c Nil -> c
  Applied c args -> par (p > 1) (intercalate " " (Cons c (map (prettyField 2) args)))
  Function a b -> par (p > 0) (prettyField 1 a ++ " -> " ++ prettyField 0 b)
  Application a b -> par (p > 1) (prettyField 1 a ++ " " ++ prettyField 2 b)
  Quantified n k b -> par (p > 0) ("forall " ++ prettyParameter (Pair n k) ++ ". " ++ prettyField 0 b)

prettyConstructor c = intercalate " " (Cons (constructorName c) (map (prettyField 2) (constructorFields c)))
prettyDeclaration d = "data " ++ intercalate " " (Cons (datatypeName d) (map prettyParameter (datatypeBinders d))) ++ " = " ++ intercalate " | " (map prettyConstructor (datatypeConstructors d)) ++ ";"
