module Bootstrap.LLVM.Optimize where

import Bootstrap.Types
import qualified Bootstrap.Std as L
import qualified Bootstrap.Map as M
import qualified Bootstrap.Set as S
import qualified Bootstrap.X.Syntax as X

-- Fresh copies preserve global binder identity uniqueness when rewriting.
data Fresh a = Fresh (Int -> Pair a Int)

runFresh : forall a. Fresh a -> Int -> Pair a Int
runFresh (Fresh f) seed = f seed

freshPure : forall a. a -> Fresh a
freshPure value = Fresh (\seed -> Pair value seed)

freshBind : forall a b. Fresh a -> (a -> Fresh b) -> Fresh b
freshBind action next = Fresh (\seed -> case runFresh action seed of
  Pair value after -> runFresh (next value) after)

instance Monad Fresh where
  return = freshPure
  bind = freshBind

freshName : Fresh XName
freshName = Fresh (\seed -> Pair (XName seed "native") (seed + 1))

nameId : XName -> Int
nameId (XName n hint) = n

compareName : XName -> XName -> Int
compareName a b = if nameId a < nameId b then 0 - 1 else if nameId a == nameId b then 0 else 1

eqName : XName -> XName -> Bool
eqName a b = nameId a == nameId b

free : XErased -> Set XName
free expression = case expression of
  XEVar n -> S.singleton n
  XEAbs n b -> S.delete compareName n (free b)
  XEApp f a -> S.union compareName (free f) (free a)
  XELet n a b -> S.union compareName (free a) (S.delete compareName n (free b))
  XELetRec ds b -> S.difference compareName (S.unions compareName (Cons (free b) (L.map (\entry -> case entry of Pair n a -> free a) ds))) (S.fromList compareName (L.map (\entry -> case entry of Pair n a -> n) ds))
  XECase a branches -> S.union compareName (free a) (S.unions compareName (L.map freeAlternative branches))
  _ -> S.empty

freeAlternative : XErasedAlternative -> Set XName
freeAlternative (XErasedAlternative p b) = S.difference compareName (free b) (S.fromList compareName (X.patternNames p))

applications : XErased -> Pair XErased (List XErased)
applications expression = collectApplications Nil expression

collectApplications : List XErased -> XErased -> Pair XErased (List XErased)
collectApplications args expression = case expression of
  XEApp f a -> collectApplications (Cons a args) f
  _ -> Pair expression args

lambdas : XErased -> Pair (List XName) XErased
lambdas expression = case expression of
  XEAbs n b -> case lambdas b of
    Pair ns body -> Pair (Cons n ns) body
  _ -> Pair Nil expression

-- Match the seed's bounded size query: a function larger than the inlining
-- threshold need not have its remaining tree traversed.
remainingSize : Int -> XErased -> Int
remainingSize budget expression = if budget <= 0 then 0 - 1 else
  let rest = budget - 1 in case expression of
    XEAbs n b -> remainingSize rest b
    XEApp f a -> remainingSize (remainingSize rest f) a
    XELet n a b -> remainingSize (remainingSize rest a) b
    XELetRec ds b -> remainingSizes (remainingSize rest b) (L.map (\entry -> case entry of Pair n a -> a) ds)
    XECase a branches -> remainingSizes (remainingSize rest a) (L.map (\branch -> case branch of XErasedAlternative p b -> b) branches)
    _ -> rest

remainingSizes : Int -> List XErased -> Int
remainingSizes budget expressions = if budget < 0 then 0 - 1 else case expressions of
  Nil -> budget
  Cons expression rest -> remainingSizes (remainingSize budget expression) rest

-- Only zero, one, and multiple free uses matter to these rewrites. The limit
-- is shared across siblings, and binder checks keep this query scope-correct.
occurrences : Int -> XName -> XErased -> Int
occurrences limit name expression = if limit <= 0 then 0 else case expression of
  XEVar n -> if eqName name n then 1 else 0
  XEAbs n b -> if eqName name n then 0 else occurrences limit name b
  XEApp f a -> occurrenceTerms limit name (Cons f (Cons a Nil))
  XELet n a b -> occurrenceTerms limit name (Cons a (if eqName name n then Nil else Cons b Nil))
  XELetRec ds b -> if L.any (\entry -> case entry of Pair n a -> eqName name n) ds then 0 else
    occurrenceTerms limit name (Cons b (L.map (\entry -> case entry of Pair n a -> a) ds))
  XECase a branches -> occurrenceTerms limit name (Cons a (L.map (\branch -> case branch of XErasedAlternative p b -> b)
    (L.filter (\branch -> case branch of XErasedAlternative p b -> L.not (L.any (eqName name) (X.patternNames p))) branches)))
  _ -> 0

occurrenceTerms : Int -> XName -> List XErased -> Int
occurrenceTerms limit name expressions = if limit <= 0 then 0 else case expressions of
  Nil -> 0
  Cons expression rest -> let used = occurrences limit name expression in
    used + occurrenceTerms (limit - used) name rest

traverseFresh : forall a b. (a -> Fresh b) -> List a -> Fresh (List b)
traverseFresh f values = case values of
  Nil -> freshPure Nil
  Cons a rest -> do
    value <- f a
    tail <- traverseFresh f rest
    freshPure (Cons value tail)

copy : Map XName XErased -> XErased -> Fresh XErased
copy env expression = case expression of
  XEVar n -> freshPure (M.findWithDefault compareName expression n env)
  XEAbs n b -> do
    renamed <- freshName
    body <- copy (M.insert compareName n (XEVar renamed) env) b
    freshPure (XEAbs renamed body)
  XEApp f a -> do
    function <- copy env f
    argument <- copy env a
    freshPure (XEApp function argument)
  XELet n a b -> do
    renamed <- freshName
    value <- copy env a
    body <- copy (M.insert compareName n (XEVar renamed) env) b
    freshPure (XELet renamed value body)
  XELetRec ds b -> do
    names <- traverseFresh (\ignored -> freshName) ds
    let local = M.union compareName (M.fromList compareName (L.zipWith (\entry n -> case entry of Pair old a -> Pair old (XEVar n)) ds names)) env
    bindings <- traverseFresh (copyRecursive local) (L.zip names ds)
    body <- copy local b
    freshPure (XELetRec bindings body)
  XECase a branches -> do
    subject <- copy env a
    alternatives <- traverseFresh (copyAlternative env) branches
    freshPure (XECase subject alternatives)
  _ -> freshPure expression

copyRecursive : Map XName XErased -> Pair XName (Pair XName XErased) -> Fresh (Pair XName XErased)
copyRecursive env (Pair name (Pair old value)) = do
  copied <- copy env value
  freshPure (Pair name copied)

copyAlternative : Map XName XErased -> XErasedAlternative -> Fresh XErasedAlternative
copyAlternative env (XErasedAlternative pattern body) = do
  names <- traverseFresh (\ignored -> freshName) (X.patternNames pattern)
  let renaming = M.fromList compareName (L.zip (X.patternNames pattern) names)
  let patternNext = case pattern of
        XDefaultPattern name -> XDefaultPattern (renameMaybe renaming name)
        XConstructorPattern c fields -> XConstructorPattern c (L.map (renameMaybe renaming) fields)
  result <- copy (M.union compareName (M.map XEVar renaming) env) body
  freshPure (XErasedAlternative patternNext result)

renameMaybe : Map XName XName -> Maybe XName -> Maybe XName
renameMaybe renaming optional = case optional of
  Nothing -> Nothing
  Just name -> Just (M.findWithDefault compareName name name renaming)

children : (XErased -> Fresh XErased) -> XErased -> Fresh XErased
children f expression = case expression of
  XEAbs n b -> do
    body <- f b
    freshPure (XEAbs n body)
  XEApp a b -> do
    function <- f a
    argument <- f b
    freshPure (XEApp function argument)
  XELet n a b -> do
    value <- f a
    body <- f b
    freshPure (XELet n value body)
  XELetRec ds b -> do
    definitions <- traverseFresh (\entry -> case entry of
      Pair n a -> do
        value <- f a
        freshPure (Pair n value)) ds
    body <- f b
    freshPure (XELetRec definitions body)
  XECase a branches -> do
    subject <- f a
    alternatives <- traverseFresh (\branch -> case branch of
      XErasedAlternative p b -> do
        body <- f b
        freshPure (XErasedAlternative p body)) branches
    freshPure (XECase subject alternatives)
  _ -> freshPure expression

identities : XErased -> Fresh XErased
identities expression = do
  normalized <- children identities expression
  case normalized of
    XEApp (XEAbs n (XEVar other)) argument -> if eqName n other then freshPure argument else freshPure normalized
    XELet n (XEVar a) b -> copy (M.singleton n (XEVar a)) b
    _ -> freshPure normalized

fixedPoints : XErased -> Fresh XErased
fixedPoints expression = case expression of
  XEAbs f (XELet g (XEAbs r (XECase (XEVar r1) (Cons (XErasedAlternative (XConstructorPattern c (Cons (Just next) Nil)) (XEApp (XEVar f1) (XEApp (XEVar next1) (XEVar r2)))) Nil))) (XEApp (XEVar g1) (XEApp (XEConstructor c1) (XEVar g2)))) ->
    if eqName f f1 && eqName r r1 && eqName r r2 && eqName next next1 && eqName g g1 && eqName g g2 && eqString c c1 then do
      loop <- freshName
      freshPure (XEAbs f (XELetRec (Cons (Pair loop (XEApp (XEVar f) (XEVar loop))) Nil) (XEVar loop)))
    else children fixedPoints expression
  _ -> children fixedPoints expression

atom : XErased -> Bool
atom expression = case expression of
  XEVar n -> true
  XEPrimitive p -> true
  XEConstructor c -> true
  XEInt n -> true
  XEDouble n -> true
  XEBool b -> true
  _ -> false

smallValue : XErased -> Bool
smallValue expression = if atom expression then true else case expression of
  XEAbs n b -> remainingSize 24 expression >= 0
  _ -> case applications expression of
    Pair (XEConstructor c) args -> L.all atom args
    _ -> false

-- Arity evidence comes from independently checked constructor patterns. No
-- constructor spelling or runtime tag is special; absent/conflicting evidence
-- disables propagation, and partial applications are never treated as data.
subterms : XErased -> List XErased
subterms expression = case expression of
  XEAbs n b -> Cons b Nil
  XEApp f a -> Cons f (Cons a Nil)
  XELet n a b -> Cons a (Cons b Nil)
  XELetRec ds b -> L.snoc (L.map (\entry -> case entry of Pair n a -> a) ds) b
  XECase a branches -> Cons a (L.map (\branch -> case branch of XErasedAlternative p b -> b) branches)
  _ -> Nil

agreeArity : Maybe Int -> Maybe Int -> Maybe Int
agreeArity a b = case a of
  Just n -> case b of
    Just m -> if n == m then Just n else Nothing
    Nothing -> Nothing
  Nothing -> Nothing

alternativeArity : Map String (Maybe Int) -> XErasedAlternative -> Map String (Maybe Int)
alternativeArity known (XErasedAlternative pattern body) = case pattern of
  XConstructorPattern c names -> M.insertWith compareString agreeArity c (Just (L.length names)) known
  _ -> known

collectArities : Map String (Maybe Int) -> XErased -> Map String (Maybe Int)
collectArities known expression =
  let after = case expression of
        XECase a branches -> L.foldlStrict alternativeArity known branches
        _ -> known in
  L.foldlStrict collectArities after (subterms expression)

constructorArities : XErased -> Map String (Maybe Int)
constructorArities expression = collectArities M.empty expression

constructorValue : Map String (Maybe Int) -> XErased -> Maybe (Pair String (List XErased))
constructorValue arities expression = case applications expression of
  Pair (XEConstructor c) args -> case M.lookup compareString c arities of
    Just (Just arity) -> if arity == L.length args then Just (Pair c args) else Nothing
    _ -> Nothing
  _ -> Nothing

-- Each non-atomic field gets one lazy binding before any projection is
-- copied. Recursive fields remain in the original group to preserve knots.
liftField : XErased -> Fresh (Pair (List (Pair XName XErased)) XErased)
liftField field = if atom field then freshPure (Pair Nil field) else do
  name <- freshName
  freshPure (Pair (Cons (Pair name field) Nil) (XEVar name))

liftConstructorValue : Map String (Maybe Int) -> XErased -> Fresh (Pair (List (Pair XName XErased)) XErased)
liftConstructorValue arities value = case constructorValue arities value of
  Just (Pair c args) -> do
    fields <- traverseFresh liftField args
    freshPure (Pair (L.concatMap L.fst fields) (L.foldl XEApp (XEConstructor c) (L.map L.snd fields)))
  Nothing -> freshPure (Pair Nil value)

liftConstructorBinding : Map String (Maybe Int) -> Pair XName XErased -> Fresh (Pair (Pair XName XErased) (List (Pair XName XErased)))
liftConstructorBinding arities (Pair name rhs) = do
  lifted <- liftConstructorValue arities rhs
  case lifted of
    Pair fields value -> freshPure (Pair (Pair name value) fields)

liftConstructorFields : Map String (Maybe Int) -> XErased -> Fresh XErased
liftConstructorFields arities expression = do
  normalized <- children (liftConstructorFields arities) expression
  case normalized of
    XELet name rhs body -> do
      lifted <- liftConstructorValue arities rhs
      case lifted of
        Pair fields value -> freshPure (L.foldr (\entry rest -> case entry of Pair n a -> XELet n a rest) (XELet name value body) fields)
    XELetRec ds body -> do
      lifted <- traverseFresh (liftConstructorBinding arities) ds
      freshPure (XELetRec (L.append (L.map L.fst lifted) (L.concatMap L.snd lifted)) body)
    _ -> freshPure normalized

constructorFact : Map String (Maybe Int) -> Map XName (Pair String (List XErased)) -> Pair XName XErased -> Map XName (Pair String (List XErased))
constructorFact arities known (Pair name rhs) = case constructorValue arities rhs of
  Just (Pair c fields) -> if L.all smallValue fields then M.insert compareName name (Pair c fields) known else known
  Nothing -> known

collectConstructorFacts : Map String (Maybe Int) -> Map XName (Pair String (List XErased)) -> XErased -> Map XName (Pair String (List XErased))
collectConstructorFacts arities known expression =
  let after = case expression of
        XELet name rhs body -> constructorFact arities known (Pair name rhs)
        XELetRec ds body -> L.foldlStrict (constructorFact arities) known ds
        _ -> known in
  L.foldlStrict (collectConstructorFacts arities) after (subterms expression)

constructorFacts : Map String (Maybe Int) -> XErased -> Map XName (Pair String (List XErased))
constructorFacts arities expression = collectConstructorFacts arities M.empty expression

projectConstructors : Map XName (Pair String (List XErased)) -> XErased -> Fresh XErased
projectConstructors facts expression = do
  normalized <- children (projectConstructors facts) expression
  case normalized of
    XECase (XEVar name) branches -> case M.lookup compareName name facts of
      Just (Pair c args) -> case selectConstructor c args branches of
        -- Small lifted values may have inlined back into fields. Freshen any
        -- copied binders so repeated projections keep global identities unique.
        Just selected -> copy M.empty selected
        Nothing -> freshPure normalized
      Nothing -> freshPure normalized
    _ -> freshPure normalized

substitute : XName -> XErased -> XErased -> Fresh XErased
substitute name value expression = case expression of
  XEVar n -> if eqName n name then copy M.empty value else freshPure expression
  _ -> children (substitute name value) expression

selectConstructor : String -> List XErased -> List XErasedAlternative -> Maybe XErased
selectConstructor constructor args branches = case branches of
  Nil -> Nothing
  Cons (XErasedAlternative pattern body) rest -> case pattern of
    XConstructorPattern c names -> if eqString constructor c && L.length names == L.length args then
        Just (L.foldr (\entry restBody -> case entry of Pair optional value -> maybeLet optional value restBody) body (L.zip names args))
      else selectConstructor constructor args rest
    XDefaultPattern optional -> Just (maybeLet optional (L.foldl XEApp (XEConstructor constructor) args) body)

maybeLet : Maybe XName -> XErased -> XErased -> XErased
maybeLet optional value body = case optional of
  Nothing -> body
  Just name -> XELet name value body

pass : XErased -> Fresh XErased
pass expression = do
  normalized <- children pass expression
  rewrite normalized

rewrite : XErased -> Fresh XErased
rewrite expression = case expression of
  XEApp (XEAbs n b) a -> freshPure (XELet n a b)
  XEApp (XELet n a f) b -> freshPure (XELet n a (XEApp f b))
  XEApp (XELetRec ds f) a -> freshPure (XELetRec ds (XEApp f a))
  XELet n a b -> let uses = occurrences 2 n b in if uses == 0 then freshPure b else
    if smallValue a then substitute n a b else case a of
      XEAbs ignored body -> if uses == 1 then substitute n a b else rewriteLet n a b
      _ -> rewriteLet n a b
  XELetRec ds b ->
    let group = S.fromList compareName (L.map (\entry -> case entry of Pair n a -> n) ds) in
    let expandable = L.filter (\entry -> case entry of Pair n a -> smallValue a && S.null (S.intersection compareName (free a) group)) ds in
    let expandedNames = S.fromList compareName (L.map (\entry -> case entry of Pair n a -> n) expandable) in
    let keep = L.filter (\entry -> case entry of Pair n a -> L.not (S.member compareName n expandedNames)) ds in
    substituteBindings (if L.null keep then b else XELetRec keep b) expandable
  XECase a (Cons (XErasedAlternative (XDefaultPattern optional) b) Nil) -> freshPure (maybeLet optional a b)
  XECase a branches -> case applications a of
    Pair (XEConstructor c) args -> case selectConstructor c args branches of
      Just b -> freshPure b
      Nothing -> freshPure expression
    _ -> freshPure expression
  _ -> freshPure expression

rewriteLet : XName -> XErased -> XErased -> Fresh XErased
rewriteLet name value body = case value of
  XELet inner a b -> freshPure (XELet inner a (XELet name b body))
  XELetRec (Cons (Pair r rhs) Nil) (XEVar other) -> if eqName r other then do
    replaced <- copy (M.singleton r (XEVar name)) rhs
    freshPure (XELetRec (Cons (Pair name replaced) Nil) body)
    else freshPure (XELet name value body)
  _ -> freshPure (XELet name value body)

substituteBindings : XErased -> List (Pair XName XErased) -> Fresh XErased
substituteBindings body bindings = case bindings of
  Nil -> freshPure body
  Cons (Pair n a) rest -> do
    result <- substitute n a body
    substituteBindings result rest

maxIdentity : XErased -> Int
maxIdentity expression = case expression of
  XEVar n -> nameId n
  XEAbs n b -> L.max (nameId n) (maxIdentity b)
  XEApp f a -> L.max (maxIdentity f) (maxIdentity a)
  XELet n a b -> L.max (nameId n) (L.max (maxIdentity a) (maxIdentity b))
  XELetRec ds b -> L.foldl (\maximum entry -> case entry of Pair n a -> L.max maximum (L.max (nameId n) (maxIdentity a))) (maxIdentity b) ds
  XECase a branches -> L.foldl (\maximum branch -> case branch of XErasedAlternative p b -> L.foldl (\best n -> L.max best (nameId n)) (L.max maximum (maxIdentity b)) (X.patternNames p)) (maxIdentity a) branches
  _ -> 0

iterations : Map String (Maybe Int) -> Int -> XErased -> Fresh XErased
iterations arities count expression = if count == 0 then freshPure expression else do
  let facts = constructorFacts arities expression
  projected <- if M.null facts then freshPure expression else projectConstructors facts expression
  next <- pass projected
  if X.equalErased expression next then freshPure expression else iterations arities (count - 1) next

-- Bound cloning by both template size and the shared fresh-name budget.
-- Only syntactic function values are copied; captured computations remain
-- shared variables. The traversal never revisits its newly created clones.
freshSeed : Fresh Int
freshSeed = Fresh (\seed -> Pair seed seed)

specializationDefinitions : XErased -> Map XName XErased
specializationDefinitions expression =
  let local = case expression of
        XELet n a b -> M.singleton n a
        XELetRec ds b -> M.fromList compareName ds
        _ -> M.empty
  in M.unions compareName (Cons local (L.map specializationDefinitions (subterms expression)))

staticCallback : Map XName XErased -> XErased -> Bool
staticCallback definitions expression = case expression of
  XEAbs n b -> remainingSize 64 expression >= 0
  _ -> case applications expression of
    Pair (XEVar n) args -> case M.lookup compareName n definitions of
      Nothing -> false
      Just rhs -> case lambdas rhs of Pair parameters body -> L.length args < L.length parameters && L.all atom args
    Pair (XEPrimitive p) args -> L.null args
    Pair (XEConstructor c) args -> L.all atom args
    _ -> false

appliedParameter : XName -> XErased -> Bool
appliedParameter parameter expression = case applications expression of
  Pair (XEVar name) (Cons first rest) -> if eqName name parameter then true else L.any (appliedParameter parameter) (subterms expression)
  _ -> L.any (appliedParameter parameter) (subterms expression)

specializeHigherOrder : XErased -> Fresh XErased
specializeHigherOrder expression = do
  seed <- freshSeed
  specializeVisit (seed + 16384) (specializationDefinitions expression) expression

specializeVisit : Int -> Map XName XErased -> XErased -> Fresh XErased
specializeVisit limit definitions expression = do
  normalized <- children (specializeVisit limit definitions) expression
  used <- freshSeed
  case applications normalized of
    Pair (XEVar name) (Cons callback args) -> if used >= limit then freshPure normalized else
      case M.lookup compareName name definitions of
        Nothing -> freshPure normalized
        Just rhs -> case lambdas rhs of
          Pair (Cons first (Cons next rest)) body ->
            if L.length args == 1 + L.length rest && remainingSize 128 rhs >= 0 &&
              staticCallback definitions callback && S.member compareName name (free body) && appliedParameter first body
            then specializeCall name rhs callback args else freshPure normalized
          _ -> freshPure normalized
    _ -> freshPure normalized

specializeCall : XName -> XErased -> XErased -> List XErased -> Fresh XErased
specializeCall name rhs callback arguments = do
  specialized <- freshName
  -- Rename the original parameter scopes before inserting the callback,
  -- whose free names belong to this call site's enclosing scope.
  copied <- copy M.empty rhs
  case lambdas copied of
    Pair (Cons key parameters) body -> do
      replaced <- specializeBody name specialized key (L.length parameters) callback body
      freshPure (XELetRec (Cons (Pair specialized (L.foldr XEAbs replaced parameters)) Nil)
        (L.foldl XEApp (XEVar specialized) arguments))
    _ -> freshPure (L.foldl XEApp (XEVar name) (Cons callback arguments))

specializeBody : XName -> XName -> XName -> Int -> XErased -> XErased -> Fresh XErased
specializeBody original specialized key arity callback expression = case applications expression of
  Pair (XEVar self) (Cons (XEVar argument) remaining) ->
    if eqName self original && eqName argument key && L.length remaining == arity then do
      arguments <- traverseFresh (specializeBody original specialized key arity callback) remaining
      freshPure (L.foldl XEApp (XEVar specialized) arguments)
    else specializeOther original specialized key arity callback expression
  _ -> specializeOther original specialized key arity callback expression

specializeOther : XName -> XName -> XName -> Int -> XErased -> XErased -> Fresh XErased
specializeOther original specialized key arity callback expression = case expression of
  XEVar name -> if eqName name key then copy M.empty callback else freshPure expression
  _ -> children (specializeBody original specialized key arity callback) expression


optimizeWork : XErased -> Fresh XErased
optimizeWork expression = do
  unique <- copy M.empty expression
  clean <- identities unique
  recursive <- fixedPoints clean
  let arities = constructorArities recursive
  lifted <- liftConstructorFields arities recursive
  simple <- iterations arities 16 lifted
  specialized <- specializeHigherOrder simple
  iterations arities 16 specialized

optimize : XErased -> XErased
optimize expression = case runFresh (optimizeWork expression) (1 + maxIdentity expression) of
  Pair normalized seed -> case runFresh (copy M.empty normalized) 0 of
    Pair result next -> result
