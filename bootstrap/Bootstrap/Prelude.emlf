module Bootstrap.Prelude where
import Bootstrap.Types
import qualified Bootstrap.Std as L
import qualified Bootstrap.Set as Set
import qualified Bootstrap.Surface as Surface

-- The source prelude is elaborated and checked like user declarations.
withPrelude : PreludeMode -> SProgram -> Pair (Set String) SProgram
withPrelude mode program = case mode of
  NoImplicitPrelude -> Pair Set.empty program
  ImplicitPrelude -> case programParts program of
    Quad datatypes classes instances body ->
      if L.any isMonadClass classes then Pair Set.empty program
      else
        let methods = Set.fromList compareString (L.concatMap classMethodNames classes) in
        let expressions = Cons body (L.concatMap instanceBodies instances) in
        let names = Set.difference compareString (Set.unions compareString (L.map freeNames expressions)) methods in
        let needed = L.not (Set.null (Set.intersection compareString names (Set.fromList compareString (Cons "return" (Cons "bind" Nil))))) || L.any exprMentionsMonad expressions || L.any classMentionsMonad classes || L.any instanceMentionsMonad instances in
        if needed then Pair (Set.singleton "Monad") (SClassProgram datatypes (Cons monadClass classes) (Cons ioInstance (Cons stInstance instances)) body) else Pair Set.empty program

programParts : SProgram -> Quad (List DataDecl) (List SClassDecl) (List SInstanceDecl) SExpr
programParts program = case program of
  SProgram datatypes body -> Quad datatypes Nil Nil body
  SClassProgram datatypes classes instances body -> Quad datatypes classes instances body
isMonadClass : SClassDecl -> Bool
isMonadClass (SClassDecl name parameters superclasses methods) = eqString name "Monad"
classMethodNames : SClassDecl -> List String
classMethodNames (SClassDecl name parameters superclasses methods) = L.map L.fst methods
instanceBodies : SInstanceDecl -> List SExpr
instanceBodies (SInstanceDecl variables context name head methods) = L.map L.snd methods

monadClass : SClassDecl
monadClass =
  let a = STVar "a" in
  let b = STVar "b" in
  let ma = STypeApp (STVar "m") a in
  let mb = STypeApp (STVar "m") b in
  SClassDecl "Monad" (Cons (Pair "m" (KArrow Star Star)) Nil) Nil
    (Cons (Pair "return" (forallType "a" (SArrow a ma)))
      (Cons (Pair "bind" (forallType "a" (forallType "b" (SArrow ma (SArrow (SArrow a mb) mb))))) Nil))
forallType : String -> SType -> SType
forallType name body = SForall Flexible name SBottom body
ioInstance : SInstanceDecl
ioInstance = SInstanceDecl Nil Nil "Monad" (Cons (SCon "IO" Nil) Nil)
  (Cons (Pair "return" (SPrimitive PIOReturn)) (Cons (Pair "bind" (SPrimitive PIOBind)) Nil))

stInstance : SInstanceDecl
stInstance = SInstanceDecl (Cons (Pair "s" Star) Nil) Nil "Monad" (Cons (SCon "ST" (Cons (STVar "s") Nil)) Nil)
  (Cons (Pair "return" (SPrimitive PSTReturn)) (Cons (Pair "bind" (SPrimitive PSTBind)) Nil))

freeNames : SExpr -> Set String
freeNames expression = case expression of
  SVar name -> Set.singleton name
  SLam name annotation body -> Set.delete compareString name (freeNames body)
  SApp f a -> Set.union compareString (freeNames f) (freeNames a)
  SLet name value body -> Set.union compareString (freeNames value) (Set.delete compareString name (freeNames body))
  SAnn value annotation -> freeNames value
  SCase value branches -> Set.union compareString (freeNames value) (Set.unions compareString (L.map alternativeNames branches))
  SDo statements result -> L.foldr statementNames (freeNames result) statements
  SEquations rows -> Set.fromList compareString (Surface.freeNames expression)
  SLetRec definitions body -> Set.difference compareString (Set.unions compareString (Cons (freeNames body) (L.map recursiveNames definitions))) (Set.fromList compareString (L.map recursiveName definitions))
  SChecked ty value -> freeNames value
  _ -> Set.empty
alternativeNames : SAlternative -> Set String
alternativeNames (SAlternative pattern body) = Set.difference compareString (freeNames body) (patternNames pattern)
recursiveNames : Triple String SAnnotation SExpr -> Set String
recursiveNames (Triple name annotation body) = freeNames body
recursiveName : Triple String SAnnotation SExpr -> String
recursiveName (Triple name annotation body) = name
statementNames : SStatement -> Set String -> Set String
statementNames statement rest = case statement of
  SDoBind pattern value -> Set.insert compareString "bind" (Set.union compareString (freeNames value) (Set.difference compareString rest (patternNames pattern)))
  SDoThen value -> Set.insert compareString "bind" (Set.union compareString (freeNames value) rest)
  SDoLet name annotation value -> Set.union compareString (freeNames value) (Set.delete compareString name rest)
  SDoLetRec definitions -> Set.difference compareString (Set.unions compareString (Cons rest (L.map recursiveNames definitions))) (Set.fromList compareString (L.map recursiveName definitions))
patternNames : SPattern -> Set String
patternNames pattern = Set.fromList compareString (Surface.patternVariables pattern)

predicateMentionsMonad : SPredicate -> Bool
predicateMentionsMonad (SPredicate name arguments) = eqString name "Monad" || L.any typeMentionsMonad arguments
typeMentionsMonad : SType -> Bool
typeMentionsMonad ty = case ty of
  SQualified predicates body -> L.any predicateMentionsMonad predicates || typeMentionsMonad body
  SForall flag name bound body -> typeMentionsMonad bound || typeMentionsMonad body
  SArrow a b -> typeMentionsMonad a || typeMentionsMonad b
  STypeApp f a -> typeMentionsMonad f || typeMentionsMonad a
  SCon name arguments -> L.any typeMentionsMonad arguments
  _ -> false
classMentionsMonad : SClassDecl -> Bool
classMentionsMonad (SClassDecl name parameters superclasses methods) = L.any predicateMentionsMonad superclasses || L.any (\entry -> typeMentionsMonad (L.snd entry)) methods
instanceMentionsMonad : SInstanceDecl -> Bool
instanceMentionsMonad (SInstanceDecl variables context name head methods) = eqString name "Monad" || L.any predicateMentionsMonad context || L.any typeMentionsMonad head
exprMentionsMonad : SExpr -> Bool
exprMentionsMonad expression = case expression of
  SLam name annotation body -> L.maybe false annotationMentionsMonad annotation || exprMentionsMonad body
  SApp f a -> exprMentionsMonad f || exprMentionsMonad a
  SLet name value body -> exprMentionsMonad value || exprMentionsMonad body
  SAnn value annotation -> exprMentionsMonad value || annotationMentionsMonad annotation
  SCase value branches -> exprMentionsMonad value || L.any alternativeMentionsMonad branches
  SDo statements result -> L.any statementMentionsMonad statements || exprMentionsMonad result
  SEquations rows -> L.any equationMentionsMonad rows
  SLetRec definitions body -> L.any recursiveMentionsMonad definitions || exprMentionsMonad body
  SChecked ty value -> typeMentionsMonad ty || exprMentionsMonad value
  _ -> false
annotationMentionsMonad : SAnnotation -> Bool
annotationMentionsMonad (SAnnotation variables ty) = typeMentionsMonad ty
alternativeMentionsMonad : SAlternative -> Bool
alternativeMentionsMonad (SAlternative pattern body) = patternMentionsMonad pattern || exprMentionsMonad body
equationMentionsMonad : Pair (List SPattern) SExpr -> Bool
equationMentionsMonad (Pair patterns body) = L.any patternMentionsMonad patterns || exprMentionsMonad body
recursiveMentionsMonad : Triple String SAnnotation SExpr -> Bool
recursiveMentionsMonad (Triple name annotation body) = annotationMentionsMonad annotation || exprMentionsMonad body
statementMentionsMonad : SStatement -> Bool
statementMentionsMonad statement = case statement of
  SDoBind pattern value -> patternMentionsMonad pattern || exprMentionsMonad value
  SDoThen value -> exprMentionsMonad value
  SDoLet name annotation value -> L.maybe false annotationMentionsMonad annotation || exprMentionsMonad value
  SDoLetRec definitions -> L.any recursiveMentionsMonad definitions
patternMentionsMonad : SPattern -> Bool
patternMentionsMonad pattern = case pattern of
  SAnnotatedPattern name annotation -> annotationMentionsMonad annotation
  SNestedPattern name patterns -> L.any patternMentionsMonad patterns
  _ -> false
