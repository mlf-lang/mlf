module Main where

import Bootstrap.Types
import qualified Bootstrap.Std as L
import qualified Bootstrap.Compiler as C
import qualified Bootstrap.X.Check as Check
import qualified Bootstrap.X.Parser as Parse
import qualified Bootstrap.X.Pretty as Pretty
import qualified Bootstrap.Runtime as Runtime
import qualified Bootstrap.LLVM as LLVM

data Command = PrintSource Bool | RunSource | EmitSource Bool | CheckTarget | RunTarget | RunProgramTarget | EmitTarget Bool | EmitIOTarget Bool
data Source = SourceFile String | SourceText String String | SourceStdin

fatal : forall a. String -> IO a
fatal message = ioBind (putErr (message ++ "\n")) (\ignored -> exitWith 1)

main = do
  count <- getArgCount
  arguments <- readArguments 0 count
  options ImplicitPrelude Nil arguments

readArguments : Int -> Int -> IO (List String)
readArguments i count = if i >= count then ioReturn Nil else do
  argument <- getArg i
  rest <- readArguments (i + 1) count
  ioReturn (Cons argument rest)

options : PreludeMode -> List String -> List String -> IO Unit
options mode paths arguments = case arguments of
  Cons "--no-prelude" rest -> options NoImplicitPrelude paths rest
  Cons "-i" (Cons path rest) -> options mode (L.snoc paths path) rest
  Cons "-i" Nil -> fatal "-i requires a module search directory"
  Cons first rest -> if stringLength first > 2 && eqString (stringSlice first 0 2) "-i" then options mode (L.snoc paths (stringSlice first 2 (stringLength first - 2))) rest else runArgs mode paths arguments
  Nil -> runArgs mode paths arguments

runArgs : PreludeMode -> List String -> List String -> IO Unit
runArgs mode paths arguments = case arguments of
  Cons "--help" Nil -> putStr usage
  Cons "--llvm-runtime" Nil -> do
    path <- runtimePath
    putStrLn path
  Cons "--type" rest -> sourceCommand mode paths (PrintSource true) Nil rest
  Cons "--emit-llvm" rest -> sourceCommand mode paths (EmitSource false) Nil rest
  Cons "--emit-llvm-gc" rest -> sourceCommand mode paths (EmitSource true) Nil rest
  Cons "--check" rest -> targetCommand CheckTarget Nil rest
  Cons "--xmlf-to-llvm" rest -> targetCommand (EmitTarget false) Nil rest
  Cons "--xmlf-to-llvm-gc" rest -> targetCommand (EmitTarget true) Nil rest
  Cons "--xmlf-to-llvm-io" rest -> targetCommand (EmitIOTarget false) Nil rest
  Cons "--xmlf-to-llvm-io-gc" rest -> targetCommand (EmitIOTarget true) Nil rest
  Cons "--run" rest -> case splitArguments rest of
    Pair source arguments -> sourceCommand mode paths RunSource arguments source
  Cons "--run-xmlf" rest -> case splitArguments rest of
    Pair source arguments -> targetCommand RunTarget arguments source
  Cons "--run-program-xmlf" rest -> case splitArguments rest of
    Pair source arguments -> targetCommand RunProgramTarget arguments source
  _ -> sourceCommand mode paths (PrintSource false) Nil arguments

splitArguments : List String -> Pair (List String) (List String)
splitArguments arguments = case arguments of
  Nil -> Pair Nil Nil
  Cons "--" rest -> Pair Nil rest
  Cons a rest -> case splitArguments rest of
    Pair source program -> Pair (Cons a source) program

parseSource : Bool -> List String -> Either String Source
parseSource expression arguments = case arguments of
  Nil -> Right SourceStdin
  Cons "-" Nil -> Right SourceStdin
  Cons "--expr" (Cons text Nil) -> if expression then Right (SourceText "<expression>" text) else Left usage
  Cons file Nil -> if stringLength file >= 2 && eqString (stringSlice file 0 2) "--" then Left usage else Right (SourceFile file)
  _ -> Left usage

sourceCommand : PreludeMode -> List String -> Command -> List String -> List String -> IO Unit
sourceCommand mode paths command programArguments arguments = case parseSource true arguments of
  Left message -> fatal message
  Right source -> do
    compiled <- case source of
      SourceFile file -> C.compileFileWithPrelude mode paths file
      SourceText file input -> C.compileSourceWithImports mode paths file input
      SourceStdin -> do
        input <- getContents
        C.compileSourceWithImports mode paths "<stdin>" input
    case compiled of
      Left error -> fatal (C.prettyError error)
      Right result -> case command of
        PrintSource onlyType -> do
          putStrLn ((if onlyType then "" else "-- type: ") ++ C.sourceType result)
          if onlyType then ioReturn Unit else putStrLn (Pretty.prettyTerm (C.compiledTerm result))
        RunSource -> execute programArguments (C.compiledTerm result)
        EmitSource compact -> printLLVM ((if compact then LLVM.emitLLVMGCChunks else LLVM.emitLLVMChunks) (C.compiledTerm result))
        _ -> fatal "invalid source command"

load : Source -> IO (Pair String String)
load source = case source of
  SourceFile file -> do
    present <- fileExists file
    if present then do
      input <- readFile file
      ioReturn (Pair file input)
    else fatal ("file does not exist: " ++ file)
  SourceText file input -> ioReturn (Pair file input)
  SourceStdin -> do
    input <- getContents
    ioReturn (Pair "<stdin>" input)

targetCommand : Command -> List String -> List String -> IO Unit
targetCommand command programArguments arguments = case parseSource false arguments of
  Left message -> fatal message
  Right source -> do
    Pair file input <- load source
    case Parse.parseTerm file input of
      Left message -> fatal message
      Right term -> case command of
        CheckTarget -> case Check.checkClosed term of
          Left message -> fatal message
          Right ty -> putStrLn (Pretty.prettyType ty)
        RunTarget -> execute programArguments term
        RunProgramTarget -> do
          result <- Runtime.runProgramWithArguments programArguments term
          case result of
            Left message -> panic message
            Right ignored -> ioReturn Unit
        EmitTarget compact -> printLLVM ((if compact then LLVM.emitLLVMGCChunks else LLVM.emitLLVMChunks) term)
        EmitIOTarget compact -> printLLVM ((if compact then LLVM.emitLLVMIOGCChunks else LLVM.emitLLVMIOChunks) term)
        _ -> fatal "invalid target command"

execute : List String -> XTerm -> IO Unit
execute args term = do
  result <- Runtime.runTermWithArguments args term
  case result of
    Left message -> panic message
    Right ignored -> ioReturn Unit

printLLVM : Either String (List String) -> IO Unit
printLLVM result = case result of
  Left message -> fatal message
  Right chunks -> printChunks chunks

printChunks : List String -> IO Unit
printChunks chunks = case chunks of
  Nil -> ioReturn Unit
  Cons chunk rest -> do
    putStr chunk
    printChunks rest

runtimePath : IO String
runtimePath = do
  executable <- getExecutablePath
  cwd <- canonicalPath "."
  chooseRuntime (L.append (ancestors (directory executable)) (ancestors cwd))

directory : String -> String
directory path = let i = lastSlash path (stringLength path - 1) in
  if i < 0 then "." else if i == 0 then "/" else stringSlice path 0 i
lastSlash : String -> Int -> Int
lastSlash path i = if i < 0 then i else if stringCodeAt path i == 47 || stringCodeAt path i == 92 then i else lastSlash path (i - 1)
ancestors : String -> List String
ancestors path = Cons path (if eqString (directory path) path then Nil else ancestors (directory path))
chooseRuntime : List String -> IO String
chooseRuntime paths = case paths of
  Nil -> fatal "Cannot find runtime/mlf_runtime.c beside the compiler or current directory."
  Cons path rest -> do
    c <- fileExists (path ++ "/runtime/mlf_runtime.c")
    h <- fileExists (path ++ "/runtime/mlf_runtime.h")
    if c && h then canonicalPath (path ++ "/runtime/mlf_runtime.c") else chooseRuntime rest

usage = "Usage: emlf [--no-prelude] [-i DIR ...] [--type] [FILE | --expr SOURCE]\n       emlf --check [XMLF_FILE]\n       emlf [--no-prelude] [-i DIR ...] --run [FILE | --expr SOURCE] [-- ARG ...]\n       emlf --run-xmlf [XMLF_FILE] [-- ARG ...]\n       emlf [--no-prelude] [-i DIR ...] --emit-llvm [FILE | --expr SOURCE]\n       emlf --xmlf-to-llvm [XMLF_FILE]\n       emlf [--no-prelude] [-i DIR ...] --emit-llvm-gc [FILE | --expr SOURCE]\n       emlf --xmlf-to-llvm[-io]-gc [XMLF_FILE]\n       emlf --llvm-runtime\nWith no FILE, read eMLF from standard input.\nImports load Foo.Bar from Foo/Bar.emlf beside the entry or in -i search roots.\nThe standard prelude supplies Monad and Monad IO; --no-prelude disables it.\nLink LLVM IR with clang, runtime/mlf_runtime.c, and GMP.\nThe -gc commands require the runtime built with MLF_USE_BDWGC and MLF_COMPACT_BDWGC.\n"
