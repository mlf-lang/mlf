+  check "embedded marker is data" (accept "main = \"-- mlf:syntax unknown\"")
+  check "missing marker rejected" (isLeft (P.parseModule "Example.hs" "module Example where\nmain = 1\n"))
+  check "unknown marker rejected" (isLeft (P.parseModule "Example.emlf" "-- mlf:syntax future-v2\nmodule Example where\nmain = 1\n"))
+  check "duplicate marker rejected" (isLeft (P.parseModule "Example.hs" (prologue ++ "-- mlf:syntax shared-haskell-v1\nmodule Example where\nimport MLF.Primitive\nmain = 1\n")))
+  check "missing extensions rejected" (isLeft (P.parseModule "Example.hs" "-- mlf:syntax shared-haskell-v1\nmodule Example where\nimport MLF.Primitive\nmain = 1\n"))
+  check "unsupported pragma rejected" (isLeft (P.parseModule "Example.hs" (prologue ++ "{-# LANGUAGE Strict #-}\nmodule Example where\nimport MLF.Primitive\nmain = 1\n")))
+  check "profile mismatch rejected" (isLeft (P.parseModuleWithProfile LegacyEmlfV1 "Example.hs" (source "main = 1")))
+  check "facade required" (isLeft (P.parseModule "Example.hs" (prologue ++ "module Example where\nmain = 1\n")))
+  check "selective facade rejected" (isLeft (P.parseModule "Example.hs" (prologue ++ "module Example where\nimport MLF.Primitive (Int)\nmain = 1\n")))
