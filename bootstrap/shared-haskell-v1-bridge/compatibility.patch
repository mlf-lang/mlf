+module Main where
+import Bootstrap.Types
+import Bootstrap.Std
+import qualified Bootstrap.Parser as P
+import qualified Bootstrap.Lexer as L
+import qualified Bootstrap.Module as Modules
+import qualified Bootstrap.Surface as Surface
+import qualified Bootstrap.Map as M
+
+prologue = "-- mlf:syntax shared-haskell-v1\n{-# LANGUAGE NoImplicitPrelude, NoMonomorphismRestriction, RankNTypes, KindSignatures, FlexibleContexts, FlexibleInstances, MultiParamTypeClasses, RebindableSyntax, OverloadedStrings #-}\n"
+source body = prologue ++ "module Example where\nimport MLF.Primitive\n" ++ body ++ "\n"
+parse body = P.parseModule "Example.hs" (source body)
+accept body = isRight (parse body)
+reject body = isLeft (parse body)
+linked text = case parse text of {Left _ -> false; Right m -> isRight (Modules.linkModules ImplicitPrelude (Cons m Nil))}
+forwardScope = case parse "main = let { x = y; y = 3 } in x" of
+  Right (SourceModule _ _ _ _ _ _ _ (Cons (Triple _ _ (SLet y (SIntLit 3) (SLet x (SVar reference) (SVar result)))) Nil) _ SharedHaskellV1) -> eqString y "y" && eqString x "x" && eqString reference "y" && eqString result "x"
+  _ -> false
+fixedDo = case parse "main = let { bind = 7 } in do { value <- ioReturn 3; ioReturn value }" of
+  Right (SourceModule _ _ _ _ _ _ _ (Cons (Triple _ _ expression) Nil) _ _) -> elem eqString "$MLF.Primitive.bind" (Surface.freeNames expression)
+  _ -> false
+legacyScope = case P.parseExpr "legacy.hs" "let x = 1 in let x = x + 1 in x" of
+  Right (SLet _ (SIntLit 1) (SLet _ _ _)) -> true
+  _ -> false
+mixedGraph = case parse "main = Support.answer" of
+  Left _ -> false
+  Right (SourceModule path name exports _ ds cs instances values body syntax) ->
+    let root = SourceModule path name exports (Cons (Import "MLF.Primitive" false Nothing Everything) (Cons (Import "Support" false Nothing Everything) Nil)) ds cs instances values body syntax in
+    case Modules.loadModuleMap (M.singleton "Support" (Pair "Support.emlf" "module Support where\nanswer = let x = 1 in let x = x + 1 in x\n")) root of
+      Left _ -> false
+      Right graph -> length graph == 2 && isRight (Modules.linkModules ImplicitPrelude graph)
+importedHook = case parse "main = 1" of
+  Left _ -> false
+  Right (SourceModule path name exports _ ds cs instances values body syntax) ->
+    let root = SourceModule path name exports (Cons (Import "MLF.Primitive" false Nothing Everything) (Cons (Import "Bad" false Nothing Everything) Nil)) ds cs instances values body syntax in
+    case P.parseModule "Bad.emlf" "module Bad where\nfromInteger x = x\n" of
+      Left _ -> false
+      Right bad -> isLeft (Modules.linkModules ImplicitPrelude (Cons bad (Cons root Nil)))
+check : String -> Bool -> IO Unit
+check name okay = if okay then ioReturn Unit else do {putErr ("shared frontend failure: " ++ name ++ "\n"); exitWith 1}
+main = do
+  check "legacy malformed pragma comment" (isRight (P.parseModule "Legacy.emlf" "{-# LANGUAGE X, #-}\nmodule Legacy where\nmain = 1\n"))
+  check "legacy pragma-shaped ordinary comment" (isRight (P.parseModule "Legacy.emlf" "{-# arbitrary legacy comment -}\nmodule Legacy where\nmain = 1\n"))
+  check "shared malformed pragma rejected" (isLeft (P.parseModule "Example.hs" (prologue ++ "{-# LANGUAGE X, #-}\nmodule Example where\nimport MLF.Primitive\nmain = 1\n")))
+  check "module metadata" (accept "main = 42")
+  check "forward group scope" forwardScope
+  check "legacy sequential scope" legacyScope
+  check "fixed do identity" fixedDo
+  check "mixed per-file profiles" mixedGraph
+  check "imported hook identity" importedHook
+  check "primitive facade link" (linked "main = do { printInt 42; ioReturn Unit }")
+  check "facade implementation host" (linked "main = implementationHost")
+  check "ordinary bind binding" (case P.parseModule "Example.hs" (prologue ++ "module Example where\nimport MLF.Primitive hiding (bind)\nbind = 42\nmain = do { ioReturn bind; ioReturn bind }\n") of {Left _ -> false; Right m -> isRight (Modules.linkModules ImplicitPrelude (Cons m Nil))})
+  check "closed recursive group" (accept "main = let { f :: Int -> Int; f x = g x; g :: Int -> Int; g x = f x } in 1")
+  check "unsigned recursive group" (reject "main = let { f x = f x } in 1")
+  check "mixed signed cycle" (reject "main = let { f :: Int -> Int; f x = g x; g x = f x } in 1")
+  check "do let forward scope" (accept "main = do { let { x = y; y = 3 }; ioReturn x }")
+  check "refutable do forbidden" (reject "main = do { Pair x y <- ioReturn (Pair 1 2); ioReturn x }")
+  check "wildcard do bind" (accept "main = do { _ <- ioReturn 1; ioReturn 2 }")
+  check "explicit local braces" (reject "main = let x = 1 in x")
+  check "implicit inline do" (reject "main = do ioReturn 1")
+  check "implicit inline case" (reject "main = case True of True -> 1; False -> 2")
+  check "recursive spelling rejected" (reject "main = let rec { x :: Int; x = x } in 1")
+  check "single-colon signature" (reject "main : Int\nmain = 1")
+  check "inline signature" (reject "main :: Int = 1")
+  check "double-colon kinds" (accept "f :: forall (m :: * -> *) a. m a -> m a\nf x = x")
+  check "legacy kind colon rejected" (reject "f :: forall (m : * -> *) a. m a -> m a\nf x = x")
+  check "free signature variable" (reject "f :: a -> a\nf x = x")
+  check "higher rank arrow" (accept "f :: (forall a. a -> a) -> Int\nf g = g 1")
+  check "impredicative argument" (reject "f :: Box (forall a. a -> a)\nf = Box (\\x -> x)")
+  check "bounded forall rejected" (reject "f :: forall (a >= Int). a -> a\nf x = x")
+  check "rigid forall rejected" (reject "f :: forall (a = Int). a -> a\nf x = x")
+  check "existential annotation rejected" (reject "f :: exists a. a -> a\nf x = x")
+  check "nested context rejected" (reject "f :: forall a. (Monad IO => IO a) -> IO a\nf x = x")
+  check "string patterns rejected" (reject "f \"x\" = 1\nf _ = 2")
+  check "typed patterns rejected" (reject "f (x :: Int) = x")
+  check "tuple expressions rejected" (reject "main = (1,2)")
+  check "unit sugar rejected" (reject "main = ()")
+  check "list sugar rejected" (reject "main = [1]")
+  check "list-tail rejected" (reject "main = 1 : Nil")
+  check "tuple types rejected" (reject "main :: (Int, Int)\nmain = Pair 1 2")
+  check "tuple patterns rejected" (reject "f (x,y) = x")
+  check "typed negative literal" (accept "main :: Int\nmain = (-1)")
+  check "bare negative rejected" (reject "main = -1")
+  check "unary plus rejected" (reject "main = +1")
+  check "nonfinite floating rejected" (reject "main = 1e999")
+  check "malformed numeric adjacency" (reject "main = 1abc")
+  check "unicode identifiers rejected" (reject "é = 1")
+  check "unicode strings accepted" (accept "main = \"λ\"")
+  check "lambda-dot rejected" (reject "main = \\x.x")
+  check "compact delimiter-prefix rejected" (reject "main = \\x->-1")
+  check "Haskell reserved identifiers" (reject "type = 1")
+  check "ordinary contextual identifiers" (accept "pattern x = x\nmain = pattern 1")
+  check "hook local binding rejected" (reject "main = let { fromInteger = 1 } in fromInteger")
+  check "hook lambda binding rejected" (reject "main = \\negate -> negate")
+  check "hook pattern binding rejected" (reject "main = case Unit of { Unit -> \\otherwise -> otherwise }")
+  check "explicit adapter call rejected" (reject "main = fromString \"x\"")
+  check "qualified adapter call rejected" (reject "main = MLF.Primitive.fromInteger 1")
+  check "ordinary ifThenElse use" (linked "main = ifThenElse True 1 2")
+  check "otherwise value" (linked "main = otherwise")
+  check "total guard" (accept "f x | x == 0 = 1 | otherwise = 2")
+  check "partial guard rejected" (reject "f x | x == 0 = 1")
+  check "tab rejected" (reject "main =\n\t1")
