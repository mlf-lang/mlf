module Main where

import Bootstrap.Types
import qualified Bootstrap.X.Parser as Parser
import qualified Bootstrap.LLVM as LLVM

fatal : String -> IO Unit
fatal message = do
  putErr (message ++ "\n")
  exitWith 1

compileTarget : Bool -> String -> IO Unit
compileTarget requireIO path = do
  input <- readFile path
  case Parser.parseTerm "<target>" input of
    Left message -> fatal message
    Right term -> case (if requireIO then LLVM.emitLLVMIOChunks term else LLVM.emitLLVMChunks term) of
      Left message -> fatal message
      Right chunks -> printChunks chunks

printChunks : List String -> IO Unit
printChunks chunks = case chunks of
  Nil -> ioReturn Unit
  Cons chunk rest -> do
    putStr chunk
    printChunks rest

main : IO Unit
main = do
  command <- getArg 0
  let alias = eqString command "--xmlf-to-llvm-gc" || eqString command "--xmlf-to-llvm-io-gc"
  if alias || eqString command "--xmlf-to-llvm" || eqString command "--xmlf-to-llvm-io" then do
    path <- getArg 1
    compileTarget (eqString command "--xmlf-to-llvm-io" || eqString command "--xmlf-to-llvm-io-gc") path
  else fatal "Usage: llvm-driver --xmlf-to-llvm[-io][-gc] FILE"
