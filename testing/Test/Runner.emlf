module Test.Runner where
import Bootstrap.Types
import qualified Bootstrap.Std as S
import qualified Test.Assert as A
import qualified Test.Case as C

data Selector = Filter String | Exact String | Tag String
data Options = Options Bool Bool String (List Selector)
data Result = Result C.Case (Either A.Failure Unit)
usage = "test [--list] [--filter TEXT] [--exact ID] [--tag TAG] [--format text|json] [--report FILE]"
listing (Options value _ _ _) = value
json (Options _ value _ _) = value
report (Options _ _ path _) = path
selectors (Options _ _ _ values) = values
parse : List String -> Either String Options
parse args = parseWith (Options false false "" Nil) args
parseWith : Options -> List String -> Either String Options
parseWith (Options list machine path selected) args = case args of
 Nil -> Right (Options list machine path (S.reverse selected))
 Cons "--list" rest -> parseWith (Options true machine path selected) rest
 Cons "--format" (Cons "text" rest) -> parseWith (Options list false path selected) rest
 Cons "--format" (Cons "json" rest) -> parseWith (Options list true path selected) rest
 Cons flag (Cons value rest) ->
  if stringLength value == 0 then Left "empty test selector or format" else
  if eqString flag "--report" then parseWith (Options list machine value selected) rest else
  if eqString flag "--filter" then parseWith (Options list machine path (Cons (Filter value) selected)) rest else
  if eqString flag "--exact" then parseWith (Options list machine path (Cons (Exact value) selected)) rest else
  if eqString flag "--tag" then parseWith (Options list machine path (Cons (Tag value) selected)) rest else Left usage
 _ -> Left usage

contains : String -> String -> Bool
contains needle text = containsAt needle text 0
containsAt : String -> String -> Int -> Bool
containsAt needle text offset = if offset + stringLength needle > stringLength text then false
 else if eqString needle (stringSlice text offset (stringLength needle)) then true else containsAt needle text (offset + 1)
matches selector entry = case selector of
 Filter text -> contains text (C.id entry) || contains text (C.name entry)
 Exact identity -> eqString identity (C.id entry)
 Tag label -> S.elem eqString label (C.tags entry)
validId identity = stringLength identity > 0 && S.all (\i ->
 let c = stringCodeAt identity i in
 c >= 48 && c <= 57 || c >= 65 && c <= 90 || c >= 97 && c <= 122 || c == 45 || c == 46 || c == 47 || c == 95)
 (S.range 0 (stringLength identity - 1))
validate : List C.Case -> Either String Unit
validate cases =
 let identities = S.map C.id cases in
 if S.null cases then Left "empty test inventory" else
 if S.not (S.all validId identities) then Left "test IDs must use letters, digits, '.', '_', '-' or '/'" else
 if S.length identities /= S.length (S.nubBy eqString identities) then Left "duplicate test ID" else
 if S.any (\entry -> stringLength (C.name entry) == 0) cases then Left "empty test name" else Right Unit
plan : List String -> List C.Case -> Either String (Pair Options (List C.Case))
plan args cases = do
 options <- parse args
 validate cases
 let selected = S.filter (\entry -> S.all (\selector -> matches selector entry) (selectors options)) cases
 if S.null selected then Left "no tests matched selection" else Right (Pair options selected)

passed (Result _ outcome) = case outcome of { Right _ -> true; Left _ -> false }
identity (Result entry _) = C.id entry
executeWith : (Result -> IO Unit) -> List C.Case -> IO (List Result)
executeWith observe cases = case cases of
 Nil -> ioReturn Nil
 Cons entry rest -> do
  outcome <- A.run (C.action entry)
  let result = Result entry outcome
  observe result
  remaining <- executeWith observe rest
  ioReturn (Cons result remaining)
execute : List C.Case -> IO (List Result)
execute = executeWith (\_ -> ioReturn Unit)

-- Only encoding is needed for the wire protocol. Preserve Unicode and escape
-- every JSON control character, including NUL; never mix test labels into JSON.
quote text = "\"" ++ S.concatMapString (\i ->
 let code = stringCodeAt text i in
 if code == 34 then "\\\"" else if code == 92 then "\\\\" else if code < 32 then
 "\\u00" ++ stringSlice "0123456789abcdef" (quotInt code 16) 1 ++ stringSlice "0123456789abcdef" (remInt code 16) 1
 else stringSlice text i 1) (S.range 0 (stringLength text - 1)) ++ "\""
strings values = "[" ++ S.intercalate "," (S.map quote values) ++ "]"
descriptor entry = "\"id\":" ++ quote (C.id entry) ++ ",\"name\":" ++ quote (C.name entry) ++ ",\"tags\":" ++ strings (C.tags entry)
prefix event = "{\"schema_version\":1,\"event\":" ++ quote event
scope total selected = if total == selected then "full" else "partial"
selectionFields total selected = ",\"total\":" ++ showInt total ++ ",\"selected\":" ++ showInt selected ++ ",\"scope\":" ++ quote (scope total selected)
resultJson (Result entry outcome) = prefix "case" ++ "," ++ descriptor entry ++ case outcome of
 Right _ -> ",\"status\":\"passed\"}"
 Left failure -> ",\"status\":\"failed\",\"message\":" ++ quote (A.message failure) ++
  (case A.details failure of { Nothing -> ""; Just (Pair expected actual) -> ",\"expected\":" ++ quote expected ++ ",\"actual\":" ++ quote actual }) ++ "}"
resultText (Result entry outcome) = case outcome of
 Right _ -> "PASS " ++ C.id entry ++ "  " ++ C.name entry
 Left failure -> "FAIL " ++ C.id entry ++ "  " ++ C.name entry ++ ": " ++ A.describe failure
summaryJson total selected results =
 let successes = S.length (S.filter passed results) in
 prefix "summary" ++ selectionFields total selected ++ ",\"complete\":true,\"executed\":" ++ showInt (S.length results) ++
 ",\"passed\":" ++ showInt successes ++ ",\"failed\":" ++ showInt (S.length results - successes) ++ "}"
run : List String -> List C.Case -> IO Int
run args cases = case plan args cases of
 Left error -> do { putErr ("test: " ++ error ++ "\n"); ioReturn 2 }
 Right (Pair options selected) -> do
  let total = S.length cases
  let count = S.length selected
  if listing options then do
   let inventory = prefix "inventory" ++ selectionFields total count ++ ",\"cases\":[" ++ S.intercalate "," (S.map (\entry -> "{" ++ descriptor entry ++ "}") selected) ++ "]}"
   saveReport options (inventory ++ "\n")
   if json options then putStrLn inventory
   else S.mapM_ (\entry -> putStrLn (C.id entry ++ "  " ++ C.name entry)) selected
   ioReturn 0
  else do
   let start = prefix "start" ++ selectionFields total count ++ ",\"ids\":" ++ strings (S.map C.id selected) ++ "}"
   -- Replace a previous report before actions run. A crash leaves an incomplete
   -- start record; only a returned run may publish a complete summary.
   saveReport options (start ++ "\n")
   if json options then putStrLn start else ioReturn Unit
   results <- executeWith (\result -> putStrLn (if json options then resultJson result else resultText result)) selected
   let failures = S.length (S.filter (\result -> S.not (passed result)) results)
   let summary = summaryJson total count results
   saveReport options (S.intercalate "\n" (Cons start (S.append (S.map resultJson results) (Cons summary Nil))) ++ "\n")
   if json options then putStrLn summary else
    putStrLn (showInt count ++ " checks; " ++ showInt failures ++ " failures (" ++ scope total count ++ " inventory)")
   ioReturn (if failures == 0 then 0 else 1)
saveReport options text = if eqString (report options) "" then ioReturn Unit else writeFile (report options) text
arguments : Int -> Int -> IO (List String)
arguments index count = if index >= count then ioReturn Nil else do
 value <- getArg index
 rest <- arguments (index + 1) count
 ioReturn (Cons value rest)
main : List C.Case -> IO Unit
main cases = do
 count <- getArgCount
 args <- arguments 0 count
 code <- run args cases
 if code == 0 then ioReturn Unit else exitWith code
