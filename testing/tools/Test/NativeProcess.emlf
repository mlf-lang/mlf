module Test.NativeProcess where
import Bootstrap.Types
import qualified Bootstrap.Std as S
import qualified Async.Process as P
import qualified Test.Outcome as O
import qualified Test.Expectation as E

-- An actual native-supervisor adapter, separate from the v1 POSIX measurement
-- transport. A shared scope is injected so nested adapters do not open N slots.
data Completed = Completed P.ProcessOutcome O.Outcome
cleanup (Completed _ value) = value
raw (Completed value _) = value
cleanupOutcome result = if P.cleanupError result == 0 then O.Pass else O.InfrastructureError ("native child cleanup failed: " ++ showInt (P.cleanupError result))
-- Ordinary nonzero exits are data. The independently supplied expectation and
-- verifier decide acceptance; no generic nonzero exit becomes a passing test.
observation phase reason verified result = E.Observation phase (case result of
 P.Exited code _ -> if code < 0 || code >= 128 then E.BadProtocol "native exit encoding cannot distinguish signal termination from this exit code" else E.Exit code
 P.LaunchFailed code _ -> E.Infrastructure ("native process launch failed: " ++ showInt code)
 P.Cancelled code _ -> E.Interrupted
 P.TimedOut _ -> E.Deadline) reason verified
validate expected phase reason verified (Completed result cleanupResult) =
 (,) (E.match expected (observation phase reason verified result)) cleanupResult
-- Require both running and total bounds. The native total bound includes
-- admission wait; awaitProcess services the supervisor until terminal cleanup.
bounded (P.ProcessSpec _ _ _ _ _ _ _ running total) = running > 0 && total > 0
execute : P.ProcessScope -> P.ProcessSpec -> IO (Either P.AsyncError Completed)
execute scope specification = if not (bounded specification) then
 ioReturn (Left (P.AsyncError 1 "test process requires positive running and total deadlines")) else do
 submitted <- P.submit scope specification
 case submitted of
  Left error -> ioReturn (Left error)
  Right handle -> do
   result <- P.awaitProcess scope handle
   ioReturn (case result of { Left error -> Left error; Right value -> Right (Completed value (cleanupOutcome value)) })
-- Top-level use only. Normal return joins; Left cancels and joins; panic/exit
-- and owner death retain the native runtime guardian/Job Object guarantees.
withSerial : forall a. (P.ProcessScope -> IO (Either P.AsyncError a)) -> IO (Either P.AsyncError a)
withSerial = P.withProcessScope (P.ScopeOptions 1 1 1024)
not value = if value then false else true

-- A caller which is already inside the suite capture may share that one
-- deadline across an entire phase. Keep execute's independently bounded API
-- for framework leaves. These jobs have no additional child timers.
data SuiteJob = SuiteJob String String ([] String) String String String

suiteSubmit : P.ProcessScope -> [] SuiteJob -> IO (Either P.AsyncError ([] ((,) String P.ProcessHandle)))
suiteSubmit scope jobs = case jobs of
 [] -> ioReturn (Right [])
 (:) (SuiteJob name executable args input stdout stderr) tail -> do
  launched <- P.submit scope (P.ProcessSpec executable args "" input stdout stderr P.InheritEnvironment 0 0)
  case launched of
   Left failure -> ioReturn (Left failure)
   Right handle -> do
    rest <- suiteSubmit scope tail
    ioReturn (case rest of { Left failure -> Left failure; Right handles -> Right ((:) ((,) name handle) handles) })

suiteAwait : P.ProcessScope -> [] ((,) String P.ProcessHandle) -> IO (Either P.AsyncError ())
suiteAwait scope handles = case handles of
 [] -> ioReturn (Right ())
 (:) ((,) name handle) tail -> do
  result <- P.awaitProcess scope handle
  case result of
   Left failure -> ioReturn (Left failure)
   Right outcome -> case outcome of
    P.Exited code cleanup ->
     if code == 0 && cleanup == 0 then suiteAwait scope tail
     else ioReturn (Left (P.AsyncError (if code == 0 then cleanup else code)
      (name ++ " exited " ++ showInt code ++ " with cleanup status " ++ showInt cleanup)))
    P.LaunchFailed code cleanup -> ioReturn (Left (P.AsyncError code
     (name ++ " launch failed; cleanup status " ++ showInt cleanup)))
    P.Cancelled code cleanup -> ioReturn (Left (P.AsyncError code
     (name ++ " was cancelled; cleanup status " ++ showInt cleanup)))
    P.TimedOut cleanup -> ioReturn (Left (P.AsyncError 124
     (name ++ " has an unexpected child timeout; cleanup status " ++ showInt cleanup)))

runSuitePhase : [] SuiteJob -> IO (Either String ())
runSuitePhase jobs = do
 let slots = S.length jobs
 if slots < 1 || slots > 4 then ioReturn (Left "invalid test suite phase width") else do
  result <- P.withProcessScope (P.ScopeOptions slots slots slots) (\scope -> do
   handles <- suiteSubmit scope jobs
   case handles of { Left failure -> ioReturn (Left failure); Right ready -> suiteAwait scope ready })
  ioReturn (case result of { Left failure -> Left (P.errorMessage failure); Right _ -> Right () })
