module Main where
import Bootstrap.Types
import qualified Bootstrap.Std as S
import qualified Test.Assert as A
import qualified Test.Case as C
import qualified Test.Runner as Runner
import qualified Test.Outcome as O
import qualified Test.Expectation as Expectation
import qualified Test.Adapter as Adapter
import qualified Test.Capability as Capability
import qualified Test.Fixture as Fixture
import qualified Test.Resources as Resources
import qualified Test.Plan as Plan
import qualified Test.Diagnostics as Diagnostics
import qualified Test.Process as Process
import qualified Test.NativeProcess as Native
import qualified Async.Process as Async

rejected result = case result of { Left _ -> true; Right _ -> false }
check name condition = C.test ("lifecycle/" ++ name) name [] (A.assert condition name)
fixtureFailure = do
 fixture <- Fixture.create "workspace" Fixture.Case Fixture.KeepFailures
 partial <- Fixture.acquire (O.InfrastructureError "setup") fixture
 Fixture.release false O.Pass partial
sealed join cleanup = do
 planned <- Adapter.plan Adapter.initial
 prepared <- Adapter.prepare O.Pass planned
 executed <- Adapter.execute O.Pass prepared
 collected <- Adapter.collect executed
 validated <- Adapter.validate O.Pass collected
 cleaning <- Adapter.beginCleanup validated
 finished <- Adapter.finishCleanup join cleanup cleaning
 Adapter.seal finished
accepted result = case result of { Right attempt -> Adapter.successful attempt; Left _ -> false }
leaseControl = do
 budget <- Resources.create Resources.serial
 first <- Resources.acquire "first" Resources.serial budget
 case first of
  Nothing -> Left "first lease unavailable"
  Just held -> do
   second <- Resources.acquire "second" Resources.serial held
   case second of { Nothing -> Right (); Just _ -> Left "nested oversubscription" }
compileOnly = Plan.Plan "catalog" "inputs" ((:) "forbidden" [])
 ((:) (Plan.Node "execute" Plan.Execute [] ((:) "forbidden" []) O.Runtime Plan.CompileOnly) [])
 [] Resources.serial (Plan.Deadlines 1 1 1)
compileOnlyValid = Plan.Plan "catalog" "inputs" ((:) "typecheck" [])
 ((:) (Plan.Node "check" Plan.Execute [] ((:) "typecheck" []) O.TypeCheck Plan.CompileOnly) [])
 [] Resources.serial (Plan.Deadlines 1 1 1)
compileOnlyLaundered = Plan.Plan "catalog" "inputs" ((:) "runtime" [])
 ((:) (Plan.Node "input" Plan.Prepare [] [] O.Source Plan.CompileOnly)
 ((:) (Plan.Node "compile" Plan.Build ((:) "input" []) [] O.Emission Plan.MayExecute)
 ((:) (Plan.Node "run" Plan.Execute ((:) "compile" []) ((:) "runtime" []) O.Runtime Plan.MayExecute) [])))
 [] Resources.serial (Plan.Deadlines 1 1 1)
prepareRejection = do
 planned <- Adapter.plan Adapter.initial
 cleaning <- Adapter.prepare (O.ExpectedRejection O.Setup "missing-fixture" 1) planned
 finished <- Adapter.finishCleanup Adapter.Joined O.Pass cleaning
 Adapter.seal finished
cancelCleanup = do
 planned <- Adapter.plan Adapter.initial
 prepared <- Adapter.prepare O.Pass planned
 executed <- Adapter.execute O.Pass prepared
 collected <- Adapter.collect executed
 validated <- Adapter.validate O.Pass collected
 cleaning <- Adapter.beginCleanup validated
 cancelled <- Adapter.cancel "requested during cleanup" cleaning
 finished <- Adapter.finishCleanup Adapter.Joined O.Pass cancelled
 Adapter.seal finished
rejectionValidationFailure = do
 planned <- Adapter.plan Adapter.initial
 prepared <- Adapter.prepare O.Pass planned
 executed <- Adapter.execute (O.ExpectedRejection O.TypeCheck "diagnostic" 1) prepared
 collected <- Adapter.collect executed
 validated <- Adapter.validate (O.AssertionFailure "oracle mismatch") collected
 cleaning <- Adapter.beginCleanup validated
 finished <- Adapter.finishCleanup Adapter.Joined O.Pass cleaning
 Adapter.seal finished
signalNotRejection = case Native.validate (Expectation.Reject O.Runtime "signal" 137) O.Runtime "signal" true (Native.Completed (Async.Exited 137 0) O.Pass) of
 (,) outcome _ -> S.not (O.successful outcome)
summaryEntry = C.test "summary/expected" "expected" [] (A.succeed ())
summaryOther = C.test "summary/other" "other" [] (A.succeed ())
cases =
 (:) (check "native-signal-not-rejection" signalNotRejection)
 ((:) (check "process-summary-missing" (S.not (Process.summaryComplete 1 ((:) summaryEntry []) [])))
 ((:) (check "process-summary-duplicate" (S.not (Process.summaryComplete 1 ((:) summaryEntry []) ((:) (Process.descriptorJson summaryEntry) ((:) (Process.descriptorJson summaryEntry) [])))))
 ((:) (check "process-summary-substituted" (S.not (Process.summaryComplete 1 ((:) summaryEntry []) ((:) (Process.descriptorJson summaryOther) []))))
 ( (:) (check "prepare-rejection-is-not-execution" (S.not (accepted prepareRejection)))
 ((:) (check "cancel-during-cleanup" (S.not (accepted cancelCleanup)))
 ((:) (check "rejection-still-needs-validation" (S.not (accepted rejectionValidationFailure)))
 ( (:) (check "compile-only-typecheck" (case Plan.validate compileOnlyValid of { Right () -> true; _ -> false }))
 ((:) (check "compile-only-transitive-runtime" (rejected (Plan.validate compileOnlyLaundered)))
 ( (:) (check "execute-before-prepare" (rejected (Adapter.execute O.Pass Adapter.initial)))
 ((:) (check "unverified-join-cannot-seal" (rejected (sealed Adapter.Unverified O.Pass)))
 ((:) (check "cleanup-failure-cannot-pass" (S.not (accepted (sealed Adapter.Joined (O.InfrastructureError "cleanup")))))
 ((:) (check "join-failure-cannot-pass" (S.not (accepted (sealed (Adapter.JoinFailed "remaining child") O.Pass))))
 ((:) (check "normal-lifecycle" (accepted (sealed Adapter.Joined O.Pass)))
 ((:) (check "partial-setup-needs-join" (rejected fixtureFailure))
 ((:) (check "nested-budget" (case leaseControl of { Right () -> true; _ -> false }))
 ((:) (check "unknown-capability" (rejected (Capability.check (Capability.Requirement "native" Capability.Required) [])))
 ((:) (check "required-capability" (case Capability.check (Capability.Requirement "native" Capability.Required) ((:) (Capability.Missing "native" "not installed") []) of { Right (O.Unsupported _) -> true; _ -> false }))
 ((:) (check "compile-only-execution" (rejected (Plan.validate compileOnly)))
 ((:) (check "display-limit" (rejected (Diagnostics.preview (0 - 1) "raw")))
 ((:) (check "native-unbounded-process" (S.not (Native.bounded (Async.command "child" [] "stdout" "stderr"))))
 ((:) (check "legacy-cancellation-status" (eqString (Process.status (Process.legacyOutcome (O.Cancelled "cancel"))) "crashed"))
 [])))))))))))))))))))))
main = Runner.main cases
