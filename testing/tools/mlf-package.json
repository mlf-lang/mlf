{
  "format": 1,
  "name": "mlf-test-tools",
  "version": "0.1.0",
  "dependencies": {
    "mlf-foundation": {
      "path": "../../libraries/mlf-foundation"
    },
    "mlf-package-core": {
      "path": "../../libraries/mlf-package-core"
    },
    "mlf-test": {
      "path": ".."
    },
    "mlf-async": {
      "path": "../../libraries/mlf-async"
    }
  },
  "library": {
    "modules": {
      "Test.Process": "Test/Process.emlf",
      "Test.NativeProcess": "Test/NativeProcess.emlf"
    }
  },
  "executables": {
    "mlf-test": {
      "main": "Main.emlf",
      "profile": "compiler"
    },
    "test-lifecycle": {
      "main": "LifecycleMain.emlf",
      "profile": "compiler"
    }
  },
  "tests": {
    "lifecycle": {
      "requires": [
        "test-lifecycle"
      ],
      "command": [
        "{bin:test-lifecycle}"
      ]
    }
  }
}
