module Bootstrap.Layout where
import Bootstrap.Types
import Bootstrap.Std
import Bootstrap.Lexer

data LayoutKind = LayoutTop | LayoutBlock | LayoutBindings
data LayoutMark = LetMark | IfMark
data Frame = Layout LayoutKind Int | Explicit String | Marker LayoutMark Int
data Pending = Open LayoutKind | AfterLet Int

layoutTokens : Bool -> String -> String -> Either String Scanned
layoutTokens program file source = case scanTokens file source of
  Left e -> Left e
  Right (Scanned tokens finish) ->
    let first = case tokens of {Nil -> finish; Cons t _ -> t} in
    let implicit = program && not (eqString (tokenText first) "{") && not (eqString (tokenText first) "module") in
    let frames = if implicit then Cons (Layout LayoutTop (lineIndent source (tokenLine first))) Nil else Nil in
    let arranged = arrange frames Nothing Nothing tokens finish in
    Right (Scanned (if implicit then Cons (virtual "{" first) arranged else arranged) finish)
lineIndent : String -> Int -> Int
lineIndent source line = indentAt source (stringLength source) line 0 1 1
indentAt : String -> Int -> Int -> Int -> Int -> Int -> Int
indentAt source size target i line column = if i >= size then column else
  let c = stringCodeAt source i in
  if line < target then indentAt source size target (i+1) (if c == 10 then line+1 else line) 1
  else if c == 32 || c == 13 then let nextColumn = column + 1 in seq nextColumn (indentAt source size target (i+1) line nextColumn)
  else if c == 9 then let nextColumn = column + 8 - ((column-1)%8) in seq nextColumn (indentAt source size target (i+1) line nextColumn)
  else column
virtual : String -> Token -> Token
virtual text (Token _ line column _ _) = Token text line column line column
punctuation : String -> Token -> List Token
punctuation text token = punctuationAt text token 0 (stringLength text)
punctuationAt : String -> Token -> Int -> Int -> List Token
punctuationAt text token i size = if i >= size then Nil else Cons (virtual (stringFromCode (stringCodeAt text i)) token) (punctuationAt text token (i+1) size)
arrange : List Frame -> Maybe Pending -> Maybe Token -> List Token -> Token -> List Token
arrange frames pending previous tokens finish = case tokens of
  Nil -> let opening = case pending of {Just (Open _) -> "{}"; _ -> ""} in punctuation (opening ++ closes frames) finish
  Cons t ts -> case pending of
    Just (AfterLet line) -> if eqString (tokenText t) "rec" then Cons t (arrange frames (Just (AfterLet (tokenEndLine t))) (Just t) ts finish)
      else if eqString (tokenText t) "{" then Cons t (nextToken t ts finish (pushToken t frames))
      else if tokenLine t > line then opened LayoutBindings frames previous t ts finish
      else normal frames previous t ts finish
    Just (Open kind) -> if eqString (tokenText t) "{" then Cons t (nextToken t ts finish (pushToken t frames)) else opened kind frames previous t ts finish
    Nothing -> normal frames previous t ts finish
nextToken : Token -> List Token -> Token -> List Frame -> List Token
nextToken token rest finish stack =
  -- A braced guard-if closes at }, so it must not intercept an enclosing
  -- ordinary if's then/else (which may also close an implicit do block).
  let scoped = if eqString (tokenText token) "if" then case rest of
        Cons next _ -> if eqString (tokenText next) "{" then case stack of {Cons (Marker IfMark _) outer -> outer; _ -> stack} else stack
        _ -> stack
      else stack in
  arrange scoped (keyword token) (Just token) rest finish
previousText : Maybe Token -> String
previousText previous = case previous of {Nothing -> ""; Just t -> tokenText t}
continuation : String -> String -> Bool
continuation token previous = elem eqString token continuationTokens || elem eqString previous continuationPrevious
continuationTokens = Cons "in" (Cons "then" (Cons "else" (Cons "of" (Cons "where" (Cons "|" (Cons ")" (Cons "}" (Cons ";" Nil))))))))
continuationPrevious = Cons "in" (Cons "then" (Cons "else" (Cons "=" (Cons "->" (Cons "<-" (Cons ":" (Cons "|" (Cons "+" (Cons "-" (Cons "*" (Cons "/" (Cons "%" (Cons "++" (Cons "&&" (Cons "||" (Cons "==" (Cons "/=" (Cons "<" (Cons "<=" (Cons ">" (Cons ">=" Nil)))))))))))))))))))))
opened : LayoutKind -> List Frame -> Maybe Token -> Token -> List Token -> Token -> List Token
opened kind stack previous token rest finish = let column = tokenColumn token in
  if not (isTop kind) && not (deeper column stack) then
    case offside column (continuation (tokenText token) (previousText previous)) (previousText previous) stack of
      Pair prefix remaining -> append (punctuation ("{}" ++ prefix) token) (Cons token (nextToken token rest finish (pushToken token remaining)))
  else Cons (virtual "{" token) (Cons token (nextToken token rest finish (pushToken token (Cons (Layout kind column) stack))))
isTop : LayoutKind -> Bool
isTop kind = case kind of {LayoutTop -> true; _ -> false}
normal : List Frame -> Maybe Token -> Token -> List Token -> Token -> List Token
normal stack previous token rest finish =
  let text = tokenText token in
  let closing = if eqString text "in" then closeMark LetMark false stack
      else if eqString text "then" then closeMark IfMark true stack
      else if eqString text "else" then closeMark IfMark false stack
      else if eqString text ")" then closeExplicit "(" stack
      else if eqString text "}" then closeExplicit "{" stack
      else if eqString text ";" then Pair "" (dropInline stack)
      else Pair "" stack in
  case closing of
    Pair ending closed ->
      let newLine = case previous of {Nothing -> false; Just old -> tokenEndLine old < tokenLine token} in
      let closingToken = eqString text ")" || eqString text "}" in
      let result = if newLine && not closingToken then offside (tokenColumn token) (continuation text (previousText previous)) (previousText previous) closed else Pair "" closed in
      case result of
        Pair separator scoped -> append (punctuation (ending ++ separator) token) (Cons token (nextToken token rest finish (if closingToken then scoped else pushToken token scoped)))
pushToken : Token -> List Frame -> List Frame
pushToken token frames = let text = tokenText token in
  if eqString text "(" || eqString text "{" then Cons (Explicit text) frames
  else if eqString text "let" then Cons (Marker LetMark (tokenColumn token)) frames
  else if eqString text "if" then Cons (Marker IfMark (tokenColumn token)) frames
  else frames
keyword : Token -> Maybe Pending
keyword token = let text = tokenText token in
  if eqString text "do" || eqString text "of" || eqString text "where" then Just (Open LayoutBlock)
  else if eqString text "let" then Just (AfterLet (tokenEndLine token)) else Nothing
deeper : Int -> List Frame -> Bool
deeper column frames = case frames of
  Cons (Layout _ indent) _ -> column > indent
  Cons (Marker _ _) rest -> deeper column rest
  _ -> true
offside : Int -> Bool -> String -> List Frame -> Pair String (List Frame)
offside column continued previous frames = case frames of
  Cons (Layout _ indent) rest -> if column < indent then case offside column continued "}" rest of
      Pair prefix remaining -> Pair ("}" ++ prefix) remaining
    else if column == indent && not continued && not (eqString previous ";" || eqString previous "{") then Pair ";" frames else Pair "" frames
  Cons (Marker _ indent) rest -> if column <= indent && not continued then offside column continued previous rest else Pair "" frames
  _ -> Pair "" frames
dropInline : List Frame -> List Frame
dropInline frames = case frames of {Cons (Marker _ _) rest -> dropInline rest; _ -> frames}
eqMark : LayoutMark -> LayoutMark -> Bool
eqMark a b = case a of {LetMark -> case b of {LetMark -> true; _ -> false}; IfMark -> case b of {IfMark -> true; _ -> false}}
closeMark : LayoutMark -> Bool -> List Frame -> Pair String (List Frame)
closeMark wanted keep frames = case searchMark wanted keep frames of {Nothing -> Pair "" frames; Just result -> result}
searchMark : LayoutMark -> Bool -> List Frame -> Maybe (Pair String (List Frame))
searchMark wanted keep frames = case frames of
  Cons (Marker mark column) rest -> if eqMark mark wanted then Just (Pair "" (if keep then frames else rest)) else searchMark wanted keep rest
  Cons (Layout _ _) rest -> case searchMark wanted keep rest of {Nothing -> Nothing; Just (Pair prefix remaining) -> Just (Pair ("}" ++ prefix) remaining)}
  _ -> Nothing
closeExplicit : String -> List Frame -> Pair String (List Frame)
closeExplicit wanted frames = case searchExplicit wanted frames of {Nothing -> Pair "" frames; Just result -> result}
searchExplicit : String -> List Frame -> Maybe (Pair String (List Frame))
searchExplicit wanted frames = case frames of
  Cons (Explicit delimiter) rest -> if eqString delimiter wanted then Just (Pair "" rest) else Nothing
  Cons (Layout _ _) rest -> case searchExplicit wanted rest of {Nothing -> Nothing; Just (Pair prefix remaining) -> Just (Pair ("}" ++ prefix) remaining)}
  Cons (Marker _ _) rest -> searchExplicit wanted rest
  _ -> Nothing
closes : List Frame -> String
closes frames = case frames of {Nil -> ""; Cons (Layout _ _) rest -> "}" ++ closes rest; Cons _ rest -> closes rest}
