module Bootstrap.Compiler
  (Compilation, inferredType, compiledTerm, checkedTerm, presolution, sourceType,
   phase, diagnostic, prettyPhase, prettyError, atPhase,
   compile, compileWithPrelude, compileModules, compileModulesWithPrelude,
   compileFile, compileFileWithPrelude, compileSourceWithImports, standalone,
   compileStandalone, compileLinked, compileExpr, compileExprWithPrelude,
   compileProgram, compileProgramWithPrelude, finishCompilation) where

import Bootstrap.Types
import qualified Bootstrap.Std as L
import qualified Bootstrap.Map as M
import qualified Bootstrap.Parser as P
import qualified Bootstrap.Module as Modules
import qualified Bootstrap.Prelude as Prelude
import qualified Bootstrap.Classes as Classes

import Bootstrap.CompilerCore

compile : String -> String -> Either CompileError Compilation
compile file source = compileWithPrelude ImplicitPrelude file source
compileWithPrelude : PreludeMode -> String -> String -> Either CompileError Compilation
compileWithPrelude mode file source = compileModulesWithPrelude mode M.empty file source
compileModules : Map String (Pair String String) -> String -> String -> Either CompileError Compilation
compileModules sources file input = compileModulesWithPrelude ImplicitPrelude sources file input
compileModulesWithPrelude : PreludeMode -> Map String (Pair String String) -> String -> String -> Either CompileError Compilation
compileModulesWithPrelude mode sources file input = do
  root <- atPhase Parsing (P.parseModule file input)
  if standalone root then compileStandalone mode root else do
    modules <- atPhase ModuleResolution (Modules.loadModuleMap sources root)
    compileLinked mode modules

compileFile : List String -> String -> IO (Either CompileError Compilation)
compileFile paths file = compileFileWithPrelude ImplicitPrelude paths file
compileFileWithPrelude : PreludeMode -> List String -> String -> IO (Either CompileError Compilation)
compileFileWithPrelude mode paths file = do
  present <- fileExists file
  if present then do
    input <- readFile file
    compileSourceWithImports mode paths file input
  else ioReturn (Left (CompileError ModuleResolution ("file does not exist: " ++ file)))
compileSourceWithImports : PreludeMode -> List String -> String -> String -> IO (Either CompileError Compilation)
compileSourceWithImports mode paths file input = case atPhase Parsing (P.parseModule file input) of
  Left err -> ioReturn (Left err)
  Right root -> if standalone root then ioReturn (compileStandalone mode root) else do
    modules <- Modules.loadModuleFiles paths root
    ioReturn (case atPhase ModuleResolution modules of
      Left err -> Left err
      Right loaded -> compileLinked mode loaded)

standalone (SourceModule _ name _ imports _ _ _ _ _) = case name of
  Nothing -> L.null imports
  Just _ -> false
compileStandalone : PreludeMode -> SourceModule -> Either CompileError Compilation
compileStandalone mode root = do
  program <- atPhase Parsing (P.standaloneProgram root)
  compileProgramWithPrelude mode program

compileLinked : PreludeMode -> List SourceModule -> Either CompileError Compilation
compileLinked mode modules = do
  LinkedModule program names valueScopes instanceScopes <- atPhase ModuleResolution (Modules.linkModules mode modules)
  let display = Modules.displayNames names
  lowered <- case Classes.lowerClassesWithScopes valueScopes instanceScopes program of
    Left err -> Left (CompileError Inference (display err))
    Right lowered -> Right lowered
  case lowered of
    Pair core classes ->
      let diagnosticNames = M.union compareString (M.map display classes) names in
      case finishCompilation lowered of
        Left (CompileError p message) -> Left (CompileError p (Modules.displayNames diagnosticNames message))
        Right (Compilation checked graph source) -> Right (Compilation checked graph (display source))

compileExpr : SExpr -> Either CompileError Compilation
compileExpr expr = compileExprWithPrelude ImplicitPrelude expr
compileExprWithPrelude : PreludeMode -> SExpr -> Either CompileError Compilation
compileExprWithPrelude mode expr = compileProgramWithPrelude mode (SProgram Nil expr)
compileProgram : SProgram -> Either CompileError Compilation
compileProgram program = compileProgramWithPrelude ImplicitPrelude program
compileProgramWithPrelude : PreludeMode -> SProgram -> Either CompileError Compilation
compileProgramWithPrelude mode original = case Prelude.withPrelude mode original of
  Pair imports source -> do
    lowered <- atPhase Inference (Classes.lowerClassesWithImports imports source)
    finishCompilation lowered
