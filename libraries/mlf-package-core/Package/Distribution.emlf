module Package.Distribution where
import Bootstrap.Types
import qualified Bootstrap.Std as S
import qualified Package.OS as O
import qualified Package.Json as J
import qualified Package.Release as R

-- Distribution is a text envelope, not an archive with producer-selected
-- paths. Only release.json and validated digest-key artifact pairs are written.
alphanumeric c = c >= 48 && c <= 57 || c >= 65 && c <= 90 || c >= 97 && c <= 122
identifier text = stringLength text > 0 && alphanumeric (stringCodeAt text 0) && S.all (\i -> let c = stringCodeAt text i in alphanumeric c || c == 45 || c == 46 || c == 95) (S.range 0 (stringLength text - 1))
validRepository text = case O.split 47 text of { Cons owner (Cons repository Nil) -> identifier owner && identifier repository; _ -> false }
validTag text = stringLength text > 0 && alphanumeric (stringCodeAt text 0) && S.not (eqString text "latest") && S.all (\i -> let c = stringCodeAt text i in alphanumeric c || c == 45 || c == 46 || c == 95 || c == 47 || c == 43) (S.range 0 (stringLength text - 1))
validateDependency dependency = do
  let source = J.get "github" dependency
  J.fields source (O.words "repository tag asset") "GitHub release source"
  repository <- R.fieldText "repository" source
  tag <- R.fieldText "tag" source
  asset <- R.fieldText "asset" source
  manifest <- R.fieldText "sha256" dependency
  digest <- R.fieldText "asset_sha256" dependency
  O.require (validRepository repository) "GitHub release repository must be OWNER/REPOSITORY"
  O.require (validTag tag) "GitHub release requires an explicit tag without option syntax"
  O.require (identifier asset && O.ends ".mlfr" asset) "GitHub release asset must be a literal .mlfr filename"
  O.require (R.validDigest manifest && R.validDigest digest) "GitHub release requires manifest and asset lowercase SHA-256 pins"
readPayload directory row = do
  let key = R.rowKey row
  let prefix = R.bundlePrefix directory key
  metadata <- readFile (prefix ++ ".mlfci")
  object <- readFile (prefix ++ ".mlfco")
  ioReturn (J.Object (Cons (Pair "key" (J.str key)) (Cons (Pair "metadata" (J.str metadata)) (Cons (Pair "object" (J.str object)) Nil))))
pack : String -> String -> IO J.Json
pack directory output = do
  source <- canonicalPath directory
  manifest <- R.readManifest source
  digest <- fileDigest (source ++ "/release.json")
  O.require (stringLength output > 0 && S.not (S.elem eqString (O.base output) (O.words ". ..")) && S.not (eqString (O.base output) "")) "invalid release asset output"
  O.mkdir (O.parent output)
  parent <- canonicalPath (O.parent output)
  let destination = O.join parent (O.base output)
  let work = destination ++ ".work"
  lock <- acquireFileLock (destination ++ ".lock")
  occupied <- fileExists destination
  directoryOccupied <- directoryExists destination
  stagingFile <- fileExists work
  stagingDirectory <- directoryExists work
  O.require (S.not (occupied || directoryOccupied || stagingFile || stagingDirectory)) "release asset output or staging path already exists"
  R.stageBundle source work manifest
  saved <- R.readPinnedManifest work digest
  manifestText <- readFile (work ++ "/release.json")
  crates <- S.mapM (readPayload work) (R.rows saved)
  R.readPinnedManifest work digest
  let envelope = J.Object (Cons (Pair "format" (J.num 1)) (Cons (Pair "manifest" (J.str manifestText)) (Cons (Pair "crates" (J.Array crates)) Nil)))
  J.write (work ++ "/package.mlfr") envelope
  asset <- fileDigest (work ++ "/package.mlfr")
  O.move (work ++ "/package.mlfr") destination
  O.remove work
  releaseFileLock lock
  ioReturn (J.Object (Cons (Pair "sha256" (J.str digest)) (Cons (Pair "asset_sha256" (J.str asset)) Nil)))
unpack asset destination expected = do
  envelope <- J.read asset
  J.fields envelope (O.words "format manifest crates") "checked release asset"
  O.require (J.equal (J.get "format" envelope) (J.num 1)) "unsupported checked release asset format"
  manifestText <- R.fieldText "manifest" envelope
  manifest <- R.checked (J.parse manifestText)
  R.validateShape manifest
  crates <- case J.get "crates" envelope of { J.Array entries -> ioReturn entries; _ -> O.fatal "release asset crates must be an array" }
  S.mapM_ (\entry -> do
    J.fields entry (O.words "key metadata object") "release asset crate"
    key <- R.fieldText "key" entry
    R.fieldText "metadata" entry
    R.fieldText "object" entry
    O.require (R.validKey key) "invalid release asset crate key") crates
  let actualKeys = S.map R.rowKey crates
  O.require (R.unique actualKeys && S.eqList eqString (S.sortBy compareString actualKeys) (S.sortBy compareString (S.map R.rowKey (R.rows manifest)))) "release asset crate inventory mismatch"
  let temporary = O.parent destination ++ "/manifest.json"
  writeFile temporary manifestText
  digest <- fileDigest temporary
  O.require (eqString digest expected) "release asset manifest SHA-256 mismatch"
  O.mkdir destination
  O.move temporary (destination ++ "/release.json")
  S.mapM_ (\entry -> do
    let prefix = R.bundlePrefix destination (R.rowKey entry)
    O.mkdir (O.parent prefix)
    writeFile (prefix ++ ".mlfci") (J.getText "metadata" "" entry)
    writeFile (prefix ++ ".mlfco") (J.getText "object" "" entry)) crates
  R.readPinnedManifest destination expected

validAsset path expected = do
  present <- fileExists path
  if S.not present then ioReturn false else do { actual <- fileDigest path; ioReturn (eqString actual expected) }
validCachedPath path = eqString path "bundle/release.json" || case O.split 47 path of
  Cons "bundle" (Cons "crates" (Cons key (Cons name Nil))) -> R.validKey key && S.elem eqString name (O.words "unit.mlfci unit.mlfco")
  _ -> false
validBundle destination expected = do
  present <- fileExists (destination ++ "/files.json")
  if S.not present then ioReturn false else do
    text <- readFile (destination ++ "/files.json")
    case J.parse text of
      Left _ -> ioReturn false
      Right receipt -> case receipt of
        J.Object _ -> if S.not (J.equal (J.get "format" receipt) (J.num 1) && J.equal (J.get "manifest_sha256" receipt) (J.str expected)) then ioReturn false else case J.get "files" receipt of
          J.Object files -> if S.null files || S.not (S.any (\entry -> eqString (S.fst entry) "bundle/release.json") files) || S.not (S.all (\entry -> validCachedPath (S.fst entry)) files) then ioReturn false else do
            checks <- S.mapM (\(Pair path digest) -> case digest of { J.String hash -> validAsset (destination ++ "/" ++ path) hash; _ -> ioReturn false }) files
            ioReturn (S.and checks)
          _ -> ioReturn false
        _ -> ioReturn false
saveBundleReceipt destination manifest expected = do
  let paths = Cons "bundle/release.json" (S.concatMap (\row -> let prefix = "bundle/crates/" ++ R.rowKey row ++ "/unit" in Cons (prefix ++ ".mlfci") (Cons (prefix ++ ".mlfco") Nil)) (R.rows manifest))
  hashes <- S.mapM (\path -> do { digest <- fileDigest (destination ++ "/" ++ path); ioReturn (Pair path (J.str digest)) }) paths
  J.write (destination ++ "/files.json") (J.Object (Cons (Pair "format" (J.num 1)) (Cons (Pair "manifest_sha256" (J.str expected)) (Cons (Pair "files" (J.Object hashes)) Nil))))
fetch : J.Json -> J.Json -> IO String
fetch options dependency = do
  validateDependency dependency
  let digest = J.getText "asset_sha256" "" dependency
  let expected = J.getText "sha256" "" dependency
  let requested = J.getText "cache-dir" ".mlf-build/cache" options
  O.mkdir (requested ++ "/.downloads")
  cache <- canonicalPath requested
  O.mkdir (cache ++ "/.locks")
  let destination = cache ++ "/.downloads/" ++ digest
  let scratch = destination ++ ".staging"
  let asset = destination ++ "/package.mlfr"
  lock <- acquireFileLock (cache ++ "/.locks/download-" ++ digest)
  retained <- validAsset asset digest
  complete <- if retained then validBundle destination expected else ioReturn false
  if complete then do { R.readPinnedManifest (destination ++ "/bundle") expected; ioReturn Unit } else do
    O.require (retained || S.not (J.getBool "offline" false options)) "offline cache miss or corrupt GitHub release asset"
    O.mkdir scratch
    work <- O.temporaryDirectory scratch (destination ++ ".work-")
    let downloaded = work ++ "/package.mlfr"
    if retained then O.copy asset downloaded else do
      gh <- O.which "gh"
      let source = J.get "github" dependency
      let argv = Cons gh (Cons "release" (Cons "download" (Cons (J.getText "tag" "" source) (Cons "--repo" (Cons ("github.com/" ++ J.getText "repository" "" source) (Cons "--pattern" (Cons (J.getText "asset" "" source) (Cons "--output" (Cons downloaded Nil)))))))))
      code <- O.exec "" argv "" "" "" (readInt (J.getText "timeout" "1800" options))
      O.require (code == 0) "GitHub release asset download failed"
    verified <- validAsset downloaded digest
    O.require verified "GitHub release asset SHA-256 mismatch"
    manifest <- unpack downloaded (work ++ "/bundle") expected
    verifiedAfter <- validAsset downloaded digest
    O.require verifiedAfter "GitHub release asset changed during extraction"
    saveBundleReceipt work manifest expected
    O.remove destination
    O.move work destination
  releaseFileLock lock
  ioReturn (destination ++ "/bundle/release.json")
