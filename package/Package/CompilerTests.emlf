module Package.CompilerTests where
import Bootstrap.Types
import qualified Bootstrap.Std as S
import qualified Bootstrap.Map as Map
import qualified Package.OS as O
import qualified Package.Json as J
import qualified Package.Build as B
import qualified Package.Command as C
import qualified Package.Verification as V
import qualified Package.Manifest as M

-- Build and execute native MLF tests; preserved oracle data and test-only
-- checking modules remain independent of the candidate compiler.
data TestContext = TestContext String String String (List String) String
root : TestContext -> String
root (TestContext r _ _ _ _) = r
output : TestContext -> String
output (TestContext _ d _ _ _) = d
compiler : TestContext -> String
compiler (TestContext _ _ c _ _) = c
runtimeProfiles : TestContext -> List String
runtimeProfiles (TestContext _ _ _ profiles _) = profiles
sharedCache : TestContext -> String
sharedCache (TestContext _ _ _ _ cache) = cache
cacheOptions : TestContext -> List String
cacheOptions c = if eqString (sharedCache c) "" then Nil else Cons "--cache-dir" (Cons (sharedCache c) Nil)
report : TestContext -> String
report c = output c ++ "/verification.json"
record : TestContext -> String -> J.Json -> IO Unit
record c key value = do { saved <- J.read (report c); J.write (report c) (J.set key value saved) }
run : TestContext -> List String -> IO Unit
run c argv = do
  putStrLn ("+ " ++ S.intercalate " " argv)
  code <- O.exec (root c) argv "" "" "" 1800
  O.require (code == 0) ("compiler test command failed (" ++ showInt code ++ "): " ++ S.intercalate " " argv)
query : TestContext -> List String -> IO String
query c argv = B.raw (output c) argv
capture : TestContext -> List String -> String -> IO Unit
capture c argv destination = captureWithin c argv destination 1800
captureWithin : TestContext -> List String -> String -> Int -> IO Unit
captureWithin c argv destination seconds = do
  let errors = destination ++ ".stderr"
  putStrLn ("+ " ++ S.intercalate " " argv)
  code <- O.exec (root c) argv "" destination errors seconds
  if code == 0 then ioReturn Unit else do { text <- readFile errors; O.fatal ("compiler test command failed (" ++ showInt code ++ "): " ++ text) }
walk : String -> IO (List String)
walk path = do
  present <- fileExists path
  if present then ioReturn (Cons path Nil) else do
    names <- O.entries path
    nested <- S.mapM (\name -> walk (O.join path name)) (S.filter (\name -> S.not (S.elem eqString name (O.words ".mlf-build .git dist-newstyle __pycache__"))) names)
    ioReturn (S.concat nested)
sources : String -> IO J.Json
sources r = do
  nested <- S.mapM (\dir -> walk (r ++ "/" ++ dir)) (O.words "scripts runtime bootstrap package examples benchmarks tests")
  let paths = S.filter (\p -> O.starts (r ++ "/benchmarks/") p || S.any (\suffix -> O.ends suffix p) (O.words ".hs .emlf .c .h .ps1 .sh .expected .json .gz")) (S.concat nested)
  hashes <- B.hashFiles (S.append paths (Cons (r ++ "/mlfpkg") (Cons (r ++ "/mlf-package.json") Nil)))
  ioReturn (J.Object (S.map (\entry -> Pair (O.relative r (S.fst entry)) (S.snd entry)) (J.items hashes)))
clearDrivers : IO Unit
clearDrivers = S.mapM_ unsetEnv (O.words "MLF_BENCH_STREAM_LINK MLF_MOCK_FAIL_RUNTIME MLF_BENCH_STREAM_LLVM MLF_BENCH_MLF_CLANG MLF_MOCK_FAST_FRONTEND MLF_BOOTSTRAP_INTERPRETER MLF_BOOTSTRAP_LLVM MLF_BOOTSTRAP_TIMEOUT_SECONDS MLF_TEST_TRACE MLF_TEST_FAIL_WRITE MLF_LLVM_TEST_ABI MLF_LLVM_TEST_CFLAGS MLF_LLVM_TEST_LIBS MLF_LLVM_TEST_OPT MLF_TEST_PORT_TARGETS MLF_TEST_PORT_TARGETS_SHA256")
nativeFlags : TestContext -> IO (List String)
nativeFlags c = do
  windows <- O.isWindows
  text <- query c (Cons "pkg-config" (O.words "--cflags --libs gmp"))
  extra <- do
    prefix <- getEnv "MLF_GC_PREFIX"
    if eqString prefix "" then do { flags <- query c (Cons "pkg-config" (O.words "--cflags --libs bdw-gc")); ioReturn (B.flags flags) }
      else do
        actual <- canonicalPath prefix
        system <- query c (O.words "uname -s")
        let library = actual ++ (if windows then "/lib/libgc.dll.a" else "/lib/libgc.a")
        ioReturn (Cons ("-I" ++ actual ++ "/include") (Cons library (if eqString (O.trim system) "Linux" then Cons "-ldl" Nil else Nil)))
  ioReturn (S.append (B.flags text) (S.append extra (if windows then O.words "-lshell32 -Wl,--stack,268435456" else Nil)))
stack : TestContext -> IO (List String)
stack c = do { system <- query c (O.words "uname -s"); ioReturn (if eqString (O.trim system) "Darwin" then Cons "-Wl,-stack_size,0x10000000" Nil else Nil) }
compileRuntime : TestContext -> List String -> Bool -> String -> IO Unit
compileRuntime c flags trace name = do
  let interpose = if trace then O.words "-Dgetline=mlf_test_getline -Dfwrite=mlf_test_fwrite -Dfputc=mlf_test_fputc -Dfflush=mlf_test_fflush" else Nil
  run c (S.append (O.words "clang -O2 -std=c11 -Wall -Wextra -Werror") (S.append (S.filter (O.starts "-I") flags) (S.append Nil (S.append interpose (Cons "-c" (Cons (root c ++ "/runtime/mlf_runtime.c") (Cons "-o" (Cons (output c ++ "/" ++ name) Nil))))))))
link : TestContext -> String -> List String -> List String -> String -> List String -> IO Unit
link c ir objects flags binary extra = run c (S.append (O.words "clang -O2 -Wno-override-module") (S.append (Cons ir objects) (S.append flags (S.append (Cons "-lm" extra) (Cons "-o" (Cons binary Nil))))))
nativeTest : TestContext -> String -> IO String
nativeTest c target = do
 manager <- getExecutablePath
 let build = output c ++ "/suite-build"
 let args = S.concat (Cons (Cons manager Nil)
  (Cons (Cons "--manifest" (Cons (root c ++ "/tests/mlf-package.json") Nil))
  (Cons (Cons "--compiler" (Cons (compiler c) Nil))
  (Cons (Cons "--runtime" (Cons (root c ++ "/runtime/mlf_runtime.c") Nil))
  (Cons (Cons "--build-dir" (Cons build Nil))
  (Cons (S.append (cacheOptions c) (S.snoc (O.words "--timeout 21600 build --target") target)) Nil))))))
 putStrLn ("+ " ++ S.intercalate " " args)
 code <- O.exec (root c) args "" "" "" 21600
 O.require (code == 0) ("native test build failed (" ++ showInt code ++ ")")
 O.executable (build ++ "/bin/" ++ target)
transports : TestContext -> IO Unit
transports c = do
 S.mapM_ (\(Pair source target) -> run c (S.append (O.words "clang -O2 -std=c11 -Wall -Wextra -Werror") (Cons (root c ++ "/tests/native/" ++ source) (Cons "-o" (Cons (output c ++ "/" ++ target) Nil))))) (Cons (Pair "binary_files.c" "binary-files") (Cons (Pair "host_support.c" "host-support") Nil))
 setEnv "MLF_TEST_BINARY_FILES" (output c ++ "/binary-files")
 setEnv "MLF_TEST_HOST_SUPPORT" (output c ++ "/host-support")
 setEnv "MLF_TEST_WORK" (output c)
 setEnv "MLF_TEST_ROOT" (output c)
suite : TestContext -> String -> List String -> IO Unit
suite c target expectations = do
 binary <- nativeTest c target
 let log = output c ++ "/" ++ target ++ ".log"
 capture c (Cons binary Nil) log
 text <- readFile log
 O.require (S.all (\expected -> contains expected text) expectations) (target ++ ": preserved coverage summary is missing")
 hash <- fileDigest log
 saved <- J.read (report c)
 record c "suites" (J.set target (B.obj2 "log_sha256" (J.str hash) "coverage" (J.stringArray expectations)) (J.getObject "suites" saved))
 putStr (O.drop (S.max 0 (stringLength text - 2000)) text)
unit : TestContext -> IO Unit
unit c = do
 transports c
 -- Check native toolchain and runtime probes before the longer compiler suites.
 suite c "regex" (Cons "regular-expression tests passed" Nil)
 suite c "harness" (Cons "Native benchmark/bootstrap/release harness tests passed" Nil)
 suite c "core" (Cons "686 checks; 0 failures" (Cons "Oracle: 6712 cases; 6703 executions" Nil))
 suite c "figure12" (Cons "43/43 expressions match regression expectations; 0 failures" (Cons "41 distinct Figure12 executions" (Cons "36 supplementary checks; 0 failures" Nil)))
packages : TestContext -> IO Unit
packages c = do
 setEnv "MLF_TEST_WORK" (output c)
 setEnv "MLF_TEST_ROOT" (output c)
 suite c "packages" (Cons "18 package resolver tests passed" (Cons "29 package integration cases passed" (Cons "28 checked package release cases passed" Nil)))
testBuilder : TestContext -> String -> IO B.Builder
testBuilder c name = do
 graph <- M.load (root c ++ "/mlf-package.json")
 let options = B.info (Cons (Pair "compiler" (J.str (compiler c))) (Cons (Pair "runtime" (J.str (root c ++ "/runtime/mlf_runtime.c"))) (Cons (Pair "cache-dir" (J.str (sharedCache c))) (Cons (Pair "timeout" (J.str "21600")) Nil))))
 configured <- C.configureGC (root c) options
 B.create graph configured (output c ++ "/" ++ name)
driverIR : TestContext -> B.Builder -> String -> IO String
driverIR c builder name = do
 saved <- J.read (report c)
 let entry = root c ++ "/bootstrap/" ++ name ++ ".emlf"
 let identity = B.info (Cons (Pair "format" (J.num 1)) (Cons (Pair "compiler" (J.get "compiler" (B.tools builder))) (Cons (Pair "manager" (J.get "manager" (B.tools builder))) (Cons (Pair "sources" (J.get "sources" saved)) (Cons (Pair "entry" (J.str entry)) (Cons (Pair "frontend" (J.str "source --emit-llvm-gc")) Nil))))))
 -- Share the verified source frontend output. The crate-linked interpreter
 -- regressed the nested compiler workloads despite identical fixture targets.
 B.cached builder ("source " ++ name ++ " LLVM") identity (\work -> do
  ignored <- B.capture builder (root c) (Cons (compiler c) (Cons "-i" (Cons (root c ++ "/bootstrap") (Cons "--emit-llvm-gc" (Cons entry Nil))))) "" (work ++ "/program.ll")
  text <- readFile (work ++ "/program.ll")
  O.require (stringLength text > 0) "test driver emitted empty LLVM")
prepareDrivers : TestContext -> Bool -> IO (List String)
prepareDrivers c portFixtures = do
 builder <- testBuilder c "driver-build"
 flags <- nativeFlags c
 compileRuntime c flags false "runtime.o"
 if portFixtures then ioReturn Unit else compileRuntime c flags true "runtime-traced.o"
 run c (S.append (O.words "clang -O2 -std=c11 -Wall -Wextra -Werror -c") (Cons (root c ++ "/tests/native/native_trace.c") (Cons "-o" (Cons (output c ++ "/trace.o") Nil))))
 extra <- stack c
 drivers <- S.mapM (\name -> do
  let ir = output c ++ "/" ++ name ++ ".ll"
  emitted <- driverIR c builder name
  O.copy (emitted ++ "/program.ll") ir
  let objects = if eqString name "RuntimeDriver" then Cons (output c ++ "/runtime-traced.o") (Cons (output c ++ "/trace.o") Nil) else Cons (output c ++ "/runtime.o") Nil
  let binary = output c ++ "/" ++ name
  link c ir objects flags binary extra
  hash <- fileDigest binary
  llvm <- fileDigest ir
  return (Pair name (J.set "frontend" (J.str "source") (B.obj2 "sha256" (J.str hash) "llvm_sha256" (J.str llvm))))) (if portFixtures then Cons "LLVMDriver" Nil else O.words "RuntimeDriver LLVMDriver")
 B.finish builder
 record c "drivers" (J.Object drivers)
 return (S.append flags extra)
matrices : TestContext -> String -> Bool -> IO Unit
matrices c binary portFixtures = do
 requestedDivisor <- getEnv "MLF_TEST_MATRIX_GC_DIVISOR"
 divisor <- case V.matrixCollectionDivisor requestedDivisor of
  Left message -> O.fatal message
  Right value -> ioReturn value
 flags <- prepareDrivers c portFixtures
 if portFixtures then unsetEnv "MLF_BOOTSTRAP_INTERPRETER" else setEnv "MLF_BOOTSTRAP_INTERPRETER" (output c ++ "/RuntimeDriver")
 setEnv "MLF_BOOTSTRAP_LLVM" (output c ++ "/LLVMDriver")
 setEnv "MLF_BOOTSTRAP_COMPILER" (compiler c)
 setEnv "MLF_BOOTSTRAP_TIMEOUT_SECONDS" "1800"
 S.mapM_ (\abi -> do
  setEnv "MLF_LLVM_TEST_ABI" abi
  let initialHeap = "8388608"
  setEnv "GC_INITIAL_HEAP_SIZE" initialHeap
  setEnv "GC_FREE_SPACE_DIVISOR" divisor
  let flagsFile = output c ++ "/link-flags.bin"
  writeFile flagsFile (O.pack flags)
  setEnv "MLF_TEST_LINK_FLAGS_FILE" flagsFile
  let directory = output c ++ "/matrix-" ++ abi
  O.mkdir directory
  compileRuntime c flags true ("matrix-" ++ abi ++ "/runtime.o")
  let log = output c ++ "/" ++ abi ++ ".log"
  -- Each fixture retains its own execution limit. The complete matrix also
  -- includes native candidate emission, linking, and graph reference workloads.
  if portFixtures then validatePreparedPort c else ioReturn Unit
  captureWithin c (Cons binary Nil) log (if portFixtures then 18000 else 14400)
  if portFixtures then validatePreparedPort c else ioReturn Unit
  text <- readFile log
  let rows = S.filter (O.starts "Backend matrix: ") (O.lines text)
  let backendNames = if portFixtures then Cons "llvm" Nil else O.words "interpreter llvm"
  case V.validateMatrixAudit (if portFixtures then 25 else 575) backendNames text of
   Left message -> O.fatal message
   Right _ -> ioReturn Unit
  let expected = if portFixtures then "25 MLF port fixtures; 0 failures" else "523 shared IO/prelude/backend fixtures; 0 failures"
  O.require (contains expected text) "native fixture coverage changed"
  hash <- fileDigest log
  let row = J.set "backend_names" (J.stringArray backendNames) (B.info (Cons (Pair "rows" (J.num (readInt (S.index (O.words (S.head rows)) 2)))) (Cons (Pair "backends" (J.num (S.length backendNames))) (Cons (Pair "cli_compiler" (J.str (compiler c))) (Cons (Pair "log_sha256" (J.str hash)) (Cons (Pair "gc_initial_heap_bytes" (J.num (readInt initialHeap))) (Cons (Pair "gc_free_space_divisor" (J.num (readInt divisor))) Nil)))))))
  saved <- J.read (report c)
  preparedHash <- getEnv "MLF_TEST_PORT_TARGETS_SHA256"
  record c "matrices" (J.set abi (if portFixtures then J.set "prepared_targets_sha256" (J.str preparedHash) row else row) (J.getObject "matrices" saved))
  putStr (O.drop (S.max 0 (stringLength text - 2000)) text)) (runtimeProfiles c)
 clearDrivers
backends : TestContext -> IO Unit
backends c = do
 transports c
 binary <- nativeTest c "backends"
 matrices c binary false
port : TestContext -> IO Unit
port c = do
 transports c
 references <- nativeTest c "references"
 setEnv "MLF_TEST_REFERENCES" references
 binary <- nativeTest c "port"
 preparePort c binary
 matrices c binary true
preparePort : TestContext -> String -> IO Unit
preparePort c binary = do
 builder <- testBuilder c "port-preparation"
 let listing = output c ++ "/port-fixtures.txt"
 capture c (Cons binary (Cons "--list" Nil)) listing
 listingText <- readFile listing
 let names = O.words listingText
 O.require (S.length names == 25 && S.length (S.nubBy eqString names) == 25) "port fixture preparation coverage changed"
 checkerHash <- fileDigest binary
 saved <- J.read (report c)
 let identity = B.info (Cons (Pair "format" (J.num 1)) (Cons (Pair "compiler" (J.get "compiler" (B.tools builder))) (Cons (Pair "manager" (J.get "manager" (B.tools builder))) (Cons (Pair "checker_sha256" (J.str checkerHash)) (Cons (Pair "sources" (J.get "sources" saved)) Nil)))))
 targets <- S.mapM (\name -> do
  artifact <- B.cachedChecked builder ("checked port target " ++ name) (J.set "fixture" (J.str name) identity) (\directory -> do
   let target = directory ++ "/unit.xmlf"
   present <- fileExists target
   receipt <- fileExists (target ++ ".checks.json")
   if present && receipt then do { hash <- fileDigest target; checks <- J.read (target ++ ".checks.json"); ioReturn (V.validPortTargetChecks name hash checks) } else ioReturn false) (\work -> do
    ignored <- B.capture builder (root c) (Cons binary (Cons "--prepare" (Cons name (Cons (work ++ "/unit.xmlf") Nil)))) "" ""
    ioReturn Unit)
  let target = artifact ++ "/unit.xmlf"
  hash <- fileDigest target
  checksHash <- fileDigest (target ++ ".checks.json")
  ioReturn (B.info (Cons (Pair "fixture" (J.str name)) (Cons (Pair "target" (J.str target)) (Cons (Pair "target_sha256" (J.str hash)) (Cons (Pair "checks_sha256" (J.str checksHash)) Nil)))))) names
 B.finish builder
 let manifest = output c ++ "/prepared-port.json"
 J.write manifest (J.set "targets" (J.Array targets) identity)
 hash <- fileDigest manifest
 setEnv "MLF_TEST_PORT_TARGETS" manifest
 setEnv "MLF_TEST_PORT_TARGETS_SHA256" hash
 let targetHashes = J.Object (S.map (\row -> Pair (J.getText "fixture" "" row) (J.get "target_sha256" row)) targets)
 record c "prepared_port" (J.set "target_hashes" targetHashes (B.info (Cons (Pair "manifest" (J.str manifest)) (Cons (Pair "sha256" (J.str hash)) (Cons (Pair "targets" (J.num (S.length targets))) (Cons (Pair "build_report" (J.str (B.reportPath builder))) Nil))))))
 validatePreparedPort c
validatePreparedPort : TestContext -> IO Unit
validatePreparedPort c = do
 path <- getEnv "MLF_TEST_PORT_TARGETS"
 expected <- getEnv "MLF_TEST_PORT_TARGETS_SHA256"
 hash <- fileDigest path
 O.require (eqString hash expected) "prepared port manifest changed between layouts"
 manifest <- J.read path
 let targets = J.values (J.get "targets" manifest)
 O.require (S.length targets == 25) "prepared port targets missing"
 S.mapM_ (\row -> do
  let target = J.getText "target" "" row
  hash <- fileDigest target
  checksHash <- fileDigest (target ++ ".checks.json")
  checks <- J.read (target ++ ".checks.json")
  O.require (eqString hash (J.getText "target_sha256" "" row) && eqString checksHash (J.getText "checks_sha256" "" row) && V.validPortTargetChecks (J.getText "fixture" "" row) hash checks) "prepared port target/check receipt changed between layouts") targets
shellQuote : String -> String
shellQuote text = "'" ++ O.replace "'" "'\\''" text ++ "'"
contains : String -> String -> Bool
contains needle text = S.not (eqString text (O.replace needle "" text))
-- The exported corpus prescribes acceptance, rejection phase/diagnostic,
-- checked target type and (where applicable) exact output for both backends.
parity : TestContext -> IO Unit
parity c = do
  checker <- nativeTest c "check-target"
  exporter <- nativeTest c "corpus"
  let corpus = output c ++ "/corpus"
  run c (Cons exporter (Cons corpus Nil))
  source <- readFile (corpus ++ "/manifest.jsonl")
  rows <- S.mapM (\line -> case J.parse line of { Left error -> O.fatal error; Right value -> ioReturn value }) (O.nonempty (O.lines source))
  O.require (S.length (S.nubBy eqString (S.map (J.getText "id" "") rows)) == S.length rows) "duplicate parity identities"
  O.require (S.all (\row -> J.equal (J.get "schema_version" row) (J.num 1)) rows) "unsupported parity schema"
  S.mapM_ (\pair -> O.require (S.length (S.filter (\row -> eqString (J.getText "category" "" row) (S.fst pair)) rows) >= S.snd pair) ("parity corpus lacks " ++ S.fst pair))
    (Cons (Pair "figure12" 43) (Cons (Pair "hm-exhaustive" 1712) (Cons (Pair "hm-generated" 5000) (Cons (Pair "annotations" 126) (Cons (Pair "readability" 18) (Cons (Pair "state" 97) (Cons (Pair "modules" 60) (Cons (Pair "examples" 21) (Cons (Pair "benchmarks" 9) Nil)))))))))
  let a8 = S.fromMaybe (panic "missing Figure12 A8") (S.find (\row -> eqString (J.getText "id" "" row) "figure12-A8") rows)
  O.require (S.not (J.getBool "expected_accept" true a8) && eqString (J.getText "expected_phase" "" a8) "Inference") "A8 must be rejected by inference"
  let moduleRows = S.filter (\row -> eqString (J.getText "category" "" row) "modules") rows
  O.require (S.length moduleRows == 60 && S.length (S.filter (J.getBool "expected_accept" false) moduleRows) == 23 && S.length (S.filter (\row -> S.not (J.getBool "expected_accept" false row)) moduleRows) == 37) "module corpus differs from the two prescribed crate-cycle oracle migrations"
  O.require (S.any (\row -> J.getBool "no_prelude" false row && J.getBool "expected_accept" false row) moduleRows) "module corpus lacks explicit prelude coverage"
  O.require (S.all (\row -> J.getBool "expected_accept" false row || (stringLength (J.getText "expected_phase" "" row) > 0 && stringLength (O.trim (J.getText "expected_error_contains" "" row)) > 0)) moduleRows) "module rejection lacks a prescribed phase or diagnostic"
  flags <- nativeFlags c
  compileRuntime c flags false "runtime.o"
  O.mkdir (output c ++ "/parity")
  checkCrateCycleOracles c corpus checker rows
  shared <- parityLoop c corpus checker flags 0 Map.empty Nil rows
  O.require (S.length shared == 11 && S.length (S.filter (\row -> O.starts "hm-generated-" (J.getText "id" "" row)) shared) == 9 && S.length (S.filter (\row -> O.starts "figure12-" (J.getText "id" "" row)) shared) == 2) "parity execution sharing changed"
  let accepted = S.length (S.filter (J.getBool "expected_accept" false) rows)
  let runtime = S.length (S.filter (J.has "expected_stdout") rows)
  O.require (S.length rows == 7086 && accepted == 3204 && runtime == 80) "preserved parity coverage changed"
  hash <- fileDigest (corpus ++ "/manifest.jsonl")
  let sourceCompilations = S.length rows - S.length shared
  let sharedAccepted = S.length (S.filter (J.getBool "expected_accept" false) shared)
  let details = B.info (Cons (Pair "source_compilations" (J.num sourceCompilations)) (Cons (Pair "shared_source_cases" (J.num (S.length shared))) (Cons (Pair "shared_cases" (J.Array shared)) (Cons (Pair "independent_target_checks" (J.num (accepted - sharedAccepted + 2))) Nil))))
  record c "parity" (J.Object (S.append (J.items details) (J.items (B.info (Cons (Pair "cases" (J.num (S.length rows))) (Cons (Pair "accepted" (J.num accepted)) (Cons (Pair "rejected" (J.num (S.length rows - accepted))) (Cons (Pair "runtime_rows" (J.num runtime)) (Cons (Pair "runtime_executions" (J.num (runtime * 2))) (Cons (Pair "manifest_sha256" (J.str hash)) Nil))))))))))
  putStrLn ("Parity: 7086 cases; " ++ showInt sourceCompilations ++ " source compilations; " ++ showInt (S.length shared) ++ " identical input/oracle cases shared")
-- The expected result is a fixed integer literal, never a type obtained from
-- the candidate. Check both the reference xMLF and every emitted candidate
-- target against the independently prescribed Int oracle.
checkCrateCycleOracles : TestContext -> String -> String -> List J.Json -> IO Unit
checkCrateCycleOracles c corpus checker rows = do
  O.require (S.length (S.filter (J.has "oracle_migration") rows) == 2) "unexpected parity oracle migrations"
  reference <- readFile (corpus ++ "/oracle/crate-module-cycles/int42.xmlf")
  O.require (eqString reference "42\n") "crate-cycle reference target changed"
  S.mapM_ (\(Pair identity reason) -> do
    let matches = S.filter (\row -> eqString (J.getText "id" "" row) identity) rows
    O.require (S.length matches == 1) "missing or duplicate migrated crate-cycle oracle"
    let row = S.head matches
    O.require (eqString (J.getText "category" "" row) "modules" && J.getBool "expected_accept" false row && eqString (J.getText "expected_type" "" row) "Int" && eqString (J.getText "oracle_migration" "" row) "crate-module-cycles-v1") "crate-cycle acceptance/type oracle changed"
    O.require (eqString (J.getText "previous_expected_phase" "" row) "ModuleResolution" && eqString (J.getText "previous_expected_error_contains" "" row) reason && S.not (J.has "expected_phase" row) && S.not (J.has "expected_error_contains" row) && S.not (J.has "expected_stdout" row)) "crate-cycle oracle provenance changed"
    O.require (eqString (J.getText "expected_reference_target" "" row) "oracle/crate-module-cycles/int42.xmlf") "crate-cycle reference path changed"
    let stem = output c ++ "/parity/oracle-" ++ identity
    writeFile (stem ++ ".type") "Int"
    status <- O.exec (root c) (Cons checker (Cons (corpus ++ "/oracle/crate-module-cycles/int42.xmlf") (Cons (stem ++ ".type") Nil))) "" (stem ++ ".out") (stem ++ ".err") 1800
    O.require (status == 0) "independent crate-cycle reference typing failed")
    (Cons (Pair "module-reject-000025" "Main -> A -> B -> A") (Cons (Pair "module-reject-000026" "Main -> Main") Nil))
parityLoop : TestContext -> String -> String -> List String -> Int -> Map String (Pair Int String) -> List J.Json -> List J.Json -> IO (List J.Json)
parityLoop c corpus checker flags number seen shared rows = case rows of
  Nil -> ioReturn (S.reverse shared)
  Cons row rest -> do
    let shareable = V.canShareParity row
    source <- if shareable then readFile (corpus ++ "/" ++ J.getText "source_path" "" row) else ioReturn ""
    let key = V.parityExecutionKey row source
    Pair next aliases <- case (if shareable then Map.lookup compareString key seen else Nothing) of
      Just (Pair canonicalIndex canonicalId) -> do
        sourceHash <- fileDigest (corpus ++ "/" ++ J.getText "source_path" "" row)
        let alias = B.info (Cons (Pair "id" (J.get "id" row)) (Cons (Pair "index" (J.num number)) (Cons (Pair "canonical_id" (J.str canonicalId)) (Cons (Pair "canonical_index" (J.num canonicalIndex)) (Cons (Pair "source_sha256" (J.str sourceHash)) (Cons (Pair "expected_accept" (J.get "expected_accept" row)) Nil))))))
        ioReturn (Pair seen (Cons alias shared))
      Nothing -> do
        parityCase c corpus checker flags number row
        ioReturn (Pair (if shareable then Map.insert compareString key (Pair number (J.getText "id" "" row)) seen else seen) shared)
    if remInt (number + 1) 100 == 0 then putStrLn ("Parity: " ++ showInt (number + 1)) else ioReturn Unit
    parityLoop c corpus checker flags (number + 1) next aliases rest
parityCase : TestContext -> String -> String -> List String -> Int -> J.Json -> IO Unit
parityCase c corpus checker flags number row = do
    let stem = output c ++ "/parity/" ++ showInt number
    let prefix = S.append (Cons (compiler c) (if J.getBool "no_prelude" false row then Cons "--no-prelude" Nil else Nil)) (S.concatMap (\path -> Cons "-i" (Cons (corpus ++ "/" ++ path) Nil)) (J.getStrings "include_dirs" row))
    let source = corpus ++ "/" ++ J.getText "source_path" "" row
    code <- O.exec (root c) (S.snoc prefix source) "" (stem ++ ".xmlf") (stem ++ ".stderr") 1800
    let accept = J.getBool "expected_accept" false row
    error <- readFile (stem ++ ".stderr")
    O.require ((code == 0 && accept) || (code == 1 && S.not accept)) (J.getText "id" "" row ++ ": acceptance mismatch: " ++ error)
    if accept then do
      writeFile (stem ++ ".type") (J.getText "expected_type" "" row)
      checked <- O.exec (root c) (Cons checker (Cons (stem ++ ".xmlf") (Cons (stem ++ ".type") Nil))) "" (stem ++ ".check.out") (stem ++ ".check.err") 1800
      O.require (checked == 0) ("independent target check failed: " ++ stem)
      checked <- O.exec (root c) (Cons (compiler c) (Cons "--check" (Cons (stem ++ ".xmlf") Nil))) "" (stem ++ ".self.out") (stem ++ ".self.err") 1800
      O.require (checked == 0) ("candidate target check failed: " ++ stem)
    else do
      target <- readFile (stem ++ ".xmlf")
      O.require (eqString target "") "rejected input emitted a target"
      let phase = J.getText "expected_phase" "" row
      let reason = J.getText "expected_error_contains" "" row
      O.require (eqString phase "" || O.starts (phase ++ ":") error) ("wrong rejection phase: " ++ stem)
      O.require (eqString reason "" || contains reason error) ("wrong rejection diagnostic: " ++ stem)
    if J.has "expected_stdout" row then do
      O.require accept "rejected corpus row has runtime expectation"
      writeFile (stem ++ ".stdin") (J.getText "expected_stdin" "" row)
      checkOutput c row (S.append prefix (Cons "--run" (Cons source Nil))) stem "interpreter"
      generated <- O.exec (root c) (S.append prefix (Cons "--emit-llvm" (Cons source Nil))) "" (stem ++ ".ll") (stem ++ ".llvm.err") 1800
      O.require (generated == 0) ("LLVM emission failed: " ++ stem)
      binary <- O.executable (stem ++ ".native")
      link c (stem ++ ".ll") (Cons (output c ++ "/runtime.o") Nil) flags binary Nil
      checkOutput c row (Cons binary Nil) stem "llvm"
    else ioReturn Unit
checkOutput : TestContext -> J.Json -> List String -> String -> String -> IO Unit
checkOutput c row argv stem backend = do
  code <- O.exec (root c) argv (stem ++ ".stdin") (stem ++ "." ++ backend ++ ".out") (stem ++ "." ++ backend ++ ".err") 1800
  out <- readFile (stem ++ "." ++ backend ++ ".out")
  err <- readFile (stem ++ "." ++ backend ++ ".err")
  O.require (code == 0 && eqString out (J.getText "expected_stdout" "" row) && eqString err (J.getText "expected_stderr" "" row)) (backend ++ " output/status mismatch: " ++ stem)
findArtifact : String -> String -> List String -> IO String
findArtifact hash cache names = case names of
  Nil -> O.fatal "cannot find the package artifact that produced the candidate"
  Cons name rest -> do
    let binary = cache ++ "/" ++ name ++ "/program"
    present <- fileExists binary
    irPresent <- fileExists (O.parent binary ++ "/program.ll")
    valid <- if present && irPresent then B.cacheValid (O.parent binary) name else ioReturn false
    if valid then do
      actual <- fileDigest binary
      if eqString actual hash then ioReturn (O.parent binary) else findArtifact hash cache rest
    else findArtifact hash cache rest
selfHost : TestContext -> IO Unit
selfHost c = do
  manager <- getExecutablePath
  hash <- fileDigest (compiler c)
  -- A shared store can contain equal native binaries from different LLVM
  -- inputs. Select the candidate's actual producer, not the first hash match.
  let producer = O.parent (O.parent (compiler c)) ++ "/build-report.json"
  present <- fileExists producer
  O.require present "candidate package build report is missing"
  let provenance = output c ++ "/candidate-build-report.json"
  O.copy producer provenance
  produced <- J.read provenance
  graph <- M.load (root c ++ "/mlf-package.json")
  snapshot <- M.snapshot graph
  O.require (eqString (J.getText "implementation" "" produced) "MLF" && J.equal snapshot (J.get "packages" produced)) "candidate build source provenance differs"
  let cache = J.getText "cache_directory" (sharedCache c) produced
  let names = S.nubBy eqString (S.map (J.getText "key" "") (S.filter (\row -> eqString (J.getText "kind" "" row) "executable mlf-compiler:emlf") (J.values (J.get "builds" produced))))
  original <- findArtifact hash cache names
  provenanceHash <- fileDigest provenance
  record c "candidate_artifact" (B.info (Cons (Pair "directory" (J.str original)) (Cons (Pair "key" (J.str (O.relative cache original))) (Cons (Pair "build_report" (J.str provenance)) (Cons (Pair "build_report_sha256" (J.str provenanceHash)) Nil)))))
  stamp <- J.read (original ++ "/artifact.json")
  let inputs = J.get "inputs" stamp
  let profile = J.getObject "native-pgo" inputs
  O.require (S.null (J.items profile) || (eqString (J.getText "mode" "" profile) "use" && eqString (J.getText "target" "" profile) "emlf")) "self-host requires an ordinary or profile-use compiler"
  B.verifyPgo profile
  let toolchain = J.get "toolchain" inputs
  let cc = J.get "clang" toolchain
  ccHash <- fileDigest (J.getText "path" "" cc)
  O.require (eqString ccHash (J.getText "sha256" "" cc)) "self-host native compiler changed"
  let profileArgs = if S.null (J.items profile) then Nil else S.append (O.words "--pgo-target emlf --pgo-use") (Cons (J.getText "path" "" (J.get "profile" profile)) Nil)
  let nativeArgs = Cons "--clang" (Cons (J.getText "path" "" cc) profileArgs)
  let next = output c ++ "/next-stage"
  O.remove next
  let argv = Cons manager (Cons "--timeout" (Cons "21600" (Cons "--compiler" (Cons (compiler c) (Cons "--build-dir" (Cons next (S.append nativeArgs (O.words "build --target emlf"))))))))
  putStrLn ("+ " ++ S.intercalate " " argv)
  code <- O.exec (root c) argv "" "" "" 21600
  O.require (code == 0) ("self-host compiler build failed (" ++ showInt code ++ ")")
  saved <- J.read (next ++ "/build-report.json")
  O.require (J.getBool "complete" false saved) "next-stage package build incomplete"
  let row = S.fromMaybe (panic "missing next compiler artifact") (S.find (\row -> eqString (J.getText "kind" "" row) "executable mlf-compiler:emlf") (J.values (J.get "builds" saved)))
  O.require (S.not (J.getBool "cached" true row)) "next compiler reused a previous build"
  let ir = next ++ "/cache/" ++ J.getText "key" "" row ++ "/program.ll"
  old <- fileDigest (original ++ "/program.ll")
  new <- fileDigest ir
  O.require (eqString old new) "package self-build did not reach an LLVM fixed point"
  binary <- fileDigest (next ++ "/bin/emlf")
  O.require (eqString hash binary) "package self-build did not reach a native binary fixed point"
  B.verifyPgo profile
  record c "native_pgo" profile
  record c "fixed_point" (B.info (Cons (Pair "llvm_sha256" (J.str new)) (Cons (Pair "next_compiler_sha256" (J.str binary)) (Cons (Pair "reused_candidate_build" (J.get "cached" row)) Nil))))
main : List String -> IO Unit
main args = case args of
  Cons group rest -> do
    Pair options remaining <- C.options J.empty rest
    O.require (S.null remaining && J.has "compiler" options && J.has "build-dir" options) "compiler-test GROUP --compiler TOOL --build-dir DIRECTORY"
    profile <- getEnv "MLF_TEST_RUNTIME_PROFILE"
    O.require (eqString profile "" || S.elem eqString profile (Cons "compact-gc" Nil)) "invalid runtime profile; expected compact-gc"
    let profiles = if eqString group "port" || eqString group "backends" then Cons "compact-gc" Nil else Nil
    let directory = J.getText "build-dir" "" options
    root <- canonicalPath "."
    O.mkdir directory
    out <- canonicalPath directory
    compiler <- canonicalPath (J.getText "compiler" "" options)
    let defaultCache = if eqString group "self-host" then O.parent (O.parent compiler) ++ "/cache" else O.parent out ++ "/mlf-test-suite/cache"
    let requestedCache = J.getText "cache-dir" defaultCache options
    O.mkdir requestedCache
    cache <- canonicalPath requestedCache
    let c = TestContext root out compiler profiles cache
    sourceHashes <- sources root
    hash <- fileDigest compiler
    manager <- getExecutablePath
    managerHash <- fileDigest manager
    let identity = B.info (Cons (Pair "complete" (J.Boolean false)) (Cons (Pair "implementation" (J.str "MLF")) (Cons (Pair "group" (J.str group)) (Cons (Pair "compiler" (J.str compiler)) (Cons (Pair "compiler_sha256" (J.str hash)) (Cons (Pair "sources" sourceHashes) Nil))))))
    J.write (report c) (J.set "requested_profiles" (J.stringArray profiles) (J.set "manager_sha256" (J.str managerHash) (J.set "manager" (J.str manager) identity)))
    setEnv "MLF_PACKAGE_MANAGER" manager
    clearDrivers
    setEnv "MLF_BOOTSTRAP_COMPILER" compiler
    path <- getEnv "PATH"
    windows <- O.isWindows
    setEnv "PATH" (O.parent compiler ++ (if windows then ";" else ":") ++ path)
    if eqString group "self-host" then selfHost c else do
      if eqString group "packages" then packages c else if eqString group "unit" then unit c else if eqString group "port" then port c else if eqString group "backends" then backends c else if eqString group "parity" then parity c else O.fatal "unknown compiler test group"
    after <- sources root
    O.require (J.equal sourceHashes after) "compiler/test sources changed during validation"
    current <- fileDigest compiler
    O.require (eqString hash current) "compiler changed during validation"
    currentManager <- fileDigest manager
    O.require (eqString managerHash currentManager) "package manager changed during validation"
    record c "complete" (J.Boolean true)
    putStrLn ("Compiler package " ++ group ++ " passed")
  Nil -> O.fatal "missing compiler test group"
