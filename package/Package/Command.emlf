module Package.Command where
import Bootstrap.Types
import qualified Bootstrap.Std as S
import qualified Package.OS as O
import qualified Package.Json as J
import qualified Package.Manifest as M
import qualified Package.Build as B
import qualified Package.Distribution as Distribution

usage : String
usage = "Usage: mlfpkg [--manifest FILE] [--build-dir DIR] [--cache-dir DIR] [--compiler TOOL] [--clang TOOL]\n              [--pkg-config TOOL] [--runtime FILE] [--gc-prefix DIR] [--timeout SECONDS] [--locked] [--offline]\n              [--pgo-generate TARGET | --pgo-target TARGET --pgo-use FILE]\n              plan | lock | build [--target NAME ...] | test [--target NAME ...] | run NAME [-- ARGS...]\n              release DIRECTORY | pack RELEASE_DIRECTORY ASSET_FILE\nPackage manifests: mlf-package.json. Dependencies select local source, checked directories, or pinned GitHub release assets.\n"
options : J.Json -> List String -> IO (Pair J.Json (List String))
options config args = case args of
  Cons "--locked" rest -> options (J.set "locked" (J.Boolean true) config) rest
  Cons "--offline" rest -> options (J.set "offline" (J.Boolean true) config) rest
  Cons option (Cons value rest) -> if S.elem eqString option (O.words "--manifest --build-dir --cache-dir --compiler --clang --pkg-config --runtime --gc-prefix --timeout --pgo-generate --pgo-target --pgo-use") then options (J.set (O.drop 2 option) (J.str value) config) rest else ioReturn (Pair config args)
  _ -> ioReturn (Pair config args)
selections : List String -> List String -> IO (List String)
selections acc args = case args of
  Nil -> do { O.require (S.length acc == S.length (S.nubBy eqString acc)) "duplicate target selection"; ioReturn acc }
  Cons "--target" (Cons name rest) -> selections (S.snoc acc name) rest
  _ -> O.fatal usage
configureCompiler : M.Package -> String -> J.Json -> IO J.Json
configureCompiler package buildDirectory config = do
  let requested = J.getText "compiler" "" config
  if S.not (eqString requested "") then ioReturn config else do
    let checkout = M.packageRoot package
    let candidates0 = if eqString (M.packageName package) "mlf-compiler" then
          Cons (buildDirectory ++ "/bin/emlf") (Cons (checkout ++ "/.mlf-build/bin/emlf") (Cons (checkout ++ "/.mlf-build/mlf-native/bin/emlf") Nil))
          else Nil
    candidates <- S.mapM O.executable candidates0
    available <- S.mapM (\path -> do { present <- fileExists path; ioReturn (if present then Just path else Nothing) }) candidates
    let selected = S.fromMaybe "emlf" (S.listToMaybe (S.catMaybes available))
    ioReturn (J.set "compiler" (J.str selected) config)
-- A source checkout can provide BDWGC without installing pkg-config metadata.
-- Explicit options and the environment take precedence over that installation.
configureGC : String -> J.Json -> IO J.Json
configureGC packageRoot config = do
  windows <- O.isWindows
  let requested = J.getText "gc-prefix" "" config
  selected <- if S.not (eqString requested "") then canonicalPath requested else do
    let dependencies = packageRoot ++ "/.mlf-build/deps"
    present <- directoryExists dependencies
    candidates <- if present then do
      names <- O.entries dependencies
      found <- S.mapM (\name -> do
        let prefix = dependencies ++ "/" ++ name
        library <- fileExists (prefix ++ (if windows then "/lib/libgc.dll.a" else "/lib/libgc.a"))
        directHeader <- fileExists (prefix ++ "/include/gc.h")
        nestedHeader <- fileExists (prefix ++ "/include/gc/gc.h")
        let header = directHeader || nestedHeader
        if library && header then do { path <- canonicalPath prefix; ioReturn (Just path) } else ioReturn Nothing)
        (S.filter (\name -> O.starts "bdwgc-" name && O.ends "-install" name) names)
      ioReturn (S.nubBy eqString (S.catMaybes found))
      else ioReturn Nil
    case candidates of
      Nil -> ioReturn ""
      Cons prefix Nil -> ioReturn prefix
      _ -> O.fatal "multiple local BDWGC installations; select one with --gc-prefix or MLF_GC_PREFIX"
  if eqString selected "" then ioReturn config else do
    -- Compiler test commands and nested package builds inherit the selection.
    setEnv "MLF_GC_PREFIX" selected
    ioReturn (J.set "gc-prefix" (J.str selected) config)
expand : List (Pair String String) -> String -> String
expand replacements text = S.foldl (\acc entry -> O.replace (S.fst entry) (S.snd entry) acc) text replacements
commandTest : B.Builder -> M.Package -> String -> J.Json -> IO J.Json
commandTest b p name target = do
  binaries <- S.mapM (\n -> do { Pair binary _ <- B.buildTarget b p n (J.get n (J.getObject "executables" (M.packageData p))) true; ioReturn (Pair ("{bin:" ++ n ++ "}") binary) }) (J.getStrings "requires" target)
  let requested = J.getStrings "command" target
  let replacements = S.append binaries (Cons (Pair "{root}" (M.packageRoot p)) (Cons (Pair "{build}" (B.directory b)) (Cons (Pair "{cache}" (B.cacheDirectory b)) Nil)))
  let argv = S.map (expand replacements) requested
  O.require (S.all (\arg -> S.all (\prefix -> eqString arg (O.replace prefix "" arg)) (O.words "{root {build {cache {bin:")) argv) "unresolved test placeholder"
  let log = B.directory b ++ "/tests/" ++ name ++ ".log"
  O.mkdir (O.parent log)
  code <- O.exec (M.packageRoot p) argv "" log log (readInt (J.getText "timeout" "1800" (B.config b)))
  hash <- fileDigest log
  B.record b "commands" (B.info (Cons (Pair "argv" (J.stringArray argv)) (Cons (Pair "cwd" (J.str (M.packageRoot p))) (Cons (Pair "exit_code" (J.num code)) (Cons (Pair "log" (J.str log)) (Cons (Pair "sha256" (J.str hash)) Nil))))))
  O.require (code == 0) ("test " ++ name ++ " failed (" ++ showInt code ++ "); see " ++ log)
  text <- readFile log
  putStr (O.drop (S.max 0 (stringLength text - 3000)) text)
  ioReturn (B.info (Cons (Pair "name" (J.str name)) (Cons (Pair "log" (J.str log)) (Cons (Pair "sha256" (J.str hash)) Nil))))
nativeTest : B.Builder -> M.Package -> String -> J.Json -> IO J.Json
nativeTest b p name target = do
  Pair binary artifact <- B.buildTarget b p ("test-" ++ name) target false
  let command = Cons (B.compiler b) (Cons "--run-crate" (Cons (artifact ++ "/unit.mlfci") (Cons "--" (J.getStrings "arguments" target))))
  let testDir = B.directory b ++ "/tests/" ++ name
  O.mkdir testDir
  writeFile (testDir ++ "/stdin") (J.getText "stdin" "" target)
  S.mapM_ (\entry -> do
    let backend = S.fst entry
    code <- O.exec artifact (S.snd entry) (testDir ++ "/stdin") (testDir ++ "/" ++ backend ++ ".stdout") (testDir ++ "/" ++ backend ++ ".stderr") (readInt (J.getText "timeout" "1800" (B.config b)))
    out <- readFile (testDir ++ "/" ++ backend ++ ".stdout")
    err <- readFile (testDir ++ "/" ++ backend ++ ".stderr")
    O.require (code == 0) ("test " ++ name ++ " (" ++ backend ++ ") exited " ++ showInt code)
    O.require (eqString out (J.getText "stdout" "" target)) ("test " ++ name ++ " (" ++ backend ++ "): unexpected stdout " ++ J.quote out)
    O.require (eqString err "") ("test " ++ name ++ " (" ++ backend ++ "): unexpected stderr " ++ J.quote err)) (Cons (Pair "interpreter" command) (Cons (Pair "llvm" (Cons binary (J.getStrings "arguments" target))) Nil))
  hash <- fileDigest (testDir ++ "/llvm.stdout")
  ioReturn (B.info (Cons (Pair "name" (J.str name)) (Cons (Pair "backends" (J.stringArray (O.words "interpreter llvm"))) (Cons (Pair "stdout_sha256" (J.str hash)) Nil))))
runTests : B.Builder -> M.Package -> List String -> IO Unit
runTests b p names = S.mapM_ (\name -> do
  putStrLn ("Testing " ++ name)
  let target = J.get name (J.getObject "tests" (M.packageData p))
  row <- if J.has "command" target then commandTest b p name target else nativeTest b p name target
  B.record b "tests" (J.set "passed" (J.Boolean true) row)) names
run : List String -> IO Unit
run args = do
  O.setupWindows
  compiler <- getEnv "MLF_COMPILER"
  defaultClang <- O.envDefault "MLF_CLANG" "clang"
  clang <- O.envDefault "CC" defaultClang
  gc <- getEnv "MLF_GC_PREFIX"
  Pair config command <- options (B.info (Cons (Pair "compiler" (J.str compiler)) (Cons (Pair "clang" (J.str clang)) (Cons (Pair "gc-prefix" (J.str gc)) Nil)))) args
  case command of
    Cons "--help" Nil -> putStr usage
    Cons "pack" (Cons directory (Cons output Nil)) -> do
      pins <- Distribution.pack directory output
      putStrLn (J.render pins)
    Cons action rest -> do
      O.require (S.elem eqString action (O.words "plan lock build test run release")) usage
      let manifest = J.getText "manifest" "mlf-package.json" config
      path <- canonicalPath manifest
      let packageDir = O.parent path
      let buildDir = J.getText "build-dir" (packageDir ++ "/.mlf-build") config
      let building = S.elem eqString action (O.words "build test run release")
      if building then O.mkdir buildDir else ioReturn Unit
      dir <- if building then canonicalPath buildDir else ioReturn buildDir
      lock <- if building then acquireFileLock (dir ++ "/.lock") else ioReturn (0 - 1)
      if building then J.write (dir ++ "/build-report.json") (B.obj2 "complete" (J.Boolean false) "implementation" (J.str "MLF")) else ioReturn Unit
      graph <- M.loadWith path (J.set "cache-dir" (J.getOr "cache-dir" (J.str (dir ++ "/cache")) config) config)
      snapshot <- M.snapshot graph
      let p = M.rootPackage graph
      let lockPath = M.packageRoot p ++ "/mlf.lock"
      if J.getBool "locked" false config then do { saved <- J.read lockPath; O.require (J.equal saved snapshot) "mlf.lock is stale; review local changes and run mlfpkg lock" } else ioReturn Unit
      if eqString action "plan" then do
        O.require (S.null rest) usage
        crates <- M.cratePlan graph
        putStrLn (J.render (J.set "crates" crates (J.set "modules" (J.stringArray (S.map M.moduleName (M.modules graph))) (J.set "executables" (J.stringArray (M.keys (J.getObject "executables" (M.packageData p)))) (J.set "tests" (J.stringArray (M.keys (J.getObject "tests" (M.packageData p)))) snapshot)))))
      else if eqString action "lock" then do { O.require (S.null rest) usage; J.write lockPath snapshot; putStrLn lockPath }
      else if eqString action "release" then case rest of
        Cons destination Nil -> do
          compilerSettings <- configureCompiler p dir config
          settings <- configureGC (M.packageRoot p) compilerSettings
          b <- B.create graph settings dir
          B.releasePackage b destination
          B.finish b
          releaseFileLock lock
          putStrLn ("release passed: " ++ destination)
        _ -> O.fatal usage
      else do
        let targets = J.getObject (if eqString action "test" then "tests" else "executables") (M.packageData p)
        selected <- if eqString action "run" then case rest of { Cons name _ -> ioReturn (Cons name Nil); Nil -> O.fatal usage } else selections Nil rest
        let names = if S.null selected then M.keys targets else selected
        O.require (S.all (\name -> J.has name targets) names) ("unknown target; available: " ++ S.intercalate ", " (M.keys targets))
        O.require (S.not (S.null names) || (eqString action "build" && S.not (S.null (M.packageModules p)))) "no targets selected"
        compilerSettings <- configureCompiler p dir config
        settings <- configureGC (M.packageRoot p) compilerSettings
        b <- B.create graph settings dir
        if eqString action "test" then runTests b p names else if S.null names then do { ignored <- B.libraries b false; ioReturn Unit } else
          S.mapM_ (\name -> do { Pair binary _ <- B.buildTarget b p name (J.get name targets) true; if eqString action "run" then ioReturn Unit else putStrLn binary }) names
        B.finish b
        releaseFileLock lock
        if eqString action "run" then case rest of
          Cons name arguments -> do
            let forwarded = case arguments of { Cons "--" tail -> tail; _ -> arguments }
            code <- O.exec (M.packageRoot p) (Cons (B.executable b (dir ++ "/bin/" ++ name)) forwarded) "" "" "" (readInt (J.getText "timeout" "1800" config))
            exitWith code
          Nil -> O.fatal usage
        else putStrLn (action ++ " passed; report: " ++ dir ++ "/build-report.json")
    Nil -> O.fatal usage
