-- Native contracts shared by the package test and release evidence gates.
module Package.Verification where
import Bootstrap.Types
import qualified Bootstrap.Std as S
import qualified Package.Json as J
import qualified Package.OS as O
ensure : Bool -> String -> Either String Unit
ensure ok reason = if ok then Right Unit else Left reason
integer : Int -> J.Json -> Int
integer fallback value = case value of { J.Number text -> readInt text; _ -> fallback }
int : String -> J.Json -> Int
int key doc = integer 0 (J.get key doc)
text : String -> J.Json -> String
text key doc = case J.get key doc of { J.String value -> value; _ -> "" }
array : String -> J.Json -> List J.Json
array key doc = J.values (J.get key doc)
contains : String -> String -> Bool
contains needle value = eqString needle "" || S.not (eqString value (O.replace needle "" value))
number : J.Json -> Maybe Double
number value = case value of
 J.Number literal -> case J.parse literal of
  Right (J.Number parsed) -> Just (readDouble parsed)
  _ -> Nothing
 _ -> Nothing
double : Double -> J.Json -> Double
double fallback value = S.fromMaybe fallback (number value)
finite : Double -> Bool
finite n = eqDouble n n && ltDouble (subDouble n n) 1.0
positive : Double -> Bool
positive n = finite n && ltDouble 0.0 n
sameKeys : List String -> J.Json -> Bool
sameKeys expected value = S.eqList eqString (S.sortBy compareString expected) (S.sortBy compareString (S.map S.fst (J.items value)))
workloads = O.words "binary-trees pidigits n-body fannkuch-redux spectral-norm fasta mandelbrot reverse-complement k-nucleotide"
languages = O.words "c rust haskell mlf"
limit : String -> Double
limit dimension = if eqString dimension "compilation" then 5.0 else 2.0
compareDouble : Double -> Double -> Int
compareDouble a b = if ltDouble a b then -1 else if ltDouble b a then 1 else 0
median : List Double -> Double
median times = let sorted = S.sortBy compareDouble times in let n = S.length sorted in
 if remInt n 2 == 1 then S.index sorted (quotInt n 2) else divDouble (addDouble (S.index sorted (quotInt n 2 - 1)) (S.index sorted (quotInt n 2))) 2.0
measurement : J.Json -> Either String Unit
measurement value = do
 let samples = array "samples" value
 ensure (int "sample_count" value == 5 && S.length samples == 5) "Missing benchmark samples"
 let values = S.map (\row -> number (J.get "wall_seconds" row)) samples
 ensure (S.all S.isJust values) "Invalid benchmark timing"
 let times = S.catMaybes values
 ensure (S.all positive times && eqDouble (double (-1.0) (J.get "median_wall_seconds" value)) (median times)) "Invalid or inconsistent benchmark timing"
 return Unit
matrixSummary : String -> String -> Either String J.Json
matrixSummary log candidate = do
 let lines = O.nonempty (O.lines log)
 let selected = S.filter (O.starts "Module CLI compiler: ") lines
 let rows = S.filter (O.starts "Backend matrix: ") lines
 let fixtures = S.filter (\line -> contains " shared IO/prelude/backend fixtures; " line) lines
 ensure (S.length selected == 1 && eqString (S.head selected) ("Module CLI compiler: " ++ candidate)) "matrix did not use selected CLI compiler"
 ensure (S.length rows == 1 && S.length fixtures == 1) "missing or duplicate matrix evidence"
 let rowWords = O.words (S.head rows)
 let fixtureWords = O.words (S.head fixtures)
 ensure (S.length rowWords == 10 && readInt (S.index rowWords 2) > 0 && O.ends "rows x 2 backends; no missing executions" (S.head rows)) "invalid backend coverage audit"
 ensure (S.length fixtureWords == 6 && readInt (S.head fixtureWords) > 0 && O.ends "fixtures; 0 failures" (S.head fixtures)) "failed or empty fixture matrix"
 return (J.Object (Cons (Pair "rows" (J.num (readInt (S.index rowWords 2)))) (Cons (Pair "fixtures" (J.num (readInt (S.head fixtureWords)))) (Cons (Pair "cli_compiler" (J.str candidate)) Nil))))
quote : String -> String
quote value = "'" ++ O.replace "'" "'\\''" value ++ "'"
cleanEnvironment : List String -> List String
cleanEnvironment names = S.filter (\name -> S.not (S.any (\prefix -> O.starts prefix name) (O.words "MLF_BOOTSTRAP_ MLF_LLVM_TEST_ MLF_TEST_ GC_"))) names
matrixCollectionDivisor : String -> Either String String
matrixCollectionDivisor requested =
 let value = if eqString requested "" then "1" else requested in
 if S.elem eqString value (O.words "1 2 4") then Right value
 else Left "matrix GC free-space divisor must be 1, 2 or 4"
matrixEnvironment : J.Json -> String -> String -> String -> String -> J.Json -> Either String J.Json
matrixEnvironment inherited drivers seed candidate abi collector = do
 ensure (eqString abi "standard" || eqString abi "compact-gc") "unknown native ABI"
 ensure (eqString abi "standard" || J.has "libs" collector && J.has "cflags" collector) "compact matrix requires collector"
 divisor <- matrixCollectionDivisor (text "MLF_TEST_MATRIX_GC_DIVISOR" inherited)
 let clean = J.Object (S.filter (\entry -> S.not (S.any (\prefix -> O.starts prefix (S.fst entry)) (O.words "MLF_BOOTSTRAP_ MLF_LLVM_TEST_ MLF_TEST_ GC_"))) (J.items inherited))
 let common = J.set "MLF_BOOTSTRAP_COMPILER" (J.str candidate) (J.set "MLF_BOOTSTRAP_INTERPRETER" (J.str (drivers ++ "/RuntimeDriver")) (J.set "MLF_BOOTSTRAP_LLVM" (J.str (drivers ++ "/LLVMDriver")) (J.set "MLF_LLVM_TEST_ABI" (J.str abi) (J.set "GC_INITIAL_HEAP_SIZE" (J.str (if eqString abi "compact-gc" then "8388608" else "536870912")) (J.set "GC_FREE_SPACE_DIVISOR" (J.str divisor) clean)))))
 return (if eqString abi "standard" then common else J.set "MLF_LLVM_TEST_CFLAGS" (J.str (S.intercalate " " (S.map quote (J.getStrings "cflags" collector)))) (J.set "MLF_LLVM_TEST_LIBS" (J.str (S.intercalate " " (S.map quote (J.getStrings "libs" collector)))) common))
layoutPlan : List String -> List String
layoutPlan layouts = S.append (O.words "RuntimeDriver LLVMDriver") (S.map (\abi -> "matrix:" ++ abi) layouts)
validateManifest : List J.Json -> Either String Unit
validateManifest rows = do
 ensure (S.length (S.nubBy eqString (S.map (text "id") rows)) == S.length rows) "duplicate corpus identity"
 ensure (S.all (\row -> int "schema_version" row == 1) rows) "unsupported corpus schema"
 S.mapM_ (\(Pair group minimum) -> ensure (S.length (S.filter (\row -> eqString (text "category" row) group) rows) >= minimum) ("corpus lacks " ++ group))
  (Cons (Pair "figure12" 43) (Cons (Pair "hm-exhaustive" 1712) (Cons (Pair "hm-generated" 5000) (Cons (Pair "annotations" 126) (Cons (Pair "readability" 18) (Cons (Pair "state" 97) (Cons (Pair "modules" 60) (Cons (Pair "examples" 18) (Cons (Pair "benchmarks" 9) Nil)))))))))
 let a8 = S.find (\row -> eqString (text "id" row) "figure12-A8") rows
 ensure (S.maybe false (\row -> S.not (J.getBool "expected_accept" true row) && eqString (text "expected_phase" row) "Inference") a8) "A8 expectation changed"
 let modules = S.filter (\row -> eqString (text "category" row) "modules") rows
 ensure (S.length (S.filter (J.getBool "expected_accept" false) modules) >= 21 && S.length (S.filter (\row -> S.not (J.getBool "expected_accept" true row)) modules) >= 39 && S.any (\row -> J.getBool "expected_accept" false row && J.getBool "no_prelude" false row) modules) "module corpus lacks coverage"
 ensure (S.all (\row -> J.getBool "expected_accept" false row || stringLength (text "expected_phase" row) > 0 && stringLength (O.trim (text "expected_error_contains" row)) > 0) modules) "module rejection lacks expectation"
 return Unit
checkRejection : J.Json -> Int -> String -> String -> Either String Unit
checkRejection row code output errors = do
 ensure (code == 1 && eqString output "") "crash or partial target is not a rejection"
 let phase = text "expected_phase" row
 let reason = text "expected_error_contains" row
 ensure (eqString phase "" || O.starts (phase ++ ":") errors) "wrong rejection phase"
 ensure (eqString reason "" || contains reason errors) "wrong rejection diagnostic"
 return Unit
validateEvidence : J.Json -> J.Json -> J.Json -> String -> J.Json -> Either String Unit
validateEvidence bootstrap backends benchmark compilerHash manifest = do
 ensure (J.getBool "complete" false bootstrap && J.getBool "fixed_point" false bootstrap) "Bootstrap is incomplete or has no fixed point"
 let stages = array "stages" bootstrap
 ensure (S.eqList eqInt (S.map (int "stage") stages) (Cons 1 (Cons 2 (Cons 3 Nil)))) "Bootstrap must contain all three stages"
 ensure (S.all (\stage -> J.equal (J.get "reused_seed_compilation" stage) (J.Boolean false)) stages) "Release requires fresh stages"
 ensure (eqString (text "llvm_sha256" (S.index stages 1)) (text "llvm_sha256" (S.index stages 2))) "Stage 2/3 LLVM differs"
 let candidate = J.get "candidate" bootstrap
 let path = text "path" candidate
 ensure (int "stage" candidate == 3 && eqString (text "sha256" candidate) compilerHash && eqString (text "binary_sha256" (S.index stages 2)) compilerHash) "candidate must be verified stage 3 binary"
 let parity = J.get "parity" bootstrap
 ensure (eqString (text "compiler" parity) path && eqString (text "compiler_sha256" parity) compilerHash) "Parity did not use release candidate"
 ensure (int "cases" parity >= 7083 && int "accepted" parity >= 3199 && int "rejected" parity >= 3884 && int "runtime_rows" parity >= 80 && int "runtime_executions" parity == 2 * int "runtime_rows" parity) "Incomplete parity coverage"
 ensure (J.getBool "complete" false backends && eqString (text "compiler_sha256" backends) compilerHash && eqString (text "compiler" backends) path) "Native matrices used different compiler"
 let matrices = J.get "matrices" backends
 ensure (sameKeys (O.words "standard compact-gc") matrices) "Both native layouts must pass"
 S.mapM_ (\(Pair abi matrix) -> ensure (int "rows" matrix >= 475 && int "fixtures" matrix >= 428 && int "backends" matrix == 2 && eqString (text "cli_compiler" matrix) path && eqString (text "MLF_LLVM_TEST_ABI" (J.get "environment" matrix)) abi) "Incomplete or misdirected native matrix") (J.items matrices)
 let tool = J.get "emlf" (J.get "toolchain" benchmark)
 ensure (eqString (text "status" benchmark) "passed" && eqString (text "sha256" tool) compilerHash && eqString (text "path" tool) path) "Benchmark did not validate candidate"
 let config = J.get "configuration" benchmark
 let limits = J.get "maximum_mlf_c_ratios" config
 ensure (int "runs" config == 5 && sameKeys (O.words "compilation runtime") limits && eqDouble (double 0.0 (J.get "compilation" limits)) 5.0 && eqDouble (double 0.0 (J.get "runtime" limits)) 2.0 && J.equal (J.get "size_override" config) J.Null && S.not (J.getBool "compile_only" false config || J.getBool "runtime_only" false config)) "Wrong release benchmark configuration"
 let expected = array "workloads" manifest
 ensure (S.eqList eqString (S.sortBy compareString (S.map (text "name") expected)) (S.sortBy compareString workloads)) "Unexpected benchmark manifest"
 let results = array "results" benchmark
 ensure (S.eqList eqString (S.sortBy compareString (S.map (text "benchmark") results)) (S.sortBy compareString workloads)) "must cover all nine workloads"
 let checks = array "performance_checks" benchmark
 let identities = S.map (\row -> text "benchmark" row ++ ":" ++ text "dimension" row) checks
 let wanted = S.concatMap (\name -> S.map (\dimension -> name ++ ":" ++ dimension) (O.words "compilation runtime")) workloads
 ensure (S.eqList eqString (S.sortBy compareString identities) (S.sortBy compareString wanted)) "Missing or duplicate performance checks"
 S.mapM_ (\row -> do
  let name = text "benchmark" row
  let workload = S.fromMaybe (panic "missing workload") (S.find (\w -> eqString (text "name" w) name) expected)
  let inputs = S.sortBy S.compareInt (S.nubBy eqInt (Cons (int "default_input" workload) (S.map (integer 0) (array "check_inputs" workload))))
  ensure (int "input" row == int "default_input" workload && J.equal (J.get "correctness_inputs" row) (J.Array (S.map J.num inputs))) "Benchmark inputs changed"
  let entries = J.get "languages" row
  ensure (sameKeys languages entries) "must compare all four languages"
  S.mapM_ (\entry -> do
   let correctness = array "correctness" entry
   ensure (S.length correctness == S.length inputs && S.not (S.null correctness) && S.all (\check -> stringLength (text "output_sha256" check) == 64) correctness) "Missing correctness evidence"
   S.mapM_ (\dimension -> measurement (J.get dimension entry)) (O.words "compilation runtime")) (S.map S.snd (J.items entries))
  S.mapM_ (\dimension -> do
   let ratio = divDouble (double 0.0 (J.get "median_wall_seconds" (J.get dimension (J.get "mlf" entries)))) (double 0.0 (J.get "median_wall_seconds" (J.get dimension (J.get "c" entries))))
   let check = S.fromMaybe (panic "missing check") (S.find (\check -> eqString name (text "benchmark" check) && eqString dimension (text "dimension" check)) checks)
   ensure (J.getBool "passed" false check && eqDouble (double 0.0 (J.get "maximum_ratio" check)) (limit dimension) && eqDouble (double 0.0 (J.get "mlf_over_c" check)) ratio && positive ratio && S.not (ltDouble (limit dimension) ratio)) "Failed or inconsistent performance limit") (O.words "compilation runtime")) results
 return Unit

update : List String -> (J.Json -> J.Json) -> J.Json -> J.Json
update path change doc = case path of
 Nil -> change doc
 Cons key rest -> J.set key (update rest change (J.get key doc)) doc
remove key doc = J.Object (S.filter (\entry -> S.not (eqString key (S.fst entry))) (J.items doc))
packageFiles : String -> IO J.Json
packageFiles directory = do
 paths <- O.files directory
 pairs <- S.mapM (\path -> do { hash <- fileDigest path; return (Pair (O.relative directory path) (J.str hash)) }) paths
 return (J.Object pairs)
verify : String -> IO (Either String J.Json)
verify directory = do
 report <- J.read (directory ++ "/verification.json")
 if S.not (int "schema_version" report == 1) || S.not (J.getBool "complete" false report) then return (Left "incomplete release") else do
  let package = directory ++ "/package"
  current <- packageFiles package
  if S.not (J.equal current (J.get "package_files" report)) then return (Left "package files changed") else do
   compilerHash <- fileDigest (package ++ "/emlf")
   host <- hostIdentity directory
   executable <- S.mapM (\name -> do { code <- O.exec "" (Cons "/bin/test" (Cons "-x" (Cons (package ++ "/" ++ name) Nil))) "" "" "" 60; return (code == 0) }) (O.words "emlf emlf-compile")
   let smoke = J.get "smoke" report
   let steps = array "steps" report
   let checks = ensure (J.equal host (J.get "host" report)) "release was built for different operating system or architecture"
   case checks of
    Left error -> return (Left error)
    Right _ -> if S.not (eqString compilerHash (text "compiler_sha256" report) && S.all S.id executable && J.equal (J.get "backends" smoke) (J.stringArray (O.words "interpreter llvm")) && J.getBool "outside_checkout" false smoke && S.eqList eqString (S.map (text "name") steps) (O.words "mlf-tests bootstrap backends benchmarks") && S.all (\row -> int "exit_code" row == 0) steps) then return (Left "missing successful native validation evidence") else do
     logHash <- fileDigest (package ++ "/evidence/mlf-tests.log")
     if S.not (eqString logHash (text "log_sha256" (S.head steps))) then return (Left "native test evidence changed") else do
      bootstrap <- J.read (package ++ "/evidence/bootstrap.json")
      backends <- J.read (package ++ "/evidence/backends.json")
      benchmark <- J.read (package ++ "/evidence/benchmarks.json")
      manifest <- J.read (package ++ "/evidence/manifest.json")
      runtime <- S.mapM (\(Pair path expected) -> do { hash <- fileDigest (package ++ "/" ++ path); return (eqString hash (case expected of { J.String value -> value; _ -> "" })) }) (J.items (J.get "runtime_sources" bootstrap))
      return (S.mapEither (\_ -> report) (do { ensure (S.all S.id runtime) "packaged runtime differs from verified runtime"; validateEvidence bootstrap backends benchmark compilerHash manifest }))
hostIdentity : String -> IO J.Json
hostIdentity directory = do
 system <- hostValue directory "-s"
 machine <- hostValue directory "-m"
 return (J.Object (Cons (Pair "system" (J.str system)) (Cons (Pair "machine" (J.str machine)) Nil)))
hostValue : String -> String -> IO String
hostValue directory arg = do
 code <- O.exec "" (Cons "/usr/bin/uname" (Cons arg Nil)) "" (directory ++ "/host.out") (directory ++ "/host.err") 60
 O.require (code == 0) "host identity unavailable"
 value <- readFile (directory ++ "/host.out")
 return (O.trim value)
-- Native contracts shared by the package test and release evidence gates.

step : String -> J.Json -> String -> List String -> IO (Either String J.Json)
step directory report name argv = do
 let log = directory ++ "/" ++ name ++ ".log"
 let errors = log ++ ".stderr"
 -- The tested gate receives no compiler, backend, failure, or collector overrides.
 host <- getEnv "MLF_TEST_HOST_SUPPORT"
 O.require (stringLength host > 0) "missing native environment transport"
 code <- O.exec "" (Cons host (Cons "env-names" Nil)) "" (directory ++ "/environment-names") (directory ++ "/environment-names.err") 60
 O.require (code == 0) "environment name transport failed"
 names <- readFile (directory ++ "/environment-names")
 let selected = S.filter (\key -> S.not (S.elem eqString key (cleanEnvironment (Cons key Nil)))) (O.words names)
 before <- S.mapM (\key -> do { value <- getEnv key; unsetEnv key; return (Pair key value) }) selected
 code <- O.exec "" argv "" log errors 1800
 S.mapM_ (\(Pair key value) -> if eqString value "" then unsetEnv key else setEnv key value) before
 err <- readFile errors
 output <- readFile log
 writeFile log (output ++ err)
 hash <- fileDigest log
 let entry = J.Object (Cons (Pair "name" (J.str name)) (Cons (Pair "exit_code" (J.num code)) (Cons (Pair "log_sha256" (J.str hash)) Nil)))
 let saved = J.set "complete" (J.Boolean false) (J.set "steps" (J.Array (S.snoc (array "steps" report) entry)) report)
 J.write (directory ++ "/verification.json") saved
 return (if code == 0 then Right saved else Left (name ++ " failed (" ++ showInt code ++ ")"))
installWithSmoke : String -> String -> (String -> IO Unit) -> IO (Either String Unit)
installWithSmoke directory prefix smoke = do
 checked <- verify directory
 case checked of
  Left error -> return (Left error)
  Right report -> do
   let hash = text "compiler_sha256" report
   let destination = prefix ++ "/lib/mlf/" ++ hash
   let bin = prefix ++ "/bin"
   conflicts <- S.mapM (\name -> do
    let path = bin ++ "/" ++ name
    present <- fileExists path
    if present then do
     actual <- canonicalPath path
     return (S.not (eqString actual (destination ++ "/" ++ name)))
     else return false) (O.words "emlf emlf-compile")
   if S.any S.id conflicts then return (Left "unrelated installed file") else do
    O.mkdir (O.parent destination)
    present <- directoryExists destination
    if present then return Unit else O.run "" (Cons "/bin/cp" (Cons "-R" (Cons (directory ++ "/package") (Cons destination Nil))))
    O.mkdir bin
    S.mapM_ (\name -> O.run "" (Cons "/bin/ln" (Cons "-sf" (Cons ("../lib/mlf/" ++ hash ++ "/" ++ name) (Cons (bin ++ "/" ++ name) Nil))))) (O.words "emlf emlf-compile")
    smoke destination
    return (Right Unit)
