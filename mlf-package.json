{
  "format": 1,
  "name": "mlf-compiler",
  "version": "0.3.0",
  "dependencies": {
    "mlf-crates": {
      "path": "libraries/mlf-crates"
    },
    "mlf-developer-tools": {
      "path": "libraries/mlf-developer-tools"
    },
    "mlf-foundation": {
      "path": "libraries/mlf-foundation"
    },
    "mlf-inference": {
      "path": "libraries/mlf-inference"
    },
    "mlf-interpreter": {
      "path": "libraries/mlf-interpreter"
    },
    "mlf-llvm": {
      "path": "libraries/mlf-llvm"
    },
    "mlf-package-core": {
      "path": "libraries/mlf-package-core"
    },
    "mlf-xmlf": {
      "path": "libraries/mlf-xmlf"
    }
  },
  "executables": {
    "emlf": {
      "main": "bootstrap/Main.emlf",
      "profile": "compiler",
      "dependencies": [
        "mlf-crates",
        "mlf-foundation",
        "mlf-inference",
        "mlf-interpreter",
        "mlf-llvm",
        "mlf-xmlf"
      ]
    },
    "mlfpkg": {
      "main": "package/Main.emlf",
      "profile": "compiler",
      "dependencies": [
        "mlf-developer-tools",
        "mlf-foundation",
        "mlf-package-core"
      ]
    }
  },
  "tests": {
    "unit": {
      "requires": [
        "emlf",
        "mlfpkg"
      ],
      "command": [
        "{bin:mlfpkg}",
        "compiler-test",
        "unit",
        "--compiler",
        "{bin:emlf}",
        "--build-dir",
        "{build}/compiler-tests/unit",
        "--cache-dir",
        "{cache}"
      ]
    },
    "packages": {
      "requires": [
        "emlf",
        "mlfpkg"
      ],
      "command": [
        "{bin:mlfpkg}",
        "compiler-test",
        "packages",
        "--compiler",
        "{bin:emlf}",
        "--build-dir",
        "{build}/compiler-tests/packages",
        "--cache-dir",
        "{cache}"
      ]
    },
    "self-host": {
      "requires": [
        "emlf",
        "mlfpkg"
      ],
      "command": [
        "{bin:mlfpkg}",
        "compiler-test",
        "self-host",
        "--compiler",
        "{bin:emlf}",
        "--build-dir",
        "{build}/compiler-tests/self-host",
        "--cache-dir",
        "{cache}"
      ]
    },
    "parity": {
      "requires": [
        "emlf",
        "mlfpkg"
      ],
      "command": [
        "{bin:mlfpkg}",
        "compiler-test",
        "parity",
        "--compiler",
        "{bin:emlf}",
        "--build-dir",
        "{build}/compiler-tests/parity",
        "--cache-dir",
        "{cache}"
      ]
    },
    "backends": {
      "requires": [
        "emlf",
        "mlfpkg"
      ],
      "command": [
        "{bin:mlfpkg}",
        "compiler-test",
        "backends",
        "--compiler",
        "{bin:emlf}",
        "--build-dir",
        "{build}/compiler-tests/backends",
        "--cache-dir",
        "{cache}"
      ]
    },
    "port": {
      "requires": [
        "emlf",
        "mlfpkg"
      ],
      "command": [
        "{bin:mlfpkg}",
        "compiler-test",
        "port",
        "--compiler",
        "{bin:emlf}",
        "--build-dir",
        "{build}/compiler-tests/port",
        "--cache-dir",
        "{cache}"
      ]
    }
  }
}
