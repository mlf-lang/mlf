{
  "format": 1,
  "name": "mlf-compiler",
  "version": "0.3.0",
  "dependencies": {
    "mlf-bootstrap": {
      "path": "bootstrap"
    },
    "mlf-package-tools": {
      "path": "package"
    }
  },
  "executables": {
    "emlf": {
      "main": "bootstrap/Main.emlf",
      "profile": "compiler"
    },
    "mlfpkg": {
      "main": "package/Main.emlf",
      "profile": "compiler"
    }
  },
  "tests": {
    "unit": {
      "requires": [
        "emlf",
        "mlfpkg"
      ],
      "command": [
        "{bin:mlfpkg}",
        "compiler-test",
        "unit",
        "--compiler",
        "{bin:emlf}",
        "--build-dir",
        "{build}/compiler-tests/unit",
        "--cache-dir",
        "{cache}"
      ]
    },
    "packages": {
      "requires": [
        "emlf",
        "mlfpkg"
      ],
      "command": [
        "{bin:mlfpkg}",
        "compiler-test",
        "packages",
        "--compiler",
        "{bin:emlf}",
        "--build-dir",
        "{build}/compiler-tests/packages",
        "--cache-dir",
        "{cache}"
      ]
    },
    "self-host": {
      "requires": [
        "emlf",
        "mlfpkg"
      ],
      "command": [
        "{bin:mlfpkg}",
        "compiler-test",
        "self-host",
        "--compiler",
        "{bin:emlf}",
        "--build-dir",
        "{build}/compiler-tests/self-host",
        "--cache-dir",
        "{cache}"
      ]
    },
    "parity": {
      "requires": [
        "emlf",
        "mlfpkg"
      ],
      "command": [
        "{bin:mlfpkg}",
        "compiler-test",
        "parity",
        "--compiler",
        "{bin:emlf}",
        "--build-dir",
        "{build}/compiler-tests/parity",
        "--cache-dir",
        "{cache}"
      ]
    },
    "backends": {
      "requires": [
        "emlf",
        "mlfpkg"
      ],
      "command": [
        "{bin:mlfpkg}",
        "compiler-test",
        "backends",
        "--compiler",
        "{bin:emlf}",
        "--build-dir",
        "{build}/compiler-tests/backends",
        "--cache-dir",
        "{cache}"
      ]
    },
    "port": {
      "requires": [
        "emlf",
        "mlfpkg"
      ],
      "command": [
        "{bin:mlfpkg}",
        "compiler-test",
        "port",
        "--compiler",
        "{bin:emlf}",
        "--build-dir",
        "{build}/compiler-tests/port",
        "--cache-dir",
        "{cache}"
      ]
    }
  }
}
