{
  "format": 1,
  "name": "mlf-compiler",
  "version": "0.3.0",
  "dependencies": {
    "mlf-crates": {
      "path": "libraries/mlf-crates"
    },
    "mlf-developer-tools": {
      "path": "libraries/mlf-developer-tools"
    },
    "mlf-foundation": {
      "path": "libraries/mlf-foundation"
    },
    "mlf-frontend": {
      "path": "libraries/mlf-frontend"
    },
    "mlf-inference": {
      "path": "libraries/mlf-inference"
    },
    "mlf-interpreter": {
      "path": "libraries/mlf-interpreter"
    },
    "mlf-language-core": {
      "path": "libraries/mlf-language-core"
    },
    "mlf-llvm": {
      "path": "libraries/mlf-llvm"
    },
    "mlf-package-core": {
      "path": "libraries/mlf-package-core"
    },
    "mlf-xmlf": {
      "path": "libraries/mlf-xmlf"
    }
  },
  "executables": {
    "tuple-list": {
      "main": "tests/MLF/Entry/TupleList.hs",
      "profile": "compiler",
      "modules": {
        "Tests.IndependentCheck": "tests/Tests/IndependentCheck.hs",
        "Tests.IndependentType": "tests/Tests/IndependentType.hs"
      },
      "dependencies": [
        "mlf-crates",
        "mlf-foundation",
        "mlf-frontend",
        "mlf-inference",
        "mlf-interpreter",
        "mlf-language-core",
        "mlf-xmlf"
      ],
      "source-syntax": "shared-haskell-v1"
    },
    "emlf": {
      "main": "bootstrap/MLF/Entry/Emlf.hs",
      "profile": "compiler",
      "dependencies": [
        "mlf-crates",
        "mlf-foundation",
        "mlf-frontend",
        "mlf-inference",
        "mlf-interpreter",
        "mlf-llvm",
        "mlf-xmlf"
      ],
      "source-syntax": "shared-haskell-v1"
    },
    "mlfpkg": {
      "main": "package/MLF/Entry/Mlfpkg.hs",
      "profile": "compiler",
      "dependencies": [
        "mlf-foundation",
        "mlf-package-core"
      ],
      "source-syntax": "shared-haskell-v1"
    },
    "compiler-tests": {
      "main": "tests/MLF/Entry/CompilerTests.hs",
      "profile": "compiler",
      "modules": {
        "Tests.CompilerTests": "tests/Tests/CompilerTests.hs",
        "Tests.CorePartitions": "tests/Tests/CorePartitions.hs",
        "Tests.Coverage": "tests/Tests/Coverage.hs",
        "Tests.TestDrivers": "tests/Tests/TestDrivers.hs",
        "Tests.TestSources": "tests/Tests/TestSources.hs",
        "Tests.Catalog": "tests/Tests/Catalog.hs",
        "Tests.Selection": "tests/Tests/Selection.hs",
        "Tests.BuildReceipts": "tests/Tests/BuildReceipts.hs"
      },
      "dependencies": [
        "mlf-developer-tools",
        "mlf-foundation",
        "mlf-frontend",
        "mlf-package-core"
      ],
      "source-syntax": "shared-haskell-v1"
    }
  },
  "tests": {
    "tuple-list": {
      "requires": [
        "tuple-list"
      ],
      "command": [
        "{bin:tuple-list}"
      ]
    },
    "tuple-list-native": {
      "requires": [
        "emlf"
      ],
      "command": [
        "bash",
        "{root}/tools/release/test-tuple-list.sh",
        "{bin:emlf}",
        "{build}/tuple-list-runtime"
      ]
    },
    "unit": {
      "requires": [
        "emlf",
        "mlfpkg",
        "compiler-tests"
      ],
      "command": [
        "{bin:compiler-tests}",
        "unit",
        "--manager",
        "{bin:mlfpkg}",
        "--compiler",
        "{bin:emlf}",
        "--build-dir",
        "{build}/compiler-tests/unit",
        "--cache-dir",
        "{cache}"
      ]
    },
    "packages": {
      "requires": [
        "emlf",
        "mlfpkg",
        "compiler-tests"
      ],
      "command": [
        "{bin:compiler-tests}",
        "packages",
        "--manager",
        "{bin:mlfpkg}",
        "--compiler",
        "{bin:emlf}",
        "--build-dir",
        "{build}/compiler-tests/packages",
        "--cache-dir",
        "{cache}"
      ]
    },
    "self-host": {
      "requires": [
        "emlf",
        "mlfpkg",
        "compiler-tests"
      ],
      "command": [
        "{bin:compiler-tests}",
        "self-host",
        "--manager",
        "{bin:mlfpkg}",
        "--compiler",
        "{bin:emlf}",
        "--build-dir",
        "{build}/compiler-tests/self-host",
        "--cache-dir",
        "{cache}"
      ]
    },
    "parity": {
      "requires": [
        "emlf",
        "mlfpkg",
        "compiler-tests"
      ],
      "command": [
        "{bin:compiler-tests}",
        "parity",
        "--manager",
        "{bin:mlfpkg}",
        "--compiler",
        "{bin:emlf}",
        "--build-dir",
        "{build}/compiler-tests/parity",
        "--cache-dir",
        "{cache}"
      ]
    },
    "backends": {
      "requires": [
        "emlf",
        "mlfpkg",
        "compiler-tests"
      ],
      "command": [
        "{bin:compiler-tests}",
        "backends",
        "--manager",
        "{bin:mlfpkg}",
        "--compiler",
        "{bin:emlf}",
        "--build-dir",
        "{build}/compiler-tests/backends",
        "--cache-dir",
        "{cache}"
      ]
    },
    "port": {
      "requires": [
        "emlf",
        "mlfpkg",
        "compiler-tests"
      ],
      "command": [
        "{bin:compiler-tests}",
        "port",
        "--manager",
        "{bin:mlfpkg}",
        "--compiler",
        "{bin:emlf}",
        "--build-dir",
        "{build}/compiler-tests/port",
        "--cache-dir",
        "{cache}"
      ]
    }
  },
  "source-syntax": "shared-haskell-v1"
}
