{
  "format": 1,
  "name": "mlf-compiler",
  "version": "0.3.0",
  "dependencies": {
    "mlf-bootstrap": {
      "path": "bootstrap"
    },
    "mlf-package-tools": {
      "path": "package"
    }
  },
  "executables": {
    "emlf": {
      "main": "bootstrap/Main.emlf",
      "profile": "compiler"
    },
    "mlfpkg": {
      "main": "package/Main.emlf",
      "profile": "compiler"
    },
    "compiler-tests": {
      "main": "tests/CompilerTestsMain.emlf",
      "profile": "compiler",
      "modules": {
        "Tests.CompilerTests": "tests/Tests/CompilerTests.emlf",
        "Tests.Coverage": "tests/Tests/Coverage.emlf",
        "Tests.TestDrivers": "tests/Tests/TestDrivers.emlf",
        "Tests.TestSources": "tests/Tests/TestSources.emlf"
      }
    }
  },
  "tests": {
    "unit": {
      "requires": [
        "emlf",
        "mlfpkg",
        "compiler-tests"
      ],
      "command": [
        "{bin:compiler-tests}",
        "unit",
        "--manager",
        "{bin:mlfpkg}",
        "--compiler",
        "{bin:emlf}",
        "--build-dir",
        "{build}/compiler-tests/unit",
        "--cache-dir",
        "{cache}"
      ]
    },
    "packages": {
      "requires": [
        "emlf",
        "mlfpkg",
        "compiler-tests"
      ],
      "command": [
        "{bin:compiler-tests}",
        "packages",
        "--manager",
        "{bin:mlfpkg}",
        "--compiler",
        "{bin:emlf}",
        "--build-dir",
        "{build}/compiler-tests/packages",
        "--cache-dir",
        "{cache}"
      ]
    },
    "self-host": {
      "requires": [
        "emlf",
        "mlfpkg",
        "compiler-tests"
      ],
      "command": [
        "{bin:compiler-tests}",
        "self-host",
        "--manager",
        "{bin:mlfpkg}",
        "--compiler",
        "{bin:emlf}",
        "--build-dir",
        "{build}/compiler-tests/self-host",
        "--cache-dir",
        "{cache}"
      ]
    },
    "parity": {
      "requires": [
        "emlf",
        "mlfpkg",
        "compiler-tests"
      ],
      "command": [
        "{bin:compiler-tests}",
        "parity",
        "--manager",
        "{bin:mlfpkg}",
        "--compiler",
        "{bin:emlf}",
        "--build-dir",
        "{build}/compiler-tests/parity",
        "--cache-dir",
        "{cache}"
      ]
    },
    "backends": {
      "requires": [
        "emlf",
        "mlfpkg",
        "compiler-tests"
      ],
      "command": [
        "{bin:compiler-tests}",
        "backends",
        "--manager",
        "{bin:mlfpkg}",
        "--compiler",
        "{bin:emlf}",
        "--build-dir",
        "{build}/compiler-tests/backends",
        "--cache-dir",
        "{cache}"
      ]
    },
    "port": {
      "requires": [
        "emlf",
        "mlfpkg",
        "compiler-tests"
      ],
      "command": [
        "{bin:compiler-tests}",
        "port",
        "--manager",
        "{bin:mlfpkg}",
        "--compiler",
        "{bin:emlf}",
        "--build-dir",
        "{build}/compiler-tests/port",
        "--cache-dir",
        "{cache}"
      ]
    }
  }
}
