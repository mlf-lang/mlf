module Main where
import Bootstrap.Types
import qualified Bootstrap.Std as L
import qualified Bootstrap.Map as M
import qualified Bootstrap.IntMap as IM
import qualified Bootstrap.Parser as P
import qualified Bootstrap.Module as Modules
import qualified Bootstrap.Classes as Classes
import qualified Bootstrap.Prelude as Prelude
import qualified Bootstrap.Constraint as C
import qualified Bootstrap.Graph.Solver as S
import qualified Bootstrap.Elaborate as E
import qualified Bootstrap.X.Check as Check
import qualified Bootstrap.X.Type as T
import qualified Bootstrap.X.Syntax as X
import qualified Bootstrap.LLVM as LLVM
import qualified Bootstrap.LLVM.Optimize as Optimize
import qualified Bootstrap.LLVM.StrictWrappers as Wrappers
import qualified Bootstrap.LLVM.Codegen as Codegen
import qualified Bootstrap.Compiler as Compiler
import qualified Force as F

mark label = putErr ("MLF_PHASE " ++ label ++ "\n")
checked : forall a. String -> (a -> Unit) -> Either String a -> IO a
checked label force result = case result of
  Left message -> do { putErr (label ++ ": " ++ message ++ "\n"); exitWith 1 }
  Right value -> do
    seq (force value) (mark label)
    -- A second traversal measures the forcing-only diagnostic overhead.
    seq (force value) (mark (label ++ "-forced-again"))
    ioReturn value

main = do
  file <- getArg 0
  includes <- getArg 1
  layout <- getArg 2
  let compact = eqString layout "compact"
  mark "start"
  source <- readFile file
  seq source (mark "read-source")
  root <- checked "parse-root" F.forceSourceModule (P.parseModule file source)
  Pair lowered classNames <- if Compiler.standalone root then do
    program <- checked "standalone" F.forceSProgram (P.standaloneProgram root)
    case Prelude.withPrelude ImplicitPrelude program of
      Pair imports source -> checked "lower-classes" (F.forcePair F.forceSProgram (F.forceMap F.scalar F.scalar)) (Classes.lowerClassesWithImports imports source)
   else do
    loaded <- Modules.loadModuleFiles (Cons includes Nil) root
    modules <- checked "load-modules" (F.forceList F.forceSourceModule) loaded
    LinkedModule program names valueScopes instanceScopes <- checked "link-modules" F.forceLinkedModule (Modules.linkModules ImplicitPrelude modules)
    checked "lower-classes" (F.forcePair F.forceSProgram (F.forceMap F.scalar F.scalar)) (Classes.lowerClassesWithScopes valueScopes instanceScopes program)
  case lowered of
    SClassProgram _ _ _ _ -> panic "unlowered classes"
    SProgram declarations expression -> do
      constraints <- checked "generate" F.forceConstraints (C.generateProgram lowered)
      prepared <- checked "prepare" F.forceSolver (S.prepare (C.initialGraph constraints))
      initial <- checked "unify" F.forceSolver (S.solverUnify (C.equalities constraints) prepared)
      instantiated <- checked "instantiate" F.forceSolver (C.evaluateSteps initial (C.solveSteps constraints))
      solved <- checked "finish-normalize" F.forceSolver (S.finishNormalized instantiated)
      let graph = S.solverGraph solved
      let types = E.prepareTypes graph
      evidence <- checked "resolve" (F.forceIntMap F.forceXTerm) (E.resolveEvidenceIn types (C.skeleton constraints))
      body <- checked "elaborate" F.forceXTerm (E.elaboratePreparedIn types solved evidence (C.skeleton constraints))
      let term = if L.null declarations then body else XWithData declarations body
      ty <- checked "check" F.forceXType (Check.checkClosed term)
      let expected = E.schemeTypeIn types (C.generalization (C.skeleton constraints))
      if L.not (T.alphaEq ty expected) then panic "type mismatch" else mark "type-agreement"
      if L.not (X.equalErased (X.erase term) (C.eraseSourceWith evidence (C.skeleton constraints))) then panic "erasure mismatch" else mark "erasure-agreement"
      erased <- checked "erase" F.forceXErased (Right (X.erase term))
      optimized <- checked "optimize" F.forceXErased (Right (Optimize.optimize erased))
      let constructorsAll = L.concatMap LLVM.dataConstructors declarations
      let constructors = M.fromList compareString (Cons (Pair "Unit" (Pair 0 0)) (L.zipWith LLVM.constructorEntry (L.range 1 (L.length constructorsAll)) constructorsAll))
      lowered <- if compact then checked "representation" F.forceXErased (Right (Wrappers.optimize declarations constructors optimized)) else ioReturn optimized
      Pair entry code <- checked "llvm-generate" (F.forcePair F.scalar (F.forceList F.scalar)) ((if compact then Codegen.generateForGC else Codegen.generate) constructors lowered)
      let chunks = L.map (\line -> line ++ "\n") (L.append (Cons "; Generated from independently checked xMLF." (Cons "source_filename = \"emlf\"" (Cons "" Nil))) (L.append code (LLVM.entryCode compact entry (LLVM.ioType ty))))
      printChunks chunks
      mark "write"
printChunks : List String -> IO Unit
printChunks chunks = case chunks of
  Nil -> ioReturn Unit
  Cons chunk rest -> do { putStr chunk; printChunks rest }
