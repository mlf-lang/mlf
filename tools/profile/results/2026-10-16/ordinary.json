  "script": "#!/bin/bash\nset -euo pipefail\ncd /Volumes/src/mlf\nexport PATH=\"$PWD/.mlf-build/self-profile/blocked:$PATH\"\nroot=\"$PWD/.mlf-build/self-profile\"\nout=\"$root/ordinary\"\nmkdir -p \"$out\"\nif [[ -e \"$out/baseline-1.json\" ]]; then exit 2; fi\nsource_root=\"$root/baseline-source/bootstrap\"\nhost=\"$root/bench-results-warm/host-support\"\n\"$root/baseline-emlf\" --type --expr 42 > \"$out/baseline-warmup.txt\"\n\"$root/candidate-v3/bin/emlf\" --type --expr 42 > \"$out/candidate-warmup.txt\"\nfor round in 1 2 3; do\n  if [[ \"$round\" == 2 ]]; then order='candidate baseline'; else order='baseline candidate'; fi\n  for label in $order; do\n    compiler=\"$root/baseline-emlf\"\n    if [[ \"$label\" == candidate ]]; then compiler=\"$root/candidate-v3/bin/emlf\"; fi\n    printf 'Self-compilation %s %s\\n' \"$round\" \"$label\"\n    \"$host\" measure 21600 '' \"$out/$label-$round.ll\" \"$out/$label-$round.stderr\" \\\n      \"$compiler\" -i \"$source_root\" --emit-llvm-gc \"$source_root/Main.emlf\" > \"$out/$label-$round.json\"\n    grep -q '\"exit_code\":0,' \"$out/$label-$round.json\"\n    cmp \"$root/baseline/self.ll\" \"$out/$label-$round.ll\"\n    cat \"$out/$label-$round.json\"\n  done\ndone\ntest ! -e \"$root/forbidden.log\"\n",
