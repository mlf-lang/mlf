#!/bin/bash
set -euo pipefail
for arg in "$@"; do
 if [[ $arg == -O2 ]]; then
  exec '/opt/homebrew/Cellar/llvm/23.1.3/bin/clang-23' "$@" '-fprofile-use=/Volumes/src/mlf/.mlf-build/compile3/pgo7/training/compiler.profdata' '-Werror=profile-instr-unprofiled' '-Werror=profile-instr-out-of-date'
 fi
done
exec '/opt/homebrew/Cellar/llvm/23.1.3/bin/clang-23' "$@"
