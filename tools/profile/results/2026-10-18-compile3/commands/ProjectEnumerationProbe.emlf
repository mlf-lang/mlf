module Main where
import Bootstrap.Types
import qualified Bootstrap.Std as L
import qualified Bootstrap.IntSet as IS
import qualified Bootstrap.IntMap as IM
import qualified Bootstrap.Graph as G
import qualified Bootstrap.Graph.Solver as S
import qualified ComponentFixtures as N

check solver starts = do
 Pair connected boundaries <- N.right (S.componentScopes solver starts)
 let old = S.graph solver
 let scopes = S.projectScopes (S.scopeIndex solver) boundaries
 let selected = IS.union connected (IS.fromList (IM.keys scopes))
 let originals = L.map (\n -> Pair n (G.nodeAt old n)) (IS.toList selected)
 let count = L.length originals
 let hidden = L.filter (\(Pair n node) -> case G.tag node of { GGen root -> L.not (IS.member root selected); _ -> false }) originals
 let stubs = IM.fromDistinctAscList (L.zip (L.map L.fst hidden) (L.range count (count + L.length hidden - 1)))
 let expected = L.map (\(Pair n node) -> Pair (S.compactIdentity old selected n) (S.localNode old selected scopes stubs n node)) originals
 let actual = S.projectNodes old selected scopes stubs 0 originals
 N.assert (L.eqList (\(Pair n a) (Pair m b) -> n == m && G.equalNode a b) expected actual) "enumerated projection changed identities, fields, binders or scope stubs"

main = do
 L.mapM_ (\input -> do
  solver <- N.right (S.prepare input)
  let keys = IM.keys (G.nodes (S.graph solver))
  L.mapM_ (check solver) (Cons Nil (Cons (Cons (L.head keys) Nil) (Cons (Cons (L.index keys 1) Nil) (Cons (Cons (L.last keys) Nil) (Cons keys (Cons (L.append keys keys) Nil))))))) (L.concatMap (\offset -> L.concatMap (\stride -> L.map (N.rename (\n -> offset + stride * n)) (Cons (N.fixture 7) (L.map N.chain (Cons 1 (Cons 2 (Cons 17 (Cons 65 Nil))))))) (Cons 1 (Cons 100003 Nil))) (Cons 0 (Cons 340282366920938463463374607431768211456 (Cons (-340282366920938463463374607431768211456) Nil))))
 putStrLn "180 projection enumerations matched explicit rank lookups"
