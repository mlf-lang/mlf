{
  "format": 1,
  "name": "mlf-phase-profile",
  "version": "0.1.0",
  "dependencies": {
    "mlf-foundation": {
      "path": "../../libraries/mlf-foundation"
    },
    "mlf-frontend": {
      "path": "../../libraries/mlf-frontend"
    },
    "mlf-inference": {
      "path": "../../libraries/mlf-inference"
    },
    "mlf-llvm": {
      "path": "../../libraries/mlf-llvm"
    },
    "mlf-xmlf": {
      "path": "../../libraries/mlf-xmlf"
    }
  },
  "library": {
    "modules": {
      "Force": "Force.emlf",
      "Simple": "Simple.emlf"
    }
  },
  "executables": {
    "stages": {
      "main": "Stages.emlf",
