    "instances": {
      "main": "Instances.emlf",
      "profile": "compiler",
      "link": "source"
    },
    "unification": {
      "main": "Unification.emlf",
      "profile": "compiler",
      "link": "source"
    },
    "unify-trace": {
      "main": "UnifyTrace.emlf",
      "profile": "compiler",
      "link": "source"
    }
  }
