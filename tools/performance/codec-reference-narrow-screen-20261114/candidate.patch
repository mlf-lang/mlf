+            writeByteArray bytes (nextIndex + 1)
+              (orInt following (andInt (unsignedShiftRInt shifted 8)
+                (shiftLInt 1 (remaining - 8) - 1)));
+            ioReturn (next + remaining)
+          }
+        }
+      }
+    };
