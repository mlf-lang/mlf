+  -- do not inspect/range-check bits before the original first buffer operation.
+  putReferenceBits :: ByteArray -> Int -> Int -> Int -> IO Int;
+  putReferenceBits bytes position width bits =
+    if width < 1 || width > 16 then putBits bytes position width bits
+    else if position < 0 || position > 9223372036854775791
+      then putBits bytes position width bits
+    else do {
+      let {
+        offset = position % 8;
+        first = min width (8 - offset);
+        mask = shiftLInt 1 first - 1;
+        piece = shiftLInt (andInt bits mask) offset;
+        byteIndex = position / 8
+      };
+      if first == 8 then writeByteArray bytes byteIndex piece else do {
+        previous <- readByteArray bytes byteIndex;
+        writeByteArray bytes byteIndex (orInt previous piece)
+      };
