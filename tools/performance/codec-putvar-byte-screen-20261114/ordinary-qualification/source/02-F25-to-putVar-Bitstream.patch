+  -- Private fixed-width specialization for putVar's defined byte in 0..255.
+  -- Keep the public generic writer for negative/overflow positions. Partial
+  -- writes retain both reads and the original read/write/error ordering.
+  putVarByte :: ByteArray -> Int -> Int -> IO Int;
+  putVarByte bytes position byte =
+    if position < 0 || position > 9223372036854775799
+    then putBits bytes position 8 byte
+    else let {
+      offset = position % 8;
+      byteIndex = position / 8;
+      lowWidth = 8 - offset
+    } in
+    if offset == 0 then do {
+      writeByteArray bytes byteIndex byte;
+      ioReturn (position + 8)
+    } else do {
+      previous <- readByteArray bytes byteIndex;
+      writeByteArray bytes byteIndex
+        (orInt previous (shiftLInt (andInt byte (shiftLInt 1 lowWidth - 1)) offset));
+      following <- readByteArray bytes (byteIndex + 1);
+      writeByteArray bytes (byteIndex + 1)
+        (orInt following (unsignedShiftRInt byte lowWidth));
+      ioReturn (position + 8)
+    };
   putVar :: ByteArray -> Int -> Int -> IO Int;
