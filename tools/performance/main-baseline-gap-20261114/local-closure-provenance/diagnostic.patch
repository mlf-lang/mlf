+  componentProvenanceVisit :: Solver ->
+                                  IntMap Node ->
+                                  IntSet -> Capture.Counts -> [] ((,) Int Int) ->
+                                  Either String ((,,) (IntMap Node) IntSet Capture.Counts);
+  componentProvenanceVisit solver seen scopes counts pending =
+    case pending of {
+      [] -> Right ((,,) seen scopes counts);
+      (:) ((,) original origin) rest ->
+        let {
+          currentGraph = graph solver
+        } in
+        let {
+          n = original
+        } in
+        if IM.member n seen
+        then componentProvenanceVisit solver seen scopes counts rest
+        else case IM.lookup n (G.nodes currentGraph) of {
+               Nothing -> Left ("missing graph node " ++ showInt n);
+               Just node ->
+                 let {
+                   boundary = G.isGen (G.tag node)
+                 } in
+                 let {
+                   connected =
+                     if boundary
+                     then rest
+                     else L.append (L.map (\n -> (,) n 2) (G.children (G.tag node)))
+                            (L.append (L.map (\n -> (,) n 3) (L.maybeToList (G.binder node)))
+                               (L.append
+                                  (L.map (\parent -> (,) parent 4) (IS.toList
+                                     (IM.findWithDefault IS.empty n (structuralParents solver))))
+                                  (L.append
+                                     (L.map (\child -> (,) child 5) (IS.toList
+                                        (IM.findWithDefault IS.empty n (bindingChildren solver))))
+                                     rest)))
+                 } in
+                 let { nextCounts = Capture.bump origin counts } in
+                 seq nextCounts (componentProvenanceVisit solver (IM.insert n node seen)
+                   (if boundary then IS.insert n scopes else scopes)
+                   nextCounts connected)
+             }
+    };
+
+  -- Diagnostic metadata is demanded only after the original action and digest.
+  projectionProvenance :: Capture.Counts -> IntMap Node -> IntMap Node ->
+                          [] Int -> [] Int -> [] Int -> IntMap Int -> [] Int;
+  projectionProvenance counts connected selected equations fresh external stubs =
+    let { eqSet = IS.fromList equations; freshSet = IS.fromList fresh;
+          externalSet = IS.fromList external;
+          direct = IS.union eqSet freshSet;
+          valid = L.all (\n -> IM.member n selected || IS.member n freshSet)
+                    (IS.toList direct) &&
+                  L.all (\n -> IM.member n selected) (IS.toList externalSet) &&
+                  L.all (\n -> L.not (IM.member n selected)) (IS.toList freshSet) &&
+                  IS.size freshSet == L.length fresh } in
+    if L.not valid then panic "provenance direct identity contract"
+    else L.append (Capture.countsList counts)
+      [IM.size connected, IM.size selected, IM.size selected - IM.size connected,
+       L.length fresh, IM.size stubs, IS.size eqSet, IS.size freshSet,
+       IS.size (IS.intersection eqSet freshSet), IS.size direct, IS.size externalSet];
+  unifyDistinctObserved :: [] ((,) Int Int) -> Solver -> Either String Solver;
+  -- Original positions precede the fresh placeholder positions.
+  unifyDistinctObserved equations solver =
+    G.bindE
+      (componentProvenanceVisit solver IM.empty IS.empty Capture.emptyCounts
+         (L.map (\n -> (,) (G.resolve (graph solver) n) 0) (L.concatMap G.equationNodes equations)))
+      (\((,,) connected boundaries counts) ->
+         let {
+           old = graph solver
+         } in
+         let {
+           scopes = projectScopes (scopeIndex solver) boundaries
+         } in
+         let {
+           selected =
+             L.foldlStrict
+               (\found n ->
+                  if IM.member n found then found else IM.insert n (IM.get n (G.nodes old)) found)
+               connected
+               (IM.keys scopes)
+         } in
+         let {
+           originals = IM.toList selected
+         } in
+         let {
+           count = L.length originals
+         } in
+         let {
+           forward =
+             Rank.indexMap selected
+         } in
+         let {
+           backward = forward
+         } in
+         let {
+           compact = \n -> rankIdentity (G.resolve old n) 0 forward
+         } in
+         let {
+           hiddenRoots =
+             L.filter
+               (\entry ->
+                  case entry of {
+                    (,) n v ->
+                      case G.tag v of {
+                        GGen root -> L.not (IM.member root selected);
+                        _ -> False
+                      }
+                  })
+               originals
+         } in
+         let {
+           stubIds = L.range count ((count + L.length hiddenRoots) - 1)
+         } in
+         let {
+           stubs =
+             IM.fromDistinctAscList
+               (L.zip
+                  (L.map
+                     (\entry ->
+                        case entry of {
+                          (,) n v -> n
+                        })
+                     hiddenRoots)
+                  stubIds)
+         } in
+         let {
+           existing = projectCanonicalNodes forward scopes stubs 0 originals
+         } in
+         let {
+           placeholders =
+             L.map
+               (\entry ->
+                  case entry of {
+                    (,) original stub ->
+                      (,) stub (G.mkNode GBot (Just (rankIdentity original 0 forward)) Flexible)
+                  })
+               (IM.toList stubs)
+         } in
+         let {
+           local =
+             G.mkGraph (G.nodesFromDistinctAscList (L.append existing placeholders)) IM.empty
+               (count + L.length hiddenRoots)
+         } in
+         G.bindE
+           (Capture.observeMetadata Capture.UnifyDistinct
+              (projectionProvenance counts connected selected
+                (L.map (G.resolve old) (L.concatMap G.equationNodes equations)) [] [] stubs)
+              G.unify
+              (L.map
+                 (\entry ->
+                    case entry of {
+                      (,) a b -> (,) (compact a) (compact b)
+                    })
+                 equations)
+              local)
+           (\solved ->
+              G.bindE
+                (G.mapE_
+                   (\stub ->
+                      G.check
+                        (matchesNode (G.nodes solved) stub (G.nodeAt local stub) &&
+                         (G.resolve solved stub == stub))
+                        "local unification changed a hidden scope root")
+                   (IM.elems stubs))
+                (\checkedStubs ->
+                   G.bindE (G.mapE_ (checkPreservedScope old solved forward scopes) originals)
+                     (\checkedScopes ->
+                        restoreProjection solver originals backward count solved))));
+  preparedFallbackProjectionObserved :: Solver -> Graph -> Int -> [] ((,) Int Node) ->
+                                [] ((,) Int Int) ->
+                                Either String
+                                  ((,,,) Graph ([] ((,) Int Int)) ([] ((,) Int Node))
+                                    ((,) ((,,) (Rank.MapIndex Node) (IntMap (Maybe Int)) (IntMap Int)) ([] Int)));
+  preparedFallbackProjectionObserved solver current first fresh equations =
+    G.bindE
+      (componentProvenanceVisit solver IM.empty IS.empty Capture.emptyCounts
+        (L.append (L.map (\n -> (,) n 0) (L.filter (\n -> n < first) (L.concatMap G.equationNodes equations)))
+          (L.map (\n -> (,) n 1) (expandedOldSeeds first fresh))))
+      (\((,,) connected boundaries counts) ->
+        let { scopes = projectScopes (scopeIndex solver) boundaries } in
+        let { selected = L.foldlStrict
+          (\found n -> if IM.member n found then found
+            else IM.insert n (IM.get n (G.nodes current)) found)
+          connected (IM.keys scopes) } in
+        let { oldOriginals = IM.toList selected } in
+        let { originals = L.append oldOriginals fresh } in
+        let { count = L.length originals } in
+        let { forward = Rank.indexMap selected } in
+        let { compact = \n -> expandedCompact first (G.nextId current) forward (G.resolve current n) } in
+        let { hiddenRoots = L.filter
+          (\((,) n v) -> case G.tag v of {
+            GGen root -> L.not (IM.member root selected);
+            _ -> False
+          }) oldOriginals } in
+        let { stubIds = L.range count ((count + L.length hiddenRoots) - 1) } in
+        let { stubs = IM.fromDistinctAscList (L.zip (L.map L.fst hiddenRoots) stubIds) } in
+        let { existing = projectExpandedNodes first (G.nextId current) forward scopes stubs 0 originals } in
+        let { placeholders = L.map
+          (\((,) original stub) ->
+            (,) stub (G.mkNode GBot (Just (rankIdentity original 0 forward)) Flexible))
+          (IM.toList stubs) } in
+        let { local = G.mkGraph
+          (G.nodesFromDistinctAscList (L.append existing placeholders)) IM.empty
+          (count + L.length hiddenRoots) } in
+        Right ((,,,) local
+          (L.map (\((,) a b) -> (,) (compact a) (compact b)) equations)
+          originals ((,) ((,,) forward scopes stubs)
+            (projectionProvenance counts connected selected
+              (L.concatMap G.equationNodes equations) (L.map L.fst fresh)
+              (expandedOldSeeds first fresh) stubs))));
+  unifyPreparedFallbackObserved :: [] ((,) Int Int) -> Solver -> Graph -> Int ->
+                           [] ((,) Int Node) -> Either String Solver;
+  unifyPreparedFallbackObserved equations solver current first fresh =
+    let { canonical = L.map
+      (\((,) a b) -> (,) (G.resolve current a) (G.resolve current b)) equations } in
+    G.bindE
+      (G.mapE_ (\n -> G.check (IM.member n (G.nodes current))
+        ("missing graph node " ++ showInt n)) (L.concatMap G.equationNodes canonical))
+      (\checked ->
+        let { pending = L.filter (\((,) a b) -> L.not (a == b)) canonical } in
+        case pending of {
+          [] -> Right (L.foldlStrict addNode (withGraph current solver) fresh);
+          (:) head tail -> G.bindE
+            (preparedFallbackProjectionObserved solver current first fresh pending)
+            (\((,,,) local localEquations originals ((,) ((,,) forward scopes stubs) metadata)) ->
+              G.bindE (Capture.observeMetadata Capture.PreparedFallback metadata G.unify localEquations local)
+                (\solved -> G.bindE
+                  (G.mapE_ (\stub -> G.check
+                    (matchesNode (G.nodes solved) stub (G.nodeAt local stub) &&
+                      G.resolve solved stub == stub)
+                    "local unification changed a hidden scope root") (IM.elems stubs))
+                  (\checkedStubs -> G.bindE
+                    (G.mapE_ (checkPreservedScope current solved forward scopes) originals)
+                    (\checkedScopes -> restoreExpandedProjection solver current first
+                      originals forward (L.length originals) solved))))
+        });
 }
