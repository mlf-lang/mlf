+def reference_cell(files,compiler,config_template):
+    """Authenticate the original producer before freezing its observed route.
+    This accepts the two source-proved production formats, not a claimed actual
+    branch. Actual child provenance and the immutable reference contract bind
+    the observed bytes; later B acceptance never selects a fresh route.
+    """
+    need(type(config_template) is list and len(config_template)==5
+         and config_template[1] is None and config_template[4] is None,'reference configuration template')
+    current=decode(files[PREFIX+'CURRENT'],6)
+    need(len(current['roots'])==1,'single reference CURRENT root')
+    address=digest(scalar(current,current['roots'][0],'text'))
+    generation=PREFIX+'generations/'+address+'.mlfqg'
+    g=decode(files[generation],6);need(len(g['roots'])==1,'single reference snapshot root')
+    root=node(g,g['roots'][0],412);need(len(root)==7,'reference snapshot arity')
+    fields,_=packed(scalar(g,root[1],'text'))
+    need(len(fields)==5 and fields[4] in ('source','lowered'),'supported main production route')
+    expected=[*config_template];expected[1]=compiler;expected[4]=fields[4]
+    result=publication(files,compiler,expected,8)
+    frozen=[*expected];frozen[1]=None
+    return {'configuration_template':frozen,'observed_route':fields[4],
+            'generation':result['generation'],'query_rows':len(result['snapshot']['rows']),
+            'result_files':result['result_count'],'checked_schema':8,'interface_schema':3}
