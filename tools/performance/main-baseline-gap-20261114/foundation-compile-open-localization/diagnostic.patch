+  -- Diagnostic IO entry only. The pure finishCompilation API above is intact.
+  -- Callbacks avoid any dependency from inference back to QueryGraph.
+  -- Only the Either constructor required by the original bind is observed.
+  observeEither :: forall e a. IO Int -> (Int -> Int -> IO ()) -> Int ->
+    Either e a -> IO (Either e a);
+  observeEither clock elapsed index value = do {
+    started <- clock;
+    case value of {
+      Left error -> do { elapsed index started; ioReturn (Left error) };
+      Right result -> do { elapsed index started; ioReturn (Right result) }
+    }
+  };
+  finishCompilationObserved :: IO Int -> (Int -> Int -> IO ()) ->
+    (,) SProgram (Map String String) -> IO (Either CompileError Compilation);
+  finishCompilationObserved clock elapsed ((,) program names) =
+    case program of {
+      SClassProgram _ _ _ _ ->
+        ioReturn (Left (CompileError Inference "class translation did not produce a core program"));
+      SProgram declarations expression -> do {
+        generated <- observeEither clock elapsed 13 (atPhase Inference (C.generateProgram program));
+        case generated of { Left error -> ioReturn (Left error); Right constraints -> do {
+          answer <- observeEither clock elapsed 14 (atPhase Inference (C.solvePrepared constraints));
+          case answer of { Left error -> ioReturn (Left error); Right solved -> do {
+            let { graph = Solver.solverGraph solved; types = E.prepareTypes graph };
+            elaborated <- observeEither clock elapsed 15 (do {
+              evidence <- atPhase Resolution (E.resolveEvidenceIn types (C.skeleton constraints));
+              body <- atPhase Elaboration (E.elaboratePreparedIn types solved evidence (C.skeleton constraints));
