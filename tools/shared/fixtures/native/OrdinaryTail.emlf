evenStep n total = if eqInt n 0 then total else let next = addInt total 1 in seq next (oddStep (subInt n 1) next)
oddStep n total = if eqInt n 0 then total else let next = addInt total 1 in seq next (evenStep (subInt n 1) next)
spine n = if eqInt n 0 then [] else (:) n (spine (subInt n 1))
caseStep remaining total = case remaining of { [] -> total; (:) item rest -> let next = addInt total item in seq next (caseStep rest next) }
captured amount salt = let rec loop n total = if eqInt n 0 then addInt total salt else let next = addInt total 1 in seq next (loop (subInt n 1) next) in loop amount 0
escape amount salt = let rec loop n total = if eqInt n 0 then (\argument -> addInt argument (addInt total salt)) else let next = addInt total 1 in seq next (loop (subInt n 1) next) in loop amount 0
ignoreCase ignored value = case ignored of { unused -> value }
boundCase values total = case values of { original -> case original of { [] -> total; (:) item rest -> let next = addInt total item in seq next (boundCase rest next) } }
small n = if eqInt n 0 then 41 else wider n 1
wider n unused = if eqInt n 0 then unused else small (subInt n 1)
collect n items = if eqInt n 0 then items else let item = concatString "v" (showInt n) in seq item (let cell = (:) item items in seq cell (collect (subInt n 1) cell))
sizeStrings items total = case items of { [] -> total; (:) item rest -> let next = addInt total (stringLength item) in seq next (sizeStrings rest next) }
run mode n salt = if eqString mode "mutual" then evenStep n 0 else if eqString mode "case" then caseStep (spine n) 0 else if eqString mode "capture" then captured n salt else if eqString mode "escape" then let closure = escape n salt in addInt (closure 3) (closure 5) else if eqString mode "default-unused" then ignoreCase (panic "unused subject") n else if eqString mode "default-bound" then boundCase (spine n) 0 else if eqString mode "abi" then small n else sizeStrings (collect n []) 0
main = ioBind (getArg 0) (\mode -> ioBind (getArg 1) (\count -> ioBind (getArg 2) (\salt -> printInt (run mode (readInt count) (readInt salt)))))
