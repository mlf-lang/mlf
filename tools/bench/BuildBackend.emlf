module Main where
import Bootstrap.Types
import qualified Bootstrap.Std as S
import qualified Package.OS as O
import qualified Package.Json as J

main = do
 args <- O.allArguments
 case args of
  (:) compiler ((:) llvm ((:) source ((:) output []))) -> do
   present <- directoryExists output
   O.require (S.not present) "backend build requires a fresh directory"
   cc <- canonicalPath compiler
   prefix <- canonicalPath llvm
   input <- canonicalPath source
   O.mkdir output
   directory <- canonicalPath output
   let binary = directory ++ "/mlf-llvm"
   let command = S.append ((:) cc (O.words "-std=c11 -O2 -Wall -Wextra -Werror")) ((:) ("-I" ++ prefix ++ "/include") ((:) input ((:) ("-L" ++ prefix ++ "/lib") ((:) ("-Wl,-rpath," ++ prefix ++ "/lib") ((:) "-lLLVM" ((:) "-o" ((:) binary [])))))))
   O.run "" command
   headers <- O.files (prefix ++ "/include/llvm-c")
   hashes <- S.mapM (\path -> do { real <- canonicalPath path; hash <- fileDigest real; return ((,) real (J.str hash)) }) (S.append ((:) cc ((:) input ((:) binary ((:) (prefix ++ "/lib/libLLVM.dylib") [])))) headers)
   writeFile (directory ++ "/build.json") (J.render (J.Object ((:) ((,) "command" (J.stringArray command)) ((:) ((,) "sha256" (J.Object hashes)) []))) ++ "\n")
  _ -> O.fatal "build-backend CLANG LLVM_PREFIX SOURCE FRESH_OUTPUT_DIRECTORY"
