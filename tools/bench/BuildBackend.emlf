module Main where
import Bootstrap.Types
import qualified Bootstrap.Std as S
import qualified Package.OS as O
import qualified Package.Json as J

main = do
 args <- O.allArguments
 case args of
  Cons compiler (Cons llvm (Cons source (Cons output Nil))) -> do
   present <- directoryExists output
   O.require (S.not present) "backend build requires a fresh directory"
   cc <- canonicalPath compiler
   prefix <- canonicalPath llvm
   input <- canonicalPath source
   O.mkdir output
   directory <- canonicalPath output
   let binary = directory ++ "/mlf-llvm"
   let command = S.append (Cons cc (O.words "-std=c11 -O2 -Wall -Wextra -Werror")) (Cons ("-I" ++ prefix ++ "/include") (Cons input (Cons ("-L" ++ prefix ++ "/lib") (Cons ("-Wl,-rpath," ++ prefix ++ "/lib") (Cons "-lLLVM" (Cons "-o" (Cons binary Nil)))))))
   O.run "" command
   headers <- O.files (prefix ++ "/include/llvm-c")
   hashes <- S.mapM (\path -> do { real <- canonicalPath path; hash <- fileDigest real; return (Pair real (J.str hash)) }) (S.append (Cons cc (Cons input (Cons binary (Cons (prefix ++ "/lib/libLLVM.dylib") Nil)))) headers)
   writeFile (directory ++ "/build.json") (J.render (J.Object (Cons (Pair "command" (J.stringArray command)) (Cons (Pair "sha256" (J.Object hashes)) Nil))) ++ "\n")
  _ -> O.fatal "build-backend CLANG LLVM_PREFIX SOURCE FRESH_OUTPUT_DIRECTORY"
