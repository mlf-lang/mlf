module Main where
import Bootstrap.Types
import qualified Bootstrap.Std as S
import qualified Package.OS as O
import qualified Package.Json as J
main = do
 args <- O.allArguments
 case args of
  (:) compiler ((:) llvm ((:) linker ((:) source ((:) output [])))) -> do
   present <- directoryExists output
   O.require (S.not present) "linker build requires a fresh directory"
   cc <- canonicalPath compiler
   prefix <- canonicalPath llvm
   lld <- canonicalPath linker
   input <- canonicalPath source
   O.mkdir output
   directory <- canonicalPath output
   let binary = directory ++ "/mlf-link"
   let command = S.append ((:) cc (O.words "-std=c++17 -O2 -Wall -Wextra -Werror")) (S.append (S.concatMap (\root -> (:) ("-I" ++ root ++ "/include") ((:) ("-L" ++ root ++ "/lib") ((:) ("-Wl,-rpath," ++ root ++ "/lib") []))) ((:) prefix ((:) lld []))) (S.append ((:) input (O.words "-llldMachO -llldCommon -lLLVM -lc++")) ((:) "-o" ((:) binary []))))
   O.run "" command
   llvmHeaders <- O.files (prefix ++ "/include/llvm")
   lldHeaders <- O.files (lld ++ "/include/lld")
   let files = S.append ((:) cc ((:) input ((:) binary ((:) (prefix ++ "/lib/libLLVM.dylib") ((:) (lld ++ "/lib/liblldMachO.dylib") ((:) (lld ++ "/lib/liblldCommon.dylib") [])))))) (S.append llvmHeaders lldHeaders)
   hashes <- S.mapM (\path -> do { real <- canonicalPath path; hash <- fileDigest real; return ((,) real (J.str hash)) }) files
   writeFile (directory ++ "/build.json") (J.render (J.Object ((:) ((,) "command" (J.stringArray command)) ((:) ((,) "sha256" (J.Object hashes)) []))) ++ "\n")
  _ -> O.fatal "build-linker CLANG LLVM_PREFIX LLD_PREFIX SOURCE FRESH_OUTPUT_DIRECTORY"
