data Maybe a = Nothing | Just a; let maybe : forall b a. b -> (a -> b) -> Maybe a -> b = \fallback f value -> case value of { Nothing -> fallback; Just x -> f x } in let intBox : Maybe Int = Just 41 in let boolBox : Maybe Bool = Just true in addInt (maybe 0 (\x -> addInt x 1) intBox) (case boolBox of { Nothing -> 0; Just flag -> if flag then 0 else 1 })
