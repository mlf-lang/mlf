cabal-version: 3.0
name: mlf
version: 0.1.0.0
synopsis: Evidence-producing eMLF to xMLF compiler
description: Graph-based type inference and explicit elaboration following Yakobowski's thesis.
category: Language
build-type: Simple
license: BSD-3-Clause
extra-source-files: README.md, examples/*.emlf, examples/*.hs, test/fixtures/*.emlf, test/*.c, docs/*.txt, scripts/*.py
data-files: runtime/mlf_runtime.c, runtime/mlf_runtime.h

common settings
  default-language: Haskell2010
  ghc-options: -Wall -Wcompat -Wincomplete-uni-patterns -Wincomplete-record-updates
  build-depends: base >=4.14 && <5, array >=0.5 && <0.6, containers >=0.6 && <0.9, mtl >=2.2 && <2.4, parsec >=3.1 && <3.2

library
  import: settings
  hs-source-dirs: src
  exposed-modules:
    MLF.Compiler
    MLF.Prelude
    MLF.Desugar
    MLF.Primitive
    MLF.Runtime
    MLF.LLVM
    MLF.Classes
    MLF.Kind
    MLF.Kinding
    MLF.Data
    MLF.Data.Parser
    MLF.Syntax
    MLF.Parser
    MLF.Graph
    MLF.Graph.Solver
    MLF.Constraint
    MLF.Elaborate
    MLF.Evidence
    MLF.X.Type
    MLF.X.Syntax
    MLF.X.Check
    MLF.X.Pretty
    MLF.X.Parser

executable emlf
  import: settings
  ghc-options: -rtsopts -with-rtsopts=-A32m
  hs-source-dirs: app
  main-is: Main.hs
  other-modules: Paths_mlf
  autogen-modules: Paths_mlf
  build-depends: mlf, directory, filepath

test-suite mlf-tests
  import: settings
  type: exitcode-stdio-1.0
  hs-source-dirs: test, examples
  main-is: Main.hs
  other-modules: Oracle, Computations, Datatypes, Typeclasses, DoNotation, GraphValidation, GraphUnification, GraphUnificationReference, GraphSolver
  build-depends: mlf, directory

test-suite figure12-tests
  import: settings
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Figure12Main.hs
  other-modules: Figure12
  build-depends: mlf

test-suite backend-tests
  import: settings
  type: exitcode-stdio-1.0
  hs-source-dirs: test, examples
  main-is: BackendMain.hs
  other-modules: Backends, BackendCases, IOTests, PreludeTests, Snake, SnakeBaseline
  build-depends: mlf, directory, filepath, process, bytestring, text, unix

benchmark compiler-bench
  import: settings
  type: exitcode-stdio-1.0
  hs-source-dirs: bench
  main-is: Main.hs
  build-tool-depends: mlf:emlf
  build-depends: directory, process
