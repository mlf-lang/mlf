cabal-version: 3.0
name: mlf
version: 0.1.0.0
synopsis: Evidence-producing eMLF to xMLF compiler
description: Graph-based type inference and explicit elaboration following Yakobowski's thesis.
category: Language
build-type: Simple
license: BSD-3-Clause
license-file: LICENSE
extra-source-files:
  mlfpkg, mlf-package.json, mlf.lock, docs/package-manager.md, scripts/bootstrap-package.sh,
  package/*.emlf, package/Package/*.emlf, package/mlf-package.json, bootstrap/mlf-package.json,
  examples/packages/*.emlf, examples/packages/mlf-package.json,
  examples/packages/greeting/*.emlf, examples/packages/greeting/mlf-package.json,
  examples/packages/message/*.emlf, examples/packages/message/mlf-package.json,
  README.md, examples/*.emlf, examples/*.hs, test/fixtures/*.emlf, test/*.c, test/*.py, docs/*.txt, scripts/*.py,
  examples/modules/*.emlf, examples/modules/Geometry/*.emlf,
  benchmarks/*.md, benchmarks/*.json, benchmarks/results/*.json, benchmarks/LICENSE.BenchmarksGame,
  benchmarks/binary-trees/*.md, benchmarks/binary-trees/*.txt,
  benchmarks/binary-trees/c/*.c, benchmarks/binary-trees/c/*.patch,
  benchmarks/binary-trees/rust/*.rs, benchmarks/binary-trees/rust/*.patch,
  benchmarks/binary-trees/haskell/*.hs, benchmarks/binary-trees/mlf/*.emlf,
  benchmarks/pidigits/*.md, benchmarks/pidigits/*.txt,
  benchmarks/pidigits/c/*.c, benchmarks/pidigits/c/*.patch,
  benchmarks/pidigits/rust/*.rs, benchmarks/pidigits/rust/*.patch,
  benchmarks/pidigits/haskell/*.hs, benchmarks/pidigits/mlf/*.emlf,
  benchmarks/n-body/*.md, benchmarks/n-body/*.txt,
  benchmarks/n-body/c/*.c, benchmarks/n-body/rust/*.rs,
  benchmarks/n-body/haskell/*.hs, benchmarks/n-body/mlf/*.emlf,
  benchmarks/fannkuch-redux/*.md, benchmarks/fannkuch-redux/*.txt,
  benchmarks/fannkuch-redux/c/*.c, benchmarks/fannkuch-redux/rust/*.rs,
  benchmarks/fannkuch-redux/rust/*.patch, benchmarks/fannkuch-redux/haskell/*.hs,
  benchmarks/fannkuch-redux/haskell/*.patch, benchmarks/fannkuch-redux/mlf/*.emlf,
  benchmarks/spectral-norm/*.md, benchmarks/spectral-norm/*.txt,
  benchmarks/spectral-norm/c/*.c, benchmarks/spectral-norm/rust/*.rs,
  benchmarks/spectral-norm/rust/*.patch, benchmarks/spectral-norm/haskell/*.hs,
  benchmarks/spectral-norm/mlf/*.emlf,
  benchmarks/fasta/*.md, benchmarks/fasta/*.txt, benchmarks/fasta/c/*.c,
  benchmarks/fasta/rust/*.rs, benchmarks/fasta/haskell/*.hs, benchmarks/fasta/mlf/*.emlf,
  benchmarks/mandelbrot/*.md, benchmarks/mandelbrot/*.pbm,
  benchmarks/mandelbrot/c/*.c, benchmarks/mandelbrot/c/*.patch,
  benchmarks/mandelbrot/rust/*.rs, benchmarks/mandelbrot/rust/*.patch,
  benchmarks/mandelbrot/haskell/*.hs, benchmarks/mandelbrot/haskell/*.patch,
  benchmarks/mandelbrot/mlf/*.emlf,
  benchmarks/reverse-complement/*.md, benchmarks/reverse-complement/*.txt,
  benchmarks/reverse-complement/c/*.c, benchmarks/reverse-complement/c/*.patch,
  benchmarks/reverse-complement/rust/*.rs, benchmarks/reverse-complement/rust/*.patch,
  benchmarks/reverse-complement/haskell/*.hs, benchmarks/reverse-complement/haskell/*.patch,
  benchmarks/reverse-complement/mlf/*.emlf,
  benchmarks/k-nucleotide/*.md, benchmarks/k-nucleotide/*.txt,
  benchmarks/k-nucleotide/c/*.c, benchmarks/k-nucleotide/c/*.patch,
  benchmarks/k-nucleotide/rust/*.rs, benchmarks/k-nucleotide/rust/*.patch,
  benchmarks/k-nucleotide/haskell/*.hs, benchmarks/k-nucleotide/haskell/*.patch,
  benchmarks/k-nucleotide/mlf/*.emlf, runtime/*.md,
  bootstrap/**/*.emlf, bootstrap/**/*.hs, bootstrap/**/*.py, bootstrap/**/*.txt, bootstrap/**/*.md, bootstrap/**/*.expected,
  bootstrap/tests/*.c
data-files: runtime/mlf_runtime.c, runtime/mlf_runtime.h, runtime/khash.h, runtime/mlf_system.h

common settings
  default-language: Haskell2010
  ghc-options: -Wall -Wcompat -Wincomplete-uni-patterns -Wincomplete-record-updates
  build-depends: base >=4.14 && <5, array >=0.5 && <0.6, containers >=0.6 && <0.9, mtl >=2.2 && <2.4, parsec >=3.1 && <3.2

library
  import: settings
  build-depends: bytestring, text, hashtables ==1.4.2, directory, filepath, process, unix >=2.8
  hs-source-dirs: src
  exposed-modules:
    MLF.Compiler
    MLF.Module.Syntax
    MLF.Module
    MLF.Separate
    MLF.Prelude
    MLF.Desugar
    MLF.Surface
    MLF.Layout
    MLF.Primitive
    MLF.Runtime
    MLF.SystemIO
    MLF.LLVM
    MLF.LLVM.Optimize
    MLF.LLVM.Analysis
    MLF.LLVM.StrictFields
    MLF.LLVM.Codegen
    MLF.LLVM.Kernel
    MLF.Classes
    MLF.Kind
    MLF.Kinding
    MLF.Data
    MLF.Data.Parser
    MLF.Syntax
    MLF.Parser
    MLF.Graph
    MLF.Graph.Solver
    MLF.Constraint
    MLF.Elaborate
    MLF.Evidence
    MLF.X.Type
    MLF.X.Syntax
    MLF.X.Check
    MLF.X.Pretty
    MLF.X.Parser

executable emlf
  import: settings
  ghc-options: -rtsopts -with-rtsopts=-A32m
  hs-source-dirs: app
  main-is: Main.hs
  other-modules: Paths_mlf
  autogen-modules: Paths_mlf
  build-depends: mlf, directory, filepath

test-suite mlf-tests
  import: settings
  type: exitcode-stdio-1.0
  hs-source-dirs: test, examples
  main-is: Main.hs
  other-modules: Oracle, Computations, Datatypes, Typeclasses, DoNotation, SurfaceSyntax, Readability, Modules, Separate, GraphValidation, GraphUnification, GraphUnificationReference, GraphSolver, EmbeddingPruning, OptimizerQueries, StrictFieldAnalysis, StateCases, StateTypes
  build-depends: mlf, directory, filepath

test-suite figure12-tests
  import: settings
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Figure12Main.hs
  other-modules: Figure12
  build-depends: mlf

test-suite backend-tests
  import: settings
  ghc-options: -threaded
  type: exitcode-stdio-1.0
  hs-source-dirs: test, examples
  main-is: BackendMain.hs
  build-tool-depends: mlf:emlf
  other-modules: Backends, BackendCases, IOTests, PreludeTests, Snake, SnakeBaseline, NativeOptimization, ConstructorProjection, ForceReuse, BoolConditions, EnvironmentAccess, StrictFields, NumericArrays, ByteArrays, DNA, Readability, Modules, ModuleBackends, Separate, SeparateBackends, BootstrapPrimitives, StateCases, StateTypes, StateRuntime, HigherOrderSpecialization
  build-depends: mlf, directory, filepath, process, bytestring, text, unix

benchmark compiler-bench
  import: settings
  type: exitcode-stdio-1.0
  hs-source-dirs: bench
  main-is: Main.hs
  build-tool-depends: mlf:emlf
  build-depends: directory, process, hashtables ==1.4.2, hashable ==1.5.1.0

test-suite benchmark-harness-tests
  import: settings
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: BenchmarkHarnessMain.hs
  build-tool-depends: mlf:emlf
  build-depends: directory, process

-- Validate the compiler written in MLF with independently specified outcomes.
test-suite bootstrap-port-tests
  import: settings
  ghc-options: -threaded
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: BootstrapPortMain.hs
  build-tool-depends: mlf:emlf
  other-modules: Backends
  build-depends: mlf, directory, filepath, process, bytestring, text, unix
