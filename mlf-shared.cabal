cabal-version: 3.0
name: mlf-shared
version: 0.3.0
build-type: Simple
license: BSD-3-Clause
license-file: LICENSE
synopsis: The same MLF implementation source built by native MLF or GHC

library
  hs-source-dirs: libraries/mlf-async, libraries/mlf-crates, libraries/mlf-developer-tools, libraries/mlf-foundation, libraries/mlf-frontend, libraries/mlf-inference, libraries/mlf-interpreter, libraries/mlf-language-core, libraries/mlf-llvm, libraries/mlf-package-core, libraries/mlf-xmlf, bootstrap, package, tests, tests/shared, testing, host/ghc
  exposed-modules: MLF.Tests.PRQuickMain, Tests.BuildReceipts, MLF.Tests.BuildReceipts, Async.Process, Async.Process.Internal, Async.Task, Async.Task.Core, Async.Task.Internal, Bootstrap.Classes, Bootstrap.Compiler, Bootstrap.CompilerCore, Bootstrap.Constraint, Bootstrap.Crate, Bootstrap.CrateArtifact, Bootstrap.CrateCodegen, Bootstrap.CrateQuery, Bootstrap.Data, Bootstrap.Dependency, Bootstrap.Desugar, Bootstrap.Elaborate, Bootstrap.Evidence, Bootstrap.Fresh, Bootstrap.Graph, Bootstrap.Graph.Solver, Bootstrap.Host, Bootstrap.InferenceUnit, Bootstrap.IntMap, Bootstrap.IntSet, Bootstrap.Kind, Bootstrap.Kinding, Bootstrap.LLVM, Bootstrap.LLVM.Analysis, Bootstrap.LLVM.Build, Bootstrap.LLVM.Codegen, Bootstrap.LLVM.Kernel, Bootstrap.LLVM.Native, Bootstrap.LLVM.Optimize, Bootstrap.LLVM.StrictFields, Bootstrap.LLVM.StrictWrappers, Bootstrap.Layout, Bootstrap.Lexer, Bootstrap.Map, Bootstrap.Module, Bootstrap.Parsec, Bootstrap.Parser, Bootstrap.Prelude, Bootstrap.Primitive, Bootstrap.ProcessHost, Bootstrap.Regex, Bootstrap.Runtime, Bootstrap.ST, Bootstrap.Separate, Bootstrap.Set, Bootstrap.SourceEquality, Bootstrap.Std, Bootstrap.Standalone, Bootstrap.Surface, Bootstrap.Types, Bootstrap.Unicode, Bootstrap.Version, Bootstrap.X.Check, Bootstrap.X.Checked, Bootstrap.X.Parser, Bootstrap.X.Pretty, Bootstrap.X.Syntax, Bootstrap.X.Type, MLF.Entry.CompilerTests, MLF.Entry.Emlf, MLF.Entry.Mlfpkg, MLF.Entry.TupleList, MLF.Tests.Async.ProcessMain, MLF.Tests.Async.ProcessPanic, MLF.Tests.Async.TaskMain, MLF.Tests.Async.TaskProcesses, MLF.Tests.Async.TaskWaitGraph, MLF.Tests.SharedFrontend, Package.Benchmark, Package.Build, Package.Command, Package.Distribution, Package.Json, Package.Manifest, Package.OS, Package.Release, Package.Scheduler, Package.Verification, Tests.Catalog, Tests.CompilerTests, Tests.CorePartitions, Tests.Coverage, Tests.IndependentCheck, Tests.IndependentType, Tests.Selection, Tests.TestDrivers, Tests.TestSources, MLF.Host.IO, Test.Assert, Test.Case, Test.Runner, Test.Descriptor, Test.Registry, Test.Outcome, Test.Expectation, Tests.TupleList, Tests.TupleListLegacy
  other-modules: MLF.Primitive, MLF.Host.Base, MLF.Host.Async
  build-depends: base >= 4.22 && < 4.23, array >= 0.5.8 && < 0.6, bytestring >= 0.12.2 && < 0.13, text >= 2.1.3 && < 2.2, containers >= 0.8 && < 0.9, directory >= 1.3.10 && < 1.4
  default-language: Haskell2010
  ghc-options: -fpedantic-bottoms -fno-state-hack
  c-sources: host/ghc/cbits/host.c, runtime/mlf_process_supervisor.c
  include-dirs: runtime

executable emlf
  hs-source-dirs: host/ghc/app/emlf
  main-is: Main.hs
  build-depends: base >= 4.22 && < 4.23, mlf-shared
  default-language: Haskell2010
  ghc-options: -fpedantic-bottoms -fno-state-hack -rtsopts=ignoreAll

