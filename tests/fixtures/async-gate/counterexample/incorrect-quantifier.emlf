-- Type-only counterexample. NEVER run this fixture or provide this signature.
-- IO returns an already polymorphic CELL, admitting unrelated instantiations.
data GateCell a = GateCell (a -> IO Unit) (IO a);
let newCompletion : IO (forall a. GateCell a) = panic "invalid contract" in
let resolve : forall a. GateCell a -> a -> IO Unit = \(GateCell write read) -> write in
let observe : forall a. GateCell a -> IO a = \(GateCell write read) -> read in
ioBind newCompletion (\(cell : forall a. GateCell a) ->
  ioBind (resolve cell 42) (\_ -> ioBind (observe cell) putStrLn))
