module Gate.CompletionInterface (GateCell, newCompletion, resolve, observe) where

-- Type-only model, deliberately not an implementation. Allocation is bottom.
-- This module is never run. Hidden, invariant fields model a typed read/write
-- interface without introducing any unsafe conversion or primitive.
data GateCell a = GateCell (a -> IO Unit) (IO a)

newCompletion : forall a. IO (GateCell a)
newCompletion = panic "type-only completion allocation must not execute"

resolve : forall a. GateCell a -> a -> IO Unit
resolve (GateCell write read) = write

observe : forall a. GateCell a -> IO a
observe (GateCell write read) = read
