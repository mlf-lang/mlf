module Main where
import Prelude hiding (Monad, return, bind)
import MLF.Primitive (Monad, return, bind)
import Bootstrap.Types
import qualified Package.OS as O
import qualified Test.Case as C
import qualified Test.Runner as Runner
import qualified Tests.CoreRegistry as Registry
import qualified RecursiveInventoryDiscovery as Discovery
import qualified Tests.CrateQueries as Queries
import qualified Bootstrap.Std as S
import Tests.Modules (moduleCases)
import Tests.Separate (separateCases)
labels = (:) "modules typing: cross-module qualified recursion generalizes shared exports" ((:) "crate typing: cross-module qualified recursion generalizes shared exports" ((:) "modules checking: cyclic empty imports carry defining-module instances" ((:) "crate checking: cyclic empty imports carry defining-module instances" ((:) "modules typing: cross-module recursion infers unsigned cycle" ((:) "crate typing: cross-module recursion infers unsigned cycle" ((:) "modules rejection: downstream orphan cannot leak into an import cycle" ((:) "crate rejects: downstream orphan cannot leak into an import cycle" ((:) "modules rejection: instance not visible in imported signed definition" ((:) "crate rejects: instance not visible in imported signed definition" ((:) "modules rejection: instance not visible in another instance" ((:) "crate rejects: instance not visible in another instance" [])))))))))))

cases : Either String ([] C.Case)
cases = do
 modules <- Registry.registerFamily "core-modules" false ((,) "core/modules" (Registry.recoverable moduleCases))
 crates <- Registry.registerFamily "core-modules" false ((,) "core/separate-compilation" (Registry.recoverable separateCases))
 let selected = S.filter (\entry -> S.elem eqString (C.name entry) labels) (S.append modules crates)
 ensure (S.length selected == S.length labels) "focused module case identity mismatch"
 let queryLabel = Queries.canonicalKeyLabel
 let queryFamily = "core/incremental-crate-cache"
 bindings <- case Registry.familyBindings queryFamily of { Nothing -> Left "missing query family"; Just rows -> Right rows }
 identity <- case S.lookup eqString queryLabel bindings of { Nothing -> Left "missing canonical query test"; Just name -> Right name }
 let query = C.test identity queryLabel ((:) ("family:" ++ queryFamily) []) Queries.canonicalKeyAssertions
 Right ((:) Discovery.registryCheck ((:) query selected))

ensure condition error = if condition then Right () else Left error

main : IO ()
main = case cases of
 Left error -> O.fatal error
 Right entries -> Runner.main entries
