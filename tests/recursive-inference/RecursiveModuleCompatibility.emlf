module Main where
import Bootstrap.Types
import qualified RecursiveInventoryDiscovery as Discovery
import qualified Tests.CrateQueries as Queries
import qualified Bootstrap.Std as S
import Tests.Modules (moduleTests)
import Tests.Separate (separateTests)
labels = Cons "modules typing: cross-module qualified recursion generalizes shared exports" (Cons "crate typing: cross-module qualified recursion generalizes shared exports" (Cons "modules checking: cyclic empty imports carry defining-module instances" (Cons "crate checking: cyclic empty imports carry defining-module instances" (Cons "modules typing: cross-module recursion infers unsigned cycle" (Cons "crate typing: cross-module recursion infers unsigned cycle" (Cons "modules rejection: downstream orphan cannot leak into an import cycle" (Cons "crate rejects: downstream orphan cannot leak into an import cycle" (Cons "modules rejection: instance not visible in imported signed definition" (Cons "crate rejects: instance not visible in imported signed definition" (Cons "modules rejection: instance not visible in another instance" (Cons "crate rejects: instance not visible in another instance" Nil)))))))))))
main = do { Discovery.main; (let selected = S.filter (\(Pair label _) -> eqString label "query encodings preserve semantics and normalize lexical names") Queries.crateQueryTests in if S.length selected == 1 then S.mapM_ (\(Pair _ action) -> action) selected else panic "missing canonical query test"); (let cases = S.filter (\(Pair label action) -> S.elem eqString label labels) (S.append moduleTests separateTests) in if S.length cases == 12 then S.mapM_ (\(Pair label action) -> do { putStrLn label; action }) cases else panic "focused module case identity mismatch") }
