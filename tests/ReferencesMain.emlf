module ReferencesMain where
import Bootstrap.Types
import qualified Bootstrap.Std as S
import qualified Package.OS as O
import qualified Tests.GraphReference as G
import qualified Tests.GraphScopesReference as Sc
import qualified Tests.GraphDenseReference as D
import qualified Tests.OrderedTraversalReference as T
import qualified Tests.InferenceReference as I
import qualified Tests.EmbeddingPruning as E
main = do
 args <- O.allArguments
 case args of
  Cons "GraphReference" Nil -> G.main
  Cons "GraphScopesReference" Nil -> Sc.main
  Cons "GraphDenseReference" Nil -> D.main
  Cons "OrderedTraversalReference" Nil -> T.main
  Cons "EmbeddingPruningReference" Nil -> E.pruningConformance
  Cons "InferenceReference" rest -> case I.fixtures of
   Left error -> O.fatal error
   Right fixtures -> case rest of
    Nil -> S.mapM_ (\fixture -> putStrLn (I.report fixture)) fixtures
    Cons "--generate" Nil -> putStr (I.program fixtures)
    _ -> O.fatal "invalid inference reference arguments"
  _ -> O.fatal "invalid reference selection"
