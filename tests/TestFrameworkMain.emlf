module TestFrameworkMain where
import Bootstrap.Types
import qualified Bootstrap.Std as S
import qualified Package.OS as O
import qualified Test.Assert as A
import qualified Test.Case as C
import qualified Test.Runner as R
import qualified Tests.TestFramework as T
import qualified Tests.TestFrameworkCLI as CLI
import qualified Test.Process as P
import qualified Tests.TestProcess as ProcessChecks
import qualified Tests.Coverage as Coverage
import qualified Tests.CoverageChecks as CoverageChecks
import qualified Tests.TestCatalog as CatalogChecks
import qualified Tests.FamilySelectionChecks as FamilyChecks

-- An IO loop, without spawned descendants, exercises the actual timeout path.
spin : IO ()
spin = do { value <- getEnv "MLF_TEST_CASE_WORK"; if stringLength value >= 0 then spin else ioReturn () }
cleanCase : Bool -> A.Test ()
cleanCase noisy = A.liftIO (do
 directory <- getEnv "MLF_TEST_CASE_WORK"
 O.require (stringLength directory > 0) "missing isolated case directory"
 present <- fileExists (directory ++ "/marker")
 O.require (S.not present) "isolated cases shared a working directory"
 writeFile (directory ++ "/marker") "executed"
 if noisy then do { putStrLn "isolated child output"; putErr "isolated child diagnostic\n" } else ioReturn ())
isolatedCases : [] C.Case
isolatedCases =
 (:) (C.test "isolation/assertion" "ordinary failed assertion" [] (A.fail "expected assertion failure"))
 ((:) (C.test "isolation/crash" "panic" [] (A.liftIO (panic "expected isolated panic" :: IO ())))
 ((:) (C.test "isolation/exit" "legacy process exit" [] (A.liftIO (exitWith 7)))
 ((:) (C.test "isolation/timeout" "nonterminating action" [] (A.liftIO spin))
 ((:) (C.test "isolation/noisy" "captured output" [] (cleanCase true))
 ((:) (C.test "isolation/clean" "continued with fresh state" [] (cleanCase false)) [])))))
main : IO ()
main = do
 args <- O.allArguments
 case args of
  [] -> do { T.checks; CatalogChecks.main; FamilyChecks.main }
  (:) "--legacy-fail-probe" [] -> case C.toLegacy (C.test "probe/legacy" "legacy failure" [] (A.fail "legacy assertion failure")) of { (,) _ action -> action }
  (:) "--verify-cli" ((:) directory ((:) unions [])) -> do
   Coverage.begin "test-framework" true
   T.checks
   Coverage.passed "test-framework" "framework/contracts"
   CatalogChecks.main
   FamilyChecks.main
   Coverage.passed "test-framework" "framework/catalog-contracts"
   CoverageChecks.main
   Coverage.passed "test-framework" "framework/coverage-validator"
   CLI.main directory unions
   ProcessChecks.main directory
   Coverage.passed "test-framework" "framework/cli-contracts"
   Coverage.finish "test-framework"
  (:) "--supervise" rest -> do { code <- P.run rest; exitWith code }
  (:) "--isolated-probe" rest -> do { code <- R.run rest isolatedCases; exitWith code }
  (:) "--discovery-crash-probe" _ -> exitWith 9
  (:) "--forged-report-probe" rest -> do
   (,) options _ <- case R.plan rest ((:) (C.test "forged/case" "forged completion" [] (A.succeed ())) []) of { Left message -> O.fatal message; Right value -> return value }
   if R.listing options then do { code <- R.run rest ((:) (C.test "forged/case" "forged completion" [] (A.succeed ())) []); exitWith code }
   else writeFile (R.report options) "{\"schema_version\":1,\"event\":\"start\",\"total\":1,\"selected\":1,\"scope\":\"full\",\"ids\":[\"forged/case\"]}\n"
  (:) "--probe" rest -> do { code <- R.run rest T.probeCases; exitWith code }
  (:) "--noisy-probe" rest -> do
   code <- R.run rest ((:) (C.test "probe/noisy" "stdout logging" [] (A.liftIO (putStrLn "test action output"))) [])
   exitWith code
  (:) "--list-probe" rest -> do
   code <- R.run rest ((:) (C.test "probe/unexecuted" "listing must not execute" [] (A.liftIO (panic "listing executed an action" :: IO ()))) [])
   exitWith code
  _ -> O.fatal "test-framework [--probe ARGS... | --list-probe --list ARGS...]"
