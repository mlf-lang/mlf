showKind : Kind -> String
showKind Star = "*"

showKind (KArrow a b) = (H.append "(" (H.append (showKind a) (H.append ">" (H.append (showKind b) ")"))))

showTag : GTag -> String
showTag t = (case t of { GBot -> "b"; (GBotK k) -> (H.append "k" (showKind k)); (GArr a b) -> (H.append "a" (H.append (H.show a) (H.append "," (H.show b)))); (GCon c xs) -> (H.append "c" (H.append c (H.append "[" (H.append (H.intercalate "," (S.map H.show xs)) "]")))); (GTyCon c k) -> (H.append "t" (H.append c (showKind k))); (GSkolem n k) -> (H.append "s" (H.append (H.show n) (showKind k))); (GTyApp a b) -> (H.append "p" (H.append (H.show a) (H.append "," (H.show b)))); (GGen n) -> (H.append "g" (H.show n)) })

showIds : IntMap Int -> String
showIds table = (H.concat (S.concatMap (\((,) n p) -> ((:) (H.append (H.show n) (H.append ":" (H.append (H.show p) ";"))) [])) (IM.toList table)))

showGraph : Graph -> String
showGraph g = (H.append (H.concat (S.concatMap (\((,) n v) -> ((:) (H.append (H.show n) (H.append ":" (H.append (showTag (G.tag v)) (H.append ":" (H.append (S.maybe "_" H.show (G.binder v)) (H.append ":" (H.append (if (H.eq (G.flag v) Flexible) then "f" else "r") ";"))))))) [])) (IM.toList (G.nodes g)))) (H.append "|" (H.append (showIds (G.links g)) (H.append "|" (H.show (G.nextId g))))))

result : String -> Either String Graph -> IO ()
result label outcome = (putStrLn (H.append label (H.append "|" (S.either (S.const "!") showGraph outcome))))

scoped : Graph
scoped = (Graph (IM.fromList ((:) ((,) 0 (Node (GGen 1) Nothing Flexible)) ((:) ((,) 1 (Node (GCon "Unit" []) (Just 0) Rigid)) ((:) ((,) 2 (Node (GGen 3) (Just 0) Flexible)) ((:) ((,) 3 (Node (GArr 4 5) (Just 2) Rigid)) ((:) ((,) 4 (Node GBot (Just 3) Rigid)) ((:) ((,) 5 (Node GBot (Just 3) Flexible)) ((:) ((,) 6 (Node (GGen 7) (Just 0) Flexible)) ((:) ((,) 7 (Node (GArr 8 9) (Just 6) Flexible)) ((:) ((,) 8 (Node GBot (Just 7) Flexible)) ((:) ((,) 9 (Node (GCon "Int" []) (Just 7) Rigid)) []))))))))))) IM.empty 10)

frontier : Graph
frontier = (Graph (IM.adjust (\v -> (Node (G.tag v) (Just 0) Flexible)) 4 (G.nodes scoped)) (G.links scoped) (G.nextId scoped))

branching : Graph
branching = (let { parent n = (if (H.eq n 0) then Nothing else (if (H.eq n 41) then (Just 0) else (if (H.eq n 31) then (Just 4) else (if true then (Just (n - 1)) else (panic "non-exhaustive test guard"))))) } in (Graph (IM.fromList (H.concat (S.concatMap (\n -> ((:) ((:) ((,) (2 * n) (Node (GGen ((2 * n) + 1)) (S.mapOptional (\section1 -> (section1 * 2)) (parent n)) Flexible)) ((:) ((,) ((2 * n) + 1) (Node GBot (Just (2 * n)) Flexible)) [])) [])) (S.range 0 50)))) IM.empty 102))

closed : Flag -> Int -> String -> Graph
closed f b rightName = (Graph (IM.fromList ((:) ((,) 0 (Node (GGen 1) Nothing Flexible)) ((:) ((,) 1 (Node (GCon "Unit" []) (Just 0) Rigid)) ((:) ((,) 2 (Node (GGen 3) (Just 0) Flexible)) ((:) ((,) 3 (Node (GArr 4 4) (Just 2) Flexible)) ((:) ((,) 4 (Node GBot (Just b) f)) ((:) ((,) 5 (Node (GGen 6) (Just 0) Flexible)) ((:) ((,) 6 (Node (GArr 7 8) (Just 5) Flexible)) ((:) ((,) 7 (Node (GCon "Int" []) (Just 6) Rigid)) ((:) ((,) 8 (Node (GCon rightName []) (Just 6) Rigid)) [])))))))))) IM.empty 9)

closedGraft : Graph
closedGraft = (Graph (IM.fromList ((:) ((,) 0 (Node (GGen 1) Nothing Flexible)) ((:) ((,) 1 (Node (GCon "Unit" []) (Just 0) Rigid)) ((:) ((,) 2 (Node (GGen 3) (Just 0) Flexible)) ((:) ((,) 3 (Node (GArr 4 5) (Just 2) Rigid)) ((:) ((,) 4 (Node (GCon "Int" []) (Just 3) Rigid)) ((:) ((,) 5 (Node (GCon "Bool" []) (Just 3) Rigid)) ((:) ((,) 6 (Node (GGen 7) (Just 0) Flexible)) ((:) ((,) 7 (Node GBot (Just 6) Flexible)) []))))))))) IM.empty 8)

graftChain : Flag -> Graph
graftChain parentFlag = (Graph (IM.union (IM.fromList ((:) ((,) 6 (Node (GGen 8) (Just 0) Flexible)) ((:) ((,) 7 (Node GBot (Just 8) Flexible)) ((:) ((,) 8 (Node (GArr 7 9) (Just 6) parentFlag)) ((:) ((,) 9 (Node (GCon "Int" []) (Just 8) Rigid)) []))))) (G.nodes closedGraft)) (G.links closedGraft) 10)

replaceTarget : Node -> Graph
replaceTarget value = (Graph (IM.insert 7 value (G.nodes closedGraft)) (G.links closedGraft) (G.nextId closedGraft))

checkDemand : IO ()
checkDemand = do { (S.unless ((S.not (G.inert closedGraft 7)) && (S.not (G.inert (replaceTarget (Node (GBotK (KArrow Star Star)) (Just 6) Flexible)) 7))) (H.fail "bottom inertness changed")); do { (putStrLn "bottom short-circuit: ok"); do { (S.unless ((H.eq (G.permission closedGraft 7) Green) && ((H.eq (G.permission (graftChain Flexible) 7) Green) && ((H.eq (G.permission (graftChain Rigid) 7) Red) && (H.eq (G.permission (replaceTarget (Node GBot (Just 6) Rigid)) 7) Orange)))) (H.fail "graft permission cases changed")); do { (case (Solver.prepare (replaceTarget (Node GBot Nothing Flexible))) of { (Left _) -> (return ()); (Right _) -> (H.fail "unbound graft target was accepted") }); do { (putStrLn "graft guards: ok"); (let { a = (Node GBot Nothing Flexible) } in (let { b = (Node (GCon "Int" []) Nothing Rigid) } in (let { table = (IM.fromList ((:) ((,) 0 a) ((:) ((,) 2 a) ((:) ((,) 3 a) ((:) ((,) 8 a) ((:) ((,) 10 b) [])))))) } in do { (S.unless ((H.eq (IM.toAscList (S.snd (H.splitIntMap 7 table))) ((:) ((,) 8 a) ((:) ((,) 10 b) []))) && (IM.null (S.snd (H.splitIntMap 11 table)))) (H.fail "fresh interval reference changed")); (putStrLn "fresh interval demand: ok") }))) } } } } }

rename : ( Int -> Int ) -> Graph -> Graph
rename f g = (let { rt t = (case t of { (GArr a b) -> (GArr (f a) (f b)); (GGen n) -> (GGen (f n)); (GCon c ns) -> (GCon c (S.map f ns)); (GTyApp a b) -> (GTyApp (f a) (f b)); _ -> t }) } in (Graph (IM.fromList (S.concatMap (\((,) n v) -> ((:) ((,) (f n) (Node (rt (G.tag v)) (S.mapOptional f (G.binder v)) (G.flag v))) [])) (IM.toList (G.nodes g)))) (IM.fromList (S.concatMap (\((,) n p) -> ((:) ((,) (f n) (f p)) [])) (IM.toList (G.links g)))) (f (G.nextId g))))

shiftedGraph : Int -> Graph -> String
shiftedGraph amount graph = (let { identity n = (H.show ((S.id n) + amount)) } in (let { tag value = (case value of { (GArr a b) -> (H.append "a" (H.append (identity a) (H.append "," (identity b)))); (GGen n) -> (H.append "g" (identity n)); (GCon name ns) -> (H.append "c" (H.append name (H.append "[" (H.append (H.intercalate "," (S.map identity ns)) "]")))); (GTyApp a b) -> (H.append "p" (H.append (identity a) (H.append "," (identity b)))); _ -> (showTag value) }) } in (H.append (H.concat (S.concatMap (\((,) n value) -> ((:) (H.append (identity n) (H.append ":" (H.append (tag (G.tag value)) (H.append ":" (H.append (S.maybe "_" identity (G.binder value)) (H.append ":" (H.append (if (H.eq (G.flag value) Flexible) then "f" else "r") ";"))))))) [])) (IM.toAscList (G.nodes graph)))) (H.append "|" (H.append (H.concat (S.concatMap (\((,) n parent) -> ((:) (H.append (identity n) (H.append ":" (H.append (identity parent) ";"))) [])) (IM.toAscList (G.links graph)))) (H.append "|" (identity (G.nextId graph))))))))

shiftedResult : String -> Int -> Either String Graph -> IO ()
shiftedResult label amount resultGraph = (putStrLn (H.append label (H.append "|" (S.either (S.const "!") (shiftedGraph amount) resultGraph))))

checkAscendingNodes : IO ()
checkAscendingNodes = (let { huge = (H.power 10 30) } in (let { entries = (S.concatMap (\key -> ((:) ((,) key (Node (GArr 3 5) (Just 7) Flexible)) [])) ((:) (0 - huge) ((:) (0 - 7) ((:) 0 ((:) 1 ((:) huge [])))))) } in do { (S.unless (H.eq (Map.toAscList (Map.fromDistinctAscList entries)) entries) (H.fail "ascending Integer keys changed")); do { ((H.forM_ (S.range 0 100)) (\count -> (let { nodes = (S.concatMap (\n -> ((:) ((,) ((3 * n) - 70) (Node (GGen n) Nothing Flexible)) [])) (S.range 0 (count - 1))) } in (S.unless (H.eq (IM.fromDistinctAscList nodes) (IM.fromList nodes)) (H.fail "ascending graph node reference changed"))))); (let { deferred = (Node (GCon "Unused" (panic "forced constructor arguments")) (Just (panic "forced binder identity")) Rigid) } in do { (S.unless (H.eq (IM.size (IM.fromDistinctAscList ((:) ((,) 0 deferred) []))) 1) (H.fail "ascending graph node demand changed")); (putStrLn "ascending graph nodes: ok") }) } }))

checkContainment : IO ()
checkContainment = (let { reaches adjacency aliases source target = (let rec { resolve : Int -> Int; resolve n = (S.maybe n resolve (Map.lookup n aliases)) } in (let { wanted = (resolve target) } in (let rec { visit : Set Int -> [] Int -> Bool; visit _ [] = false; visit seen ((:) n pending) = (if (H.eq n wanted) then true else (if (Set.member n seen) then (visit seen pending) else (if true then (visit (Set.insert n seen) (H.append (S.map resolve (Map.findWithDefault [] n adjacency)) pending)) else (panic "non-exhaustive test guard")))) } in (visit Set.empty ((:) (resolve source) []))))) } in (let { keys = (H.rangeStep 3 10 45) } in (let { graph seed = (Graph (IM.fromList (S.concatMap (\n -> ((:) ((,) n (Node (GCon "T" (S.concatMap (\m -> (if ((remInt (((n * 13) + (m * 17)) + (seed * (n + 1))) 97) < 24) then ((:) m []) else [])) keys)) Nothing Flexible)) [])) keys)) (IM.fromList (H.concat (S.concatMap (\n -> ((:) ((:) ((,) (n + 100) n) ((:) ((,) (n + 200) (n + 100)) [])) [])) keys))) 300) } in (let { fixtures = (H.append (S.concatMap (\seed -> ((:) ((,) seed 0) [])) (S.range 0 31)) ((:) ((,) 7 (H.power 10 30)) ((:) ((,) 19 (H.negateInt (H.power 10 30))) []))) } in (let { rows = (S.concatMap (\((,) seed shift) -> ((:) (let { g = (graph seed) } in (let { move n = ((S.id n) + shift) } in (let { adjacency = (Map.fromList (S.concatMap (\((,) n v) -> ((:) ((,) (move n) (S.map move (G.children (G.tag v)))) [])) (IM.toList (G.nodes g)))) } in (let { aliases = (Map.fromList (S.concatMap (\((,) n p) -> ((:) ((,) (move n) (move p)) [])) (IM.toList (G.links g)))) } in (let { sources = (H.append (IM.keys (G.nodes g)) (IM.keys (G.links g))) } in (S.concatMap (\source -> (S.concatMap (\target -> ((:) ((,) (reaches adjacency aliases (move source) (move target)) (IS.member (G.resolve g target) (G.reachable g source))) [])) (H.append sources ((:) 999 [])))) sources)))))) [])) fixtures) } in (let { comparisons = (H.concat rows) } in do { (S.unless ((H.eq (H.length comparisons) 15708) && ((S.all (S.uncurry H.eq) comparisons) && ((S.any S.snd comparisons) && (S.any (S.compose S.not S.snd) comparisons)))) (H.fail "structural containment corpus changed")); do { (putStrLn "structural containment oracle: 15708 comparisons passed"); do { (S.unless (reaches (Map.fromList ((:) ((,) 0 ((:) 1 (panic "forced an unvisited branch"))) ((:) ((,) 1 []) []))) Map.empty 0 1) (H.fail "structural containment demand changed")); (putStrLn "structural containment demand: ok") } } }))))))

main : IO ()
main = do { (putStrLn (H.concatMap (\n -> (H.show (G.permission scoped n))) (S.range 0 9))); do { (result "normalize" (Right (G.normalize scoped))); (let { first = (bind (Solver.prepare scoped) (Solver.unify ((:) ((,) 4 8) []))) } in do { (result "merge" (bind first Solver.finish)); do { (result "rigid" (bind (bind first (Solver.unify ((:) ((,) 8 9) []))) Solver.finish)); do { (result "protected" (bind (bind first (Solver.unify ((:) ((,) 5 9) []))) Solver.finish)); do { ((H.forM_ ((:) 1 ((:) 100000 []))) (\scale -> ((H.forM_ ((:) 0 ((:) (0 - 30) []))) (\shift -> (let { f n = ((scale * n) + shift) } in (result "renamed" (bind (bind (Solver.prepare (rename f scoped)) (Solver.unify ((:) ((,) (f 4) (f 8)) []))) Solver.finish))))))); do { ((H.forM_ ((:) scoped ((:) frontier []))) (\g -> do { (case (G.runBuild g (G.expand 2 0)) of { (Left _) -> (putStrLn "expand|!"); (Right ((,) ((,,) root copies edges) next)) -> (putStrLn (H.append "expand|" (H.append (H.show root) (H.append "|" (H.append (showIds copies) (H.append "|" (H.append (showIds (IM.fromList edges)) (H.append "|" (showGraph next))))))))) }); ((H.forM_ ((:) 3 ((:) 8 []))) (\target -> do { (result "instance" (bind (bind (Solver.prepare g) (Solver.instantiate 2 target)) Solver.finish)); (case (bind (Solver.prepare g) (Solver.witness 2 target)) of { (Left _) -> (putStrLn "witness|!"); (Right ((,) copies solver)) -> (case (Solver.finish solver) of { (Left message) -> (H.fail message); (Right final) -> (putStrLn (H.append "witness|" (H.append (showIds copies) (H.append "|" (showGraph final))))) }) }) })) })); (let { points = ((:) 0 ((:) 1 ((:) 4 ((:) 7 ((:) 15 ((:) 30 ((:) 31 ((:) 40 ((:) 41 ((:) 50 [])))))))))) } in do { ((H.forM_ (S.concatMap (\a -> (S.concatMap (\b -> (if (a < b) then ((:) ((,) a b) []) else [])) points)) points)) (\((,) a b) -> (result "branch" (bind (bind (Solver.prepare branching) (Solver.unify ((:) ((,) ((2 * a) + 1) ((2 * b) + 1)) []))) Solver.finish)))); do { ((H.forM_ ((:) (closed Flexible 2 "Bool") ((:) (closed Rigid 2 "Int") ((:) (closed Flexible 0 "Int") ((:) (closed Flexible 2 "Int") []))))) (\g -> (result "closed" (bind (bind (Solver.prepare g) (Solver.instantiateClosed 2 6)) Solver.finish)))); do { (result "graft" (bind (bind (Solver.prepare closedGraft) (Solver.instantiateClosed 2 7)) Solver.finish)); do { checkDemand; do { (result "graft-flexible-parent" (bind (bind (Solver.prepare (graftChain Flexible)) (Solver.instantiateClosed 2 7)) Solver.finish)); do { (result "graft-rigid-parent" (bind (bind (Solver.prepare (graftChain Rigid)) (Solver.instantiateClosed 2 7)) Solver.finish)); do { (result "graft-rigid-target" (bind (bind (Solver.prepare (replaceTarget (Node GBot (Just 6) Rigid))) (Solver.instantiateClosed 2 7)) Solver.finish)); do { (result "graft-kind-mismatch" (bind (bind (Solver.prepare (replaceTarget (Node (GBotK (KArrow Star Star)) (Just 6) Flexible))) (Solver.instantiateClosed 2 7)) Solver.finish)); do { ((H.forM_ ((:) 1 ((:) 100000 []))) (\scale -> ((H.forM_ ((:) 0 ((:) (0 - 30) []))) (\shift -> (let { f n = ((scale * n) + shift) } in (result "fresh-renamed" (bind (bind (Solver.prepare (rename f scoped)) (Solver.instantiate (f 2) (f 3))) Solver.finish))))))); do { checkAscendingNodes; (let { swap n = (if (H.eq n 4) then 8 else (if (H.eq n 8) then 4 else (if true then n else (panic "non-exhaustive test guard")))) } in do { (result "permuted-projection" (bind (bind (Solver.prepare (rename swap scoped)) (Solver.unify ((:) ((,) (swap 4) (swap 8)) []))) Solver.finish)); (let { sparse n = ((100003 * n) - 9001) } in do { (result "sparse-branch" (bind (bind (Solver.prepare (rename sparse branching)) (Solver.unify ((:) ((,) (sparse 63) (sparse 101)) []))) Solver.finish)); do { ((H.forM_ ((:) (H.power 10 30) ((:) (H.negateInt (H.power 10 30)) []))) (\amount -> do { (shiftedResult "huge-projection" amount (bind (bind (Solver.prepare branching) (Solver.unify ((:) ((,) 63 101) []))) Solver.finish)); do { (shiftedResult "huge-expansion" amount (bind (bind (Solver.prepare scoped) (Solver.instantiate 2 3)) Solver.finish)); (shiftedResult "huge-graft" amount (bind (bind (Solver.prepare closedGraft) (Solver.instantiateClosed 2 7)) Solver.finish)) } })); checkContainment } }) }) } } } } } } } } } }) } } } } }) } }
