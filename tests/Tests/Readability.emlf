module Tests.Readability where
import Bootstrap.Types
import qualified Bootstrap.Std as S
import qualified Package.OS as OS
import qualified Tests.Helpers as H
import Tests.Helpers (Quint(..), Sext(..))
import Bootstrap.Compiler
import Bootstrap.Parser (parseProgram, parseExpr)
import qualified Bootstrap.X.Check as C
import qualified Bootstrap.X.Parser as XP
import Bootstrap.X.Pretty (prettyTerm)
import qualified Bootstrap.X.Syntax as X
import qualified Bootstrap.X.Type as T

checked : String -> IO Compilation
checked source = do { result <- (H.right (compile "<readability>" source)); do { parsed <- (H.right (XP.parseTerm "<readability xMLF>" (prettyTerm (compiledTerm result)))); do { ty <- (H.right (C.checkClosed parsed)); do { (H.assert (T.alphaEq ty (inferredType result)) "target round trip changed type"); do { (H.assert (H.eq (X.erase parsed) (X.erase (compiledTerm result))) "target round trip changed erasure"); (return result) } } } } }

sameLayout : String -> String -> String -> Pair String (IO Unit)
sameLayout label layout explicit = (Pair (H.append "layout: " label) do { a <- (H.right (parseProgram "<layout>" layout)); do { b <- (H.right (parseProgram "<braces>" explicit)); (H.assert (H.eq a b) (H.append "layout changed AST:\n" (H.append (H.show a) (H.append "\n" (H.show b))))) } })

rejects : String -> String -> Phase -> String -> Pair String (IO Unit)
rejects label source expectedPhase reason = (Pair (H.append "readability rejection: " label) (case (compile "<invalid readability>" source) of { (Left err) -> (H.assert ((H.eq (phase err) expectedPhase) && (H.contains reason (diagnostic err))) (H.show err)); (Right result) -> (H.fail (H.append "unexpected acceptance: " (sourceType result))) }))

readabilityTests : (List ( Pair String (IO Unit) ))
readabilityTests = (let rec { containsRec : XErased -> Bool; containsRec e = (case e of { (XELetRec _ _) -> true; (XEAbs _ b) -> (containsRec b); (XEApp a b) -> ((containsRec a) || (containsRec b)); (XELet _ a b) -> ((containsRec a) || (containsRec b)); (XECase a bs) -> ((containsRec a) || (S.any (\(XErasedAlternative _ b) -> (containsRec b)) bs)); _ -> false }) } in (H.append (Cons (sameLayout "top-level data, signatures and equations" "data Maybe a = Nothing | Just a\nget : Maybe Int -> Int\nget Nothing = 0\nget (Just x) = x\nmain = get (Just 42)\n" "data Maybe a = Nothing | Just a; get : Maybe Int -> Int; get Nothing = 0; get (Just x) = x; main = get (Just 42);") (Cons (sameLayout "nested do with a trailing semicolon" "main = do\n  do\n    printInt 1;\n  printInt 2\n" "main = do { do { printInt 1; }; printInt 2 };") (Cons (sameLayout "nested case and do" "data Box = Box Int\nmain = case Box 42 of\n  Box x -> do\n    printInt x\n    putStrLn \"ok\"\n" "data Box = Box Int; main = case Box 42 of { Box x -> do { printInt x; putStrLn \"ok\" } };") (Cons (sameLayout "parenthesized implicit block" "main = ioBind (do\n  printInt 1\n  return 42) (\\x -> printInt x)\n" "main = ioBind (do { printInt 1; return 42 }) (\\x -> printInt x);") (Cons (sameLayout "implicit block in explicit block" "main = do {\n  case true of\n    true -> printInt 1\n    false -> printInt 0\n}\n" "main = do { case true of { true -> printInt 1; false -> printInt 0 } };") (Cons (sameLayout "same-line else closes do" "main = if true then do printInt 1 else do printInt 0\n" "main = if true then do { printInt 1 } else do { printInt 0 };") (Cons (sameLayout "local declaration layout" "main = let\n  x = 20\n  y = 22\n in printInt (x + y)\n" "main = let { x = 20; y = 22 } in printInt (x + y);") (Cons (sameLayout "do local group followed by another statement" "main = do\n  let\n    id x = x\n    n = id 42;\n  printInt n\n" "main = do { let { id x = x; n = id 42; }; printInt n };") (Cons (sameLayout "nested explicit let matches its own in" "main = let\n  x = let { y = 42 } in y\n in printInt x\n" "main = let { x = let { y = 42 } in y } in printInt x;") (Cons (sameLayout "class and instance layout" "class Render a where\n  render : a -> String\ninstance Render Bool where\n  render true = \"yes\"\n  render false = \"no\"\nmain = putStrLn (render true)\n" "class Render a where { render : a -> String }; instance Render Bool where { render true = \"yes\"; render false = \"no\" }; main = putStrLn (render true);") (Cons (sameLayout "explicit braces after a keyword on another line" "main = do\n{ printInt 42 }\n" "main = do { printInt 42 };") (Cons (sameLayout "keywords in comments and strings" "{- do {- where -}\n let of -}\nmain = do\n  putStrLn \"do -- case of { where }\"\n  -- } let\n  printInt 42\n" "main = do { putStrLn \"do -- case of { where }\"; printInt 42 };") (Cons (sameLayout "tabs have tab-stop indentation" "main = do\n\tprintInt 1\n\tprintInt 2\n" "main = do { printInt 1; printInt 2 };") (Cons (sameLayout "indented file" "    inc x = x + 1\n    main = printInt (inc 41)\n" "inc x = x + 1; main = printInt (inc 41);") (Cons (sameLayout "leading comment does not set the top-level column" "{- comment -} inc x = x + 1\nmain = printInt (inc 41)\n" "inc x = x + 1; main = printInt (inc 41);") (Cons (sameLayout "string gap ending before the closing quote" "main = do\n  putStrLn \"a\\\n    \\\"\n  printInt 1\n" "main = do { putStrLn \"a\"; printInt 1 };") (Cons (sameLayout "explicit top-level braces" "{ f x = x; main = f 42; }" "f x = x\nmain = f 42\n") (Cons (Pair "layout: parseExpr accepts an implicit do" do { a <- (H.right (parseExpr "<expr layout>" "do\n  x <- return 42\n  printInt x")); do { b <- (H.right (parseExpr "<expr braces>" "do { x <- return 42; printInt x }")); (H.assert (H.eq a b) "parseExpr layout differs") } }) (Cons (Pair "layout: diagnostics keep original line and column" (case (parseProgram "original.emlf" "main = do\n  printInt )\n") of { (Left err) -> (H.assert (H.contains "original.emlf:2:12:" err) err); (Right p) -> (H.fail (H.show p)) })) (Cons (Pair "recursion: declared polymorphism is independently checked" do { result <- (checked "data Nest a = Leaf a | Step (Nest (Nest a)); depth : forall a. Nest a -> Int; depth (Leaf _) = 0; depth (Step x) = 1 + depth x; main = depth (Step (Leaf (Leaf true)));"); do { (H.assert (T.alphaEq (inferredType result) (XCon "Int" Nil)) (sourceType result)); (H.assert (containsRec (X.erase (compiledTerm result))) "recursion did not reach checked target bindings") } }) (Cons (Pair "recursion: monomorphic closure captures an outer value" do { result <- (checked "let offset = 2 in let rec count n : Int -> Int = if n == 0 then offset else count (n-1) + 1 in count 3"); (H.assert (T.alphaEq (inferredType result) (XCon "Int" Nil)) (sourceType result)) }) (Cons (Pair "recursion: explicit quantifiers preserve their declared order" do { result <- (checked "data List a = Nil | Cons a (List a); foldl : forall a b. (b -> a -> b) -> b -> List a -> b; foldl f z xs = case xs of { Nil -> z; Cons x rest -> foldl f (f z x) rest }; main = foldl (\\count value -> count + 1) 0 (Cons true (Cons false Nil));"); (H.assert (T.alphaEq (inferredType result) (XCon "Int" Nil)) (sourceType result)) }) (Cons (Pair "recursion: unused explicit quantified variables are discharged" do { result <- (checked "count : forall a. Int -> Int; count n = if n == 0 then 0 else 1 + count (n - 1); main = count 4;"); (H.assert (T.alphaEq (inferredType result) (XCon "Int" Nil)) (sourceType result)) }) (Cons (Pair "equations: parameter can shadow the function name" do { result <- (checked "identity identity = identity; main = identity 42;"); (H.assert (T.alphaEq (inferredType result) (XCon "Int" Nil)) (sourceType result)) }) (Cons (rejects "recursive forall cannot specialize to Int" "bad : forall a. a -> a; bad x = if true then 1 else bad x; main = bad true;" Inference "") (Cons (Pair "recursion: mixed signed and inferred group" do { result <- checked "f : Int -> Int; f x = g x; g x = f x; main = f 0;"; H.assert (T.alphaEq (inferredType result) (XCon "Int" Nil)) (sourceType result) }) (Cons (Pair "recursion: unsigned local group" do { result <- checked "let rec f x = if true then x else f x in f 0"; H.assert (T.alphaEq (inferredType result) (XCon "Int" Nil)) (sourceType result) }) (Cons (rejects "recursive existentials are not closed signatures" "f : exists a. Int -> a; f x = f x; main = f 0;" Parsing "requires an explicit closed signature") (Cons (rejects "recursive signature free variable" "f : a -> a; f x = f x; main = f 0;" Inference "unbound") (Cons (rejects "equation arity" "f 0 = 0; f x y = x; main = f 0;" Parsing "different arities") (Cons (rejects "equations must be contiguous" "f 0 = 0; g = 1; f n = n; main = f 1;" Parsing "contiguous") (Cons (rejects "missing constructor equation" "data Maybe a = Nothing | Just a; f (Just x) = x; main = f (Just 1);" Inference "non-exhaustive") (Cons (rejects "missing nested constructor" "data Maybe a = Nothing | Just a; f Nothing = 0; f (Just (Just x)) = x; main = f (Just (Just 1));" Inference "non-exhaustive") (Cons (rejects "integer equations need fallback" "f 0 = 42; main = f 1;" Inference "non-exhaustive") (Cons (rejects "Boolean coverage" "f true = 42; main = f false;" Inference "non-exhaustive") (Cons (rejects "mixed literal types" "f 0 = 1; f \"zero\" = 2; f _ = 3; main = f 0;" Inference "mixed literal") (Cons (rejects "nested case duplicate binder" "data Pair a b = Pair a b; case Pair 1 (Pair 2 3) of { Pair x (Pair x y) -> y }" Inference "duplicate pattern variable") (Cons (rejects "constructor arity in function pattern" "data Pair a b = Pair a b; f (Pair x) = x; main = f (Pair 1 2);" Inference "pattern arity mismatch") (Cons (rejects "pattern variable cannot escape an equation" "data Maybe a = Nothing | Just a; f (Just x) = x; f Nothing = x; main = f (Just 1);" Inference "unbound variable: x") (Cons (rejects "empty implicit do" "main = do\nother = 42\n" Parsing "") (Cons (rejects "dedent closes do before application" "main = do\n  printInt 1\n printInt 2\n" Inference "type constructor mismatch") Nil))))))))))))))))))))))))))))))))))))))))) (S.concatMap (\(Quad label source _ _) -> (Cons (Pair (H.append "readability checking: " label) do { result <- (checked source); (H.assert (T.alphaEq (inferredType result) (XCon "IO" (Cons (XCon "Unit" Nil) Nil))) (sourceType result)) }) Nil)) readabilityPrograms)))

readabilityPrograms : (List ( (Quad (String) (String) ((List ( String ))) (String)) ))
readabilityPrograms = (Cons (Quad "readability: factorial equations" (S.unlines (Cons "fact : Int -> Int" (Cons "fact 0 = 1" (Cons "fact n = n * fact (n - 1)" (Cons "main = do" (Cons "  printInt (fact 0)" (Cons "  printInt (fact 6)" Nil))))))) Nil "1\n720\n") (Cons (Quad "readability: recursive forall order" (S.unlines (Cons "data List a = Nil | Cons a (List a)" (Cons "foldl : forall a b. (b -> a -> b) -> b -> List a -> b" (Cons "foldl f z xs = case xs of { Nil -> z; Cons x rest -> foldl f (f z x) rest }" (Cons "main = printInt (foldl (\\count value -> count + 1) 0 (Cons true (Cons false Nil)))" Nil))))) Nil "2\n") (Cons (Quad "readability: unused recursive forall" (S.unlines (Cons "count : forall a. Int -> Int" (Cons "count n = if n == 0 then 0 else 1 + count (n - 1)" (Cons "main = printInt (count 4)" Nil)))) Nil "4\n") (Cons (Quad "readability: mutual recursion" (S.unlines (Cons "even : Int -> Bool" (Cons "even 0 = true" (Cons "even n = odd (n - 1)" (Cons "odd : Int -> Bool" (Cons "odd 0 = false" (Cons "odd n = even (n - 1)" (Cons "main = do" (Cons "  printInt (if even 20 then 1 else 0)" (Cons "  printInt (if odd 21 then 1 else 0)" Nil)))))))))) Nil "1\n1\n") (Cons (Quad "readability: recursive IO and do-local recursion" (S.unlines (Cons "main = do" (Cons "  let rec" (Cons "    count : Int -> IO Unit" (Cons "    count 0 = putStrLn \"done\"" (Cons "    count n = do" (Cons "      printInt n" (Cons "      count (n - 1)" (Cons "  count 3" Nil))))))))) Nil "3\n2\n1\ndone\n") (Cons (Quad "readability: qualified recursive function" (S.unlines (Cons "repeat : forall (m : * -> *) a. Monad m => Int -> m a -> m a" (Cons "repeat 0 action = action" (Cons "repeat n action = do" (Cons "  action" (Cons "  repeat (n - 1) action" (Cons "main = repeat 2 (putStrLn \"again\")" Nil))))))) Nil "again\nagain\nagain\n") (Cons (Quad "readability: polymorphic recursion" (S.unlines (Cons "data Nest a = Leaf a | Step (Nest (Nest a))" (Cons "depth : forall a. Nest a -> Int" (Cons "depth (Leaf _) = 0" (Cons "depth (Step x) = 1 + depth x" (Cons "main = printInt (depth (Step (Step (Leaf (Leaf (Leaf true))))))" Nil)))))) Nil "2\n") (Cons (Quad "readability: cyclic lazy value" (S.unlines (Cons "data List a = Nil | Cons a (List a)" (Cons "ones : List Int" (Cons "ones = Cons 1 ones" (Cons "prefix : Int -> List Int -> Int" (Cons "prefix 0 _ = 0" (Cons "prefix n Nil = 0" (Cons "prefix n (Cons x xs) = x + prefix (n - 1) xs" (Cons "main = printInt (prefix 2 ones)" Nil))))))))) Nil "2\n") (Cons (Quad "readability: nested patterns and fallback" (S.unlines (Cons "data Maybe a = Nothing | Just a" (Cons "data Pair a b = Pair a b" (Cons "pick (Pair (Just x) (Just y)) = x + y" (Cons "pick (Pair (Just x) _) = x" (Cons "pick _ = 0" (Cons "main = do" (Cons "  printInt (pick (Pair (Just 20) (Just 22)))" (Cons "  printInt (pick (Pair (Just 7) Nothing))" (Cons "  printInt (pick (Pair Nothing (Just 9)))" Nil)))))))))) Nil "42\n7\n0\n") (Cons (Quad "readability: constructor equation order keeps wildcard lazy" (S.unlines (Cons "data Box = Box Int" (Cons "data Choice = Stop | Go" (Cons "spin : Box" (Cons "spin = spin" (Cons "select _ Stop = 42" (Cons "select (Box x) Go = x" (Cons "main = do" (Cons "  printInt (select spin Stop)" (Cons "  printInt (select (Box 7) Go)" Nil)))))))))) Nil "42\n7\n") (Cons (Quad "readability: nested lambda and do patterns" (S.unlines (Cons "data Pair a b = Pair a b" (Cons "main = do" (Cons "  Pair x (Pair y z) <- return (Pair 10 (Pair 20 12))" (Cons "  printInt ((\\(Pair a (Pair b c)) -> a + b + c) (Pair x (Pair y z)))" Nil))))) Nil "42\n") (Cons (Quad "readability: pattern annotation imports the prelude" (S.unlines (Cons "main = case (\\x -> x) of" (Cons "  (f : forall (m : * -> *) a. Monad m => m a -> m a) -> ioBind (f (ioReturn 42)) printInt" Nil))) Nil "42\n") (Cons (Quad "readability: pattern temporary hygiene" (S.unlines (Cons "data Box = Box Int" (Cons "matchValue0 = 40" (Cons "doValue0 = 1" (Cons "readBox (Box x) = x + matchValue0" (Cons "main = do" (Cons "  Box n <- return (Box 1)" (Cons "  printInt (readBox (Box n) + doValue0)" Nil)))))))) Nil "42\n") (Cons (Quad "readability: literal patterns" (S.unlines (Cons "command \"yes\" = 1" (Cons "command \"no\" = 0" (Cons "command _ = -1" (Cons "sign (-1) = \"negative one\"" (Cons "sign 0 = \"zero\"" (Cons "sign _ = \"other\"" (Cons "main = do" (Cons "  printInt (command \"yes\")" (Cons "  printInt (command \"maybe\")" (Cons "  putStrLn (sign (-1))" (Cons "  putStrLn (sign 0)" (Cons "  putStrLn (sign 2)" Nil))))))))))))) Nil "1\n-1\nnegative one\nzero\nother\n") (Cons (Quad "readability: literal case order and wildcard laziness" (S.unlines (Cons "spin : Int" (Cons "spin = spin" (Cons "first _ false = 7" (Cons "first 0 true = 0" (Cons "first _ true = 1" (Cons "main = do" (Cons "  printInt (first spin false)" (Cons "  printInt (case 2 of" (Cons "    1 -> 10" (Cons "    2 -> 20" (Cons "    _ -> 30)" Nil)))))))))))) Nil "7\n20\n") (Cons (Quad "readability: instance equations" (S.unlines (Cons "data Flag = Off | On" (Cons "class Render a where" (Cons "  render : a -> String" (Cons "instance Render Flag where" (Cons "  render Off = \"off\"" (Cons "  render On = \"on\"" (Cons "main = do" (Cons "  putStrLn (render Off)" (Cons "  putStrLn (render On)" Nil)))))))))) Nil "off\non\n") (Cons (Quad "readability: nested conditional IO layout" (S.unlines (Cons "main = do" (Cons "  line <- getLine" (Cons "  if eqString line \"yes\" then do" (Cons "    putStrLn \"selected\"" (Cons "    printInt 42" (Cons "  else do" (Cons "    putStrLn \"other\"" (Cons "  putStrLn \"done\"" Nil))))))))) (Cons "yes" Nil) "selected\n42\ndone\n") (Cons (Quad "readability: local equation group" (S.unlines (Cons "data Maybe a = Nothing | Just a" (Cons "main = let" (Cons "  value Nothing = 0" (Cons "  value (Just x) = x" (Cons " in printInt (value (Just 42))" Nil)))))) Nil "42\n") Nil))))))))))))))))))
