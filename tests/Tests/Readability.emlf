module Tests.Readability where
import Bootstrap.Types
import qualified Bootstrap.Std as S
import qualified Package.OS as OS
import qualified Tests.Helpers as H
import Tests.Helpers (Quint(..), Sext(..))
import Bootstrap.Compiler
import Bootstrap.Parser (parseProgram, parseExpr)
import qualified Bootstrap.X.Check as C
import qualified Bootstrap.X.Parser as XP
import Bootstrap.X.Pretty (prettyTerm)
import qualified Bootstrap.X.Syntax as X
import qualified Bootstrap.X.Type as T

checked : String -> IO Compilation
checked source = do { result <- (H.right (compile "<readability>" source)); do { parsed <- (H.right (XP.parseTerm "<readability xMLF>" (prettyTerm (compiledTerm result)))); do { ty <- (H.right (C.checkClosed parsed)); do { (H.assert (T.alphaEq ty (inferredType result)) "target round trip changed type"); do { (H.assert (H.eq (X.erase parsed) (X.erase (compiledTerm result))) "target round trip changed erasure"); (return result) } } } } }

sameLayout : String -> String -> String -> (,) String (IO ())
sameLayout label layout explicit = ((,) (H.append "layout: " label) do { a <- (H.right (parseProgram "<layout>" layout)); do { b <- (H.right (parseProgram "<braces>" explicit)); (H.assert (H.eq a b) (H.append "layout changed AST:\n" (H.append (H.show a) (H.append "\n" (H.show b))))) } })

rejects : String -> String -> Phase -> String -> (,) String (IO ())
rejects label source expectedPhase reason = ((,) (H.append "readability rejection: " label) (case (compile "<invalid readability>" source) of { (Left err) -> (H.assert ((H.eq (phase err) expectedPhase) && (H.contains reason (diagnostic err))) (H.show err)); (Right result) -> (H.fail (H.append "unexpected acceptance: " (sourceType result))) }))

readabilityTests : ([] ( (,) String (IO ()) ))
readabilityTests = (let rec { containsRec : XErased -> Bool; containsRec e = (case e of { (XELetRec _ _) -> true; (XEAbs _ b) -> (containsRec b); (XEApp a b) -> ((containsRec a) || (containsRec b)); (XELet _ a b) -> ((containsRec a) || (containsRec b)); (XECase a bs) -> ((containsRec a) || (S.any (\(XErasedAlternative _ b) -> (containsRec b)) bs)); _ -> false }) } in (H.append ((:) (sameLayout "top-level data, signatures and equations" "data Maybe a = Nothing | Just a\nget : Maybe Int -> Int\nget Nothing = 0\nget (Just x) = x\nmain = get (Just 42)\n" "data Maybe a = Nothing | Just a; get : Maybe Int -> Int; get Nothing = 0; get (Just x) = x; main = get (Just 42);") ((:) (sameLayout "nested do with a trailing semicolon" "main = do\n  do\n    printInt 1;\n  printInt 2\n" "main = do { do { printInt 1; }; printInt 2 };") ((:) (sameLayout "nested case and do" "data Box = Box Int\nmain = case Box 42 of\n  Box x -> do\n    printInt x\n    putStrLn \"ok\"\n" "data Box = Box Int; main = case Box 42 of { Box x -> do { printInt x; putStrLn \"ok\" } };") ((:) (sameLayout "parenthesized implicit block" "main = ioBind (do\n  printInt 1\n  return 42) (\\x -> printInt x)\n" "main = ioBind (do { printInt 1; return 42 }) (\\x -> printInt x);") ((:) (sameLayout "implicit block in explicit block" "main = do {\n  case true of\n    true -> printInt 1\n    false -> printInt 0\n}\n" "main = do { case true of { true -> printInt 1; false -> printInt 0 } };") ((:) (sameLayout "same-line else closes do" "main = if true then do printInt 1 else do printInt 0\n" "main = if true then do { printInt 1 } else do { printInt 0 };") ((:) (sameLayout "local declaration layout" "main = let\n  x = 20\n  y = 22\n in printInt (x + y)\n" "main = let { x = 20; y = 22 } in printInt (x + y);") ((:) (sameLayout "do local group followed by another statement" "main = do\n  let\n    id x = x\n    n = id 42;\n  printInt n\n" "main = do { let { id x = x; n = id 42; }; printInt n };") ((:) (sameLayout "nested explicit let matches its own in" "main = let\n  x = let { y = 42 } in y\n in printInt x\n" "main = let { x = let { y = 42 } in y } in printInt x;") ((:) (sameLayout "class and instance layout" "class Render a where\n  render : a -> String\ninstance Render Bool where\n  render true = \"yes\"\n  render false = \"no\"\nmain = putStrLn (render true)\n" "class Render a where { render : a -> String }; instance Render Bool where { render true = \"yes\"; render false = \"no\" }; main = putStrLn (render true);") ((:) (sameLayout "explicit braces after a keyword on another line" "main = do\n{ printInt 42 }\n" "main = do { printInt 42 };") ((:) (sameLayout "keywords in comments and strings" "{- do {- where -}\n let of -}\nmain = do\n  putStrLn \"do -- case of { where }\"\n  -- } let\n  printInt 42\n" "main = do { putStrLn \"do -- case of { where }\"; printInt 42 };") ((:) (sameLayout "tabs have tab-stop indentation" "main = do\n\tprintInt 1\n\tprintInt 2\n" "main = do { printInt 1; printInt 2 };") ((:) (sameLayout "indented file" "    inc x = x + 1\n    main = printInt (inc 41)\n" "inc x = x + 1; main = printInt (inc 41);") ((:) (sameLayout "leading comment does not set the top-level column" "{- comment -} inc x = x + 1\nmain = printInt (inc 41)\n" "inc x = x + 1; main = printInt (inc 41);") ((:) (sameLayout "string gap ending before the closing quote" "main = do\n  putStrLn \"a\\\n    \\\"\n  printInt 1\n" "main = do { putStrLn \"a\"; printInt 1 };") ((:) (sameLayout "explicit top-level braces" "{ f x = x; main = f 42; }" "f x = x\nmain = f 42\n") ((:) ((,) "layout: parseExpr accepts an implicit do" do { a <- (H.right (parseExpr "<expr layout>" "do\n  x <- return 42\n  printInt x")); do { b <- (H.right (parseExpr "<expr braces>" "do { x <- return 42; printInt x }")); (H.assert (H.eq a b) "parseExpr layout differs") } }) ((:) ((,) "layout: diagnostics keep original line and column" (case (parseProgram "original.emlf" "main = do\n  printInt )\n") of { (Left err) -> (H.assert (H.contains "original.emlf:2:12:" err) err); (Right p) -> (H.fail (H.show p)) })) ((:) ((,) "recursion: declared polymorphism is independently checked" do { result <- (checked "data Nest a = Leaf a | Step (Nest (Nest a)); depth : forall a. Nest a -> Int; depth (Leaf _) = 0; depth (Step x) = 1 + depth x; main = depth (Step (Leaf (Leaf true)));"); do { (H.assert (T.alphaEq (inferredType result) (XCon "Int" [])) (sourceType result)); (H.assert (containsRec (X.erase (compiledTerm result))) "recursion did not reach checked target bindings") } }) ((:) ((,) "recursion: monomorphic closure captures an outer value" do { result <- (checked "let offset = 2 in let rec count n : Int -> Int = if n == 0 then offset else count (n-1) + 1 in count 3"); (H.assert (T.alphaEq (inferredType result) (XCon "Int" [])) (sourceType result)) }) ((:) ((,) "recursion: explicit quantifiers preserve their declared order" do { result <- (checked "data List a = Nil | Cons a (List a); foldl : forall a b. (b -> a -> b) -> b -> List a -> b; foldl f z xs = case xs of { Nil -> z; Cons x rest -> foldl f (f z x) rest }; main = foldl (\\count value -> count + 1) 0 (Cons true (Cons false Nil));"); (H.assert (T.alphaEq (inferredType result) (XCon "Int" [])) (sourceType result)) }) ((:) ((,) "recursion: unused explicit quantified variables are discharged" do { result <- (checked "count : forall a. Int -> Int; count n = if n == 0 then 0 else 1 + count (n - 1); main = count 4;"); (H.assert (T.alphaEq (inferredType result) (XCon "Int" [])) (sourceType result)) }) ((:) ((,) "equations: parameter can shadow the function name" do { result <- (checked "identity identity = identity; main = identity 42;"); (H.assert (T.alphaEq (inferredType result) (XCon "Int" [])) (sourceType result)) }) ((:) (rejects "recursive forall cannot specialize to Int" "bad : forall a. a -> a; bad x = if true then 1 else bad x; main = bad true;" Inference "") ((:) (rejects "mutual recursion needs every signature" "f : Int -> Int; f x = g x; g x = f x; main = f 0;" Parsing "requires an explicit closed signature") ((:) (rejects "local recursion needs a signature" "let rec f x = f x in f 0" Parsing "requires an explicit closed signature") ((:) (rejects "recursive existentials are not closed signatures" "f : exists a. Int -> a; f x = f x; main = f 0;" Parsing "requires an explicit closed signature") ((:) (rejects "recursive signature free variable" "f : a -> a; f x = f x; main = f 0;" Inference "unbound") ((:) (rejects "equation arity" "f 0 = 0; f x y = x; main = f 0;" Parsing "different arities") ((:) (rejects "equations must be contiguous" "f 0 = 0; g = 1; f n = n; main = f 1;" Parsing "contiguous") ((:) (rejects "missing constructor equation" "data Maybe a = Nothing | Just a; f (Just x) = x; main = f (Just 1);" Inference "non-exhaustive") ((:) (rejects "missing nested constructor" "data Maybe a = Nothing | Just a; f Nothing = 0; f (Just (Just x)) = x; main = f (Just (Just 1));" Inference "non-exhaustive") ((:) (rejects "integer equations need fallback" "f 0 = 42; main = f 1;" Inference "non-exhaustive") ((:) (rejects "Boolean coverage" "f true = 42; main = f false;" Inference "non-exhaustive") ((:) (rejects "mixed literal types" "f 0 = 1; f \"zero\" = 2; f _ = 3; main = f 0;" Inference "mixed literal") ((:) (rejects "nested case duplicate binder" "data Pair a b = Pair a b; case Pair 1 (Pair 2 3) of { Pair x (Pair x y) -> y }" Inference "duplicate pattern variable") ((:) (rejects "constructor arity in function pattern" "data Pair a b = Pair a b; f (Pair x) = x; main = f (Pair 1 2);" Inference "pattern arity mismatch") ((:) (rejects "pattern variable cannot escape an equation" "data Maybe a = Nothing | Just a; f (Just x) = x; f Nothing = x; main = f (Just 1);" Inference "unbound variable: x") ((:) (rejects "empty implicit do" "main = do\nother = 42\n" Parsing "") ((:) (rejects "dedent closes do before application" "main = do\n  printInt 1\n printInt 2\n" Inference "type constructor mismatch") []))))))))))))))))))))))))))))))))))))))))) (S.concatMap (\((,,,) label source _ _) -> ((:) ((,) (H.append "readability checking: " label) do { result <- (checked source); (H.assert (T.alphaEq (inferredType result) (XCon "IO" ((:) (XCon "Unit" []) []))) (sourceType result)) }) [])) readabilityPrograms)))

readabilityPrograms : ([] ( ((,,,) (String) (String) (([] ( String ))) (String)) ))
readabilityPrograms = ((:) ((,,,) "readability: factorial equations" (S.unlines ((:) "fact : Int -> Int" ((:) "fact 0 = 1" ((:) "fact n = n * fact (n - 1)" ((:) "main = do" ((:) "  printInt (fact 0)" ((:) "  printInt (fact 6)" []))))))) [] "1\n720\n") ((:) ((,,,) "readability: recursive forall order" (S.unlines ((:) "data List a = Nil | Cons a (List a)" ((:) "foldl : forall a b. (b -> a -> b) -> b -> List a -> b" ((:) "foldl f z xs = case xs of { Nil -> z; Cons x rest -> foldl f (f z x) rest }" ((:) "main = printInt (foldl (\\count value -> count + 1) 0 (Cons true (Cons false Nil)))" []))))) [] "2\n") ((:) ((,,,) "readability: unused recursive forall" (S.unlines ((:) "count : forall a. Int -> Int" ((:) "count n = if n == 0 then 0 else 1 + count (n - 1)" ((:) "main = printInt (count 4)" [])))) [] "4\n") ((:) ((,,,) "readability: mutual recursion" (S.unlines ((:) "even : Int -> Bool" ((:) "even 0 = true" ((:) "even n = odd (n - 1)" ((:) "odd : Int -> Bool" ((:) "odd 0 = false" ((:) "odd n = even (n - 1)" ((:) "main = do" ((:) "  printInt (if even 20 then 1 else 0)" ((:) "  printInt (if odd 21 then 1 else 0)" [])))))))))) [] "1\n1\n") ((:) ((,,,) "readability: recursive IO and do-local recursion" (S.unlines ((:) "main = do" ((:) "  let rec" ((:) "    count : Int -> IO Unit" ((:) "    count 0 = putStrLn \"done\"" ((:) "    count n = do" ((:) "      printInt n" ((:) "      count (n - 1)" ((:) "  count 3" []))))))))) [] "3\n2\n1\ndone\n") ((:) ((,,,) "readability: qualified recursive function" (S.unlines ((:) "repeat : forall (m : * -> *) a. Monad m => Int -> m a -> m a" ((:) "repeat 0 action = action" ((:) "repeat n action = do" ((:) "  action" ((:) "  repeat (n - 1) action" ((:) "main = repeat 2 (putStrLn \"again\")" []))))))) [] "again\nagain\nagain\n") ((:) ((,,,) "readability: polymorphic recursion" (S.unlines ((:) "data Nest a = Leaf a | Step (Nest (Nest a))" ((:) "depth : forall a. Nest a -> Int" ((:) "depth (Leaf _) = 0" ((:) "depth (Step x) = 1 + depth x" ((:) "main = printInt (depth (Step (Step (Leaf (Leaf (Leaf true))))))" [])))))) [] "2\n") ((:) ((,,,) "readability: cyclic lazy value" (S.unlines ((:) "data List a = Nil | Cons a (List a)" ((:) "ones : List Int" ((:) "ones = Cons 1 ones" ((:) "prefix : Int -> List Int -> Int" ((:) "prefix 0 _ = 0" ((:) "prefix n Nil = 0" ((:) "prefix n (Cons x xs) = x + prefix (n - 1) xs" ((:) "main = printInt (prefix 2 ones)" []))))))))) [] "2\n") ((:) ((,,,) "readability: nested patterns and fallback" (S.unlines ((:) "data Maybe a = Nothing | Just a" ((:) "data Pair a b = Pair a b" ((:) "pick (Pair (Just x) (Just y)) = x + y" ((:) "pick (Pair (Just x) _) = x" ((:) "pick _ = 0" ((:) "main = do" ((:) "  printInt (pick (Pair (Just 20) (Just 22)))" ((:) "  printInt (pick (Pair (Just 7) Nothing))" ((:) "  printInt (pick (Pair Nothing (Just 9)))" [])))))))))) [] "42\n7\n0\n") ((:) ((,,,) "readability: constructor equation order keeps wildcard lazy" (S.unlines ((:) "data Box = Box Int" ((:) "data Choice = Stop | Go" ((:) "spin : Box" ((:) "spin = spin" ((:) "select _ Stop = 42" ((:) "select (Box x) Go = x" ((:) "main = do" ((:) "  printInt (select spin Stop)" ((:) "  printInt (select (Box 7) Go)" [])))))))))) [] "42\n7\n") ((:) ((,,,) "readability: nested lambda and do patterns" (S.unlines ((:) "data Pair a b = Pair a b" ((:) "main = do" ((:) "  Pair x (Pair y z) <- return (Pair 10 (Pair 20 12))" ((:) "  printInt ((\\(Pair a (Pair b c)) -> a + b + c) (Pair x (Pair y z)))" []))))) [] "42\n") ((:) ((,,,) "readability: pattern annotation imports the prelude" (S.unlines ((:) "main = case (\\x -> x) of" ((:) "  (f : forall (m : * -> *) a. Monad m => m a -> m a) -> ioBind (f (ioReturn 42)) printInt" []))) [] "42\n") ((:) ((,,,) "readability: pattern temporary hygiene" (S.unlines ((:) "data Box = Box Int" ((:) "matchValue0 = 40" ((:) "doValue0 = 1" ((:) "readBox (Box x) = x + matchValue0" ((:) "main = do" ((:) "  Box n <- return (Box 1)" ((:) "  printInt (readBox (Box n) + doValue0)" [])))))))) [] "42\n") ((:) ((,,,) "readability: literal patterns" (S.unlines ((:) "command \"yes\" = 1" ((:) "command \"no\" = 0" ((:) "command _ = -1" ((:) "sign (-1) = \"negative one\"" ((:) "sign 0 = \"zero\"" ((:) "sign _ = \"other\"" ((:) "main = do" ((:) "  printInt (command \"yes\")" ((:) "  printInt (command \"maybe\")" ((:) "  putStrLn (sign (-1))" ((:) "  putStrLn (sign 0)" ((:) "  putStrLn (sign 2)" []))))))))))))) [] "1\n-1\nnegative one\nzero\nother\n") ((:) ((,,,) "readability: literal case order and wildcard laziness" (S.unlines ((:) "spin : Int" ((:) "spin = spin" ((:) "first _ false = 7" ((:) "first 0 true = 0" ((:) "first _ true = 1" ((:) "main = do" ((:) "  printInt (first spin false)" ((:) "  printInt (case 2 of" ((:) "    1 -> 10" ((:) "    2 -> 20" ((:) "    _ -> 30)" [])))))))))))) [] "7\n20\n") ((:) ((,,,) "readability: instance equations" (S.unlines ((:) "data Flag = Off | On" ((:) "class Render a where" ((:) "  render : a -> String" ((:) "instance Render Flag where" ((:) "  render Off = \"off\"" ((:) "  render On = \"on\"" ((:) "main = do" ((:) "  putStrLn (render Off)" ((:) "  putStrLn (render On)" [])))))))))) [] "off\non\n") ((:) ((,,,) "readability: nested conditional IO layout" (S.unlines ((:) "main = do" ((:) "  line <- getLine" ((:) "  if eqString line \"yes\" then do" ((:) "    putStrLn \"selected\"" ((:) "    printInt 42" ((:) "  else do" ((:) "    putStrLn \"other\"" ((:) "  putStrLn \"done\"" []))))))))) ((:) "yes" []) "selected\n42\ndone\n") ((:) ((,,,) "readability: local equation group" (S.unlines ((:) "data Maybe a = Nothing | Just a" ((:) "main = let" ((:) "  value Nothing = 0" ((:) "  value (Just x) = x" ((:) " in printInt (value (Just 42))" [])))))) [] "42\n") []))))))))))))))))))
