compilerTests : ([] ( (,) String (IO ()) ))
compilerTests = ((:) (hasType "identity" "\\x -> x" identity) ((:) (hasType "constant 42" "42" int) ((:) (hasType "boolean" "true" bool) ((:) (hasType "identity self-application" "(\\x -> x) (\\y -> y)" identity) ((:) (hasType "let polymorphism" "let id = \\x -> x in let number = id 42 in id true" bool) ((:) (hasType "lambda scope is not generalized" "\\x -> let y = x in y" identity) ((:) (hasType "lexical shadowing" "let x = true in (\\x -> x) 42" int) ((:) (hasType "let RHS sees outer binding" "let x = true in let x = x in x" bool) ((:) (hasType "application under an unannotated lambda" "\\f x -> f x" (allT 0 XBot (allT 1 XBot (XArrow (XArrow (v 0) (v 1)) (XArrow (v 0) (v 1)))))) ((:) (hasType "K preserves its polymorphic return bound" "\\x y -> x" (allT 0 XBot (allT 1 (allT 2 XBot (XArrow (v 2) (v 0))) (XArrow (v 0) (v 1))))) ((:) (hasType "g g" (H.append choosePrefix "let g = choose id in g g") chooseId) ((:) (hasType "g g applied to identity" (H.append choosePrefix "let g = choose id in g g id 42") int) ((:) (rejects "g g retains its identity lower bound" (H.append choosePrefix "let g = choose id in g g 42")) ((:) (hasType "closed annotation" "(\\x -> x) : forall a. a -> a" identity) ((:) (hasType "let annotation" "let id : forall a. a -> a = \\x -> x in id" identity) ((:) (hasType "bounded annotation" "(\\x -> x) : forall (a >= forall b. b -> b). a -> a" chooseId) ((:) (hasType "annotated self-application" "\\(f : forall a. a -> a) -> f f" (allT 1 identity (XArrow identity (v 1)))) ((:) (hasType "polymorphic parameter at distinct instances" "(\\(f : forall a. a -> a) -> let a = f 42 in f true) (\\x -> x)" bool) ((:) (hasType "impredicative result" "(\\(f : forall a. a -> a) -> f f) (\\x -> x)" identity) ((:) (hasType "partial annotation" "((\\x -> \\y -> y) : exists a. a -> (forall b. b -> b)) 42" identity) ((:) (hasType "existential root" "(\\x -> x) : exists a. a" identity) ((:) (hasType "existential annotation shares both sides" "(\\x -> x) : exists a. a -> a" identity) ((:) (hasType "alias bounds normalized before xMLF" "(\\x -> x) : forall a (b >= a). b -> b" identity) ((:) (hasType "inert bounds inlined" "(\\x -> x) : forall (a >= Int). a -> a" (XArrow int int)) ((:) (hasType "unused bounds disappear" "(\\x -> x) : forall unused a. a -> a" identity) ((:) (hasType "forall a.a equivalent to its bound" "(\\x -> x) : forall (a >= forall b. b -> b). a" identity) ((:) (hasType "annotation alpha-renaming" "(\\x -> x) : forall z. z -> z" identity) ((:) (hasType "parameterized type constructor" "(\\x -> x) : forall a. List a -> List a" (allT 0 XBot (XArrow (XCon "List" ((:) (v 0) [])) (XCon "List" ((:) (v 0) []))))) ((:) (accepts "rigid polymorphic bound" "(\\x -> x) : forall (a = forall b. b -> b). a -> a") ((:) (accepts "multiple quantified variables" "(\\x y -> x) : forall a b. a -> b -> a") ((:) (accepts "shared type has independent lexical binders" "let id = let id = \\x -> x in id in \\ignored -> (\\x y -> x) (\\x -> true)") ((:) (accepts "arbitrary-rank annotation" "\\(f : ((forall a. a -> a) -> Int) -> Int) -> f (\\(id : forall a. a -> a) -> id 42)") ((:) (rejects "unannotated self-application" "\\x -> x x") ((:) (rejects "inconsistent monomorphic argument" "\\f -> let a = f 42 in f true") ((:) (rejects "integer is not a function" "42 true") ((:) (rejects "cannot satisfy universal identity with an integer result" "(\\x -> 42) : forall a. a -> a") ((:) (rejects "distinct skolems cannot merge" "(\\x -> x) : forall a b. a -> b") ((:) (rejects "wrong closed annotation" "42 :: Bool") ((:) (rejects "cannot invent a polymorphic value" "42 : forall a. a") ((:) (rejects "free source variable" "missing") ((:) (rejects "recursive let is not implicit" "let x = x in x") ((:) (rejects "type annotation has a free variable" "(\\x -> x) : a -> a") ((:) (rejects "constructor arity" "42 :: Int Bool") ((:) ((,) "trailing input is rejected" (H.reject (parseExpr "<test>" "42 )"))) ((:) ((,) "parser handles nested comments" do { r <- (compileOK "{- outer {- inner -} -} let id = \\x -> x in -- a comment\n id 42"); (sameType (inferredType r) int) }) ((:) ((,) "generated computations are necessary" do { r <- (compileOK "(\\x -> x) 42"); (H.reject (C.checkClosed (stripComputations (compiledTerm r)))) }) []))))))))))))))))))))))))))))))))))))))))))))))

families : [] ((,) String ([] ((,) String (IO ()))))
families =
 (:) ((,) "core/substring-adapter" [])
 ((:) ((,) "core/inference-and-annotations" compilerTests)
