checked : String -> IO XTerm
checked source = do { term <- (H.fmap compiledTerm (H.right (compile "<DNA test>" source))); do { parsed <- (H.right (XP.parseTerm "<DNA xMLF>" (prettyTerm term))); do { (S.unless (H.eq (X.erase term) (X.erase parsed)) (H.fail "DNA round trip changed erasure")); (return parsed) } } }

run : B.Backends -> String -> Input -> Bytes.Bytes -> String -> IO ()
run backends source input expected unused = do { term <- (checked source); do { result <- (B.execute backends IOEntry input term); do { (H.right (B.outcome result)); (S.unless ((H.eq (B.outputBytes result) expected) && (H.eq (B.remaining result) unused)) (H.fail (H.show result))) } } }

dnaTests : B.Backends -> ([] ( ((,) (String) (IO ())) ))
dnaTests backends = ((:) ((,) "byte input: raw bytes, blank lines, final line and repeated EOF" (let { source = (H.append recursion (H.append "let echo : Int -> IO Unit = fix (\\again n -> ifThenElse (eqInt n 0) (return ()) " (H.append "(do { line <- getByteLine; count <- lengthByteArray line; printInt count; " "putBytes line 0 count; again (subInt n 1) })) in echo 5"))) } in (let { bytes = (BS.pack ((:) 0 ((:) 128 ((:) 255 ((:) 10 ((:) 10 ((:) 65 []))))))) } in (run backends source (RawInput bytes false) (H.append (ASCII.pack "4\n") (H.append (BS.pack ((:) 0 ((:) 128 ((:) 255 ((:) 10 []))))) (ASCII.pack "1\n\n1\nA0\n0\n"))) "")))) ((:) ((,) "byte input: shared reads execute again and mix with getLine" (let { source = (H.append "let read = getByteLine in do { let unused = read; a <- read; " (H.append "b <- read; writeByteArray a 0 88; n <- lengthByteArray b; putBytes b 0 n; " "text <- getLine; putStrLn text }")) } in (run backends source (Input "first\nsecond\nλ😀\nunused\n" false) (BS.pack ((:) 115 ((:) 101 ((:) 99 ((:) 111 ((:) 110 ((:) 100 ((:) 10 ((:) 206 ((:) 187 ((:) 240 ((:) 159 ((:) 152 ((:) 128 ((:) 10 []))))))))))))))) "unused\n"))) ((:) ((,) "byte input: long raw line grows without decoding" (let { bytes = (H.append (BS.pack (S.take 17000 (H.cycle ((:) 0 ((:) 128 ((:) 255 ((:) 65 []))))))) (ASCII.pack "\n")) } in (run backends "do { a <- getByteLine; n <- lengthByteArray a; putBytes a 0 n }" (RawInput (H.append bytes (ASCII.pack "tail")) false) bytes "tail"))) ((:) ((,) "byte input: buffer boundaries preserve mixed reads and retained lines" ((H.forM_ ((:) 65535 ((:) 65536 ((:) 65537 [])))) (\size -> (let { first = (H.append (BS.pack (S.take size (H.cycle ((:) 0 ((:) 128 ((:) 255 ((:) 65 []))))))) (ASCII.pack "\n")) } in (let { text = (BS.pack ((:) 206 ((:) 187 ((:) 240 ((:) 159 ((:) 152 ((:) 128 ((:) 10 [])))))))) } in (let { next = (ASCII.pack "next\n") } in (run backends "do { first <- getByteLine; text <- getLine; next <- getByteLine; putStrLn text; n <- lengthByteArray first; putBytes first 0 n; m <- lengthByteArray next; putBytes next 0 m }" (RawInput (H.append first (H.append text (H.append next (ASCII.pack "tail")))) false) (H.append text (H.append first next)) "tail"))))))) ((:) ((,) "byte input: discarded action does not consume input" (run backends "do { return getByteLine; putStrLn \"ok\" }" (RawInput (BS.pack ((:) 255 [])) false) (ASCII.pack "ok\n") (stringFromCode 255))) ((:) ((,) "byte input: invalid UTF-8 still fails for text input" do { term <- (checked "do { getLine; putStrLn \"unreachable\" }"); do { result <- (B.execute backends IOEntry (RawInput (BS.pack ((:) 255 ((:) 10 ((:) 65 [])))) false) term); (let guardSubject5 = (B.outcome result) in (let guardNext7 = \ignored -> (let guardNext6 = \ignored -> (panic "non-exhaustive test case") in (case guardSubject5 of { _ -> (H.fail (H.show result)) })) in (case guardSubject5 of { (Left err) -> (if ((H.eq (H.show err) "IO error: invalid UTF-8 input") && (H.eq (B.remaining result) "A")) then (return ()) else (guardNext7 ())); _ -> (guardNext7 ()) }))) } }) ((:) ((,) "table: fresh actions, aliasing, overwrite and snapshot reads" (run backends (H.append "let make = newIntTable in do { a <- make; b <- make; let alias = a; " (H.append "let read = readIntTable a 7; x <- read; writeIntTable alias 7 23; y <- read; " (H.append "writeIntTable a 7 (-4); z <- read; other <- readIntTable b 7; " "printInt x; printInt y; printInt z; printInt other }"))) (Input "" false) (ASCII.pack "0\n23\n-4\n0\n") "")) ((:) ((,) "table: generic applications and unbounded signed keys and values" (run backends (H.append "do { make <- return newIntTable; read <- return readIntTable; write <- return writeIntTable; t <- make; " (H.append "write t (-1) 5000000000000000042; write t 4611686018427387904 12; " (H.append "write t (-4611686018427387905) 13; write t 6000000000000000000 14; " (H.append "write t (-6000000000000000000) 15; " (H.append "a <- read t (-1); b <- read t (addInt 4611686018427387903 1); " (H.append "c <- read t (subInt (-4611686018427387904) 1); " (H.append "d <- read t (subInt 6000000000000000001 1); " (H.append "e <- read t (-6000000000000000000); f <- read t 0; " "printInt a; printInt b; printInt c; printInt d; printInt e; printInt f }")))))))) (Input "" false) (ASCII.pack "5000000000000000042\n12\n13\n14\n15\n0\n") "")) ((:) ((,) "table: native counting loop grows and updates collision-prone keys" (let { source = (H.append recursion (H.append "let count : IntTable -> Int -> IO Unit = fix (\\again t n -> ifThenElse (eqInt n 0) (return ()) " (H.append "(do { let key = mulInt (remInt n 67) 4294967296; old <- readIntTable t key; " (H.append "writeIntTable t key (addInt old 1); again t (subInt n 1) })) in " (H.append "do { t <- newIntTable; count t 135; x <- readIntTable t 0; " "y <- readIntTable t 4294967296; z <- readIntTable t 283467841536; printInt x; printInt y; printInt z }"))))) } in do { term <- (checked source); do { llvm <- (H.right (emitLLVMIO term)); do { (S.unless ((H.contains "define private ptr @mlf.numeric." llvm) && (H.contains "call ptr @mlf_add_int_table" llvm)) (H.fail "table loop did not use the native region")); do { result <- (B.execute backends IOEntry (Input "" false) term); do { (H.right (B.outcome result)); (S.unless (H.eq (B.output result) "2\n3\n2\n") (H.fail (H.show result))) } } } } })) ((:) ((,) "native IO: nested collections preserve caller values and prior results" (let { source = (H.append recursion (H.append "let consume : ByteArray -> Int -> IO ByteArray = fix (\\again last n -> " (H.append "ifThenElse (eqInt n 0) (return last) (do { line <- getByteLine; again line (subInt n 1) })) in " (H.append "let read : Int -> IO ByteArray = \\n -> do { first <- getByteLine; " (H.append "last <- consume first n; count <- lengthByteArray first; putBytes first 0 count; return last } in " (H.append "do { a <- read 80; b <- read 80; " "na <- lengthByteArray a; nb <- lengthByteArray b; putBytes a 0 na; putBytes b 0 nb }")))))) } in (let { input = (H.append "first\n" (H.append (H.concat (S.replicate 79 "churn\n")) (H.append "last\n" (H.append "second\n" (H.append (H.concat (S.replicate 79 "other\n")) "end\n"))))) } in do { term <- (checked source); do { llvm <- (H.right (emitLLVMIO term)); do { (S.unless (S.all (\section4 -> (H.contains section4 llvm)) ((:) "call void @mlf_gc_check" ((:) "call void @mlf_roots_enter" []))) (H.fail "fixture missed nested native collection")); do { result <- (B.execute backends IOEntry (Input input false) term); do { (H.right (B.outcome result)); (S.unless ((H.eq (B.output result) "first\nsecond\nlast\nend\n") && (H.null (B.remaining result))) (H.fail (H.show result))) } } } } }))) ((:) ((,) "table fusion: snapshots, large signed keys and promotion across updates" (let { source = (H.append recursion (H.append "let update : IntTable -> IntArray -> Int -> Int -> IO Unit = \\t out key delta -> do { " (H.append "old <- readIntTable t key; writeIntTable t key (addInt old delta); writeIntArray out 0 old } in " (H.append "do { t <- newIntTable; out <- newIntArray 1 0; " (H.append "writeIntTable t (-7000000000000000000) 4611686018427387903; " (H.append "update t out (-7000000000000000000) 1; a <- readIntArray out 0; " (H.append "b <- readIntTable t (-7000000000000000000); " (H.append "update t out (-7000000000000000000) (-4611686018427387909); " (H.append "c <- readIntArray out 0; d <- readIntTable t (-7000000000000000000); " (H.append "update t out 7 (-2); e <- readIntArray out 0; f <- readIntTable t 7; " "printInt a; printInt b; printInt c; printInt d; printInt e; printInt f }")))))))))) } in do { term <- (checked source); do { llvm <- (H.right (emitLLVMIO term)); do { (S.unless (H.contains "call ptr @mlf_add_int_table" llvm) (H.fail "fixture did not fuse the table update")); do { result <- (B.execute backends IOEntry (Input "" false) term); do { (H.right (B.outcome result)); (S.unless (H.eq (B.output result) "4611686018427387903\n4611686018427387904\n4611686018427387904\n-5\n0\n-2\n") (H.fail (H.show result))) } } } } })) ((:) ((,) "table fusion: intervening writes and unequal keys retain their order" (run backends (H.append "let update : IntTable -> Int -> Int -> IO Unit = \\t a b -> do { " (H.append "old <- readIntTable t a; writeIntTable t a 9; writeIntTable t b (addInt old 1) } in " (H.append "do { t <- newIntTable; writeIntTable t 1 3; update t 1 2; " "a <- readIntTable t 1; b <- readIntTable t 2; printInt a; printInt b }"))) (Input "" false) (ASCII.pack "9\n4\n") "")) ((:) ((,) "table: GMP keys and values and pending IO survive collection" (run backends (H.append recursion (H.append "let churn : Int -> IO Unit = fix (\\again n -> ifThenElse (eqInt n 0) (return ()) " (H.append "(do { t <- newIntTable; writeIntTable t n (mulInt n 7000000000000000000); again (subInt n 1) })) in " (H.append "do { t <- newIntTable; writeIntTable t 7000000000000000100 6000000000000000031; " (H.append "let read = readIntTable t (addInt 7000000000000000099 1); churn 600; old <- read; " "writeIntTable t 7000000000000000100 42; churn 600; new <- read; printInt old; printInt new }"))))) (Input "" false) (ASCII.pack "6000000000000000031\n42\n") "")) ((:) ((,) "table: unused actions do not demand failing operands" (run backends "do { t <- newIntTable; return (writeIntTable t (quotInt 1 0) (quotInt 2 0)); return (readIntTable t (quotInt 1 0)); printInt 7 }" (Input "" false) (ASCII.pack "7\n") "")) ((:) ((,) "table: small keys retain GMP values through collection and promotion" (run backends (H.append recursion (H.append "let churn : Int -> IO Unit = fix (\\again n -> ifThenElse (eqInt n 0) (return ()) " (H.append "(do { a <- newByteArray 1 0; again (subInt n 1) })) in " (H.append "let fill : IntTable -> Int -> IO Unit = fix (\\again t n -> ifThenElse (eqInt n 0) (return ()) " (H.append "(do { writeIntTable t n (addInt 5000000000000000017 n); again t (subInt n 1) })) in " (H.append "let sum : IntTable -> Int -> Int -> IO Int = fix (\\again t n total -> ifThenElse (eqInt n 0) (return total) " (H.append "(do { x <- readIntTable t n; again t (subInt n 1) (addInt total x) })) in " (H.append "do { t <- newIntTable; fill t 100; churn 100; a <- sum t 100 0; " (H.append "writeIntTable t (-5000000000000000017) 42; churn 100; b <- sum t 100 0; " "c <- readIntTable t (-5000000000000000017); printInt a; printInt b; printInt c }"))))))))) (Input "" false) (ASCII.pack "1937910009842113118\n1937910009842113118\n42\n") "")) ((:) ((,) "table: demanded operands fail after preceding effects" ((H.forM_ ((:) "readIntTable t (quotInt 1 0)" ((:) "writeIntTable t 0 (quotInt 1 0)" ((:) "writeIntTable t (quotInt 1 0) (readInt \"not an integer\")" [])))) (\operation -> do { term <- (checked (H.append "do { t <- newIntTable; putStrLn \"before\"; " (H.append operation "; getByteLine }"))); do { result <- (B.execute backends IOEntry (Input "unused\n" false) term); (let guardSubject1 = (B.outcome result) in (let guardNext3 = \ignored -> (let guardNext2 = \ignored -> (panic "non-exhaustive test case") in (case guardSubject1 of { _ -> (H.fail (H.show result)) })) in (case guardSubject1 of { (Left err) -> (if ((H.contains "integer division by zero" (H.show err)) && ((H.eq (B.output result) "before\n") && (H.eq (B.remaining result) "unused\n"))) then (return ()) else (guardNext3 ())); _ -> (guardNext3 ()) }))) } }))) ((:) ((,) "table: nominal types and IO signatures are checked" ((H.forM_ ((:) "data IntTable = Forged; Forged" ((:) "do { t <- newIntTable; readByteArray t 0 }" ((:) "do { a <- newIntArray 1 0; readIntTable a 0 }" ((:) "do { t <- newIntTable; writeIntTable t 0 true }" ((:) "do { t <- newIntTable; readIntTable t 1.0 }" ((:) "getByteLine 1" []))))))) (\source -> (case (compile "<invalid table>" source) of { (Left _) -> (return ()); (Right _) -> (H.fail (H.append "accepted " source)) })))) ((:) ((,) "DNA: reverse-complement ambiguity codes, records and growing buffers" do { source <- (readFile "benchmarks/reverse-complement/mlf/main.emlf"); (let { cases = (H.append ((:) ((,) "" "") ((:) ((,) ">empty\n" ">empty\n") ((:) ((,) ">id description\nacgtumrwsykvhdbn\n" ">id description\nNVHDBMRSWYKAACGT\n") ((:) ((,) ">a\nA\n>b\nCGT" ">a\nT\n>b\nACG\n") ((:) ((,) (H.append ">wide\n" (H.append (H.repeatChar 2100 97) "\n")) (H.append ">wide\n" (H.concat (S.replicate 35 (H.append (H.repeatChar 60 84) "\n"))))) []))))) (S.concatMap (\n -> ((:) ((,) (H.append ">chunks\n" (H.append (H.repeatChar n 97) "\n")) (H.append ">chunks\n" (H.append (H.concat (S.replicate 1024 (H.append (H.repeatChar 60 84) "\n"))) (if (H.eq n 61440) then "" else "T\n")))) [])) ((:) 61440 ((:) 61441 [])))) } in ((H.forM_ cases) (\((,) input expected) -> (run backends source (Input input false) (ASCII.pack expected) "")))) }) ((:) ((,) "DNA: both upstream fixtures" ((H.forM_ ((:) "reverse-complement" ((:) "k-nucleotide" []))) (\name -> (let { path = (H.append "benchmarks/" (H.append name "/")) } in do { source <- (readFile (H.append path "mlf/main.emlf")); do { input <- (BS.readFile (H.append path "input-1000.txt")); do { expected <- (BS.readFile (H.append path "expected-1000.txt")); (run backends source (RawInput input false) expected "") } } })))) ((:) ((,) "DNA: k-nucleotide short inputs, ties, mixed case and record termination" do { source <- (readFile "benchmarks/k-nucleotide/mlf/main.emlf"); (let { zero = "0\tGGT\n0\tGGTA\n0\tGGTATT\n0\tGGTATTTTAATT\n0\tGGTATTTTAATTTATAGT\n" } in do { (run backends source (Input ">ONE\nGGT\n>THREEISH\nGGT\n>THREE\naCgT\n>FOUR\nunused\n" false) (ASCII.pack (H.append "A 25.000\nC 25.000\nG 25.000\nT 25.000\n\nAC 33.333\nCG 33.333\nGT 33.333\n\n" zero)) "unused\n"); do { (run backends source (Input ">THREE\nA" false) (ASCII.pack (H.append "A 100.000\n\n\n" zero)) ""); (run backends source (Input ">THREE\n" false) (ASCII.pack (H.append "\n\n" zero)) "") } }) }) []))))))))))))))))))))

recursion : String
recursion = (H.append "data Rec a = Rec (Rec a -> a); let fix : forall a. (a -> a) -> a = \\f -> " "let go = \\r -> case r of { Rec next -> f (next r) } in go (Rec go) in ")
