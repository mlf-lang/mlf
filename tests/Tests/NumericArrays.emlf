programs : ([] ( ((,,) (String) (String) (String)) ))
programs = ((:) ((,,) "read unbounded signed decimals" "do { printInt (readInt \"+00042\"); printInt (readInt \"-123456789012345678901234567890\"); printInt (readInt \"-0\") }" "42\n-123456789012345678901234567890\n0\n") ((:) ((,,) "curried GMP primitives" "do { mul <- return mulInt; q <- return quotInt; r <- return remInt; printInt (mul 12345678901234567890 10); printInt (q (-19) 3); printInt (r (-19) 3) }" "123456789012345678900\n-6\n-1\n") ((:) ((,,) "curried unbounded bitwise AND" "do { mask <- return andInt; printInt (mask (-1) 1267650600228229401496703205377); printInt (mask (-2) (-3)); printInt (mask 1267650600228229401496703205377 3) }" "1267650600228229401496703205377\n-4\n1\n") ((:) ((,,) "unused bitwise arguments remain lazy" "do { return (andInt (quotInt 1 0) 0); printInt (ifThenElse true 7 (andInt 0 (quotInt 2 0))) }" "7\n") ((:) ((,,) "binary64 arithmetic and scientific literals" "do { putStrLn (formatDouble 9 (sqrtDouble (addDouble (mulDouble 3.0 3.0) (mulDouble 4e0 4.0)))); putStrLn (formatDouble 3 (divDouble (subDouble 1.25 (-2.5)) 2.0)); putStrLn (formatDouble 1 (intToDouble (-42))) }" "5.000000000\n1.875\n-42.0\n") ((:) ((,,) "rounding ties and signed zero" "do { putStrLn (formatDouble 0 2.5); putStrLn (formatDouble 0 3.5); putStrLn (formatDouble 2 1.005); putStrLn (formatDouble 2 (-0.0)); putStrLn (formatDouble 2 (-0.001)) }" "2\n4\n1.00\n-0.00\n-0.00\n") ((:) ((,,) "generic floating primitives and IEEE comparisons" "do { f <- return mulDouble; root <- return sqrtDouble; equal <- return eqDouble; less <- return ltDouble; putStrLn (formatDouble 2 (root (f 2.0 8.0))); printInt (ifThenElse (equal (-0.0) 0.0) 1 0); printInt (ifThenElse (less (-2.0) 1.0) 1 0); printInt (ifThenElse (equal (divDouble 0.0 0.0) 0.0) 1 0); printInt (ifThenElse (less (sqrtDouble (-1.0)) 0.0) 1 0) }" "4.00\n1\n1\n0\n0\n") ((:) ((,,) "IEEE non-finite results" "do { putStrLn (formatDouble 3 (divDouble 1.0 0.0)); putStrLn (formatDouble 3 (divDouble (-1.0) 0.0)); putStrLn (formatDouble 3 (sqrtDouble (-1.0))); putStrLn (formatDouble 3 (mulDouble 1e308 1e308)) }" "Infinity\n-Infinity\nNaN\nInfinity\n") ((:) ((,,) "large integer conversion rounds to nearest" "do { putStrLn (formatDouble 0 (intToDouble 9007199254740995)); putStrLn (formatDouble 0 (intToDouble 4611686018427388672)); putStrLn (formatDouble 0 (intToDouble (-4611686018427388672))) }" "9007199254740996\n4611686018427388928\n-4611686018427388928\n") ((:) ((,,) "IntArray aliasing and repeated action reads" "do { a <- newIntArray 3 7; let alias = a; let read = readIntArray alias 1; x <- read; writeIntArray a 1 123456789012345678901234567890; y <- read; n <- lengthIntArray a; printInt x; printInt y; printInt n }" "7\n123456789012345678901234567890\n3\n") ((:) ((,,) "allocation actions produce distinct arrays" "let new = newIntArray 1 5 in do { a <- new; b <- new; writeIntArray a 0 42; x <- readIntArray b 0; printInt x }" "5\n") ((:) ((,,) "DoubleArray values are copied at read time" "do { a <- newDoubleArray 2 1.5; let read = readDoubleArray a 0; x <- read; writeDoubleArray a 0 (mulDouble x 2.0); y <- read; n <- lengthDoubleArray a; putStrLn (formatDouble 1 x); putStrLn (formatDouble 1 y); printInt n }" "1.5\n3.0\n2\n") ((:) ((,,) "generic ternary writes" "do { write <- return writeIntArray; create <- return newDoubleArray; wd <- return writeDoubleArray; a <- newIntArray 1 0; b <- create 1 0.0; wa <- return (write a 0); wa 42; wd b 0 2.25; x <- readIntArray a 0; y <- readDoubleArray b 0; printInt x; putStrLn (formatDouble 2 y) }" "42\n2.25\n") ((:) ((,,) "unused actions and unselected arithmetic remain lazy" "do { a <- newIntArray 1 1; let ignored = writeIntArray a 0 (quotInt 1 0); return ignored; let bad = newDoubleArray (-1) (sqrtDouble (-1.0)); return bad; x <- readIntArray a 0; printInt x; printInt (ifThenElse true 42 (quotInt 1 0)) }" "1\n42\n") ((:) ((,,) "empty arrays have zero length" "do { a <- newIntArray 0 0; b <- newDoubleArray 0 0.0; x <- lengthIntArray a; y <- lengthDoubleArray b; printInt (addInt x y) }" "0\n") ((:) ((,,) "array roots and boxed cells survive collection" (H.append recursion (H.append "let loop : IntArray -> DoubleArray -> Int -> IO Unit = fix (\\again a b n -> ifThenElse (eqInt n 0) (return ()) (do { x <- readIntArray a 0; y <- readDoubleArray b 0; writeIntArray a 0 (addInt x 1); writeDoubleArray b 0 (addDouble y 0.5); again a b (subInt n 1) })) in " "do { a <- newIntArray 1 123456789012345678901234567890; b <- newDoubleArray 1 0.0; loop a b 300; x <- readIntArray a 0; y <- readDoubleArray b 0; printInt x; putStrLn (formatDouble 1 y) }")) "123456789012345678901234568190\n150.0\n") []))))))))))))))))

failures : ([] ( ((,,) (String) (String) (String)) ))
failures = ((:) ((,,) "quotient by zero" "printInt (quotInt 4611686018427387904 0)" "integer division by zero") ((:) ((,,) "remainder by zero" "printInt (remInt 1 0)" "integer division by zero") ((:) ((,,) "bitwise zero mask still demands its argument" "printInt (andInt 0 (quotInt 1 0))" "integer division by zero") ((:) ((,,) "direct bitwise arguments are ordered" "printInt (andInt (readInt \"bad\") (quotInt 1 0))" "invalid integer input") ((:) ((,,) "curried bitwise arguments are ordered" "do { mask <- return andInt; printInt (mask (readInt \"bad\") (quotInt 1 0)) }" "invalid integer input") ((:) ((,,) "empty integer input" "printInt (readInt \"\")" "invalid integer input") ((:) ((,,) "signed empty input" "printInt (readInt \"-\")" "invalid integer input") ((:) ((,,) "whitespace integer input" "printInt (readInt \" 1\")" "invalid integer input") ((:) ((,,) "embedded NUL input" "printInt (readInt \"1\\0\")" "invalid integer input") ((:) ((,,) "fractional integer input" "printInt (readInt \"1.5\")" "invalid integer input") ((:) ((,,) "negative precision" "putStrLn (formatDouble (-1) 1.0)" "Double precision must be between 0 and 17") ((:) ((,,) "large precision" "putStrLn (formatDouble 999999999999999999999 1.0)" "Double precision must be between 0 and 17") ((:) ((,,) "negative array length" "newIntArray (-1) 0" "invalid array length") ((:) ((,,) "huge array length" "newDoubleArray 999999999999999999999 0.0" "invalid array length") ((:) ((,,) "negative read index" "do { a <- newIntArray 1 0; readIntArray a (-1) }" "array index out of bounds") ((:) ((,,) "huge read index" "do { a <- newIntArray 1 0; readIntArray a 999999999999999999999 }" "array index out of bounds") ((:) ((,,) "empty array read" "do { a <- newDoubleArray 0 0.0; readDoubleArray a 0 }" "array index out of bounds") ((:) ((,,) "integer write past end" "do { a <- newIntArray 2 0; writeIntArray a 2 3 }" "array index out of bounds") ((:) ((,,) "negative Double write" "do { a <- newDoubleArray 1 0.0; writeDoubleArray a (-1) 3.0 }" "array index out of bounds") ((:) ((,,) "writes force stored values" "do { a <- newIntArray 1 0; writeIntArray a 0 (quotInt 1 0) }" "integer division by zero") ((:) ((,,) "direct floating arguments are ordered" "putStrLn (formatDouble 1 (addDouble (intToDouble (readInt \"bad\")) (intToDouble (quotInt 1 0))))" "invalid integer input") ((:) ((,,) "curried floating arguments are ordered" "do { add <- return addDouble; putStrLn (formatDouble 1 (add (intToDouble (readInt \"bad\")) (intToDouble (quotInt 1 0)))) }" "invalid integer input") []))))))))))))))))))))))

recursion : String
recursion = "data Rec a = Rec (Rec a -> a); let fix : forall a. (a -> a) -> a = \\f -> let go = \\r -> case r of { Rec next -> f (next r) } in go (Rec go) in "
