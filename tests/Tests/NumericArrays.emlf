checked : String -> IO XTerm
checked source = do { term <- (H.fmap compiledTerm (H.right (compile "<numeric/array test>" source))); do { parsed <- (H.right (XP.parseTerm "<numeric/array xMLF>" (prettyTerm term))); do { (S.unless (H.eq (X.erase term) (X.erase parsed)) (H.fail "numeric/array serialization changed erasure")); (return parsed) } } }

observe : B.Backends -> XTerm -> String -> IO Unit
observe backends term expected = do { result <- (B.execute backends IOEntry (Input "" false) term); do { (H.right (B.outcome result)); (S.unless (H.eq (B.output result) expected) (H.fail (H.append (H.show result) (H.append "; expected " (H.show expected))))) } }

numericArrayTests : B.Backends -> (List ( (Pair (String) (IO Unit)) ))
numericArrayTests backends = (H.append (S.concatMap (\(Triple label source expected) -> (Cons (Pair (H.append "native scalar arguments: " label) do { term <- (checked (H.append recursion source)); do { llvm <- (H.right (emitLLVMIO term)); do { (S.unless (S.any (\line -> ((H.contains "define private ptr @mlf.numeric." line) && (H.contains "double %a" line))) (H.lines llvm)) (H.fail "fixture did not exercise an unboxed Double worker")); (observe backends term expected) } } }) Nil)) scalarPrograms) (H.append (S.concatMap (\(Triple label source expected) -> (Cons (Pair (H.append "native numeric region: " label) do { term <- (checked (H.append recursion source)); do { llvm <- (H.right (emitLLVMIO term)); do { (S.unless (H.contains "define private ptr @mlf.numeric." llvm) (H.fail "fixture did not produce a native numeric region")); do { result <- (B.execute backends IOEntry (Input "" false) term); (case expected of { (Right output) -> (bind (H.right (B.outcome result)) (\ignored -> (S.unless (H.eq (B.output result) output) (H.fail (H.show result))))); (Left message) -> (let guardSubject1 = (B.outcome result) in (let guardNext3 = \ignored -> (let guardNext2 = \ignored -> (panic "non-exhaustive test case") in (case guardSubject1 of { _ -> (H.fail (H.show result)) })) in (case guardSubject1 of { (Left err) -> (if ((H.contains message (H.show err)) && (H.eq (B.output result) "before\n")) then (return Unit) else (guardNext3 Unit)); _ -> (guardNext3 Unit) }))) }) } } } }) Nil)) regionPrograms) (H.append (S.concatMap (\(Triple label source expected) -> (Cons (Pair (H.append "numeric: " label) (bind (checked source) (\term -> (observe backends term expected)))) Nil)) programs) (H.append (S.concatMap (\(Triple label source message) -> (Cons (Pair (H.append "numeric failure: " label) do { term <- (checked (H.append "do { putStrLn \"before\"; " (H.append source " }"))); do { result <- (B.execute backends IOEntry (Input "" false) term); (let guardSubject4 = (B.outcome result) in (let guardNext6 = \ignored -> (let guardNext5 = \ignored -> (panic "non-exhaustive test case") in (case guardSubject4 of { _ -> (H.fail (H.show result)) })) in (case guardSubject4 of { (Left err) -> (if ((H.contains message (H.show err)) && (H.eq (B.output result) "before\n")) then (return Unit) else (guardNext6 Unit)); _ -> (guardNext6 Unit) }))) } }) Nil)) failures) (Cons (Pair "native numeric region: multiplication and division retain arbitrary precision" (let { limit = (H.power 2 62) } in (let { values = (Cons (0 - (H.power 2 100)) (Cons ((0 - limit) - 1) (Cons (0 - limit) (Cons (0 - 3) (Cons 0 (Cons 3 (Cons (limit - 1) (Cons limit (Cons (H.power 2 100) Nil))))))))) } in (let { pairs = (S.concatMap (\a -> (S.concatMap (\b -> (Cons (Pair a b) Nil)) (Cons (0 - 1) (Cons 2 (Cons (limit - 1) Nil))))) values) } in (let { ops = (Cons "mulInt x y" (Cons "quotInt x (-1)" (Cons "remInt x (-1)" (Cons "quotInt x 3" (Cons "remInt x 3" (Cons "quotInt x (-3)" (Cons "remInt x (-3)" (Cons "andInt x y" Nil)))))))) } in (let { width = (H.length ops) } in (let { expected (Pair a b) = (Cons (a * b) (Cons (quotInt a (0 - 1)) (Cons (remInt a (0 - 1)) (Cons (quotInt a 3) (Cons (remInt a 3) (Cons (quotInt a (0 - 3)) (Cons (remInt a (0 - 3)) (Cons (andInt a b) Nil)))))))) } in (let { source = (H.append recursion (H.append "let loop : IntArray -> IntArray -> Int -> IO Unit = fix (\\again a b i -> " (H.append "ifThenElse (ltInt i " (H.append (H.show (H.length pairs)) (H.append ") (do { " (H.append "x <- readIntArray a (mulInt i 2); y <- readIntArray a (addInt (mulInt i 2) 1); " (H.append (H.concat (S.concatMap (\(Pair j op) -> (Cons (H.append "writeIntArray b (addInt (mulInt i " (H.append (H.show width) (H.append ") " (H.append (H.show j) (H.append ") (" (H.append op "); ")))))) Nil)) (S.zip (S.range 0 9223372036854775807) ops))) (H.append "again a b (addInt i 1) }) (return ())) in " (H.append "let dump : IntArray -> Int -> IO Unit = fix (\\again a i -> " (H.append "ifThenElse (ltInt i " (H.append (H.show ((H.length pairs) * width)) (H.append ") " (H.append "(do { x <- readIntArray a i; printInt x; again a (addInt i 1) }) (return ())) in " (H.append "do { a <- newIntArray " (H.append (H.show ((H.length pairs) * 2)) (H.append " 0; " (H.append (H.concat (S.concatMap (\(Pair i n) -> (Cons (H.append "writeIntArray a " (H.append (H.show i) (H.append " (" (H.append (H.show n) "); ")))) Nil)) (S.zip (S.range 0 9223372036854775807) (H.concatMap (\(Pair a b) -> (Cons a (Cons b Nil))) pairs)))) (H.append "b <- newIntArray " (H.append (H.show ((H.length pairs) * width)) " 0; loop a b 0; dump b 0 }"))))))))))))))))))) } in do { (H.assert (S.length values == 9 && S.length (S.nubBy eqInt values) == 9 && S.length pairs == 27 && width == 8 && S.length (H.concatMap expected pairs) == 216) "arithmetic boundary coverage changed"); term <- (checked source); do { llvm <- (H.right (emitLLVMIO term)); do { (S.unless (S.all (\section14 -> (H.contains section14 llvm)) (Cons "call { i64, i1 } @llvm.smul.with.overflow.i64" (Cons "sdiv i64" (Cons "srem i64" Nil)))) (H.fail "arithmetic boundary fixture missed the native fast paths")); (observe backends term (S.unlines (S.map H.show (H.concatMap expected pairs)))) } } })))))))) (Cons (Pair "native scalar arguments: recursive permutations bound specialization" (let { arguments = (S.concatMap (\i -> (Cons (H.append "x" (H.show i)) Nil)) (S.range 1 9)) } in (let { source = (H.append recursion (H.append "let start : " (H.append (H.concat (S.replicate 9 "Double -> ")) (H.append "IO Double = \\" (H.append (S.unwords arguments) (H.append " -> let rotate : Int -> " (H.append (H.concat (S.replicate 10 "Double -> ")) (H.append "IO Double = fix (\\again n first " (H.append (S.unwords arguments) (H.append " -> " (H.append "ifThenElse (eqInt n 0) (return first) (again (subInt n 1) " (H.append (S.unwords arguments) (H.append " (addDouble first 0.0))) in rotate 21 1.0 " (H.append (S.unwords arguments) (H.append " in " (H.append "do { x <- start " (H.append (S.unwords (S.concatMap (\i -> (Cons (H.append (H.show i) ".0") Nil)) (S.range 2 10))) "; putStrLn (formatDouble 1 x) }"))))))))))))))))) } in do { term <- (checked source); do { llvm <- (H.right (emitLLVMIO term)); (let { prefix = "define private ptr @mlf.numeric." } in (let { counts = ((S.compose (S.map H.length) (S.compose H.group H.sort)) (S.concatMap (\line -> (if (H.eq (H.stringTake (H.length prefix) line) prefix) then (if (S.not (H.contains "@mlf.numeric.entry." line)) then (Cons (H.stringTakeWhile (\c -> ((S.not (H.eq c 46)) && (S.not (H.eq c 40)))) (H.stringDrop (H.length prefix) line)) Nil) else Nil) else Nil)) (H.lines llvm))) } in do { (S.unless ((H.elem 9 counts) && (S.all (\section13 -> (section13 <= 9)) counts)) (H.fail (H.append "specialization cap was not exercised: " (H.show counts)))); (observe backends term "2.0\n") })) } }))) (Cons (Pair "numeric: multiplication and signed quotient boundaries" (let { limit = (H.power 2 62) } in (let { values = (Cons (0 - (H.power 2 100)) (Cons ((0 - limit) - 1) (Cons (0 - limit) (Cons (0 - 1) (Cons 0 (Cons 1 (Cons 3 (Cons (limit - 1) (Cons limit (Cons (H.power 2 100) Nil)))))))))) } in (let { pairs = (S.concatMap (\a -> (S.concatMap (\b -> (Cons (Pair a b) Nil)) values)) values) } in (let { cases = (H.concat (S.concatMap (\(Pair a b) -> (Cons (H.append (Cons (Quad PMulInt a b (a * b)) (Cons (Quad PAndInt a b (andInt a b)) Nil)) (if (S.not (H.eq b 0)) then (S.concatMap (\(Pair p op) -> (Cons (Quad p a b (op a b)) Nil)) (Cons (Pair PQuotInt quotInt) (Cons (Pair PRemInt remInt) Nil))) else Nil)) Nil)) pairs)) } in (let { apply p a b = (XApp (XApp (XPrimitive p Nil) (XIntTerm a)) (XIntTerm b)) } in (let { printNumber x = (XApp (XPrimitive PPrintInt Nil) x) } in (let { unit = (XCon "Unit" Nil) } in (let { sequence' = (S.foldr (\(Pair i a) b -> (XApp (XApp (XPrimitive PIOBind (Cons unit (Cons unit Nil))) a) (XAbs (XName i "ignored") unit b))) (XApp (XPrimitive PIOReturn (Cons unit Nil)) (XConstructor "Unit" Nil))) } in (observe backends (sequence' (S.zip (S.range 1000 9223372036854775807) (S.concatMap (\(Quad p a b _) -> (Cons (printNumber (apply p a b)) Nil)) cases))) (S.unlines (S.concatMap (\(Quad _ _ _ n) -> (Cons (H.show n) Nil)) cases)))))))))))) (Cons (Pair "numeric: types reject invalid numeric and array programs" ((H.forM_ (Cons "addDouble 1 2.0" (Cons "sqrtDouble 1" (Cons "addInt 1.0 2.0" (Cons "andInt 1 2.0" (Cons "do { a <- newIntArray 2 0; writeIntArray a 0 1.0 }" (Cons "do { a <- newDoubleArray 2 0.0; readIntArray a 0 }" (Cons "do { a <- newIntArray 2 0; printInt (readIntArray a 0) }" (Cons "data Double = Forged; Forged" (Cons "data IntArray = Forged; Forged" (Cons "data DoubleArray = Forged; Forged" (Cons "putStrLn (formatDouble 2 1e9999)" Nil)))))))))))) (\source -> (case (compile "<invalid numeric/array test>" source) of { (Left _) -> (return Unit); (Right _) -> (H.fail (H.append "accepted: " source)) })))) (Cons (Pair "numeric: non-finite target literal rejected by both backends" ((H.forM_ (Cons (divDouble 0.0 0.0) (Cons (divDouble 1.0 0.0) (Cons (divDouble (-1.0) 0.0) Nil)))) (\value -> (let { term = (XApp (XPrimitive PIOReturn (Cons (XCon "Double" Nil) Nil)) (XDoubleTerm value)) } in do { parsed <- (H.right (XP.parseTerm "<non-finite xMLF>" (prettyTerm term))); do { (case parsed of { (XApp _ (XDoubleTerm actual)) -> (S.unless (if (H.isNaN value) then (H.isNaN actual) else (eqDouble actual value)) (H.fail "target serialization changed a non-finite Double")); _ -> (H.fail "target serialization lost a non-finite Double") }); do { result <- (B.execute backends IOEntry (Input "" false) parsed); (let guardSubject10 = (B.outcome result) in (let guardNext12 = \ignored -> (let guardNext11 = \ignored -> (panic "non-exhaustive test case") in (case guardSubject10 of { _ -> (H.fail (H.show result)) })) in (case guardSubject10 of { (Left err) -> (if ((H.contains "non-finite Double literal" (H.show err)) && (H.null (B.events result))) then (return Unit) else (guardNext12 Unit)); _ -> (guardNext12 Unit) }))) } } })))) (Cons (Pair "numeric: direct and curried formatting force the same arguments" ((H.forM_ (Cons false (Cons true Nil))) (\generic -> do { term <- (checked (H.append "let bad = intToDouble (quotInt 1 0) in do { putStrLn \"before\"; " (H.append (if generic then "formatter <- return formatDouble; putStrLn (formatter (-1) bad)" else "putStrLn (formatDouble (-1) bad)") " }"))); do { result <- (B.execute backends IOEntry (Input "" false) term); (let guardSubject7 = (B.outcome result) in (let guardNext9 = \ignored -> (let guardNext8 = \ignored -> (panic "non-exhaustive test case") in (case guardSubject7 of { _ -> (H.fail (H.show result)) })) in (case guardSubject7 of { (Left err) -> (if ((H.contains "integer division by zero" (H.show err)) && (H.eq (B.output result) "before\n")) then (return Unit) else (guardNext9 Unit)); _ -> (guardNext9 Unit) }))) } }))) (Cons (Pair "numeric: pidigits benchmark partial and full rows" do { term <- (bind (readFile "benchmarks/pidigits/mlf/main.emlf") checked); ((H.forM_ (Cons (Pair 1 "3         \t:1\n") (Cons (Pair 27 "3141592653\t:10\n5897932384\t:20\n6264338   \t:27\n") Nil))) (\(Pair n expected) -> do { result <- (B.execute backends IOEntry (Input (H.append (H.show n) "\n") false) term); do { (H.right (B.outcome result)); (S.unless ((H.eq (B.output result) expected) && (H.null (B.remaining result))) (H.fail (H.show result))) } })) }) (Cons (Pair "numeric: n-body benchmark initialization and integration" do { term <- (bind (readFile "benchmarks/n-body/mlf/main.emlf") checked); do { fixture <- (readFile "benchmarks/n-body/expected-1000.txt"); ((H.forM_ (Cons (Pair 0 "-0.169075164\n-0.169075164\n") (Cons (Pair 1 "-0.169075164\n-0.169074954\n") (Cons (Pair 1000 fixture) Nil)))) (\(Pair n expected) -> do { result <- (B.execute backends IOEntry (Input (H.append (H.show n) "\n") false) term); do { (H.right (B.outcome result)); (let { numbers = (S.map readDouble (OS.words (B.output result))) } in (let { reference = (S.map readDouble (OS.words expected)) } in (S.unless ((H.eq (H.length numbers) 2) && ((S.all (\(Pair a b) -> ((S.not ((H.isNaN a) || (H.isInfinite a))) && (H.doubleWithin (H.absDouble (subDouble a b)) 1e-8))) (S.zip numbers reference)) && (H.null (B.remaining result)))) (H.fail (H.show result))))) } })) } }) (Cons (Pair "numeric: spectral-norm benchmark small and odd matrices" do { term <- (bind (readFile "benchmarks/spectral-norm/mlf/main.emlf") checked); do { fixture <- (readFile "benchmarks/spectral-norm/expected-100.txt"); ((H.forM_ (Cons (Pair 1 "1.000000000") (Cons (Pair 2 "1.183350177") (Cons (Pair 3 "1.233644501") (Cons (Pair 100 fixture) Nil))))) (\(Pair n expected) -> do { result <- (B.execute backends IOEntry (Input (H.append (H.show n) "\n") false) term); do { (H.right (B.outcome result)); (let { numbers = (S.map readDouble (OS.words (B.output result))) } in (S.unless (case numbers of { (Cons x Nil) -> ((S.not ((H.isNaN x) || (H.isInfinite x))) && (H.doubleWithin (H.absDouble (subDouble x (readDouble (OS.trim expected)))) 1e-8)); _ -> false }) (H.fail (H.show result)))) } })) } }) (Cons (Pair "numeric: fannkuch-redux benchmark checksum and flips" do { term <- (bind (readFile "benchmarks/fannkuch-redux/mlf/main.emlf") checked); do { fixture <- (readFile "benchmarks/fannkuch-redux/expected-7.txt"); ((H.forM_ (Cons (Pair 1 "0\nPfannkuchen(1) = 0\n") (Cons (Pair 2 "-1\nPfannkuchen(2) = 1\n") (Cons (Pair 5 "11\nPfannkuchen(5) = 7\n") (Cons (Pair 7 fixture) Nil))))) (\(Pair n expected) -> do { result <- (B.execute backends IOEntry (Input (H.append (H.show n) "\n") false) term); do { (H.right (B.outcome result)); (S.unless ((H.eq (B.output result) expected) && (H.null (B.remaining result))) (H.fail (H.show result))) } })) } }) Nil))))))))))))))

scalarPrograms : (List ( (Triple (String) (String) (String)) ))
scalarPrograms = (Cons (Triple "captured doubles and nonnegative countdown" (H.append "let start : Double -> IO Double = \\step -> " (H.append "let loop : Int -> Double -> IO Double = fix (\\again n x -> " (H.append "ifThenElse (eqInt 0 n) (return x) (again (subInt n 1) (addDouble x step))) in loop 12 0.0 in " "do { x <- start 0.5; putStrLn (formatDouble 1 x) }"))) "6.0\n") (Cons (Triple "IEEE values survive recursive calls" (H.append "let loop : Int -> Double -> IO Double = fix (\\again n x -> " (H.append "ifThenElse (eqInt n 0) (return x) (again (subInt n 1) (divDouble x 1.0))) in " (H.append "do { a <- newDoubleArray 1 (-0.0); x <- readDoubleArray a 0; r <- loop 3 x; " (H.append "putStrLn (formatDouble 2 r); writeDoubleArray a 0 (divDouble 1.0 0.0); y <- readDoubleArray a 0; " (H.append "s <- loop 3 y; putStrLn (formatDouble 2 s); writeDoubleArray a 0 (divDouble 0.0 0.0); " "z <- readDoubleArray a 0; t <- loop 3 z; putStrLn (formatDouble 2 t) }"))))) "-0.00\nInfinity\nNaN\n") (Cons (Triple "payload reads stay within their branch" (H.append "let loop : Bool -> Int -> Double -> IO Double = fix (\\again flag n x -> " (H.append "ifThenElse (eqInt n 0) (return x) (do { ignored <- ifThenElse flag " (H.append "(return (addDouble x 1.0)) (return 0.0); again flag (subInt n 1) (mulDouble x 2.0) })) in " (H.append "do { x <- loop false 3 1.0; y <- loop true 2 1.0; putStrLn (formatDouble 1 x); " "putStrLn (formatDouble 1 y) }")))) "8.0\n4.0\n") (Cons (Triple "unused failing floating arguments remain lazy" (H.append "let loop : Int -> Double -> Double -> IO Double = fix (\\again n bad x -> " (H.append "ifThenElse (eqInt n 0) (return x) (again (subInt n 1) bad (addDouble x 0.5))) in " "do { x <- loop 3 (intToDouble (quotInt 1 0)) 1.0; putStrLn (formatDouble 1 x) }")) "2.5\n") Nil))))

regionPrograms : (List ( (Triple (String) (String) (Either String String)) ))
regionPrograms = (H.append (Cons (Triple "specialized integer ranges permit negative results and GMP promotion" (H.append "let loop : Int -> Int -> IO Int = fix (\\again n x -> ifThenElse (eqInt n 0) (return x) " (H.append "(ifThenElse (eqInt x 4611686018427387903) (again (subInt n 1) (addInt x 1)) " (H.append "(ifThenElse (eqInt x 0) (again (subInt n 1) (subInt x 1)) (again (subInt n 1) (addInt x 1))))) in " (H.append "let start : Bool -> IO Int = \\large -> ifThenElse large (loop 1 4611686018427387903) (loop 2 0) in " "do { x <- start true; y <- start false; printInt x; printInt y }")))) (Right "4611686018427387904\n0\n")) (Cons (Triple "reused actions execute and snapshots stay immutable" (H.append "let loop : IntArray -> Int -> IO Int = fix (\\again a n -> ifThenElse (eqInt n 0) " (H.append "(readIntArray a 0) (do { x <- readIntArray a 0; writeIntArray a 0 (addInt x 1); again a (subInt n 1) })) in " "do { a <- newIntArray 1 4611686018427387902; let action = loop a 2; x <- action; y <- action; printInt x; printInt y }")) (Right "4611686018427387904\n4611686018427387906\n")) (Cons (Triple "unforced unused arguments take the lazy boundary" (H.append "let loop : Bool -> Int -> IntArray -> Int -> IO Int = fix (\\again flag bad a n -> " (H.append "ifThenElse (eqInt n 0) (return 0) (ifThenElse flag (return 42) " (H.append "(do { writeIntArray a 0 bad; again flag bad a (subInt n 1) }))) in " "do { a <- newIntArray 1 0; x <- loop true (quotInt 1 0) a 1; printInt x }"))) (Right "42\n")) (Cons (Triple "aliased Double arrays preserve write and read order" (H.append "let loop : DoubleArray -> DoubleArray -> Int -> IO Unit = fix (\\again a b n -> " (H.append "ifThenElse (eqInt n 0) (return ()) (do { x <- readDoubleArray a 0; writeDoubleArray b 0 (addDouble x 1.0); " (H.append "y <- readDoubleArray a 0; writeDoubleArray b 0 (mulDouble y 2.0); again a b (subInt n 1) })) in " (H.append "do { a <- newDoubleArray 1 1.0; b <- newDoubleArray 1 1.0; c <- newDoubleArray 1 0.0; " (H.append "loop a a 2; loop b c 2; x <- readDoubleArray a 0; y <- readDoubleArray c 0; " "putStrLn (formatDouble 1 x); putStrLn (formatDouble 1 y) }"))))) (Right "10.0\n2.0\n")) (Cons (Triple "range facts do not escape a conditional branch" (H.append "let loop : Bool -> IntArray -> Int -> Int -> IO Unit = fix (\\again flag a i n -> " (H.append "ifThenElse (eqInt n 0) (return ()) (do { ifThenElse flag " (H.append "(do { ignored <- readIntArray a i; return () }) (return ()); " (H.append "writeIntArray a (addInt i 1) 0; again flag a i (subInt n 1) })) in " "do { putStrLn \"before\"; a <- newIntArray 1 0; loop false a 4611686018427387903 1 }")))) (Left "array index out of bounds")) (Cons (Triple "lazy write operands retain bounds-error ordering" (H.append "let loop : IntArray -> Int -> Int -> Int -> IO Unit = fix (\\again a i bad n -> " (H.append "ifThenElse (eqInt n 0) (return ()) (do { writeIntArray a i bad; again a i bad (subInt n 1) })) in " "do { putStrLn \"before\"; a <- newIntArray 1 0; loop a 2 (quotInt 1 0) 1 }")) (Left "array index out of bounds")) Nil)))))) (S.concatMap (\(Triple label size index) -> (Cons (Triple label (H.append "let loop : DoubleArray -> Int -> Int -> IO Unit = fix (\\again a i n -> " (H.append "ifThenElse (eqInt n 0) (return ()) (do { ignored <- readDoubleArray a i; again a i (subInt n 1) })) in " (H.append "do { putStrLn \"before\"; a <- newDoubleArray " (H.append size (H.append " 0.0; loop a " (H.append index " 1 }")))))) (Left "array index out of bounds")) Nil)) (Cons (Triple "negative native index" "1" "(-1)") (Cons (Triple "GMP native index" "1" "4611686018427387904") (Cons (Triple "empty native array" "0" "0") Nil)))))

programs : (List ( (Triple (String) (String) (String)) ))
programs = (Cons (Triple "read unbounded signed decimals" "do { printInt (readInt \"+00042\"); printInt (readInt \"-123456789012345678901234567890\"); printInt (readInt \"-0\") }" "42\n-123456789012345678901234567890\n0\n") (Cons (Triple "curried GMP primitives" "do { mul <- return mulInt; q <- return quotInt; r <- return remInt; printInt (mul 12345678901234567890 10); printInt (q (-19) 3); printInt (r (-19) 3) }" "123456789012345678900\n-6\n-1\n") (Cons (Triple "curried unbounded bitwise AND" "do { mask <- return andInt; printInt (mask (-1) 1267650600228229401496703205377); printInt (mask (-2) (-3)); printInt (mask 1267650600228229401496703205377 3) }" "1267650600228229401496703205377\n-4\n1\n") (Cons (Triple "unused bitwise arguments remain lazy" "do { return (andInt (quotInt 1 0) 0); printInt (ifThenElse true 7 (andInt 0 (quotInt 2 0))) }" "7\n") (Cons (Triple "binary64 arithmetic and scientific literals" "do { putStrLn (formatDouble 9 (sqrtDouble (addDouble (mulDouble 3.0 3.0) (mulDouble 4e0 4.0)))); putStrLn (formatDouble 3 (divDouble (subDouble 1.25 (-2.5)) 2.0)); putStrLn (formatDouble 1 (intToDouble (-42))) }" "5.000000000\n1.875\n-42.0\n") (Cons (Triple "rounding ties and signed zero" "do { putStrLn (formatDouble 0 2.5); putStrLn (formatDouble 0 3.5); putStrLn (formatDouble 2 1.005); putStrLn (formatDouble 2 (-0.0)); putStrLn (formatDouble 2 (-0.001)) }" "2\n4\n1.00\n-0.00\n-0.00\n") (Cons (Triple "generic floating primitives and IEEE comparisons" "do { f <- return mulDouble; root <- return sqrtDouble; equal <- return eqDouble; less <- return ltDouble; putStrLn (formatDouble 2 (root (f 2.0 8.0))); printInt (ifThenElse (equal (-0.0) 0.0) 1 0); printInt (ifThenElse (less (-2.0) 1.0) 1 0); printInt (ifThenElse (equal (divDouble 0.0 0.0) 0.0) 1 0); printInt (ifThenElse (less (sqrtDouble (-1.0)) 0.0) 1 0) }" "4.00\n1\n1\n0\n0\n") (Cons (Triple "IEEE non-finite results" "do { putStrLn (formatDouble 3 (divDouble 1.0 0.0)); putStrLn (formatDouble 3 (divDouble (-1.0) 0.0)); putStrLn (formatDouble 3 (sqrtDouble (-1.0))); putStrLn (formatDouble 3 (mulDouble 1e308 1e308)) }" "Infinity\n-Infinity\nNaN\nInfinity\n") (Cons (Triple "large integer conversion rounds to nearest" "do { putStrLn (formatDouble 0 (intToDouble 9007199254740995)); putStrLn (formatDouble 0 (intToDouble 4611686018427388672)); putStrLn (formatDouble 0 (intToDouble (-4611686018427388672))) }" "9007199254740996\n4611686018427388928\n-4611686018427388928\n") (Cons (Triple "IntArray aliasing and repeated action reads" "do { a <- newIntArray 3 7; let alias = a; let read = readIntArray alias 1; x <- read; writeIntArray a 1 123456789012345678901234567890; y <- read; n <- lengthIntArray a; printInt x; printInt y; printInt n }" "7\n123456789012345678901234567890\n3\n") (Cons (Triple "allocation actions produce distinct arrays" "let new = newIntArray 1 5 in do { a <- new; b <- new; writeIntArray a 0 42; x <- readIntArray b 0; printInt x }" "5\n") (Cons (Triple "DoubleArray values are copied at read time" "do { a <- newDoubleArray 2 1.5; let read = readDoubleArray a 0; x <- read; writeDoubleArray a 0 (mulDouble x 2.0); y <- read; n <- lengthDoubleArray a; putStrLn (formatDouble 1 x); putStrLn (formatDouble 1 y); printInt n }" "1.5\n3.0\n2\n") (Cons (Triple "generic ternary writes" "do { write <- return writeIntArray; create <- return newDoubleArray; wd <- return writeDoubleArray; a <- newIntArray 1 0; b <- create 1 0.0; wa <- return (write a 0); wa 42; wd b 0 2.25; x <- readIntArray a 0; y <- readDoubleArray b 0; printInt x; putStrLn (formatDouble 2 y) }" "42\n2.25\n") (Cons (Triple "unused actions and unselected arithmetic remain lazy" "do { a <- newIntArray 1 1; let ignored = writeIntArray a 0 (quotInt 1 0); return ignored; let bad = newDoubleArray (-1) (sqrtDouble (-1.0)); return bad; x <- readIntArray a 0; printInt x; printInt (ifThenElse true 42 (quotInt 1 0)) }" "1\n42\n") (Cons (Triple "empty arrays have zero length" "do { a <- newIntArray 0 0; b <- newDoubleArray 0 0.0; x <- lengthIntArray a; y <- lengthDoubleArray b; printInt (addInt x y) }" "0\n") (Cons (Triple "array roots and boxed cells survive collection" (H.append recursion (H.append "let loop : IntArray -> DoubleArray -> Int -> IO Unit = fix (\\again a b n -> ifThenElse (eqInt n 0) (return ()) (do { x <- readIntArray a 0; y <- readDoubleArray b 0; writeIntArray a 0 (addInt x 1); writeDoubleArray b 0 (addDouble y 0.5); again a b (subInt n 1) })) in " "do { a <- newIntArray 1 123456789012345678901234567890; b <- newDoubleArray 1 0.0; loop a b 300; x <- readIntArray a 0; y <- readDoubleArray b 0; printInt x; putStrLn (formatDouble 1 y) }")) "123456789012345678901234568190\n150.0\n") Nil))))))))))))))))

failures : (List ( (Triple (String) (String) (String)) ))
failures = (Cons (Triple "quotient by zero" "printInt (quotInt 4611686018427387904 0)" "integer division by zero") (Cons (Triple "remainder by zero" "printInt (remInt 1 0)" "integer division by zero") (Cons (Triple "bitwise zero mask still demands its argument" "printInt (andInt 0 (quotInt 1 0))" "integer division by zero") (Cons (Triple "direct bitwise arguments are ordered" "printInt (andInt (readInt \"bad\") (quotInt 1 0))" "invalid integer input") (Cons (Triple "curried bitwise arguments are ordered" "do { mask <- return andInt; printInt (mask (readInt \"bad\") (quotInt 1 0)) }" "invalid integer input") (Cons (Triple "empty integer input" "printInt (readInt \"\")" "invalid integer input") (Cons (Triple "signed empty input" "printInt (readInt \"-\")" "invalid integer input") (Cons (Triple "whitespace integer input" "printInt (readInt \" 1\")" "invalid integer input") (Cons (Triple "embedded NUL input" "printInt (readInt \"1\\0\")" "invalid integer input") (Cons (Triple "fractional integer input" "printInt (readInt \"1.5\")" "invalid integer input") (Cons (Triple "negative precision" "putStrLn (formatDouble (-1) 1.0)" "Double precision must be between 0 and 17") (Cons (Triple "large precision" "putStrLn (formatDouble 999999999999999999999 1.0)" "Double precision must be between 0 and 17") (Cons (Triple "negative array length" "newIntArray (-1) 0" "invalid array length") (Cons (Triple "huge array length" "newDoubleArray 999999999999999999999 0.0" "invalid array length") (Cons (Triple "negative read index" "do { a <- newIntArray 1 0; readIntArray a (-1) }" "array index out of bounds") (Cons (Triple "huge read index" "do { a <- newIntArray 1 0; readIntArray a 999999999999999999999 }" "array index out of bounds") (Cons (Triple "empty array read" "do { a <- newDoubleArray 0 0.0; readDoubleArray a 0 }" "array index out of bounds") (Cons (Triple "integer write past end" "do { a <- newIntArray 2 0; writeIntArray a 2 3 }" "array index out of bounds") (Cons (Triple "negative Double write" "do { a <- newDoubleArray 1 0.0; writeDoubleArray a (-1) 3.0 }" "array index out of bounds") (Cons (Triple "writes force stored values" "do { a <- newIntArray 1 0; writeIntArray a 0 (quotInt 1 0) }" "integer division by zero") (Cons (Triple "direct floating arguments are ordered" "putStrLn (formatDouble 1 (addDouble (intToDouble (readInt \"bad\")) (intToDouble (quotInt 1 0))))" "invalid integer input") (Cons (Triple "curried floating arguments are ordered" "do { add <- return addDouble; putStrLn (formatDouble 1 (add (intToDouble (readInt \"bad\")) (intToDouble (quotInt 1 0)))) }" "invalid integer input") Nil))))))))))))))))))))))

recursion : String
recursion = "data Rec a = Rec (Rec a -> a); let fix : forall a. (a -> a) -> a = \\f -> let go = \\r -> case r of { Rec next -> f (next r) } in go (Rec go) in "
