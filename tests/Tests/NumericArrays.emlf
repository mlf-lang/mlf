checked : String -> IO XTerm
checked source = do { term <- (H.fmap compiledTerm (H.right (compile "<numeric/array test>" source))); do { parsed <- (H.right (XP.parseTerm "<numeric/array xMLF>" (prettyTerm term))); do { (S.unless (H.eq (X.erase term) (X.erase parsed)) (H.fail "numeric/array serialization changed erasure")); (return parsed) } } }

observe : B.Backends -> XTerm -> String -> IO ()
observe backends term expected = do { result <- (B.execute backends IOEntry (Input "" false) term); do { (H.right (B.outcome result)); (S.unless (H.eq (B.output result) expected) (H.fail (H.append (H.show result) (H.append "; expected " (H.show expected))))) } }

