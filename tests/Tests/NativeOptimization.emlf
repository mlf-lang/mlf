int : XType
int = (XCon "Int" [])

unit : XType
unit = (XCon "()" [])

ioUnit : XType
ioUnit = (XCon "IO" ((:) unit []))

name : Int -> XName
name i = (XName i "same")

binary : Primitive -> XTerm -> XTerm -> XTerm
binary p a b = (XApp (XApp (XPrimitive p []) a) b)

choose : XType -> XTerm -> XTerm -> XTerm -> XTerm
choose t c a b = (XApp (XApp (XApp (XPrimitive PIfThenElse ((:) t [])) c) a) b)

printInt : XTerm -> XTerm
printInt = (XApp (XPrimitive PPrintInt []))

sequenceIO : ([] ( XTerm )) -> XTerm
sequenceIO actions = (S.foldr (\((,) i a) b -> (XApp (XApp (XPrimitive PIOBind ((:) unit ((:) unit []))) a) (XAbs (name i) unit b))) (XApp (XPrimitive PIOReturn ((:) unit [])) (XConstructor "()" [])) (S.zip (S.range 9000 9223372036854775807) actions))

observe : B.Backends -> Entry -> XTerm -> String -> IO ()
observe backends entry term expected = do { result <- (B.execute backends entry (Input "" false) term); do { (S.either (S.compose H.fail H.show) return (B.outcome result)); (S.unless (H.eq (B.output result) expected) (H.fail (H.show result))) } }

nativeOptimizationTests : B.Backends -> ([] ( ((,) (String) (IO ())) ))
nativeOptimizationTests backends = (let { sources = ((:) ((,,) "recursive encoding is structural" (H.append "data Roll a = Roll (Roll a -> a); let tie : forall a. (a -> a) -> a = \\step -> " (H.append "let unroll = \\rolled -> case rolled of { Roll fn -> step (fn rolled) } in unroll (Roll unroll) in " "let sum : Int -> Int = tie (\\again n -> ifThenElse (eqInt n 0) 0 (addInt n (again (subInt n 1)))) in printInt (sum 2)")) "3\n") ((:) ((,,) "escaping recursive function" (H.append "data Roll a = Roll (Roll a -> a); let tie : forall a. (a -> a) -> a = \\f -> " (H.append "let go = \\r -> case r of { Roll next -> f (next r) } in go (Roll go) in " (H.append "let sum : Int -> Int = tie (\\again n -> ifThenElse (eqInt n 0) 0 (addInt n (again (subInt n 1)))) in " "do { f <- return sum; printInt (f 10); printInt (sum 2) }"))) "55\n3\n") ((:) ((,,) "captured closures survive collection" (H.append "data Roll a = Roll (Roll a -> a); let tie : forall a. (a -> a) -> a = \\f -> " (H.append "let go = \\r -> case r of { Roll next -> f (next r) } in go (Roll go) in " (H.append "let repeat : Int -> IO () = tie (\\again n -> ifThenElse (eqInt n 0) (return ()) " (H.append "(do { ignored <- return (addInt n 1); again (subInt n 1) })) in " (H.append "do { x <- return (addInt 19 20); let f = \\y z -> addInt x (addInt y z) in " "do { saved <- return (f 1); repeat 300; printInt (saved 2); printInt (f 3 0) } }"))))) "42\n42\n") ((:) ((,,) "lazy recursive fields and conditional demands" (H.append "data Roll a = Roll (Roll a -> a); data Pair = Pair Int Int; " (H.append "let spin : Int = let go = \\r -> case r of { Roll next -> next r } in go (Roll go) in " (H.append "let choose = \\flag x y -> ifThenElse flag (addInt x 1) (subInt y 1) in " "case Pair spin 41 of { Pair bottom n -> do { printInt (choose true n bottom); printInt (choose false bottom 43) } }"))) "42\n42\n") ((:) ((,,) "seq demands stay inside the chosen branch" (H.append "let pick = \\flag x y -> if flag then seq x 11 else seq y 22 in " "do { printInt (pick true 1 (panic \"right\")); printInt (pick false (panic \"left\") 2) }") "11\n22\n") ((:) ((,,) "seq preserves ignored arguments and unused results" (H.append "let keep = \\x ignored -> x in let force = \\x y -> seq x y in " (H.append "do { printInt (keep 42 (force (panic \"unused first\") (panic \"unused second\"))); " "return (force (panic \"unused result\") 3); printInt 7 }")) "42\n7\n") ((:) ((,,) "three-field constructor partially applied" (H.append "data Triple = Triple Int Int Int; do { ctor <- return Triple; partial <- return (ctor 10 12); " "case partial 20 of { Triple a b c -> printInt (addInt a (addInt b c)) } }") "42\n") ((:) ((,,) "generic arithmetic crosses immediate range" (H.append "do { add <- return addInt; sub <- return subInt; less <- return ltInt; " (H.append "printInt (add 4611686018427387903 1); printInt (sub (-4611686018427387904) 1); " "printInt (add 4611686018427387904 (-1)); printInt (ifThenElse (less (-1) 4611686018427387904) 1 0) }")) "4611686018427387904\n-4611686018427387905\n4611686018427387903\n1\n") [])))))))) } in (H.append ((:) ((,) "native optimization: tagged integer boundaries" (let { limit = (H.power 2 62) } in (let { values = ((:) ((0 - limit) - 1) ((:) (0 - limit) ((:) ((0 - limit) + 1) ((:) (0 - 1) ((:) 0 ((:) 1 ((:) (limit - 1) ((:) limit ((:) (limit + 1) ((:) (H.power 2 100) [])))))))))) } in (let { pairs = (S.concatMap (\a -> (S.concatMap (\b -> ((:) ((,) a b) [])) values)) values) } in (let { number n = (XIntTerm n) } in (let { expression ((,) a b) = (H.append (S.concatMap (\p -> ((:) (printInt (binary p (number a) (number b))) [])) ((:) PAddInt ((:) PSubInt []))) (S.concatMap (\p -> ((:) (printInt (choose int (binary p (number a) (number b)) (number 1) (number 0))) [])) ((:) PEqInt ((:) PLtInt [])))) } in (let { expected ((,) a b) = (S.map H.show ((:) (a + b) ((:) (a - b) ((:) (if (H.eq a b) then 1 else 0) ((:) (if (a < b) then 1 else 0) []))))) } in (observe backends IOEntry (sequenceIO (H.concatMap expression pairs)) (S.unlines (H.concatMap expected pairs)))))))))) ((:) ((,) "native optimization: ordinary products and division preserve Integer boundaries" (let { limit = (H.power 2 62) } in (let { values = ((:) ((0 - limit) - 1) ((:) (0 - limit) ((:) ((0 - limit) + 1) ((:) (0 - 1) ((:) 0 ((:) 1 ((:) (limit - 1) ((:) limit ((:) (limit + 1) ((:) (H.power 2 100) [])))))))))) } in (let { operations a b = (H.append ((:) ((,) PMulInt (a * b)) []) (H.append (if (S.not (H.eq b 0)) then ((:) ((,) PQuotInt (quotInt a b)) []) else []) (if (S.not (H.eq b 0)) then ((:) ((,) PRemInt (remInt a b)) []) else []))) } in (let { cases = (S.concatMap (\a -> (S.concatMap (\b -> (S.concatMap (\((,) p want) -> ((:) ((,,,) p a b want) [])) (operations a b))) values)) values) } in (let { term = (sequenceIO (S.concatMap (\((,,,) p a b _) -> ((:) (printInt (binary p (XIntTerm a) (XIntTerm b))) [])) cases)) } in do { llvm <- (S.either H.fail return (emitLLVMIO term)); do { (S.unless ((H.contains "= call { i64, i1 } @llvm.smul.with.overflow.i64(" llvm) && (S.not (H.contains "define private ptr @mlf.numeric." llvm))) (H.fail "ordinary arithmetic fixture did not exercise checked product lowering")); (observe backends IOEntry term (S.unlines (S.concatMap (\((,,,) _ _ _ want) -> ((:) (H.show want) [])) cases))) } })))))) ((:) ((,) "native optimization: partial workers stay lazy" (observe backends ProgramEntry partialWorker "")) ((:) ((,) "native optimization: seq propagates saturated worker demands" (let { term = (seqWorker (XIntTerm 19) (XIntTerm 42)) } in do { (let guardSubject7 = (Map.lookup (name 0) (Analysis.analyze (X.erase term))) in (let guardNext9 = \ignored -> (let guardNext8 = \ignored -> (panic "non-exhaustive test case") in (case guardSubject7 of { _ -> (H.fail "saturated seq worker did not demand both arguments") })) in (case guardSubject7 of { (Just worker) -> (if (H.eq (Analysis.strict worker) (Set.fromList ((:) (name 1) ((:) (name 2) [])))) then (return ()) else (guardNext9 ())); _ -> (guardNext9 ()) }))); (observe backends IOEntry term "before\n42\n") })) ((:) ((,) "native optimization: seq worker forces both operands after preceding effects" ((H.forM_ ((:) ((,,) (panicInt "first") (XIntTerm 42) "first") ((:) ((,,) (XIntTerm 19) (panicInt "second") "second") []))) (\((,,) a b message) -> do { result <- (B.execute backends IOEntry (Input "" false) (seqWorker a b)); (S.unless ((S.either (S.compose (\section6 -> (H.eq section6 message)) H.show) (S.const false) (B.outcome result)) && (H.eq (B.events result) ((:) (B.Write "before\n") []))) (H.fail (H.show result))) }))) ((:) ((,) "native optimization: partial seq stays lazy" (observe backends ProgramEntry partialSeq "")) ((:) ((,) "native optimization: function captures and mutual recursion" do { (observe backends IOEntry captureWorkers "42\n"); do { parsed <- (S.either H.fail return (XP.parseTerm "<native worker round trip>" (prettyTerm (captureWorkersAt 1000)))); do { original <- (S.either H.fail return (emitLLVMIO captureWorkers)); do { serialized <- (S.either H.fail return (emitLLVMIO parsed)); (S.unless (H.eq original serialized) (H.fail "worker symbols depend on parser-assigned identities")) } } } }) ((:) ((,) "native optimization: identities reused in disjoint scopes" (observe backends IOEntry disjointIdentities "42\n")) ((:) ((,) "native optimization: packed and general constructor layouts" do { (observe backends IOEntry constructorLayouts "42\n"); do { _ <- (S.either H.fail return (Check.checkClosed constructorLayouts)); do { ((,) _ code) <- (S.either H.fail return (Codegen.generate (Map.fromList ((:) ((,) "()" ((,) 1 0)) ((:) ((,) "One" ((,) 69 1)) ((:) ((,) "Three" ((,) 70 3)) [])))) (X.erase constructorLayouts))); (let { llvm = (S.unlines code) } in (S.unless (((H.contains "call ptr @mlf.construct.wide(" llvm) && (H.contains "call ptr @mlf.construct.1(" llvm)) && (S.not (H.contains "call ptr @mlf_application(" llvm))) (H.fail "saturated constructor still builds generic application nodes"))) } } }) ((:) ((,) "native optimization: wide constructors keep fields lazy and recursive" (observe backends IOEntry wideConstructor "42\n")) ((:) ((,) "native optimization: five-field constructor returned from numeric region" do { term <- (S.either (S.compose H.fail H.show) (S.compose return compiledTerm) (compile "<numeric constructor>" numericConstructorSource)); do { (observe backends IOEntry term "42\n47\n"); do { llvm <- (S.either H.fail return (emitLLVMIO term)); (let { workers = (S.concatMap (\comprehension4 -> case comprehension4 of { ((:) line body) -> (if (OS.starts "define private ptr @mlf.numeric." line) then ((:) (S.takeWhile (\section3 -> (S.not (H.eq section3 "}"))) body) []) else []); _ -> [] }) (H.tails (H.lines llvm))) } in (S.unless (S.any (S.any (\section5 -> (H.contains "call ptr @mlf.construct.wide(" section5))) workers) (H.fail "numeric constructor fixture did not exercise direct field construction"))) } } }) ((:) ((,) "native optimization: general fields retain captured worker values" do { (observe backends IOEntry capturedConstructorField "42\n43\n"); (let { functions = (Analysis.analyze (X.erase capturedConstructorField)) } in do { (S.unless (H.eq (Analysis.needed functions (XEVar (name 8))) (Set.singleton (name 7))) (H.fail "field fixture did not expose its recursive worker capture")); do { llvm <- (rawFiveCode capturedConstructorField); (S.unless ((S.not (H.contains "call ptr @mlf_field(" llvm)) && (compactLastField llvm)) (H.fail "general case did not load only its captured last field")) } }) }) ((:) ((,) "native optimization: dead and wildcard fields need no environment" do { (observe backends IOEntry discardedConstructorFields "7\n"); do { llvm <- (rawFiveCode discardedConstructorFields); (S.unless ((S.not (H.contains "call ptr @mlf_field(" llvm)) && (S.not (H.contains "= load ptr," llvm))) (H.fail "unused constructor fields still access their environment")) } }) []))))))))))))) (S.concatMap (\((,,) label source expected) -> ((:) ((,) (H.append "native optimization: " label) do { term <- (S.either (S.compose H.fail H.show) (S.compose return compiledTerm) (compile "<native optimization>" source)); (observe backends IOEntry term expected) }) [])) sources)))

partialWorker : XTerm
partialWorker = (let { bottom = (name 0) } in (let { f = (name 1) } in (let { x = (name 2) } in (let { y = (name 3) } in (let { body = (choose int (binary PEqInt (XVarTerm y) (XIntTerm 0)) (binary PAddInt (XVarTerm x) (XIntTerm 1)) (XApp (XApp (XVarTerm f) (XVarTerm x)) (binary PSubInt (XVarTerm y) (XIntTerm 1)))) } in (XLetRec ((:) ((,,) bottom int (XVarTerm bottom)) ((:) ((,,) f (XArrow int (XArrow int int)) (XAbs x int (XAbs y int body))) [])) (XApp (XVarTerm f) (XVarTerm bottom))))))))

panicInt : String -> XTerm
panicInt message = (XApp (XPrimitive PPanic ((:) int [])) (XStringTerm message))

seqWorker : XTerm -> XTerm -> XTerm
seqWorker a b = (XLet (name 0) (XAbs (name 1) int (XAbs (name 2) int (XApp (XApp (XPrimitive PSeq ((:) int ((:) int []))) (XVarTerm (name 1))) (XVarTerm (name 2))))) (sequenceIO ((:) (XApp (XPrimitive PPutStrLn []) (XStringTerm "before")) ((:) (printInt (XApp (XApp (XVarTerm (name 0)) a) b)) []))))

partialSeq : XTerm
partialSeq = ((XLetRec ((:) ((,,) (name 2) int (XVarTerm (name 2))) [])) (XLet (name 0) (XAbs (name 1) int (XApp (XPrimitive PSeq ((:) int ((:) int []))) (XVarTerm (name 1)))) (XApp (XVarTerm (name 0)) (XVarTerm (name 2)))))

captureWorkers : XTerm
captureWorkers = (captureWorkersAt 0)

captureWorkersAt : Int -> XTerm
captureWorkersAt offset = (let { fn = (XArrow int int) } in (let { local i = (name (offset + i)) } in (let { saved = (local 0) } in (let { f = (local 1) } in (let { g = (local 2) } in (let { x = (local 3) } in (let { y = (local 4) } in (let { escaped = (local 5) } in ((XLet saved (binary PAddInt (XIntTerm 19) (XIntTerm 23))) ((XLetRec ((:) ((,,) f fn (XAbs x int (XApp (XVarTerm g) (XVarTerm x)))) ((:) ((,,) g fn (XAbs y int (choose int (binary PEqInt (XVarTerm y) (XIntTerm 0)) (XVarTerm saved) (XApp (XVarTerm f) (binary PSubInt (XVarTerm y) (XIntTerm 1)))))) []))) (XApp (XApp (XPrimitive PIOBind ((:) fn ((:) unit []))) (XApp (XPrimitive PIOReturn ((:) fn [])) (XVarTerm g))) (XAbs escaped fn (printInt (XApp (XVarTerm escaped) (XIntTerm 20)))))))))))))))

disjointIdentities : XTerm
disjointIdentities = (printInt (XApp (XLet (name 0) (XIntTerm 19) (XAbs (name 1) int (binary PAddInt (XVarTerm (name 0)) (XVarTerm (name 1))))) (XLet (name 0) (XIntTerm 23) (XVarTerm (name 0)))))

constructorLayouts : XTerm
constructorLayouts = (let { tree = (name 0) } in (let { a = (name 1) } in (let { b = (name 2) } in (let { c = (name 3) } in ((XWithData ((:) (DataDecl "One" [] ((:) (ConstructorDecl "One" ((:) (Applied "Int" []) [])) [])) ((:) (DataDecl "Three" [] ((:) (ConstructorDecl "Three" ((:) (Applied "One" []) ((:) (Applied "Int" []) ((:) (Applied "Three" []) [])))) [])) []))) ((XLetRec ((:) ((,,) tree (XCon "Three" []) (S.foldl XApp (XConstructor "Three" []) ((:) (XApp (XConstructor "One" []) (XIntTerm 19)) ((:) (XIntTerm 23) ((:) (XVarTerm tree) []))))) [])) (XCase (XVarTerm tree) ioUnit ((:) (XAlternative (XConstructorPattern "Three" ((:) (Just a) ((:) (Just b) ((:) Nothing [])))) (XCase (XVarTerm a) ioUnit ((:) (XAlternative (XConstructorPattern "One" ((:) (Just c) [])) (printInt (binary PAddInt (XVarTerm b) (XVarTerm c)))) []))) []))))))))

wideConstructor : XTerm
wideConstructor = (let { wide = (XCon "Wide" []) } in (let { declaration = (DataDecl "Wide" [] ((:) (ConstructorDecl "Wide" (H.append (S.replicate 15 (Applied "Int" [])) ((:) (Function (Applied "Int" []) (Applied "Int" [])) ((:) (Applied "Wide" []) [])))) [])) } in (let { captured = (name 0) } in (let { tree = (name 1) } in (let { argument = (name 2) } in (let { function = (name 3) } in (let { next = (name 4) } in (let { numbers = (S.map name (S.range 10 23)) } in (let { fields = ((:) (panicInt "unused wide field") (H.append (S.map XIntTerm (S.range 1 14)) ((:) (XAbs argument int (binary PSubInt (XVarTerm captured) (XVarTerm argument))) ((:) (XVarTerm tree) [])))) } in ((XWithData ((:) declaration [])) ((XLet captured (binary PAddInt (XIntTerm 100) (XIntTerm 47))) ((XLetRec ((:) ((,,) tree wide (S.foldl XApp (XConstructor "Wide" []) fields)) [])) (XCase (XVarTerm tree) ioUnit ((:) ((XAlternative (XConstructorPattern "Wide" (H.append (S.replicate 15 Nothing) ((:) (Just function) ((:) (Just next) []))))) (XCase (XVarTerm next) ioUnit ((:) ((XAlternative (XConstructorPattern "Wide" ((:) Nothing (H.append (S.map Just numbers) ((:) Nothing ((:) Nothing [])))))) (printInt (XApp (XVarTerm function) (S.foldr (S.compose (binary PAddInt) XVarTerm) (XIntTerm 0) numbers)))) []))) []))))))))))))))

numericConstructorSource : String
numericConstructorSource = (H.append "data Five = Five Int Int Int Int Int; let make = \\n -> ioReturn " (H.append "(Five n (addInt n 1) (addInt n 2) (addInt n 3) (addInt n 6)) in " (H.append "do { first <- make 6; second <- make 7; " (H.append "case first of { Five a b c d e -> printInt (addInt a (addInt b (addInt c (addInt d e)))) }; " "case second of { Five a b c d e -> printInt (addInt a (addInt b (addInt c (addInt d e)))) } }"))))

-- Wide constructor field four is at 24 + 4*8. Count accesses to that
-- constructor, separately from the required load of a coallocated thunk's
-- environment at byte 16. No other constructor field may be read.
compactLastField : String -> Bool
compactLastField llvm =
 let instructions = S.map OS.words (H.lines llvm) in
 let addresses = S.filter (\parts -> S.length parts == 8 && eqString (S.index parts 2) "getelementptr" && eqString (S.index parts 3) "i8," && eqString (S.index parts 6) "i64") instructions in
 let selected = S.filter (\parts -> eqString (S.last parts) "56") addresses in
 case selected of
  (:) field [] ->
   let base = S.index field 5 in
   let fromValue = S.filter (\parts -> eqString (S.index parts 5) base) addresses in
   let address = S.head field ++ "," in
   let reads = S.filter (\parts -> S.length parts > 5 && eqString (S.index parts 2) "load" && eqString (S.index parts 3) "ptr," && eqString (S.index parts 5) address) instructions in
   S.eqList eqString (S.map S.last fromValue) (OS.words "8 56") && S.length reads == 1
  _ -> false

rawFiveCode : XTerm -> IO String
rawFiveCode term = do { _ <- (S.either H.fail return (Check.checkClosed term)); do { ((,) _ code) <- (S.either H.fail return (Codegen.generate (Map.fromList ((:) ((,) "()" ((,) 1 0)) ((:) ((,) "Five" ((,) 69 5)) []))) (X.erase term))); (let { alternatives = (S.concatMap (\comprehension12 -> case comprehension12 of { ((:) line rest) -> (if (OS.starts "define private ptr " line) then (let { body = (S.takeWhile (\section11 -> (S.not (H.eq section11 "}"))) rest) } in (if (S.any (\section10 -> (H.contains "switch i64 " section10)) body) then ((:) (S.unlines body) []) else [])) else []); _ -> [] }) (H.tails (H.lines (S.unlines code)))) } in (case alternatives of { ((:) body []) -> (return body); _ -> (H.fail "field-liveness fixture did not retain exactly one constructor case") })) } }

constructorFieldsInput : ([] ( Maybe XName )) -> XTerm -> XTerm
constructorFieldsInput fields body = (let { five = (XCon "Five" []) } in (let { constructorType = (S.foldr XArrow five (S.replicate 5 int)) } in (let { partialType = (XArrow int five) } in (let { constructor = (name 0) } in (let { partial = (name 1) } in (let { record = (name 2) } in (let { ret ty value = (XApp (XPrimitive PIOReturn ((:) ty [])) value) } in (let { bind ty action variable next = (XApp (XApp (XPrimitive PIOBind ((:) ty ((:) unit []))) action) (XAbs variable ty next)) } in ((XWithData ((:) (DataDecl "Five" [] ((:) (ConstructorDecl "Five" (S.replicate 5 (Applied "Int" []))) [])) [])) ((bind constructorType (ret constructorType (XConstructor "Five" [])) constructor) ((bind partialType (ret partialType (S.foldl XApp (XVarTerm constructor) (S.concatMap (\i -> ((:) (panicInt (H.append "unused field " (H.show i))) [])) (S.range 0 3)))) partial) ((bind five (ret five (XApp (XVarTerm partial) (XIntTerm 41))) record) (XCase (XVarTerm record) ioUnit ((:) (XAlternative (XConstructorPattern "Five" fields) body) []))))))))))))))

capturedConstructorField : XTerm
capturedConstructorField = (let { captured = (name 7) } in (let { worker = (name 8) } in (let { counter = (name 9) } in (let { escaped = (name 10) } in (let { fn = (XArrow int int) } in ((constructorFieldsInput ((:) (Just (name 3)) ((:) (Just (name 4)) ((:) Nothing ((:) (Just (name 6)) ((:) (Just captured) [])))))) ((XLetRec ((:) ((,,) worker fn (XAbs counter int (choose int (binary PEqInt (XVarTerm counter) (XIntTerm 0)) (XVarTerm captured) (binary PAddInt (XIntTerm 1) (XApp (XVarTerm worker) (binary PSubInt (XVarTerm counter) (XIntTerm 1))))))) [])) (XApp (XApp (XPrimitive PIOBind ((:) fn ((:) unit []))) (XApp (XPrimitive PIOReturn ((:) fn [])) (XVarTerm worker))) (XAbs escaped fn (sequenceIO ((:) (printInt (XApp (XVarTerm escaped) (XIntTerm 1))) ((:) (printInt (XApp (XVarTerm worker) (XIntTerm 2))) []))))))))))))

discardedConstructorFields : XTerm
discardedConstructorFields = (constructorFieldsInput ((:) (Just (name 3)) ((:) Nothing ((:) (Just (name 5)) ((:) Nothing ((:) (Just (name 7)) []))))) (printInt (XIntTerm 7)))
