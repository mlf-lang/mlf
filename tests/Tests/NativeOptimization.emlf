import Prelude hiding (printInt)

int : XType
int = (XCon "Int" Nil)

unit : XType
unit = (XCon "Unit" Nil)

ioUnit : XType
ioUnit = (XCon "IO" (Cons unit Nil))

name : Int -> XName
name i = (XName i "same")

binary : Primitive -> XTerm -> XTerm -> XTerm
binary p a b = (XApp (XApp (XPrimitive p Nil) a) b)

choose : XType -> XTerm -> XTerm -> XTerm -> XTerm
choose t c a b = (XApp (XApp (XApp (XPrimitive PIfThenElse (Cons t Nil)) c) a) b)

printInt : XTerm -> XTerm
printInt = (XApp (XPrimitive PPrintInt Nil))

sequenceIO : (List ( XTerm )) -> XTerm
sequenceIO actions = (S.foldr (\(Pair i a) b -> (XApp (XApp (XPrimitive PIOBind (Cons unit (Cons unit Nil))) a) (XAbs (name i) unit b))) (XApp (XPrimitive PIOReturn (Cons unit Nil)) (XConstructor "Unit" Nil)) (S.zip (S.range 9000 9223372036854775807) actions))

observe : B.Backends -> Entry -> XTerm -> String -> IO Unit
observe backends entry term expected = do { result <- (B.execute backends entry (Input "" false) term); do { (S.either (S.compose H.fail H.show) return (B.outcome result)); (S.unless (H.eq (B.output result) expected) (H.fail (H.show result))) } }

nativeOptimizationTests : B.Backends -> (List ( (Pair (String) (IO Unit)) ))
nativeOptimizationTests backends = (let { sources = (Cons (Triple "recursive encoding is structural" (H.append "data Roll a = Roll (Roll a -> a); let tie : forall a. (a -> a) -> a = \\step -> " (H.append "let unroll = \\rolled -> case rolled of { Roll fn -> step (fn rolled) } in unroll (Roll unroll) in " "let sum : Int -> Int = tie (\\again n -> ifThenElse (eqInt n 0) 0 (addInt n (again (subInt n 1)))) in printInt (sum 100)")) "5050\n") (Cons (Triple "escaping recursive function" (H.append "data Roll a = Roll (Roll a -> a); let tie : forall a. (a -> a) -> a = \\f -> " (H.append "let go = \\r -> case r of { Roll next -> f (next r) } in go (Roll go) in " (H.append "let sum : Int -> Int = tie (\\again n -> ifThenElse (eqInt n 0) 0 (addInt n (again (subInt n 1)))) in " "do { f <- return sum; printInt (f 10); printInt (sum 2) }"))) "55\n3\n") (Cons (Triple "captured closures survive collection" (H.append "data Roll a = Roll (Roll a -> a); let tie : forall a. (a -> a) -> a = \\f -> " (H.append "let go = \\r -> case r of { Roll next -> f (next r) } in go (Roll go) in " (H.append "let repeat : Int -> IO Unit = tie (\\again n -> ifThenElse (eqInt n 0) (return ()) " (H.append "(do { ignored <- return (addInt n 1); again (subInt n 1) })) in " (H.append "do { x <- return (addInt 19 20); let f = \\y z -> addInt x (addInt y z) in " "do { saved <- return (f 1); repeat 300; printInt (saved 2); printInt (f 3 0) } }"))))) "42\n42\n") (Cons (Triple "lazy recursive fields and conditional demands" (H.append "data Roll a = Roll (Roll a -> a); data Pair = Pair Int Int; " (H.append "let spin : Int = let go = \\r -> case r of { Roll next -> next r } in go (Roll go) in " (H.append "let choose = \\flag x y -> ifThenElse flag (addInt x 1) (subInt y 1) in " "case Pair spin 41 of { Pair bottom n -> do { printInt (choose true n bottom); printInt (choose false bottom 43) } }"))) "42\n42\n") (Cons (Triple "seq demands stay inside the chosen branch" (H.append "let pick = \\flag x y -> if flag then seq x 11 else seq y 22 in " "do { printInt (pick true 1 (panic \"right\")); printInt (pick false (panic \"left\") 2) }") "11\n22\n") (Cons (Triple "seq preserves ignored arguments and unused results" (H.append "let keep = \\x ignored -> x in let force = \\x y -> seq x y in " (H.append "do { printInt (keep 42 (force (panic \"unused first\") (panic \"unused second\"))); " "return (force (panic \"unused result\") 3); printInt 7 }")) "42\n7\n") (Cons (Triple "three-field constructor partially applied" (H.append "data Triple = Triple Int Int Int; do { ctor <- return Triple; partial <- return (ctor 10 12); " "case partial 20 of { Triple a b c -> printInt (addInt a (addInt b c)) } }") "42\n") (Cons (Triple "generic arithmetic crosses immediate range" (H.append "do { add <- return addInt; sub <- return subInt; less <- return ltInt; " (H.append "printInt (add 4611686018427387903 1); printInt (sub (-4611686018427387904) 1); " "printInt (add 4611686018427387904 (-1)); printInt (ifThenElse (less (-1) 4611686018427387904) 1 0) }")) "4611686018427387904\n-4611686018427387905\n4611686018427387903\n1\n") Nil)))))))) } in (H.append (Cons (Pair "native optimization: tagged integer boundaries" (let { limit = (H.power 2 62) } in (let { values = (Cons ((0 - limit) - 1) (Cons (0 - limit) (Cons ((0 - limit) + 1) (Cons (0 - 1) (Cons 0 (Cons 1 (Cons (limit - 1) (Cons limit (Cons (limit + 1) (Cons (H.power 2 100) Nil)))))))))) } in (let { pairs = (S.concatMap (\a -> (S.concatMap (\b -> (Cons (Pair a b) Nil)) values)) values) } in (let { number n = (XIntTerm n) } in (let { expression (Pair a b) = (H.append (S.concatMap (\p -> (Cons (printInt (binary p (number a) (number b))) Nil)) (Cons PAddInt (Cons PSubInt Nil))) (S.concatMap (\p -> (Cons (printInt (choose int (binary p (number a) (number b)) (number 1) (number 0))) Nil)) (Cons PEqInt (Cons PLtInt Nil)))) } in (let { expected (Pair a b) = (S.map H.show (Cons (a + b) (Cons (a - b) (Cons (if (H.eq a b) then 1 else 0) (Cons (if (a < b) then 1 else 0) Nil))))) } in (observe backends IOEntry (sequenceIO (H.concatMap expression pairs)) (S.unlines (H.concatMap expected pairs)))))))))) (Cons (Pair "native optimization: ordinary products and division preserve Integer boundaries" (let { limit = (H.power 2 62) } in (let { values = (Cons ((0 - limit) - 1) (Cons (0 - limit) (Cons ((0 - limit) + 1) (Cons (0 - 1) (Cons 0 (Cons 1 (Cons (limit - 1) (Cons limit (Cons (limit + 1) (Cons (H.power 2 100) Nil)))))))))) } in (let { operations a b = (H.append (Cons (Pair PMulInt (a * b)) Nil) (H.append (if (S.not (H.eq b 0)) then (Cons (Pair PQuotInt (quotInt a b)) Nil) else Nil) (if (S.not (H.eq b 0)) then (Cons (Pair PRemInt (remInt a b)) Nil) else Nil))) } in (let { cases = (S.concatMap (\a -> (S.concatMap (\b -> (S.concatMap (\(Pair p want) -> (Cons (Quad p a b want) Nil)) (operations a b))) values)) values) } in (let { term = (sequenceIO (S.concatMap (\(Quad p a b _) -> (Cons (printInt (binary p (XIntTerm a) (XIntTerm b))) Nil)) cases)) } in do { llvm <- (S.either H.fail return (emitLLVMIO term)); do { (S.unless ((H.contains "= call { i64, i1 } @llvm.smul.with.overflow.i64(" llvm) && (S.not (H.contains "define private ptr @mlf.numeric." llvm))) (H.fail "ordinary arithmetic fixture did not exercise checked product lowering")); (observe backends IOEntry term (S.unlines (S.concatMap (\(Quad _ _ _ want) -> (Cons (H.show want) Nil)) cases))) } })))))) (Cons (Pair "native optimization: partial workers stay lazy" (observe backends ProgramEntry partialWorker "")) (Cons (Pair "native optimization: seq propagates saturated worker demands" (let { term = (seqWorker (XIntTerm 19) (XIntTerm 42)) } in do { (let guardSubject7 = (Map.lookup (name 0) (Analysis.analyze (X.erase term))) in (let guardNext9 = \ignored -> (let guardNext8 = \ignored -> (panic "non-exhaustive test case") in (case guardSubject7 of { _ -> (H.fail "saturated seq worker did not demand both arguments") })) in (case guardSubject7 of { (Just worker) -> (if (H.eq (Analysis.strict worker) (Set.fromList (Cons (name 1) (Cons (name 2) Nil)))) then (return Unit) else (guardNext9 Unit)); _ -> (guardNext9 Unit) }))); (observe backends IOEntry term "before\n42\n") })) (Cons (Pair "native optimization: seq worker forces both operands after preceding effects" ((H.forM_ (Cons (Triple (panicInt "first") (XIntTerm 42) "first") (Cons (Triple (XIntTerm 19) (panicInt "second") "second") Nil))) (\(Triple a b message) -> do { result <- (B.execute backends IOEntry (Input "" false) (seqWorker a b)); (S.unless ((S.either (S.compose (\section6 -> (H.eq section6 message)) H.show) (S.const false) (B.outcome result)) && (H.eq (B.events result) (Cons (B.Write "before\n") Nil))) (H.fail (H.show result))) }))) (Cons (Pair "native optimization: partial seq stays lazy" (observe backends ProgramEntry partialSeq "")) (Cons (Pair "native optimization: function captures and mutual recursion" do { (observe backends IOEntry captureWorkers "42\n"); do { parsed <- (S.either H.fail return (XP.parseTerm "<native worker round trip>" (prettyTerm (captureWorkersAt 1000)))); do { original <- (S.either H.fail return (emitLLVMIO captureWorkers)); do { serialized <- (S.either H.fail return (emitLLVMIO parsed)); (S.unless (H.eq original serialized) (H.fail "worker symbols depend on parser-assigned identities")) } } } }) (Cons (Pair "native optimization: identities reused in disjoint scopes" (observe backends IOEntry disjointIdentities "42\n")) (Cons (Pair "native optimization: packed and general constructor layouts" do { (observe backends IOEntry constructorLayouts "42\n"); do { _ <- (S.either H.fail return (Check.checkClosed constructorLayouts)); do { (Pair _ code) <- (S.either H.fail return (Codegen.generate (Map.fromList (Cons (Pair "Unit" (Pair 0 0)) (Cons (Pair "One" (Pair 1 1)) (Cons (Pair "Three" (Pair 2 3)) Nil)))) (X.erase constructorLayouts))); (let { llvm = (S.unlines code) } in (S.unless ((H.contains "call ptr @mlf_constructor_new(" llvm) && (S.not (H.contains "call ptr @mlf_application(" llvm))) (H.fail "saturated constructor still builds generic application nodes"))) } } }) (Cons (Pair "native optimization: wide constructors keep fields lazy and recursive" (observe backends IOEntry wideConstructor "42\n")) (Cons (Pair "native optimization: five-field constructor returned from numeric region" do { term <- (S.either (S.compose H.fail H.show) (S.compose return compiledTerm) (compile "<numeric constructor>" numericConstructorSource)); do { (observe backends IOEntry term "42\n47\n"); do { llvm <- (S.either H.fail return (emitLLVMIO term)); (let { workers = (S.concatMap (\comprehension4 -> case comprehension4 of { (Cons line body) -> (if (OS.starts "define private ptr @mlf.numeric." line) then (Cons (S.takeWhile (\section3 -> (S.not (H.eq section3 "}"))) body) Nil) else Nil); _ -> Nil }) (H.tails (H.lines llvm))) } in (S.unless (S.any (S.any (\section5 -> (H.contains "call ptr @mlf_constructor_new(" section5))) workers) (H.fail "numeric constructor fixture did not exercise direct field construction"))) } } }) (Cons (Pair "native optimization: general fields retain captured worker values" do { (observe backends IOEntry capturedConstructorField "42\n43\n"); (let { functions = (Analysis.analyze (X.erase capturedConstructorField)) } in do { (S.unless (H.eq (Analysis.needed functions (XEVar (name 8))) (Set.singleton (name 7))) (H.fail "field fixture did not expose its recursive worker capture")); do { llvm <- (rawFiveCode capturedConstructorField); (S.unless ((S.not (H.contains "call ptr @mlf_field(" llvm)) && ((H.eq (H.length (S.filter (\section1 -> (H.contains "= load ptr," section1)) (H.lines llvm))) 2) && (S.any (\section2 -> (H.contains "i64 56" section2)) (H.lines llvm)))) (H.fail "general case did not load only its captured last field")) } }) }) (Cons (Pair "native optimization: dead and wildcard fields need no environment" do { (observe backends IOEntry discardedConstructorFields "7\n"); do { llvm <- (rawFiveCode discardedConstructorFields); (S.unless ((S.not (H.contains "call ptr @mlf_field(" llvm)) && (S.not (H.contains "= load ptr," llvm))) (H.fail "unused constructor fields still access their environment")) } }) Nil))))))))))))) (S.concatMap (\(Triple label source expected) -> (Cons (Pair (H.append "native optimization: " label) do { term <- (S.either (S.compose H.fail H.show) (S.compose return compiledTerm) (compile "<native optimization>" source)); (observe backends IOEntry term expected) }) Nil)) sources)))

partialWorker : XTerm
partialWorker = (let { bottom = (name 0) } in (let { f = (name 1) } in (let { x = (name 2) } in (let { y = (name 3) } in (let { body = (choose int (binary PEqInt (XVarTerm y) (XIntTerm 0)) (binary PAddInt (XVarTerm x) (XIntTerm 1)) (XApp (XApp (XVarTerm f) (XVarTerm x)) (binary PSubInt (XVarTerm y) (XIntTerm 1)))) } in (XLetRec (Cons (Triple bottom int (XVarTerm bottom)) (Cons (Triple f (XArrow int (XArrow int int)) (XAbs x int (XAbs y int body))) Nil)) (XApp (XVarTerm f) (XVarTerm bottom))))))))

panicInt : String -> XTerm
panicInt message = (XApp (XPrimitive PPanic (Cons int Nil)) (XStringTerm message))

seqWorker : XTerm -> XTerm -> XTerm
seqWorker a b = (XLet (name 0) (XAbs (name 1) int (XAbs (name 2) int (XApp (XApp (XPrimitive PSeq (Cons int (Cons int Nil))) (XVarTerm (name 1))) (XVarTerm (name 2))))) (sequenceIO (Cons (XApp (XPrimitive PPutStrLn Nil) (XStringTerm "before")) (Cons (printInt (XApp (XApp (XVarTerm (name 0)) a) b)) Nil))))

partialSeq : XTerm
partialSeq = ((XLetRec (Cons (Triple (name 2) int (XVarTerm (name 2))) Nil)) (XLet (name 0) (XAbs (name 1) int (XApp (XPrimitive PSeq (Cons int (Cons int Nil))) (XVarTerm (name 1)))) (XApp (XVarTerm (name 0)) (XVarTerm (name 2)))))

captureWorkers : XTerm
captureWorkers = (captureWorkersAt 0)

captureWorkersAt : Int -> XTerm
captureWorkersAt offset = (let { fn = (XArrow int int) } in (let { local i = (name (offset + i)) } in (let { saved = (local 0) } in (let { f = (local 1) } in (let { g = (local 2) } in (let { x = (local 3) } in (let { y = (local 4) } in (let { escaped = (local 5) } in ((XLet saved (binary PAddInt (XIntTerm 19) (XIntTerm 23))) ((XLetRec (Cons (Triple f fn (XAbs x int (XApp (XVarTerm g) (XVarTerm x)))) (Cons (Triple g fn (XAbs y int (choose int (binary PEqInt (XVarTerm y) (XIntTerm 0)) (XVarTerm saved) (XApp (XVarTerm f) (binary PSubInt (XVarTerm y) (XIntTerm 1)))))) Nil))) (XApp (XApp (XPrimitive PIOBind (Cons fn (Cons unit Nil))) (XApp (XPrimitive PIOReturn (Cons fn Nil)) (XVarTerm g))) (XAbs escaped fn (printInt (XApp (XVarTerm escaped) (XIntTerm 20)))))))))))))))

disjointIdentities : XTerm
disjointIdentities = (printInt (XApp (XLet (name 0) (XIntTerm 19) (XAbs (name 1) int (binary PAddInt (XVarTerm (name 0)) (XVarTerm (name 1))))) (XLet (name 0) (XIntTerm 23) (XVarTerm (name 0)))))

constructorLayouts : XTerm
constructorLayouts = (let { tree = (name 0) } in (let { a = (name 1) } in (let { b = (name 2) } in (let { c = (name 3) } in ((XWithData (Cons (DataDecl "One" Nil (Cons (ConstructorDecl "One" (Cons (Applied "Int" Nil) Nil)) Nil)) (Cons (DataDecl "Three" Nil (Cons (ConstructorDecl "Three" (Cons (Applied "One" Nil) (Cons (Applied "Int" Nil) (Cons (Applied "Three" Nil) Nil)))) Nil)) Nil))) ((XLetRec (Cons (Triple tree (XCon "Three" Nil) (S.foldl XApp (XConstructor "Three" Nil) (Cons (XApp (XConstructor "One" Nil) (XIntTerm 19)) (Cons (XIntTerm 23) (Cons (XVarTerm tree) Nil))))) Nil)) (XCase (XVarTerm tree) ioUnit (Cons (XAlternative (XConstructorPattern "Three" (Cons (Just a) (Cons (Just b) (Cons Nothing Nil)))) (XCase (XVarTerm a) ioUnit (Cons (XAlternative (XConstructorPattern "One" (Cons (Just c) Nil)) (printInt (binary PAddInt (XVarTerm b) (XVarTerm c)))) Nil))) Nil))))))))

wideConstructor : XTerm
wideConstructor = (let { wide = (XCon "Wide" Nil) } in (let { declaration = (DataDecl "Wide" Nil (Cons (ConstructorDecl "Wide" (H.append (S.replicate 15 (Applied "Int" Nil)) (Cons (Function (Applied "Int" Nil) (Applied "Int" Nil)) (Cons (Applied "Wide" Nil) Nil)))) Nil)) } in (let { captured = (name 0) } in (let { tree = (name 1) } in (let { argument = (name 2) } in (let { function = (name 3) } in (let { next = (name 4) } in (let { numbers = (S.map name (S.range 10 23)) } in (let { fields = (Cons (panicInt "unused wide field") (H.append (S.map XIntTerm (S.range 1 14)) (Cons (XAbs argument int (binary PSubInt (XVarTerm captured) (XVarTerm argument))) (Cons (XVarTerm tree) Nil)))) } in ((XWithData (Cons declaration Nil)) ((XLet captured (binary PAddInt (XIntTerm 100) (XIntTerm 47))) ((XLetRec (Cons (Triple tree wide (S.foldl XApp (XConstructor "Wide" Nil) fields)) Nil)) (XCase (XVarTerm tree) ioUnit (Cons ((XAlternative (XConstructorPattern "Wide" (H.append (S.replicate 15 Nothing) (Cons (Just function) (Cons (Just next) Nil))))) (XCase (XVarTerm next) ioUnit (Cons ((XAlternative (XConstructorPattern "Wide" (Cons Nothing (H.append (S.map Just numbers) (Cons Nothing (Cons Nothing Nil)))))) (printInt (XApp (XVarTerm function) (S.foldr (S.compose (binary PAddInt) XVarTerm) (XIntTerm 0) numbers)))) Nil))) Nil))))))))))))))

numericConstructorSource : String
numericConstructorSource = (H.append "data Five = Five Int Int Int Int Int; let make = \\n -> ioReturn " (H.append "(Five n (addInt n 1) (addInt n 2) (addInt n 3) (addInt n 6)) in " (H.append "do { first <- make 6; second <- make 7; " (H.append "case first of { Five a b c d e -> printInt (addInt a (addInt b (addInt c (addInt d e)))) }; " "case second of { Five a b c d e -> printInt (addInt a (addInt b (addInt c (addInt d e)))) } }"))))

rawFiveCode : XTerm -> IO String
rawFiveCode term = do { _ <- (S.either H.fail return (Check.checkClosed term)); do { (Pair _ code) <- (S.either H.fail return (Codegen.generate (Map.fromList (Cons (Pair "Unit" (Pair 0 0)) (Cons (Pair "Five" (Pair 1 5)) Nil))) (X.erase term))); (let { alternatives = (S.concatMap (\comprehension12 -> case comprehension12 of { (Cons line rest) -> (if (OS.starts "define private ptr " line) then (let { body = (S.takeWhile (\section11 -> (S.not (H.eq section11 "}"))) rest) } in (if (S.any (\section10 -> (H.contains "switch i64 " section10)) body) then (Cons (S.unlines body) Nil) else Nil)) else Nil); _ -> Nil }) (H.tails (H.lines (S.unlines code)))) } in (case alternatives of { (Cons body Nil) -> (return body); _ -> (H.fail "field-liveness fixture did not retain exactly one constructor case") })) } }

constructorFieldsInput : (List ( Maybe XName )) -> XTerm -> XTerm
constructorFieldsInput fields body = (let { five = (XCon "Five" Nil) } in (let { constructorType = (S.foldr XArrow five (S.replicate 5 int)) } in (let { partialType = (XArrow int five) } in (let { constructor = (name 0) } in (let { partial = (name 1) } in (let { record = (name 2) } in (let { ret ty value = (XApp (XPrimitive PIOReturn (Cons ty Nil)) value) } in (let { bind ty action variable next = (XApp (XApp (XPrimitive PIOBind (Cons ty (Cons unit Nil))) action) (XAbs variable ty next)) } in ((XWithData (Cons (DataDecl "Five" Nil (Cons (ConstructorDecl "Five" (S.replicate 5 (Applied "Int" Nil))) Nil)) Nil)) ((bind constructorType (ret constructorType (XConstructor "Five" Nil)) constructor) ((bind partialType (ret partialType (S.foldl XApp (XVarTerm constructor) (S.concatMap (\i -> (Cons (panicInt (H.append "unused field " (H.show i))) Nil)) (S.range 0 3)))) partial) ((bind five (ret five (XApp (XVarTerm partial) (XIntTerm 41))) record) (XCase (XVarTerm record) ioUnit (Cons (XAlternative (XConstructorPattern "Five" fields) body) Nil))))))))))))))

capturedConstructorField : XTerm
capturedConstructorField = (let { captured = (name 7) } in (let { worker = (name 8) } in (let { counter = (name 9) } in (let { escaped = (name 10) } in (let { fn = (XArrow int int) } in ((constructorFieldsInput (Cons (Just (name 3)) (Cons (Just (name 4)) (Cons Nothing (Cons (Just (name 6)) (Cons (Just captured) Nil)))))) ((XLetRec (Cons (Triple worker fn (XAbs counter int (choose int (binary PEqInt (XVarTerm counter) (XIntTerm 0)) (XVarTerm captured) (binary PAddInt (XIntTerm 1) (XApp (XVarTerm worker) (binary PSubInt (XVarTerm counter) (XIntTerm 1))))))) Nil)) (XApp (XApp (XPrimitive PIOBind (Cons fn (Cons unit Nil))) (XApp (XPrimitive PIOReturn (Cons fn Nil)) (XVarTerm worker))) (XAbs escaped fn (sequenceIO (Cons (printInt (XApp (XVarTerm escaped) (XIntTerm 1))) (Cons (printInt (XApp (XVarTerm worker) (XIntTerm 2))) Nil))))))))))))

discardedConstructorFields : XTerm
discardedConstructorFields = (constructorFieldsInput (Cons (Just (name 3)) (Cons Nothing (Cons (Just (name 5)) (Cons Nothing (Cons (Just (name 7)) Nil))))) (printInt (XIntTerm 7)))
