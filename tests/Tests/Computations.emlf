module Tests.Computations where
import Bootstrap.Types
import qualified Bootstrap.Std as S
import qualified Package.OS as OS
import qualified Tests.Helpers as H
import Tests.Helpers (Quint(..), Sext(..))
import qualified Tests.Map as Map
import qualified Tests.Set as Set
import qualified Bootstrap.X.Check as C
import qualified Bootstrap.X.Syntax as X
import qualified Bootstrap.X.Type as T

v : Int -> XType
v = (S.compose XVar XTyVar)

allT : Int -> XType -> XType -> XType
allT = (S.compose XForall XTyVar)

int : XType
int = (XCon "Int" [])

bool : XType
bool = (XCon "Bool" [])

identity : XType
identity = (allT 0 XBot (XArrow (v 0) (v 0)))

sameType : XType -> XType -> IO ()
sameType actual expected = (H.assert (T.alphaEq actual expected) (H.append "expected " (H.append (H.show expected) (H.append ", got " (H.show actual)))))

computationTests : ([] ( (,) String (IO ()) ))
computationTests = (let { a = (XTyVar 0) } in (let { b = (XTyVar 1) } in ((:) (computation "Inst-Reflex" Map.empty XRefl identity identity) ((:) (computation "Inst-Bot" Map.empty (XBottom identity) XBot identity) ((:) (computation "Inst-Hyp" (Map.singleton b identity) (XHyp b) identity (XVar b)) ((:) (computation "Inst-Inner" Map.empty (XInner (XBottom int)) identity (XForall a int (XArrow (XVar a) (XVar a)))) ((:) (computation "Inst-Outer" Map.empty (XOuter a (X.typeApplication (XVar a))) (allT 0 XBot (allT 1 XBot (XArrow (v 0) (v 1)))) identity) ((:) (computation "Inst-Quant-Elim" Map.empty XElim (allT 0 int (XArrow (v 0) (v 0))) (XArrow int int)) ((:) (computation "Inst-Quant-Intro" Map.empty (XIntro a) int (XForall a XBot int)) ((:) (computation "Inst-Trans / System F application" Map.empty (X.typeApplication int) identity (XArrow int int)) ((:) (computation "outer alpha conversion" Map.empty (XOuter b XRefl) identity identity) ((:) ((,) "Inst-Hyp checks its bound" (H.reject (C.checkComputation (Map.singleton a int) (XHyp a) bool))) ((:) ((,) "Inst-Hyp requires a binding" (H.reject (C.checkComputation Map.empty (XHyp a) int))) ((:) ((,) "Inst-Bot requires bottom source" (H.reject (C.checkComputation Map.empty (XBottom bool) int))) ((:) ((,) "elimination requires a quantifier" (H.reject (C.checkComputation Map.empty XElim int))) ((:) ((,) "inner does not cross arrows" (H.reject (C.checkComputation Map.empty (XInner XElim) (XArrow identity identity)))) ((:) ((,) "introduction cannot capture" (H.reject (C.checkComputation (Map.singleton a XBot) (XIntro a) (XVar a)))) ((:) ((,) "outer cannot capture" (H.reject (C.checkComputation (Map.singleton b XBot) (XOuter b XRefl) (XForall a XBot (XArrow (XVar a) (XVar b)))))) ((:) ((,) "cyclic environments rejected" (H.reject (C.checkComputation (Map.fromList ((:) ((,) a (XVar b)) ((:) ((,) b (XVar a)) []))) XRefl int))) ((:) ((,) "malformed term environment rejected" (H.reject (C.infer (XEnv Map.empty (Map.singleton (XName 0 "x") (XVar a))) (XVarTerm (XName 0 "x"))))) []))))))))))))))))))))

computation : String -> Map XTyVar XType -> XComputation -> XType -> XType -> (,) String (IO ())
computation label env phi source expected = ((,) label (S.either H.fail (\section1 -> (sameType section1 expected)) (C.checkComputation env phi source)))

hygieneTests : ([] ( (,) String (IO ()) ))
hygieneTests = ((:) ((,) "capture-avoiding substitution" (let { t = (T.substitute (XTyVar 0) (v 1) (allT 1 XBot (XArrow (v 0) (v 1)))) } in do { (sameType t (allT 2 XBot (XArrow (v 1) (v 2)))); (H.assert (H.eq (T.freeVars t) (Set.singleton (XTyVar 1))) "free variable captured") })) ((:) ((,) "quantifier does not scope over its own bound" (let { t = (T.substitute (XTyVar 0) int (allT 0 (v 0) (v 0))) } in (sameType t (allT 0 int (v 0))))) ((:) ((,) "alpha-equivalence tracks shadowing" do { (H.assert (T.alphaEq (allT 0 XBot (allT 0 XBot (v 0))) (allT 1 XBot (allT 2 XBot (v 2)))) "shadowing was not recognized"); (H.assert (S.not (T.alphaEq (allT 0 XBot (allT 0 XBot (v 0))) (allT 1 XBot (allT 2 XBot (v 1))))) "shadowing changed binding") }) ((:) ((,) "type quantifiers have lexical scope" (S.either H.fail return (C.wellFormed (Map.singleton (XTyVar 0) int) identity))) ((:) ((,) "xMLF does not identify inert or alias bounds" do { (H.assert (S.not (T.alphaEq (allT 0 int (v 0)) int)) "unsound type equality"); (H.assert (S.not (T.alphaEq identity (allT 0 XBot (allT 1 (v 0) (XArrow (v 1) (v 0)))))) "alias bound erased") }) [])))))
