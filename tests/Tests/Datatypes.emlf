module Tests.Datatypes where
import Bootstrap.Types
import qualified Bootstrap.Std as S
import qualified Package.OS as OS
import qualified Tests.Helpers as H
import Tests.Helpers (Quint(..), Sext(..))
import Bootstrap.Compiler
import qualified Bootstrap.Data as D
import Bootstrap.Parser (parseProgram)
import qualified Bootstrap.X.Check as C
import qualified Bootstrap.X.Parser as P
import Bootstrap.X.Pretty (prettyTerm, prettyType)
import qualified Bootstrap.X.Syntax as X
import qualified Bootstrap.X.Type as T

checked : String -> IO Compilation
checked source = do { result <- (H.right (compile "<data test>" source)); do { parsed <- (H.right (P.parseTerm "<data xMLF>" (prettyTerm (compiledTerm result)))); do { ty <- (H.right (C.checkClosed parsed)); do { (H.assert (T.alphaEq ty (inferredType result)) "data xMLF round trip changed type"); do { (H.assert (H.eq (X.erase parsed) (X.erase (compiledTerm result))) "data xMLF round trip changed erasure"); (return result) } } } } }

hasType : String -> String -> XType -> (,) String (IO ())
hasType label source expected = ((,) (H.append "data: " label) do { result <- (checked source); (H.assert (T.alphaEq (inferredType result) expected) (H.append "expected " (H.append (prettyType expected) (H.append ", got " (prettyType (inferredType result)))))) })

rejects : String -> String -> String -> (,) String (IO ())
rejects label source reason = ((,) (H.append "data: " label) (case (compile "<data rejection>" source) of { (Left err) -> do { (H.assert (H.eq (phase err) Inference) (H.append "wrong rejection phase: " (H.show err))); (H.assert (H.contains reason (diagnostic err)) (H.append "wrong rejection reason: " (H.show err))) }; (Right result) -> (H.fail (H.append "unexpected acceptance: " (prettyType (inferredType result)))) }))

targetRejects : String -> XTerm -> String -> (,) String (IO ())
targetRejects label term reason = ((,) (H.append "data target: " label) (case (C.checkClosed term) of { (Left err) -> (H.assert (H.contains reason err) (H.append "wrong target rejection: " err)); (Right ty) -> (H.fail (H.append "unexpected target type: " (prettyType ty))) }))

int : XType
int = (XCon "Int" [])

bool : XType
bool = (XCon "Bool" [])

identity : XType
identity = (XForall (XTyVar 0) XBot (XArrow (v 0) (v 0)))

v : Int -> XType
v = (S.compose XVar XTyVar)

allT : Int -> XType -> XType
allT n = (XForall (XTyVar n) XBot)

maybeT : XType -> XType
maybeT t = (XCon "Maybe" ((:) t []))

maybeDecl : String
maybeDecl = "data Maybe a = Nothing | Just a; "

listDecl : String
listDecl = "data List a = Nil | Cons a (List a); "

pairDecl : String
pairDecl = "data Pair a b = Pair a b; "

maybeData : DataDecl
maybeData = (DataDecl "Maybe" ((:) "a" []) ((:) (ConstructorDecl "Nothing" []) ((:) (ConstructorDecl "Just" ((:) (Parameter "a") [])) [])))

withMaybe : XTerm -> XTerm
withMaybe = (XWithData ((:) maybeData []))

justInt : XTerm
justInt = (XApp (XConstructor "Just" ((:) int [])) (XIntTerm 42))

x : XName
x = (XName 1 "x")

nothing : XTerm -> XAlternative
nothing = (XAlternative (XConstructorPattern "Nothing" []))

just : XTerm -> XAlternative
just = (XAlternative (XConstructorPattern "Just" ((:) (Just x) [])))

datatypeTests : ([] ( (,) String (IO ()) ))
datatypeTests = (H.append ((:) (hasType "nullary constructor" "data Color = Red | Green | Blue; Red" (XCon "Color" [])) ((:) (hasType "polymorphic nullary constructor" (H.append maybeDecl "Nothing") (allT 0 (maybeT (v 0)))) ((:) (hasType "constructor is a first-class function" (H.append maybeDecl "Just") (allT 0 (XArrow (v 0) (maybeT (v 0))))) ((:) (hasType "constructor application" (H.append maybeDecl "Just 42") (maybeT int)) ((:) (hasType "partial constructor application" (H.append pairDecl "Pair 42") (allT 0 (XArrow (v 0) (XCon "Pair" ((:) int ((:) (v 0) [])))))) ((:) (hasType "multiple parameters" (H.append pairDecl "Pair 42 true") (XCon "Pair" ((:) int ((:) bool [])))) ((:) (hasType "let-bound constructor has independent instances" (H.append maybeDecl "let make = Just in let a = make 42 in make true") (maybeT bool)) ((:) (hasType "phantom parameter" "data Phantom a = Phantom; Phantom :: Phantom Int" (XCon "Phantom" ((:) int []))) ((:) (hasType "exhaustive case" (H.append maybeDecl "case Just 42 of { Nothing -> 0; Just x -> x }") int) ((:) (hasType "nested patterns" (H.append maybeDecl "case Just Nothing of { Just (Just x) -> x; _ -> 0 }") int) ((:) (hasType "reordered alternatives" (H.append maybeDecl "case Just 42 of { Just x -> x; Nothing -> 0; }") int) ((:) (hasType "case constrains scrutinee" (H.append maybeDecl "\\m -> case m of { Nothing -> 0; Just x -> x }") (XArrow (maybeT int) int)) ((:) (hasType "case returns its polymorphic scrutinee" (H.append maybeDecl "\\m -> case m of { Nothing -> m; Just _ -> m }") (allT 0 (XArrow (maybeT (v 0)) (maybeT (v 0))))) ((:) (hasType "case rebuilds polymorphic data" (H.append maybeDecl "\\m -> case m of { Nothing -> Nothing; Just x -> Just x }") (allT 0 (XArrow (maybeT (v 0)) (maybeT (v 0))))) ((:) (hasType "case generalizes an unconstrained result" (H.append maybeDecl "case Nothing of { Nothing -> Nothing; Just _ -> Nothing }") (allT 0 (maybeT (v 0)))) ((:) (hasType "case retains an MLF result bound" (H.append maybeDecl "\\m -> case m of { Nothing -> (\\x -> x); Just f -> f }") (XForall (XTyVar 1) identity (XArrow (maybeT (v 1)) (v 1)))) ((:) (hasType "generalized case function" (H.append maybeDecl "let get = \\d m -> case m of { Nothing -> d; Just x -> x } in let n = get 0 (Just 42) in get true Nothing") bool) ((:) (hasType "pattern field order" (H.append pairDecl "case Pair 42 true of { Pair n b -> b }") bool) ((:) (hasType "wildcard field" (H.append pairDecl "case Pair 42 true of { Pair _ b -> b }") bool) ((:) (hasType "multiple wildcard fields" (H.append pairDecl "case Pair 42 true of { Pair _ _ -> 0 }") int) ((:) (hasType "wildcard alternative" (H.append maybeDecl "case Just 42 of { Nothing -> 0; _ -> 1 }") int) ((:) (hasType "variable alternative and nested case" (H.append maybeDecl "case Just 42 of { Nothing -> 0; rest -> case rest of { Nothing -> 0; Just n -> n } }") int) ((:) (hasType "wildcard-only case" "case 42 of { _ -> true }" bool) ((:) (hasType "variable-only case" "case 42 of { n -> n }" int) ((:) (hasType "pattern shadows outer variable" (H.append maybeDecl "let x = true in case Just 42 of { Nothing -> 0; Just x -> x }") int) ((:) (hasType "recursive list" (H.append listDecl "Cons 1 (Cons 2 Nil)") (XCon "List" ((:) int []))) ((:) (hasType "recursive list deconstruction" (H.append listDecl "case Cons 1 (Cons 2 Nil) of { Nil -> 0; Cons x xs -> case xs of { Nil -> x; Cons y _ -> y } }") int) ((:) (hasType "recursive tree" "data Tree a = Leaf a | Node (Tree a) (Tree a); Node (Leaf 1) (Leaf 2)" (XCon "Tree" ((:) int []))) ((:) (hasType "mutually recursive declarations" "data A = MkA B; data B = End | MkB A; case MkA (MkB (MkA End)) of { MkA b -> b }" (XCon "B" [])) ((:) (hasType "non-regular recursive declaration" "data Nested a = Stop a | More (Nested (Nested a)); More (Stop (Stop 42))" (XCon "Nested" ((:) int []))) ((:) (hasType "function field" "data Fn a b = Fn (a -> b); case Fn (\\x -> x) of { Fn f -> f 42 }" int) ((:) (hasType "polymorphic type argument" (H.append maybeDecl "Just (\\x -> x) : Maybe (forall a. a -> a)") (maybeT identity)) ((:) (hasType "polymorphic case result" (H.append maybeDecl "case Just (\\x -> x) of { Nothing -> (\\x -> x); Just f -> f }") identity) ((:) (hasType "polymorphic field used with an explicit annotation" (H.append maybeDecl "case (Just (\\x -> x) : Maybe (forall a. a -> a)) of { Nothing -> true; Just f -> let p = (f : forall a. a -> a) in let n = p 42 in p true }") bool) ((:) (hasType "declaration parameter is not a target keyword" "data Box id = Box id; Box 42" (XCon "Box" ((:) int []))) ((:) (hasType "explicitly polymorphic field" "data Box = Box (forall a. a -> a); case Box (\\x -> x) of { Box f -> let id = f : forall a. a -> a in let n = id 1 in id true }" bool) ((:) (rejects "unknown constructor" "Just 42" "unknown data constructor: Just") ((:) (rejects "wrong field type" (H.append listDecl "Cons true (Cons 42 Nil)") "type constructor mismatch") ((:) (rejects "pattern fields are not implicitly generalized" (H.append maybeDecl "case Just (\\x -> x) of { Nothing -> true; Just f -> let n = f 1 in f true }") "type constructor mismatch") ((:) (rejects "overapplied nullary constructor" (H.append maybeDecl "Nothing 42") "type constructor mismatch") ((:) (rejects "wrong scrutinee type" (H.append maybeDecl "case 42 of { Nothing -> 0; Just x -> x }") "type constructor mismatch") ((:) (rejects "inconsistent branch results" (H.append maybeDecl "case Just 42 of { Nothing -> true; Just x -> x }") "type constructor mismatch") ((:) (rejects "non-exhaustive case" (H.append maybeDecl "case Just 42 of { Just x -> x }") "non-exhaustive case; missing: Nothing") ((:) (rejects "too few pattern fields" (H.append maybeDecl "case Just 42 of { Nothing -> 0; Just -> 1 }") "constructor pattern arity mismatch") ((:) (rejects "too many pattern fields" (H.append maybeDecl "case Just 42 of { Nothing x -> x; Just x -> x }") "constructor pattern arity mismatch") ((:) (rejects "duplicate constructor alternative" (H.append maybeDecl "case Just 42 of { Nothing -> 0; Just x -> x; Just y -> y }") "duplicate constructor alternative") ((:) (rejects "mixed datatype alternatives" (H.append maybeDecl "case Just 42 of { Nothing -> 0; Just x -> x; Unit -> 0 }") "different data types") ((:) (rejects "default must be last" (H.append maybeDecl "case Just 42 of { _ -> 0; Just x -> x }") "default alternative must be last") ((:) (rejects "duplicate pattern variable" (H.append pairDecl "case Pair 1 2 of { Pair x x -> x }") "duplicate pattern variable") ((:) (rejects "pattern variables do not escape" (H.append maybeDecl "let v = case Just 42 of { Nothing -> 0; Just x -> x } in x") "unbound variable: x") ((:) (rejects "pattern variable unavailable in sibling branch" (H.append maybeDecl "case Just 42 of { Just x -> x; Nothing -> x }") "unbound variable: x") ((:) (rejects "duplicate datatype" "data T = A; data T = B; A" "duplicate data type") ((:) (rejects "duplicate constructor across datatypes" "data T = A; data U = A; A" "duplicate data constructor") ((:) (rejects "duplicate constructor within datatype" "data T = A | A; A" "duplicate data constructor") ((:) (rejects "duplicate type parameter" "data T a a = A a; A 1" "duplicate type parameter") ((:) (rejects "free field type parameter" "data T a = A b; A 1" "unbound data type parameter: b") ((:) (rejects "unknown field type" "data T = A Missing; A" "unknown field type: Missing") ((:) (rejects "recursive type arity" "data T a = A (T a a); A" "invalid type constructor arity: T") ((:) (rejects "declared annotation arity" (H.append maybeDecl "(\\x -> x) : Maybe -> Maybe") "invalid type constructor arity: Maybe") ((:) (rejects "primitive type redefinition" "data Int = Number; Number" "cannot redefine a primitive type") ((:) (rejects "reserved datatype name" "data True = MkTrue; MkTrue" "reserved data type name") ((:) (rejects "primitive constructor redefinition" "data T = True; True" "cannot redefine a primitive constructor") ((:) ((,) "data: declaration and case parse tree" do { program <- (H.right (parseProgram "<data syntax>" (H.append maybeDecl "case Just 1 of { Nothing -> 0; Just x -> x }"))); (let { expected = (SProgram ((:) maybeData []) (SCase (SApp (SConstructor "Just") (SIntLit 1)) ((:) (SAlternative (SConstructorPattern "Nothing" []) (SIntLit 0)) ((:) (SAlternative (SConstructorPattern "Just" ((:) (Just "x") [])) (SVar "x")) [])))) } in (H.assert (H.eq program expected) "unexpected declaration or case AST")) }) ((:) ((,) "data: empty declaration rejected by AST API" (case (compileProgram (SProgram ((:) (DataDecl "Void" [] []) []) (SIntLit 1))) of { (Left err) -> (H.assert ((H.eq (phase err) Inference) && (H.contains "no constructors" (diagnostic err))) (H.show err)); (Right _) -> (H.fail "empty declaration accepted") })) ((:) ((,) "data: constructor and case erasure" do { result <- (checked (H.append maybeDecl "case Just 42 of { Nothing -> 0; Just x -> x }")); (case (X.erase (compiledTerm result)) of { (XECase (XEApp (XEConstructor "Just") (XEInt 42)) ((:) (XErasedAlternative (XConstructorPattern "Nothing" []) (XEInt 0)) ((:) (XErasedAlternative (XConstructorPattern "Just" ((:) (Just n) [])) (XEVar m)) []))) -> (H.assert (H.eq n m) "case erasure changed the pattern binder"); other -> (H.fail (H.append "unexpected case erasure: " (H.show other))) }) }) ((:) ((,) "data target: independent constructor and case typing" do { ty <- (H.right (C.checkClosed (withMaybe (XCase justInt int ((:) (nothing (XIntTerm 0)) ((:) (just (XVarTerm x)) [])))))); (H.assert (T.alphaEq ty int) "wrong target case type") }) ((:) (targetRejects "unknown constructor" (XConstructor "Just" ((:) int [])) "unknown data constructor") ((:) (targetRejects "constructor type argument count" (withMaybe (XConstructor "Just" [])) "type argument arity mismatch") ((:) (targetRejects "constructor type argument is well formed" (withMaybe (XConstructor "Just" ((:) (v 0) []))) "unbound type variable") ((:) (targetRejects "constructor field type" (withMaybe (XApp (XConstructor "Just" ((:) bool [])) (XIntTerm 42))) "application type mismatch") ((:) (targetRejects "non-exhaustive case" (withMaybe (XCase justInt int ((:) (just (XVarTerm x)) []))) "non-exhaustive case") ((:) (targetRejects "empty case" (withMaybe (XCase justInt int [])) "case has no alternatives") ((:) (targetRejects "case result type" (withMaybe (XCase justInt bool ((:) (nothing (XBoolTerm true)) ((:) (just (XVarTerm x)) [])))) "alternative result type mismatch") ((:) (targetRejects "case scrutinee type" (withMaybe (XCase (XIntTerm 42) int ((:) (nothing (XIntTerm 0)) ((:) (just (XVarTerm x)) [])))) "wrong data type") ((:) (targetRejects "pattern field count" (withMaybe (XCase justInt int ((:) (nothing (XIntTerm 0)) ((:) (XAlternative (XConstructorPattern "Just" []) (XIntTerm 1)) [])))) "pattern arity mismatch") ((:) (targetRejects "repeated alternative" (withMaybe (XCase justInt int ((:) (nothing (XIntTerm 0)) ((:) (just (XVarTerm x)) ((:) (just (XVarTerm x)) []))))) "duplicate constructor alternative") ((:) (targetRejects "pattern binder freshness" (withMaybe (XAbs x int (XCase justInt int ((:) (nothing (XIntTerm 0)) ((:) (just (XVarTerm x)) []))))) "pattern binder already in scope") ((:) (targetRejects "pattern scope" (withMaybe (XCase justInt int ((:) (nothing (XVarTerm x)) ((:) (just (XVarTerm x)) [])))) "unbound term variable") ((:) (targetRejects "declared arity in an annotation" (withMaybe (XAbs x (XCon "Maybe" []) (XVarTerm x))) "invalid type constructor arity") ((:) (targetRejects "declared arity inside a type computation" (withMaybe (XTypeApp (XTypeAbs (XTyVar 0) XBot (XIntTerm 1)) (XInner (XBottom (XCon "Maybe" []))))) "invalid type constructor arity") ((:) (targetRejects "invalid declaration" (XWithData ((:) (DataDecl "T" [] ((:) (ConstructorDecl "T" ((:) (Parameter "a") [])) [])) []) (XIntTerm 1)) "unbound data type parameter") ((:) (targetRejects "nested declaration scope" (XAbs x int (withMaybe (XVarTerm x))) "outermost level") [])))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))) (S.concatMap (\((,) label source) -> ((:) ((,) (H.append "data syntax: " label) (case (parseProgram "<invalid data syntax>" source) of { (Left _) -> (return ()); (Right parsed) -> (H.fail (H.append "unexpected parse: " (H.show parsed))) })) [])) ((:) ((,) "declaration separator required" "data T = T T") ((:) ((,) "lowercase constructor" "data T = bad; bad") ((:) ((,) "empty case" (H.append maybeDecl "case Nothing of {}")) ((:) ((,) "wildcard token boundary" (H.append pairDecl "case Pair 1 2 of { Pair _x -> 0 }")) []))))))
