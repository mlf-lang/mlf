module Tests.Datatypes where
import Bootstrap.Types
import qualified Bootstrap.Std as S
import qualified Package.OS as OS
import qualified Tests.Helpers as H
import Tests.Helpers (Quint(..), Sext(..))
import Bootstrap.Compiler
import qualified Bootstrap.Data as D
import Bootstrap.Parser (parseProgram)
import qualified Bootstrap.X.Check as C
import qualified Bootstrap.X.Parser as P
import Bootstrap.X.Pretty (prettyTerm, prettyType)
import qualified Bootstrap.X.Syntax as X
import qualified Bootstrap.X.Type as T

checked : String -> IO Compilation
checked source = do { result <- (H.right (compile "<data test>" source)); do { parsed <- (H.right (P.parseTerm "<data xMLF>" (prettyTerm (compiledTerm result)))); do { ty <- (H.right (C.checkClosed parsed)); do { (H.assert (T.alphaEq ty (inferredType result)) "data xMLF round trip changed type"); do { (H.assert (H.eq (X.erase parsed) (X.erase (compiledTerm result))) "data xMLF round trip changed erasure"); (return result) } } } } }

hasType : String -> String -> XType -> Pair String (IO Unit)
hasType label source expected = (Pair (H.append "data: " label) do { result <- (checked source); (H.assert (T.alphaEq (inferredType result) expected) (H.append "expected " (H.append (prettyType expected) (H.append ", got " (prettyType (inferredType result)))))) })

rejects : String -> String -> String -> Pair String (IO Unit)
rejects label source reason = (Pair (H.append "data: " label) (case (compile "<data rejection>" source) of { (Left err) -> do { (H.assert (H.eq (phase err) Inference) (H.append "wrong rejection phase: " (H.show err))); (H.assert (H.contains reason (diagnostic err)) (H.append "wrong rejection reason: " (H.show err))) }; (Right result) -> (H.fail (H.append "unexpected acceptance: " (prettyType (inferredType result)))) }))

targetRejects : String -> XTerm -> String -> Pair String (IO Unit)
targetRejects label term reason = (Pair (H.append "data target: " label) (case (C.checkClosed term) of { (Left err) -> (H.assert (H.contains reason err) (H.append "wrong target rejection: " err)); (Right ty) -> (H.fail (H.append "unexpected target type: " (prettyType ty))) }))

int : XType
int = (XCon "Int" Nil)

bool : XType
bool = (XCon "Bool" Nil)

identity : XType
identity = (XForall (XTyVar 0) XBot (XArrow (v 0) (v 0)))

v : Int -> XType
v = (S.compose XVar XTyVar)

allT : Int -> XType -> XType
allT n = (XForall (XTyVar n) XBot)

maybeT : XType -> XType
maybeT t = (XCon "Maybe" (Cons t Nil))

maybeDecl : String
maybeDecl = "data Maybe a = Nothing | Just a; "

listDecl : String
listDecl = "data List a = Nil | Cons a (List a); "

pairDecl : String
pairDecl = "data Pair a b = Pair a b; "

maybeData : DataDecl
maybeData = (DataDecl "Maybe" (Cons "a" Nil) (Cons (ConstructorDecl "Nothing" Nil) (Cons (ConstructorDecl "Just" (Cons (Parameter "a") Nil)) Nil)))

withMaybe : XTerm -> XTerm
withMaybe = (XWithData (Cons maybeData Nil))

justInt : XTerm
justInt = (XApp (XConstructor "Just" (Cons int Nil)) (XIntTerm 42))

x : XName
x = (XName 1 "x")

nothing : XTerm -> XAlternative
nothing = (XAlternative (XConstructorPattern "Nothing" Nil))

just : XTerm -> XAlternative
just = (XAlternative (XConstructorPattern "Just" (Cons (Just x) Nil)))

datatypeTests : (List ( Pair String (IO Unit) ))
datatypeTests = (H.append (Cons (hasType "nullary constructor" "data Color = Red | Green | Blue; Red" (XCon "Color" Nil)) (Cons (hasType "polymorphic nullary constructor" (H.append maybeDecl "Nothing") (allT 0 (maybeT (v 0)))) (Cons (hasType "constructor is a first-class function" (H.append maybeDecl "Just") (allT 0 (XArrow (v 0) (maybeT (v 0))))) (Cons (hasType "constructor application" (H.append maybeDecl "Just 42") (maybeT int)) (Cons (hasType "partial constructor application" (H.append pairDecl "Pair 42") (allT 0 (XArrow (v 0) (XCon "Pair" (Cons int (Cons (v 0) Nil)))))) (Cons (hasType "multiple parameters" (H.append pairDecl "Pair 42 true") (XCon "Pair" (Cons int (Cons bool Nil)))) (Cons (hasType "let-bound constructor has independent instances" (H.append maybeDecl "let make = Just in let a = make 42 in make true") (maybeT bool)) (Cons (hasType "phantom parameter" "data Phantom a = Phantom; Phantom : Phantom Int" (XCon "Phantom" (Cons int Nil))) (Cons (hasType "exhaustive case" (H.append maybeDecl "case Just 42 of { Nothing -> 0; Just x -> x }") int) (Cons (hasType "nested patterns" (H.append maybeDecl "case Just Nothing of { Just (Just x) -> x; _ -> 0 }") int) (Cons (hasType "reordered alternatives" (H.append maybeDecl "case Just 42 of { Just x -> x; Nothing -> 0; }") int) (Cons (hasType "case constrains scrutinee" (H.append maybeDecl "\\m -> case m of { Nothing -> 0; Just x -> x }") (XArrow (maybeT int) int)) (Cons (hasType "case returns its polymorphic scrutinee" (H.append maybeDecl "\\m -> case m of { Nothing -> m; Just _ -> m }") (allT 0 (XArrow (maybeT (v 0)) (maybeT (v 0))))) (Cons (hasType "case rebuilds polymorphic data" (H.append maybeDecl "\\m -> case m of { Nothing -> Nothing; Just x -> Just x }") (allT 0 (XArrow (maybeT (v 0)) (maybeT (v 0))))) (Cons (hasType "case generalizes an unconstrained result" (H.append maybeDecl "case Nothing of { Nothing -> Nothing; Just _ -> Nothing }") (allT 0 (maybeT (v 0)))) (Cons (hasType "case retains an MLF result bound" (H.append maybeDecl "\\m -> case m of { Nothing -> (\\x -> x); Just f -> f }") (XForall (XTyVar 1) identity (XArrow (maybeT (v 1)) (v 1)))) (Cons (hasType "generalized case function" (H.append maybeDecl "let get = \\d m -> case m of { Nothing -> d; Just x -> x } in let n = get 0 (Just 42) in get true Nothing") bool) (Cons (hasType "pattern field order" (H.append pairDecl "case Pair 42 true of { Pair n b -> b }") bool) (Cons (hasType "wildcard field" (H.append pairDecl "case Pair 42 true of { Pair _ b -> b }") bool) (Cons (hasType "multiple wildcard fields" (H.append pairDecl "case Pair 42 true of { Pair _ _ -> 0 }") int) (Cons (hasType "wildcard alternative" (H.append maybeDecl "case Just 42 of { Nothing -> 0; _ -> 1 }") int) (Cons (hasType "variable alternative and nested case" (H.append maybeDecl "case Just 42 of { Nothing -> 0; rest -> case rest of { Nothing -> 0; Just n -> n } }") int) (Cons (hasType "wildcard-only case" "case 42 of { _ -> true }" bool) (Cons (hasType "variable-only case" "case 42 of { n -> n }" int) (Cons (hasType "pattern shadows outer variable" (H.append maybeDecl "let x = true in case Just 42 of { Nothing -> 0; Just x -> x }") int) (Cons (hasType "recursive list" (H.append listDecl "Cons 1 (Cons 2 Nil)") (XCon "List" (Cons int Nil))) (Cons (hasType "recursive list deconstruction" (H.append listDecl "case Cons 1 (Cons 2 Nil) of { Nil -> 0; Cons x xs -> case xs of { Nil -> x; Cons y _ -> y } }") int) (Cons (hasType "recursive tree" "data Tree a = Leaf a | Node (Tree a) (Tree a); Node (Leaf 1) (Leaf 2)" (XCon "Tree" (Cons int Nil))) (Cons (hasType "mutually recursive declarations" "data A = MkA B; data B = End | MkB A; case MkA (MkB (MkA End)) of { MkA b -> b }" (XCon "B" Nil)) (Cons (hasType "non-regular recursive declaration" "data Nested a = Stop a | More (Nested (Nested a)); More (Stop (Stop 42))" (XCon "Nested" (Cons int Nil))) (Cons (hasType "function field" "data Fn a b = Fn (a -> b); case Fn (\\x -> x) of { Fn f -> f 42 }" int) (Cons (hasType "polymorphic type argument" (H.append maybeDecl "Just (\\x -> x) : Maybe (forall a. a -> a)") (maybeT identity)) (Cons (hasType "polymorphic case result" (H.append maybeDecl "case Just (\\x -> x) of { Nothing -> (\\x -> x); Just f -> f }") identity) (Cons (hasType "polymorphic field used with an explicit annotation" (H.append maybeDecl "case (Just (\\x -> x) : Maybe (forall a. a -> a)) of { Nothing -> true; Just f -> let p = (f : forall a. a -> a) in let n = p 42 in p true }") bool) (Cons (hasType "declaration parameter is not a target keyword" "data Box id = Box id; Box 42" (XCon "Box" (Cons int Nil))) (Cons (hasType "explicitly polymorphic field" "data Box = Box (forall a. a -> a); case Box (\\x -> x) of { Box f -> let id = f : forall a. a -> a in let n = id 1 in id true }" bool) (Cons (rejects "unknown constructor" "Just 42" "unknown data constructor: Just") (Cons (rejects "wrong field type" (H.append listDecl "Cons true (Cons 42 Nil)") "type constructor mismatch") (Cons (rejects "pattern fields are not implicitly generalized" (H.append maybeDecl "case Just (\\x -> x) of { Nothing -> true; Just f -> let n = f 1 in f true }") "type constructor mismatch") (Cons (rejects "overapplied nullary constructor" (H.append maybeDecl "Nothing 42") "type constructor mismatch") (Cons (rejects "wrong scrutinee type" (H.append maybeDecl "case 42 of { Nothing -> 0; Just x -> x }") "type constructor mismatch") (Cons (rejects "inconsistent branch results" (H.append maybeDecl "case Just 42 of { Nothing -> true; Just x -> x }") "type constructor mismatch") (Cons (rejects "non-exhaustive case" (H.append maybeDecl "case Just 42 of { Just x -> x }") "non-exhaustive case; missing: Nothing") (Cons (rejects "too few pattern fields" (H.append maybeDecl "case Just 42 of { Nothing -> 0; Just -> 1 }") "constructor pattern arity mismatch") (Cons (rejects "too many pattern fields" (H.append maybeDecl "case Just 42 of { Nothing x -> x; Just x -> x }") "constructor pattern arity mismatch") (Cons (rejects "duplicate constructor alternative" (H.append maybeDecl "case Just 42 of { Nothing -> 0; Just x -> x; Just y -> y }") "duplicate constructor alternative") (Cons (rejects "mixed datatype alternatives" (H.append maybeDecl "case Just 42 of { Nothing -> 0; Just x -> x; Unit -> 0 }") "different data types") (Cons (rejects "default must be last" (H.append maybeDecl "case Just 42 of { _ -> 0; Just x -> x }") "default alternative must be last") (Cons (rejects "duplicate pattern variable" (H.append pairDecl "case Pair 1 2 of { Pair x x -> x }") "duplicate pattern variable") (Cons (rejects "pattern variables do not escape" (H.append maybeDecl "let v = case Just 42 of { Nothing -> 0; Just x -> x } in x") "unbound variable: x") (Cons (rejects "pattern variable unavailable in sibling branch" (H.append maybeDecl "case Just 42 of { Just x -> x; Nothing -> x }") "unbound variable: x") (Cons (rejects "duplicate datatype" "data T = A; data T = B; A" "duplicate data type") (Cons (rejects "duplicate constructor across datatypes" "data T = A; data U = A; A" "duplicate data constructor") (Cons (rejects "duplicate constructor within datatype" "data T = A | A; A" "duplicate data constructor") (Cons (rejects "duplicate type parameter" "data T a a = A a; A 1" "duplicate type parameter") (Cons (rejects "free field type parameter" "data T a = A b; A 1" "unbound data type parameter: b") (Cons (rejects "unknown field type" "data T = A Missing; A" "unknown field type: Missing") (Cons (rejects "recursive type arity" "data T a = A (T a a); A" "invalid type constructor arity: T") (Cons (rejects "declared annotation arity" (H.append maybeDecl "(\\x -> x) : Maybe -> Maybe") "invalid type constructor arity: Maybe") (Cons (rejects "primitive type redefinition" "data Int = Number; Number" "cannot redefine a primitive type") (Cons (rejects "reserved datatype name" "data True = MkTrue; MkTrue" "reserved data type name") (Cons (rejects "primitive constructor redefinition" "data T = True; True" "cannot redefine a primitive constructor") (Cons (Pair "data: declaration and case parse tree" do { program <- (H.right (parseProgram "<data syntax>" (H.append maybeDecl "case Just 1 of { Nothing -> 0; Just x -> x }"))); (let { expected = (SProgram (Cons maybeData Nil) (SCase (SApp (SConstructor "Just") (SIntLit 1)) (Cons (SAlternative (SConstructorPattern "Nothing" Nil) (SIntLit 0)) (Cons (SAlternative (SConstructorPattern "Just" (Cons (Just "x") Nil)) (SVar "x")) Nil)))) } in (H.assert (H.eq program expected) "unexpected declaration or case AST")) }) (Cons (Pair "data: empty declaration rejected by AST API" (case (compileProgram (SProgram (Cons (DataDecl "Void" Nil Nil) Nil) (SIntLit 1))) of { (Left err) -> (H.assert ((H.eq (phase err) Inference) && (H.contains "no constructors" (diagnostic err))) (H.show err)); (Right _) -> (H.fail "empty declaration accepted") })) (Cons (Pair "data: constructor and case erasure" do { result <- (checked (H.append maybeDecl "case Just 42 of { Nothing -> 0; Just x -> x }")); (case (X.erase (compiledTerm result)) of { (XECase (XEApp (XEConstructor "Just") (XEInt 42)) (Cons (XErasedAlternative (XConstructorPattern "Nothing" Nil) (XEInt 0)) (Cons (XErasedAlternative (XConstructorPattern "Just" (Cons (Just n) Nil)) (XEVar m)) Nil))) -> (H.assert (H.eq n m) "case erasure changed the pattern binder"); other -> (H.fail (H.append "unexpected case erasure: " (H.show other))) }) }) (Cons (Pair "data target: independent constructor and case typing" do { ty <- (H.right (C.checkClosed (withMaybe (XCase justInt int (Cons (nothing (XIntTerm 0)) (Cons (just (XVarTerm x)) Nil)))))); (H.assert (T.alphaEq ty int) "wrong target case type") }) (Cons (targetRejects "unknown constructor" (XConstructor "Just" (Cons int Nil)) "unknown data constructor") (Cons (targetRejects "constructor type argument count" (withMaybe (XConstructor "Just" Nil)) "type argument arity mismatch") (Cons (targetRejects "constructor type argument is well formed" (withMaybe (XConstructor "Just" (Cons (v 0) Nil))) "unbound type variable") (Cons (targetRejects "constructor field type" (withMaybe (XApp (XConstructor "Just" (Cons bool Nil)) (XIntTerm 42))) "application type mismatch") (Cons (targetRejects "non-exhaustive case" (withMaybe (XCase justInt int (Cons (just (XVarTerm x)) Nil))) "non-exhaustive case") (Cons (targetRejects "empty case" (withMaybe (XCase justInt int Nil)) "case has no alternatives") (Cons (targetRejects "case result type" (withMaybe (XCase justInt bool (Cons (nothing (XBoolTerm true)) (Cons (just (XVarTerm x)) Nil)))) "alternative result type mismatch") (Cons (targetRejects "case scrutinee type" (withMaybe (XCase (XIntTerm 42) int (Cons (nothing (XIntTerm 0)) (Cons (just (XVarTerm x)) Nil)))) "wrong data type") (Cons (targetRejects "pattern field count" (withMaybe (XCase justInt int (Cons (nothing (XIntTerm 0)) (Cons (XAlternative (XConstructorPattern "Just" Nil) (XIntTerm 1)) Nil)))) "pattern arity mismatch") (Cons (targetRejects "repeated alternative" (withMaybe (XCase justInt int (Cons (nothing (XIntTerm 0)) (Cons (just (XVarTerm x)) (Cons (just (XVarTerm x)) Nil))))) "duplicate constructor alternative") (Cons (targetRejects "pattern binder freshness" (withMaybe (XAbs x int (XCase justInt int (Cons (nothing (XIntTerm 0)) (Cons (just (XVarTerm x)) Nil))))) "pattern binder already in scope") (Cons (targetRejects "pattern scope" (withMaybe (XCase justInt int (Cons (nothing (XVarTerm x)) (Cons (just (XVarTerm x)) Nil)))) "unbound term variable") (Cons (targetRejects "declared arity in an annotation" (withMaybe (XAbs x (XCon "Maybe" Nil) (XVarTerm x))) "invalid type constructor arity") (Cons (targetRejects "declared arity inside a type computation" (withMaybe (XTypeApp (XTypeAbs (XTyVar 0) XBot (XIntTerm 1)) (XInner (XBottom (XCon "Maybe" Nil))))) "invalid type constructor arity") (Cons (targetRejects "invalid declaration" (XWithData (Cons (DataDecl "T" Nil (Cons (ConstructorDecl "T" (Cons (Parameter "a") Nil)) Nil)) Nil) (XIntTerm 1)) "unbound data type parameter") (Cons (targetRejects "nested declaration scope" (XAbs x int (withMaybe (XVarTerm x))) "outermost level") Nil)))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))) (S.concatMap (\(Pair label source) -> (Cons (Pair (H.append "data syntax: " label) (case (parseProgram "<invalid data syntax>" source) of { (Left _) -> (return Unit); (Right parsed) -> (H.fail (H.append "unexpected parse: " (H.show parsed))) })) Nil)) (Cons (Pair "declaration separator required" "data T = T T") (Cons (Pair "lowercase constructor" "data T = bad; bad") (Cons (Pair "empty case" (H.append maybeDecl "case Nothing of {}")) (Cons (Pair "wildcard token boundary" (H.append pairDecl "case Pair 1 2 of { Pair _x -> 0 }")) Nil))))))
