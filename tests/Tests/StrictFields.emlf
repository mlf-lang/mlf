module Tests.StrictFields where
import Bootstrap.Types
import qualified Bootstrap.Std as S
import qualified Package.OS as OS
import qualified Tests.Helpers as H
import Tests.Helpers (Quint(..), Sext(..))
import qualified Tests.Map as M
import Tests.Backends
import qualified Tests.Backends as B
import Bootstrap.Compiler (compile, compiledTerm)
import qualified Bootstrap.Data as D
import qualified Bootstrap.LLVM.Codegen as G
import qualified Bootstrap.Primitive as P
import qualified Bootstrap.X.Check as Check
import qualified Bootstrap.X.Syntax as X
import qualified Bootstrap.X.Type as T

observe : B.Backends -> XTerm -> String -> IO Unit
observe backends term expected = do { result <- (B.execute backends IOEntry (Input "" false) term); do { (S.either (S.compose H.fail H.show) return (B.outcome result)); (S.unless (H.eq (B.output result) expected) (H.fail (H.show result))) } }

strictFieldTests : B.Backends -> (List ( (Pair (String) (IO Unit)) ))
strictFieldTests backends = (let { source = (S.unlines (Cons "data StrictTriple = StrictTriple Int Int Int" (Cons "data LazyTriple = LazyTriple Int Int Int" (Cons "data PartialTriple = PartialTriple Int Int Int" (Cons "data Chain = Chain Int Chain Int" (Cons "data Captured = Captured Int Int Int" (Cons "data Mixed = Mixed Int Int Int" (Cons "" (Cons "strictTriple : Int -> Int -> Int -> Int -> StrictTriple" (Cons "strictTriple count x y z = if count == 0 then seq x (seq y (seq z (StrictTriple x y z))) else strictTriple (count - 1) x y z" (Cons "lazyTriple : Int -> Int -> LazyTriple" (Cons "lazyTriple count x = if count == 0 then LazyTriple x (quotInt 1 0) 9 else lazyTriple (count - 1) x" (Cons "partialTriple : Int -> Int -> Int -> PartialTriple" (Cons "partialTriple count = if count == 0 then PartialTriple 4 else partialTriple (count - 1)" (Cons "chain : Chain" (Cons "chain = Chain 5 chain 7" (Cons "capture x = seq x (\\ignored -> Captured x 8 10)" (Cons "strictMixed : Int -> Int -> Mixed" (Cons "strictMixed count x = if count == 0 then seq x (Mixed x 1 2) else strictMixed (count - 1) x" (Cons "lazyMixed : Int -> Int -> Mixed" (Cons "lazyMixed count x = if count == 0 then Mixed x (quotInt 1 0) 12 else lazyMixed (count - 1) x" (Cons "" (Cons "main = do" (Cons "  case strictTriple 3 1 2 3 of" (Cons "    StrictTriple x y z -> seq x (seq y (seq z (printInt (x + y + z))))" (Cons "  case lazyTriple 3 2 of" (Cons "    LazyTriple x poison z -> seq x (seq z (printInt (x + z)))" (Cons "  case partialTriple 3 (quotInt 1 0) 3 of" (Cons "    PartialTriple x poison z -> seq x (seq z (printInt (x + z)))" (Cons "  case chain of" (Cons "    Chain x rest z -> case rest of" (Cons "      Chain y next w -> seq x (seq y (seq z (seq w (printInt (x + y + z + w)))))" (Cons "  case capture 6 0 of" (Cons "    Captured x y z -> seq x (seq y (seq z (printInt (x + y + z))))" (Cons "  case strictMixed 3 7 of" (Cons "    Mixed x y z -> seq x (seq y (seq z (printInt (x + y + z))))" (Cons "  case lazyMixed 3 8 of" (Cons "    Mixed x poison z -> seq x (seq z (printInt (x + z)))" Nil)))))))))))))))))))))))))))))))))))))) } in (Cons (Pair "strict constructor fields: checked lowering uses the pointer proof" do { _ <- (S.either H.fail return (Check.checkClosed lowered)); do { (Pair entry code) <- (S.either H.fail return (G.generate (M.fromList (Cons (Pair "Unit" (Pair 0 0)) (Cons (Pair "Cell" (Pair 1 1)) Nil))) (X.erase lowered))); do { (case (S.filter (\section1 -> (OS.starts (H.append "define private ptr " (H.append entry "(")) section1)) code) of { (Cons body Nil) -> (S.unless (S.not (H.contains "call ptr @mlf_force(" body)) (H.fail "proven constructor field was forced")); _ -> (H.fail "missing strict-field lowering entry") }); (observe backends lowered "42\n") } } }) (Cons (Pair "strict constructor fields: lazy, partial, mixed and recursive values" do { term <- (H.fmap compiledTerm (S.either (S.compose H.fail H.show) return (compile "<strict fields>" source))); (observe backends term "6\n11\n7\n24\n24\n10\n20\n") }) Nil)))

lowered : XTerm
lowered = (let { function = (XName 0 "constructor") } in (let { value = (XName 1 "value") } in (let { field = (XName 2 "field") } in (let { int = (XCon "Int" Nil) } in (let { cell = (XCon "Cell" Nil) } in (let { ioUnit = (XCon "IO" (Cons (XCon "Unit" Nil) Nil)) } in (let { sequenceWith result a b = (XApp (XApp (XPrimitive PSeq (Cons int (Cons result Nil))) a) b) } in ((XWithData (Cons (DataDecl "Cell" Nil (Cons (ConstructorDecl "Cell" (Cons (Applied "Int" Nil) Nil)) Nil)) Nil)) ((XLet function (XAbs value int (sequenceWith cell (XVarTerm value) (XApp (XConstructor "Cell" Nil) (XVarTerm value))))) (XCase (XApp (XVarTerm function) (XIntTerm 42)) ioUnit (Cons (XAlternative (XConstructorPattern "Cell" (Cons (Just field) Nil)) (sequenceWith ioUnit (XVarTerm field) (XApp (XPrimitive PPrintInt Nil) (XVarTerm field)))) Nil)))))))))))
