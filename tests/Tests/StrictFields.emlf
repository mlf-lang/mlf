module Tests.StrictFields where
import Bootstrap.Types
import qualified Bootstrap.Std as S
import qualified Package.OS as OS
import qualified Tests.Helpers as H
import Tests.Helpers (Quint(..), Sext(..))
import qualified Tests.Map as M
import Tests.Backends
import qualified Tests.Backends as B
import Bootstrap.Compiler (compile, compiledTerm)
import qualified Bootstrap.Data as D
import qualified Bootstrap.LLVM.Codegen as G
import qualified Bootstrap.Primitive as P
import qualified Bootstrap.X.Check as Check
import qualified Bootstrap.X.Syntax as X
import qualified Bootstrap.X.Type as T

observe : B.Backends -> XTerm -> String -> IO ()
observe backends term expected = do { result <- (B.execute backends IOEntry (Input "" false) term); do { (S.either (S.compose H.fail H.show) return (B.outcome result)); (S.unless (H.eq (B.output result) expected) (H.fail (H.show result))) } }

strictFieldTests : B.Backends -> ([] ( ((,) (String) (IO ())) ))
strictFieldTests backends = (let { source = (S.unlines ((:) "data StrictTriple = StrictTriple Int Int Int" ((:) "data LazyTriple = LazyTriple Int Int Int" ((:) "data PartialTriple = PartialTriple Int Int Int" ((:) "data Chain = Chain Int Chain Int" ((:) "data Captured = Captured Int Int Int" ((:) "data Mixed = Mixed Int Int Int" ((:) "" ((:) "strictTriple : Int -> Int -> Int -> Int -> StrictTriple" ((:) "strictTriple count x y z = if count == 0 then seq x (seq y (seq z (StrictTriple x y z))) else strictTriple (count - 1) x y z" ((:) "lazyTriple : Int -> Int -> LazyTriple" ((:) "lazyTriple count x = if count == 0 then LazyTriple x (quotInt 1 0) 9 else lazyTriple (count - 1) x" ((:) "partialTriple : Int -> Int -> Int -> PartialTriple" ((:) "partialTriple count = if count == 0 then PartialTriple 4 else partialTriple (count - 1)" ((:) "chain : Chain" ((:) "chain = Chain 5 chain 7" ((:) "capture x = seq x (\\ignored -> Captured x 8 10)" ((:) "strictMixed : Int -> Int -> Mixed" ((:) "strictMixed count x = if count == 0 then seq x (Mixed x 1 2) else strictMixed (count - 1) x" ((:) "lazyMixed : Int -> Int -> Mixed" ((:) "lazyMixed count x = if count == 0 then Mixed x (quotInt 1 0) 12 else lazyMixed (count - 1) x" ((:) "" ((:) "main = do" ((:) "  case strictTriple 3 1 2 3 of" ((:) "    StrictTriple x y z -> seq x (seq y (seq z (printInt (x + y + z))))" ((:) "  case lazyTriple 3 2 of" ((:) "    LazyTriple x poison z -> seq x (seq z (printInt (x + z)))" ((:) "  case partialTriple 3 (quotInt 1 0) 3 of" ((:) "    PartialTriple x poison z -> seq x (seq z (printInt (x + z)))" ((:) "  case chain of" ((:) "    Chain x rest z -> case rest of" ((:) "      Chain y next w -> seq x (seq y (seq z (seq w (printInt (x + y + z + w)))))" ((:) "  case capture 6 0 of" ((:) "    Captured x y z -> seq x (seq y (seq z (printInt (x + y + z))))" ((:) "  case strictMixed 3 7 of" ((:) "    Mixed x y z -> seq x (seq y (seq z (printInt (x + y + z))))" ((:) "  case lazyMixed 3 8 of" ((:) "    Mixed x poison z -> seq x (seq z (printInt (x + z)))" [])))))))))))))))))))))))))))))))))))))) } in ((:) ((,) "strict constructor fields: checked lowering uses the pointer proof" do { _ <- (S.either H.fail return (Check.checkClosed lowered)); do { ((,) entry code) <- (S.either H.fail return (G.generate (M.fromList ((:) ((,) "()" ((,) 1 0)) ((:) ((,) "Cell" ((,) 69 1)) []))) (X.erase lowered))); do { (case (S.filter (\section1 -> (OS.starts (H.append "define private ptr " (H.append entry "(")) section1)) code) of { ((:) body []) -> (S.unless (S.not (H.contains "call ptr @mlf.force(" body)) (H.fail "proven constructor field was forced")); _ -> (H.fail "missing strict-field lowering entry") }); (observe backends lowered "42\n") } } }) ((:) ((,) "strict constructor fields: lazy, partial, mixed and recursive values" do { term <- (H.fmap compiledTerm (S.either (S.compose H.fail H.show) return (compile "<strict fields>" source))); (observe backends term "6\n11\n7\n24\n24\n10\n20\n") }) [])))

lowered : XTerm
lowered = (let { function = (XName 0 "constructor") } in (let { value = (XName 1 "value") } in (let { field = (XName 2 "field") } in (let { int = (XCon "Int" []) } in (let { cell = (XCon "Cell" []) } in (let { ioUnit = (XCon "IO" ((:) (XCon "()" []) [])) } in (let { sequenceWith result a b = (XApp (XApp (XPrimitive PSeq ((:) int ((:) result []))) a) b) } in ((XWithData ((:) (DataDecl "Cell" [] ((:) (ConstructorDecl "Cell" ((:) (Applied "Int" []) [])) [])) [])) ((XLet function (XAbs value int (sequenceWith cell (XVarTerm value) (XApp (XConstructor "Cell" []) (XVarTerm value))))) (XCase (XApp (XVarTerm function) (XIntTerm 42)) ioUnit ((:) (XAlternative (XConstructorPattern "Cell" ((:) (Just field) [])) (sequenceWith ioUnit (XVarTerm field) (XApp (XPrimitive PPrintInt []) (XVarTerm field)))) [])))))))))))
