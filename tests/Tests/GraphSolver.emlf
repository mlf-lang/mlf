module Tests.GraphSolver where
import Bootstrap.Types
import qualified Bootstrap.Std as S
import qualified Package.OS as OS
import qualified Tests.Helpers as H
import Tests.Helpers (Quint(..), Sext(..))
import Tests.Graph (get, put, lift)
import qualified Bootstrap.IntMap as IM
import qualified Bootstrap.IntSet as IS
import Bootstrap.Classes (lowerClassesWithImports)
import Bootstrap.Constraint
import Bootstrap.Elaborate (reference, schemeType)
import qualified Tests.Graph as G
import qualified Bootstrap.Graph.Solver as Solver
import Bootstrap.Parser (parseProgram)
import Bootstrap.Prelude (withPrelude)
import qualified Bootstrap.X.Type as T

graphSolverTests : (List ( (Pair (String) (IO Unit)) ))
graphSolverTests = (Cons (Pair "component solver matches every full-graph inference step" do { counts <- ((S.forM fixtures) (\file -> do { c <- (constraints file); do { solver <- (H.right (Solver.prepare (initialGraph c))); do { first <- (H.right (Solver.unify (equalities c) solver)); do { (Pair _ expected) <- (H.right (G.runBuild (initialGraph c) (G.unify (equalities c)))); do { (sameGraph expected first); do { _ <- (S.foldM (\(Pair g s) edge -> do { (Pair _ g') <- (H.right (G.runBuild g (expandAndSolve false edge))); do { s' <- (H.right (Solver.instantiate (fromGen edge) (toNode edge) s)); do { (sameGraph g' s'); (return (Pair g' s')) } } }) (Pair expected first) (instances c)); (return ((H.length (instances c)) + 1)) } } } } } })); (putStrLn (H.append "Component inference: " (H.append (H.show (S.sum counts)) " complete graph/index comparisons"))) }) (Cons (Pair "component witnesses preserve separate frontier solving and identities" do { counts <- ((S.forM fixtures) (\file -> do { c <- (constraints file); do { g <- (H.right (solve c)); do { solver <- (H.right (Solver.prepare g)); (let { nonreflexive edge = (S.not (T.alphaEq (schemeType g (fromGen edge)) (reference g (toNode edge)))) } in (let { edges = (S.filter nonreflexive (instances c)) } in do { ((H.forM_ edges) (\edge -> do { (Pair expectedCopies expected) <- (H.right (G.runBuild g (expandAndSolve true edge))); do { (Pair copies result) <- (H.right (Solver.witness (fromGen edge) (toNode edge) solver)); do { (S.unless (H.eq copies expectedCopies) (H.fail "witness lost original-to-copy identity")); (sameGraph expected result) } } })); (return (H.length edges)) })) } } })); do { (S.unless ((S.sum counts) > 100) (H.fail "vacuous witness comparison")); (putStrLn (H.append "Component witnesses: " (H.append (H.show (S.sum counts)) " full-graph comparisons"))) } }) (Cons (Pair "component solver includes incoming references and protected siblings" do { initial <- (H.right (Solver.prepare scopedGraph)); do { first <- (H.right (Solver.unify (Cons (Pair 4 8) Nil) initial)); do { (Pair _ expected) <- (H.right (G.runBuild scopedGraph (G.unify (Cons (Pair 4 8) Nil)))); do { (sameGraph expected first); do { (H.reject (Solver.unify (Cons (Pair 8 9) Nil) first)); (H.reject (Solver.unify (Cons (Pair 5 9) Nil) first)) } } } } }) (Cons (Pair "component solver rejects malformed disconnected input" (let { broken = (Graph (IM.adjust (\v -> (Node (GGen 99) (G.binder v) (G.flag v))) 0 (G.nodes scopedGraph)) (G.links scopedGraph) (G.nextId scopedGraph)) } in do { (H.reject (Solver.prepare broken)); do { initial <- (H.right (Solver.prepare scopedGraph)); do { (H.reject (Solver.unify (Cons (Pair 4 99) Nil) initial)); (H.reject (Solver.unify (Cons (Pair 99 99) Nil) initial)) } } })) (Cons (Pair "component solver preserves deep branching scopes and separate type components" (let { parent n = (if (H.eq n 0) then Nothing else (if (H.eq n 401) then (Just 0) else (if (H.eq n 301) then (Just 20) else (if true then (Just (n - 1)) else (panic "non-exhaustive test guard"))))) } in (let { g = (Graph (IM.fromList (H.concat (S.concatMap (\n -> (Cons (Cons (Pair (2 * n) (Node (GGen ((2 * n) + 1)) (H.fmap (\section2 -> (section2 * 2)) (parent n)) Flexible)) (Cons (Pair ((2 * n) + 1) (Node GBot (Just (2 * n)) Flexible)) Nil)) Nil)) (S.range 0 500)))) IM.empty 1002) } in (let { points = (Cons 0 (Cons 1 (Cons 20 (Cons 31 (Cons 127 (Cons 255 (Cons 300 (Cons 301 (Cons 400 (Cons 401 (Cons 500 Nil))))))))))) } in do { initial <- (H.right (Solver.prepare g)); ((H.forM_ (S.concatMap (\a -> (S.concatMap (\b -> (if (a < b) then (Cons (Pair a b) Nil) else Nil)) points)) points)) (\(Pair a b) -> (let { equations = (Cons (Pair ((2 * a) + 1) ((2 * b) + 1)) Nil) } in (case G.runBuild g (G.unify equations) of {
 Left err -> case Solver.unify equations initial of { Left _ -> return Unit; Right _ -> H.fail ("component accepted a rejected scope merge: " ++ err) };
 Right (Pair _ expected) -> case Solver.unify equations initial of { Right actual -> sameGraph expected actual; Left err -> H.fail ("component rejected a valid scope merge: " ++ err) }
})))) })))) (Cons (Pair "expansion preserves the exact fresh identity budget across word boundaries" (let { expandFrom next = (G.runBuild (Graph (G.nodes scopedGraph) (G.links scopedGraph) next) (G.expand 2 0)) } in do { do { Pair (Triple _ boundaryCopies _) boundary <- H.right (expandFrom (9223372036854775807 - 2)); H.assert (IM.size boundaryCopies == 3 && G.nextId boundary == 9223372036854775808 && S.eqList eqInt (IM.elems boundaryCopies) (Cons 9223372036854775805 (Cons 9223372036854775806 (Cons 9223372036854775807 Nil)))) "arbitrary-precision expansion crossed the word boundary incorrectly"; H.right (G.validateGraph boundary) }; do { (Pair (Triple _ copies _) expanded) <- (H.right (expandFrom (9223372036854775807 - 3))); do { (S.unless ((H.eq (IM.size copies) 3) && (H.eq (G.nextId expanded) 9223372036854775807)) (H.fail "expansion did not use exactly its three reserved identities")); (H.right (G.validateGraph expanded)) } } })) (Cons (Pair "closed-instance optimization preserves all original schemes" do { counts <- ((S.forM (H.append fixtures (S.concatMap (\name -> (Cons (H.append "benchmarks/" (H.append name "/mlf/main.emlf")) Nil)) (Cons "binary-trees" (Cons "pidigits" (Cons "n-body" (Cons "fannkuch-redux" Nil))))))) (\file -> do { c <- (constraints file); do { initial <- (H.right (bind (Solver.prepare (initialGraph c)) (Solver.unify (equalities c)))); do { exact <- (H.right (bind (S.foldM (\s e -> (Solver.instantiate (fromGen e) (toNode e) s)) initial (instances c)) Solver.finish)); do { optimized <- (H.right (solve c)); (let { expected = (G.normalize exact) } in (let { gens = (S.concatMap (\(Pair n v) -> (S.concatMap (\comprehension1 -> case comprehension1 of { (GGen _) -> (Cons n Nil); _ -> Nil }) (Cons (G.tag v) Nil))) (IM.toAscList (G.nodes (initialGraph c)))) } in do { ((H.forM_ gens) (\gen -> (S.unless (T.alphaEq (schemeType expected gen) (schemeType optimized gen)) (H.fail (H.append file (H.append ": changed scheme at " (H.append (H.show gen) (H.append "\n" (H.append (H.show (schemeType expected gen)) (H.append "\n" (H.show (schemeType optimized gen)))))))))))); (return (H.length gens)) })) } } } })); (putStrLn (H.append "Closed instances: " (H.append (H.show (S.sum counts)) " independent scheme comparisons"))) }) (Cons (Pair "closed-instance matching checks repeated, rigid and frontier variables" (let { graph fieldFlag fieldBinder rightName = (Graph (IM.fromList (Cons (Pair 0 (Node (GGen 1) Nothing Flexible)) (Cons (Pair 1 (Node (GCon "Unit" Nil) (Just 0) Rigid)) (Cons (Pair 2 (Node (GGen 3) (Just 0) Flexible)) (Cons (Pair 3 (Node (GArr 4 4) (Just 2) Flexible)) (Cons (Pair 4 (Node GBot (Just fieldBinder) fieldFlag)) (Cons (Pair 5 (Node (GGen 6) (Just 0) Flexible)) (Cons (Pair 6 (Node (GArr 7 8) (Just 5) Flexible)) (Cons (Pair 7 (Node (GCon "Int" Nil) (Just 6) Rigid)) (Cons (Pair 8 (Node (GCon rightName Nil) (Just 6) Rigid)) Nil)))))))))) IM.empty 9) } in (let { run g = (bind (bind (Solver.prepare g) (Solver.instantiateClosed 2 6)) Solver.finish) } in do { (H.reject (run (graph Flexible 2 "Bool"))); do { (H.reject (run (graph Rigid 2 "Int"))); do { result <- (H.right (run (graph Flexible 0 "Int"))); do { (S.unless (H.eq (G.tag (G.nodeAt result 4)) (GCon "Int" Nil)) (H.fail "external frontier was mistaken for a quantified variable")); do { _ <- (H.right (run (graph Flexible 2 "Int"))); (return Unit) } } } } }))) Nil))))))))

fixtures : (List ( String ))
fixtures = (Cons "examples/snake.emlf" (Cons "examples/monad-state-do.emlf" (Cons "examples/monad-maybe.emlf" (Cons "examples/contextual-instance.emlf" (Cons "examples/partial-annotation.emlf" Nil)))))

constraints : String -> IO Constraints
constraints file = do { source <- (readFile file); do { parsed <- (H.right (parseProgram file source)); (case (withPrelude ImplicitPrelude parsed) of { (Pair imports program) -> do { (Pair lowered _) <- (H.right (lowerClassesWithImports imports program)); (H.right (generateProgram lowered)) } }) } }

expandAndSolve : Bool -> Edge -> G.Build ( IntMap Int )
expandAndSolve separately edge = do { g <- get; (let { target = (G.resolve g (toNode edge)) } in do { destination <- (S.maybe (lift (Left "missing target binder")) return (G.binder (G.nodeAt g target))); do { (Triple root copies frontier) <- (referenceExpand (fromGen edge) destination); do { (if separately then do { (S.unless (H.null frontier) (G.unify frontier)); (G.unify (Cons (Pair root target) Nil)) } else (G.unify (H.append frontier (Cons (Pair root target) Nil)))); (return copies) } } }) }

referenceExpand : Int -> Int -> G.Build (Triple (Int) (IntMap Int) ((List ( (Pair (Int) (Int)) ))))
referenceExpand gen destination = do { g <- get; (let { source = (G.genRoot g gen) } in (let rec { visit : IntSet -> Int -> IntSet; visit seen x = (let { n = (G.resolve g x) } in (if (IS.member n seen) then seen else (if (S.not (G.underBinder g n gen)) then (IS.insert n seen) else (if true then (S.foldl visit (IS.insert n seen) (G.children (G.tag (G.nodeAt g n)))) else (panic "non-exhaustive test guard"))))) } in (let { originals = (IS.toList (visit IS.empty source)) } in do { copies <- (H.fmap IM.fromList (S.mapM (\n -> do { c <- G.freshId; (return (Pair n c)) }) originals)); (let { copy n = (IM.findWithDefault (G.resolve g n) (G.resolve g n) copies) } in (let { root = (copy source) } in (let { frontier = (S.concatMap (\n -> (if (S.not (G.underBinder g n gen)) then (Cons n Nil) else Nil)) originals) } in (let { copyTag t = (case t of { (GArr a b) -> (GArr (copy a) (copy b)); (GCon c ns) -> (GCon c (S.map copy ns)); (GGen n) -> (GGen (copy n)); (GTyApp a b) -> (GTyApp (copy a) (copy b)); _ -> t }) } in do { ((H.forM_ originals) (\n -> do { k <- (lift (G.kindAt g n)); (let { v = (G.nodeAt g n) } in (let { new = (if (H.elem n frontier) then (Node (G.bottomTag k) (Just destination) Flexible) else (if (H.eq n source) then (Node (copyTag (G.tag v)) (Just destination) Flexible) else (if true then (Node (copyTag (G.tag v)) (H.fmap (\b -> (if (H.eq (G.resolve g b) (G.resolve g gen)) then root else (copy b))) (G.binder v)) (G.flag v)) else (panic "non-exhaustive test guard")))) } in (G.setNode (copy n) new))) })); (return (Triple root copies (S.concatMap (\n -> (Cons (Pair n (copy n)) Nil)) frontier))) })))) }))) }

sameGraph : Graph -> Solver -> IO Unit
sameGraph expected solver = do { actual <- (H.right (Solver.finish solver)); (S.unless (H.eq actual expected) (H.fail (H.append "component graph differs\nexpected: " (H.append (H.show expected) (H.append "\nactual: " (H.show actual)))))) }

scopedGraph : Graph
scopedGraph = (Graph (IM.fromList (Cons (Pair 0 (Node (GGen 1) Nothing Flexible)) (Cons (Pair 1 (Node (GCon "Unit" Nil) (Just 0) Rigid)) (Cons (Pair 2 (Node (GGen 3) (Just 0) Flexible)) (Cons (Pair 3 (Node (GArr 4 5) (Just 2) Rigid)) (Cons (Pair 4 (Node GBot (Just 3) Rigid)) (Cons (Pair 5 (Node GBot (Just 3) Flexible)) (Cons (Pair 6 (Node (GGen 7) (Just 0) Flexible)) (Cons (Pair 7 (Node (GArr 8 9) (Just 6) Flexible)) (Cons (Pair 8 (Node GBot (Just 7) Flexible)) (Cons (Pair 9 (Node (GCon "Int" Nil) (Just 7) Rigid)) Nil))))))))))) IM.empty 10)
