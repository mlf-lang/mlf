graphSolverTests : ([] ( ((,) (String) (IO ())) ))
graphSolverTests = ((:) ((,) "component solver matches every full-graph inference step" do { validatedKindControls; fieldProjectionControls; counts <- ((S.forM fixtures) (\file -> do { c <- (constraints file); do { solver <- (H.right (Solver.prepare (initialGraph c))); do { first <- (H.right (Solver.unify (equalities c) solver)); do { ((,) _ expected) <- (H.right (G.runBuild (initialGraph c) (G.unify (equalities c)))); do { (sameGraph expected first); do { _ <- (S.foldM compareSolveStep ((,) expected first) (solveSteps c)); (return ((H.length (solveSteps c)) + 1)) } } } } } })); (putStrLn (H.append "Component inference: " (H.append (H.show (S.sum counts)) " complete graph/index comparisons"))) }) ((:) ((,) "component witnesses preserve separate frontier solving and identities" do { counts <- ((S.forM fixtures) (\file -> do { c <- (constraints file); do { g <- (H.right (solve c)); do { solver <- (H.right (Solver.prepare g)); (let { nonreflexive edge = (S.not (T.alphaEq (schemeType g (fromGen edge)) (reference g (toNode edge)))) } in (let { edges = (S.filter nonreflexive (instances c)) } in do { ((H.forM_ edges) (\edge -> do { ((,) expectedCopies expected) <- (H.right (G.runBuild g (expandAndSolve true edge))); do { ((,) copies result) <- (H.right (Solver.witness (fromGen edge) (toNode edge) solver)); do { (S.unless (H.eq copies expectedCopies) (H.fail "witness lost original-to-copy identity")); (sameGraph expected result) } } })); (return (H.length edges)) })) } } })); do { (S.unless ((S.sum counts) > 100) (H.fail "vacuous witness comparison")); (putStrLn (H.append "Component witnesses: " (H.append (H.show (S.sum counts)) " full-graph comparisons"))) } }) ((:) ((,) "component solver includes incoming references and protected siblings" do { aliasReceipts; initial <- (H.right (Solver.prepare scopedGraph)); do { first <- (H.right (Solver.unify ((:) ((,) 4 8) []) initial)); do { ((,) _ expected) <- (H.right (G.runBuild scopedGraph (G.unify ((:) ((,) 4 8) [])))); do { (sameGraph expected first); do { (H.reject (Solver.unify ((:) ((,) 8 9) []) first)); (H.reject (Solver.unify ((:) ((,) 5 9) []) first)) } } } } }) ((:) ((,) "component solver rejects malformed disconnected input" (let { broken = (Graph (IM.adjust (\v -> (Node (GGen 99) (G.binder v) (G.flag v))) 0 (G.nodes scopedGraph)) (G.links scopedGraph) (G.nextId scopedGraph)) } in do { indexAudit; (H.reject (Solver.prepare broken)); do { initial <- (H.right (Solver.prepare scopedGraph)); do { (H.reject (Solver.unify ((:) ((,) 4 99) []) initial)); (H.reject (Solver.unify ((:) ((,) 99 99) []) initial)) } } })) ((:) ((,) "component solver preserves deep branching scopes and separate type components" branchingScopes) ((:) ((,) "expansion preserves the exact fresh identity budget across word boundaries" (let { expandFrom next = (G.runBuild (Graph (G.nodes scopedGraph) (G.links scopedGraph) next) (G.expand 2 0)) } in do { copyAllocation; do { (,) ((,,) _ boundaryCopies _) boundary <- H.right (expandFrom (9223372036854775807 - 4)); H.assert (IM.size boundaryCopies == 3 && G.nextId boundary == 9223372036854775806 && S.eqList eqInt (IM.elems boundaryCopies) ((:) 9223372036854775803 ((:) 9223372036854775804 ((:) 9223372036854775805 [])))) "Int64 expansion changed the reserved identity interval"; H.right (G.validateGraph boundary) }; do { ((,) ((,,) _ copies _) expanded) <- (H.right (expandFrom (9223372036854775807 - 3))); do { (S.unless ((H.eq (IM.size copies) 3) && (H.eq (G.nextId expanded) 9223372036854775807)) (H.fail "expansion did not use exactly its three reserved identities")); (H.right (G.validateGraph expanded)) } } })) ((:) ((,) "closed-instance optimization preserves all original schemes" schemeComparisonTest) ((:) ((,) "closed-instance matching checks repeated, rigid and frontier variables" (let { graph fieldFlag fieldBinder rightName = (Graph (IM.fromList ((:) ((,) 0 (Node (GGen 1) Nothing Flexible)) ((:) ((,) 1 (Node (GCon "Unit" []) (Just 0) Rigid)) ((:) ((,) 2 (Node (GGen 3) (Just 0) Flexible)) ((:) ((,) 3 (Node (GArr 4 4) (Just 2) Flexible)) ((:) ((,) 4 (Node GBot (Just fieldBinder) fieldFlag)) ((:) ((,) 5 (Node (GGen 6) (Just 0) Flexible)) ((:) ((,) 6 (Node (GArr 7 8) (Just 5) Flexible)) ((:) ((,) 7 (Node (GCon "Int" []) (Just 6) Rigid)) ((:) ((,) 8 (Node (GCon rightName []) (Just 6) Rigid)) [])))))))))) IM.empty 9) } in (let { run g = (bind (bind (Solver.prepare g) (Solver.instantiateClosed 2 6)) Solver.finish) } in do { (H.reject (run (graph Flexible 2 "Bool"))); do { (H.reject (run (graph Rigid 2 "Int"))); do { result <- (H.right (run (graph Flexible 0 "Int"))); do { (S.unless (H.eq (G.tag (G.nodeAt result 4)) (GCon "Int" [])) (H.fail "external frontier was mistaken for a quantified variable")); do { _ <- (H.right (run (graph Flexible 2 "Int"))); (return ()) } } } } }))) []))))))))

-- Exhaust the branching relations on a small graph. The original 1002-node
-- graph separately retains long-ancestry and branch-junction regressions.
branchGraph count first second anchor =
 let parent n = if n == 0 then Nothing else if n == first then Just anchor else if n == second then Just 0 else Just (n - 1) in
 Graph (IM.fromList (S.concatMap (\n -> (:) ((,) (2*n) (Node (GGen (2*n+1)) (S.mapOptional (\p -> 2*p) (parent n)) Flexible)) ((:) ((,) (2*n+1) (Node GBot (Just (2*n)) Flexible)) [])) (S.range 0 count))) IM.empty (2*count+2)
checkBranches graph pairs = do
 initial <- H.right (Solver.prepare graph)
 S.mapM_ (\((,) a b) -> do
  let equations = (:) ((,) (2*a+1) (2*b+1)) []
  case G.runBuild graph (G.unify equations) of
   Left message -> H.reject (Solver.unify equations initial)
   Right ((,) _ expected) -> do { actual <- H.right (Solver.unify equations initial); sameGraph expected actual }) pairs
branchingScopes : IO ()
branchingScopes = do
 let points = S.range 0 8
 checkBranches (branchGraph 8 4 6 1) (S.concatMap (\a -> S.map ((,) a) (S.filter (\b -> a < b) points)) points)
 checkBranches (branchGraph 500 301 401 20) ((:) ((,) 0 500) ((:) ((,) 1 300) ((:) ((,) 20 301) ((:) ((,) 300 301) ((:) ((,) 300 400) ((:) ((,) 400 401) ((:) ((,) 401 500) ((:) ((,) 31 127) ((:) ((,) 127 255) ((:) ((,) 255 300) []))))))))))

fixtures : ([] ( String ))
fixtures = ((:) "examples/snake.emlf" ((:) "examples/monad-state-do.emlf" ((:) "examples/monad-maybe.emlf" ((:) "examples/contextual-instance.emlf" ((:) "examples/partial-annotation.emlf" [])))))

constraints : String -> IO Constraints
constraints file = do { source <- readFile file; H.right (sourceConstraints file source) }

expandAndSolve : Bool -> Edge -> G.Build ( IntMap Int )
expandAndSolve separately edge = do { g <- get; (let { target = (G.resolve g (toNode edge)) } in do { destination <- (S.maybe (lift (Left "missing target binder")) return (G.binder (G.nodeAt g target))); do { ((,,) root copies frontier) <- (referenceExpand (fromGen edge) destination); do { (if separately then do { (S.unless (H.null frontier) (G.unify frontier)); (G.unify ((:) ((,) root target) [])) } else (G.unify (H.append frontier ((:) ((,) root target) [])))); (return copies) } } }) }

-- Instantiate retains the independent full-graph expansion oracle. Projection
-- uses the production operation only for this new action; rebuilding its indexes
-- checks coherence, not the semantic choice of nodes. Authored graphs below
-- independently prescribe that choice, copied identities, flags and frontier.
compareSolveStep : ((,) Graph Solver) -> SolveStep -> IO ((,) Graph Solver)
compareSolveStep ((,) g solver) action = case action of
 Instantiate edge -> do
  ((,) _ expected) <- H.right (G.runBuild g (expandAndSolve false edge))
  actual <- H.right (Solver.instantiate (fromGen edge) (toNode edge) solver)
  sameGraph expected actual
  return ((,) expected actual)
 ProjectCase fields -> do
  prepared <- H.right (Solver.prepare g)
  projected <- H.right (Solver.projectCaseFields fields prepared)
  expected <- H.right (Solver.finish projected)
  actual <- H.right (Solver.projectCaseFields fields solver)
  sameGraph expected actual
  assertRebuiltIndices actual
  return ((,) expected actual)

exactSolveStep : Solver -> SolveStep -> Either String Solver
exactSolveStep solver action = case action of
 Instantiate edge -> Solver.instantiate (fromGen edge) (toNode edge) solver
 ProjectCase fields -> Solver.projectCaseFields fields solver

assertRebuiltIndices : Solver -> IO ()
assertRebuiltIndices solver = do
 rebuilt <- H.right (Solver.prepare (Solver.solverGraph solver))
 H.assert (H.eq (Solver.structuralParents solver) (Solver.structuralParents rebuilt)) "projection structural index differs from reconstruction"
 H.assert (H.eq (Solver.bindingChildren solver) (Solver.bindingChildren rebuilt)) "projection binding index differs from reconstruction"
 H.assert (Solver.equalScopes (Solver.scopeIndex solver) (Solver.scopeIndex rebuilt)) "projection scope index differs from reconstruction"

-- A rigid forall a. a -> captured has a real local prefix. The source and
-- external skolem stay untouched; only 2 and 3 are copied to the reserved IDs.
fieldProjectionGraph : Graph
fieldProjectionGraph = Graph (IM.fromList
 ((:) ((,) 0 (Node (GGen 1) Nothing Flexible))
 ((:) ((,) 1 (Node (GCon "Unit" []) (Just 0) Rigid))
 ((:) ((,) 2 (Node (GArr 3 5) (Just 0) Rigid))
 ((:) ((,) 3 (Node GBot (Just 2) Flexible))
 ((:) ((,) 4 (Node (GGen 2) (Just 0) Flexible))
 ((:) ((,) 5 (Node (GSkolem 99 Star) (Just 0) Rigid)) []))))))) IM.empty 6

fieldProjectionExpected : Graph
fieldProjectionExpected = Graph
 (IM.insert 4 (Node (GGen 6) (Just 0) Flexible)
  (IM.insert 6 (Node (GArr 7 5) (Just 4) Flexible)
   (IM.insert 7 (Node GBot (Just 6) Flexible) (G.nodes fieldProjectionGraph)))) IM.empty 8

checkUnknownField : Graph -> IO ()
checkUnknownField graph = do
 initial <- H.right (Solver.prepare graph)
 known <- H.right (NativeGraph.knownFieldInterface graph 2)
 H.assert (S.not known) "unknown field was classified as an exact interface"
 projected <- H.right (Solver.projectCaseFields ((:) ((,) 2 4) []) initial)
 sameGraph graph projected
 assertRebuiltIndices projected
 H.assert (H.eq (Solver.structuralParents initial) (Solver.structuralParents projected) && H.eq (Solver.bindingChildren initial) (Solver.bindingChildren projected) && Solver.equalScopes (Solver.scopeIndex initial) (Solver.scopeIndex projected)) "unknown projection changed indexes"
 H.reject (NativeGraph.materializeField 2 4 graph)

fieldProjectionControls : IO ()
fieldProjectionControls = do
 let graph = fieldProjectionGraph
 let fields = (:) ((,) 2 4) []
 let receipt = IM.fromList ((:) ((,) 2 6) ((:) ((,) 3 7) []))
 initial <- H.right (Solver.prepare graph)
 known <- H.right (NativeGraph.knownFieldInterface graph 2)
 H.assert known "rigid quantified parameter was not an exact interface"
 ((,) copies materialized) <- H.right (NativeGraph.materializeField 2 4 graph)
 H.assert (H.eq copies receipt && H.eq materialized fieldProjectionExpected) "field materialization changed the prescribed identities, frontier, binders or flags"
 ((,) indexedCopies indexed) <- H.right (Solver.projectField 2 4 initial)
 H.assert (H.eq indexedCopies receipt) "indexed projection changed its copy receipt"
 sameGraph fieldProjectionExpected indexed
 assertRebuiltIndices indexed
 projected <- H.right (Solver.projectCaseFields fields initial)
 sameGraph fieldProjectionExpected projected
 assertRebuiltIndices projected
 dispatched <- H.right (evaluateStep initial (ProjectCase fields))
 sameGraph fieldProjectionExpected dispatched
 -- Same graph shape with a flexible lower bound is not an exact interface.
 checkUnknownField (NativeGraph.setNode 2 (Node (GArr 3 5) (Just 0) Flexible) graph)
 -- Abstract and inert parameters do not acquire a fresh instantiable prefix.
 let replaceRoot node = Graph (IM.insert 2 node (IM.delete 3 (G.nodes graph))) IM.empty 6
 checkUnknownField (replaceRoot (Node (GSkolem 100 Star) (Just 0) Rigid))
 checkUnknownField (NativeGraph.setNode 3 (Node (GCon "Int" []) (Just 2) Flexible) graph)
 -- A universal strictly inside a rigid arrow argument is not a root prefix.
 let nested = Graph (IM.insert 3 (Node (GArr 6 6) (Just 2) Rigid) (IM.insert 6 (Node GBot (Just 3) Flexible) (G.nodes graph))) IM.empty 7
 checkUnknownField nested
 -- A rigid bottom is itself an exact interface, without invented children.
 let bottom = replaceRoot (Node GBot (Just 0) Rigid)
 let bottomExpected = Graph (IM.insert 4 (Node (GGen 6) (Just 0) Flexible) (IM.insert 6 (Node GBot (Just 4) Flexible) (G.nodes bottom))) IM.empty 7
 ((,) bottomCopies bottomActual) <- H.right (NativeGraph.materializeField 2 4 bottom)
 H.assert (H.eq bottomCopies (IM.singleton 2 6) && H.eq bottomActual bottomExpected) "bottom interface projection copied an invented prefix"
 -- Destination validation rejects missing, non-Gen and already-filled proxies.
 H.reject (NativeGraph.materializeField 2 999 graph)
 H.reject (NativeGraph.materializeField 2 3 graph)
 H.reject (NativeGraph.materializeField 2 4 materialized)
 H.reject (Solver.projectField 2 999 initial)
 H.reject (Solver.projectField 2 3 initial)
 -- The public graph boundary rejects malformed ancestry and fresh aliases.
 let cyclic = NativeGraph.setNode 2 (Node (GArr 3 5) (Just 3) Rigid) graph
 H.reject (NativeGraph.materializeField 2 4 cyclic)
 let highAlias = Graph (G.nodes graph) (IM.singleton 6 5) 6
 H.reject (NativeGraph.materializeField 2 4 highAlias)
 -- A skolem may stay on the external frontier, but cannot be captured/copied.
 let captured = Graph (IM.insert 5 (Node (GSkolem 99 Star) (Just 2) Rigid) (G.nodes graph)) IM.empty 6
 capturedSolver <- H.right (Solver.prepare captured)
 H.reject (NativeGraph.materializeField 2 4 captured)
 H.reject (Solver.projectCaseFields fields capturedSolver)
 -- The receipt validator must reject a local copy whose binder is absent.
 H.right (NativeGraph.validateFieldCopy graph 2 receipt 3)
 H.reject (NativeGraph.validateFieldCopy graph 2 (IM.singleton 3 6) 3)
 let higher = replaceRoot (Node (GBotK (KArrow Star Star)) (Just 0) Rigid)
 higherSolver <- H.right (Solver.prepare higher)
 H.reject (NativeGraph.knownFieldInterface higher 2)
 H.reject (Solver.projectCaseFields fields higherSolver)
 -- A valid first copy followed by an invalid descriptor never commits a prefix.
 H.reject (Solver.projectCaseFields ((:) ((,) 2 4) ((:) ((,) 2 999) [])) initial)
 sameGraph graph initial
 assertRebuiltIndices initial
 retried <- H.right (Solver.projectCaseFields fields initial)
 sameGraph fieldProjectionExpected retried
 assertRebuiltIndices retried
 -- No-op barriers still leave malformed indexes observable to the final audit.
 let forged = Solver graph IM.empty (Solver.bindingChildren initial) (Solver.scopeIndex initial)
 H.reject (Solver.finish forged)
 noOp <- H.right (Solver.projectCaseFields [] forged)
 H.reject (Solver.finish noOp)
 putStrLn "Case projection: authored interfaces, exact copies, frontier identities, rejection and rebuilt indexes agree"

referenceExpand : Int -> Int -> G.Build ((,,) (Int) (IntMap Int) (([] ( ((,) (Int) (Int)) ))))
referenceExpand gen destination = do { g <- get; (let { source = (G.genRoot g gen) } in (let rec { visit : IntSet -> Int -> IntSet; visit seen x = (let { n = (G.resolve g x) } in (if (IS.member n seen) then seen else (if (S.not (G.underBinder g n gen)) then (IS.insert n seen) else (if true then (S.foldl visit (IS.insert n seen) (G.children (G.tag (G.nodeAt g n)))) else (panic "non-exhaustive test guard"))))) } in (let { originals = (IS.toList (visit IS.empty source)) } in do { copies <- (fmap IM.fromList (S.mapM (\n -> do { c <- G.freshId; (return ((,) n c)) }) originals)); (let { copy n = (IM.findWithDefault (G.resolve g n) (G.resolve g n) copies) } in (let { root = (copy source) } in (let { frontier = (S.concatMap (\n -> (if (S.not (G.underBinder g n gen)) then ((:) n []) else [])) originals) } in (let { copyTag t = (case t of { (GArr a b) -> (GArr (copy a) (copy b)); (GCon c ns) -> (GCon c (S.map copy ns)); (GGen n) -> (GGen (copy n)); (GTyApp a b) -> (GTyApp (copy a) (copy b)); _ -> t }) } in do { ((H.forM_ originals) (\n -> do { k <- (lift (G.kindAt g n)); (let { v = (G.nodeAt g n) } in (let { new = (if (H.elem n frontier) then (Node (G.bottomTag k) (Just destination) Flexible) else (if (H.eq n source) then (Node (copyTag (G.tag v)) (Just destination) Flexible) else (if true then (Node (copyTag (G.tag v)) (S.mapOptional (\b -> (if (H.eq (G.resolve g b) (G.resolve g gen)) then root else (copy b))) (G.binder v)) (G.flag v)) else (panic "non-exhaustive test guard")))) } in (G.setNode (copy n) new))) })); (return ((,,) root copies (S.concatMap (\n -> ((:) ((,) n (copy n)) [])) frontier))) })))) }))) }

sameGraph : Graph -> Solver -> IO ()
sameGraph expected solver = do { assertCanonical solver; actual <- (H.right (Solver.finish solver)); (S.unless (H.eq actual expected) (H.fail (H.append "component graph differs\nexpected: " (H.append (H.show expected) (H.append "\nactual: " (H.show actual)))))) }

scopedGraph : Graph
scopedGraph = (Graph (IM.fromList ((:) ((,) 0 (Node (GGen 1) Nothing Flexible)) ((:) ((,) 1 (Node (GCon "Unit" []) (Just 0) Rigid)) ((:) ((,) 2 (Node (GGen 3) (Just 0) Flexible)) ((:) ((,) 3 (Node (GArr 4 5) (Just 2) Rigid)) ((:) ((,) 4 (Node GBot (Just 3) Rigid)) ((:) ((,) 5 (Node GBot (Just 3) Flexible)) ((:) ((,) 6 (Node (GGen 7) (Just 0) Flexible)) ((:) ((,) 7 (Node (GArr 8 9) (Just 6) Flexible)) ((:) ((,) 8 (Node GBot (Just 7) Flexible)) ((:) ((,) 9 (Node (GCon "Int" []) (Just 7) Rigid)) []))))))))))) IM.empty 10)

-- Prepared solver states use canonical live fields even while their external
-- alias table grows. Projection and canonical projection rely on this construction
-- invariant; keep it visible in every full-graph differential comparison.
assertCanonical : Solver -> IO ()
assertCanonical solver =
 let graph = Solver.solverGraph solver in
 H.assert (S.all (\((,) n node) -> G.resolve graph n == n && S.all (\child -> G.resolve graph child == child && IM.member child (G.nodes graph)) (S.append (G.children (G.tag node)) (S.maybeToList (G.binder node)))) (IM.toList (G.nodes graph))) "solver live fields contain an alias or missing node"

aliasReceipts : IO ()
aliasReceipts = do
 let nodes = IM.insert 10 (Node GBot (Just 0) Flexible) (G.nodes scopedGraph)
 let aliases = IM.fromList ((:) ((,) 1000 0) ((:) ((,) 1001 10) []))
 let graph = Graph nodes aliases 1002
 prepared <- H.right (Solver.prepare graph)
 expected <- case Solver.groundGraft 1000 1001 prepared of {Nothing -> H.fail "nonvacuous ground view fixture did not graft"; Just value -> return value}
 actual <- H.right (Solver.instantiateClosed 1000 1001 prepared)
 sameGraph (Solver.solverGraph expected) actual
 H.assert (H.eq (G.links (Solver.solverGraph actual)) aliases) "solver discarded external aliases"
 let aliases2 = IM.insert 1002 2 aliases
 let second = Graph nodes aliases2 1003
 initial <- H.right (Solver.prepare second)
 -- The public expansion keeps alias-aware lookup. Compare it with the
 -- solver's projection boundary, including frontier IDs and its fresh budget.
 ((,) ((,,) expectedRoot expectedCopies expectedFrontier) expectedGraph) <- H.right (G.runBuild second (G.expand 1002 0))
 ((,,,) root copies frontier expanded) <- H.right (Solver.expanded 1002 1001 initial)
 H.assert (root == expectedRoot && H.eq copies expectedCopies && H.eq frontier expectedFrontier) "canonical expansion changed its identity receipt"
 sameGraph expectedGraph expanded


-- The retained reverse-edge scan is an independent control for the finite-set
-- cardinality audit. Compare the complete result, including graph diagnostics.
legacyFinish : Solver -> Either String Graph
legacyFinish solver = NativeGraph.bindE (NativeGraph.validateGraph (Solver.graph solver)) (\_ ->
 let current = Solver.graph solver in
 let parents = Solver.structuralParents solver in
 let descendants = Solver.bindingChildren solver in
 if Solver.indexAgrees current true parents && Solver.indexAgrees current false descendants &&
   S.all (Solver.nodeIndexed parents descendants) (IM.toList (NativeGraph.nodes current)) &&
   Solver.equalScopes (Solver.scopeIndex solver) (Solver.indexScopes current)
 then Right current else Left "incremental graph index disagrees with the graph")

indexMutations : IntMap IntSet -> [] (IntMap IntSet)
indexMutations table =
 let corruptTree = case table of
       IntMap IntMapNil -> []
       IntMap (IntMapTip key value) -> (:) (IntMap (IntMapBin 2 (key + 1) (IntMapTip key value) IntMapNil)) []
       IntMap (IntMapBin count prefix left right) -> (:) (IntMap (IntMapBin (count + 1) prefix left right))
         ((:) (IntMap (IntMapBin count prefix right left)) []) in
 S.append ((:) table ((:) IM.empty ((:) (IM.insert 999 (IS.singleton 0) table)
   ((:) (IM.map (IS.map (\n -> n + 1000)) table) corruptTree))))
   (S.concatMap (\((,) key values) -> (:) (IM.delete key table)
    ((:) (IM.insert key IS.empty table)
    ((:) (IM.insert key (IS.insert 999 values) table)
    ((:) (IM.insert key (IntSet (IntSetTip 9 0 1)) table)
    ((:) (IM.insert key (IntSet (IntSetBin 2 1 (IntSetTip 1 0 1) (IntSetTip 1 0 1))) table) []))))) (IM.toList table))

indexAudit : IO ()
indexAudit = do
 scopeAudit
 let repeated = Graph (IM.fromList ((:) ((,) 0 (Node (GGen 1) Nothing Flexible))
       ((:) ((,) 1 (Node (GArr 2 2) (Just 0) Flexible))
       ((:) ((,) 2 (Node GBot (Just 1) Flexible)) [])))) IM.empty 3
 S.mapM_ (\input -> do
  initial <- H.right (Solver.prepare input)
  let current = Solver.graph initial
  let parents = Solver.structuralParents initial
  let descendants = Solver.bindingChildren initial
  let scopes = Solver.scopeIndex initial
  S.mapM_ (\changed -> do
   let forged = Solver current changed descendants scopes
   H.assert (H.eq (legacyFinish forged) (Solver.finish forged)) "structural index audit changed a forged result") (indexMutations parents)
  S.mapM_ (\changed -> do
   let forged = Solver current parents changed scopes
   H.assert (H.eq (legacyFinish forged) (Solver.finish forged)) "binding index audit changed a forged result") (indexMutations descendants)
  -- Raw malformed node-map ordering uses the preceding full audit fallback.
  let malformed = case NativeGraph.nodes current of
       IntMap IntMapNil -> current
       IntMap (IntMapTip key value) -> current
       IntMap (IntMapBin count prefix left right) -> Graph (IntMap (IntMapBin count prefix right left)) (NativeGraph.links current) (NativeGraph.nextId current)
  let old = Solver.indexAgrees malformed true parents && Solver.indexAgrees malformed false descendants &&
       S.all (Solver.nodeIndexed parents descendants) (IM.toList (NativeGraph.nodes malformed))
  H.assert (H.eq old (Solver.indicesAgree malformed parents descendants)) "malformed node ordering changed index audit") ((:) scopedGraph ((:) repeated []))

-- Scope equality is checked against the retained reconstruction, including
-- hidden extra keys, forged cardinalities, wrong DFS intervals and jump levels.
legacyScopeRoot : ScopeIndex -> Int -> Int
legacyScopeRoot (ScopeIndex _ levels) n = case S.reverse levels of
 [] -> panic "empty scope ancestry index"
 (:) final _ -> IM.get n final

forgeCount : forall a. Int -> IntMap a -> IntMap a
forgeCount count table = case table of
 IntMap IntMapNil -> table
 IntMap (IntMapTip key value) -> IntMap (IntMapBin count (key + 1) (IntMapTip key value) IntMapNil)
 IntMap (IntMapBin _ prefix left right) -> IntMap (IntMapBin count prefix left right)
scopeMutations : ScopeIndex -> [] ScopeIndex
scopeMutations (ScopeIndex intervals levels) =
 let alter table = S.append ((:) IM.empty ((:) (IM.map (\n -> n + 1) table) ((:) (forgeCount (IM.size table) (IM.insert 99999 0 table)) []))) (S.concatMap (\((,) n value) -> (:) (IM.delete n table) ((:) (IM.insert n 99999 table) [])) (if IM.size table <= 16 then IM.toList table else S.append (S.take 3 (IM.toList table)) (S.drop (IM.size table - 3) (IM.toList table)))) in
 let rec replacePrefix : [] (IntMap Int) -> [] (IntMap Int) -> [] ScopeIndex = \prefix -> \pending -> case pending of
       [] -> []
       (:) level rest -> S.append (S.map (\changed -> ScopeIndex intervals (S.append (S.reverse prefix) ((:) changed rest))) (alter level)) (replacePrefix ((:) level prefix) rest) in
 S.append ((:) (ScopeIndex intervals []) ((:) (ScopeIndex intervals (S.reverse levels)) ((:) (ScopeIndex intervals (S.append levels levels)) ((:) (ScopeIndex IM.empty levels) ((:) (ScopeIndex (IM.map (\((,) start end) -> (,) (start + 1) end) intervals) levels) ((:) (ScopeIndex (forgeCount (IM.size intervals) (IM.insert 99999 ((,) 0 1) intervals)) levels) [])))))) (replacePrefix [] levels)

auditOneScope : Bool -> Graph -> IO ()
auditOneScope exhaustive graph = do
 solver <- H.right (Solver.prepare graph)
 let expected = Solver.scopeIndex solver
 S.mapM_ (\n -> H.assert (legacyScopeRoot expected n == Solver.scopeRoot expected n) "last-level selection changed a scope root") (IM.keys (Solver.scopeIntervals expected))
 S.mapM_ (\changed -> do
  H.assert (H.eq (Solver.equalScopes changed expected) (Solver.scopesAgreeValidated (Solver.graph solver) changed)) "scope audit changed equality"
  let forged = Solver (Solver.graph solver) (Solver.structuralParents solver) (Solver.bindingChildren solver) changed
  H.assert (H.eq (legacyFinish forged) (Solver.finish forged)) "scope audit changed the complete finish result") ((:) expected (if exhaustive then scopeMutations expected else boundaryScopeMutations expected))

-- Corrupt each jump level once at scale. Fine-grained key deletion,
-- cardinality, interval and ordering mutations remain exhaustive on small graphs.
boundaryScopeMutations (ScopeIndex intervals levels) =
 let rec changed : [] (IntMap Int) -> [] (IntMap Int) -> [] ScopeIndex = \prefix -> \pending -> case pending of
       [] -> []
       (:) level rest -> (:) (ScopeIndex intervals (S.append (S.reverse prefix) ((:) (IM.map (\n -> n + 1) level) rest))) (changed ((:) level prefix) rest) in
 (:) (ScopeIndex (IM.map (\((,) start end) -> (,) start (end + 1)) intervals) levels)
  ((:) (ScopeIndex intervals []) (changed [] levels))
scopeChain count = Graph (IM.fromList (S.concatMap (\n -> (:) ((,) (2*n) (Node (GGen (2*n+1)) (if n == 0 then Nothing else Just (2*(n-1))) Flexible)) ((:) ((,) (2*n+1) (Node GBot (Just (2*n)) Flexible)) [])) (S.range 0 (count - 1)))) IM.empty (2*count)
scopeAudit : IO ()
scopeAudit = do
 auditOneScope true scopedGraph
 auditOneScope true (scopeChain 8)
 S.mapM_ (\count -> auditOneScope false (scopeChain count)) ((:) 15 ((:) 16 ((:) 17 ((:) 255 ((:) 256 ((:) 257 []))))))
 putStrLn "deep scopes, exact intervals, forged sizes/extra keys and ancestry levels agree"


-- The expected receipt comes directly from each occurrence's position and
-- the last occurrence of duplicate originals, independently of allocation.
copyAllocation : IO ()
copyAllocation = do
 let small = S.concatMap (\offset -> S.concatMap (\count -> S.map (\fresh -> (,,) offset count fresh) ((:) (-7) ((:) 0 ((:) 9223372036854774783 ((:) 1152921504606846977 []))))) ((:) 0 ((:) 1 ((:) 2 ((:) 7 []))))) ((:) (-1152921504606846977) ((:) 0 ((:) 100003 [])))
 let scale = (:) ((,,) 0 31 9223372036854774783) ((:) ((,,) 0 257 9223372036854774783) ((:) ((,,) 100003 257 1152921504606846977) []))
 let inputs = S.concatMap (\((,,) offset count fresh) ->
       let identities = S.map (\n -> offset + 7*n) (S.range 0 (count - 1)) in
       S.map ((,) fresh) ((:) identities ((:) (S.reverse identities) ((:) (S.append identities identities) ((:) [] []))))) (S.append small scale)
 let unique = S.nubBy (\((,) a xs) ((,) b ys) -> a == b && S.eqList eqInt xs ys) inputs
 S.mapM_ (\((,) fresh originals) -> do
  let graph = Graph (NativeGraph.nodes scopedGraph) (IM.fromList ((:) ((,) fresh 0) ((:) ((,) (fresh+1) 2) []))) fresh
  let expectedCopies = IM.fromList (S.zip originals (S.range fresh (fresh + S.length originals - 1)))
  let expectedGraph = Graph (NativeGraph.nodes graph) (NativeGraph.links graph) (fresh + S.length originals)
  H.assert (H.eq (NativeGraph.allocateCopies graph originals) ((,) expectedCopies expectedGraph)) "copy allocation changed occurrence identities, node/alias maps or the exact fresh budget") unique

legacyKindUnify : [] ((,) Int Int) -> Graph -> Either String Graph
legacyKindUnify equations before = NativeGraph.bindE (NativeGraph.validateGraph before) (\checked ->
 NativeGraph.bindE (NativeGraph.kindsAt before (S.concatMap NativeGraph.equationNodes equations)) (\kinds ->
 NativeGraph.bindE (NativeGraph.foldE (NativeGraph.firstOrder kinds) before equations) (\skeleton ->
 NativeGraph.bindE (NativeGraph.rebind before (NativeGraph.canonicalize skeleton)) (\rebuilt ->
 NativeGraph.bindE (NativeGraph.validateGraph rebuilt) (\verified -> Right rebuilt)))))

kindFixture : Kind -> Graph
kindFixture kind = NativeGraph.mkGraph (IM.fromList
 ((:) ((,) 0 (NativeGraph.mkNode (GGen 1) Nothing Flexible))
 ((:) ((,) 1 (NativeGraph.mkNode (GTyApp 2 3) (Just 0) Flexible))
 ((:) ((,) 2 (NativeGraph.mkNode (GTyCon "F" (KArrow Star kind)) (Just 1) Rigid))
 ((:) ((,) 3 (NativeGraph.mkNode GBot (Just 1) Flexible))
 ((:) ((,) 4 (NativeGraph.mkNode (GBotK kind) (Just 0) Flexible))
 ((:) ((,) 5 (NativeGraph.mkNode (GTyCon "R" kind) (Just 0) Rigid))
 ((:) ((,) 6 (NativeGraph.mkNode (GSkolem 1152921504606846977 kind) (Just 0) Rigid)) [])))))))) IM.empty 7

compareKindGraph : Graph -> IO ()
compareKindGraph graph = do
 H.right (NativeGraph.validateGraph graph)
 S.mapM_ (\n -> H.assert (H.eq (NativeGraph.kindAt graph n) (NativeGraph.validatedKind graph n)) "higher kind or Gen-root kind changed") (IM.keys (NativeGraph.nodes graph))
 S.mapM_ (\a -> S.mapM_ (\b -> H.assert (H.eq (legacyKindUnify ((:) ((,) a b) []) graph) (NativeGraph.unify ((:) ((,) a b) []) graph)) "higher-kind unification or forged cardinality changed") (IM.keys (NativeGraph.nodes graph))) (IM.keys (NativeGraph.nodes graph))

swapKindLeaves : (Int -> Node) -> IntMapTree Node -> IntMapTree Node
swapKindLeaves value tree = case tree of
 IntMapNil -> IntMapNil
 IntMapTip key node -> if key == 15 then IntMapTip 20 (value 20) else
   if key == 20 then IntMapTip 15 (value 15) else IntMapTip key node
 IntMapBin count prefix left right -> IntMapBin count prefix (swapKindLeaves value left) (swapKindLeaves value right)

rawKindControls : IO ()
rawKindControls = do
 S.mapM_ (\kind -> do
  let original = kindFixture kind
  compareKindGraph original
  compareKindGraph (Graph (forgeCount 70 (NativeGraph.nodes original)) IM.empty 7))
  ((:) Star ((:) (KArrow Star Star) ((:) (KArrow (KArrow Star Star) (KArrow Star Star)) [])))
 -- Enumeration contains every valid node, but ordered lookup cannot find 15.
 -- The dense validator accepts this raw representation. The ordered guard
 -- must preserve the original kind traversal's missing-child diagnostic.
 let value = \n -> if n == 0 then NativeGraph.mkNode (GGen 1) Nothing Flexible else
       if n == 8 then NativeGraph.mkNode (GArr 15 15) (Just 0) Rigid else
       if n == 15 then NativeGraph.mkNode GBot (Just 8) Flexible else
       NativeGraph.mkNode (GCon "Unit" []) (Just 0) Rigid
 -- Swap only two leaf positions. Enumeration retains all graph nodes while
 -- lookup of 15 follows the old position to leaf 20 and fails.
 let tree = case IM.fromList (S.map (\n -> (,) n (value n))
       ((:) 0 ((:) 1 ((:) 5 ((:) 8 ((:) 10 ((:) 12 ((:) 15 ((:) 20 ((:) 25 ((:) 30 ((:) 35 ((:) 50 ((:) 70 [])))))))))))))) of
       IntMap original -> swapKindLeaves value original
 let malformed = Graph (IntMap tree) IM.empty 71
 H.right (NativeGraph.validateGraph malformed)
 H.assert (S.not (Solver.ascending (IM.keys (NativeGraph.nodes malformed)))) "invalid-Patricia kind fallback fixture is vacuous"
 let expected = legacyKindUnify ((:) ((,) 8 8) []) malformed
 H.assert (H.eq expected (Left "missing graph node 15")) "invalid-Patricia reference did not reach the expected kind error"
 H.assert (H.eq expected (NativeGraph.unify ((:) ((,) 8 8) []) malformed)) "invalid-Patricia map lost its original kind diagnostic"
 -- Sorted leaves alone do not certify Patricia lookup routing.
 let tip = \n -> IntMapTip n (value n)
 let routed = Graph (IntMap (IntMapBin 5 8 (IntMapBin 2 1 (tip 0) (tip 1))
       (IntMapBin 3 12 (tip 8) (IntMapBin 2 16 (tip 12) (tip 15))))) IM.empty 16
 H.right (NativeGraph.validateGraph routed)
 H.assert (Solver.ascending (IM.keys (NativeGraph.nodes routed))) "invalid-prefix sorted-leaf fixture is vacuous"
 let routedExpected = legacyKindUnify ((:) ((,) 8 8) []) routed
 H.assert (H.eq routedExpected (Left "missing graph node 15")) "invalid-prefix reference did not reach the expected kind error"
 H.assert (H.eq routedExpected (NativeGraph.unify ((:) ((,) 8 8) []) routed)) "sorted leaves concealed invalid Patricia routing"
 putStrLn "higher kinds, Gen roots, forged counts and invalid-Patricia kind fallback agree"

sharedKindGraph : Int -> Graph
sharedKindGraph depth =
 let root = 2*depth+2 in
 let entries = (:) ((,) 0 (NativeGraph.mkNode (GGen root) Nothing Flexible))
       ((:) ((,) 1 (NativeGraph.mkNode (GTyCon "Binary" (KArrow Star (KArrow Star Star))) (Just 0) Rigid))
       ((:) ((,) 2 (NativeGraph.mkNode (GCon "Unit" []) (Just 0) Rigid))
       (S.concatMap (\n -> (:) ((,) (2*n+1) (NativeGraph.mkNode (GTyApp 1 (2*n)) (Just 0) Rigid))
         ((:) ((,) (2*n+2) (NativeGraph.mkNode (GTyApp (2*n+1) (2*n)) (Just 0) Rigid)) [])) (S.range 1 depth)))) in
 NativeGraph.mkGraph (IM.fromDistinctAscList entries) IM.empty (root+1)

sharedKindControls : IO ()
sharedKindControls = do
 S.mapM_ (\depth -> do
  let graph = sharedKindGraph depth
  let root = 2*depth+2
  H.right (NativeGraph.validateGraph graph)
  H.assert (S.not (NativeGraph.orderedSimpleKinds (IM.toList (NativeGraph.nodes graph)))) "shared application DAG did not select the original kind cache"
  H.assert (H.eq (NativeGraph.validatedKind graph root) (Right Star)) "shared DAG query changed its kind"
  S.mapM_ (\equations -> H.assert (H.eq (legacyKindUnify equations graph) (NativeGraph.unify equations graph)) "shared application DAG changed unification")
   ((:) ((:) ((,) root root) []) ((:) ((:) ((,) 2 root) []) [])))
  ((:) 1 ((:) 8 ((:) 24 ((:) 64 []))))
 putStrLn "shared higher-kind DAGs retain the original memoized path"

validatedKindControls : IO ()
validatedKindControls = do
 sharedKindControls
 rawKindControls
 S.mapM_ (\graph -> case NativeGraph.validateGraph graph of
  Left _ -> return ()
  Right _ -> if IM.null (NativeGraph.links graph) && Solver.ascending (IM.keys (NativeGraph.nodes graph)) then do
   S.mapM_ (\n -> H.assert (H.eq (NativeGraph.kindAt graph n) (NativeGraph.validatedKind graph n)) "validated tag kind disagrees with independent complete kind traversal") (IM.keys (NativeGraph.nodes graph))
   let keys = IM.keys (NativeGraph.nodes graph)
   let missing = NativeGraph.nextId graph + 1000000
   S.mapM_ (\a -> S.mapM_ (\b -> do
    let pair = (,) a b
    S.mapM_ (\equations -> H.assert (H.eq (legacyKindUnify equations graph) (NativeGraph.unify equations graph)) "validated kind path changed unification or missing-input error priority")
     ((:) ((:) pair ((:) ((,) missing missing) [])) ((:) ((:) ((,) missing missing) ((:) pair [])) ((:) ((:) pair []) [])))) keys) keys
  else return ()) Validation.smallGraphs
 putStrLn "validated kinds and eager input-error priority agree"

-- Schemes nested inside another original Gen retain that owner's free
-- references. Establish one graph correspondence before comparing any scheme:
-- it starts at every original node and follows ordered structural/binder edges.
-- Only rigid, closed ground structure outside every variable-owner closure may
-- differ in sharing, fresh allocation or binder placement.
schemeSameFlag a b = case ((,) a b) of
 (,) Flexible Flexible -> true
 (,) Rigid Rigid -> true
 _ -> false

schemeSameShape a b = case ((,) a b) of
 (,) (GArr _ _) (GArr _ _) -> true
 (,) (GTyApp _ _) (GTyApp _ _) -> true
 (,) (GGen _) (GGen _) -> true
 (,) GBot GBot -> true
 (,) (GBotK k) (GBotK l) -> H.eq k l
 (,) (GCon n xs) (GCon m ys) -> eqString n m && H.length xs == H.length ys
 (,) (GTyCon n k) (GTyCon m l) -> eqString n m && H.eq k l
 (,) (GSkolem n k) (GSkolem m l) -> n == m && H.eq k l
 _ -> false

schemeSensitive node = case G.tag node of
 GGen _ -> true
 GSkolem _ _ -> true
 _ -> schemeSameFlag (G.flag node) Flexible

schemeProtect : Graph -> IntSet -> Int -> IntSet
schemeProtect graph seen original =
 let n = G.resolve graph original in
 if IS.member n seen then seen else
 case IM.lookup n (G.nodes graph) of
  Nothing -> IS.insert n seen
  Just node -> case G.binder node of
   Nothing -> IS.insert n seen
   Just owner -> schemeProtect graph (IS.insert n seen) owner

schemeProtected graph =
 S.foldl (schemeProtect graph) IS.empty
 (S.concatMap (\((,) n node) -> if schemeSensitive node then (:) n [] else [])
  (IM.toAscList (G.nodes graph)))

schemeClosedGround : Graph -> IntSet -> Int -> Bool
schemeClosedGround graph active original =
 let n = G.resolve graph original in
 if IS.member n active then false else
 case IM.lookup n (G.nodes graph) of
  Nothing -> false
  Just node ->
   schemeSameFlag (G.flag node) Rigid &&
   (case G.tag node of
    GBot -> false
    GBotK _ -> false
    GSkolem _ _ -> false
    GGen _ -> false
    _ -> S.all (schemeClosedGround graph (IS.insert n active)) (G.children (G.tag node)))

schemePairSeen x y seen = IS.member y (IM.findWithDefault IS.empty x seen)
schemeInsertSeen x y seen = IM.insert x (IS.insert y (IM.findWithDefault IS.empty x seen)) seen
schemeKnownDifferent key value mapping = case IM.lookup key mapping of
 Nothing -> false
 Just previous -> previous /= value

-- This comparator needs a total representative lookup. Its domain guard
-- checks every alias path before any G.resolve, independently of the production
-- validator's treatment of aliases outside the live structural graph.
schemeAliasPath : Graph -> IntSet -> IntSet -> Int -> Either String IntSet
schemeAliasPath graph complete active identity =
 if IS.member identity complete then Right complete
 else if IS.member identity active then Left "scheme correspondence: alias cycle"
 else case IM.lookup identity (G.links graph) of
  Nothing ->
   if IM.member identity (G.nodes graph) then Right (IS.insert identity complete)
   else Left "scheme correspondence: missing alias target"
  Just target -> do
   checked <- schemeAliasPath graph complete (IS.insert identity active) target
   Right (IS.insert identity checked)

schemeValidateLinks : Graph -> Either String ()
schemeValidateLinks graph = do
 _ <- S.foldM (\complete identity -> schemeAliasPath graph complete IS.empty identity)
  IS.empty (IM.keys (G.links graph))
 Right ()

schemeGraphRelation : Graph -> Graph -> Graph -> Either String (IntMap Int)
schemeGraphRelation original left right = do
 schemeValidateLinks original
 schemeValidateLinks left
 schemeValidateLinks right
 G.validateGraph original
 G.validateGraph left
 G.validateGraph right
 schemeVisit left right (schemeProtected left) (schemeProtected right)
  IM.empty IM.empty IM.empty (S.map (\n -> (,) n n) (IM.keys (G.nodes original)))

schemeVisit : Graph -> Graph -> IntSet -> IntSet -> IntMap Int -> IntMap Int ->
 IntMap IntSet -> [] ((,) Int Int) -> Either String (IntMap Int)
schemeVisit left right leftOwners rightOwners forward backward seen pending =
 case pending of
  [] -> Right forward
  (:) ((,) oldLeft oldRight) rest ->
   let x = G.resolve left oldLeft in
   let y = G.resolve right oldRight in
   if schemePairSeen x y seen
   then schemeVisit left right leftOwners rightOwners forward backward seen rest
   else case ((,) (IM.lookup x (G.nodes left)) (IM.lookup y (G.nodes right))) of
    (,) (Just a) (Just b) ->
     let message = H.append "scheme graph correspondence at " (H.show ((,) x y)) in
     if S.not (schemeSameShape (G.tag a) (G.tag b)) then Left (H.append message ": shape")
     else if S.not (schemeSameFlag (G.flag a) (G.flag b)) then Left (H.append message ": flag")
     else case ((,) (G.kindAt left x) (G.kindAt right y)) of
      (,) (Right k) (Right l) ->
       if S.not (H.eq k l) then Left (H.append message ": kind") else
       let children = S.zip (G.children (G.tag a)) (G.children (G.tag b)) in
       let visited = schemeInsertSeen x y seen in
       let ground = IS.notMember x leftOwners && IS.notMember y rightOwners &&
            schemeClosedGround left IS.empty x && schemeClosedGround right IS.empty y in
       if ground
       then schemeVisit left right leftOwners rightOwners forward backward visited
             (H.append children rest)
       else if schemeKnownDifferent x y forward || schemeKnownDifferent y x backward
       then Left (H.append message ": identity sharing")
       else case ((,) (G.binder a) (G.binder b)) of
        (,) Nothing Nothing ->
         schemeVisit left right leftOwners rightOwners (IM.insert x y forward) (IM.insert y x backward)
          visited (H.append children rest)
        (,) (Just pa) (Just pb) ->
         schemeVisit left right leftOwners rightOwners (IM.insert x y forward) (IM.insert y x backward)
          visited (H.append children ((:) ((,) pa pb) rest))
        _ -> Left (H.append message ": owner")
      _ -> Left (H.append message ": invalid kind")
    _ -> Left "scheme graph correspondence: missing node"

-- The domains remain separate. A rigid skolem's payload is its semantic
-- identity, not the identity of a possibly copied graph node.
schemeVariablePairs left right pairs =
 S.concatMap (\((,) x y) ->
  let a = G.nodeAt left x in
  let b = G.nodeAt right y in
  case ((,) (G.tag a) (G.tag b)) of
   (,) (GGen _) (GGen _) -> []
   (,) (GSkolem sk _) (GSkolem tk _) -> (:) ((,) sk tk) []
   _ -> if schemeSameFlag (G.flag a) Flexible then (:) ((,) x y) [] else [])
 (IM.toAscList pairs)

schemeVariablePair ((,) forward backward) ((,) x y) =
 if schemeKnownDifferent x y forward || schemeKnownDifferent y x backward
 then Left "scheme variable correspondence: identity sharing"
 else Right ((,) (IM.insert x y forward) (IM.insert y x backward))

data SchemeIdentity = SchemeIdentity
 (IntMap Int) (IntMap Int) (Map XTyVar Int) (Map XTyVar Int) Int

schemeIdentity : Graph -> Graph -> IntMap Int -> Either String SchemeIdentity
schemeIdentity left right nodes = do
 (,) forward backward <- S.foldM schemeVariablePair ((,) IM.empty IM.empty)
  (schemeVariablePairs left right nodes)
 let indexed = S.zip (S.range 0 (IM.size forward)) (IM.toAscList forward)
 let lm = M.fromList T.compareTyVar (S.map (\((,) i ((,) x _)) -> (,) (XTyVar x) i) indexed)
 let rm = M.fromList T.compareTyVar (S.map (\((,) i ((,) _ y)) -> (,) (XTyVar y) i) indexed)
 Right (SchemeIdentity forward backward lm rm (IM.size forward))

schemeCovered variables ty =
 S.all (\(XTyVar n) -> IM.member n variables) (TypeSet.toList (T.freeVars ty))

schemeAlpha : SchemeIdentity -> XType -> XType -> Either String ()
schemeAlpha identity left right = case identity of
 SchemeIdentity forward backward lm rm depth ->
  if S.not (schemeCovered forward left && schemeCovered backward right)
  then Left "scheme variable correspondence: unanchored free variable"
  else if T.alphaIn lm rm depth left right then Right ()
  else Left "scheme differs in its validated ambient context"

schemeCompareAll : Graph -> Graph -> Graph -> Either String Int
schemeCompareAll original expected optimized = do
 nodes <- schemeGraphRelation original expected optimized
 identity <- schemeIdentity expected optimized nodes
 let expectedContext = Elaborate.prepareTypes expected
 let optimizedContext = Elaborate.prepareTypes optimized
 let gens = S.concatMap (\((,) n node) -> case G.tag node of
              GGen _ -> (:) n []
              _ -> []) (IM.toAscList (G.nodes original))
 S.mapM_ (\gen ->
  let left = Elaborate.schemeTypeIn expectedContext gen in
  let right = Elaborate.schemeTypeIn optimizedContext gen in
  case schemeAlpha identity left right of
   Right () -> Right ()
   Left why -> Left (H.append "changed scheme at " (H.append (H.show gen)
    (H.append ": " (H.append why (H.append "\n" (H.append (H.show left)
     (H.append "\n" (H.show right))))))))) gens
 Right (H.length gens)

schemeComparisonTest : IO ()
schemeComparisonTest = do
 schemeComparisonControls
 counts <- S.forM
  (H.append fixtures (S.map (\name -> H.append "benchmarks/" (H.append name "/mlf/main.emlf"))
   ((:) "binary-trees" ((:) "pidigits" ((:) "n-body" ((:) "fannkuch-redux" []))))))
  (\file -> do
   c <- constraints file
   initial <- H.right (bind (Solver.prepare (initialGraph c)) (Solver.unify (equalities c)))
   exact <- H.right (bind (S.foldM exactSolveStep initial (solveSteps c)) Solver.finish)
   optimized <- H.right (solve c)
   case schemeCompareAll (initialGraph c) (G.normalize exact) optimized of
    Left message -> H.fail (H.append file (H.append ": " message))
    Right count -> return count)
 putStrLn (H.append "Closed instances: " (H.append (H.show (S.sum counts)) " independent scheme comparisons"))

schemeControlInitial : Graph
schemeControlInitial = Graph (IM.fromList
 ((:) ((,) 0 (Node (GGen 1) Nothing Flexible))
 ((:) ((,) 1 (Node GBot (Just 0) Flexible))
 ((:) ((,) 4 (Node (GGen 5) (Just 0) Flexible))
 ((:) ((,) 5 (Node GBot (Just 4) Flexible))
 ((:) ((,) 6 (Node (GGen 7) (Just 0) Flexible))
 ((:) ((,) 7 (Node GBot (Just 6) Flexible)) []))))))) IM.empty 8

schemeControl a b = Graph (IM.fromList
 ((:) ((,) 0 (Node (GGen 1) Nothing Flexible))
 ((:) ((,) 1 (Node (GArr a b) (Just 0) Rigid))
 ((:) ((,) 4 (Node (GGen 5) (Just 0) Flexible))
 ((:) ((,) 5 (Node (GArr a a) (Just 4) Rigid))
 ((:) ((,) 6 (Node (GGen 7) (Just 0) Flexible))
 ((:) ((,) 7 (Node (GArr a b) (Just 6) Rigid))
 ((:) ((,) a (Node GBot (Just 0) Flexible))
 ((:) ((,) b (Node GBot (Just 0) Flexible)) []))))))))) IM.empty 1000

schemeControlSet n value graph =
 Graph (IM.insert n value (G.nodes graph)) (G.links graph) (G.nextId graph)

schemeGroundInitial : Graph
schemeGroundInitial = Graph (IM.fromList
 ((:) ((,) 0 (Node (GGen 1) Nothing Flexible))
 ((:) ((,) 1 (Node (GArr 2 3) (Just 0) Rigid))
 ((:) ((,) 2 (Node GBot (Just 0) Flexible))
 ((:) ((,) 3 (Node GBot (Just 0) Flexible)) []))))) IM.empty 4

schemeGroundControl a b c d owner = Graph (IM.fromList
 ((:) ((,) 0 (Node (GGen 1) Nothing Flexible))
 ((:) ((,) 1 (Node (GArr 2 3) (Just 0) Rigid))
 ((:) ((,) 2 (Node (GCon "Pair" ((:) a ((:) b []))) (Just 1) Rigid))
 ((:) ((,) 3 (Node (GCon "Pair" ((:) c ((:) d []))) (Just 1) Rigid))
 ((:) ((,) a (Node (GTyCon "Int" Star) (Just owner) Rigid))
 ((:) ((,) b (Node (GTyCon "Int" Star) (Just owner) Rigid))
 ((:) ((,) c (Node (GTyCon "Int" Star) (Just owner) Rigid))
 ((:) ((,) d (Node (GTyCon "Int" Star) (Just owner) Rigid)) []))))))))) IM.empty 1000

schemeValidReject initial expected actual = do
 H.right (G.validateGraph actual)
 H.reject (schemeCompareAll initial expected actual)

schemeComparisonControls : IO ()
schemeComparisonControls = do
 H.right (G.validateGraph schemeControlInitial)
 let expected = schemeControl 100 101
 let optimized = schemeControl 200 201
 H.right (G.validateGraph expected)
 H.right (G.validateGraph optimized)
 count <- H.right (schemeCompareAll schemeControlInitial expected optimized)
 H.assert (count == 3) "ambient oracle omitted an original Gen"
 _ <- H.right (schemeCompareAll schemeControlInitial expected (schemeControl 101 100))
 -- Splitting, merging or swapping a captured parameter across two original
 -- schemes must fail the same global relation, even with the same owner.
 let split = schemeControlSet 202 (Node GBot (Just 0) Flexible)
              (schemeControlSet 5 (Node (GArr 200 202) (Just 4) Rigid) optimized)
 let merged = schemeControlSet 1 (Node (GArr 200 200) (Just 0) Rigid) optimized
 let swapped = schemeControlSet 7 (Node (GArr 201 200) (Just 6) Rigid) optimized
 schemeValidReject schemeControlInitial expected split
 schemeValidReject schemeControlInitial expected merged
 schemeValidReject schemeControlInitial expected swapped
 schemeValidReject schemeControlInitial expected
  (schemeControlSet 200 (Node GBot (Just 0) Rigid) optimized)
 -- This owner mutation escapes its new scope; it is an invalid-input control.
 let owner = schemeControlSet 200 (Node GBot (Just 4) Flexible) optimized
 H.reject (G.validateGraph owner)
 H.reject (schemeCompareAll schemeControlInitial expected owner)
 let skolemLeft = schemeControlSet 100 (Node (GSkolem 777 Star) (Just 0) Rigid) expected
 let skolemRight = schemeControlSet 200 (Node (GSkolem 777 Star) (Just 0) Rigid) optimized
 _ <- H.right (schemeCompareAll schemeControlInitial skolemLeft skolemRight)
 schemeValidReject schemeControlInitial skolemLeft
  (schemeControlSet 200 (Node (GSkolem 778 Star) (Just 0) Rigid) optimized)
 nodes <- H.right (schemeGraphRelation schemeControlInitial expected optimized)
 identity <- H.right (schemeIdentity expected optimized nodes)
 -- 200 is lexical on the left but ambient on the right; 100 is the converse.
 -- This checks capture avoidance as well as overlapping graph ID namespaces.
 H.right (schemeAlpha identity
  (XForall (XTyVar 200) XBot (XArrow (XVar (XTyVar 100)) (XVar (XTyVar 200))))
  (XForall (XTyVar 100) XBot (XArrow (XVar (XTyVar 200)) (XVar (XTyVar 100)))))
 H.right (schemeAlpha identity
  (XForall (XTyVar 100) XBot (XVar (XTyVar 100)))
  (XForall (XTyVar 200) XBot (XVar (XTyVar 200))))
 H.reject (schemeAlpha identity
  (XForall (XTyVar 300) XBot (XArrow (XVar (XTyVar 100)) (XVar (XTyVar 300))))
  (XForall (XTyVar 200) XBot (XArrow (XVar (XTyVar 200)) (XVar (XTyVar 200)))))
 H.reject (schemeAlpha identity (XVar (XTyVar 999)) (XVar (XTyVar 999)))
 -- Closed rigid structure may duplicate/share descendants and reparent them.
 let groundLeft = schemeGroundControl 100 101 102 103 0
 let groundRight = schemeGroundControl 200 200 200 200 1
 H.right (G.validateGraph schemeGroundInitial)
 H.right (G.validateGraph groundLeft)
 H.right (G.validateGraph groundRight)
 _ <- H.right (schemeCompareAll schemeGroundInitial groundLeft groundRight)
 schemeValidReject schemeGroundInitial groundLeft
  (schemeControlSet 200 (Node (GTyCon "Bool" Star) (Just 1) Rigid) groundRight)
 schemeValidReject schemeGroundInitial groundLeft
  (schemeControlSet 2 (Node (GCon "Pair" ((:) 200 [])) (Just 1) Rigid) groundRight)
 let wrongKind = schemeControlSet 200 (Node (GTyCon "Int" (KArrow Star Star)) (Just 1) Rigid) groundRight
 H.reject (G.validateGraph wrongKind)
 H.reject (schemeCompareAll schemeGroundInitial wrongKind wrongKind)
 let illApplied = schemeControlSet 2 (Node (GTyApp 200 200) (Just 1) Rigid) groundRight
 H.reject (G.validateGraph illApplied)
 H.reject (schemeCompareAll schemeGroundInitial illApplied illApplied)
 let missing = schemeControlSet 2 (Node (GArr 999 200) (Just 1) Rigid) groundRight
 H.reject (G.validateGraph missing)
 H.reject (schemeCompareAll schemeGroundInitial missing missing)
 let cyclic = schemeControlSet 2 (Node (GArr 2 200) (Just 1) Rigid) groundRight
 H.reject (G.validateGraph cyclic)
 H.reject (schemeCompareAll schemeGroundInitial cyclic cyclic)
 H.assert (S.not (schemeClosedGround cyclic IS.empty 2)) "ground predicate accepted structural cycle"
 let aliasChain = Graph (G.nodes groundRight) (IM.fromList ((:) ((,) 900 901) ((:) ((,) 901 200) []))) 1000
 H.right (schemeValidateLinks aliasChain)
 _ <- H.right (schemeCompareAll schemeGroundInitial groundLeft aliasChain)
 let missingAlias = Graph (G.nodes groundRight) (IM.singleton 900 999) 1000
 H.reject (schemeValidateLinks missingAlias)
 H.reject (schemeCompareAll schemeGroundInitial missingAlias missingAlias)
 let aliases = Graph (G.nodes groundRight) (IM.fromList ((:) ((,) 900 901) ((:) ((,) 901 900) []))) 1000
 H.reject (schemeValidateLinks aliases)
 H.reject (schemeCompareAll schemeGroundInitial aliases aliases)
 S.mapM_ (\node ->
  H.assert (S.not (schemeClosedGround (schemeControlSet 200 node groundRight) IS.empty 200))
   "ground predicate accepted a variable, Gen, skolem or flexible node")
  ((:) (Node GBot (Just 1) Rigid)
  ((:) (Node (GBotK Star) (Just 1) Rigid)
  ((:) (Node (GSkolem 777 Star) (Just 1) Rigid)
  ((:) (Node (GGen 2) (Just 1) Rigid)
  ((:) (Node (GTyCon "Int" Star) (Just 1) Flexible) [])))))
 let ownedGround = schemeControlSet 250 (Node GBot (Just 200) Flexible) groundRight
 H.assert (IS.member 200 (schemeProtected ownedGround)) "ground exception lost a variable owner"
 putStrLn "scheme context: anchored sharing, owners, ground structure, skolems and capture controls agree"
