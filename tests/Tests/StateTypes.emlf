module Tests.StateTypes where
import Bootstrap.Types
import qualified Bootstrap.Std as S
import qualified Package.OS as OS
import qualified Tests.Helpers as H
import Tests.Helpers (Quint(..), Sext(..))
import qualified Bootstrap.Compiler as C
import Bootstrap.Compiler (Compilation)
import qualified Bootstrap.Primitive as P
import qualified Bootstrap.X.Check as Check
import qualified Bootstrap.X.Parser as Parser
import qualified Bootstrap.X.Pretty as Pretty
import qualified Bootstrap.X.Syntax as X
import qualified Bootstrap.X.Type as T
import Tests.StateCases

checkedStateSource : String -> IO Compilation
checkedStateSource source = do { result <- (S.either (S.compose H.fail H.show) return (C.compile "<ST fixture>" source)); do { target <- (S.either H.fail return (Parser.parseTerm "<ST target>" (Pretty.prettyTerm (C.compiledTerm result)))); do { ty <- (S.either H.fail return (Check.checkClosed target)); do { (S.unless (T.alphaEq ty (C.inferredType result)) (H.fail "ST target roundtrip changed type")); do { (S.unless (H.eq (X.erase target) (X.erase (C.compiledTerm result))) (H.fail "ST target roundtrip changed erasure")); (return result) } } } } }

stateTypeTests : (List ( (Pair (String) (IO Unit)) ))
stateTypeTests = (H.append (S.concatMap (\(Quad label accepted source expectedType) -> (Cons (Pair (H.append "ST source type: " label) (if accepted then do { result <- (checkedStateSource source); ((H.forM_ (S.maybeToList expectedType)) (\expected -> (S.unless (H.eq (C.sourceType result) expected) (H.fail (H.append "expected " (H.append expected (H.append ", got " (C.sourceType result)))))))) } else (case (C.compile "<ST rejection>" source) of { (Left err) -> (S.unless (H.eq (C.phase err) Inference) (H.fail (H.append "expected a type inference rejection: " (H.show err)))); (Right result) -> (H.fail (H.append "accepted escaping or ill-typed state: " (C.sourceType result))) }))) Nil)) stateTypeCases) (H.append (S.concatMap (\(Triple label accepted source) -> (Cons (Pair (H.append "ST target type: " label) do { term <- (S.either H.fail return (Parser.parseTerm "<ST direct target>" source)); (case (Pair accepted (Check.checkClosed term)) of { (Pair true (Right _)) -> (return Unit); (Pair false (Left _)) -> (return Unit); (Pair true (Left err)) -> (H.fail err); (Pair false (Right ty)) -> (H.fail (H.append "accepted invalid target: " (Pretty.prettyType ty))) }) }) Nil)) stateTargetCases) (Cons (Pair "ST primitive ABI is appended and action construction stays lazy" (let { rows = (Cons (Quint PGetExecutablePath 64 "getExecutablePath" 0 false) (Cons (Quint PGetContents 65 "getContents" 0 false) (Cons (Quint PSTReturn 66 "stReturn" 1 false) (Cons (Quint PSTBind 67 "stBind" 2 false) (Cons (Quint PRunST 68 "runST" 1 true) (Cons (Quint PNewSTArray 69 "newSTArray" 2 false) (Cons (Quint PReadSTArray 70 "readSTArray" 2 false) (Cons (Quint PWriteSTArray 71 "writeSTArray" 3 false) (Cons (Quint PLengthSTArray 72 "lengthSTArray" 1 false) Nil))))))))) } in ((H.forM_ rows) (\(Quint primitive code name arity strict) -> (S.unless ((H.eq (P.primitiveCode primitive) code) && ((H.eq (P.primitiveName primitive) name) && ((H.eq (P.primitiveArity primitive) arity) && (H.eq (P.primitiveStrict primitive) strict)))) (H.fail (H.append "incorrect state primitive metadata: " (H.show primitive)))))))) (Cons (Pair "ST primitives work with implicit prelude disabled" do { result <- (S.either (S.compose H.fail H.show) return (C.compileWithPrelude NoImplicitPrelude "<no prelude ST>" "runST (stBind (newSTArray 1 7) (\\a -> readSTArray a 0))")); (S.unless (T.alphaEq (C.inferredType result) (XCon "Int" Nil)) (H.fail (C.sourceType result))) }) Nil))))
