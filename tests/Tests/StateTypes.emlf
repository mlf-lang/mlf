module Tests.StateTypes where
import Prelude hiding (Monad, return, bind)
import MLF.Primitive (Monad, return, bind)
import qualified Test.Assert as A
import Bootstrap.Types
import qualified Bootstrap.Std as S
import qualified Package.OS as OS
import qualified Tests.Helpers as H
import Tests.Helpers (Quint(..), Sext(..))
import qualified Bootstrap.Compiler as C
import Bootstrap.Compiler (Compilation)
import qualified Bootstrap.Primitive as P
import qualified Bootstrap.X.Check as Check
import qualified Bootstrap.X.Parser as Parser
import qualified Bootstrap.X.Pretty as Pretty
import qualified Bootstrap.X.Syntax as X
import qualified Bootstrap.X.Type as T
import Tests.StateCases

assertStateSource : String -> A.Test Compilation
assertStateSource source = do { result <- (A.andThen (A.liftIO (C.compile "<ST fixture>" source)) (S.either (S.compose A.fail H.show) return)); do { target <- (S.either A.fail return (Parser.parseTerm "<ST target>" (Pretty.prettyTerm (C.compiledTerm result)))); do { ty <- (S.either A.fail return (Check.checkClosed target)); do { (S.unless (T.alphaEq ty (C.inferredType result)) (A.fail "ST target roundtrip changed type")); do { (S.unless (H.eq (X.erase target) (X.erase (C.compiledTerm result))) (A.fail "ST target roundtrip changed erasure")); (return result) } } } } }

stateTypeTests : ([] ( ((,) (String) (A.Test ())) ))
stateTypeTests = (H.append (S.concatMap (\((,,,) label accepted source expectedType) -> ((:) ((,) (H.append "ST source type: " label) (if accepted then do { result <- (assertStateSource source); ((H.forM_ (S.maybeToList expectedType)) (\expected -> (S.unless (H.eq (C.sourceType result) expected) (A.fail (H.append "expected " (H.append expected (H.append ", got " (C.sourceType result)))))))) } else (do { compilationResult <- A.liftIO (C.compile "<ST rejection>" source); case compilationResult of { (Left err) -> (S.unless (H.eq (C.phase err) Inference) (A.fail (H.append "expected a type inference rejection: " (H.show err)))); (Right result) -> (A.fail (H.append "accepted escaping or ill-typed state: " (C.sourceType result))) } }))) [])) stateTypeCases) (H.append (S.concatMap (\((,,) label accepted source) -> ((:) ((,) (H.append "ST target type: " label) do { term <- (S.either A.fail return (Parser.parseTerm "<ST direct target>" source)); (case ((,) accepted (Check.checkClosed term)) of { ((,) true (Right _)) -> (return ()); ((,) false (Left _)) -> (return ()); ((,) true (Left err)) -> (A.fail err); ((,) false (Right ty)) -> (A.fail (H.append "accepted invalid target: " (Pretty.prettyType ty))) }) }) [])) stateTargetCases) ((:) ((,) "ST primitive ABI is appended and action construction stays lazy" (let { rows = ((:) (Quint PGetExecutablePath 64 "getExecutablePath" 0 false) ((:) (Quint PGetContents 65 "getContents" 0 false) ((:) (Quint PSTReturn 66 "stReturn" 1 false) ((:) (Quint PSTBind 67 "stBind" 2 false) ((:) (Quint PRunST 68 "runST" 1 true) ((:) (Quint PNewSTArray 69 "newSTArray" 2 false) ((:) (Quint PReadSTArray 70 "readSTArray" 2 false) ((:) (Quint PWriteSTArray 71 "writeSTArray" 3 false) ((:) (Quint PLengthSTArray 72 "lengthSTArray" 1 false) []))))))))) } in ((H.forM_ rows) (\(Quint primitive code name arity strict) -> (S.unless ((H.eq (P.primitiveCode primitive) code) && ((H.eq (P.primitiveName primitive) name) && ((H.eq (P.primitiveArity primitive) arity) && (H.eq (P.primitiveStrict primitive) strict)))) (A.fail (H.append "incorrect state primitive metadata: " (H.show primitive)))))))) ((:) ((,) "ST primitives work with implicit prelude disabled" do { result <- (A.andThen (A.liftIO (C.compileWithPrelude NoImplicitPrelude "<no prelude ST>" "runST (stBind (newSTArray 1 7) (\\a -> readSTArray a 0))")) (S.either (S.compose A.fail H.show) return)); (S.unless (T.alphaEq (C.inferredType result) (XCon "Int" [])) (A.fail (C.sourceType result))) }) []))))

-- The interpreter/LLVM suite still consumes this compilation as an IO prerequisite.
checkedStateSource : String -> IO Compilation
checkedStateSource source = A.orExit (assertStateSource source)
