module Tests.ConstructorProjection where
import Bootstrap.Types
import qualified Bootstrap.Std as S
import qualified Package.OS as OS
import qualified Tests.Helpers as H
import Tests.Helpers (Quint(..), Sext(..))
import qualified Tests.Map as Map
import qualified Tests.Set as Set
import Tests.Backends
import qualified Tests.Backends as B
import Bootstrap.Compiler (compile, compiledTerm)
import qualified Bootstrap.LLVM.Analysis as A
import qualified Bootstrap.LLVM.Optimize as O
import qualified Bootstrap.Primitive as P
import qualified Bootstrap.X.Syntax as X

children : XErased -> (List ( XErased ))
children expression = (case expression of { (XEAbs _ b) -> (Cons b Nil); (XEApp f a) -> (Cons f (Cons a Nil)); (XELet _ a b) -> (Cons a (Cons b Nil)); (XELetRec ds b) -> (H.append (S.map S.snd ds) (Cons b Nil)); (XECase a branches) -> (Cons a (S.concatMap (\comprehension1 -> case comprehension1 of { (XErasedAlternative _ b) -> (Cons b Nil); _ -> Nil }) branches)); _ -> Nil })

countPrimitive : Primitive -> XErased -> Int
countPrimitive wanted expression = ((let guardSubject2 = expression in (let guardNext4 = \ignored -> (let guardNext3 = \ignored -> (panic "non-exhaustive test case") in (case guardSubject2 of { _ -> 0 })) in (case guardSubject2 of { (XEPrimitive primitive) -> (if (H.eq primitive wanted) then 1 else (guardNext4 Unit)); _ -> (guardNext4 Unit) }))) + (S.sum (S.map (countPrimitive wanted) (children expression))))

countCase : String -> XErased -> Int
countCase constructor expression = (let { matches (XErasedAlternative (XConstructorPattern c _) _) = (H.eq c constructor); matches _ = false } in ((let guardSubject5 = expression in (let guardNext7 = \ignored -> (let guardNext6 = \ignored -> (panic "non-exhaustive test case") in (case guardSubject5 of { _ -> 0 })) in (case guardSubject5 of { (XECase _ branches) -> (if (S.any matches branches) then 1 else (guardNext7 Unit)); _ -> (guardNext7 Unit) }))) + (S.sum (S.map (countCase constructor) (children expression)))))

binders : XErased -> (List ( XName ))
binders expression = (H.append (case expression of { (XEAbs n _) -> (Cons n Nil); (XELet n _ _) -> (Cons n Nil); (XELetRec ds _) -> (S.map S.fst ds); (XECase _ branches) -> (H.concat (S.concatMap (\comprehension8 -> case comprehension8 of { (XErasedAlternative p _) -> (Cons (X.patternNames p) Nil); _ -> Nil }) branches)); _ -> Nil }) (H.concatMap binders (children expression)))

constructorProjectionTests : B.Backends -> (List ( (Pair (String) (IO Unit)) ))
constructorProjectionTests backends = (let { capturedWorker f = ((S.not (H.null (A.captures f))) && ((H.eq (H.length (A.parameters f)) 1) && ((countPrimitive PAddInt (A.functionBody f)) >= 6))) } in (let { sources = (Cons (Triple "shared fields and lazy poison" (H.append "data Cell = Cell Int Int; main = let cell = Cell (readInt \"42\") (panic \"unused field\") in " "case cell of { Cell x _ -> case cell of { Cell y _ -> do { printInt x; printInt y } } };") "42\n42\n") (Cons (Triple "captured function becomes a known worker" (H.append "data Ops = Ops (Int -> Int); main = let saved = readInt \"19\" in " (H.append "let ops = Ops (\\n -> saved + n + 1 + 1 + 1 + 1 + 1) in " "case ops of { Ops f -> case ops of { Ops g -> do { putStrLn \"before\"; printInt (f 18); printInt (g 17) } } };")) "before\n42\n41\n") (Cons (Triple "recursive data keeps its knot" (S.unlines (Cons "data Stream = Stream Int Stream" (Cons "ones : Stream" (Cons "ones = Stream (readInt \"42\") ones" (Cons "main = case ones of" (Cons "  Stream x next -> case next of" (Cons "    Stream y _ -> do" (Cons "      printInt x" (Cons "      printInt y" Nil))))))))) "42\n42\n") (Cons (Triple "mutually recursive dictionary methods" (H.append "class Count a where { first : a -> Int; second : a -> Int }; " (H.append "instance Count Int where { first = \\n -> if n == 0 then 42 else second (n - 1); " (H.append "second = \\n -> if n == 0 then 42 else first (n - 1) }; " "main = do { printInt (first 10); printInt (second 11) };"))) "42\n42\n") (Cons (Triple "partial constructors remain lazy" (H.append "data Triple = Triple Int Int Int; main = let partial = Triple (panic \"unused partial field\") in " "do { seq partial (putStrLn \"partial\"); case partial 19 23 of { Triple _ a b -> printInt (a + b) } };") "partial\n42\n") (Cons (Triple "same spelling in disjoint scopes" (H.append "data Cell = Cell Int; main = let cell = Cell (readInt \"19\") in " (H.append "let pick = \\ignored -> case cell of { Cell x -> x } in " "let cell = Cell (readInt \"23\") in do { printInt (pick ()); case cell of { Cell y -> printInt y } };")) "19\n23\n") (Cons (Triple "escaping constructor shares its fields" (H.append "data Cell = Cell Int Int; main = let cell = Cell (readInt \"42\") (panic \"unused escaping field\") in " "case cell of { Cell x _ -> do { printInt x; escaped <- return cell; case escaped of { Cell y _ -> printInt y } } };") "42\n42\n") (Cons (Triple "default branch preserves its bound constructor" (H.append "data Choice = One Int | Two Int; main = let choice = Two (readInt \"42\") in " "case choice of { One _ -> printInt 0; other -> case other of { Two n -> printInt n; _ -> printInt 1 } };") "42\n") Nil)))))))) } in (H.append (Cons (Pair "constructor projections: demanded field fails after preceding effects" do { term <- (H.fmap compiledTerm (S.either (S.compose H.fail H.show) return (compile "<constructor projection failure>" (H.append "data Box = Box Int; main = let box = Box (panic \"demanded field\") in " "do { putStrLn \"before\"; case box of { Box n -> printInt n } };")))); do { result <- (B.execute backends IOEntry (Input "" false) term); (S.unless ((S.either (S.compose (\section9 -> (H.eq section9 "demanded field")) H.show) (S.const false) (B.outcome result)) && (H.eq (B.events result) (Cons (B.Write "before\n") Nil))) (H.fail (H.show result))) } }) Nil) (S.concatMap (\(Triple label source expected) -> (Cons (Pair (H.append "constructor projections: " label) do { term <- (H.fmap compiledTerm (S.either (S.compose H.fail H.show) return (compile "<constructor projection>" source))); (let { original = (X.erase term) } in (let { optimized = (O.optimize original) } in (let { names = (binders optimized) } in do { (S.unless ((Set.null (O.free optimized)) && (H.eq (H.length names) (Set.size (Set.fromList names)))) (H.fail "constructor projection changed scope or duplicated a binder identity")); do { ((S.when (H.eq label "shared fields and lazy poison")) do { (S.unless ((H.eq (countCase "Cell" original) 2) && (H.eq (countCase "Cell" optimized) 0)) (H.fail "known-constructor projection path did not remove both cases")); (S.unless (H.eq (countPrimitive PReadInt optimized) 1) (H.fail "a shared field computation was duplicated or discarded")) }); do { ((S.when (H.eq label "captured function becomes a known worker")) do { (S.unless ((H.eq (countCase "Ops" optimized) 0) && (S.any capturedWorker (Map.elems (A.analyze optimized)))) (H.fail "lifted function field did not expose a captured native worker")); (S.unless (H.eq (countPrimitive PReadInt optimized) 1) (H.fail "function capture was duplicated")) }); do { result <- (B.execute backends IOEntry (Input "" false) term); do { (S.either (S.compose H.fail H.show) return (B.outcome result)); (S.unless (H.eq (B.output result) expected) (H.fail (H.show result))) } } } } }))) }) Nil)) sources))))
