module Tests.GraphValidation where
-- Select the standard Monad used by shared Either; retain legacy guest syntax.
import Prelude hiding (Monad, return, bind)
import MLF.Primitive (Monad, return, bind)
import Bootstrap.Types
import qualified Bootstrap.Std as S
import qualified Package.OS as OS
import qualified Tests.Helpers as H
import Tests.Helpers (Quint(..), Sext(..))
import qualified Bootstrap.IntMap as IM
import qualified Bootstrap.IntSet as IS
import Tests.Graph
import Bootstrap.Kind
import qualified Tests.Graph as G

graphValidationTests : ([] ( ((,) (String) (IO ())) ))
graphValidationTests = ((:) ((,) "graph validation agrees with uncached reference" (let { graphs = smallGraphs } in (let { accepted = (H.length (S.filter (S.compose S.isRight referenceValidation) graphs)) } in do { (S.unless ((accepted > 25) && (accepted < (H.length graphs))) (H.fail (H.append "vacuous graph corpus: " (H.append (H.show accepted) " valid")))); do { ((H.forM_ graphs) (\g -> (S.unless (H.eq (S.isRight (validateGraph g)) (S.isRight (referenceValidation g))) (H.fail (H.append "graph validation disagrees with reference: " (H.show g)))))); (putStrLn (H.append "Graph validation: " (H.append (H.show (H.length graphs)) (H.append " graphs; " (H.append (H.show accepted) " valid"))))) } }))) ((:) ((,) "graph validation checks deeply nested binding scopes" (let { g = (nestedGraph 1000) } in do { (S.either H.fail return (validateGraph g)); (let { small = nestedGraph 3; invalid = (Graph (IM.adjust (\v -> (Node (GArr 2 3) (G.binder v) (G.flag v))) 1 (nodes small)) (G.links small) (G.nextId small)) } in do { S.either H.fail return (validateGraph small); S.unless (S.not (S.isRight (validateGraph invalid)) && S.not (S.isRight (referenceValidation invalid))) (H.fail "accepted scope escape") }) })) ((:) ((,) "graph validation checks shared higher-kinded subgraphs" (let { g = (Graph (IM.fromList ((:) ((,) 0 (Node (GGen 1) Nothing Flexible)) ((:) ((,) 1 (Node (GArr 2 2) (Just 0) Rigid)) ((:) ((,) 2 (Node (GTyApp 3 4) (Just 1) Rigid)) ((:) ((,) 3 (Node (GTyCon "F" (KArrow Star Star)) (Just 2) Rigid)) ((:) ((,) 4 (Node GBot (Just 2) Flexible)) [])))))) IM.empty 5) } in do { (S.either H.fail return (validateGraph g)); (let { invalid = (Graph (IM.adjust (\v -> (Node (GBotK (KArrow Star Star)) (G.binder v) (G.flag v))) 4 (nodes g)) (G.links g) (G.nextId g)) } in (S.unless (S.not (S.isRight (validateGraph invalid))) (H.fail "accepted kind mismatch"))) })) [])))

smallGraphs : ([] ( Graph ))
smallGraphs = (S.concatMap (\top -> (S.concatMap (\left -> (S.concatMap (\right -> (S.concatMap (\parent -> (S.concatMap (\leftParent -> (S.concatMap (\rightParent -> (S.concatMap (\aliases -> ((:) (Graph (IM.fromList ((:) ((,) 0 (Node (GGen 1) Nothing Flexible)) ((:) ((,) 1 (Node top parent Flexible)) ((:) ((,) 2 (Node left leftParent Flexible)) ((:) ((,) 3 (Node right rightParent Rigid)) []))))) aliases 6) [])) ((:) IM.empty ((:) (IM.fromList ((:) ((,) 5 4) ((:) ((,) 4 2) []))) [])))) ((:) Nothing ((:) (Just 0) ((:) (Just 1) ((:) (Just 2) ((:) (Just 9) []))))))) ((:) Nothing ((:) (Just 0) ((:) (Just 1) ((:) (Just 3) ((:) (Just 9) []))))))) ((:) Nothing ((:) (Just 0) ((:) (Just 2) []))))) ((:) GBot ((:) (GTyCon "G" (KArrow Star Star)) ((:) (GArr 2 2) ((:) (GArr 9 9) [])))))) ((:) GBot ((:) (GTyCon "F" (KArrow Star Star)) ((:) (GArr 3 3) ((:) (GGen 3) [])))))) ((:) (GArr 2 3) ((:) (GArr 2 2) ((:) (GTyApp 2 3) ((:) (GCon "Pair" ((:) 2 ((:) 3 []))) ((:) (GArr 5 3) []))))))

nestedGraph : Int -> Graph
nestedGraph depth = (Graph (IM.fromList ((:) ((,) 0 (Node (GGen 1) Nothing Flexible)) (S.concatMap (\n -> ((:) ((,) n (Node (if (H.eq n depth) then GBot else (GArr (n + 1) (n + 1))) (Just (n - 1)) Flexible)) [])) (S.range 1 depth)))) IM.empty (depth + 1))

referenceValidation : Graph -> Either String ()
referenceValidation g = (let rec { bindingPath : IntSet -> Int -> Either String (); bindingPath seen n = (if (IS.member n seen) then (Left "binding cycle") else (if true then do { v <- (S.maybe (Left "missing binder") return (IM.lookup n (nodes g))); (S.maybe (return ()) (bindingPath (IS.insert n seen)) (binder v)) } else (panic "non-exhaustive test guard"))) } in (let rec { kind : IntSet -> Int -> Either String Kind; kind seen original = (let { n = (resolve g original) } in do { (S.unless (IS.notMember n seen) (Left "structural cycle")); do { v <- (S.maybe (Left "missing node") return (IM.lookup n (nodes g))); (let { child = (kind (IS.insert n seen)) } in (case (tag v) of { GBot -> (return Star); (GBotK k) -> (return k); (GTyCon _ k) -> (return k); (GSkolem _ k) -> (return k); (GGen s) -> (child s); (GArr a b) -> do { ka <- (child a); do { kb <- (child b); do { (S.unless ((H.eq ka Star) && (H.eq kb Star)) (Left "arrow kind")); (return Star) } } }; (GCon _ ns) -> do { ks <- (S.mapM child ns); do { (S.unless (S.all (\section1 -> (H.eq section1 Star)) ks) (Left "constructor kind")); (return Star) } }; (GTyApp f a) -> do { kf <- (child f); do { ka <- (child a); (applyKind kf ka) } } })) } }) } in do { (H.mapM_ (kind IS.empty) (IM.keys (nodes g))); do { (S.unless (H.eq (H.length (S.concatMap (\v -> (if (H.eq (binder v) Nothing) then ((:) () []) else [])) (IM.elems (nodes g)))) 1) (Left "roots")); do { ((H.forM_ (IM.toList (nodes g))) (\((,) n v) -> do { (bindingPath IS.empty n); (case (binder v) of { Nothing -> (case (tag v) of { (GGen _) -> (return ()); _ -> (Left "root tag") }); (Just b) -> (case (tag (nodeAt g b)) of { (GGen _) -> (return ()); _ -> (S.unless (IS.member n (reachable g b)) (Left "containment")) }) }) })); ((H.forM_ (IM.toList (nodes g))) (\((,) p v) -> do { (case (tag v) of { (GGen _) -> (S.unless (H.eq (flag v) Flexible) (Left "gen flag")); _ -> (return ()) }); ((H.forM_ (children (tag v))) (\c -> do { (case (tag (nodeAt g c)) of { (GGen _) -> (Left "gen child"); _ -> (return ()) }); (case (binder (nodeAt g c)) of { (Just b) -> (S.unless ((H.eq b p) || (underBinder g p b)) (Left "domination")); Nothing -> (Left "unbound child") }) })) })) } } }))
