module Tests.GraphValidation where
-- Select the standard Monad used by shared Either; retain legacy guest syntax.
import Prelude hiding (Monad, return, bind)
import MLF.Primitive (Monad, return, bind)
import Bootstrap.Types
import qualified Bootstrap.Std as S
import qualified Package.OS as OS
import qualified Tests.Helpers as H
import Tests.Helpers (Quint(..), Sext(..))
import qualified Bootstrap.IntMap as IM
import qualified Bootstrap.IntSet as IS
import Tests.Graph
import Bootstrap.Kind
import qualified Tests.Graph as G

graphValidationTests : (List ( (Pair (String) (IO Unit)) ))
graphValidationTests = (Cons (Pair "graph validation agrees with uncached reference" (let { graphs = smallGraphs } in (let { accepted = (H.length (S.filter (S.compose S.isRight referenceValidation) graphs)) } in do { (S.unless ((accepted > 25) && (accepted < (H.length graphs))) (H.fail (H.append "vacuous graph corpus: " (H.append (H.show accepted) " valid")))); do { ((H.forM_ graphs) (\g -> (S.unless (H.eq (S.isRight (validateGraph g)) (S.isRight (referenceValidation g))) (H.fail (H.append "graph validation disagrees with reference: " (H.show g)))))); (putStrLn (H.append "Graph validation: " (H.append (H.show (H.length graphs)) (H.append " graphs; " (H.append (H.show accepted) " valid"))))) } }))) (Cons (Pair "graph validation checks deeply nested binding scopes" (let { g = (nestedGraph 1000) } in do { (S.either H.fail return (validateGraph g)); (let { small = nestedGraph 3; invalid = (Graph (IM.adjust (\v -> (Node (GArr 2 3) (G.binder v) (G.flag v))) 1 (nodes small)) (G.links small) (G.nextId small)) } in do { S.either H.fail return (validateGraph small); S.unless (S.not (S.isRight (validateGraph invalid)) && S.not (S.isRight (referenceValidation invalid))) (H.fail "accepted scope escape") }) })) (Cons (Pair "graph validation checks shared higher-kinded subgraphs" (let { g = (Graph (IM.fromList (Cons (Pair 0 (Node (GGen 1) Nothing Flexible)) (Cons (Pair 1 (Node (GArr 2 2) (Just 0) Rigid)) (Cons (Pair 2 (Node (GTyApp 3 4) (Just 1) Rigid)) (Cons (Pair 3 (Node (GTyCon "F" (KArrow Star Star)) (Just 2) Rigid)) (Cons (Pair 4 (Node GBot (Just 2) Flexible)) Nil)))))) IM.empty 5) } in do { (S.either H.fail return (validateGraph g)); (let { invalid = (Graph (IM.adjust (\v -> (Node (GBotK (KArrow Star Star)) (G.binder v) (G.flag v))) 4 (nodes g)) (G.links g) (G.nextId g)) } in (S.unless (S.not (S.isRight (validateGraph invalid))) (H.fail "accepted kind mismatch"))) })) Nil)))

smallGraphs : (List ( Graph ))
smallGraphs = (S.concatMap (\top -> (S.concatMap (\left -> (S.concatMap (\right -> (S.concatMap (\parent -> (S.concatMap (\leftParent -> (S.concatMap (\rightParent -> (S.concatMap (\aliases -> (Cons (Graph (IM.fromList (Cons (Pair 0 (Node (GGen 1) Nothing Flexible)) (Cons (Pair 1 (Node top parent Flexible)) (Cons (Pair 2 (Node left leftParent Flexible)) (Cons (Pair 3 (Node right rightParent Rigid)) Nil))))) aliases 6) Nil)) (Cons IM.empty (Cons (IM.fromList (Cons (Pair 5 4) (Cons (Pair 4 2) Nil))) Nil)))) (Cons Nothing (Cons (Just 0) (Cons (Just 1) (Cons (Just 2) (Cons (Just 9) Nil))))))) (Cons Nothing (Cons (Just 0) (Cons (Just 1) (Cons (Just 3) (Cons (Just 9) Nil))))))) (Cons Nothing (Cons (Just 0) (Cons (Just 2) Nil))))) (Cons GBot (Cons (GTyCon "G" (KArrow Star Star)) (Cons (GArr 2 2) (Cons (GArr 9 9) Nil)))))) (Cons GBot (Cons (GTyCon "F" (KArrow Star Star)) (Cons (GArr 3 3) (Cons (GGen 3) Nil)))))) (Cons (GArr 2 3) (Cons (GArr 2 2) (Cons (GTyApp 2 3) (Cons (GCon "Pair" (Cons 2 (Cons 3 Nil))) (Cons (GArr 5 3) Nil))))))

nestedGraph : Int -> Graph
nestedGraph depth = (Graph (IM.fromList (Cons (Pair 0 (Node (GGen 1) Nothing Flexible)) (S.concatMap (\n -> (Cons (Pair n (Node (if (H.eq n depth) then GBot else (GArr (n + 1) (n + 1))) (Just (n - 1)) Flexible)) Nil)) (S.range 1 depth)))) IM.empty (depth + 1))

referenceValidation : Graph -> Either String Unit
referenceValidation g = (let rec { bindingPath : IntSet -> Int -> Either String Unit; bindingPath seen n = (if (IS.member n seen) then (Left "binding cycle") else (if true then do { v <- (S.maybe (Left "missing binder") return (IM.lookup n (nodes g))); (S.maybe (return Unit) (bindingPath (IS.insert n seen)) (binder v)) } else (panic "non-exhaustive test guard"))) } in (let rec { kind : IntSet -> Int -> Either String Kind; kind seen original = (let { n = (resolve g original) } in do { (S.unless (IS.notMember n seen) (Left "structural cycle")); do { v <- (S.maybe (Left "missing node") return (IM.lookup n (nodes g))); (let { child = (kind (IS.insert n seen)) } in (case (tag v) of { GBot -> (return Star); (GBotK k) -> (return k); (GTyCon _ k) -> (return k); (GSkolem _ k) -> (return k); (GGen s) -> (child s); (GArr a b) -> do { ka <- (child a); do { kb <- (child b); do { (S.unless ((H.eq ka Star) && (H.eq kb Star)) (Left "arrow kind")); (return Star) } } }; (GCon _ ns) -> do { ks <- (S.mapM child ns); do { (S.unless (S.all (\section1 -> (H.eq section1 Star)) ks) (Left "constructor kind")); (return Star) } }; (GTyApp f a) -> do { kf <- (child f); do { ka <- (child a); (applyKind kf ka) } } })) } }) } in do { (H.mapM_ (kind IS.empty) (IM.keys (nodes g))); do { (S.unless (H.eq (H.length (S.concatMap (\v -> (if (H.eq (binder v) Nothing) then (Cons Unit Nil) else Nil)) (IM.elems (nodes g)))) 1) (Left "roots")); do { ((H.forM_ (IM.toList (nodes g))) (\(Pair n v) -> do { (bindingPath IS.empty n); (case (binder v) of { Nothing -> (case (tag v) of { (GGen _) -> (return Unit); _ -> (Left "root tag") }); (Just b) -> (case (tag (nodeAt g b)) of { (GGen _) -> (return Unit); _ -> (S.unless (IS.member n (reachable g b)) (Left "containment")) }) }) })); ((H.forM_ (IM.toList (nodes g))) (\(Pair p v) -> do { (case (tag v) of { (GGen _) -> (S.unless (H.eq (flag v) Flexible) (Left "gen flag")); _ -> (return Unit) }); ((H.forM_ (children (tag v))) (\c -> do { (case (tag (nodeAt g c)) of { (GGen _) -> (Left "gen child"); _ -> (return Unit) }); (case (binder (nodeAt g c)) of { (Just b) -> (S.unless ((H.eq b p) || (underBinder g p b)) (Left "domination")); Nothing -> (Left "unbound child") }) })) })) } } }))
