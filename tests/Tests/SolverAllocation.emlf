module Tests.SolverAllocation where
import Bootstrap.Types
import qualified Bootstrap.Std as S
import qualified Bootstrap.IntMap as IM
import qualified Bootstrap.Graph as G
import qualified Bootstrap.Graph.Solver as Solver
import qualified Tests.Graph as Reference
import qualified Tests.GraphSolver as R
import qualified Tests.Helpers as H

suite : [] ((,) String (IO ()))
suite = (:) ((,) "strict graph builder agrees with independent insertion" builders)
 ((:) ((,) "node forcing preserves arbitrary identities and lazy constructor fields" nodeDemand)
 ((:) ((,) "graph expansion preserves independent allocation and frontier identities" expansions) []))

checkBuilder count offset = do
 let entries = S.map (\i -> (,) (offset + i * 3) (Node (GArr (offset + i) (offset - i)) (Just (offset + i + 1)) (if remInt i 2 == 0 then Flexible else Rigid))) (S.range 0 (count - 1))
 let expected = S.foldlStrict (\table ((,) key value) -> IM.insert key value table) IM.empty entries
 let actual = G.nodesFromDistinctAscList entries
 H.assert (IM.valid actual && IM.eqIntMap G.equalNode actual expected) "strict sorted graph construction changed nodes or map balance"
builders : IO ()
builders = do
 checkBuilder 0 0
 S.mapM_ (\count -> S.mapM_ (checkBuilder count) ((:) (-1152921504606846976) ((:) 0 ((:) 1152921504606846976 [])))) ((:) 1 ((:) 2 ((:) 3 ((:) 17 []))))
 checkBuilder 257 0
 checkBuilder 4096 0

nodeDemand : IO ()
nodeDemand = do
 let lazyNode = G.strictNode (Node (GCon "Lazy" (panic "forced constructor child list")) (Just (panic "forced optional binder contents")) Flexible)
 let lazyTable = G.nodesFromDistinctAscList ((:) ((,) 42 lazyNode) [])
 H.assert (IM.size lazyTable == 1 && G.equalFlag (G.flag (IM.get 42 lazyTable)) Flexible) "graph node demand changed"
 let graph = G.strictGraph (Graph (IM.singleton 42 (panic "forced graph map value")) IM.empty 1152921504606846976)
 H.assert (G.nextId graph == 1152921504606846976 && IM.size (G.nodes graph) == 1) "graph wrapper forcing changed"
 let scopes = Solver.strictScopes (ScopeIndex IM.empty ((:) (panic "forced unused scope jump") []))
 H.assert (IM.null (Solver.scopeIntervals scopes)) "scope wrapper forcing changed"
 S.mapM_ (\node -> H.assert (G.equalNode node (G.strictNode node)) "forcing changed a graph node")
  ((:) (Node (GArr (-1152921504606846976) 1152921504606846976) Nothing Rigid)
  ((:) (Node (GTyApp 0 4611686018427387921) (Just 7) Flexible)
  ((:) (Node (GGen 1152921504606846976) Nothing Flexible) [])))

expansions : IO ()
expansions = S.mapM_ (\next -> S.mapM_ (\source -> do
 let original = Graph (G.nodes R.scopedGraph) (G.links R.scopedGraph) next
 (,) expected expectedGraph <- H.right (Reference.runBuild original (R.referenceExpand source 0))
 (,) actual actualGraph <- H.right (G.expand source 0 original)
 H.assert (H.eq expected actual && H.eq expectedGraph actualGraph && IM.valid (G.nodes actualGraph)) "expansion changed graph or identity budget")
 ((:) 2 ((:) 6 [])))
 ((:) 10 ((:) 9223372036854775791 ((:) 1152921504606846976 [])))
