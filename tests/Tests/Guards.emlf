module Tests.Guards where
import Bootstrap.Types
import qualified Bootstrap.Std as S
import qualified Tests.Helpers as H
import Bootstrap.Compiler
import Bootstrap.Parser (parseExpr, parseProgram)
import qualified Bootstrap.X.Check as C
import qualified Bootstrap.X.Parser as XP
import Bootstrap.X.Pretty (prettyTerm)
import qualified Bootstrap.X.Syntax as X
import qualified Bootstrap.X.Type as T

sameExpr : String -> String -> String -> (,) String (IO ())
sameExpr label guarded ordinary = (,) ("guards parser: " ++ label) (do
  actual <- H.right (parseExpr "<guards expression>" guarded)
  expected <- H.right (parseExpr "<ordinary conditional>" ordinary)
  H.assert (H.eq actual expected) ("guard lowering changed AST: " ++ H.show actual))

sameProgram : String -> String -> String -> (,) String (IO ())
sameProgram label guarded ordinary = (,) ("guards program: " ++ label) (do
  actual <- H.right (parseProgram "<guards program>" guarded)
  expected <- H.right (parseProgram "<ordinary program>" ordinary)
  H.assert (H.eq actual expected) ("guard lowering changed program: " ++ H.show actual))

programAST : String -> String -> SExpr -> (,) String (IO ())
programAST label source expected = (,) ("guards parser: " ++ label) (do
  actual <- H.right (parseProgram "<guards annotation boundary>" source)
  H.assert (H.eq actual (SProgram [] expected)) (H.show actual))

conditional : SExpr -> SExpr -> SExpr -> SExpr
conditional condition yes no = SApp (SApp (SApp (SPrimitive PIfThenElse) condition) yes) no

hasType : String -> String -> XType -> (,) String (IO ())
hasType label source expected = (,) ("guards checking: " ++ label) (do
  result <- H.right (compile "<guards test>" source)
  term <- H.right (XP.parseTerm "<guards xMLF>" (prettyTerm (compiledTerm result)))
  actual <- H.right (C.checkClosed term)
  H.assert (T.alphaEq actual expected && T.alphaEq actual (inferredType result)) ("wrong type: " ++ sourceType result)
  H.assert (H.eq (X.erase term) (X.erase (compiledTerm result))) "xMLF round trip changed erasure")

rejects : String -> String -> Phase -> String -> (,) String (IO ())
rejects label source expectedPhase reason = (,) ("guards rejection: " ++ label) (case compile "<invalid guards>" source of
  Left err -> H.assert (H.eq (phase err) expectedPhase && H.contains reason (diagnostic err)) ("wrong rejection: " ++ H.show err)
  Right result -> H.fail ("unexpected acceptance: " ++ sourceType result))

int : XType
int = XCon "Int" []

bool : XType
bool = XCon "Bool" []

ioUnit : XType
ioUnit = XCon "IO" ((:) (XCon "Unit" []) [])

guardTests : [] ((,) String (IO ()))
guardTests = S.append parserTests (S.append checkingTests (S.append rejectionTests
  (S.map (\((,,,) label source _ _) -> hasType label source ioUnit) guardPrograms)))

parserTests : [] ((,) String (IO ()))
parserTests = (:)
  (sameExpr "ordered expression arms" "if { | a -> x; | b -> y; | otherwise -> z }" "if a then x else if b then y else z") ((:)
  (sameExpr "fallback-only expression" "if { | otherwise -> 42 }" "42") ((:)
  (sameExpr "expression trailing separator" "if { | false -> 0; | otherwise -> 42; }" "if false then 0 else 42") ((:)
  (sameExpr "nested expression arms" "if { | a -> if { | b -> x; | otherwise -> y }; | otherwise -> z }" "if a then if b then x else y else z") ((:)
  (sameExpr "ordinary if inside guarded branches" "if { | a -> if b then x else y; | otherwise -> if c then z else w }" "if a then if b then x else y else if c then z else w") ((:)
  (sameExpr "arithmetic and Boolean precedence" "1 + if { | a || b && c -> 2 * x; | otherwise -> y + 3 }" "1 + if a || b && c then 2 * x else y + 3") ((:)
  (sameExpr "otherwise call remains a condition" "if { | otherwise x -> 42; | otherwise -> 0 }" "if otherwise x then 42 else 0") ((:)
  (sameExpr "qualified otherwise remains a condition" "if { | M.otherwise x -> 42; | otherwise -> 0 }" "if M.otherwise x then 42 else 0") ((:)
  (sameExpr "parenthesized otherwise remains a condition" "if { | (otherwise) -> 42; | otherwise -> 0 }" "if otherwise then 42 else 0") ((:)
  (sameProgram "function guard layout" "choose x\n  | x < 0 = 0\n  | x == 0 = 1\n  | otherwise = x\nmain = choose 42\n" "choose x = if x < 0 then 0 else if x == 0 then 1 else x; main = choose 42;") ((:)
  (sameProgram "function guard nested block layout" "choose x\n  | x > 0 = case x of\n      n -> n\n  | otherwise = 0\nmain = choose 42\n" "choose x = if x > 0 then case x of { n -> n } else 0; main = choose 42;") ((:)
  (sameProgram "expression guard inside ordinary then-do layout" "main = if true then do\n  if { | true -> printInt 42; | otherwise -> printInt 0 }\nelse printInt 1\n" "main = if true then do { if true then printInt 42 else printInt 0 } else printInt 1;") ((:)
  (sameProgram "ordinary if identifier compatibility" "otherwise = false; otherwiseValue = true; main = if otherwise then 0 else if otherwiseValue then 42 else 1;" "otherwise = false; otherwiseValue = true; main = if otherwise then 0 else if otherwiseValue then 42 else 1;") ((:)
  (programAST "legacy annotation in RHS before bar" "f x | true = x :: Int | otherwise = 0; f 42"
    (SLet "f" (SLam "x" Nothing (conditional (SBoolLit true)
      (SAnn (SVar "x") (SAnnotation [] (SCon "Int" []))) (SIntLit 0)))
      (SApp (SVar "f") (SIntLit 42)))) ((:)
  (programAST "legacy annotation in condition before equals" "g flag | flag :: Bool = 1 | otherwise = 0; g true"
    (SLet "g" (SLam "flag" Nothing (conditional
      (SAnn (SVar "flag") (SAnnotation [] (SCon "Bool" []))) (SIntLit 1) (SIntLit 0)))
      (SApp (SVar "g") (SBoolLit true)))) ((:)
  ((,) "guards parser: diagnostics keep original line and column" (case parseExpr "guards-position.emlf" "if {\n  | true -> 1;\n  | otherwise -> )\n}" of
    Left err -> H.assert (H.contains "guards-position.emlf:3:18:" err) err
    Right parsed -> H.fail (H.show parsed)))
  [])))))))))))))))

checkingTests : [] ((,) String (IO ()))
checkingTests = (:)
  (hasType "guarded values generalize" "pick | true = (\\x -> x) | otherwise = (\\x -> x); n = pick 1; main = pick true;" bool) ((:)
  (hasType "separate whole-function signature" "choose : Int -> Int; choose x | x > 0 = x | otherwise = 0; main = choose 42;" int) ((:)
  (hasType "inline whole-function signature" "choose x : Int -> Int | x > 0 = x | otherwise = 0; main = choose 42;" int) ((:)
  (hasType "annotated parameter" "apply (f : forall a. a -> a) | true = f 42 | otherwise = f 0; main = apply (\\x -> x);" int) ((:)
  (hasType "local guard sees outer binding" "let offset = 2 in let choose x | x > 0 = x + offset | otherwise = offset in choose 40" int) ((:)
  (hasType "pattern binders scope over guards and results" "data Maybe a = Nothing | Just a; choose (Just n) | n > 0 = n | otherwise = 0; choose Nothing = -1; main = choose (Just 42);" int) ((:)
  (hasType "guard condition can contain an expression guard" "if { | if { | false -> false; | otherwise -> true } -> 42; | otherwise -> 0 }" int) ((:)
  (hasType "unselected branches preserve polymorphism" "id x = x; main = (if { | false -> id; | otherwise -> id }) 42;" int) ((:)
  ((,) "guards checking: no implicit prelude required" (do
    result <- H.right (compileWithPrelude NoImplicitPrelude "<guards without prelude>" "choose x | x > 0 = x | otherwise = 0; main = if { | true -> choose 42; | otherwise -> 0 };")
    H.assert (T.alphaEq (inferredType result) int) (sourceType result)))
  []))))))))

rejectionTests : [] ((,) String (IO ()))
rejectionTests = (:)
  (rejects "expression condition requires Bool" "if { | 1 -> 42; | otherwise -> 0 }" Inference "type constructor mismatch") ((:)
  (rejects "function condition requires Bool" "choose x | x = 42 | otherwise = 0; main = choose 1;" Inference "type constructor mismatch") ((:)
  (rejects "all result types agree" "if { | true -> 42; | otherwise -> false }" Inference "type constructor mismatch") ((:)
  (rejects "unselected condition is checked" "if { | true -> 42; | 1 -> 0; | otherwise -> 0 }" Inference "type constructor mismatch") ((:)
  (rejects "pattern coverage remains exhaustive" "data Maybe a = Nothing | Just a; choose (Just n) | n > 0 = n | otherwise = 0; main = choose (Just 42);" Inference "non-exhaustive") ((:)
  (rejects "total guards do not fall through to another equation" "choose x | x > 0 = 1 | otherwise = 2; choose y = 3; main = choose 0;" Inference "unreachable") ((:)
  (rejects "pattern binder does not enter sibling equation" "data Maybe a = Nothing | Just a; choose (Just n) | n > 0 = n | otherwise = 0; choose Nothing | n > 0 = 1 | otherwise = 2; main = choose Nothing;" Inference "unbound variable: n") ((:)
  (rejects "pattern binder does not escape function" "data Box = Box Int; choose (Box n) | n > 0 = n | otherwise = 0; main = n;" Inference "unbound variable: n") ((:)
  (rejects "branch binding does not enter sibling guard" "if { | false -> let n = 1 in n; | n > 0 -> 2; | otherwise -> 0 }" Inference "unbound variable: n") ((:)
  (rejects "expression fallback required" "if { | true -> 42 }" Parsing "guard block requires a final otherwise branch") ((:)
  (rejects "function fallback required" "choose x | x > 0 = x; main = choose 42;" Parsing "guard block requires a final otherwise branch") ((:)
  (rejects "expression fallback must be last" "if { | otherwise -> 42; | true -> 0 }" Parsing "otherwise must be the final guard branch") ((:)
  (rejects "function fallback must be last" "choose x | otherwise = 42 | x > 0 = 0; main = choose 1;" Parsing "otherwise must be the final guard branch") ((:)
  (rejects "duplicate expression fallback" "if { | false -> 0; | otherwise -> 42; | otherwise -> 1 }" Parsing "otherwise must be the final guard branch") ((:)
  (rejects "duplicate function fallback" "choose x | false = 0 | otherwise = 42 | otherwise = 1; main = choose 1;" Parsing "otherwise must be the final guard branch") ((:)
  (rejects "empty expression block" "if {}" Parsing "guard block requires a final otherwise branch") ((:)
  (rejects "expression arm requires arrow" "if { | true = 42; | otherwise -> 0 }" Parsing "-> after guard condition") ((:)
  (rejects "function arm requires equals" "choose x | true -> 42 | otherwise = 0; main = choose 1;" Parsing "= after guard condition") ((:)
  (rejects "expression arm requires result" "if { | true -> ; | otherwise -> 0 }" Parsing "") ((:)
  (rejects "comma guards are not accepted" "if { | true, false -> 42; | otherwise -> 0 }" Parsing "") ((:)
  (rejects "pattern guards are not accepted" "data Maybe a = Nothing | Just a; main = if { | Just n <- Just 42 -> n; | otherwise -> 0 };" Parsing "") ((:)
  (rejects "expression guard block needs braces" "if | true -> 42 | otherwise -> 0" Parsing "")
  [])))))))))))))))))))))

guardPrograms : [] ((,,,) String String ([] String) String)
guardPrograms = (:)
  ((,,,) "guards runtime: first match and short circuit" (S.unlines ((:)
    "spinInt : Int" ((:)
    "spinInt = spinInt" ((:)
    "spinBool : Bool" ((:)
    "spinBool = spinBool" ((:)
    "choose n | n >= 0 = 10 | n > 10 = 20 | otherwise = 30" ((:)
    "main = do" ((:)
    "  printInt (choose 20)" ((:)
    "  printInt (choose (-1))" ((:)
    "  printInt (if { | true -> 42; | spinBool -> 0; | otherwise -> 1 })" ((:)
    "  printInt (if { | false && spinBool -> 0; | true || spinBool -> 7; | otherwise -> spinInt })" ((:)
    "  printInt (if { | false -> spinInt; | otherwise -> 9 })"
    [])))))))))))) [] "10\n30\n42\n7\n9\n") ((:)
  ((,,,) "guards runtime: only selected IO executes" (S.unlines ((:)
    "choose flag" ((:)
    "  | flag = do" ((:)
    "      putStrLn \"selected\"" ((:)
    "      printInt 42" ((:)
    "  | otherwise = do" ((:)
    "      putStrLn \"fallback\"" ((:)
    "      printInt 7" ((:)
    "main = do" ((:)
    "  choose true" ((:)
    "  if { | false -> putStrLn \"wrong\"; | true -> putStrLn \"yes\"; | otherwise -> putStrLn \"wrong fallback\" }" ((:)
    "  choose false"
    [])))))))))))) [] "selected\n42\nyes\nfallback\n7\n") ((:)
  ((,,,) "guards runtime: local and recursive bindings" (S.unlines ((:)
    "fact : Int -> Int" ((:)
    "fact n | n == 0 = 1 | otherwise = n * fact (n - 1)" ((:)
    "main = do" ((:)
    "  let offset = 1" ((:)
    "  let choose x | x > 0 = x + offset | otherwise = offset" ((:)
    "  printInt (choose 41)" ((:)
    "  let rec" ((:)
    "    sum : Int -> Int" ((:)
    "    sum n" ((:)
    "      | n == 0 = 0" ((:)
    "      | otherwise = n + sum (n - 1)" ((:)
    "  printInt (sum 4)" ((:)
    "  printInt (fact 5)" ((:)
    "  printInt (let clip x | x > 10 = 10 | otherwise = x in clip 12)"
    []))))))))))))))) [] "42\n10\n120\n10\n") ((:)
  ((,,,) "guards runtime: patterns and instance methods" (S.unlines ((:)
    "data Maybe a = Nothing | Just a" ((:)
    "class Classify a where" ((:)
    "  classify : a -> Int" ((:)
    "instance Classify (Maybe Int) where" ((:)
    "  classify (Just n)" ((:)
    "    | n > 0 = n" ((:)
    "    | otherwise = 0" ((:)
    "  classify Nothing = -1" ((:)
    "main = do" ((:)
    "  printInt (classify (Just 42))" ((:)
    "  printInt (classify (Just (-1)))" ((:)
    "  printInt (classify (Nothing :: Maybe Int))"
    []))))))))))))) [] "42\n0\n-1\n") ((:)
  ((,,,) "guards runtime: nested ordinary and guarded conditionals" (S.unlines ((:)
    "main = do" ((:)
    "  if true then do" ((:)
    "    if { | false -> printInt 0; | otherwise -> printInt 42 }" ((:)
    "  else printInt 1" ((:)
    "  if (if { | false -> false; | otherwise -> true }) then printInt 7 else printInt 0" ((:)
    "  printInt (if { | true -> if false then 0 else 8; | otherwise -> 0 })" ((:)
    "  printInt (if { | false -> 0; | otherwise -> if { | false -> 1; | otherwise -> 9 } })" ((:)
    "  if if { | false -> false; | otherwise -> true } then do" ((:)
    "    printInt 10" ((:)
    "  else printInt 0" ((:)
    "  if false then printInt 0 else do" ((:)
    "    if { | false -> printInt 0; | otherwise -> printInt 11 }" ((:)
    "    printInt 12" ((:)
    "  printInt 13"
    []))))))))))))))) [] "42\n7\n8\n9\n10\n11\n12\n13\n") ((:)
  ((,,,) "guards runtime: case bodies and lazy wildcard" (S.unlines ((:)
    "data Box = Box Int" ((:)
    "spin : Box" ((:)
    "spin = spin" ((:)
    "choose _ flag | flag = 42 | otherwise = 0" ((:)
    "read box" ((:)
    "  | true = case box of" ((:)
    "      Box n -> n" ((:)
    "  | otherwise = 0" ((:)
    "main = do" ((:)
    "  printInt (choose spin true)" ((:)
    "  printInt (read (Box 7))"
    [])))))))))))) [] "42\n7\n") ((:)
  ((,,,) "guards runtime: contextual otherwise compatibility" (S.unlines ((:)
    "otherwise x = x > 0" ((:)
    "otherwiseValue = true" ((:)
    "choose x | otherwise x = 42 | otherwise = 0" ((:)
    "chooseFlag otherwise | (otherwise) = 1 | otherwise = 2" ((:)
    "main = do" ((:)
    "  printInt (choose 1)" ((:)
    "  printInt (choose 0)" ((:)
    "  printInt (if otherwiseValue then 7 else 8)" ((:)
    "  printInt (let otherwise = false in if otherwise then 0 else 9)" ((:)
    "  printInt (chooseFlag false)"
    []))))))))))) [] "42\n0\n7\n9\n2\n") ((:)
  ((,,,) "guards runtime: dynamic selection and primitive hygiene" (S.unlines ((:)
    "ifThenElse condition yes no = no" ((:)
    "choose n | n < 0 = 0 | n == 20 = 42 | 1 / 0 == 0 = 1 | otherwise = 2" ((:)
    "main = do" ((:)
    "  line <- getLine" ((:)
    "  let n = readInt line" ((:)
    "  printInt (choose n)" ((:)
    "  if { | n < 0 -> do { ignored <- getLine; putStrLn ignored }; | n == 20 -> putStrLn \"selected\"; | 1 / 0 == 0 -> putStrLn \"wrong\"; | otherwise -> do { ignored <- getLine; putStrLn ignored } }" ((:)
    "  printInt (ifThenElse true 42 0)"
    []))))))))) ((:) "20" []) "42\nselected\n0\n")
  [])))))))
