module Tests.EnvironmentAccess where
import Bootstrap.Types
import qualified Bootstrap.Std as S
import qualified Package.OS as OS
import qualified Tests.Helpers as H
import Tests.Helpers (Quint(..), Sext(..))
import qualified Tests.Map as Map
import Tests.Backends
import qualified Tests.Backends as B
import Bootstrap.Compiler (compile, compiledTerm)
import Bootstrap.LLVM (emitLLVMIO)
import qualified Bootstrap.Data as D
import qualified Bootstrap.LLVM.Codegen as Codegen
import qualified Bootstrap.X.Check as Check
import qualified Bootstrap.X.Syntax as X

checked : String -> IO XTerm
checked = (S.compose (S.either (S.compose H.fail H.show) (S.compose return compiledTerm)) (compile "<environment slots>"))

observe : B.Backends -> XTerm -> String -> IO Unit
observe backends term expected = do { result <- (B.execute backends IOEntry (Input "" false) term); do { (S.either (S.compose H.fail H.show) return (B.outcome result)); (S.unless (H.eq (B.output result) expected) (H.fail (H.show result))) } }

directSlots : String -> Bool
directSlots code = ((S.not (H.contains "call ptr @mlf_env_get(" code)) && ((S.not (H.contains "call void @mlf_env_set(" code)) && ((H.contains "store ptr " code) && ((H.contains "load ptr," code) && (H.contains "getelementptr i8, ptr %env, i64 24" code)))))

originalEnvironmentAccessTests : B.Backends -> (List ( (Pair (String) (IO Unit)) ))
originalEnvironmentAccessTests backends = (Cons (Pair "environment slots: curried captures and constructor fields remain lazy" do { term <- (checked lazySource); do { _ <- (S.either H.fail return (Check.checkClosed term)); (let { declarations = (case term of { (XWithData ds _) -> ds; _ -> Nil }) } in (let { constructors = (Map.fromList (Cons (Pair "Unit" (Pair 0 0)) (S.concatMap (\(Pair i c) -> (Cons (Pair (D.constructorName c) (Pair i (H.length (D.constructorFields c)))) Nil)) (S.zip (S.range 1 9223372036854775807) (H.concatMap D.datatypeConstructors declarations))))) } in do { (Pair _ code) <- (S.either H.fail return (Codegen.generate constructors (X.erase term))); (let { llvm = (S.unlines code) } in do { (S.unless ((directSlots llvm) && ((H.contains "call ptr @mlf_constructor_new(" llvm) && ((H.contains "call ptr @mlf_closure(" llvm) && (H.contains "call ptr @mlf_thunk(" llvm)))) (H.fail "fixture did not directly initialize/read closure, thunk, and constructor environments")); (observe backends term "19\n42\n43\n") }) })) } }) (Cons (Pair "environment slots: repeated native action preserves captures and laziness" do { term <- (checked nativeSource); do { llvm <- (S.either H.fail return (emitLLVMIO term)); (let { entries = (S.concatMap (\comprehension2 -> case comprehension2 of { (Cons line body) -> (if (OS.starts "define private ptr @mlf.numeric.entry." line) then (Cons (S.unlines (S.takeWhile (\section1 -> (S.not (H.eq section1 "}"))) body)) Nil) else Nil); _ -> Nil }) (H.tails (H.lines llvm))) } in do { (S.unless ((directSlots llvm) && ((S.any (\section3 -> (H.contains "getelementptr i8, ptr %env, i64 24" section3)) entries) && (H.contains "call ptr @mlf_native_io(" llvm))) (H.fail "fixture did not retain a native action with direct capture slots")); (observe backends term "before\n42\n42\n7\n") }) } }) Nil))

lazySource : String
lazySource = (H.append "data Cell = Cell Int Int (Int -> Int); " (H.append "let make = \\base extra ignored -> let add = \\delta -> base + extra + delta in Cell base ignored add in " (H.append "do { base <- ioReturn (readInt \"19\"); partial <- ioReturn (make base 3); " (H.append "cell <- ioReturn (partial (panic \"unused constructor field\")); " "case cell of { Cell first _ add -> do { printInt first; printInt (add 20); printInt (add 21) } } }"))))

nativeSource : String
nativeSource = (H.append "do { base <- ioReturn (readInt \"19\"); " (H.append "let make = \\n -> ioReturn (base + n + 1 + 1 + 1 + 1 + 1 + 1) in " (H.append "do { action <- ioReturn (make 17); " (H.append "putStrLn \"before\"; first <- action; printInt first; second <- action; printInt second; " "unused <- ioReturn (make (panic \"unused native argument\")); printInt 7 } }"))))

-- The largest batched capture environment and its first spill both preserve
-- every captured value and the shared update after the first projection.
captureBoundarySource count =
 let names = S.map (\i -> "a" ++ showInt i) (S.range 1 count) in
 "data Box = Box Int Int; make " ++ S.intercalate " " names ++
 " = let value = " ++ S.intercalate " + " names ++ " in Box value value; main = do { input <- getLine; let base = readInt input; let box = make " ++
 S.intercalate " " (S.map (\i -> if i == 0 then "base" else "(base + " ++ showInt i ++ ")") (S.range 0 (count - 1))) ++
 "; case box of { Box first second -> do { printInt first; printInt second } } };"

environmentAccessTests backends = S.append (originalEnvironmentAccessTests backends)
 (S.map (\count -> Pair ("environment slots: captured thunk boundary " ++ showInt count) (do
  term <- checked (captureBoundarySource count)
  result <- B.execute backends IOEntry (Input "19\n" false) term
  S.either (S.compose H.fail H.show) return (B.outcome result)
  let answer = showInt (19 * count + quotInt (count * (count - 1)) 2) ++ "\n"
  H.assert (eqString (B.output result) (answer ++ answer) && H.null (B.remaining result)) "captured thunk lost a field or changed its shared update")) (Cons 28 (Cons 29 Nil)))
