module Tests.TupleListLegacy where

-- Keep the harness itself in the released syntax. The strings below exercise
-- the checkout parser; fixed ASTs and types are independent expectations.
import Bootstrap.Types
import qualified Bootstrap.Std as S
import qualified Bootstrap.Map as M
import qualified Bootstrap.Parser as Parser
import qualified Bootstrap.Parsec as Parsec
import qualified Bootstrap.SourceEquality as Equality
import qualified Bootstrap.Compiler as Compiler
import qualified Bootstrap.Runtime as Runtime
import qualified Bootstrap.X.Check as Check
import qualified Bootstrap.X.Parser as TargetParser
import qualified Bootstrap.X.Pretty as Pretty
import qualified Bootstrap.X.Syntax as X
import qualified Tests.IndependentCheck as Independent
import qualified Tests.IndependentType as IndependentType

fatal : forall a. String -> IO a
fatal message = do { putErr ("Tuple/list failure: " ++ message ++ "\n"); exitWith 1 }
require : Bool -> String -> IO Unit
require condition message = if condition then ioReturn Unit else fatal message
right : forall a. Either String a -> IO a
right result = case result of { Left error -> fatal error; Right value -> ioReturn value }
compiled : Either CompileError Compiler.Compilation -> IO Compiler.Compilation
compiled result = case result of { Left error -> fatal (Compiler.prettyError error); Right value -> ioReturn value }
passed : String -> IO Unit
passed label = putStrLn ("PASS tuple/list " ++ label)
contains : String -> String -> Bool
contains needle text = containsAt needle text 0
containsAt : String -> String -> Int -> Bool
containsAt needle text offset = offset + stringLength needle <= stringLength text &&
  (eqString needle (stringSlice text offset (stringLength needle)) || containsAt needle text (offset+1))

one : forall a. a -> List a
one a = Cons a Nil
two : forall a. a -> a -> List a
two a b = Cons a (one b)
three : forall a. a -> a -> a -> List a
three a b c = Cons a (two b c)
apply2 : SExpr -> SExpr -> SExpr -> SExpr
apply2 f a b = SApp (SApp f a) b
pair : SExpr -> SExpr -> SExpr
pair = apply2 (SConstructor "Pair")
cons : SExpr -> SExpr -> SExpr
cons = apply2 (SConstructor "Cons")
nil : SExpr
nil = SConstructor "Nil"
int : XType
int = XCon "Int" Nil
bool : XType
bool = XCon "Bool" Nil
intType : SType
intType = SCon "Int" Nil
boolType : SType
boolType = SCon "Bool" Nil

sameExpression : String -> String -> SExpr -> IO Unit
sameExpression label source expected = do
 actual <- right (Parser.parseExpr "tuple-list.emlf" source)
 require (Equality.eqExpr actual expected) (label ++ ": unexpected expression AST")
 passed label
sameBoundary : String -> String -> String -> SExpr -> IO Unit
sameBoundary label delimiter source expected = do
 actual <- right (Parser.parseLayout false (Parsec.pBefore Parser.expr (Parsec.pToken delimiter)) "tuple-list-boundary.emlf" source)
 require (Equality.eqExpr actual expected) (label ++ ": unexpected expression before delimiter")
 passed label
-- A surrounding parser owns these delimiters; no guards grammar is needed.
boundaryChecks : IO Unit
boundaryChecks = do
 sameBoundary "colon annotation before bar" "|" "x : Int |" (SAnn (SVar "x") (SAnnotation Nil intType))
 sameBoundary "colon annotation before equals" "=" "flag : Bool =" (SAnn (SVar "flag") (SAnnotation Nil boolType))
 sameBoundary "explicit annotation before bar" "|" "x :: Int |" (SAnn (SVar "x") (SAnnotation Nil intType))
 sameBoundary "explicit annotation before equals" "=" "flag :: Bool =" (SAnn (SVar "flag") (SAnnotation Nil boolType))
 sameBoundary "lowercase tail remains cons before bar" "|" "x : xs |" (cons (SVar "x") (SVar "xs"))
 sameBoundary "empty tail remains cons before equals" "=" "1 : [] =" (cons (SIntLit 1) nil)
 sameBoundary "closed constructor annotation before bar" "|" "x : Nil |" (SAnn (SVar "x") (SAnnotation Nil (SCon "Nil" Nil)))
sameAnnotation : String -> String -> SType -> IO Unit
sameAnnotation label source expected = do
 actual <- right (Parser.parseAnnotation source)
 require (Equality.eqAnnotation actual (SAnnotation Nil expected)) (label ++ ": unexpected type AST")
 passed label
sameFields : IO Unit
sameFields = do
 actual <- right (Parser.parseModule "fields.emlf" "data Box a = Box [a] (a, Int) (a, Int, Bool) (a, Int, Bool, String); main = 42;")
 let a = Parameter "a"
 let i = Applied "Int" Nil
 let b = Applied "Bool" Nil
 let fields = Cons (Applied "List" (one a)) (Cons (Applied "Pair" (two a i))
       (Cons (Applied "Triple" (three a i b)) (one (Applied "Quad" (Cons a (three i b (Applied "String" Nil)))))))
 let expected = DataDecl "Box" (one "a") (one (ConstructorDecl "Box" fields))
 case actual of
  SourceModule _ _ _ _ (Cons declaration Nil) _ _ _ _ -> require (Equality.eqDataDecl declaration expected) "tuple/list datatype fields"
  _ -> fatal "missing datatype fields"
 passed "datatype field ASTs"

checkResult : String -> XType -> Compiler.Compilation -> IO Unit
checkResult label expected result = do
 require (IndependentType.alphaEq (Compiler.inferredType result) expected) (label ++ ": inferred " ++ Compiler.sourceType result)
 let original = Compiler.compiledTerm result
 term <- right (TargetParser.parseTerm "tuple-list.xmlf" (Pretty.prettyTerm original))
 current <- right (Check.checkClosed term)
 independent <- right (Independent.checkClosed term)
 require (IndependentType.alphaEq current expected && IndependentType.alphaEq independent expected) (label ++ ": checked type mismatch")
 require (X.equalErased (X.erase term) (X.erase original)) (label ++ ": target round trip changed erasure")
 passed label
accepted : String -> String -> XType -> IO Unit
accepted label source expected = do
 result <- compiled (Compiler.compile "tuple-list.emlf" source)
 checkResult label expected result
evaluates : String -> String -> Int -> IO Unit
evaluates label source expected = do
 result <- compiled (Compiler.compile "tuple-list.emlf" source)
 checkResult label int result
 let term = Compiler.compiledTerm result
 prepared <- right (Runtime.prepare false term)
 let environment = case prepared of { Pair dataEnvironment _ -> dataEnvironment }
 value <- right (Runtime.evaluate environment (Runtime.REnv M.empty) (X.erase term))
 case value of
  Runtime.RInteger actual -> require (actual == expected) (label ++ ": runtime value was " ++ showInt actual)
  _ -> fatal (label ++ ": runtime value was not an integer")
 passed (label ++ " runtime")
parseRejected : String -> String -> IO Unit
parseRejected label source = do
 case Parser.parseExpr "tuple-list.emlf" source of
  Left error -> require (contains "tuple-list.emlf:" error) (label ++ ": source location missing")
  Right _ -> fatal (label ++ ": malformed syntax accepted")
 passed label
parseDiagnostic : String -> String -> String -> IO Unit
parseDiagnostic label source expected = do
 case Parser.parseExpr "tuple-list.emlf" source of
  Left error -> require (contains expected error) (label ++ ": " ++ error)
  Right _ -> fatal (label ++ ": malformed syntax accepted")
 passed label
rejected : String -> String -> Phase -> String -> IO Unit
rejected label source phase reason = do
 case Compiler.compile "tuple-list.emlf" source of
  Left error -> require (eqString (Compiler.prettyPhase (Compiler.phase error)) (Compiler.prettyPhase phase) && contains reason (Compiler.diagnostic error)) (label ++ ": " ++ Compiler.prettyError error)
  Right _ -> fatal (label ++ ": invalid program accepted")
 passed label

declarations : String
declarations = "data List a = Nil | Cons a (List a); data Pair a b = Pair a b; data Triple a b c = Triple a b c; data Quad a b c d = Quad a b c d; "

parserChecks : IO Unit
parserChecks = do
 let a = SVar "a"
 let b = SVar "b"
 let c = SVar "c"
 let d = SVar "d"
 sameExpression "pair AST" "(a,b)" (pair a b)
 sameExpression "triple AST" "(a,b,c)" (SApp (apply2 (SConstructor "Triple") a b) c)
 sameExpression "quad AST" "(a,b,c,d)" (SApp (SApp (apply2 (SConstructor "Quad") a b) c) d)
 sameExpression "grouping remains grouping" "(a)" a
 sameExpression "unit remains intrinsic" "()" (SConstructor "Unit")
 sameExpression "empty list AST" "[]" nil
 sameExpression "singleton list AST" "[a]" (cons a nil)
 sameExpression "nested list and tuple AST" "[(a,b), (c,d)]" (cons (pair a b) (cons (pair c d) nil))
 sameExpression "cons associates right" "a : b : c" (cons a (cons b c))
 sameExpression "cons follows addition" "a + b : c" (cons (apply2 (SPrimitive PAddInt) a b) c)
 sameExpression "cons and concatenation share right precedence" "a : b ++ c" (cons a (apply2 (SPrimitive PConcatString) b c))
 sameExpression "concatenation and cons share right precedence" "a ++ b : c" (apply2 (SPrimitive PConcatString) a (cons b c))
 sameExpression "legacy annotation covers addition" "a + b : Int" (SAnn (apply2 (SPrimitive PAddInt) a b) (SAnnotation Nil intType))
 sameExpression "legacy uppercase tail is an annotation" "a : Nil" (SAnn a (SAnnotation Nil (SCon "Nil" Nil)))
 sameExpression "explicit annotation" "[a] :: [Int]" (SAnn (cons a nil) (SAnnotation Nil (SCon "List" (one intType))))
 sameExpression "explicit free annotation still parses" "a :: b" (SAnn a (SAnnotation Nil (STVar "b")))
 sameExpression "case tuple pattern AST" "case a of {(x,y) -> x}" (SCase a (one (SAlternative (SConstructorPattern "Pair" (two (Just "x") (Just "y"))) (SVar "x"))))
 sameExpression "case cons pattern AST" "case a of {x : xs -> x}" (SCase a (one (SAlternative (SConstructorPattern "Cons" (two (Just "x") (Just "xs"))) (SVar "x"))))
 sameExpression "empty pattern AST" "case a of {[] -> b}" (SCase a (one (SAlternative (SConstructorPattern "Nil" Nil) b)))
 sameExpression "list pattern AST" "case a of {[x,y] -> x}" (SCase a (one (SAlternative
   (SNestedPattern "Cons" (two (SDefaultPattern (Just "x"))
     (SNestedPattern "Cons" (two (SDefaultPattern (Just "y")) (SConstructorPattern "Nil" Nil))))) (SVar "x"))))
 sameAnnotation "pair type AST" "(Int,Bool)" (SCon "Pair" (two intType boolType))
 sameAnnotation "triple type AST" "(Int,Bool,Int)" (SCon "Triple" (three intType boolType intType))
 sameAnnotation "list type AST" "[(Int,Bool)]" (SCon "List" (one (SCon "Pair" (two intType boolType))))
 sameAnnotation "function tuple component" "(Int -> Bool, [Int])" (SCon "Pair" (two (SArrow intType boolType) (SCon "List" (one intType))))
 sameFields
 S.mapM_ (\source -> parseRejected ("malformed " ++ source) source)
   (Cons "(a,)" (Cons "(,a)" (Cons "(a,b,c,d,e)" (Cons "[a,]" (Cons "[,a]" (Cons "[a" (Cons "[1..3]" (Cons "[a | a <- b]" (Cons "a :" Nil)))))))))
 parseDiagnostic "ranges have a targeted diagnostic" "[1..3]" "list ranges are not supported"
 parseDiagnostic "comprehensions have a targeted diagnostic" "[a | a <- b]" "list comprehensions are not supported"
 parseDiagnostic "tuple arity has a targeted diagnostic" "(a,b,c,d,e)" "tuple syntax supports two, three or four components"
 parseDiagnostic "malformed list retains exact source position" "[1,\n ]" "tuple-list.emlf:2:2:"

checkingChecks : IO Unit
checkingChecks = do
 accepted "pair inferred and independently checked" (declarations ++ "(42,true)") (XCon "Pair" (two int bool))
 accepted "triple inferred and independently checked" (declarations ++ "(42,true,42)") (XCon "Triple" (three int bool int))
 accepted "quad inferred and independently checked" (declarations ++ "(42,true,42,true)") (XCon "Quad" (Cons int (three bool int bool)))
 accepted "homogeneous list" (declarations ++ "[40,41,42]") (XCon "List" (one int))
 accepted "empty list annotation" (declarations ++ "[] : [Int]") (XCon "List" (one int))
 accepted "cons spine" (declarations ++ "40 : 41 : [42]") (XCon "List" (one int))
 accepted "nested pair/list patterns" (declarations ++ "case [(40,2)] of {[(x,y)] -> x+y; _ -> 0}") int
 accepted "equations and cons parameters" (declarations ++ "head [] = 0; head (x : xs) = x; main = head [42];") int
 accepted "tuple lambda" (declarations ++ "(\\(x,y) -> x+y) (40,2)") int
 accepted "legacy annotated parameter" "(\\(x : Int) -> x+1) 41" int
 accepted "legacy grouped annotated parameter" "(\\((x) : Int) -> x+1) 41" int
 accepted "explicit annotated parameter" "(\\(x :: Int) -> x+1) 41" int
 accepted "explicit grouped annotated parameter" "(\\((x) :: Int) -> x+1) 41" int
 accepted "explicit declaration signature" (declarations ++ "head :: [Int] -> Int; head [] = 0; head (x : xs) = x; main = head [42];") int
 accepted "type sugar in datatype fields" (declarations ++ "data Box = Box [Int] (Int,Int); case Box [42] (40,2) of {Box [x] (y,z) -> x+y+z; _ -> 0}") int
 accepted "do tuple pattern" (declarations ++ "do {(x,y) <- (return (40,2) :: IO (Int,Int)); return (x+y)}") (XCon "IO" (one int))
 accepted "multiline list closes inner case layout" (declarations ++ "\nmain = case [case true of\n  true -> 42\n  false -> 0\n  , 1] of\n  [x,y] -> x+y\n  _ -> 0\n") int
 accepted "multiline list and tuple" (declarations ++ "\nmain = case [\n (40,\n  2)\n ] of\n [(x,y)] -> x+y\n _ -> 0\n") int
 withoutPrelude <- compiled (Compiler.compileWithPrelude NoImplicitPrelude "tuple-list.emlf" (declarations ++ "case [42] of {[x] -> x; _ -> 0}"))
 checkResult "list sugar works without implicit Prelude" int withoutPrelude
 rejected "heterogeneous list" (declarations ++ "[42,true]") Inference "type constructor mismatch"
 rejected "duplicate tuple variable" (declarations ++ "f (x,x) = x; main = f (1,2);") Parsing "duplicate function parameter"
 rejected "nonexhaustive cons pattern" (declarations ++ "case [42] of {x : xs -> x}") Inference "non-exhaustive"
 rejected "duplicate list pattern variable" (declarations ++ "case [1,2] of {[x,x] -> x; _ -> 0}") Inference "duplicate pattern variable"
 rejected "missing tuple declaration" "(1,2)" Inference "unknown data constructor"
 rejected "legacy free arrow annotation stays rejected" "(\\x -> x) : a -> a" Inference "unbound annotation type variable"

runtimeChecks : IO Unit
runtimeChecks = do
 evaluates "tuple projection" (declarations ++ "case (40,2) of {(x,y) -> x+y}") 42
 evaluates "list pattern result" (declarations ++ "case [20,22] of {[x,y] -> x+y; _ -> 0}") 42
 evaluates "cons associativity result" (declarations ++ "case 20 : 22 : [] of {[x,y] -> x+y; _ -> 0}") 42
 evaluates "tuple ignored field stays lazy" (declarations ++ "case (42, panic \"tuple field forced\") of {(x,_) -> x}") 42
 evaluates "list ignored head stays lazy" (declarations ++ "case [panic \"list head forced\",42] of {[_,x] -> x; _ -> 0}") 42
 evaluates "cons ignored tail stays lazy" (declarations ++ "case 42 : (panic \"list tail forced\") of {x : _ -> x; [] -> 0}") 42
 evaluates "typed recursive list traversal" (declarations ++ "sum : [Int] -> Int; sum [] = 0; sum (x : xs) = x + sum xs; main = sum [10,12,20];") 42

shapes : Map String (Pair String String)
shapes = M.singleton "Shapes" (Pair "Shapes.emlf" ("module Shapes where\n" ++ declarations))
moduleAccepted : String -> String -> IO Unit
moduleAccepted label source = do
 result <- compiled (Compiler.compileModules shapes "Main.emlf" source)
 checkResult label int result
moduleRejected : String -> Map String (Pair String String) -> String -> String -> IO Unit
moduleRejected label libraries source reason = do
 case Compiler.compileModules libraries "Main.emlf" source of
  Left error -> require (contains reason (Compiler.diagnostic error)) (label ++ ": " ++ Compiler.prettyError error)
  Right _ -> fatal (label ++ ": scope failure accepted")
 passed label
scopeChecks : IO Unit
scopeChecks = do
 moduleAccepted "imported ordinary constructors" "module Main where\nimport Shapes\nmain = case [(40,2)] of {[(x,y)] -> x+y; _ -> 0}\n"
 moduleAccepted "qualified explicit constructors interoperate" "module Main where\nimport Shapes\nmain = case Shapes.Cons (Shapes.Pair 40 2) Shapes.Nil of {[(x,y)] -> x+y; _ -> 0}\n"
 moduleRejected "qualified-only import does not supply sugar names" shapes "module Main where\nimport qualified Shapes\nmain = []\n" "not in scope: Nil"
 moduleRejected "hidden constructor stays hidden" shapes "module Main where\nimport Shapes hiding (List(Nil))\nmain = []\n" "not in scope: Nil"
 moduleRejected "abstract tuple import stays abstract" shapes "module Main where\nimport Shapes (Pair)\nmain = (1,2)\n" "not in scope: Pair"
 let ambiguous = M.insert compareString "Other" (Pair "Other.emlf" "module Other where\ndata Pair a b = Pair a b\n") shapes
 moduleRejected "ambiguous tuple constructor stays ambiguous" ambiguous "module Main where\nimport Shapes\nimport Other\nmain = (1,2)\n" "ambiguous name Pair"

main : IO Unit
main = do
 parserChecks
 boundaryChecks
 checkingChecks
 runtimeChecks
 scopeChecks
 putStrLn "Tuple/list focused checks passed."
