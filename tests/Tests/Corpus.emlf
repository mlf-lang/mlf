-- Fresh deterministic inputs; expected types remain frozen independent oracle data.
module Tests.Corpus where
import Bootstrap.Types
import qualified Bootstrap.Std as S
import qualified Bootstrap.Map as M
import qualified Package.OS as O
import qualified Package.Json as J
import qualified Tests.Helpers as H
import qualified Tests.Oracle as W
import qualified Tests.Figure12 as F
import qualified Bootstrap.Kind as K
prettyExpr : SExpr -> String
prettyExpr expression = case expression of
 SVar name -> name
 SLam name annotation body -> "(\\" ++ parameter name annotation ++ " -> " ++ prettyExpr body ++ ")"
 SApp function argument -> "(" ++ prettyExpr function ++ " " ++ prettyExpr argument ++ ")"
 SLet name value body -> "(let " ++ name ++ " = " ++ prettyExpr value ++ " in " ++ prettyExpr body ++ ")"
 SAnn value annotation -> "(" ++ prettyExpr value ++ " : " ++ prettyAnnotation annotation ++ ")"
 SIntLit n -> "(" ++ showInt n ++ ")"
 SBoolLit b -> if b then "true" else "false"
 _ -> panic "unsupported independent oracle AST"
parameter : String -> Maybe SAnnotation -> String
parameter name annotation = case annotation of { Nothing -> name; Just a -> "(" ++ name ++ " : " ++ prettyAnnotation a ++ ")" }
prettyAnnotation : SAnnotation -> String
prettyAnnotation (SAnnotation variables ty) = (if S.null variables then "" else "exists " ++ S.unwords variables ++ ". ") ++ prettySourceType ty
prettySourceType : SType -> String
prettySourceType ty = case ty of
 STVar name -> name
 SBottom -> "bot"
 SBottomKind kind -> "(bot : " ++ K.prettyKind kind ++ ")"
 SArrow a b -> "(" ++ prettySourceType a ++ " -> " ++ prettySourceType b ++ ")"
 SCon name [] -> name
 SCon name args -> "(" ++ S.unwords ((:) name (S.map prettySourceType args)) ++ ")"
 STypeApp f a -> "(" ++ prettySourceType f ++ " " ++ prettySourceType a ++ ")"
 SForall flag name bound body -> "(forall " ++ boundParameter flag name bound ++ ". " ++ prettySourceType body ++ ")"
 _ -> panic "qualified type outside annotation corpus"
boundParameter : Flag -> String -> SType -> String
boundParameter flag name bound = case (,) flag bound of
 (,) Flexible SBottom -> name
 _ -> "(" ++ name ++ (if S.eqFlag flag Flexible then " >= " else " = ") ++ prettySourceType bound ++ ")"
annotationTerms =
 let identityExpr = SLam "x" Nothing (SVar "x") in
 let identityType = SForall Flexible "a" SBottom (SArrow (STVar "a") (STVar "a")) in
 let types = (:) SBottom ((:) (SCon "Int" []) ((:) (SCon "Bool" []) ((:) identityType ((:) (SForall Flexible "a" SBottom (SCon "[]" ((:) (STVar "a") []))) ((:) (SForall Flexible "a" identityType (SArrow (STVar "a") (STVar "a"))) []))))) in
 let nested = S.append types (S.concatMap (\a -> S.map (SArrow a) types) types) in
 S.concatMap (\ty -> (:) (SAnn identityExpr (SAnnotation [] (SArrow ty ty))) ((:) (SLam "x" (Just (SAnnotation [] ty)) (SVar "x")) ((:) (SLet "f" (SAnn identityExpr (SAnnotation [] (SArrow ty ty))) (SVar "f")) []))) nested
rows directory = do
 text <- readFile (directory ++ "/manifest.jsonl")
 S.mapM (\line -> H.right (J.parse line)) (O.nonempty (H.lines text))
regenerate directory group expressions oracle manifest = do
 let selected = S.filter (\row -> eqString group (J.getText "category" "" row)) manifest
 H.assert (S.length selected == S.length expressions) ("changed generated corpus coverage: " ++ group)
 S.mapM_ (\((,) row expression) -> do
  let path = directory ++ "/" ++ J.getText "source_path" "" row
  let text = prettyExpr expression ++ "\n"
  original <- readFile path
  H.assert (eqString original text) ("generated source changed: " ++ path)
  H.assert (H.eq (oracle expression) (J.getBool "expected_accept" false row)) ("independent acceptance differs: " ++ path)
  writeFile path text) (S.zip selected expressions)

-- Keep the historical archive immutable. These two exact cases changed
-- language semantics: their import cycles contain no recursive value group,
-- and their entry expression is the integer literal 42. The prescribed type
-- and reference target below are independent of the candidate compiler.
crateCycleExpectation : String -> Maybe ((,,) String String String)
crateCycleExpectation identity = case identity of
 "module-reject-000025" -> Just ((,,) "cycle includes chain" "Main -> A -> B -> A" "import A\n42\n")
 "module-reject-000026" -> Just ((,,) "self import" "Main -> Main" "module Main where\nimport Main\nmain = 42\n\n")
 _ -> Nothing
isCrateCycle row = S.isJust (crateCycleExpectation (J.getText "id" "" row))
crateCycleReference = "oracle/crate-module-cycles/int42.xmlf"
crateCycleMigration = "crate-module-cycles-v1"
withoutRejection row = J.Object (S.filter (\entry -> S.not (S.elem eqString (S.fst entry) ((:) "expected_phase" ((:) "expected_error_contains" [])))) (J.items row))
migrateCrateCycleRow : String -> J.Json -> IO J.Json
migrateCrateCycleRow directory row =
 case crateCycleExpectation (J.getText "id" "" row) of
  Nothing -> return row
  Just ((,,) label reason source) -> do
   let identity = J.getText "id" "" row
   let prefix = "cases/modules/" ++ identity
   H.assert (J.equal (J.get "schema_version" row) (J.num 1) && eqString (J.getText "category" "" row) "modules" && eqString (J.getText "label" "" row) label) "crate-cycle migration no longer matches the frozen case identity"
   H.assert (S.not (J.getBool "expected_accept" true row) && eqString (J.getText "expected_phase" "" row) "ModuleResolution" && eqString (J.getText "expected_error_contains" "" row) reason) "crate-cycle migration no longer matches the frozen rejection oracle"
   H.assert (eqString (J.getText "source_path" "" row) (prefix ++ "/Main.emlf") && H.eq (J.getStrings "include_dirs" row) ((:) (prefix ++ "/libraries") []) && S.not (J.getBool "no_prelude" true row)) "crate-cycle migration source configuration changed"
   original <- readFile (directory ++ "/" ++ prefix ++ "/Main.emlf")
   H.assert (eqString original source) "crate-cycle migration entry source changed"
   if eqString identity "module-reject-000025" then do
    a <- readFile (directory ++ "/" ++ prefix ++ "/libraries/A.emlf")
    b <- readFile (directory ++ "/" ++ prefix ++ "/libraries/B.emlf")
    H.assert (eqString a "module A where\nimport B\nx = 1\n" && eqString b "module B where\nimport A\ny = 2\n") "crate-cycle migration library sources changed"
   else return ()
   let migrated = J.set "expected_accept" (J.Boolean true) (J.set "expected_type" (J.str "Int") (withoutRejection row))
   let provenance = J.set "previous_expected_phase" (J.str "ModuleResolution") (J.set "previous_expected_error_contains" (J.str reason) migrated)
   return (J.set "oracle_migration" (J.str crateCycleMigration) (J.set "expected_reference_target" (J.str crateCycleReference) (J.set "acceptance_oracle" (J.str "crate namespaces permit import cycles; exact frozen sources have no recursive value dependencies") (J.set "type_oracle" (J.str "independent integer-literal typing: the entry is 42 : Int") provenance))))
migrateCrateCycles directory manifest = do
 H.assert (S.length (S.filter isCrateCycle manifest) == 2) "crate-cycle migration must match exactly two frozen cases"
 original <- readFile (directory ++ "/manifest.jsonl")
 let lines = O.nonempty (H.lines original)
 H.assert (S.length lines == S.length manifest) "crate-cycle manifest framing changed"
 migrated <- S.mapM (migrateCrateCycleRow directory) manifest
 O.mkdir (directory ++ "/oracle/crate-module-cycles")
 writeFile (directory ++ "/" ++ crateCycleReference) "42\n"
 -- Preserve every other historical row byte-for-byte, including its oracle.
 writeFile (directory ++ "/manifest.jsonl") (S.unlines (S.map (\((,) line row) -> if isCrateCycle row then J.render row else line) (S.zip lines migrated)))
-- Finite authenticated migration of frozen source/API representations.
-- The archive and original manifest remain immutable. The reviewed sidecar
-- fixes full old rows and exact old/current/projected source hashes. Expected
-- types are structural projections of the frozen independent oracle, never
-- candidate-inferred types. Custom List/Pair/Unit declarations remain nominal.
-- The existing two crate-cycle acceptance migrations are kept separate.
data SourceApiRegistry = SourceApiRegistry ([] J.Json) (Map String J.Json) (Map String J.Json)
sourceApiEntries (SourceApiRegistry entries _ _) = entries
sourceApiTable (SourceApiRegistry _ identities _) = identities
sourceApiPaths (SourceApiRegistry _ _ paths) = paths
loadSourceApiRegistry : String -> IO SourceApiRegistry
loadSourceApiRegistry root = do
 let path = root ++ "/tests/golden/parity-source-api.json"
 raw <- readFile path
 digest <- sourceApiDigest raw
 H.assert (eqString digest "23e857328a652604d0f08125bdda256d57f1237f7955d86774e998cbef2680ff") "fixed source/API migration registry changed"
 value <- H.right (J.parse raw)
 case value of
  J.Array entries -> do
   let identities = M.fromList compareString (S.map (\entry -> ((,) (sourceApiIdentity entry) entry)) entries)
   let paths = M.fromList compareString (S.map (\entry -> ((,) (sourceApiPath entry) entry)) entries)
   H.assert (S.length entries == 179 && M.size identities == 179 && M.size paths == 179) "source/API registry identities or paths are not exact and unique"
   return (SourceApiRegistry entries identities paths)
  _ -> H.fail "source/API migration registry must be an array"
sourceApiIdentity entry = J.getText "id" "" entry
sourceApiPath entry = J.getText "source_path" "" entry
sourceApiLookup registry identity = M.lookup compareString identity (sourceApiTable registry)
sourceApiLookupPath registry path = M.lookup compareString path (sourceApiPaths registry)
sourceApiRowMatches : J.Json -> J.Json -> Bool
sourceApiRowMatches entry row = J.equal row (J.get "old_row" entry)
sourceApiRowsMatch : SourceApiRegistry -> [] J.Json -> Bool
sourceApiRowsMatch registry manifest =
 let selected = S.filter (\row -> S.isJust (sourceApiLookup registry (J.getText "id" "" row))) manifest in
 let actual = M.fromList compareString (S.map (\row -> ((,) (J.getText "id" "" row) row)) selected) in
 S.length (sourceApiEntries registry) == 179 && M.size (sourceApiTable registry) == 179 && M.size (sourceApiPaths registry) == 179 && S.length selected == 179 && M.size actual == 179 &&
 S.all (\entry -> case M.lookup compareString (sourceApiIdentity entry) actual of { Just row -> sourceApiRowMatches entry row; Nothing -> false }) (sourceApiEntries registry)
sourceApiHashesMatch : J.Json -> String -> String -> Bool
sourceApiHashesMatch entry old fresh = eqString old (J.getText "old_source_sha256" "" entry) && eqString fresh (J.getText "new_source_sha256" "" entry)
sourceApiDigest : String -> IO String
sourceApiDigest text = do { bytes <- byteArrayFromString text; byteArrayDigest bytes }
prepareSourceApi : SourceApiRegistry -> String -> String -> [] J.Json -> IO ()
prepareSourceApi registry root directory manifest = do
 H.assert (sourceApiRowsMatch registry manifest) "source/API migration identities or frozen oracles changed"
 S.mapM_ (\entry -> do
  let path = directory ++ "/" ++ sourceApiPath entry
  old <- fileDigest path
  let fresh = J.getText "new_source" "" entry
  freshHash <- sourceApiDigest fresh
  H.assert (sourceApiHashesMatch entry old freshHash) ("source/API migration bytes changed: " ++ sourceApiIdentity entry)
  if O.starts "repository/" (sourceApiPath entry) then do
   current <- fileDigest (root ++ "/" ++ O.relative "repository" (sourceApiPath entry))
   H.assert (eqString current (J.getText "checkout_source_sha256" "" entry)) "source/API checkout input changed"
  else return ()
  writeFile path fresh) (sourceApiEntries registry)
-- The sidecar authenticates the complete original row, including these three
-- descriptive identities. Keep its oracle/configuration fields in the output
-- provenance without repeating identities already excluded by the existing
-- parity execution key. This preserves the original 11 exact shared pairs;
-- every oracle, configuration, and unknown field still participates in it.
sourceApiPreviousOracle row = J.Object (S.filter (\entry -> S.not (S.elem eqString (S.fst entry) ((:) "id" ((:) "label" ((:) "source_path" []))))) (J.items row))
migrateSourceApiRow : SourceApiRegistry -> J.Json -> IO J.Json
migrateSourceApiRow registry row = case sourceApiLookup registry (J.getText "id" "" row) of
 Nothing -> return row
 Just entry -> do
  H.assert (sourceApiRowMatches entry row) "source/API migration frozen row changed"
  let prescribed = S.foldl (\changed ((,) key value) -> J.set key value changed) row (J.items (J.get "updates" entry))
  let provenance = J.set "previous_oracle" (sourceApiPreviousOracle row) prescribed
  let hashes = J.set "previous_source_sha256" (J.get "old_source_sha256" entry) (J.set "source_sha256" (J.get "new_source_sha256" entry) (J.set "checkout_source_sha256" (J.get "checkout_source_sha256" entry) provenance))
  return (J.set "source_api_migration" (J.str "canonical-prelude-source-api-v1") (J.set "source_api_basis" (J.get "reason" entry) hashes))
checkRepositoryInput : SourceApiRegistry -> String -> String -> String -> IO ()
checkRepositoryInput registry root directory path = do
 let relative = O.relative (directory ++ "/repository") path
 current <- readFile (root ++ "/" ++ relative)
 original <- readFile path
 case sourceApiLookupPath registry ("repository/" ++ relative) of
  Nothing -> H.assert (eqString current original) ("repository corpus input changed; review oracle: " ++ relative)
  Just entry -> do
   checkoutHash <- sourceApiDigest current
   projectedHash <- sourceApiDigest original
   H.assert (eqString checkoutHash (J.getText "checkout_source_sha256" "" entry) && eqString projectedHash (J.getText "new_source_sha256" "" entry)) "source/API repository input changed after projection"
migrateSourceApiRows : SourceApiRegistry -> String -> IO ()
migrateSourceApiRows registry directory = do
 manifest <- rows directory
 H.assert (sourceApiRowsMatch registry manifest) "source/API migration identities or frozen oracles changed"
 original <- readFile (directory ++ "/manifest.jsonl")
 let lines = O.nonempty (H.lines original)
 H.assert (S.length lines == S.length manifest) "source/API manifest framing changed"
 migrated <- S.mapM (migrateSourceApiRow registry) manifest
 -- Preserve every line outside the explicit 179-row registry. The two
 -- independently authenticated crate-cycle lines have already been migrated.
 writeFile (directory ++ "/manifest.jsonl") (S.unlines (S.map (\((,) line row) -> if S.isJust (sourceApiLookup registry (J.getText "id" "" row)) then J.render row else line) (S.zip lines migrated)))

main : String -> IO ()
main directory = do
 root <- canonicalPath "."
 O.mkdir directory
 archiveHash <- fileDigest (root ++ "/tests/golden/parity-seed.tar.gz")
 H.assert (eqString archiveHash "ad64708fe76cad0f93af44d39e0a49b86e00b3ccaa621296fc4a43694e902ae8") "frozen parity archive changed"
 O.run "" ((:) "tar" ((:) "-xzf" ((:) (root ++ "/tests/golden/parity-seed.tar.gz") ((:) "-C" ((:) directory [])))))
 manifestHash <- fileDigest (directory ++ "/manifest.jsonl")
 H.assert (eqString manifestHash "c32f9fd7a57dbc9b5d792194ad70a81e62b4d64d5359f433bd65dc9c4072fa2d") "frozen parity manifest changed"
 manifest <- rows directory
 registry <- loadSourceApiRegistry root
 prepareSourceApi registry root directory manifest
 H.assert (S.length manifest == 7086) "parity baseline coverage changed"
 regenerate directory "hm-exhaustive" (W.closedTerms 6) W.hmTypable manifest
 regenerate directory "hm-generated" (W.generatedTerms 5000) W.hmTypable manifest
 regenerate directory "annotations" annotationTerms (\_ -> true) manifest
 S.mapM_ (\c -> do
  let identity = "figure12-" ++ F.caseId c
  let row = S.fromMaybe (panic "missing Figure12 corpus row") (S.find (\r -> eqString identity (J.getText "id" "" r)) manifest)
  text <- H.right (F.program c)
  original <- readFile (directory ++ "/" ++ J.getText "source_path" "" row)
  H.assert (eqString original (text ++ "\n")) ("Figure12 source changed: " ++ identity)
  H.assert (H.eq (F.expectedAcceptance c) (J.getBool "expected_accept" false row)) "Figure12 acceptance changed") F.cases
 -- Refresh repository inputs from the current checkout while keeping prescribed oracle types.
 files <- O.files (directory ++ "/repository")
 S.mapM_ (checkRepositoryInput registry root directory) files
 migrateCrateCycles directory manifest
 migrateSourceApiRows registry directory
 putStrLn "Fresh MLF corpus: 7086 rows; generated inputs checked; 179 authenticated source/API projections"
