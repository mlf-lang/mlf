import qualified Package.OS as O
import qualified Tests.Selection as Selection
import qualified Test.Case as Case
import qualified Test.CaseSelection as Planned
import qualified Test.Runner as Runner
suite : B.Backends -> [] ((,) String (IO ()))
suite backends = S.append (Wr.backendTests backends) (S.concat ((:) (Io.ioTests backends) ((:) (Pr.preludeTests backends) ((:) (Sn.snakeTests backends) ((:) (Ba.backendTests backends) ((:) (Na.nativeOptimizationTests backends) ((:) (Co.constructorProjectionTests backends) ((:) (Fo.forceReuseTests backends) ((:) (Bo.boolConditionTests backends) ((:) (En.environmentAccessTests backends) ((:) (St.strictFieldTests backends) ((:) (Nu.numericArrayTests backends) ((:) (By.byteArrayTests backends) ((:) (Dn.dnaTests backends) ((:) (Mo.moduleBackendTests backends) ((:) (Se.separateBackendTests backends) ((:) (Bs.bootstrapPrimitiveTests backends) ((:) (Sr.stateRuntimeTests backends) ((:) (Hi.higherOrderTests backends) [])))))))))))))))))))
-- Each family is a contract boundary over existing fixture actions. Selection
-- filters the original suite, preserving its exact full and partial ordering.
familyNames : [] String
familyNames = O.words "backends/strict-wrappers backends/io-language backends/io-runtime backends/io-target-validation backends/io-monad-laws backends/io-failures backends/prelude-language backends/prelude-import-equivalence backends/prelude-runtime backends/snake backends/surface-language backends/guards backends/target-validation backends/target-runtime-input backends/target-semantics backends/example-corpus backends/tree-workload backends/native-arithmetic-boundaries backends/native-optimization backends/constructor-projection backends/force-reuse backends/boolean-lowering backends/environment-slots backends/strict-fields backends/numeric-language backends/numeric-specialization backends/numeric-target-validation backends/numeric-runtime backends/numeric-workloads backends/byte-language backends/byte-specialization backends/byte-target-validation backends/byte-io-failure backends/byte-runtime backends/byte-workloads backends/table-language backends/byte-input-runtime backends/table-specialization backends/table-runtime backends/dna-workloads backends/module-execution backends/module-cli backends/crate-linking backends/crate-cli backends/crate-invalidation backends/primitive-language backends/primitive-runtime backends/state-workers backends/state-runtime backends/higher-order-specialization"
casesWith predicate cases = S.filter (\entry -> predicate (S.fst entry)) cases
isIOLanguage label = O.starts "IO string constraint: " label || O.starts "IO type: " label || O.starts "IO rejection: " label || eqString label "IO: unknown target primitive is rejected"
isIOTarget label = O.starts "IO target: " label || eqString label "IO: pure programs are not executable entry points" || eqString label "IO: target verification happens before any effects"
isIOLaw label = O.starts "IO monad law: " label
isIOFailure label = eqString label "IO: EOF is reported and stops the continuation" || eqString label "IO: backend output errors are reported"
isPreludeRuntime label = O.starts "prelude runtime: " label
isPreludeImports label = O.starts "prelude: every compiler API " label || O.starts "prelude: unused imports preserve " label || eqString label "prelude: opt-out removes implicit class declarations"
isNumericLanguage label = eqString label "numeric: types reject invalid numeric and array programs"
isNumericNative label = O.starts "native scalar arguments: " label || O.starts "native numeric region: " label
isByteLanguage label = eqString label "bytes: nominal types reject invalid operations"
isByteNative label = S.elem eqString label ((:) "bytes: native loop emits every byte without Unicode conversion" ((:) "bytes: bulk copy preserves offsets, empty ranges and forward overlap" ((:) "bytes: native stores check bounds before byte range" ((:) "numeric region: integer-to-Double conversion preserves rounding" []))))
isCrateCLI label = O.starts "crate CLI: " label
isCrateInvalidation label = eqString label "crate runtime: source-free metadata and semantic invalidation"
isPrimitiveLanguage label = eqString label "bootstrap primitives: signatures reject mismatched types"
isStateWorker label = S.elem eqString label (S.map (\name -> "ST runtime: " ++ name) (O.words "bounded-non-tail-state-worker bounded-tail-state-worker bounded-mixed-tail-state-worker single-use-action-alias"))
isBackendLanguage label = O.starts "backend: readability: " label || O.starts "backend: surface: " label || S.elem eqString label ((:) "backend: state dictionary result" ((:) "backend: superclass dictionary result" []))
isBackendGuards label = O.starts "backend: guards runtime: " label
isBackendTarget label = O.starts "backend target: " label
isBackendInput label = S.elem eqString label ((:) "backend: unicode-input" ((:) "backend: unicode" ((:) "backend: nul" ((:) "backend: final line without newline" ((:) "backend: unused input is retained" [])))))
isBackendExample label = eqString label "backend: all examples execute"
isBackendWorkload label = eqString label "backend: binary-trees benchmark"
isNativeArithmetic label = S.elem eqString label ((:) "native optimization: tagged integer boundaries" ((:) "native optimization: ordinary products and division preserve Integer boundaries" []))
isNumericTarget label = eqString label "numeric: non-finite target literal rejected by both backends"
isNumericWorkload label = S.any (\prefix -> O.starts prefix label) ((:) "numeric: pidigits benchmark " ((:) "numeric: n-body benchmark " ((:) "numeric: spectral-norm benchmark " ((:) "numeric: fannkuch-redux benchmark " []))))
isByteTarget label = eqString label "bytes: forged surrogate is rejected before encoding by both backends"
isByteFailure label = eqString label "bytes: write failures stop continuation and preserve raw output"
isByteWorkload label = S.any (\prefix -> O.starts prefix label) ((:) "bytes: fasta " ((:) "bytes: mandelbrot " []))
isTableLanguage label = eqString label "table: nominal types and IO signatures are checked"
isTableNative label = S.elem eqString label ((:) "table: native counting loop grows and updates collision-prone keys" ((:) "native IO: nested collections preserve caller values and prior results" ((:) "table fusion: snapshots, large signed keys and promotion across updates" [])))
isModuleCLI label = eqString label "modules runtime: CLI imports and output paths"
families : B.Backends -> [] ((,) String ([] ((,) String (IO ()))))
families backends =
 let base = Ba.backendTests backends in
 let native = Na.nativeOptimizationTests backends in
 let dna = Dn.dnaTests backends in
 let modules = Mo.moduleBackendTests backends in
 let io = Io.ioTests backends in
 let prelude = Pr.preludeTests backends in
 let numeric = Nu.numericArrayTests backends in
 let bytes = By.byteArrayTests backends in
 let crates = Se.separateBackendTests backends in
 let primitives = Bs.bootstrapPrimitiveTests backends in
 let state = Sr.stateRuntimeTests backends in
 ((:) ((,) "backends/strict-wrappers" (Wr.backendTests backends)) ((:) ((,) "backends/io-language" (casesWith isIOLanguage io)) ((:) ((,) "backends/io-runtime" (casesWith (\label -> S.not (isIOLanguage label || isIOTarget label || isIOLaw label || isIOFailure label)) io)) ((:) ((,) "backends/io-target-validation" (casesWith isIOTarget io)) ((:) ((,) "backends/io-monad-laws" (casesWith isIOLaw io)) ((:) ((,) "backends/io-failures" (casesWith isIOFailure io)) ((:) ((,) "backends/prelude-language" (casesWith (\label -> S.not (isPreludeRuntime label || isPreludeImports label)) prelude)) ((:) ((,) "backends/prelude-import-equivalence" (casesWith isPreludeImports prelude)) ((:) ((,) "backends/prelude-runtime" (casesWith isPreludeRuntime prelude)) ((:) ((,) "backends/snake" (Sn.snakeTests backends)) ((:) ((,) "backends/surface-language" (casesWith isBackendLanguage base)) ((:) ((,) "backends/guards" (casesWith isBackendGuards base)) ((:) ((,) "backends/target-validation" (casesWith isBackendTarget base)) ((:) ((,) "backends/target-runtime-input" (casesWith isBackendInput base)) ((:) ((,) "backends/target-semantics" (casesWith (\label -> S.not (isBackendLanguage label || isBackendGuards label || isBackendTarget label || isBackendInput label || isBackendExample label || isBackendWorkload label)) base)) ((:) ((,) "backends/example-corpus" (casesWith isBackendExample base)) ((:) ((,) "backends/tree-workload" (casesWith isBackendWorkload base)) ((:) ((,) "backends/native-arithmetic-boundaries" (casesWith isNativeArithmetic native)) ((:) ((,) "backends/native-optimization" (casesWith (\label -> S.not (isNativeArithmetic label)) native)) ((:) ((,) "backends/constructor-projection" (Co.constructorProjectionTests backends)) ((:) ((,) "backends/force-reuse" (Fo.forceReuseTests backends)) ((:) ((,) "backends/boolean-lowering" (Bo.boolConditionTests backends)) ((:) ((,) "backends/environment-slots" (En.environmentAccessTests backends)) ((:) ((,) "backends/strict-fields" (St.strictFieldTests backends)) ((:) ((,) "backends/numeric-language" (casesWith isNumericLanguage numeric)) ((:) ((,) "backends/numeric-specialization" (casesWith isNumericNative numeric)) ((:) ((,) "backends/numeric-target-validation" (casesWith isNumericTarget numeric)) ((:) ((,) "backends/numeric-runtime" (casesWith (\label -> S.not (isNumericLanguage label || isNumericNative label || isNumericTarget label || isNumericWorkload label)) numeric)) ((:) ((,) "backends/numeric-workloads" (casesWith isNumericWorkload numeric)) ((:) ((,) "backends/byte-language" (casesWith isByteLanguage bytes)) ((:) ((,) "backends/byte-specialization" (casesWith isByteNative bytes)) ((:) ((,) "backends/byte-target-validation" (casesWith isByteTarget bytes)) ((:) ((,) "backends/byte-io-failure" (casesWith isByteFailure bytes)) ((:) ((,) "backends/byte-runtime" (casesWith (\label -> S.not (isByteLanguage label || isByteNative label || isByteTarget label || isByteFailure label || isByteWorkload label)) bytes)) ((:) ((,) "backends/byte-workloads" (casesWith isByteWorkload bytes)) ((:) ((,) "backends/table-language" (casesWith isTableLanguage dna)) ((:) ((,) "backends/byte-input-runtime" (casesWith (O.starts "byte input: ") dna)) ((:) ((,) "backends/table-specialization" (casesWith isTableNative dna)) ((:) ((,) "backends/table-runtime" (casesWith (\label -> S.not (isTableLanguage label || O.starts "byte input: " label || isTableNative label || O.starts "DNA: " label)) dna)) ((:) ((,) "backends/dna-workloads" (casesWith (O.starts "DNA: ") dna)) ((:) ((,) "backends/module-execution" (casesWith (\label -> S.not (isModuleCLI label)) modules)) ((:) ((,) "backends/module-cli" (casesWith isModuleCLI modules)) ((:) ((,) "backends/crate-linking" (casesWith (\label -> S.not (isCrateCLI label || isCrateInvalidation label)) crates)) ((:) ((,) "backends/crate-cli" (casesWith isCrateCLI crates)) ((:) ((,) "backends/crate-invalidation" (casesWith isCrateInvalidation crates)) ((:) ((,) "backends/primitive-language" (casesWith isPrimitiveLanguage primitives)) ((:) ((,) "backends/primitive-runtime" (casesWith (\label -> S.not (isPrimitiveLanguage label)) primitives)) ((:) ((,) "backends/state-workers" (casesWith isStateWorker state)) ((:) ((,) "backends/state-runtime" (casesWith (\label -> S.not (isStateWorker label)) state)) ((:) ((,) "backends/higher-order-specialization" (Hi.higherOrderTests backends)) []))))))))))))))))))))))))))))))))))))))))))))))))))
validateFamilies allCases entries = do
 let labels = S.map S.fst allCases
 let partitioned = S.concatMap (\entry -> S.map S.fst (S.snd entry)) entries
 H.assert (S.eqList eqString (S.map S.fst entries) familyNames) "backend family registry differs from discovery"
 H.assert (S.all (\entry -> S.not (S.null (S.snd entry))) entries && S.length partitioned == S.length labels && S.length partitioned == S.length (S.nubBy eqString partitioned) && S.eqList eqString (S.sortBy compareString partitioned) (S.sortBy compareString labels)) "backend families do not partition the preserved fixture actions"
validateSuite allCases = do
 let labels = S.map S.fst allCases
 H.assert (S.length allCases == 541) "preserved backend fixture coverage changed"
 H.assert (S.length labels == S.length (S.nubBy eqString labels)) "duplicate backend fixture labels"
-- Escape semantic labels reversibly. Coordinates are local to a case, while
-- the legacy global row indices remain in the compatibility receipt.
caseId family label = family ++ "/" ++ S.concatMapString (\index ->
 let code = stringCodeAt label index in
 if H.isAlphaNum code || code == 45 || code == 46 then O.char label index
 else "_" ++ showInt code ++ "_") (S.range 0 (stringLength label - 1))

registry backends allCases entries =
 let owners = M.fromList compareString (S.concatMap (\((,) family cases) -> S.map (\entry -> (,) (S.fst entry) family) cases) entries) in
 S.map (\((,) label action) ->
  let family = case M.lookup compareString label owners of { Just value -> value; Nothing -> panic "backend fixture has no family" } in
  let identity = caseId family label in
  Case.test identity label ((:) ("family:" ++ family) [])
   (B.recoverCase (B.inRegisteredCase backends identity label (do { putStrLn label; action })))) allCases

selectedCases cases args = case args of
 (:) "--from" ((:) prefix []) -> do
  options <- H.right (Runner.parse [])
  let selected = S.dropWhile (\entry -> S.not (O.starts prefix (Case.name entry))) cases
  H.assert (S.not (S.null selected)) ("unknown backend fixture prefix: " ++ prefix)
  return ((,,) options selected Nothing)
 (:) "--families" _ -> do
  (,) _ names <- H.right (Selection.choose familyNames args)
  options <- H.right (Runner.parse [])
  let selected = S.filter (\entry -> S.any (\name -> S.elem eqString ("family:" ++ name) (Case.tags entry)) names) cases
  return ((,,) options selected (Just names))
 _ -> do
  (,) options selected <- H.right (Runner.plan args cases)
  let names = if S.null (Runner.selectors options) then Just familyNames else Nothing
  return ((,,) options selected names)

main : IO ()
main = do
 args <- O.allArguments
 if Selection.listing args then putStr (S.unlines familyNames) else do
  let allCases = suite B.inventoryContext
  let entries = families B.inventoryContext
  validateSuite allCases
  validateFamilies allCases entries
  let cases = registry B.inventoryContext allCases entries
  (,,) options selected selection <- selectedCases cases args
  if Runner.listing options then do
   plan <- H.right (Planned.project cases selected)
   runRegistry B.inventoryContext args options selection plan
  else B.withBackends (\backends -> do
   let runnable = registry backends (suite backends) (families backends)
   plan <- H.right (Planned.rebind runnable selected)
   runRegistry backends args options selection plan)

runRegistry backends args options selection plan = do
 let selected = Planned.cases plan
 reported <- B.reportArgs (case args of
  (:) "--from" _ -> []
  (:) "--families" _ -> []
  _ -> args)
 reportOptions <- H.right (Runner.parse reported)
 let wholeInvocation = case args of { (:) "--from" _ -> false; (:) "--families" _ -> false; _ -> true }
 let full = S.length selected == Planned.total plan && S.null (Runner.selectors options) && wholeInvocation
 if Runner.listing options then do
  code <- Runner.runSelected (\_ -> return ()) reportOptions plan
  if code == 0 then return () else exitWith code
 else do
  case selection of { Nothing -> return (); Just names -> Selection.begin "backends" full names }
  code <- Runner.runSelected (\_ -> return ()) reportOptions plan
  if code == 0 then do
   _ <- if full then B.auditBackends backends else B.auditSelectedBackends backends
   case selection of
    Nothing -> return ()
    Just names -> do { S.mapM_ (Selection.passed "backends") names; Selection.finish "backends" }
   putStrLn (showInt (S.length selected) ++ " shared IO/prelude/backend fixtures; 0 failures")
  else exitWith code
