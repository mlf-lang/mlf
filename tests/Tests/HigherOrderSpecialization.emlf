module Tests.HigherOrderSpecialization where
import Bootstrap.Types
import qualified Bootstrap.Std as S
import qualified Package.OS as OS
import qualified Tests.Helpers as H
import Tests.Helpers (Quint(..), Sext(..))
import qualified Tests.Backends as B
import qualified Bootstrap.Compiler as C
import qualified Bootstrap.LLVM as LLVM
import qualified Bootstrap.X.Check as Check
import qualified Bootstrap.X.Type as T

higherOrderTests : B.Backends -> ([] ( ((,) (String) (IO ())) ))
higherOrderTests backends = (S.concatMap (\((,,) label source expected) -> ((:) ((,) (H.append "higher-order specialization: " label) do { compilation <- (S.either (S.compose H.fail H.show) return (C.compile label source)); do { ty <- (S.either H.fail return (Check.checkClosed (C.compiledTerm compilation))); do { (S.unless (T.alphaEq ty (C.inferredType compilation)) (H.fail "target type changed")); do { (if (H.eq label "primitive-callback") then do { llvm <- (S.either H.fail return (LLVM.emitLLVM (C.compiledTerm compilation))); (S.unless (S.not (H.contains "call ptr @mlf_application(" llvm)) (H.fail "known recursive callback still uses generic application")) } else (return ())); do { observed <- (B.execute backends B.ProgramEntry (B.Input "" false) (C.compiledTerm compilation)); (S.unless ((S.either (S.const false) (S.const true) (B.outcome observed)) && ((H.eq (B.output observed) expected) && ((H.null (B.stderrOutput observed)) && (H.null (B.remaining observed))))) (H.fail (H.show observed))) } } } } }) [])) cases)

cases : ([] ( ((,,) (String) (String) (String)) ))
cases = ((:) ((,,) "primitive-callback" "loop : (Int -> Int -> Int) -> Int -> Int -> Int\nloop f z n = if n == 0 then z else loop f (f z n) (n - 1)\nmain = printInt (loop addInt 0 10)" "55\n") ((:) ((,,) "captured-callback" "loop : (Int -> Int -> Int) -> Int -> Int -> Int\nloop f z n = if n == 0 then z else loop f (f z n) (n - 1)\nrun offset = loop (\\z n -> z + n + offset) 0 10\nmain = printInt (run (readInt \"3\"))" "85\n") ((:) ((,,) "partial-callback" "loop : (Int -> Int -> Int) -> Int -> Int -> Int\nloop f z n = if n == 0 then z else loop f (f z n) (n - 1)\nstep bias z n = z + bias + n\nrun bias = loop (step bias) 0 10\nmain = printInt (run 3)" "85\n") ((:) ((,,) "empty-lazy-capture" "loop : (Int -> Int -> Int) -> Int -> Int -> Int\nloop f z n = if n == 0 then z else loop f (f z n) (n - 1)\nrun bias = loop (\\z n -> z + bias + n) 42 0\nmain = printInt (run (panic \"unused captured value\"))" "42\n") ((:) ((,,) "discarded-callback-argument" "loop : (Int -> Int -> Int) -> Int -> Int -> Int\nloop f z n = if n == 0 then z else loop f (f z n) (n - 1)\nmain = printInt (loop (\\z n -> n) (panic \"unused accumulator\") 1)" "1\n") ((:) ((,,) "changing-callback" "loop : (Int -> Int) -> Int -> Int -> Int\nloop f z n = if n == 0 then z else loop (\\x -> f x + 1) (f z) (n - 1)\nmain = printInt (loop (\\x -> x + 1) 0 3)" "6\n") ((:) ((,,) "recursive-capture-scope" "loop : (Int -> Int) -> Int -> Int\nloop f n = if n == 0 then f 0 else if n == 1 then loop (\\x -> x + n) 0 else loop f (n - 1)\nmain = printInt (loop (\\x -> x + 100) 2)" "1\n") ((:) ((,,) "unbounded-callback-integers" "loop : (Int -> Int -> Int) -> Int -> Int -> Int\nloop f z n = if n == 0 then z else loop f (f z n) (n - 1)\nmain = printInt (loop addInt 1267650600228229401496703205376 10)" "1267650600228229401496703205431\n") ((:) ((,,) "constructor-callback" "data Box = Box Int\nrepeat : (Int -> Box) -> Int -> Box\nrepeat f n = if n == 0 then f 42 else repeat f (n - 1)\nmain = case repeat Box 3 of Box n -> printInt n" "42\n") ((:) ((,,) "lazy-constructor-callback" "data Box = Box Int Int\nrepeat : (Int -> Box) -> Int -> Box\nrepeat f n = if n == 0 then f 42 else repeat f (n - 1)\nmain = case repeat (Box (panic \"unused constructor field\")) 3 of Box _ n -> printInt n" "42\n") ((:) ((,,) "escaping-original-worker" "loop : (Int -> Int -> Int) -> Int -> Int -> Int\nloop f z n = if n == 0 then z else loop f (f z n) (n - 1)\nchoose flag a b = if flag then a else b\nmain = printInt (loop addInt 0 10 + (choose (eqString \"a\" \"a\") loop (\\f z n -> z)) (\\z n -> z + n) 0 7)" "83\n") [])))))))))))
