module Tests.CoreHelpers where
import Prelude hiding (Monad, return, bind)
import MLF.Primitive (Monad, return, bind)
import qualified Test.Assert as A
import Bootstrap.Types
import Bootstrap.Compiler
import Bootstrap.Parser
import qualified Bootstrap.Classes as Classes
import qualified Bootstrap.Standalone as Standalone
import qualified Bootstrap.Prelude as SourcePrelude
import qualified Bootstrap.Constraint as Constraint
import Bootstrap.X.Pretty
import qualified Bootstrap.Std as S
import qualified Tests.Helpers as H
import qualified Bootstrap.X.Check as C
import qualified Bootstrap.X.Syntax as X
import qualified Bootstrap.X.Type as T
import qualified Bootstrap.X.Parser as XP

-- Match Compiler.compileProgramWithPrelude before testing solver internals.
sourceConstraints : String -> String -> Either String Constraints
sourceConstraints file source = case parseProgram file source of
 Left message -> Left message
 Right parsed -> case Standalone.normalize ImplicitPrelude parsed of
  Left message -> Left message
  Right Nothing -> case SourcePrelude.withPrelude ImplicitPrelude parsed of
   (,) imports program -> lowerSourceConstraints imports program
  Right (Just ((,,) imports program _)) -> lowerSourceConstraints imports program

lowerSourceConstraints : Set String -> SProgram -> Either String Constraints
lowerSourceConstraints imports program = case Classes.canonicalSourceProgram imports program of
 Left message -> Left message
 Right canonical -> case Classes.lowerClassesWithImports imports canonical of
  Left message -> Left message
  Right ((,) lowered _) -> Constraint.generateProgram lowered

v : Int -> XType
v = (S.compose XVar XTyVar)

allT : Int -> XType -> XType -> XType
allT = (S.compose XForall XTyVar)

int : XType
int = (XCon "Int" [])

bool : XType
bool = (XCon "Bool" [])

identity : XType
identity = (allT 0 XBot (XArrow (v 0) (v 0)))

chooseId : XType
chooseId = (allT 1 identity (XArrow (v 1) (v 1)))

choosePrefix : String
choosePrefix = "let choose = ((\\x y -> x) : forall a. a -> a -> a) in let id = \\x -> x in "

sameType : XType -> XType -> IO ()
sameType actual expected = A.orExit (assertSameType actual expected)

compileOK : String -> IO Compilation
compileOK source = A.orExit (assertCompiled source)

assertSameType : XType -> XType -> A.Test ()
assertSameType actual expected = (A.assert (T.alphaEq actual expected) (H.append "expected " (H.append (prettyType expected) (H.append ", got " (prettyType actual)))))

assertCompiled : String -> A.Test Compilation
assertCompiled source = do { result <- (A.right H.show (compile "<test>" source)); do { parsed <- (A.right H.show (XP.parseTerm "<generated xMLF>" (prettyTerm (compiledTerm result)))); do { (A.assert (H.eq (X.erase parsed) (X.erase (compiledTerm result))) "printed output changed erasure"); do { ty <- (A.right H.show (C.checkClosed parsed)); do { (assertSameType ty (inferredType result)); (return result) } } } } }

hasType : String -> String -> XType -> (,) String (A.Test ())
hasType label source ty = ((,) label (bind (assertCompiled source) (\r -> (assertSameType (inferredType r) ty))))

accepts : String -> String -> (,) String (A.Test ())
accepts label source = ((,) label (bind (assertCompiled source) (\ignored -> (return ()))))

rejects : String -> String -> (,) String (A.Test ())
rejects label source = ((,) label (case (compile "<test>" source) of { (Left (CompileError Inference _)) -> (return ()); (Left err) -> (A.fail (H.append "error at the wrong phase: " (H.show err))); (Right r) -> (A.fail (H.append "unexpected type: " (prettyType (inferredType r)))) }))

requireRejection : forall e a. Either e a -> A.Test ()
requireRejection value = case value of
 Left _ -> A.succeed ()
 Right _ -> A.fail "unexpected success"

stripComputations : XTerm -> XTerm
stripComputations t = (case t of { (XTypeApp a _) -> (stripComputations a); (XAbs n ty b) -> (XAbs n ty (stripComputations b)); (XApp a b) -> (XApp (stripComputations a) (stripComputations b)); (XTypeAbs a ty b) -> (XTypeAbs a ty (stripComputations b)); (XLet n a b) -> (XLet n (stripComputations a) (stripComputations b)); (XLetRec ds b) -> (XLetRec (S.concatMap (\((,,) n ty a) -> ((:) ((,,) n ty (stripComputations a)) [])) ds) (stripComputations b)); (XWithData ds b) -> (XWithData ds (stripComputations b)); (XCase a ty bs) -> (XCase (stripComputations a) ty (S.concatMap (\comprehension2 -> case comprehension2 of { (XAlternative p b) -> ((:) (XAlternative p (stripComputations b)) []); _ -> [] }) bs)); _ -> t })
