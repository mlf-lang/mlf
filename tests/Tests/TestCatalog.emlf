module Tests.TestCatalog where
import Bootstrap.Types
import qualified Bootstrap.Std as S
import qualified Package.Json as J
import qualified Package.OS as O
import qualified Tests.Basic as H
import qualified Tests.Catalog as C
import qualified Tests.Coverage as Coverage
import qualified Tests.CorePartitions as CorePartitions

rejected : forall a. Either String a -> IO ()
rejected value = case value of { Left _ -> return (); Right _ -> H.fail "invalid catalog, selection or partial coverage was accepted" }
ids values = S.map C.identity values
selected catalog arguments = do
 settings <- H.right (C.parse J.empty (O.words arguments))
 H.right (C.select catalog settings)
chosen catalog arguments expected = do
 values <- selected catalog arguments
 H.assert (S.eqList eqString (ids values) expected) ("catalog selection changed families or order: " ++ arguments)
notChosen catalog arguments = do
 settings <- H.right (C.parse J.empty (O.words arguments))
 rejected (C.select catalog settings)
remove key object = J.Object (S.filter (\entry -> S.not (eqString (S.fst entry) key)) (J.items object))
changeFamily name action catalog = J.set "families" (J.Array (S.map (\entry -> if eqString (C.identity entry) name then action entry else entry) (C.families catalog))) catalog
changeEvidence name action catalog = changeFamily name (\entry -> J.set "evidence" (action (J.get "evidence" entry)) entry) catalog
changeSuite name action inventory = J.set "suites" (J.set name (action (J.get name (J.get "suites" inventory))) (J.get "suites" inventory)) inventory
suite inventory name = J.get name (J.get "suites" inventory)
partial = "{\"schema_version\":1,\"suite\":\"sample\",\"event\":\"start\",\"scope\":\"partial\"}\n{\"schema_version\":1,\"suite\":\"sample\",\"event\":\"case\",\"id\":\"first\",\"status\":\"passed\"}\n{\"schema_version\":1,\"suite\":\"sample\",\"event\":\"summary\",\"complete\":true,\"executions\":1,\"aliases\":0,\"metrics\":0}\n"

selectionChecks catalog = do
 -- Expected selections come from the reviewed purpose of these families, not
 -- from another invocation of the selector under test.
 chosen catalog "--family core/hm-oracle" ((:) "core/hm-oracle" [])
 chosen catalog "--family core/hm-oracle --group language --level integration --unit core --campaign unit --input exhaustive --input seeded-random --oracle independent-reference --purpose conformance --purpose regression" ((:) "core/hm-oracle" [])
 chosen catalog "--family core/hm-oracle --technique property-based --technique differential --technique regression" ((:) "core/hm-oracle" [])
 chosen catalog "--family harness/native-driver-cache --technique metamorphic --technique fault-injection" ((:) "harness/native-driver-cache" [])
 chosen catalog "--technique fixed-point" ((:) "self-host/complete" [])
 chosen catalog "--family core/hm-oracle --family core/substring-adapter" (O.words "core/substring-adapter core/hm-oracle")
 chosen catalog "--category language --family core/hm-oracle" ((:) "core/hm-oracle" [])
 let packageIds = O.words "package-integration/complete package-distribution/complete"
 chosen catalog "--campaign packages" packageIds
 chosen catalog "--campaign packages --unit package-distribution" ((:) "package-distribution/complete" [])
 unit <- selected catalog "--campaign unit"
 H.assert (S.eqList eqString (S.nubBy eqString (S.map C.unitName unit)) (O.words "regex harness test-framework core figure12")) "preserved unit campaign changed execution order"
 all <- H.right (C.select catalog J.empty)
 H.assert (S.eqList eqString (ids all) (ids (C.families catalog))) "empty settings lost full-campaign families"
 rejected (C.select catalog J.Null)
 S.mapM_ (\name -> do
  rejected (C.select catalog (J.set name J.Null J.empty))
  rejected (C.select catalog (J.set name (J.str "") J.empty))) (O.words "group level unit campaign")
 S.mapM_ (\name -> do
  rejected (C.select catalog (J.set name J.Null J.empty))
  rejected (C.select catalog (J.set name (J.stringArray []) J.empty))
  rejected (C.select catalog (J.set name (J.Array ((:) (J.num 1) [])) J.empty))) (O.words "inputs oracles purposes techniques families")
 S.mapM_ (\name -> do
  values <- selected catalog ("--group " ++ name)
  H.assert (S.not (S.null values) && S.all (\entry -> eqString (J.getText "group" "" entry) name) values) "primary group selection leaked another group") (O.words "language code-generation runtime-library packages-build distribution bootstrap test-infrastructure")
 S.mapM_ (notChosen catalog) (S.append
  (S.map (\flag -> flag ++ " unknown") (O.words "--group --level --unit --campaign --input --oracle --purpose --technique"))
  ((:) "--family core/absent"
  ((:) "--family core/hm-oracle --family core/hm-oracle"
  ((:) "--family core/hm-oracle --input fixed"
  ((:) "--family core/hm-oracle --input exhaustive --input transformed"
  ((:) "--family core/hm-oracle --oracle fixed-point"
  ((:) "--family core/hm-oracle --purpose performance"
  ((:) "--family core/hm-oracle --group distribution"
  ((:) "--family core/hm-oracle --level system"
  ((:) "--family core/hm-oracle --unit harness"
  ((:) "--family core/hm-oracle --campaign port"
  ((:) "--group runtime-library --technique fixed-point" []))))))))))))
 S.mapM_ (\arguments -> rejected (C.parse J.empty (O.words arguments)))
  ((:) "--category" ((:) "--family" ((:) "--input" ((:) "--unknown value"
  ((:) "--campaign unit --campaign packages" ((:) "--group language --category language"
  ((:) "--level component --level integration" ((:) "--unit core --unit harness"
  ((:) "--format xml" [])))))))))
 rejected (C.parse J.empty ((:) "--campaign" ((:) "" [])))
 rejected (C.parse J.empty ((:) "--family" ((:) "" [])))
 let labels = C.tags (C.family catalog "core/hm-oracle")
 H.assert (C.sameSet labels (O.words "group:language level:integration input:exhaustive input:seeded-random oracle:independent-reference purpose:regression purpose:conformance") && C.unique labels) "family metadata lost independent namespaced axes"
 let summary = C.selection catalog ((:) (C.family catalog "core/hm-oracle") [])
 H.assert (J.equal (J.get "granularity" summary) (J.str "verified-case-or-family") && S.eqList eqString (J.getStrings "units" summary) ((:) "core" []) && J.equal (J.get "tags" (S.head (J.values (J.get "families" summary)))) (J.stringArray labels)) "selection descriptor lost family metadata or execution ownership"
 format <- H.right (C.parse J.empty (O.words "--list --format json"))
 selector <- H.right (C.parse J.empty (O.words "--input exhaustive"))
 H.assert (S.not (C.hasSelection format) && C.hasSelection selector) "discovery formatting changed campaign scope"

batchChecks catalog = do
 let all = C.families catalog
 let batches = C.batches all
 let flattened = S.concatMap (\entry -> ids (S.snd entry)) batches
 H.assert (S.length batches == 10 && C.unique (S.map S.fst batches) && C.sameSet flattened (ids all) && C.unique flattened) "selection batches lose or repeat families"
 H.assert (S.length (S.filter (\entry -> eqString (S.fst entry) "backends" || eqString (S.fst entry) "port") batches) == 2) "backend and port receipts share an execution directory"
 H.assert (S.eqList eqString (S.map S.fst (C.batches (C.forCampaign catalog "packages"))) ((:) "packages" [])) "combined package phases would execute twice"
 H.assert (S.eqList eqString (S.map S.fst (C.batches (C.forUnit catalog "package-distribution"))) ((:) "package-distribution" [])) "single package phase was broadened"
 let mixed = (:) (C.family catalog "core/hm-oracle") ((:) (C.family catalog "package-distribution/complete") ((:) (C.family catalog "package-integration/complete") []))
 let mixedBatches = C.batches mixed
 H.assert (S.eqList eqString (S.map S.fst mixedBatches) (O.words "core packages") && C.sameSet (S.concatMap (\entry -> ids (S.snd entry)) mixedBatches) (ids mixed)) "mixed-axis family batches changed selected work"

corePartitionChecks catalog = do
 let reviewed = ids (C.forUnit catalog "core")
 H.right (CorePartitions.validate reviewed)
 H.assert (S.eqList eqString CorePartitions.targets (O.words "core-crates core-solver core-language core-modules")) "core physical target inventory changed"
 H.assert (S.length reviewed == 35 && C.sameSet (S.concatMap S.snd CorePartitions.partitions) reviewed) "core compilation shards changed logical families"
 H.right (CorePartitions.validateCompleted reviewed (S.concatMap S.snd CorePartitions.partitions))
 rejected (CorePartitions.validateCompleted reviewed (S.tail reviewed))
 rejected (CorePartitions.validateCompleted reviewed (S.snoc reviewed (S.head reviewed)))
 rejected (CorePartitions.validateCompleted reviewed (S.snoc (S.init reviewed) "core/unknown"))
 rejected (CorePartitions.validateCompleted ((:) "core/hm-oracle" []) reviewed)
 rejected (CorePartitions.validateCompleted [] [])
 rejected (CorePartitions.validate (S.tail reviewed))
 rejected (CorePartitions.validate (S.snoc reviewed (S.head reviewed)))
 rejected (CorePartitions.validate (S.reverse reviewed))
 rejected (CorePartitions.validate (S.snoc (S.init reviewed) "core/unknown"))
 H.assert (S.eqList eqString (CorePartitions.selectedTargets (O.words "core/hm-oracle core/substring-adapter")) (O.words "core-language core-modules")) "focused core selection pulls unrelated compilation targets"
 H.assert (S.eqList eqString (CorePartitions.selectedTargets ((:) "core/graph-solver" [])) ((:) "core-solver" [])) "graph family does not select its independent closure"
 H.assert (S.eqList eqString (CorePartitions.selectedTargets reviewed) CorePartitions.targets) "full core selection omits a compilation target"
 H.assert (S.null (CorePartitions.selectedTargets []) && S.null (CorePartitions.forTarget "unknown")) "empty or unknown core target broadened work"
 -- All four projections must be a disjoint exact cover of the reviewed actions,
 -- aliases and counted loops. The logical campaign/unit names remain untouched.
 let selected = S.concatMap (\((,) _ names) -> S.filter (\entry -> S.elem eqString (C.identity entry) names) (C.forUnit catalog "core")) CorePartitions.partitions
 H.assert (C.unique (ids selected) && C.sameSet (ids selected) reviewed && S.all (\entry -> eqString (C.unitName entry) "core") selected) "physical core sharding changed logical unit membership"

schemaChecks catalog = do
 S.mapM_ (\key -> do
  rejected (C.validate (J.set key J.Null catalog))
  rejected (C.validate (remove key catalog))) (O.words "schema_version granularity groups levels inputs oracles purposes profiles campaigns units families")
 rejected (C.validate J.Null)
 rejected (C.validate (J.set "schema_version" (J.num 1) catalog))
 rejected (C.validate (J.set "granularity" (J.str "execution-unit") catalog))
 rejected (C.validate (J.set "extra" (J.num 1) catalog))
 rejected (C.validate (J.set "groups" (J.stringArray (O.words "language language")) catalog))
 let firstUnit = S.head (C.units catalog)
 rejected (C.validate (J.set "units" (J.Array (S.snoc (C.units catalog) firstUnit)) catalog))
 rejected (C.validate (J.set "units" (J.Array (S.tail (C.units catalog))) catalog))
 rejected (C.validate (J.set "units" (J.Array ((:) (J.set "id" (J.num 1) firstUnit) (S.tail (C.units catalog)))) catalog))
 let hm = C.family catalog "core/hm-oracle"
 rejected (C.validate (J.set "families" (J.Array (S.snoc (C.families catalog) hm)) catalog))
 rejected (C.validate (J.set "families" (J.Array []) catalog))
 S.mapM_ (\key -> rejected (C.validate (changeFamily "core/hm-oracle" (remove key) catalog))) (O.words "id unit name group level inputs oracles purposes evidence")
 rejected (C.validate (changeFamily "core/hm-oracle" (J.set "id" (J.str "harness/forged")) catalog))
 S.mapM_ (\name -> rejected (C.validate (changeFamily "core/hm-oracle" (J.set name (J.num 1)) catalog))) (O.words "id unit name group level")
 rejected (C.validate (changeFamily "core/hm-oracle" (J.set "unit" (J.str "unknown")) catalog))
 rejected (C.validate (changeFamily "core/hm-oracle" (J.set "name" (J.str "")) catalog))
 rejected (C.validate (changeFamily "core/hm-oracle" (J.set "group" (J.str "unknown")) catalog))
 rejected (C.validate (changeFamily "core/hm-oracle" (J.set "level" (J.str "unknown")) catalog))
 rejected (C.validate (changeFamily "core/hm-oracle" (J.set "extra" (J.num 1)) catalog))
 S.mapM_ (\key -> do
  rejected (C.validate (changeFamily "core/hm-oracle" (J.set key J.Null) catalog))
  rejected (C.validate (changeFamily "core/hm-oracle" (J.set key (J.stringArray [])) catalog))
  rejected (C.validate (changeFamily "core/hm-oracle" (J.set key (J.stringArray ((:) "unknown" []))) catalog))) (O.words "inputs oracles purposes")
 rejected (C.validate (changeFamily "core/hm-oracle" (J.set "inputs" (J.stringArray (O.words "exhaustive exhaustive"))) catalog))
 rejected (C.validate (J.set "campaigns" (J.set "unit" (J.stringArray ((:) "core" [])) (J.get "campaigns" catalog)) catalog))
 rejected (C.validate (changeEvidence "core/hm-oracle" (J.set "executions" (J.stringArray ((:) "repeated" ((:) "repeated" [])))) catalog))
 rejected (C.validate (changeEvidence "core/hm-oracle" (J.set "aliases" J.Null) catalog))
 rejected (C.validate (changeEvidence "core/hm-oracle" (J.set "metrics" J.Null) catalog))
 empty <- H.right (J.parse "{\"kind\":\"coverage\",\"executions\":[],\"aliases\":{},\"metrics\":{}}")
 rejected (C.validate (changeFamily "core/hm-oracle" (J.set "evidence" empty) catalog))
 rejected (C.validate (changeEvidence "backends/strict-wrappers" (J.set "rows" (J.num 3)) catalog))
 -- Preserve aggregate counts while forging a duplicate fixture label across families.
 let backendLabel = S.head (J.getStrings "labels" (J.get "evidence" (C.family catalog "backends/strict-wrappers")))
 rejected (C.validate (changeEvidence "backends/io-runtime" (\entry -> J.set "labels" (J.stringArray ((:) backendLabel (S.tail (J.getStrings "labels" entry)))) entry) catalog))
 rejected (C.validate (changeEvidence "port/foundation" (J.set "labels" (J.stringArray ((:) "forged" []))) catalog))
 rejected (C.validate (changeFamily "port/foundation" (J.set "fixture" (J.str "forged")) catalog))
 rejected (C.validate (changeEvidence "port/foundation" (J.set "rows" (J.num 2)) catalog))
 rejected (C.validate (changeEvidence "self-host/complete" (J.set "rows" (J.num 1)) catalog))

inventoryChecks catalog inventory = do
 H.right (C.validateInventory catalog inventory)
 -- Structural metadata may be well formed yet lie about reviewed executions.
 -- These mutations must pass schema validation and fail independent partitioning.
 let missing = J.set "families" (J.Array (S.filter (\entry -> S.not (eqString (C.identity entry) "core/optimizer-uses")) (C.families catalog))) catalog
 H.right (C.validate missing)
 rejected (C.validateInventory missing inventory)
 let forgedCase = changeEvidence "core/optimizer-uses" (\entry -> J.set "executions" (J.stringArray ((:) "invented optimizer assertion" (S.tail (J.getStrings "executions" entry)))) entry) catalog
 H.right (C.validate forgedCase)
 rejected (C.validateInventory forgedCase inventory)
 let duplicateCase = changeEvidence "core/substring-adapter" (J.set "executions" (J.stringArray ((:) "independent ML typability oracle" []))) catalog
 H.right (C.validate duplicateCase)
 rejected (C.validateInventory duplicateCase inventory)
 let forgedMetric = changeEvidence "core/substring-adapter" (J.set "metrics" (J.Object ((:) ((,) "substring-executed" (J.num 12)) []))) catalog
 H.right (C.validate forgedMetric)
 rejected (C.validateInventory forgedMetric inventory)
 let duplicateMetric = changeEvidence "core/optimizer-uses" (J.set "metrics" (J.Object ((:) ((,) "substring-executed" (J.num 13)) []))) catalog
 rejected (C.validateInventory duplicateMetric inventory)
 let missingAlias = changeEvidence "figure12/complete" (J.set "aliases" J.empty) catalog
 H.right (C.validate missingAlias)
 rejected (C.validateInventory missingAlias inventory)
 let forgedAlias = changeEvidence "figure12/complete" (\entry -> J.set "aliases" (J.set "A12.1" (J.str "A12.2") (J.get "aliases" entry)) entry) catalog
 rejected (C.validateInventory forgedAlias inventory)
 let duplicateAlias = changeEvidence "figure12/complete" (\entry -> J.set "aliases" (J.Object ((:) ((,) "A12.1" (J.str "A10.1")) (J.items (J.get "aliases" entry)))) entry) catalog
 rejected (C.validateInventory duplicateAlias inventory)
 rejected (C.validateInventory catalog (J.set "schema_version" (J.num 2) inventory))
 rejected (C.validateInventory catalog J.Null)
 rejected (C.validateInventory catalog (J.set "suites" J.Null inventory))
 rejected (C.validateInventory catalog (changeSuite "core" (\_ -> J.Null) inventory))
 S.mapM_ (\name -> rejected (C.validateInventory catalog (changeSuite "core" (J.set name J.Null) inventory))) (O.words "executions aliases metrics")
 rejected (C.validateInventory catalog (J.set "suites" (remove "core" (J.get "suites" inventory)) inventory))
 rejected (C.validateInventory catalog (changeSuite "core" (\entry -> J.set "executions" (J.stringArray (S.tail (J.getStrings "executions" entry))) entry) inventory))
 rejected (C.validateInventory catalog (changeSuite "core" (\entry -> J.set "executions" (J.stringArray ((:) (S.head (J.getStrings "executions" entry)) (J.getStrings "executions" entry))) entry) inventory))
 rejected (C.validateInventory catalog (changeSuite "core" (\entry -> J.set "executions" (J.stringArray ((:) "unreviewed assertion" (J.getStrings "executions" entry))) entry) inventory))
 rejected (C.validateInventory catalog (changeSuite "core" (\entry -> J.set "metrics" (remove "hm-executed" (J.get "metrics" entry)) entry) inventory))
 rejected (C.validateInventory catalog (changeSuite "core" (\entry -> J.set "metrics" (J.set "hm-executed" (J.num 6702) (J.get "metrics" entry)) entry) inventory))
 rejected (C.validateInventory catalog (changeSuite "figure12" (\entry -> J.set "aliases" (J.set "A12.1" (J.str "A12.2") (J.get "aliases" entry)) entry) inventory))
 S.mapM_ (\name -> do
  let families = S.filter (\entry -> eqString (C.suiteName (C.unitName entry)) name) (C.coverageFamilies (C.families catalog))
  H.assert (C.unique (C.combine "executions" families) && C.sameSet (C.combine "executions" families) (J.getStrings "executions" (suite inventory name))) ("coverage partition lost reviewed cases: " ++ name)
  H.assert (J.equal (C.projection inventory name families) (suite inventory name)) ("full projection lost reviewed aliases or metrics: " ++ name)) (O.words "core harness regex figure12 test-framework packages")
 let source = C.combine "executions" (C.forUnit catalog "package-integration")
 let releases = C.combine "executions" (C.forUnit catalog "package-distribution")
 H.assert (S.length source == 51 && S.length releases == 28 && C.sameSet (S.append source releases) (J.getStrings "executions" (suite inventory "packages")) && C.unique (S.append source releases)) "package classification changed the reviewed 79-case inventory"
 substring <- H.right (J.parse "{\"executions\":[],\"aliases\":{},\"metrics\":{\"substring-executed\":13}}")
 H.assert (J.equal (C.projection inventory "core" ((:) (C.family catalog "core/substring-adapter") [])) substring) "metric-only family projection broadened coverage"
 hm <- H.right (J.parse "{\"executions\":[\"independent ML typability oracle\"],\"aliases\":{},\"metrics\":{\"hm-prescribed\":6712,\"hm-exhaustive\":1712,\"hm-generated\":5000,\"hm-distinct-generated\":4991,\"hm-executed\":6703,\"hm-typable\":2901}}")
 H.assert (J.equal (C.projection inventory "core" ((:) (C.family catalog "core/hm-oracle") [])) hm) "oracle family projection lost counted corpus oracles"
 H.assert (J.equal (C.projection inventory "core" ((:) (C.family forgedMetric "core/substring-adapter") [])) substring) "projection trusted forged metric values instead of the reviewed inventory"
 let packaged = C.projection inventory "packages" (C.forUnit catalog "package-distribution")
 H.assert (S.length (J.getStrings "executions" packaged) == 28 && C.sameSet (J.getStrings "executions" packaged) releases && S.null (J.items (J.get "metrics" packaged)) && S.null (J.items (J.get "aliases" packaged))) "one package phase projected another phase's work"

main : IO ()
main = do
 -- The framework's CLI probe also runs from tests/, so retain both cwd forms.
 directory <- canonicalPath "."
 nested <- fileExists (directory ++ "/tests/test-catalog.json")
 let root = if nested then directory else O.parent directory
 catalog <- J.read (root ++ "/tests/test-catalog.json")
 inventory <- J.read (root ++ "/tests/golden/unit-inventory.json")
 H.right (C.validate catalog)
 H.assert (C.sameSet (J.getStrings "groups" catalog) (O.words "language code-generation runtime-library packages-build distribution bootstrap test-infrastructure")) "seven primary groups changed"
 selectionChecks catalog
 batchChecks catalog
 corePartitionChecks catalog
 schemaChecks catalog
 inventoryChecks catalog inventory
 -- Keep the original flat selection contract as a regression alongside the
 -- richer family/projection protocol checks in FamilySelectionChecks.
 expected <- H.right (J.parse "{\"schema_version\":1,\"suites\":{\"sample\":{\"executions\":[\"first\",\"second\"],\"aliases\":{},\"metrics\":{}}}}")
 H.right (Coverage.validateSelection expected "sample" ((:) "first" []) partial)
 rejected (Coverage.validate expected "sample" partial)
 rejected (Coverage.validateSelection expected "sample" ((:) "first" []) (O.replace "partial" "full" partial))
 rejected (Coverage.validateSelection expected "sample" ((:) "second" []) partial)
 rejected (Coverage.validateSelection expected "sample" (O.words "first second") partial)
 rejected (Coverage.validateSelection expected "sample" (O.words "first first") partial)
 rejected (Coverage.validateSelection expected "sample" ((:) "absent" []) partial)
 rejected (Coverage.validateSelection expected "sample" [] partial)
 putStrLn "Test catalog classification and selection contracts passed"
