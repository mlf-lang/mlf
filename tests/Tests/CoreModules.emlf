module Tests.CoreModules where
import Prelude hiding (listDirectory, Monad, return, bind)
import MLF.Primitive (Monad, return, bind)
import qualified Test.Assert as A
import Bootstrap.Types
import qualified Tests.CoreRegistry as Registry
import qualified Bootstrap.Std as S
import Bootstrap.Compiler
import Bootstrap.X.Pretty
import qualified Bootstrap.X.Parser as XP
import qualified Bootstrap.X.Check as C
import qualified Tests.Helpers as H
import qualified Tests.Coverage as Coverage
import Tests.CoreHelpers
import Tests.Oracle (hmTypable, closedTerms, generatedTerms, distinctTermCases)
import Tests.System
import Tests.Readability (readabilityCases)
import Tests.Modules (moduleCases, fileCase, fileTests)
import Tests.Separate (separateCases, pathCase, cratePaths)
import Tests.StateTypes (stateTypeTests)

reportText : String -> IO ()
reportText message = do
 machine <- getEnv "MLF_TEST_CORE_JSON"
 if eqString machine "1" then putErr (message ++ "\n") else putStrLn message

counted : forall a. String -> [] a -> (a -> A.Test ()) -> A.Test ()
counted metric inputs action = do
 S.mapM_ action inputs
 A.liftIO (Coverage.metric "core" metric (S.length inputs))

oracleTest : A.Test ()
oracleTest = do
 let exhaustive = closedTerms 6
 let seeded = generatedTerms 5000
 let unique = distinctTermCases seeded
 let terms = S.append (S.zip (S.range 1 1712) exhaustive) (S.map (\((,) seed e) -> (,) (1712 + seed) e) unique)
 let cases = S.map (\((,) i e) -> (,,) i e (hmTypable e)) terms
 A.assert (S.length exhaustive == 1712 && S.length seeded == 5000 && S.length unique == 4991) "independent HM corpus coverage changed"
 let typed = S.length (S.filter (\((,,) _ _ expected) -> expected) cases)
 A.assert (typed > 100 && typed < S.length cases) "oracle corpus lacks positive or negative cases"
 counted "hm-executed" cases (\((,,) i e expected) -> case compileExpr e of
  Right _ -> A.assert expected ("accepted non-ML term " ++ H.show i ++ ": " ++ H.show e)
  Left err -> do
   A.assert (H.eq (phase err) Inference) ("compiler failure on " ++ H.show e ++ ": " ++ H.show err)
   A.assert (S.not expected) ("rejected ML term " ++ H.show i ++ ": " ++ H.show e ++ "\n" ++ H.show err))
 A.liftIO (reportText ("Oracle: 6712 cases; 6703 executions (1712 exhaustive, 4991 distinct of 5000 seeded); " ++ H.show typed ++ " typable"))
 A.liftIO (Coverage.metric "core" "hm-prescribed" (S.length exhaustive + S.length seeded))
 A.liftIO (Coverage.metric "core" "hm-exhaustive" (S.length exhaustive))
 A.liftIO (Coverage.metric "core" "hm-generated" (S.length seeded))
 A.liftIO (Coverage.metric "core" "hm-distinct-generated" (S.length unique))
 A.liftIO (Coverage.metric "core" "hm-typable" typed)

annotationCorpus : A.Test ()
annotationCorpus = (let { identityExpr = (SLam "x" Nothing (SVar "x")) } in (let { identityType = (SForall Flexible "a" SBottom (SArrow (STVar "a") (STVar "a"))) } in (let { types = ((:) SBottom ((:) (SCon "Int" []) ((:) (SCon "Bool" []) ((:) identityType ((:) (SForall Flexible "a" SBottom (SCon "List" ((:) (STVar "a") []))) ((:) (SForall Flexible "a" identityType (SArrow (STVar "a") (STVar "a"))) [])))))) } in (let { nested = (H.append types (S.concatMap (\a -> (S.concatMap (\b -> ((:) (SArrow a b) [])) types)) types)) } in (let { programs = (S.concat (S.concatMap (\t -> ((:) ((:) (SAnn identityExpr (SAnnotation [] (SArrow t t))) ((:) (SLam "x" (Just (SAnnotation [] t)) (SVar "x")) ((:) (SLet "f" (SAnn identityExpr (SAnnotation [] (SArrow t t))) (SVar "f")) []))) [])) nested)) } in do { ((counted "annotation-executed" programs) (\e -> (case (compileExpr e) of { (Left err) -> (A.fail (H.append "failed annotated identity " (H.append (H.show e) (H.append "\n" (H.show err))))); (Right r) -> do { parsed <- (A.right H.show (XP.parseTerm "<annotation xMLF>" (prettyTerm (compiledTerm r)))); do { ty <- (A.right H.show (C.checkClosed parsed)); (assertSameType ty (inferredType r)) } } }))); (A.liftIO (reportText (H.append "Annotations: " (H.append (H.show (H.length programs)) " typed programs")))) })))))

examplesTest : IO ()
examplesTest = do { files <- (H.fmap (S.compose H.sort (S.filter (\section1 -> (H.contains ".emlf" section1)))) (listDirectory "examples")); do { (H.assert ((H.length files) >= 6) "example files are missing"); ((H.forM_ files) (\file -> (bind (bind (readFile (H.append "examples/" file)) compileOK) (\ignored -> (return ()))))) } }

moduleActions : [] ((,) String Registry.Action)
moduleActions = S.map (\((,) label action) ->
 if eqString label (S.fst fileCase) then (,) label (Registry.Isolated fileTests)
 else (,) label (Registry.Recoverable action)) moduleCases

separateActions : [] ((,) String Registry.Action)
separateActions = S.map (\((,) label action) ->
 if eqString label (S.fst pathCase) then (,) label (Registry.Isolated cratePaths)
 else (,) label (Registry.Recoverable action)) separateCases

families : [] ((,) String ([] ((,) String Registry.Action)))
families =
 (:) ((,) "core/readability" (Registry.recoverable readabilityCases))
 ((:) ((,) "core/modules" (moduleActions))
 ((:) ((,) "core/separate-compilation" (separateActions))
 ((:) ((,) "core/state-types" (Registry.recoverable stateTypeTests))
 ((:) ((,) "core/hm-oracle" (Registry.recoverable ((:) ((,) "independent ML typability oracle" oracleTest) [])))
 ((:) ((,) "core/annotation-corpus" (Registry.recoverable ((:) ((,) "annotation corpus" annotationCorpus) [])))
 ((:) ((,) "core/example-files" (Registry.isolated ((:) ((,) "example files" examplesTest) [])))
 []))))))
