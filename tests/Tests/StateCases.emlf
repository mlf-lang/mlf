module Tests.StateCases where
import Bootstrap.Types
import qualified Bootstrap.Std as S


stateTypeCases : (List ( (Quad (String) (Bool) (String) (Maybe String)) ))
stateTypeCases = (Cons (Quad "return" true "runST (stReturn 42)" (Just "Int")) (Cons (Quad "bind" true "runST (stBind (stReturn 4) (\\n -> stReturn (n + 3)))" (Just "Int")) (Cons (Quad "array-read" true "runST (stBind (newSTArray 2 42) (\\a -> readSTArray a 1))" (Just "Int")) (Cons (Quad "array-write" true "runST (stBind (newSTArray 2 0) (\\a -> stBind (writeSTArray a 1 42) (\\_ -> readSTArray a 1)))" (Just "Int")) (Cons (Quad "array-length" true "runST (stBind (newSTArray 3 true) lengthSTArray)" (Just "Int")) (Cons (Quad "implicit-do" true "action : forall s. ST s Int\naction = do { a <- newSTArray 2 0; writeSTArray a 1 42; readSTArray a 1 }\nmain = runST action" (Just "Int")) (Cons (Quad "implicit-return" true "action : forall s. ST s Int\naction = do { a <- newSTArray 2 0; n <- readSTArray a 1; return n }\nmain = runST action" (Just "Int")) (Cons (Quad "explicit-action-signature" true "let action : forall s. ST s Int = stBind (newSTArray 2 0) (\\array -> stBind (writeSTArray array 1 37) (\\_ -> readSTArray array 1)) in runST action" (Just "Int")) (Cons (Quad "polymorphic-result" true "runST (stReturn ((\\x -> x) : forall a. a -> a))" Nothing) (Cons (Quad "impredicative-array-functions" true "data Pair a b = Pair a b; runST (stBind (newSTArray 1 ((\\x -> x) : forall a. a -> a)) (\\array -> stBind (readSTArray array 0) (\\(f : forall a. a -> a) -> stReturn (Pair (f 42) (f true)))))" (Just "Pair Int Bool")) (Cons (Quad "nested-independent" true "runST (stBind (newSTArray 1 3) (\\a -> stBind (readSTArray a 0) (\\x -> stReturn (x + runST (stBind (newSTArray 1 4) (\\b -> readSTArray b 0))))))" (Just "Int")) (Cons (Quad "reuse-independent-allocation" true "let alloc = newSTArray 1 9 in runST (stBind alloc (\\a -> readSTArray a 0)) + runST (stBind alloc (\\a -> readSTArray a 0))" (Just "Int")) (Cons (Quad "pure-io-description-result" true "runST (stReturn (putStrLn \"safe description\"))" (Just "IO Unit")) (Cons (Quad "unused-poisoned-cell" true "runST (stBind (newSTArray 1 (panic \"unused\")) lengthSTArray)" (Just "Int")) (Cons (Quad "snapshot" true "runST (stBind (newSTArray 1 1) (\\a -> stBind (readSTArray a 0) (\\old -> stBind (writeSTArray a 0 2) (\\_ -> stReturn old))))" (Just "Int")) (Cons (Quad "repeated-read-action" true "runST (stBind (newSTArray 1 1) (\\a -> let read = readSTArray a 0 in stBind read (\\x -> stBind (writeSTArray a 0 2) (\\_ -> stBind read (\\y -> stReturn (x + y))))))" (Just "Int")) (Cons (Quad "higher-order-runner" true "let runner : forall a. (forall s. ST s a) -> a = runST in runner (stReturn 7)" (Just "Int")) (Cons (Quad "primitive-shadowing" true "let runST = \\x -> x in runST 7" (Just "Int")) (Cons (Quad "qualified-prelude-import" true "module Main where\nimport qualified Prelude as P\nmain = P.runST (P.stBind (P.newSTArray 1 8) (\\a -> P.readSTArray a 0))" (Just "Int")) (Cons (Quad "explicit-prelude-types" true "module Main where\nimport Prelude (Int, ST, STArray, runST, stBind, newSTArray, readSTArray)\naction : forall s. ST s Int\naction = stBind (newSTArray 1 7) (\\a -> readSTArray a 0)\nmain = runST action" (Just "Int")) (Cons (Quad "opaque-existential-package" true "data Hidden = Hidden ((forall t. STArray t Int -> Int) -> Int); runST (stBind (newSTArray 1 0) (\\a -> stReturn (Hidden (\\(f : forall t. STArray t Int -> Int) -> f a))))" (Just "Hidden")) (Cons (Quad "opaque-parametric-callback" true "runST (stBind (newSTArray 1 0) (\\a -> stReturn (\\(f : forall t. STArray t Int -> Int) -> f a)))" Nothing) (Cons (Quad "escape-array" false "runST (newSTArray 1 0)" Nothing) (Cons (Quad "escape-through-bind" false "runST (stBind (newSTArray 1 0) (\\a -> stReturn a))" Nothing) (Cons (Quad "escape-through-data" false "data Box a = Box a; runST (stBind (newSTArray 1 0) (\\a -> stReturn (Box a)))" Nothing) (Cons (Quad "escape-read-action" false "runST (stBind (newSTArray 1 0) (\\a -> stReturn (readSTArray a 0)))" Nothing) (Cons (Quad "escape-write-action" false "runST (stBind (newSTArray 1 0) (\\a -> stReturn (writeSTArray a 0 1)))" Nothing) (Cons (Quad "escape-reader-closure" false "runST (stBind (newSTArray 1 0) (\\a -> stReturn (\\i -> readSTArray a i)))" Nothing) (Cons (Quad "nested-read-outer-region" false "runST (stBind (newSTArray 1 0) (\\a -> stReturn (runST (readSTArray a 0))))" Nothing) (Cons (Quad "nested-write-outer-region" false "runST (stBind (newSTArray 1 0) (\\a -> stReturn (runST (writeSTArray a 0 1))))" Nothing) (Cons (Quad "cross-region-read-signature" false "let cross : forall s t. STArray s Int -> ST t Int = \\a -> readSTArray a 0 in 0" Nothing) (Cons (Quad "cross-region-write-signature" false "let cross : forall s t. STArray s Int -> ST t Unit = \\a -> writeSTArray a 0 1 in 0" Nothing) (Cons (Quad "monomorphic-argument" false "runST (stReturn 7 : ST Int Int)" Nothing) (Cons (Quad "monomorphic-bound-argument" false "(\\(action : ST Int Int) -> runST action) (stReturn 7)" Nothing) (Cons (Quad "monomorphic-runner-signature" false "let runner : forall s a. ST s a -> a = runST in 0" Nothing) (Cons (Quad "io-as-st" false "runST (ioReturn 7)" Nothing) (Cons (Quad "bind-io-action" false "stBind (putStrLn \"bad\") (\\_ -> stReturn 7)" Nothing) (Cons (Quad "bind-io-continuation" false "stBind (stReturn 7) (\\n -> printInt n)" Nothing) (Cons (Quad "io-bind-st-action" false "ioBind (stReturn 7) (\\n -> printInt n)" Nothing) (Cons (Quad "io-array-as-st-array" false "\\(a : IntArray) -> readSTArray a 0" Nothing) (Cons (Quad "wrong-array-value-type" false "runST (stBind (newSTArray 1 0) (\\a -> stBind (writeSTArray a 0 true) (\\_ -> readSTArray a 0)))" Nothing) (Cons (Quad "polymorphic-reference-attack" false "runST (stBind (newSTArray 1 (\\x -> x)) (\\a -> stBind (writeSTArray a 0 (\\x -> x + 1)) (\\_ -> stBind (readSTArray a 0) (\\f -> stReturn (f true)))))" Nothing) (Cons (Quad "impredicative-reference-attack" false "runST (stBind (newSTArray 1 ((\\x -> x) : forall a. a -> a)) (\\a -> stBind (writeSTArray a 0 (\\x -> x + 1)) (\\_ -> stBind (readSTArray a 0) (\\(f : forall a. a -> a) -> stReturn (f true)))))" Nothing) (Cons (Quad "repackage-action-as-region-polymorphic" false "runST (stBind (newSTArray 1 0) (\\a -> stReturn ((readSTArray a 0) : forall s. ST s Int)))" Nothing) (Cons (Quad "existential-coercion-escape" false "runST (stBind (newSTArray 1 (panic \"poly\")) (\\a -> stReturn (a : exists t. STArray t Int)))" Nothing) (Cons (Quad "opaque-package-read-attack" false "let hidden = runST (stBind (newSTArray 1 0) (\\a -> stReturn (\\(f : forall t. STArray t Int -> Int) -> f a))) in hidden (\\a -> runST (readSTArray a 0))" Nothing) (Cons (Quad "opaque-package-write-attack" false "let hidden = runST (stBind (newSTArray 1 0) (\\a -> stReturn (\\(f : forall t. STArray t Int -> Int) -> f a))) in hidden (\\a -> seq (runST (writeSTArray a 0 1)) 0)" Nothing) (Cons (Quad "redefine-st" false "data ST s a = Forge a; 0" Nothing) (Cons (Quad "redefine-array" false "data STArray s a = Forge a; 0" Nothing) (Cons (Quad "construct-opaque-st" false "ST 7" Nothing) (Cons (Quad "construct-opaque-array" false "STArray 7" Nothing) (Cons (Quad "pattern-opaque-st" false "case stReturn 7 of ST x -> x" Nothing) (Cons (Quad "st-wrong-arity" false "panic \"unused\" : ST Int" Nothing) (Cons (Quad "array-wrong-arity" false "panic \"unused\" : STArray Int" Nothing) (Cons (Quad "st-region-wrong-kind" false "panic \"unused\" : ST IO Int" Nothing) (Cons (Quad "array-element-wrong-kind" false "panic \"unused\" : STArray Int IO" Nothing) Nil))))))))))))))))))))))))))))))))))))))))))))))))))))))))

stateTargetCases : (List ( (Triple (String) (Bool) (String)) ))
stateTargetCases = (Cons (Triple "rank2-runner" true "primitive runST(Int)") (Cons (Triple "monomorphic-action-value" true "primitive stReturn(Int, Int) 7") (Cons (Triple "rank2-region-action" true "primitive runST(Int) (/\\(a1 >= bot) -> primitive stReturn(a1, Int) 7)") (Cons (Triple "monomorphic-runST-input" false "primitive runST(Int) (primitive stReturn(Int, Int) 7)") (Cons (Triple "outer-forall-cannot-replace-inner" false "/\\(a1 >= bot) -> \\(action_1 : ST a1 Int) -> primitive runST(Int) action_1") (Cons (Triple "io-to-st-cast" false "primitive runST(Int) (/\\(a1 >= bot) -> primitive ioReturn(Int) 7)") (Cons (Triple "cross-region-read" false "/\\(a1 >= bot) -> /\\(a2 >= bot) -> \\(array_1 : STArray a1 Int) -> primitive readSTArray(a2, Int) array_1 0") (Cons (Triple "cross-region-write" false "/\\(a1 >= bot) -> /\\(a2 >= bot) -> \\(array_1 : STArray a1 Int) -> primitive writeSTArray(a2, Int) array_1 0 1") (Cons (Triple "unbound-region" false "primitive stReturn(a999, Int) 7") (Cons (Triple "runST-extra-type-argument" false "primitive runST(Int, Int)") (Cons (Triple "higher-kind-region" false "primitive stReturn(IO, Int) 7") (Cons (Triple "unexecuted-array-action" false "primitive readSTArray(Int, Int) (primitive newSTArray(Int, Int) 1 0) 0") Nil))))))))))))

stateRuntimeCases : (List ( (Quad (String) (String) (String) (Maybe String)) ))
stateRuntimeCases = (Cons (Quad "return" "printInt (runST (stReturn 42))" "42\n" Nothing) (Cons (Quad "write-read" "printInt (runST (stBind (newSTArray 2 0) (\\a -> stBind (writeSTArray a 1 42) (\\_ -> readSTArray a 1))))" "42\n" Nothing) (Cons (Quad "length-zero-lazy-initial" "printInt (runST (stBind (newSTArray 0 (panic \"unused initial\")) lengthSTArray))" "0\n" Nothing) (Cons (Quad "length-lazy-initial" "printInt (runST (stBind (newSTArray 100 (panic \"unused initial\")) lengthSTArray))" "100\n" Nothing) (Cons (Quad "snapshot" "printInt (runST (stBind (newSTArray 1 1) (\\a -> stBind (readSTArray a 0) (\\old -> stBind (writeSTArray a 0 2) (\\_ -> stReturn old)))))" "1\n" Nothing) (Cons (Quad "repeated-read-action" "printInt (runST (stBind (newSTArray 1 1) (\\a -> let read = readSTArray a 0 in stBind read (\\x -> stBind (writeSTArray a 0 2) (\\_ -> stBind read (\\y -> stReturn (x + y)))))))" "3\n" Nothing) (Cons (Quad "allocation-actions-repeat" "printInt (runST (let alloc = newSTArray 1 3 in stBind alloc (\\a -> stBind alloc (\\b -> stBind (writeSTArray a 0 99) (\\_ -> readSTArray b 0)))))" "3\n" Nothing) (Cons (Quad "array-aliases" "printInt (runST (stBind (newSTArray 1 3) (\\a -> stBind (stReturn a) (\\b -> stBind (writeSTArray a 0 99) (\\_ -> readSTArray b 0)))))" "99\n" Nothing) (Cons (Quad "separate-regions" "printInt (let alloc = newSTArray 1 3 in runST (stBind alloc (\\a -> stBind (writeSTArray a 0 9) (\\_ -> readSTArray a 0))) + runST (stBind alloc (\\a -> readSTArray a 0)))" "12\n" Nothing) (Cons (Quad "nested-regions" "printInt (runST (stBind (newSTArray 1 3) (\\a -> stBind (readSTArray a 0) (\\x -> stReturn (x + runST (stBind (newSTArray 1 4) (\\b -> readSTArray b 0)))))))" "7\n" Nothing) (Cons (Quad "large-integer" "printInt (runST (stBind (newSTArray 1 1267650600228229401496703205376) (\\a -> stBind (readSTArray a 0) (\\n -> stBind (writeSTArray a 0 (0 - n)) (\\_ -> readSTArray a 0)))))" "-1267650600228229401496703205376\n" Nothing) (Cons (Quad "unused-written-poison" "printInt (runST (stBind (newSTArray 2 7) (\\a -> stBind (writeSTArray a 1 (panic \"unused written\")) (\\_ -> readSTArray a 0))))" "7\n" Nothing) (Cons (Quad "unused-return-poison" "printInt (seq (runST (stReturn (\\x -> panic \"unused closure body\"))) 7)" "7\n" Nothing) (Cons (Quad "unused-actions" "printInt (seq (writeSTArray (panic \"array\") (panic \"index\") (panic \"element\")) 7)" "7\n" Nothing) (Cons (Quad "prelude-do" "action : forall s. ST s Int\naction = do { a <- newSTArray 1 0; writeSTArray a 0 23; n <- readSTArray a 0; return n }\nmain = printInt (runST action)" "23\n" Nothing) (Cons (Quad "polymorphic-elements" "data Pair a b = Pair a b; main = case runST (stBind (newSTArray 1 ((\\x -> x) : forall a. a -> a)) (\\a -> stBind (readSTArray a 0) (\\(f : forall a. a -> a) -> stReturn (Pair (f 42) (f true))))) of Pair n yes -> printInt (if yes then n else 0)" "42\n" Nothing) (Cons (Quad "constructor-elements" "data Box a = Box a; main = case runST (stBind (newSTArray 1 (Box 4)) (\\a -> stBind (writeSTArray a 0 (Box 9)) (\\_ -> readSTArray a 0))) of Box n -> printInt n" "9\n" Nothing) (Cons (Quad "recursive-elements" "data Stream = Stream Int Stream; let rec value : Stream = Stream 5 value in case runST (stBind (newSTArray 1 value) (\\a -> readSTArray a 0)) of Stream x rest -> case rest of Stream y unused -> printInt (x + y)" "10\n" Nothing) (Cons (Quad "opaque-package" "data Hidden = Hidden ((forall t. STArray t Int -> Int) -> Int); main = case runST (stBind (newSTArray 1 0) (\\a -> stReturn (Hidden (\\(f : forall t. STArray t Int -> Int) -> f a)))) of Hidden consume -> printInt (consume (\\unused -> 17))" "17\n" Nothing) (Cons (Quad "io-description-result" "main = runST (stReturn (putStrLn \"description\"))" "description\n" Nothing) (Cons (Quad "order" "main = do { putStrLn \"before\"; printInt (runST (stReturn (panic \"forced result\"))); putStrLn \"after\" }" "before\n" (Just "forced result")) (Cons (Quad "nested-poison-order" "main = do { putStrLn \"before\"; printInt (runST (stBind (newSTArray 1 (panic \"forced cell\")) (\\a -> readSTArray a 0))); putStrLn \"after\" }" "before\n" (Just "forced cell")) (Cons (Quad "negative-size" "printInt (runST (stBind (newSTArray (-1) 0) lengthSTArray))" "" (Just "invalid array length")) (Cons (Quad "huge-size" "printInt (runST (stBind (newSTArray 1267650600228229401496703205376 0) lengthSTArray))" "" (Just "invalid array length")) (Cons (Quad "negative-index" "printInt (runST (stBind (newSTArray 2 0) (\\a -> readSTArray a (-1))))" "" (Just "array index out of bounds")) (Cons (Quad "past-end" "printInt (runST (stBind (newSTArray 2 0) (\\a -> readSTArray a 2)))" "" (Just "array index out of bounds")) (Cons (Quad "huge-index" "printInt (runST (stBind (newSTArray 2 0) (\\a -> readSTArray a 1267650600228229401496703205376)))" "" (Just "array index out of bounds")) (Cons (Quad "empty-array-read" "printInt (runST (stBind (newSTArray 0 0) (\\a -> readSTArray a 0)))" "" (Just "array index out of bounds")) (Cons (Quad "negative-write-index" "printInt (runST (stBind (newSTArray 2 0) (\\a -> stBind (writeSTArray a (-1) (panic \"unused cell\")) (\\_ -> readSTArray a 0))))" "" (Just "array index out of bounds")) (Cons (Quad "past-end-write" "printInt (runST (stBind (newSTArray 2 0) (\\a -> stBind (writeSTArray a 2 (panic \"unused cell\")) (\\_ -> readSTArray a 0))))" "" (Just "array index out of bounds")) (Cons (Quad "huge-write-index" "printInt (runST (stBind (newSTArray 2 0) (\\a -> stBind (writeSTArray a 1267650600228229401496703205376 (panic \"unused cell\")) (\\_ -> readSTArray a 0))))" "" (Just "array index out of bounds")) (Cons (Quad "bool-whnf" "printInt (if runST (stReturn (eqString \"same\" \"same\")) then 42 else panic \"wrong Bool WHNF\")" "42\n" Nothing) (Cons (Quad "int-whnf" "printInt (runST (stReturn (readInt \"123456789012345678901234567890\")) + 1)" "123456789012345678901234567891\n" Nothing) (Cons (Quad "double-whnf" "putStrLn (formatDouble 2 (addDouble (runST (stReturn (readDouble \"1.25\"))) 0.5))" "1.75\n" Nothing) (Cons (Quad "lazy-data-result" "data Pair = Pair Int Int; case runST (stReturn (Pair (readInt \"42\") (panic \"unused field\"))) of { Pair first _ -> printInt first }" "42\n" Nothing) (Cons (Quad "polymorphic-function-result" "let f = runST (stReturn ((\\x -> x) : forall a. a -> a)) in do { printInt (f 42); printInt (if f true then 1 else 0) }" "42\n1\n" Nothing) (Cons (Quad "primitive-laziness" "do { unused <- ioReturn (runST (stBind (newSTArray (panic \"unused size\") (panic \"unused entry\")) (\\a -> lengthSTArray a))); printInt 42 }" "42\n" Nothing) (Cons (Quad "ignored-bind-result" "printInt (runST (stBind (stReturn (panic \"unused bind result\")) (\\_ -> stReturn 42)))" "42\n" Nothing) (Cons (Quad "recursive-state-worker" "let rec loop a n : forall s. STArray s Int -> Int -> ST s Int = if n == 0 then readSTArray a 0 else stBind (readSTArray a 0) (\\x -> stBind (writeSTArray a 0 (x + 1)) (\\_ -> loop a (n - 1))) in printInt (runST (stBind (newSTArray 1 0) (\\a -> loop a 1000)))" "1000\n" Nothing) (Cons (Quad "case-state-worker" "data Choice = Take Int | Skip; let choose = \\c -> case c of { Take n -> stReturn (n + 1); Skip -> stReturn 0 } in let input = if eqString \"same\" \"same\" then Take (readInt \"41\") else Skip in printInt (runST (choose input))" "42\n" Nothing) (Cons (Quad "lazy-default-case" "printInt (runST (case panic \"unused scrutinee\" of { _ -> stReturn 42 }))" "42\n" Nothing) (Cons (Quad "strict-worker-constructor" "data Box = Box Int; let create = \\n -> if n == 0 then stReturn (Box n) else stReturn (Box n) in case runST (create (readInt \"42\")) of { Box n -> printInt (n + 1) }" "43\n" Nothing) (Cons (Quad "strict-captured-constructor" "data Box = Box Int; let n = readInt \"42\" in let create = \\u -> if n == 0 then stReturn (Box n) else stReturn (Box (n + u)) in case runST (create 0) of { Box n -> printInt (n + 1) }" "43\n" Nothing) (Cons (Quad "strict-let-constructor" "data Box = Box Int; let make = \\text -> let n = readInt text in if n == 0 then stReturn (Box n) else stReturn (Box n) in case runST (make \"42\") of { Box n -> printInt (n + 1) }" "43\n" Nothing) (Cons (Quad "partial-continuation" "let save = \\a n -> writeSTArray a 0 n in printInt (runST (stBind (newSTArray 1 0) (\\a -> stBind (stBind (stReturn 42) (save a)) (\\_ -> readSTArray a 0))))" "42\n" Nothing) (Cons (Quad "dynamic-continuation" "let choose = \\flag k m -> if flag then k else m in printInt (runST (stBind (newSTArray 1 0) (\\a -> stBind (stBind (stReturn 42) (choose (eqString \"yes\" \"yes\") (\\n -> writeSTArray a 0 n) (\\n -> writeSTArray a 0 (n + 1)))) (\\_ -> readSTArray a 0))))" "42\n" Nothing) (Cons (Quad "deferred-state-poison" "do { putStrLn \"before\"; printInt (runST (stBind (newSTArray 1 (panic \"snapshot poison\")) (\\a -> stBind (readSTArray a 0) (\\old -> stBind (writeSTArray a 0 42) (\\_ -> stReturn old))))); putStrLn \"after\" }" "before\n" (Just "snapshot poison")) (Cons (Quad "branch-laziness" "printInt (runST (stBind (newSTArray 1 42) (\\a -> if eqString \"yes\" \"yes\" then readSTArray a 0 else stBind (writeSTArray a (panic \"bad index\") 0) (\\_ -> stReturn 0))))" "42\n" Nothing) (Cons (Quad "sequence-in-state" "printInt (runST (seq (readInt \"7\") (stBind (newSTArray 1 42) (\\a -> readSTArray a 0))))" "42\n" Nothing) (Cons (Quad "bounded-non-tail-state-worker" "let rec loop a n : forall s. STArray s Int -> Int -> ST s Unit = if n == 0 then stReturn Unit else stBind (loop a (n - 1)) (\\_ -> writeSTArray a 0 n) in printInt (runST (stBind (newSTArray 1 0) (\\a -> stBind (loop a 4096) (\\_ -> readSTArray a 0))))\n" "4096\n" Nothing) (Cons (Quad "bounded-tail-state-worker" "let rec loop a n : forall s. STArray s Int -> Int -> ST s Unit = if n == 0 then stReturn Unit else stBind (writeSTArray a 0 n) (\\_ -> loop a (n - 1)) in printInt (runST (stBind (newSTArray 1 0) (\\a -> stBind (loop a 4096) (\\_ -> readSTArray a 0))))\n" "1\n" Nothing) (Cons (Quad "bounded-mixed-tail-state-worker" "outer : forall s. STArray s Int -> Int -> ST s Unit\nouter a n = if n == 0 then stReturn Unit else stBind (inner a (n - 1)) (\\_ -> writeSTArray a 0 n)\ninner : forall s. STArray s Int -> Int -> ST s Unit\ninner a n = if n < 0 then stReturn Unit else outer a n\nmain = printInt (runST (stBind (newSTArray 1 0) (\\a -> stBind (outer a 4096) (\\_ -> readSTArray a 0))))\n" "4096\n" Nothing) (Cons (Quad "single-use-action-alias" "printInt (runST (let action = stBind (newSTArray 1 3) (\\a -> stBind (writeSTArray a 0 42) (\\_ -> readSTArray a 0)) in stBind action (\\n -> stReturn (n + 1))))" "43\n" Nothing) Nil)))))))))))))))))))))))))))))))))))))))))))))))))))))

stateRuntimeSuccesses : (List ( (Triple (String) (String) (String)) ))
stateRuntimeSuccesses = (S.concatMap (\comprehension1 -> case comprehension1 of { (Quad label source output Nothing) -> (Cons (Triple label source output) Nil); _ -> Nil }) stateRuntimeCases)
