module Tests.StrictFieldAnalysis where
import Bootstrap.Types
import qualified Bootstrap.Std as S
import qualified Package.OS as OS
import qualified Tests.Helpers as H
import Tests.Helpers (Quint(..), Sext(..))
import qualified Tests.Map as M
import qualified Bootstrap.LLVM.Analysis as A
import qualified Bootstrap.Primitive as P
import qualified Bootstrap.X.Syntax as X
import qualified Bootstrap.LLVM.StrictFields as F

n : Int -> XName
n i = (XName i "probe")

v : Int -> XErased
v = (S.compose XEVar n)

apps : XErased -> (List ( XErased )) -> XErased
apps = (S.foldl XEApp)

con : String -> (List ( XErased )) -> XErased
con c = (apps (XEConstructor c))

seqE : XErased -> XErased -> XErased
seqE a b = (apps (XEPrimitive PSeq) (Cons a (Cons b Nil)))

absE : Int -> XErased -> XErased
absE = (S.compose XEAbs n)

letE : Int -> XErased -> XErased -> XErased
letE = (S.compose XELet n)

recE : (List ( (Pair (Int) (XErased)) )) -> XErased -> XErased
recE bs = (XELetRec (S.concatMap (\(Pair i e) -> (Cons (Pair (n i) e) Nil)) bs))

cs : Map String Int
cs = (M.fromList (Cons (Pair "C" 3) (Cons (Pair "One" 1) (Cons (Pair "Wrap" 1) (Cons (Pair "Empty" 0) Nil)))))

poison : XErased
poison = (apps (XEPrimitive PPanic) (Cons (XEString "unused") Nil))

strictFunction : XErased
strictFunction = (absE 1 (absE 2 (absE 3 (seqE (v 1) (seqE (v 3) (con "C" (Cons (v 1) (Cons (v 2) (Cons (v 3) Nil)))))))))

worker : XErased
worker = (letE 0 strictFunction (apps (v 0) (Cons (XEInt 1) (Cons poison (Cons (XEInt 3) Nil)))))

cases : (List ( (Quad (String) (String) (XErased) (Maybe (List ( Bool )))) ))
cases = (Cons (Quad "strict worker, lazy value" "C" worker (Just (Cons true (Cons false (Cons true Nil))))) (Cons (Quad "partial escape invalidates all" "C" (letE 4 (XEConstructor "C") worker) (Just (Cons false (Cons false (Cons false Nil))))) (Cons (Quad "literal and constructor atoms" "C" (con "C" (Cons (XEInt 1) (Cons (con "One" (Cons poison Nil)) (Cons (XEAbs (n 9) poison) Nil)))) (Just (Cons true (Cons true (Cons true Nil))))) (Cons (Quad "meet across sites" "C" (letE 8 worker (con "C" (Cons poison (Cons (XEInt 2) (Cons (XEInt 3) Nil))))) (Just (Cons false (Cons false (Cons true Nil))))) (Cons (Quad "anonymous callback drops capture facts" "One" (letE 0 (absE 1 (seqE (v 1) (absE 2 (con "One" (Cons (v 1) Nil))))) (apps (v 0) (Cons (XEInt 1) Nil))) (Just (Cons false Nil))) (Cons (Quad "compound suspension drops capture facts" "One" (letE 0 (absE 1 (seqE (v 1) (con "Wrap" (Cons (seqE (XEInt 1) (con "One" (Cons (v 1) Nil))) Nil)))) (apps (v 0) (Cons (XEInt 1) Nil))) (Just (Cons false Nil))) (Cons (Quad "strict let canonical result" "One" (letE 1 (apps (XEPrimitive PAddInt) (Cons (XEInt 1) (Cons (XEInt 2) Nil))) (seqE (v 1) (con "One" (Cons (v 1) Nil)))) (Just (Cons true Nil))) (Cons (Quad "recursive hole remains unknown" "One" (recE (Cons (Pair 1 (XEInt 1)) Nil) (seqE (v 1) (con "One" (Cons (v 1) Nil)))) (Just (Cons false Nil))) (Cons (Quad "unused constructor has no vacuous fact" "C" (XEInt 0) Nothing) (Cons (Quad "pattern fields remain unknown" "One" (XECase (con "C" (Cons (XEInt 1) (Cons (XEInt 2) (Cons (XEInt 3) Nil)))) (Cons (XErasedAlternative (XConstructorPattern "C" (Cons (Just (n 1)) (Cons Nothing (Cons Nothing Nil)))) (con "One" (Cons (v 1) Nil))) Nil)) (Just (Cons false Nil))) (Cons (Quad "lazy default binder remains unknown" "One" (XECase (XEInt 1) (Cons (XErasedAlternative (XDefaultPattern (Just (n 1))) (con "One" (Cons (v 1) Nil))) Nil)) (Just (Cons false Nil))) (Cons (Quad "checked default binder is canonical" "One" (XECase (XEConstructor "Empty") (Cons (XErasedAlternative (XConstructorPattern "Empty" Nil) (con "One" (Cons (XEInt 1) Nil))) (Cons (XErasedAlternative (XDefaultPattern (Just (n 1))) (con "One" (Cons (v 1) Nil))) Nil))) (Just (Cons true Nil))) Nil))))))))))))

strictFieldAnalysisTests : (List ( (Pair (String) (IO Unit)) ))
strictFieldAnalysisTests = (S.concatMap (\(Quad label constructor expression expected) -> (Cons (Pair (H.append "strict constructor fields: " label) (let { actual = (M.lookup constructor (F.infer cs (A.analyze expression) expression)) } in (S.unless (H.eq actual expected) (H.fail (H.append (H.show actual) (H.append " expected " (H.show expected))))))) Nil)) cases)
