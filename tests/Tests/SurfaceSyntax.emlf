module Tests.SurfaceSyntax where
import Bootstrap.Types
import qualified Bootstrap.Std as S
import qualified Package.OS as OS
import qualified Tests.Helpers as H
import Tests.Helpers (Quint(..), Sext(..))
import Bootstrap.Compiler
import Bootstrap.Parser (parseExpr, parseProgram)
import qualified Bootstrap.Primitive as P
import qualified Bootstrap.X.Check as C
import qualified Bootstrap.X.Parser as XP
import Bootstrap.X.Pretty (prettyTerm)
import qualified Bootstrap.X.Syntax as X
import qualified Bootstrap.X.Type as T

sameParse : String -> String -> SExpr -> Pair String (IO Unit)
sameParse label source expected = (Pair (H.append "surface parser: " label) do { actual <- (H.right (parseExpr "<surface expression>" source)); (H.assert (H.eq actual expected) (H.append "unexpected AST: " (H.show actual))) })

sameProgram : String -> String -> SExpr -> Pair String (IO Unit)
sameProgram label source expected = (Pair (H.append "surface program: " label) do { actual <- (H.right (parseProgram "<surface declarations>" source)); (H.assert (H.eq actual (SProgram Nil expected)) (H.append "unexpected program: " (H.show actual))) })

hasType : String -> String -> XType -> Pair String (IO Unit)
hasType label source expected = (Pair (H.append "surface checking: " label) do { result <- (H.right (compile "<surface test>" source)); do { term <- (H.right (XP.parseTerm "<surface xMLF>" (prettyTerm (compiledTerm result)))); do { actual <- (H.right (C.checkClosed term)); do { (H.assert ((T.alphaEq actual expected) && (T.alphaEq actual (inferredType result))) (H.append "wrong type: " (sourceType result))); (H.assert (H.eq (X.erase term) (X.erase (compiledTerm result))) "xMLF round trip changed erasure") } } } })

rejects : String -> String -> Phase -> String -> Pair String (IO Unit)
rejects label source expectedPhase reason = (Pair (H.append "surface rejection: " label) (case (compile "<invalid surface syntax>" source) of { (Left err) -> (H.assert ((H.eq (phase err) expectedPhase) && (H.contains reason (diagnostic err))) (H.append "wrong rejection: " (H.show err))); (Right result) -> (H.fail (H.append "unexpected acceptance: " (sourceType result))) }))

int : XType
int = (XCon "Int" Nil)

bool : XType
bool = (XCon "Bool" Nil)

var : String -> SExpr
var = SVar

lit : Int -> SExpr
lit = SIntLit

prim : Primitive -> SExpr -> SExpr -> SExpr
prim p a b = (SApp (SApp (SPrimitive p) a) b)

choose : SExpr -> SExpr -> SExpr -> SExpr
choose a b c = (SApp (prim PIfThenElse a b) c)

lam : String -> SExpr -> SExpr
lam n = (SLam n Nothing)

surfaceSyntaxTests : (List ( Pair String (IO Unit) ))
surfaceSyntaxTests = (let { identityAnnotation = (SAnnotation Nil (SForall Flexible "a" SBottom (SArrow (STVar "a") (STVar "a")))) } in (Cons (sameParse "multiplication binds above addition" "x * 4 + y" (prim PAddInt (prim PMulInt (var "x") (lit 4)) (var "y"))) (Cons (sameParse "application binds above arithmetic" "f x + g y * 2" (prim PAddInt (SApp (var "f") (var "x")) (prim PMulInt (SApp (var "g") (var "y")) (lit 2)))) (Cons (sameParse "subtraction associates left" "10-3-2" (prim PSubInt (prim PSubInt (lit 10) (lit 3)) (lit 2))) (Cons (sameParse "quotient and remainder associate left" "20 / 3 % 4" (prim PRemInt (prim PQuotInt (lit 20) (lit 3)) (lit 4))) (Cons (sameParse "parentheses override precedence" "(x + y) * 4" (prim PMulInt (prim PAddInt (var "x") (var "y")) (lit 4))) (Cons (sameParse "Boolean precedence" "x < 3 || y == 4 && z" (choose (prim PLtInt (var "x") (lit 3)) (SBoolLit true) (choose (prim PEqInt (var "y") (lit 4)) (var "z") (SBoolLit false)))) (Cons (sameParse "concatenation associates right" "\"a\" ++ \"b\" ++ \"c\"" (prim PConcatString (SStringLit "a") (prim PConcatString (SStringLit "b") (SStringLit "c")))) (Cons (sameParse "subtraction without spaces is not signed application" "f x-1" (prim PSubInt (SApp (var "f") (var "x")) (lit 1))) (Cons (sameParse "negative argument is parenthesized" "f (-1)" (SApp (var "f") (lit (0 - 1)))) (Cons (sameParse "unary minus applies after function application" "-f x * 2" (prim PMulInt (prim PSubInt (lit 0) (SApp (var "f") (var "x"))) (lit 2))) (Cons (sameParse "signed Double exponent" "-2.5e-2" (SDoubleLit (-0.025))) (Cons (sameParse "signed hexadecimal integer" "-0x20" (lit (0 - 32))) (Cons (sameParse "plus sign and negative right operand" "+1 + -2" (prim PAddInt (lit 1) (lit (0 - 2)))) (Cons (sameParse "comments at operators" "1 {- outer {- nested -} -} + 2 -- comment\n * 3" (prim PAddInt (lit 1) (prim PMulInt (lit 2) (lit 3)))) (Cons (sameParse "nearest else" "if a then if b then x else y else z" (choose (var "a") (choose (var "b") (var "x") (var "y")) (var "z"))) (Cons (sameParse "arithmetic inside branches" "if x < 0 then 0 else x + 1" (choose (prim PLtInt (var "x") (lit 0)) (lit 0) (prim PAddInt (var "x") (lit 1)))) (Cons (sameParse "control expression as right operand" "1 + if a then 2 else 3" (prim PAddInt (lit 1) (choose (var "a") (lit 2) (lit 3)))) (Cons (sameParse "annotation covers the infix expression" "x + 1 : Int" (SAnn (prim PAddInt (var "x") (lit 1)) (SAnnotation Nil (SCon "Int" Nil)))) (Cons (sameParse "local parameters lower to lambdas" "let f x y = x + y in f 1 2" (SLet "f" (lam "x" (lam "y" (prim PAddInt (var "x") (var "y")))) (SApp (SApp (var "f") (lit 1)) (lit 2)))) (Cons (sameProgram "declarations have ordered let scopes" "id x = x; value = id 42; value" (SLet "id" (lam "x" (var "x")) (SLet "value" (SApp (var "id") (lit 42)) (var "value")))) (Cons (sameProgram "implicit main with trailing semicolon" "main = 42;" (SLet "main" (lit 42) (var "main"))) (Cons (sameProgram "implicit main without trailing semicolon" "main = 42" (SLet "main" (lit 42) (var "main"))) (Cons (sameProgram "explicit entry overrides main" "main = 42; true" (SLet "main" (lit 42) (SBoolLit true))) (Cons (sameProgram "separate signature covers the whole function" "id : forall a. a -> a; id x = x; id 42" (SLet "id" (SSignature (lam "x" (var "x")) identityAnnotation) (SApp (var "id") (lit 42)))) (Cons (hasType "declarations generalize" "id x = x; n = id 42; main = id true;" bool) (Cons (hasType "annotated function parameter" "apply (f : forall a. a -> a) = f f; id x = x; main = apply id 42;" int) (Cons (hasType "inline whole-function signature" "id x : forall a. a -> a = x; n = id true; main = id 42;" int) (Cons (hasType "annotated local function" "let id x : forall a. a -> a = x in let n = id true in id 42" int) (Cons (hasType "do-local function generalizes" "do { let id x : forall a. a -> a = x; let n = id 42; id true }" bool) (Cons (hasType "do-local function sees outer binding" "let f x = x + 1 in do { let f x = f x + 1; f 40 }" int) (Cons (hasType "conditional returns polymorphic function" "id x = x; main = (if true then id else id) 42;" int) (Cons (hasType "conditional works in a case scrutinee" "data Maybe a = Nothing | Just a; case if true then Just 42 else Nothing of { Just x -> x; Nothing -> 0 }" int) (Cons (hasType "keyword prefixes remain identifiers" "iffy thenValue elsewhere = thenValue + elsewhere; main = iffy 20 22;" int) (Cons (hasType "instance method parameters" "class Convert a b where { convert : a -> b }; instance Convert Int Bool where { convert x = x > 0 }; main = convert 42 : Bool;" bool) (Cons (hasType "qualified function declaration" "twice : forall (m : * -> *) a. Monad m => m a -> m a; twice action = do { action; action }; main = twice (return 42 : IO Int);" (XCon "IO" (Cons int Nil))) (Cons (Pair "surface checking: syntax needs no implicit prelude" do { result <- (H.right (compileWithPrelude NoImplicitPrelude "<surface without prelude>" "inc x = x + 1; main = if true then inc 41 else 0;")); (H.assert (T.alphaEq (inferredType result) int) (sourceType result)) }) (Cons (rejects "recursion needs a signature" "loop x = loop x; main = loop 42;" Parsing "requires an explicit closed signature") (Cons (hasType "forward value references" "main = later 42; later x = x;" int) (Cons (rejects "branch types must agree" "if true then 42 else false" Inference "type constructor mismatch") (Cons (rejects "condition must be Bool" "if 1 then 2 else 3" Inference "type constructor mismatch") (Cons (rejects "arithmetic does not overload Double" "1.0 + 2.0" Inference "type constructor mismatch") (Cons (rejects "unary plus requires a number" "+true" Inference "type constructor mismatch") (Cons (rejects "unary minus requires a number" "-true" Inference "type constructor mismatch") (Cons (rejects "comparisons do not overload String" "\"a\" == \"a\"" Inference "type constructor mismatch") (Cons (rejects "whole function signature is checked" "f : Int -> Bool; f x = x + 1; main = f 42;" Inference "type constructor mismatch") (Cons (rejects "chained comparisons" "1 < 2 < 3" Parsing "ambiguous") (Cons (rejects "mixed chained comparisons" "1 == 2 < 3" Parsing "ambiguous") (Cons (rejects "missing else" "if true then 42" Parsing "else") (Cons (rejects "missing then" "if true 42 else 0" Parsing "unexpected") (Cons (hasType "layout declaration separator" "f x = x\nmain = f 42" int) (Cons (rejects "declaration-only file needs main" "answer = 42;" Parsing "main") (Cons (rejects "unreachable equation" "f x = x; f y = y; main = f 42;" Inference "unreachable") (Cons (rejects "duplicate function parameters" "f x x = x; main = f 1 2;" Parsing "duplicate function parameter") (Cons (rejects "signature must name its next definition" "f : Int; g = 42; main = g;" Parsing "expected a definition of f") (Cons (rejects "duplicate signatures" "f : Int; f : Int = 42; main = f;" Parsing "duplicate signature") (Cons (rejects "signature without equation" "f : Int;" Parsing "unexpected") (Cons (rejects "reserved conditional word" "let then = 42 in then" Parsing "reserved word") (Cons (rejects "reserved word in datatype parameter" "data Box if = Box if; main = 42;" Parsing "reserved word") Nil)))))))))))))))))))))))))))))))))))))))))))))))))))))))))))
