module Tests.SurfaceSyntax where
import Bootstrap.Types
import qualified Bootstrap.Std as S
import qualified Package.OS as OS
import qualified Tests.Helpers as H
import Tests.Helpers (Quint(..), Sext(..))
import Bootstrap.Compiler
import Bootstrap.Parser (parseExpr, parseProgram)
import qualified Bootstrap.Primitive as P
import qualified Bootstrap.X.Check as C
import qualified Bootstrap.X.Parser as XP
import Bootstrap.X.Pretty (prettyTerm)
import qualified Bootstrap.X.Syntax as X
import qualified Bootstrap.X.Type as T

withoutSites : SExpr -> SExpr
withoutSites expression = case expression of {
  SCallSite _ _ value -> withoutSites value;
  SApp f x -> SApp (withoutSites f) (withoutSites x);
  SLam n t body -> SLam n t (withoutSites body);
  SLet n value body -> SLet n (withoutSites value) (withoutSites body);
  SAnn value annotation -> SAnn (withoutSites value) annotation;
  _ -> expression
}

sourceString : String -> SExpr
sourceString text = SApp (SVar "$MLF.Primitive.fromString") (SApp (SPrimitive PTextToChars) (SStringLit text))

sourceEq : SExpr -> SExpr -> SExpr
sourceEq a b = SApp (SApp (SVar "==") a) b

sameParse : String -> String -> SExpr -> (,) String (IO ())
sameParse label source expected = ((,) (H.append "surface parser: " label) do { actual <- (H.right (parseExpr "<surface expression>" source)); (H.assert (H.eq (withoutSites actual) expected) (H.append "unexpected AST: " (H.show actual))) })

sameProgram : String -> String -> SExpr -> (,) String (IO ())
sameProgram label source expected = ((,) (H.append "surface program: " label) do { actual <- (H.right (parseProgram "<surface declarations>" source)); (H.assert (H.eq (case actual of { SProgram declarations body -> SProgram declarations (withoutSites body); _ -> actual }) (SProgram [] expected)) (H.append "unexpected program: " (H.show actual))) })

hasType : String -> String -> XType -> (,) String (IO ())
hasType label source expected = ((,) (H.append "surface checking: " label) do { result <- (H.right (compile "<surface test>" source)); do { term <- (H.right (XP.parseTerm "<surface xMLF>" (prettyTerm (compiledTerm result)))); do { actual <- (H.right (C.checkClosed term)); do { (H.assert ((T.alphaEq actual expected) && (T.alphaEq actual (inferredType result))) (H.append "wrong type: " (sourceType result))); (H.assert (H.eq (X.erase term) (X.erase (compiledTerm result))) "xMLF round trip changed erasure") } } } })

rejects : String -> String -> Phase -> String -> (,) String (IO ())
rejects label source expectedPhase reason = ((,) (H.append "surface rejection: " label) (case (compile "<invalid surface syntax>" source) of { (Left err) -> (H.assert ((H.eq (phase err) expectedPhase) && (H.contains reason (diagnostic err))) (H.append "wrong rejection: " (H.show err))); (Right result) -> (H.fail (H.append "unexpected acceptance: " (sourceType result))) }))

int : XType
int = (XCon "Int" [])

bool : XType
bool = (XCon "Bool" [])

var : String -> SExpr
var = SVar

lit : Int -> SExpr
lit = SIntLit

prim : Primitive -> SExpr -> SExpr -> SExpr
prim p a b = (SApp (SApp (SPrimitive p) a) b)

choose : SExpr -> SExpr -> SExpr -> SExpr
choose a b c = (SApp (prim PIfThenElse a b) c)

lam : String -> SExpr -> SExpr
lam n = (SLam n Nothing)

surfaceSyntaxTests : ([] ( (,) String (IO ()) ))
surfaceSyntaxTests = (let { identityAnnotation = (SAnnotation [] (SForall Flexible "a" SBottom (SArrow (STVar "a") (STVar "a")))) } in ((:) (sameParse "multiplication binds above addition" "x * 4 + y" (prim PAddInt (prim PMulInt (var "x") (lit 4)) (var "y"))) ((:) (sameParse "application binds above arithmetic" "f x + g y * 2" (prim PAddInt (SApp (var "f") (var "x")) (prim PMulInt (SApp (var "g") (var "y")) (lit 2)))) ((:) (sameParse "subtraction associates left" "10-3-2" (prim PSubInt (prim PSubInt (lit 10) (lit 3)) (lit 2))) ((:) (sameParse "quotient and remainder associate left" "20 / 3 % 4" (prim PRemInt (prim PQuotInt (lit 20) (lit 3)) (lit 4))) ((:) (sameParse "parentheses override precedence" "(x + y) * 4" (prim PMulInt (prim PAddInt (var "x") (var "y")) (lit 4))) ((:) (sameParse "Boolean precedence" "x < 3 || y == 4 && z" (choose (prim PLtInt (var "x") (lit 3)) (SBoolLit true) (choose (sourceEq (var "y") (lit 4)) (var "z") (SBoolLit false)))) ((:) (sameParse "concatenation associates right" "\"a\" ++ \"b\" ++ \"c\"" (prim PConcatString (sourceString "a") (prim PConcatString (sourceString "b") (sourceString "c")))) ((:) (sameParse "subtraction without spaces is not signed application" "f x-1" (prim PSubInt (SApp (var "f") (var "x")) (lit 1))) ((:) (sameParse "negative argument is parenthesized" "f (-1)" (SApp (var "f") (lit (0 - 1)))) ((:) (sameParse "unary minus applies after function application" "-f x * 2" (prim PMulInt (prim PSubInt (lit 0) (SApp (var "f") (var "x"))) (lit 2))) ((:) (sameParse "signed Double exponent" "-2.5e-2" (SDoubleLit (-0.025))) ((:) (sameParse "signed hexadecimal integer" "-0x20" (lit (0 - 32))) ((:) (sameParse "plus sign and negative right operand" "+1 + -2" (prim PAddInt (lit 1) (lit (0 - 2)))) ((:) (sameParse "comments at operators" "1 {- outer {- nested -} -} + 2 -- comment\n * 3" (prim PAddInt (lit 1) (prim PMulInt (lit 2) (lit 3)))) ((:) (sameParse "nearest else" "if a then if b then x else y else z" (choose (var "a") (choose (var "b") (var "x") (var "y")) (var "z"))) ((:) (sameParse "arithmetic inside branches" "if x < 0 then 0 else x + 1" (choose (prim PLtInt (var "x") (lit 0)) (lit 0) (prim PAddInt (var "x") (lit 1)))) ((:) (sameParse "control expression as right operand" "1 + if a then 2 else 3" (prim PAddInt (lit 1) (choose (var "a") (lit 2) (lit 3)))) ((:) (sameParse "annotation covers the infix expression" "x + 1 :: Int" (SAnn (prim PAddInt (var "x") (lit 1)) (SAnnotation [] (SCon "Int" [])))) ((:) (sameParse "local parameters lower to lambdas" "let f x y = x + y in f 1 2" (SLet "f" (lam "x" (lam "y" (prim PAddInt (var "x") (var "y")))) (SApp (SApp (var "f") (lit 1)) (lit 2)))) ((:) (sameProgram "declarations have ordered let scopes" "id x = x; value = id 42; value" (SLet "id" (lam "x" (var "x")) (SLet "value" (SApp (var "id") (lit 42)) (var "value")))) ((:) (sameProgram "implicit main with trailing semicolon" "main = 42;" (SLet "main" (lit 42) (var "main"))) ((:) (sameProgram "implicit main without trailing semicolon" "main = 42" (SLet "main" (lit 42) (var "main"))) ((:) (sameProgram "explicit entry overrides main" "main = 42; true" (SLet "main" (lit 42) (SBoolLit true))) ((:) (sameProgram "separate signature covers the whole function" "id : forall a. a -> a; id x = x; id 42" (SLet "id" (SSignature (lam "x" (var "x")) identityAnnotation) (SApp (var "id") (lit 42)))) ((:) (hasType "declarations generalize" "id x = x; n = id 42; main = id true;" bool) ((:) (hasType "annotated function parameter" "apply (f : forall a. a -> a) = f f; id x = x; main = apply id 42;" int) ((:) (hasType "inline whole-function signature" "id x : forall a. a -> a = x; n = id true; main = id 42;" int) ((:) (hasType "annotated local function" "let id x : forall a. a -> a = x in let n = id true in id 42" int) ((:) (hasType "do-local function generalizes" "do { let id x : forall a. a -> a = x; let n = id 42; id true }" bool) ((:) (hasType "distinct do-local function sees outer binding" "let f x = x + 1 in do { let g x = f x + 1; g 40 }" int) ((:) (hasType "conditional returns polymorphic function" "id x = x; main = (if true then id else id) 42;" int) ((:) (hasType "conditional works in a case scrutinee" "data Maybe a = Nothing | Just a; case if true then Just 42 else Nothing of { Just x -> x; Nothing -> 0 }" int) ((:) (hasType "keyword prefixes remain identifiers" "iffy thenValue elsewhere = thenValue + elsewhere; main = iffy 20 22;" int) ((:) (hasType "instance method parameters" "class Convert a b where { convert : a -> b }; instance Convert Int Bool where { convert x = x > 0 }; main = convert 42 :: Bool;" bool) ((:) (hasType "qualified function declaration" "twice : forall (m : * -> *) a. Monad m => m a -> m a; twice action = do { action; action }; main = twice (return 42 :: IO Int);" (XCon "IO" ((:) int []))) ((:) ((,) "surface checking: syntax needs no implicit prelude" do { result <- (H.right (compileWithPrelude NoImplicitPrelude "<surface without prelude>" "inc x = x + 1; main = if true then inc 41 else 0;")); (H.assert (T.alphaEq (inferredType result) int) (sourceType result)) }) ((:) (hasType "same-name do-local function is recursive" "let f x = x + 1 in do { let f x = f x + 1; f 40 }" int) ((:) (hasType "unsigned recursion infers bottom" "loop x = loop x; main = loop 42;" XBot) ((:) (hasType "forward value references" "main = later 42; later x = x;" int) ((:) (rejects "branch types must agree" "if true then 42 else false" Inference "type constructor mismatch") ((:) (rejects "condition must be Bool" "if 1 then 2 else 3" Inference "type constructor mismatch") ((:) (rejects "arithmetic does not overload Double" "1.0 + 2.0" Inference "type constructor mismatch") ((:) (rejects "unary plus requires a number" "+true" Inference "type constructor mismatch") ((:) (rejects "unary minus requires a number" "-true" Inference "type constructor mismatch") ((:) (hasType "equality supports annotated strings" "(\"a\" :: String) == \"a\"" bool) ((:) (rejects "whole function signature is checked" "f : Int -> Bool; f x = x + 1; main = f 42;" Inference "type constructor mismatch") ((:) (rejects "chained comparisons" "1 < 2 < 3" Parsing "ambiguous") ((:) (rejects "mixed chained comparisons" "1 == 2 < 3" Parsing "ambiguous") ((:) (rejects "missing else" "if true then 42" Parsing "else") ((:) (rejects "missing then" "if true 42 else 0" Parsing "unexpected") ((:) (hasType "layout declaration separator" "f x = x\nmain = f 42" int) ((:) (rejects "declaration-only file needs main" "answer = 42;" Parsing "main") ((:) (rejects "unreachable equation" "f x = x; f y = y; main = f 42;" Inference "unreachable") ((:) (rejects "duplicate function parameters" "f x x = x; main = f 1 2;" Parsing "duplicate function parameter") ((:) (rejects "signature must name its next definition" "f : Int; g = 42; main = g;" Parsing "expected a definition of f") ((:) (rejects "duplicate signatures" "f : Int; f : Int = 42; main = f;" Parsing "duplicate signature") ((:) (rejects "signature without equation" "f : Int;" Parsing "unexpected") ((:) (rejects "reserved conditional word" "let then = 42 in then" Parsing "reserved word") ((:) (rejects "reserved word in datatype parameter" "data Box if = Box if; main = 42;" Parsing "reserved word") []))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))
