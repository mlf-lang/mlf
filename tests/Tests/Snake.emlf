module Tests.Snake where
import Bootstrap.Types
import Bootstrap.Compiler
import Bootstrap.Parser (parseExpr, parseProgram)
import qualified Bootstrap.Std as S
import qualified Package.OS as O
import qualified Package.OS as OS
import qualified Tests.Helpers as H
import qualified Tests.Backends as B
import Tests.Backends (Event(..))
import qualified Bootstrap.X.Check as C
import qualified Bootstrap.X.Parser as XP
import Bootstrap.X.Pretty (prettyTerm)
import qualified Bootstrap.X.Syntax as X
import qualified Bootstrap.X.Type as T
import qualified Tests.SnakeBaseline as Ref

data Script a = Script ([] String -> Either String ((,,) a ([] String) String))
returnScript a = Script (\xs -> Right ((,,) a xs ""))
bindScript (Script action) f = Script (\xs -> case action xs of
  Left err -> Left err
  Right ((,,) a rest out) -> case f a of
   Script next -> case next rest of
    Left err -> Left err
    Right ((,,) b remaining text) -> Right ((,,) b remaining (out ++ text)))
instance Functor Script where { fmap f action = bindScript action (\x -> returnScript (f x)) }
instance Applicative Script where {
 pure = returnScript;
 (<*>) functions arguments = bindScript functions (\f -> bindScript arguments (\x -> returnScript (f x)))
}
instance Monad Script where { (>>=) = bindScript }
scriptRead = Script (\xs -> case xs of { [] -> Left "baseline requested unexpected input"; (:) x rest -> Right ((,,) x rest "") })
scriptWrite text = Script (\xs -> Right ((,,) () xs text))
baseline input = case Ref.runGame (Ref.Console scriptRead scriptWrite) of
 Script action -> do
  (,,) _ remaining output <- H.right (action input)
  H.assert (S.null remaining) "baseline stopped before consuming scripted input"
  return output
runWithBaseline backends term input = do
 output <- runOn backends term input
 reference <- baseline input
 H.assert (eqString output reference) ("independent Snake transcript mismatch\n" ++ output ++ "\n" ++ reference)
 return output
frames : String -> IO ([] ([] String))
frames output = scanFrames (H.lines output)
scanFrames : [] String -> IO ([] ([] String))
scanFrames [] = return []
scanFrames ((:) line rest) = if eqString line "+------------+" then do
 let cells = S.take 8 rest
 let after = S.drop 8 rest
 H.assert (S.length cells == 8 && S.all (\row -> stringLength row == 14 && stringCodeAt row 0 == 124 && stringCodeAt row 13 == 124) cells) "malformed Snake board"
 case after of
  (:) end more -> do
   H.assert (eqString end "+------------+") "missing Snake bottom border"
   suffix <- scanFrames more
   return ((:) cells suffix)
  _ -> H.fail "missing Snake bottom border"
 else scanFrames rest

checked : Compilation -> IO XTerm
checked result = do { term <- (H.right (XP.parseTerm "<Snake xMLF>" (prettyTerm (compiledTerm result)))); do { ty <- (H.right (C.checkClosed term)); do { (H.assert (T.alphaEq ty (XCon "IO" ((:) (XCon "()" []) []))) "Snake must have type IO ()"); do { (H.assert (H.eq (X.erase term) (X.erase (compiledTerm result))) "Snake round trip changed erasure"); (return term) } } } }

runOn : B.Backends -> XTerm -> ([] ( String )) -> IO String
runOn backends term input = do { ((,) result trace) <- (B.capture backends term input); do { (H.right result); (return (H.concat (S.concatMap (\comprehension1 -> case comprehension1 of { (Write text) -> ((:) text []); _ -> [] }) trace))) } }

board : ([] ( ((,) (Int) (String)) )) -> ([] ( String ))
board changed = (S.concatMap (\y -> ((:) (H.append "|" (H.append (S.maybe (H.repeatChar 12 46) S.id (H.lookup y changed)) "|")) [])) (S.range 0 7))

initialBoard : ([] ( String ))
initialBoard = (board ((:) ((,) 3 "..oo@.*.....") []))

snakeTests : B.Backends -> ([] ( (,) String (IO ()) ))
snakeTests backends = (let { run = (runOn backends) } in (let { runBoth = (runWithBaseline backends) } in ((:) ((,) "Snake: playable source and xMLF sessions" do { (putStrLn "  Snake: compiling the interactive example"); do { source <- (readFile "examples/snake.emlf"); do { result <- (H.right (compile "examples/snake.emlf" source)); do { term <- (checked result); do { direct <- (run (compiledTerm result) ((:) "q" [])); do { quit <- (runBoth term ((:) "q" [])); do { (H.assert (H.eq direct quit) "source and standalone xMLF execution differ"); do { quitFrames <- (frames quit); do { (H.assert ((H.eq quitFrames ((:) initialBoard [])) && (H.contains "Goodbye. Score: 0\n" quit)) (H.append "unexpected initial game: " quit)); do { growth <- (runBoth term ((:) "d" ((:) "d" ((:) "q" [])))); do { growthFrames <- (frames growth); do { (H.assert (H.eq growthFrames ((:) initialBoard ((:) (board ((:) ((,) 3 "...oo@*.....") [])) ((:) (board ((:) ((,) 0 "*...........") ((:) ((,) 3 "...ooo@.....") []))) [])))) (H.append "movement/growth rendered incorrectly: " growth)); do { (H.assert (H.contains "Goodbye. Score: 1\n" growth) "eating did not increase the score"); do { invalid <- (runBoth term ((:) "x" ((:) "" ((:) "q" [])))); do { invalidFrames <- (frames invalid); do { (H.assert ((H.eq invalidFrames ((:) initialBoard ((:) initialBoard ((:) (board ((:) ((,) 3 "...oo@*.....") [])) [])))) && (H.contains "No move made." invalid)) (H.append "invalid/empty command behavior: " invalid)); do { reverseTurn <- (runBoth term ((:) "a" ((:) "q" []))); do { reverseFrames <- (frames reverseTurn); do { (H.assert (H.eq reverseFrames ((:) initialBoard ((:) (board ((:) ((,) 3 "...oo@*.....") [])) []))) "reverse turn was not ignored"); do { turns <- (runBoth term ((:) "w" ((:) "a" ((:) "s" ((:) "d" ((:) "q" [])))))); do { turnFrames <- (frames turns); do { (H.assert ((H.eq (H.length turnFrames) 5) && (H.eq (S.last turnFrames) (board ((:) ((,) 2 "...o........") ((:) ((,) 3 "...o@.*.....") []))))) (H.append "WASD turns produced the wrong snake: " turns)); do { (H.assert (H.eq (S.filter (OS.starts "Score:") (H.lines turns)) (S.concatMap (\d -> ((:) (H.append "Score: 0  Direction: " d) [])) ((:) "right" ((:) "up" ((:) "left" ((:) "down" ((:) "right" []))))))) "wrong headings"); do { wall <- (runBoth term (S.replicate 8 "d")); do { wallFrames <- (frames wall); do { (H.assert ((H.eq (H.length wallFrames) 8) && (H.contains "Game over: hit wall. Score: 1\n" wall)) (H.append "wall collision did not end the game: " wall)); do { body <- (runBoth term (H.append ((:) "d" ((:) "d" [])) (H.append (S.replicate 3 "w") (H.append (S.replicate 6 "a") ((:) "s" ((:) "d" ((:) "w" []))))))); do { bodyFrames <- (frames body); do { (H.assert ((H.eq (H.length bodyFrames) 14) && (H.contains "Game over: hit body. Score: 2\n" body)) (H.append "body collision did not end the game: " body)); (putStrLn "  Snake: all 7 sessions pass on both backends and match Haskell") } } } } } } } } } } } } } } } } } } } } } } } } } } } } }) ((:) ((,) "Snake: pure rules, departing tail, food search, and full-board win" do { (putStrLn "  Snake: compiling the pure-rule checks"); do { source <- (readFile "examples/snake.emlf"); do { program <- (H.right (parseProgram "examples/snake.emlf" source)); do { entry <- (H.right (parseExpr "<Snake rule checks>" rulesDriver)); do { program' <- (H.right (withRulesEntry entry program)); do { result <- (H.right (compileProgram program')); do { term <- (checked result); do { output <- (run term []); do { (H.assert (H.eq (H.lines output) (S.map (\((,,) label _ expected) -> (H.append label (H.append ": " expected))) ruleCases)) (H.append "unexpected rule outcomes:\n" output)); (let { baseline = (S.concatMap (\((,) label result') -> ((:) (H.append label (H.append ": " (describeOutcome result'))) [])) baselineRuleCases) } in do { (H.assert (H.eq (H.lines output) baseline) (H.append "Haskell/eMLF rule mismatch:\n" (S.unlines baseline))); (putStrLn (H.append "  Snake: " (H.append (H.show (H.length ruleCases)) " rule checks pass on both backends and match Haskell"))) }) } } } } } } } } }) []))))

withRulesEntry : SExpr -> SProgram -> Either String SProgram
withRulesEntry entry program = (let rec { replace : SExpr -> Either String SExpr; replace (SLet name rhs body) = (if (H.eq name "step") then (Right (SLet name rhs entry)) else (if true then (S.mapEither (SLet name rhs) (replace body)) else (panic "non-exhaustive test guard"))); replace (SLetRec definitions body) = (if (S.any (\((,,) name _ _) -> (H.eq name "step")) definitions) then (Right (SLetRec definitions entry)) else (if true then (S.mapEither (SLetRec definitions) (replace body)) else (panic "non-exhaustive test guard"))); replace _ = (Left "Snake example no longer defines step in its helper scope") } in (case program of { (SProgram ds body) -> (S.mapEither (SProgram ds) (replace body)); (SClassProgram ds cs instances body) -> (S.mapEither (SClassProgram ds cs instances) (replace body)) }))

position : ((,) (Int) (Int)) -> String
position ((,) x y) = (H.append "(Position " (H.append (H.show x) (H.append " " (H.append (H.show y) ")"))))

positions : ([] ( ((,) (Int) (Int)) )) -> String
positions = (S.foldr (\p rest -> (H.append "(Cons " (H.append (position p) (H.append " " (H.append rest ")"))))) "Nil")

game : ((,) (Int) (Int)) -> ([] ( ((,) (Int) (Int)) )) -> String -> ((,) (Int) (Int)) -> Int -> String
game headPosition body heading food score = (H.append "(Game (Snake " (H.append (position headPosition) (H.append " " (H.append (positions body) (H.append ") " (H.append heading (H.append " " (H.append (position food) (H.append " " (H.append (H.show score) ")"))))))))))

describeOutcome : Ref.Outcome -> String
describeOutcome outcome = (let { showPosition (Ref.Position x y) = (H.append "(" (H.append (H.show x) (H.append "," (H.append (H.show y) ")")))) } in (case outcome of { (Ref.Lost reason score) -> (H.append "lost " (H.append reason (H.append " score=" (H.show score)))); (Ref.Won score) -> (H.append "won score=" (H.show score)); (Ref.Continue (Ref.Game (Ref.Snake headPosition body) _ food score)) -> (H.append "continue " (H.append (showPosition headPosition) (H.append " [" (H.append (H.concatMap showPosition body) (H.append "] food=" (H.append (showPosition food) (H.append " score=" (H.show score)))))))) }))

baselineRuleCases : ([] ( ((,) (String) (Ref.Outcome)) ))
baselineRuleCases = (let { point ((,) x y) = (Ref.Position x y) } in (let { state headPosition body heading food score = (Ref.Game (Ref.Snake (point headPosition) (S.map point body)) heading (point food) score) } in (let { almostFull = (S.drop 2 (S.concatMap (\y -> (S.concatMap (\x -> ((:) ((,) x y) [])) (if (H.even y) then (S.range 0 11) else (H.rangeStep 11 10 0)))) (S.range 0 7))) } in ((:) ((,) "ordinary move" (Ref.step Ref.East (state ((,) 4 3) ((:) ((,) 3 3) ((:) ((,) 2 3) [])) Ref.East ((,) 6 3) 0))) ((:) ((,) "growth" (Ref.step Ref.East (state ((,) 5 3) ((:) ((,) 4 3) ((:) ((,) 3 3) [])) Ref.East ((,) 6 3) 0))) ((:) ((,) "reverse" (Ref.step Ref.West (state ((,) 4 3) ((:) ((,) 3 3) ((:) ((,) 2 3) [])) Ref.East ((,) 6 3) 0))) ((:) ((,) "departing tail" (Ref.step Ref.West (state ((,) 1 1) ((:) ((,) 1 2) ((:) ((,) 0 2) ((:) ((,) 0 1) []))) Ref.North ((,) 11 7) 7))) ((:) ((,) "body" (Ref.step Ref.East (state ((,) 1 1) ((:) ((,) 1 0) ((:) ((,) 2 0) ((:) ((,) 2 1) ((:) ((,) 2 2) [])))) Ref.South ((,) 11 7) 7))) ((:) ((,) "left wall" (Ref.step Ref.West (state ((,) 0 3) [] Ref.West ((,) 11 7) 7))) ((:) ((,) "right wall" (Ref.step Ref.East (state ((,) 11 3) [] Ref.East ((,) 0 0) 7))) ((:) ((,) "top wall" (Ref.step Ref.North (state ((,) 3 0) [] Ref.North ((,) 11 7) 7))) ((:) ((,) "bottom wall" (Ref.step Ref.South (state ((,) 3 7) [] Ref.South ((,) 0 0) 7))) ((:) ((,) "food skips snake" (Ref.step Ref.East (state ((,) 1 0) ((:) ((,) 0 0) []) Ref.East ((,) 2 0) 0))) ((:) ((,) "full board" (Ref.step Ref.West (state ((,) 1 0) almostFull Ref.West ((,) 0 0) 92))) []))))))))))))))

ruleCases : ([] ( ((,,) (String) (String) (String)) ))
ruleCases = ((:) ((,,) "ordinary move" (H.append "step East " (game ((,) 4 3) ((:) ((,) 3 3) ((:) ((,) 2 3) [])) "East" ((,) 6 3) 0)) "continue (5,3) [(4,3)(3,3)] food=(6,3) score=0") ((:) ((,,) "growth" (H.append "step East " (game ((,) 5 3) ((:) ((,) 4 3) ((:) ((,) 3 3) [])) "East" ((,) 6 3) 0)) "continue (6,3) [(5,3)(4,3)(3,3)] food=(0,0) score=1") ((:) ((,,) "reverse" (H.append "step West " (game ((,) 4 3) ((:) ((,) 3 3) ((:) ((,) 2 3) [])) "East" ((,) 6 3) 0)) "continue (5,3) [(4,3)(3,3)] food=(6,3) score=0") ((:) ((,,) "departing tail" (H.append "step West " (game ((,) 1 1) ((:) ((,) 1 2) ((:) ((,) 0 2) ((:) ((,) 0 1) []))) "North" ((,) 11 7) 7)) "continue (0,1) [(1,1)(1,2)(0,2)] food=(11,7) score=7") ((:) ((,,) "body" (H.append "step East " (game ((,) 1 1) ((:) ((,) 1 0) ((:) ((,) 2 0) ((:) ((,) 2 1) ((:) ((,) 2 2) [])))) "South" ((,) 11 7) 7)) "lost body score=7") ((:) ((,,) "left wall" (H.append "step West " (game ((,) 0 3) [] "West" ((,) 11 7) 7)) "lost wall score=7") ((:) ((,,) "right wall" (H.append "step East " (game ((,) 11 3) [] "East" ((,) 0 0) 7)) "lost wall score=7") ((:) ((,,) "top wall" (H.append "step North " (game ((,) 3 0) [] "North" ((,) 11 7) 7)) "lost wall score=7") ((:) ((,,) "bottom wall" (H.append "step South " (game ((,) 3 7) [] "South" ((,) 0 0) 7)) "lost wall score=7") ((:) ((,,) "food skips snake" (H.append "step East " (game ((,) 1 0) ((:) ((,) 0 0) []) "East" ((,) 2 0) 0)) "continue (2,0) [(1,0)(0,0)] food=(3,0) score=1") ((:) ((,,) "full board" "step West (Game (Snake (Position 1 0) (serpentine 2 0 1)) West (Position 0 0) 92)" "won score=93") [])))))))))))

rulesDriver : String
rulesDriver = (S.unlines ((:) "let rec serpentine x y dx : Int -> Int -> Int -> List Position =" ((:) "  if y == 8 then Nil" ((:) "  else if x == 12 then serpentine 11 (y + 1) (-1)" ((:) "  else if x < 0 then serpentine 0 (y + 1) 1" ((:) "  else Cons (Position x y) (serpentine (x + dx) y dx) in" ((:) "let showPosition = \\position -> case position of { Position x y ->" ((:) "  concatString \"(\" (concatString (showInt x) (concatString \",\" (concatString (showInt y) \")\"))) } in" ((:) "let rec showBody body : List Position -> String = case body of {" ((:) "  Nil -> \"\"; Cons p rest -> concatString (showPosition p) (showBody rest) } in" ((:) "let describe = \\outcome -> case outcome of {" ((:) "  Lost reason score -> concatString \"lost \" (concatString reason (concatString \" score=\" (showInt score)));" ((:) "  Won score -> concatString \"won score=\" (showInt score);" ((:) "  Continue game -> case game of { Game snake heading food score -> case snake of { Snake head body ->" ((:) "    concatString \"continue \" (concatString (showPosition head) (concatString \" [\" (concatString (showBody body)" ((:) "      (concatString \"] food=\" (concatString (showPosition food) (concatString \" score=\" (showInt score))))))) } }" ((:) "} in do {" ((:) (H.concat (S.concatMap (\((,,) label expression _) -> ((:) (H.append "putStrLn (concatString " (H.append (H.show (H.append label ": ")) (H.append " (describe (" (H.append expression ")));\n")))) [])) ruleCases)) ((:) "return () }" [])))))))))))))))))))
