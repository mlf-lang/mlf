module Tests.PackageResolver where
import Prelude hiding (Monad, return, bind)
import MLF.Primitive (Monad, return, bind)
import Bootstrap.Types
import qualified Tests.Coverage as Coverage
import qualified Bootstrap.Std as S
import qualified Package.OS as O
import qualified Package.Json as J
import qualified Tests.Basic as Sys
import qualified Tests.Basic as H
import qualified Test.Assert as A
import qualified Test.Case as C

data Resolver = Resolver String String
root (Resolver r _) = r
manager (Resolver _ m) = m
make r name moduleName deps imports = do
 let directory = root r ++ "/" ++ name
 O.mkdir directory
 let path = directory ++ "/mlf-package.json"
 let dependencies = J.Object (S.map (\((,) name path) -> (,) name (J.Object ((:) ((,) "path" (J.str path)) []))) deps)
 let library = J.Object ((:) ((,) "modules" (J.Object ((:) ((,) moduleName (J.str "Source.emlf")) []))) [])
 J.write path (J.Object ((:) ((,) "format" (J.num 1)) ((:) ((,) "name" (J.str name)) ((:) ((,) "version" (J.str "0.1.0")) ((:) ((,) "dependencies" dependencies) ((:) ((,) "library" library) []))))))
 writeFile (directory ++ "/Source.emlf") ("module " ++ moduleName ++ " where\n" ++ imports ++ "\nvalue = 1\n")
 return path
modify path f = do { before <- J.read path; J.write path (f before) }
command r path args success reason = do
 let stem = root r ++ "/resolver-command"
 code <- A.liftIO (O.exec (root r) (S.append ((:) (manager r) ((:) "--manifest" ((:) path []))) args) "" (stem ++ ".stdout") (stem ++ ".stderr") 60)
 stdout <- A.liftIO (readFile (stem ++ ".stdout"))
 stderr <- A.liftIO (readFile (stem ++ ".stderr"))
 A.assert (H.eq (code == 0) success && (success || stringLength stderr > 0) && (eqString reason "" || H.contains reason stderr)) ("resolver command failed: " ++ stderr)
 return stdout
plan r path success reason = command r path ((:) "plan" []) success reason
resolverIdentity label = "packages/resolver/" ++ label
check name action = C.test (resolverIdentity name) ("test_packages." ++ name) ((:) "mode:integration" []) (do
 action
 A.liftIO (Coverage.passed "packages" ("test_packages." ++ name))
 A.liftIO (putStrLn ("PASS test_packages." ++ name)))

-- Selected resolver cases share only read-only prerequisite sources.
-- Set them up even when their former producer case was not selected.
withResolver selected action = Sys.withScratch (\directory -> do
 manager <- getEnv "MLF_PACKAGE_MANAGER"
 let r = Resolver directory manager
 let usesAny labels = S.any (\label -> S.elem eqString (resolverIdentity label) selected) (O.words labels)
 let needsLeft = usesAny "test_diamond_and_canonical_symlink test_target_dependencies_default test_target_dependencies_selection"
 let needsBase = needsLeft || usesAny "test_local_dependency_plan test_dependency_paths_are_manifest_relative test_dependency_key_must_match_identity test_direct_dependency_visibility test_target_dependencies_empty test_target_dependencies_validation"
 if needsBase then do { make r "base" "Base" [] ""; return () } else return ()
 if needsLeft then do { make r "left" "Left" ((:) ((,) "base" "../base") []) "import Base"; return () } else return ()
 action r)

cases : Resolver -> [] C.Case
cases r =
 let directory = root r in
 let tool = manager r in
 [ check "test_local_dependency_plan" (do
  app <- A.liftIO (make r "app" "App" ((:) ((,) "base" "../base") []) "import Base")
  text <- plan r app true ""
  doc <- A.right (\message -> message) (J.parse text)
  A.assert (J.equal (J.get "modules" doc) (J.stringArray ((:) "Base" ((:) "App" [])))) "package ordering changed")
 , check "test_dependency_paths_are_manifest_relative" (do
  app <- A.liftIO (make r "relative" "Relative" ((:) ((,) "base" "../base") []) "import Base")
  let elsewhere = directory ++ "/elsewhere"
  let away = Resolver (elsewhere ++ "/current") tool
  A.liftIO (O.mkdir (root away))
  ignored <- A.liftIO (make (Resolver elsewhere tool) "base" "Decoy" [] "")
  text <- plan away app true ""
  doc <- A.right (\message -> message) (J.parse text)
  A.assert (J.equal (J.get "modules" doc) (J.stringArray ((:) "Base" ((:) "Relative" [])))) "dependency resolved relative to the working directory")
 , check "test_diamond_and_canonical_symlink" (do
  A.liftIO (O.run "" ((:) "/bin/ln" ((:) "-s" ((:) (directory ++ "/base") ((:) (directory ++ "/base-link") [])))))
  right <- A.liftIO (make r "right" "Right" ((:) ((,) "base" "../base-link") []) "import Base")
  top <- A.liftIO (make r "diamond" "Diamond" ((:) ((,) "left" "../left") ((:) ((,) "right" "../right") [])) "import Left\nimport Right")
  text <- plan r top true ""
  doc <- A.right (\message -> message) (J.parse text)
  A.assert (S.length (J.values (J.get "packages" doc)) == 4) "diamond dependency duplicated"
  A.assert (J.equal (J.Array (S.map (J.get "name") (J.values (J.get "packages" doc)))) (J.stringArray ((:) "base" ((:) "left" ((:) "right" ((:) "diamond" [])))))) "diamond package ordering changed"
  A.assert (J.equal (J.get "modules" doc) (J.stringArray ((:) "Base" ((:) "Left" ((:) "Right" ((:) "Diamond" [])))))) "diamond module ordering changed")
 , check "test_package_cycle" (do
  a <- A.liftIO (make r "cycle-a" "CycleA" ((:) ((,) "cycle-b" "../cycle-b") []) "")
  b <- A.liftIO (make r "cycle-b" "CycleB" ((:) ((,) "cycle-a" "../cycle-a") []) "")
  plan r a false "dependency cycle"
  first <- A.liftIO (canonicalPath a)
  second <- A.liftIO (canonicalPath b)
  error <- A.liftIO (readFile (directory ++ "/resolver-command.stderr"))
  A.assert (H.contains (first ++ " -> " ++ second ++ " -> " ++ first) error) "dependency cycle lost its complete chain")
 , check "test_symlink_dependency_cycle" (do
  a <- A.liftIO (make r "symlink-cycle" "Cycle" ((:) ((,) "symlink-cycle" "../cycle-alias") []) "")
  A.liftIO (O.run "" ((:) "/bin/ln" ((:) "-s" ((:) (directory ++ "/symlink-cycle") ((:) (directory ++ "/cycle-alias") [])))))
  plan r a false "dependency cycle")
 , check "test_missing_dependency" (do
  a <- A.liftIO (make r "missing-dep" "Missing" ((:) ((,) "missing" "../does-not-exist") []) "")
  plan r a false "canonical path")
 , check "test_dependency_key_must_match_identity" (do
  app <- A.liftIO (make r "bad-key" "BadKey" ((:) ((,) "wrong" "../base") []) "")
  plan r app false "resolves to package base")
 , check "test_duplicate_module_and_package_identity" (do
  a <- A.liftIO (make r "same-a" "Shared" [] "")
  b <- A.liftIO (make r "same-b" "Shared" ((:) ((,) "same-a" "../same-a") []) "")
  plan r b false "multiple packages"
  A.liftIO (modify b (J.set "name" (J.str "same-a")))
  plan r b false "multiple local paths")
 , check "test_direct_dependency_visibility" (do
  mid <- A.liftIO (make r "mid" "Mid" ((:) ((,) "base" "../base") []) "import Base")
  top <- A.liftIO (make r "top" "Top" ((:) ((,) "mid" "../mid") []) "import Base")
  plan r top false "direct dependency")
 , check "test_module_cycle" (do
  app <- A.liftIO (make r "module-cycle" "A" [] "import B")
  A.liftIO (writeFile (directory ++ "/module-cycle/B.emlf") "module B where\nimport A\ny = 2\n")
  A.liftIO (modify app (\doc -> J.set "library" (J.Object ((:) ((,) "modules" (J.Object ((:) ((,) "A" (J.str "Source.emlf")) ((:) ((,) "B" (J.str "B.emlf")) [])))) [])) doc))
  text <- plan r app true ""
  doc <- A.right (\message -> message) (J.parse text)
  A.assert (S.length (J.values (J.get "modules" doc)) == 2) "cyclic module discovery duplicated a namespace"
  A.assert (S.length (J.values (J.get "crates" doc)) == 1) "module cycle split one library into multiple compilation units")
 , check "test_manifest_module_identity" (do
  app <- A.liftIO (make r "wrong-module" "A" [] "")
  A.liftIO (modify app (J.set "library" (J.Object ((:) ((,) "modules" (J.Object ((:) ((,) "Other" (J.str "Source.emlf")) []))) []))))
  plan r app false "manifest declares Other, source declares A")
 , check "test_source_escape_and_symlink" (do
  app <- A.liftIO (make r "escape" "A" [] "")
  A.liftIO (writeFile (directory ++ "/Outside.emlf") "module A where\nx = 1\n")
  A.liftIO (O.run "" ((:) "/bin/ln" ((:) "-s" ((:) (directory ++ "/Outside.emlf") ((:) (directory ++ "/escape/link.emlf") [])))))
  S.mapM_ (\name -> do
   A.liftIO (modify app (J.set "library" (J.Object ((:) ((,) "modules" (J.Object ((:) ((,) "A" (J.str name)) []))) []))))
   plan r app false "outside package") ((:) "../Outside.emlf" ((:) "link.emlf" [])))
 , check "test_lock_tracks_content" (do
  app <- A.liftIO (make r "locked" "Locked" [] "")
  before <- plan r app true ""
  A.liftIO (writeFile (directory ++ "/locked/Source.emlf") "module Locked where\nvalue = 2\n")
  after <- plan r app true ""
  A.assert (S.not (eqString before after)) "source edit did not affect plan"
  command r app ((:) "lock" []) true ""
  command r app ((:) "--locked" ((:) "plan" [])) true ""
  A.liftIO (writeFile (directory ++ "/locked/Source.emlf") "module Locked where\nvalue = 3\n")
  command r app ((:) "--locked" ((:) "plan" [])) false "mlf.lock is stale")
 , check "test_unknown_and_duplicate_fields" (do
  app <- A.liftIO (make r "unknown" "Unknown" [] "")
  A.liftIO (modify app (J.set "dependecies" J.empty))
  plan r app false "unknown field"
  A.liftIO (writeFile app "{\"name\":\"a\",\"name\":\"b\"}")
  plan r app false "duplicate JSON key")
 , check "test_invalid_manifest_shapes" (S.mapM_ (\mutation -> do
  app <- A.liftIO (make r "invalid" "Invalid" [] "")
  A.liftIO (modify app mutation)
  plan r app false "") ((:) (J.set "format" (J.Boolean true)) ((:) (J.set "executables" (J.Object ((:) ((,) "a" J.Null) []))) ((:) (J.set "tests" (J.Object ((:) ((,) "a" (J.Object ((:) ((,) "command" (J.Array [])) []))) []))) ((:) (J.set "tests" (J.Object ((:) ((,) "a" (J.Object ((:) ((,) "main" (J.str "Source.emlf")) []))) []))) ((:) (J.set "dependencies" (J.Object ((:) ((,) "remote" (J.Object ((:) ((,) "url" (J.str "https://invalid.example")) []))) []))) []))))))
 , check "test_real_parser_handles_multiline_imports_and_comments" (do
  base <- A.liftIO (make r "real" "Real.Library" [] "")
  app <- A.liftIO (make r "parser" "A" ((:) ((,) "real" "../real") []) "")
  A.liftIO (writeFile (directory ++ "/parser/Source.emlf") "{- module Fake where {- import Missing -} -}\nmodule A where {\nimport\n qualified\n Real.Library\n as Alias (value);\n-- import Ignored\nvalue = \"import Not.Real\" }\n")
  text <- plan r app true ""
  doc <- A.right (\message -> message) (J.parse text)
  A.assert (J.equal (J.get "modules" doc) (J.stringArray ((:) "Real.Library" ((:) "A" [])))) "parser treated comments or strings as imports")
 , check "test_truncated_source_rejected" (do
  app <- A.liftIO (make r "truncated" "Truncated" [] "")
  S.mapM_ (\source -> do { A.liftIO (writeFile (directory ++ "/truncated/Source.emlf") source); plan r app false "" }) ((:) "{- open {- nested -}" ((:) "module Truncated where\nvalue = \"open" [])))
 , check "test_json_unicode_and_invalid_tokens" (do
  app <- A.liftIO (make r "unicode" "Unicode" [] "")
  A.liftIO (O.move (directory ++ "/unicode/Source.emlf") (directory ++ "/unicode/λ😀.emlf"))
  A.liftIO (modify app (J.set "library" (J.Object ((:) ((,) "modules" (J.Object ((:) ((,) "Unicode" (J.str "λ😀.emlf")) []))) []))))
  text <- plan r app true ""
  doc <- A.right (\message -> message) (J.parse text)
  A.assert (J.has "λ😀.emlf" (J.get "sources" (S.head (J.values (J.get "packages" doc))))) "Unicode source path lost"
  -- Query reports contain thousands of records and long stable identities.
  -- Exercise offset scanning, long runs, all escapes and surrogate pairs in one
  -- multi-megabyte document without relying on the JSON renderer as its oracle.
  let member = S.concatStrings (S.replicate 64 "module_λ😀0123456789abcdef")
  let longText = S.concatStrings (S.replicate 4096 "λ😀0123456789abcdef")
  let group = "{\"cached\":false,\"members\":[\"" ++ member ++ "\"],\"count\":-12.5E+3,\"missing\":null}"
  let large = "{\"groups\":[" ++ S.intercalate "," (S.replicate 2048 group) ++ "],\"long\":\"" ++ longText ++ "\",\"escaped\":\"\\\"\\\\\\/\\b\\f\\n\\r\\t\\u03bb\\ud83d\\ude00\",\"ok\":true}"
  parsed <- A.right (\message -> message) (J.parse large)
  let groups = J.values (J.get "groups" parsed)
  A.assert (S.length groups == 2048 && J.equal (J.get "members" (S.last groups)) (J.stringArray ((:) member []))) "large JSON query records changed"
  A.assert (eqString (J.text (J.get "long" parsed)) longText && eqString (J.text (J.get "escaped" parsed)) "\"\\/\b\f\n\r\tλ😀") "JSON string chunks or escapes changed"
  A.assert (J.equal (J.get "count" (S.head groups)) (J.Number "-12.5E+3") && J.equal (J.get "missing" (S.head groups)) J.Null && J.getBool "ok" false parsed && S.not (J.getBool "cached" true (S.last groups))) "JSON literal or number parsing changed"
  roundtrip <- A.right (\message -> message) (J.parse (J.render parsed))
  A.assert (J.equal (J.get "long" roundtrip) (J.get "long" parsed) && J.equal (J.get "escaped" roundtrip) (J.get "escaped" parsed)) "long JSON string rendering changed"
  S.mapM_ (\((,) invalid expected) -> case J.parse invalid of {Left message -> A.assert (eqString message expected) "JSON error offset changed"; Right _ -> A.fail "invalid JSON was accepted"}) ((:) ((,) "{\"x\":\"\\ud800\"}" "invalid JSON at offset 7") ((:) ((,) "[1e+]" "invalid JSON at offset 1") ((:) ((,) "{\"x\":true,\"x\":false}" "duplicate JSON key: x") [])))
  S.mapM_ (\text -> do { A.liftIO (writeFile app text); plan r app false "invalid JSON" }) ((:) "{\"format\":1,}" ((:) "{\"format\":01}" ((:) "{\"name\":\"\\ud800\"}" ((:) "[true,]" [])))))
 , check "test_target_dependencies_default" (do
  app <- A.liftIO (make r "target-default" "Unused" ((:) ((,) "base" "../base") ((:) ((,) "left" "../left") [])) "")
  A.liftIO (writeFile (directory ++ "/target-default/Main.emlf") "module Main where\nimport Base\nimport Left\nmain = value\n")
  A.liftIO (modify app (\doc -> J.set "library" J.empty (J.set "executables" (J.Object ((:) ((,) "main" (J.Object ((:) ((,) "main" (J.str "Main.emlf")) []))) [])) doc)))
  text <- plan r app true ""
  doc <- A.right (\message -> message) (J.parse text)
  let target = S.last (J.values (J.get "crates" doc))
  A.assert (J.equal (J.get "dependencies" target) (J.stringArray ((:) "base/0.1.0/library" ((:) "left/0.1.0/library" [])))) "omitted target dependencies changed compatibility")
 , check "test_target_dependencies_selection" (do
  app <- A.liftIO (make r "target-selected" "Unused" ((:) ((,) "base" "../base") ((:) ((,) "left" "../left") [])) "")
  A.liftIO (writeFile (directory ++ "/target-selected/Main.emlf") "module Main where\nimport Base\nmain = value\n")
  let target = J.Object ((:) ((,) "main" (J.str "Main.emlf")) ((:) ((,) "dependencies" (J.stringArray ((:) "base" []))) []))
  A.liftIO (modify app (\doc -> J.set "library" J.empty (J.set "executables" (J.Object ((:) ((,) "main" target) [])) doc)))
  text <- plan r app true ""
  doc <- A.right (\message -> message) (J.parse text)
  A.assert (J.equal (J.get "dependencies" (S.last (J.values (J.get "crates" doc)))) (J.stringArray ((:) "base/0.1.0/library" []))) "target selected an unrelated package"
  A.liftIO (writeFile (directory ++ "/target-selected/Main.emlf") "module Main where\nimport Left\nmain = value\n")
  plan r app false "selected direct dependency")
 , check "test_target_dependencies_empty" (do
  app <- A.liftIO (make r "target-empty" "Unused" ((:) ((,) "base" "../base") []) "")
  A.liftIO (writeFile (directory ++ "/target-empty/Main.emlf") "module Main where\nmain = 1\n")
  let target = J.Object ((:) ((,) "main" (J.str "Main.emlf")) ((:) ((,) "dependencies" (J.Array [])) []))
  A.liftIO (modify app (\doc -> J.set "library" J.empty (J.set "executables" (J.Object ((:) ((,) "main" target) [])) doc)))
  text <- plan r app true ""
  doc <- A.right (\message -> message) (J.parse text)
  A.assert (J.equal (J.get "dependencies" (S.last (J.values (J.get "crates" doc)))) (J.Array [])) "explicit empty target dependencies inherited package dependencies")
 , check "test_target_dependencies_validation" (do
  app <- A.liftIO (make r "target-invalid" "Unused" ((:) ((,) "base" "../base") []) "")
  A.liftIO (writeFile (directory ++ "/target-invalid/Main.emlf") "module Main where\nmain = 1\n")
  S.mapM_ (\((,) selected expected) -> do
   let target = J.Object ((:) ((,) "main" (J.str "Main.emlf")) ((:) ((,) "dependencies" selected) []))
   A.liftIO (modify app (\doc -> J.set "library" J.empty (J.set "executables" (J.Object ((:) ((,) "main" target) [])) doc)))
   plan r app false expected) ((:) ((,) (J.stringArray ((:) "left" [])) "not a direct package dependency") ((:) ((,) (J.stringArray ((:) "base" ((:) "base" []))) "duplicate target dependency") ((:) ((,) (J.str "base") "expected JSON array") []))))
 ]
