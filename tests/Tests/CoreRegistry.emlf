familyBindings name = S.lookup eqString name bindings
scope : String -> Bool -> C.Case -> C.Case
scope target complete (C.Case identity label tags action) =
 C.Case identity label (S.append tags ((:) "logical-unit:core"
  ((:) ("physical-target:" ++ target) ((:) ("logical-scope:" ++ (if complete then "full" else "partial"))
  ((:) "qualification:ineligible" ((:) "adapter:legacy-process" [])))))) action

registerFamily : String -> Bool -> (,) String ([] ((,) String (IO ()))) -> Either String ([] C.Case)
registerFamily target complete ((,) family actions) = case familyBindings family of
 Nothing -> Left "core family has no reviewed leaf bindings"
 Just expected ->
  if S.not (S.eqList eqString (S.map S.fst actions) (S.map S.fst expected)) then
   Left ("core action labels differ from frozen family bindings: " ++ family)
  else Right (S.map (\((,) label body) ->
   let identity = S.fromMaybe (panic "validated core binding disappeared") (S.lookup eqString label expected) in
   scope target complete (C.fromIO identity ((:) ("family:" ++ family) []) ((,) label body))) actions)
register : String -> Bool -> [] ((,) String ([] ((,) String (IO ())))) -> Either String ([] C.Case)
register target complete families = do
 rows <- S.mapM (registerFamily target complete) families
 Right (S.concat rows)
