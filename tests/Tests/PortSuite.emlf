module Tests.PortSuite where
import Bootstrap.Types
import qualified Bootstrap.Std as S
import qualified Package.OS as O
import qualified Package.Json as J
import qualified Package.Verification as V
import qualified Package.Manifest as M
import qualified Tests.TestSources as TS
import qualified Tests.Helpers as H
import qualified Tests.Backends as B
import qualified Tests.Bytes as Bytes
import qualified Tests.Selection as Selection
import qualified Bootstrap.Compiler as C
import qualified Tests.IndependentCheck as Check
import qualified Bootstrap.X.Parser as P
import qualified Bootstrap.X.Pretty as Pretty
import qualified Bootstrap.X.Syntax as X
import qualified Bootstrap.X.Type as T
import qualified Bootstrap.Primitive as Primitive
import qualified Bootstrap.Data as D
names : List String
names = O.words "foundation MapFolds IntegerContainers OptimizerQueries ConstructorProjection ForceReuse StrictFields prelude Target frontend LexerCounters LLVMBuild RuntimeCases StateRuntime StateTypes GraphConformance GraphScopes GraphDense OrderedTraversal SolverReuse TypeCache GraphStack EmbeddingPruning InferenceConformance PrimitiveMetadata"
familyId name = "port/" ++ name
familyIds = S.map familyId names
references : List (Pair String String)
references = Cons (Pair "GraphConformance" "GraphReference") (Cons (Pair "GraphScopes" "GraphScopesReference") (Cons (Pair "GraphDense" "GraphDenseReference") (Cons (Pair "OrderedTraversal" "OrderedTraversalReference") (Cons (Pair "EmbeddingPruning" "EmbeddingPruningReference") (Cons (Pair "InferenceConformance" "InferenceReference") Nil)))))
metadata : String
metadata = S.unlines (S.map (\primitive -> case Primitive.primitiveSignature primitive of
 Pair variables field -> showInt (Primitive.primitiveCode primitive) ++ "\t" ++ Primitive.primitiveName primitive ++ "\t" ++ showInt (Primitive.primitiveArity primitive) ++ "\t" ++ (if Primitive.primitiveStrict primitive then "strict" else "lazy") ++ "\t" ++ D.prettyDeclaration (DataDeclK "Sig" variables (Cons (ConstructorDecl "M" (Cons field Nil)) Nil))) Primitive.allPrimitives)
-- Preparation runs once for a source/tool identity. The immutable target bytes
-- can then be executed natively and independently by each runtime layout.
prepareFixture : String -> String -> IO Unit
prepareFixture name destination = do
 H.assert (S.elem eqString name names) "unknown port fixture"
 let source = "bootstrap/tests/" ++ name ++ ".emlf"
 graph <- M.load "mlf-package.json"
 result <- C.compileFile (TS.portRoots graph) source
 compilation <- H.right result
 ty <- H.right (Check.checkClosed (C.compiledTerm compilation))
 expected <- H.right (P.parseType "IO Unit")
 H.assert (T.alphaEq ty (C.inferredType compilation) && T.alphaEq ty expected) "port inferred/target type differs"
 parsed <- H.right (P.parseTerm source (Pretty.prettyTerm (C.compiledTerm compilation)))
 parsedType <- H.right (Check.checkClosed parsed)
 H.assert (T.alphaEq parsedType ty && X.equalErased (X.erase parsed) (X.erase (C.compiledTerm compilation))) "port target serialization changed"
 let serialized = B.serializeTerm parsed
 transported <- H.right (P.parseTerm source serialized)
 transportedType <- H.right (Check.checkClosed transported)
 H.assert (T.alphaEq transportedType ty) "port transport changed the target type"
 writeFile destination serialized
 hash <- fileDigest destination
 J.write (destination ++ ".checks.json") (J.Object (Cons (Pair "format" (J.num 1)) (Cons (Pair "fixture" (J.str name)) (Cons (Pair "target_sha256" (J.str hash)) (Cons (Pair "entry_type" (J.str "IO Unit")) (Cons (Pair "inferred_type" (J.str (Pretty.prettyType ty))) (Cons (Pair "checks" V.portTargetChecks) Nil)))))))
 putStrLn ("CHECKED " ++ name)
preparedSource : String -> IO String
preparedSource name = preparedSourceFor names true name
preparedSourceFor : List String -> Bool -> String -> IO String
preparedSourceFor selected full name = do
 path <- getEnv "MLF_TEST_PORT_TARGETS"
 expected <- getEnv "MLF_TEST_PORT_TARGETS_SHA256"
 H.assert (stringLength path > 0 && stringLength expected == 64) "missing prepared port targets"
 actual <- fileDigest path
 H.assert (eqString actual expected) "prepared port manifest changed"
 manifest <- J.read path
 let rows = J.values (J.get "targets" manifest)
 let actualNames = S.map (J.getText "fixture" "") rows
 let fullCoverage = eqString (J.getText "scope" "full" manifest) "full" && S.length rows == 25 && S.eqList eqString (S.sortBy compareString names) (S.sortBy compareString actualNames)
 let partialCoverage = eqString (J.getText "scope" "" manifest) "partial" && S.not (S.null selected) && S.length selected == S.length (S.nubBy eqString selected) && S.all (\fixture -> S.elem eqString fixture names) selected && J.equal (J.get "selected_fixtures" manifest) (J.stringArray selected) && S.length rows == S.length selected && S.eqList eqString (S.sortBy compareString selected) (S.sortBy compareString actualNames)
 H.assert (J.equal (J.get "format" manifest) (J.num 1) && (if full then fullCoverage else partialCoverage)) "prepared port coverage changed"
 row <- case S.find (\row -> eqString name (J.getText "fixture" "" row)) rows of {Just row -> return row; Nothing -> H.fail "prepared port target missing"}
 let target = J.getText "target" "" row
 digest <- fileDigest target
 H.assert (eqString digest (J.getText "target_sha256" "" row)) "prepared port target changed"
 checks <- J.read (target ++ ".checks.json")
 checksHash <- fileDigest (target ++ ".checks.json")
 H.assert (eqString checksHash (J.getText "checks_sha256" "" row) && V.validPortTargetChecks name digest checks) "prepared port check receipt changed"
 source <- readFile target
 after <- fileDigest target
 H.assert (eqString digest after) "prepared port target changed while reading"
 return source
runFixture : B.Backends -> String -> IO Unit
runFixture backends name = runPreparedFixture backends names true name
runPreparedFixture : B.Backends -> List String -> Bool -> String -> IO Unit
runPreparedFixture backends selected full name = do
 let source = "bootstrap/tests/" ++ name ++ ".emlf"
 expected <- if eqString name "PrimitiveMetadata" then return (Bytes.encode metadata) else Bytes.readFile ("bootstrap/tests/" ++ name ++ ".expected")
 H.assert (S.not (Bytes.null expected)) "empty port fixture expectation"
 case S.lookup eqString name references of
  Nothing -> return Unit
  Just reference -> do
   exe <- getEnv "MLF_TEST_REFERENCES"
   work <- getEnv "MLF_TEST_WORK"
   code <- O.exec "" (Cons exe (Cons reference Nil)) "" (work ++ "/oracle.out") (work ++ "/oracle.err") 1800
   output <- Bytes.readFile (work ++ "/oracle.out")
   error <- readFile (work ++ "/oracle.err")
   H.assert (code == 0 && eqString error "" && H.eq output expected) ("independent reference differs: " ++ name)
   if eqString name "InferenceConformance" then do
    code <- O.exec "" (Cons exe (Cons reference (Cons "--generate" Nil))) "" (work ++ "/generated.emlf") (work ++ "/generated.err") 1800
    generated <- Bytes.readFile (work ++ "/generated.emlf")
    original <- Bytes.readFile source
    H.assert (code == 0 && H.eq generated original && H.contains "Fig12-A8\tREJECT Inference\n" (Bytes.decodeText expected)) "inference input generation or A8 coverage differs"
    else return Unit
 serialized <- preparedSourceFor selected full name
 let heavy = S.elem eqString name (O.words "GraphConformance GraphDense InferenceConformance SolverReuse StateTypes")
 let execution = B.withExecutionTimeout (if heavy then 1800 else 60) backends
 observed <- B.executeNativeSerialized execution B.IOEntry (B.Input "" false) serialized
 H.right (B.outcome observed)
 H.assert (H.eq (B.outputBytes observed) expected && eqString (B.stderrOutput observed) "" && eqString (B.remaining observed) "") ("port runtime output differs: " ++ name)
main : IO Unit
main = do
 args <- O.allArguments
 if Selection.listing args then putStr (S.unlines familyIds) else do
  H.assert (S.length names == 25 && S.length (S.nubBy eqString names) == 25 && S.length references == 6 && S.all (\(Pair name _) -> S.elem eqString name names) references) "port fixture or independent-reference coverage changed"
  case args of
   Cons "--list" Nil -> putStr (S.unlines names)
   Cons "--prepare" (Cons name (Cons destination Nil)) -> prepareFixture name destination
   _ -> executeFixtures args
executeFixtures : List String -> IO Unit
executeFixtures args = do
 Pair full selected <- case args of
  Cons "--only" names' -> do
   H.assert (S.not (S.null names') && S.length names' == S.length (S.nubBy eqString names') && S.all (\name -> S.elem eqString name names) names') "invalid port fixture selection"
   return (Pair false names')
  _ -> do
   Pair full identities <- H.right (Selection.choose familyIds args)
   return (Pair full (S.filter (\name -> S.elem eqString (familyId name) identities) names))
 let focused = case args of { Cons "--families" _ -> true; _ -> false }
 let expectedPrepared = if focused then selected else names
 Selection.begin "port" full (S.map familyId selected)
 B.withBackends (\backends -> do
  S.mapM_ (\name -> do
   B.inCase backends ("MLF compiler port: " ++ name) (do { runPreparedFixture backends expectedPrepared (S.not focused) name; putStrLn ("PASS " ++ name) })
   Selection.passed "port" (familyId name)) selected
  B.auditNativeBackends backends
  putStrLn (showInt (S.length selected) ++ " MLF port fixtures; 0 failures"))
 Selection.finish "port"
