module Tests.OrderedTraversalReference where
import Bootstrap.Types
import qualified Bootstrap.Std as S
import qualified Tests.Helpers as H
import qualified Package.OS as O
import qualified Tests.Graph as G
import Tests.Graph
import qualified Bootstrap.IntMap as IM
import qualified Bootstrap.IntSet as IS
import qualified Tests.Map as Map
import qualified Tests.Set as Set
import qualified Bootstrap.Graph.Solver as Solver
import Tests.GraphValidation (smallGraphs)
import Tests.GraphUnificationReference (referenceUnify)

graphFor : Int -> Graph
graphFor seed = (let { edges n = (H.concat (S.concatMap (\m -> (Cons (if ((remInt (((n * 13) + (m * 17)) + (seed * (n + 1))) 97) < 29) then (H.append (Cons (if (H.eq (remInt (m + seed) 3) 0) then (m + 200) else m) Nil) (if (H.eq (remInt ((n + m) + seed) 5) 0) then (Cons m Nil) else Nil)) else Nil) Nil)) (S.range 0 6))) } in (Graph (IM.fromList (S.concatMap (\n -> (Cons (Pair n (Node (GCon "T" (edges n)) Nothing Flexible)) Nil)) (S.range 0 6))) (IM.fromList (H.concat (S.concatMap (\n -> (Cons (Cons (Pair (n + 100) n) (Cons (Pair (n + 200) (n + 100)) Nil)) Nil)) (S.range 0 6)))) 300))

preseen : Int -> Int -> (List ( Int ))
preseen mode root = (case mode of { 0 -> Nil; 1 -> (Cons root Nil); 2 -> (Cons 0 (Cons 3 (Cons 6 Nil))); 3 -> (Cons 103 (Cons 999 Nil)); 4 -> (S.range 0 6); _ -> (H.append (S.range 100 106) (S.range 200 206)) })

showIds : (List ( Int )) -> String
showIds = (S.compose (H.intercalate ",") (S.map H.show))

checkGraph : Int -> Int -> ( Int -> Int ) -> IO Unit
checkGraph seed transform move = (let { graph = (graphFor seed) } in ((H.forM_ (H.append (S.range 0 6) (H.append (S.range 100 106) (S.range 200 206)))) (\root -> ((H.forM_ (S.range 0 5)) (\state -> ((H.forM_ (S.range 0 1)) (\prefixMode -> (let { initial = (IS.fromList (preseen state root)) } in (let { blocked = (Graph (IM.mapWithKey (\n value -> (if (IS.member n initial) then (Node GBot (G.binder value) (G.flag value)) else value)) (G.nodes graph)) (G.links graph) (G.nextId graph)) } in (let { order = (S.filter (\section1 -> (IS.notMember section1 initial)) (G.orderedBelow blocked root)) } in (let { seen = (IS.union initial (IS.fromList order)) } in (let { prefix = (if (H.eq prefixMode 0) then Nil else (Cons 999 (Cons 0 (Cons 999 Nil)))) } in (let { moveIds = (S.map (S.compose move S.id)) } in (let { renamedSeen = (Set.toList (Set.fromList (moveIds (IS.toList seen)))) } in do { (S.unless (H.eq (H.length order) (IS.size (IS.fromList order))) (H.fail "seed repeated a structural node")); (putStrLn (H.append (H.intercalate "/" (S.map H.show (Cons seed (Cons transform (Cons root (Cons state (Cons prefixMode Nil))))))) (H.append "|" (H.append (showIds renamedSeen) (H.append "|" (showIds (moveIds (H.append prefix order)))))))) }))))))))))))))

main : IO Unit
main = do { (putStrLn "ordered traversal demand: ok"); (let { handGraph = (Graph (IM.fromList (Cons (Pair 0 (Node (GArr 1 2) Nothing Flexible)) (Cons (Pair 1 (Node (GTyApp 4 3) Nothing Flexible)) (Cons (Pair 2 (Node (GGen 4) Nothing Flexible)) (Cons (Pair 3 (Node GBot Nothing Flexible)) (Cons (Pair 4 (Node (GCon "Cycle" (Cons 0 (Cons 5 (Cons 5 Nil)))) Nothing Flexible)) (Cons (Pair 5 (Node (GTyCon "K" Star) Nothing Flexible)) Nil))))))) IM.empty 6) } in do { (S.unless (H.eq (G.orderedBelow handGraph 0) (Cons 5 (Cons 4 (Cons 3 (Cons 1 (Cons 2 (Cons 0 Nil))))))) (H.fail "seed mixed-tag order changed")); do { (putStrLn "mixed-tag order: 5,4,3,1,2,0"); do { ((H.forM_ (S.range 0 15)) (\seed -> (checkGraph seed 0 (\n -> ((n * 11) - 29))))); (let { huge = (H.power 10 30) } in do { (checkGraph 7 1 (\section2 -> (huge + section2))); do { (checkGraph 12 2 (H.subtract huge)); (checkGraph 9 3 (\section3 -> (huge - section3))) } }) } } }) }
