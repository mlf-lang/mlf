module Tests.OrderedTraversalReference where
import Bootstrap.Types
import qualified Bootstrap.Std as S
import qualified Tests.Helpers as H
import qualified Package.OS as O
import qualified Tests.Graph as G
import Tests.Graph
import qualified Bootstrap.IntMap as IM
import qualified Bootstrap.IntSet as IS
import qualified Tests.Map as Map
import qualified Tests.Set as Set
import qualified Bootstrap.Graph.Solver as Solver
import Tests.GraphValidation (smallGraphs)
import Tests.GraphUnificationReference (referenceUnify)

graphFor : Int -> Graph
graphFor seed = (let { edges n = (H.concat (S.concatMap (\m -> ((:) (if ((remInt (((n * 13) + (m * 17)) + (seed * (n + 1))) 97) < 29) then (H.append ((:) (if (H.eq (remInt (m + seed) 3) 0) then (m + 200) else m) []) (if (H.eq (remInt ((n + m) + seed) 5) 0) then ((:) m []) else [])) else []) [])) (S.range 0 6))) } in (Graph (IM.fromList (S.concatMap (\n -> ((:) ((,) n (Node (GCon "T" (edges n)) Nothing Flexible)) [])) (S.range 0 6))) (IM.fromList (H.concat (S.concatMap (\n -> ((:) ((:) ((,) (n + 100) n) ((:) ((,) (n + 200) (n + 100)) [])) [])) (S.range 0 6)))) 300))

preseen : Int -> Int -> ([] ( Int ))
preseen mode root = (case mode of { 0 -> []; 1 -> ((:) root []); 2 -> ((:) 0 ((:) 3 ((:) 6 []))); 3 -> ((:) 103 ((:) 999 [])); 4 -> (S.range 0 6); _ -> (H.append (S.range 100 106) (S.range 200 206)) })

showIds : ([] ( Int )) -> String
showIds = (S.compose (H.intercalate ",") (S.map H.show))

checkGraph : Int -> Int -> ( Int -> Int ) -> IO ()
checkGraph seed transform move = (let { graph = (graphFor seed) } in ((H.forM_ (H.append (S.range 0 6) (H.append (S.range 100 106) (S.range 200 206)))) (\root -> ((H.forM_ (S.range 0 5)) (\state -> ((H.forM_ (S.range 0 1)) (\prefixMode -> (let { initial = (IS.fromList (preseen state root)) } in (let { blocked = (Graph (IM.mapWithKey (\n value -> (if (IS.member n initial) then (Node GBot (G.binder value) (G.flag value)) else value)) (G.nodes graph)) (G.links graph) (G.nextId graph)) } in (let { order = (S.filter (\section1 -> (IS.notMember section1 initial)) (G.orderedBelow blocked root)) } in (let { seen = (IS.union initial (IS.fromList order)) } in (let { prefix = (if (H.eq prefixMode 0) then [] else ((:) 999 ((:) 0 ((:) 999 [])))) } in (let { moveIds = (S.map (S.compose move S.id)) } in (let { renamedSeen = (Set.toList (Set.fromList (moveIds (IS.toList seen)))) } in do { (S.unless (H.eq (H.length order) (IS.size (IS.fromList order))) (H.fail "seed repeated a structural node")); (putStrLn (H.append (H.intercalate "/" (S.map H.show ((:) seed ((:) transform ((:) root ((:) state ((:) prefixMode []))))))) (H.append "|" (H.append (showIds renamedSeen) (H.append "|" (showIds (moveIds (H.append prefix order)))))))) }))))))))))))))

main : IO ()
main = do { (putStrLn "ordered traversal demand: ok"); (let { handGraph = (Graph (IM.fromList ((:) ((,) 0 (Node (GArr 1 2) Nothing Flexible)) ((:) ((,) 1 (Node (GTyApp 4 3) Nothing Flexible)) ((:) ((,) 2 (Node (GGen 4) Nothing Flexible)) ((:) ((,) 3 (Node GBot Nothing Flexible)) ((:) ((,) 4 (Node (GCon "Cycle" ((:) 0 ((:) 5 ((:) 5 [])))) Nothing Flexible)) ((:) ((,) 5 (Node (GTyCon "K" Star) Nothing Flexible)) []))))))) IM.empty 6) } in do { (S.unless (H.eq (G.orderedBelow handGraph 0) ((:) 5 ((:) 4 ((:) 3 ((:) 1 ((:) 2 ((:) 0 []))))))) (H.fail "seed mixed-tag order changed")); do { (putStrLn "mixed-tag order: 5,4,3,1,2,0"); do { ((H.forM_ (S.range 0 15)) (\seed -> (checkGraph seed 0 (\n -> ((n * 11) - 29))))); (let { huge = (H.power 10 30) } in do { (checkGraph 7 1 (\section2 -> (huge + section2))); do { (checkGraph 12 2 (H.subtract huge)); (checkGraph 9 3 (\section3 -> (huge - section3))) } }) } } }) }
