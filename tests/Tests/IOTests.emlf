module Tests.IOTests where
import Bootstrap.Types
import qualified Bootstrap.Std as S
import qualified Package.OS as OS
import qualified Tests.Helpers as H
import Tests.Helpers (Quint(..), Sext(..))
import Tests.Backends
import qualified Tests.Backends as B
import Bootstrap.Compiler
import qualified Bootstrap.Data as D
import qualified Bootstrap.Primitive as P
import qualified Bootstrap.X.Check as C
import qualified Bootstrap.X.Parser as XP
import Bootstrap.X.Pretty (prettyTerm)
import qualified Bootstrap.X.Syntax as X
import qualified Bootstrap.X.Type as T

checked : String -> IO ((,) (Compilation) (XTerm))
checked source = do { result <- (H.right (compile "<IO test>" source)); do { term <- (H.right (XP.parseTerm "<IO xMLF>" (prettyTerm (compiledTerm result)))); do { ty <- (H.right (C.checkClosed term)); do { (H.assert (T.alphaEq ty (inferredType result)) "IO round trip changed the type"); do { (H.assert (H.eq (X.erase term) (X.erase (compiledTerm result))) "IO round trip changed erasure"); (return ((,) result term)) } } } } }

runsOn : B.Backends -> String -> String -> ([] ( String )) -> ([] ( B.Event )) -> (,) String (IO ())
runsOn backends label source inputs expected = ((,) (H.append "IO: " label) do { ((,) _ term) <- (checked source); do { ((,) result trace) <- (B.capture backends term inputs); do { (H.right result); (H.assert (H.eq trace expected) (H.append "expected " (H.append (H.show expected) (H.append ", got " (H.show trace))))) } } })

hasType : String -> String -> XType -> (,) String (IO ())
hasType label source expected = ((,) (H.append "IO type: " label) do { ((,) result _) <- (checked source); (H.assert (T.alphaEq (inferredType result) expected) (H.append "wrong type: " (sourceType result))) })

rejects : String -> String -> String -> (,) String (IO ())
rejects label source reason = ((,) (H.append "IO rejection: " label) (case (compile "<invalid IO>" source) of { (Left err) -> (H.assert ((H.eq (phase err) Inference) && (H.contains reason (diagnostic err))) (H.show err)); (Right result) -> (H.fail (H.append "unexpected acceptance: " (sourceType result))) }))

rejectsIsStringInt : String -> String -> (,) String (IO ())
rejectsIsStringInt label source = ((,) (H.append "IO string constraint: " label) (case (compile "<invalid string instance>" source) of { Left err -> H.assert ((H.eq (phase err) Resolution) && (H.contains "no instance or given constraint" (diagnostic err)) && (H.contains "IsString" (diagnostic err)) && (H.contains "Int" (diagnostic err))) (H.show err); Right result -> H.fail (H.append "unexpected acceptance: " (sourceType result)) }))

targetRejectsOn : B.Backends -> String -> XTerm -> String -> (,) String (IO ())
targetRejectsOn backends label term reason = ((,) (H.append "IO target: " label) do { observed <- (B.execute backends IOEntry (Input "" false) term); (case (B.outcome observed) of { (Left err) -> (H.assert ((H.contains reason (H.show err)) && (H.null (B.events observed))) (H.show err)); (Right ()) -> (H.fail "invalid target accepted by both backends") }) })

int : XType
int = (XCon "Int" [])

string : XType
string = (XCon "String" [])

unit : XType
unit = (XCon "()" [])

io : XType -> XType
io t = (XCon "IO" ((:) t []))

monadIO : String
monadIO = ""

ioTests : B.Backends -> ([] ( (,) String (IO ()) ))
ioTests backends = (let { runs = (runsOn backends) } in (let { capture = (B.capture backends) } in (let { targetRejects = (targetRejectsOn backends) } in (let { law label left rightExpression expected = ((,) (H.append "IO monad law: " label) (let { prefix = (H.append "let action = do { putStrLn \"action\"; return 7 } in " (H.append "let f = \\n -> do { printInt n; return \"done\" } in " "let g = \\s -> do { putStrLn s; return \"end\" } in ")) } in (let { finish expression = (H.append prefix (H.append "bind (" (H.append expression (H.append ") " (if (H.eq label "right identity") then "printInt" else "putStrLn"))))) } in do { ((,) _ a) <- (checked (finish left)); do { ((,) _ b) <- (checked (finish rightExpression)); do { ((,) resultA traceA) <- (capture a []); do { ((,) resultB traceB) <- (capture b []); do { (H.right resultA); do { (H.right resultB); (H.assert ((H.eq traceA expected) && (H.eq traceB expected)) (H.show ((,) traceA traceB))) } } } } } }))) } in ((:) (hasType "annotated opaque string literal" "(\"hello\" :: String)" string) ((:) (hasType "unit literal" "()" unit) ((:) (hasType "ordinary nominal Unit constructor" "data Unit = Unit; Unit" (XCon "Unit" [])) ((:) (hasType "unit type alias" "return () :: IO ()" (io unit)) ((:) (hasType "getLine" "getLine" (io string)) ((:) (hasType "putStrLn" "putStrLn \"hello\"" (io unit)) ((:) (hasType "return" "return 42 :: IO Int" (io int)) ((:) (hasType "IO-specific return" "ioReturn 42" (io int)) ((:) (hasType "pure" "pure true :: IO Bool" (io (XCon "Bool" []))) ((:) (runs "greeting and input order" "do { putStr \"Name: \"; name <- getLine; putStrLn (concatString \"Hello, \" name) }" ((:) "Ada" []) ((:) (Write "Name: ") ((:) ReadLine ((:) (Write "Hello, Ada\n") [])))) ((:) (runs "integer printing and string conversion" "do { printInt (-42); putStrLn (showInt 123456789012345678901234567890) }" [] ((:) (Write "-42\n") ((:) (Write "-4362896299872285998\n") []))) ((:) (runs "integer arithmetic is signed and wraps at 64 bits" "do { printInt (addInt (-7) 3); printInt (subInt 3 7); printInt (addInt 999999999999999999999999999999 1) }" [] ((:) (Write "-4\n") ((:) (Write "-4\n") ((:) (Write "5076944270305263616\n") [])))) ((:) (runs "integer equality and strict ordering" (H.append "let report = \\b -> printInt (ifThenElse b 1 0) in do { " (H.append "report (eqInt (-3) (-3)); report (eqInt (-3) 3); " "report (ltInt (-3) 3); report (ltInt 3 3); report (ltInt 4 3) }")) [] (S.map Write ((:) "1\n" ((:) "0\n" ((:) "1\n" ((:) "0\n" ((:) "0\n" []))))))) ((:) (runs "string equality respects case, empty strings, and Unicode" (H.append "let report = \\b -> printInt (ifThenElse b 1 0) in do { " (H.append "report (eqString \"\" \"\"); report (eqString \"w\" \"W\"); " "report (eqString \"你好\" \"你好\"); report (eqString \"a\" \"ab\") }")) [] (S.map Write ((:) "1\n" ((:) "0\n" ((:) "1\n" ((:) "0\n" [])))))) ((:) (runs "primitives are curried ordinary values" "let increment = addInt 1 in let choose = ifThenElse false in printInt (choose 0 (increment 41))" [] ((:) (Write "42\n") [])) ((:) (runs "conditional executes only the chosen IO branch" "do { ifThenElse true (putStrLn \"yes\") (bind getLine putStrLn); ifThenElse false (bind getLine putStrLn) (putStrLn \"no\") }" [] ((:) (Write "yes\n") ((:) (Write "no\n") []))) ((:) (runs "conditional preserves a polymorphic branch" "let id = ifThenElse true (\\x -> x) (\\x -> x) in do { printInt (id 42); putStrLn (id \"ok\") }" [] ((:) (Write "42\n") ((:) (Write "ok\n") []))) ((:) (runs "local bindings shadow arithmetic primitives" "let addInt = \\x y -> subInt x y in printInt (addInt 7 3)" [] ((:) (Write "4\n") [])) ((:) ((,) "IO: conditional does not force an unselected pure branch" do { ((,) _ term) <- (checked (H.append "data Loop a = Loop (Loop a -> a); " (H.append "let spin : Int = let go = \\r -> case r of { Loop f -> f r } in go (Loop go) in " "do { printInt (ifThenElse true 1 spin); printInt (ifThenElse false spin 2) }"))); do { ((,) result trace) <- (capture term []); do { (H.right result); (H.assert (H.eq trace ((:) (Write "1\n") ((:) (Write "2\n") []))) (H.show trace)) } } }) ((:) (runs "string escapes and unicode" "putStrLn \"你好\\n\\\"quoted\\\"\\t\\\\\"" [] ((:) (Write "你好\n\"quoted\"\t\\\n") [])) ((:) (runs "an action can be executed more than once" "let input = getLine in do { a <- input; b <- input; putStrLn (concatString a b) }" ((:) "first" ((:) "second" [])) ((:) ReadLine ((:) ReadLine ((:) (Write "firstsecond\n") [])))) ((:) (runs "constructing unused actions has no effects" "let ignored = putStrLn \"wrong\" in return () :: IO ()" [] []) ((:) (runs "return does not execute its argument" "return (putStrLn \"wrong\") :: IO (IO ())" [] []) ((:) (runs "extracting a nested action still needs sequencing" "do { action <- return (putStrLn \"once\"); action }" [] ((:) (Write "once\n") [])) ((:) (runs "unit pattern" "do { () <- putStrLn \"one\"; return () }" [] ((:) (Write "one\n") [])) ((:) (runs "polymorphic function returned by IO" "do { id <- return (\\x -> x); printInt (id 42) }" [] ((:) (Write "42\n") [])) ((:) (runs "local bindings shadow IO primitives" "let putStrLn = \\x -> ioReturn x in ioBind (putStrLn \"quiet\") (\\x -> ioReturn ())" [] []) ((:) (runs "data fields can contain IO actions" "data Box a = Box a; case Box (putStrLn \"field\") of { Box action -> action }" [] ((:) (Write "field\n") [])) ((:) (runs "unselected case branch has no effects" "data Choice = First | Second; case First of { First -> putStrLn \"first\"; Second -> putStrLn \"wrong\" }" [] ((:) (Write "first\n") [])) ((:) (runs "constructor and case evaluation" "data Pair a b = Pair a b; let pair = Pair 42 in case pair true of { Pair number flag -> printInt number }" [] ((:) (Write "42\n") [])) ((:) (runs "recursive dictionary methods" (H.append "data List a = Nil | Cons a (List a); class PrintList a where { printList : List a -> IO () }; " (H.append "instance PrintList Int where { printList = \\xs -> case xs of { Nil -> return (); Cons n rest -> do { printInt n; printList rest } } }; " "printList (Cons 1 (Cons 2 Nil))")) [] ((:) (Write "1\n") ((:) (Write "2\n") []))) ((:) (runs "generic Monad IO bind" (H.append monadIO "let twice : forall (m : * -> *) a. Monad m => m a -> m a = \\action -> do { action; value <- action; return value } in twice (putStrLn \"again\")") [] ((:) (Write "again\n") ((:) (Write "again\n") []))) ((:) (runs "generic Monad IO input" (H.append monadIO "let echo : forall (m : * -> *). Monad m => m String -> (String -> m ()) -> m () = \\input output -> do { line <- input; output line } in echo getLine putStrLn") ((:) "generic" []) ((:) ReadLine ((:) (Write "generic\n") []))) ((:) (rejects "IO cannot be redefined" "data IO a = Fake a; Fake 42" "cannot redefine a primitive type") ((:) (rejects "String cannot be redefined" "data String = Text; Text" "cannot redefine a primitive type") ((:) (rejects "nominal Unit is distinct from builtin unit" "data Unit = Unit; Unit :: ()" "type constructor mismatch") ((:) (hasType "ordinary Unit constructor in another datatype" "data Fake = Unit; Unit" (XCon "Fake" [])) ((:) (rejects "putStrLn expects a string" "putStrLn 42" "type constructor mismatch") ((:) (rejectsIsStringInt "arithmetic expects integers" "addInt 1 \"2\"") ((:) (rejects "comparison expects integers" "ltInt false 1" "type constructor mismatch") ((:) (rejects "string equality expects strings" "eqString 1 1" "type constructor mismatch") ((:) (rejects "conditional requires a Boolean" "ifThenElse 1 2 3" "type constructor mismatch") ((:) (rejectsIsStringInt "conditional branches must agree" "ifThenElse true 42 \"wrong\"") ((:) (rejectsIsStringInt "printInt expects an integer" "printInt \"42\"") ((:) (rejects "getLine is an action rather than a function" "getLine ()" "type constructor mismatch") ((:) (rejects "IO action cannot be used as a pure string" "putStrLn getLine" "type constructor mismatch") ((:) (rejects "bind continuation must return an action" "bind getLine (\\line -> line)" "type constructor mismatch") ((:) (rejects "IO has a fixed arity" "(\\x -> x) :: IO -> IO" "invalid type constructor arity") ((:) (rejects "IO cannot take two parameters" "(\\x -> x) :: IO Int Bool -> IO Int Bool" "kind * cannot be applied") ((:) (targetRejects "primitive type arity" (XPrimitive PIOReturn []) "primitive type argument arity mismatch") ((:) (targetRejects "primitive type kind" (XPrimitive PIOReturn ((:) (XCon "IO" []) [])) "primitive type argument kind mismatch") ((:) (targetRejects "primitive type scope" (XPrimitive PIOReturn ((:) (XVar (XTyVar 0)) [])) "unbound type variable") ((:) (targetRejects "primitive value argument type" (XApp (XPrimitive PPutStrLn []) (XIntTerm 42)) "application type mismatch") ((:) (targetRejects "conditional type argument arity" (XPrimitive PIfThenElse []) "primitive type argument arity mismatch") ((:) (targetRejects "conditional branch type checked independently" (XApp (XApp (XApp (XPrimitive PIfThenElse ((:) int [])) (XBoolTerm true)) (XIntTerm 1)) (XStringTerm "wrong")) "application type mismatch") ((:) (targetRejects "no IO constructor" (XConstructor "IO" ((:) int [])) "unknown data constructor") ((:) (targetRejects "target IO type cannot be forged" (XWithData ((:) (DataDecl "IO" ((:) "a" []) ((:) (ConstructorDecl "Fake" ((:) (Parameter "a") [])) [])) []) (XConstructor "Fake" ((:) int []))) "cannot redefine a primitive type") ((:) ((,) "IO: pure programs are not executable entry points" do { ((,) _ term) <- (checked "42"); do { ((,) outcome trace) <- (capture term []); (case outcome of { (Left err) -> (H.assert ((H.contains "must have type IO" (H.show err)) && (H.null trace)) (H.show ((,) err trace))); (Right _) -> (H.fail "pure program was executed") }) } }) ((:) ((,) "IO: target verification happens before any effects" (let { printTerm = (XApp (XPrimitive PPutStrLn []) (XStringTerm "must not print")) } in (let { bad = (XApp (XApp (XPrimitive PIOBind ((:) unit ((:) unit []))) printTerm) (XAbs (XName 0 "x") unit (XIntTerm 42))) } in do { ((,) outcome trace) <- (capture bad []); (case outcome of { (Left err) -> (H.assert ((H.contains "target verification failed" (H.show err)) && (H.null trace)) (H.show ((,) err trace))); (Right _) -> (H.fail "ill-typed IO reached execution") }) }))) ((:) ((,) "IO: EOF is reported and stops the continuation" do { ((,) _ term) <- (checked "do { line <- getLine; putStrLn line }"); do { ((,) outcome trace) <- (capture term []); (case outcome of { (Left err) -> (H.assert ((H.contains "test input exhausted" (H.show err)) && (H.eq trace ((:) ReadLine []))) (H.show ((,) err trace))); (Right _) -> (H.fail "EOF did not fail") }) } }) ((:) ((,) "IO: backend output errors are reported" do { ((,) _ term) <- (checked "putStrLn \"hello\""); do { observed <- (B.execute backends IOEntry (Input "" true) term); (case (B.outcome observed) of { (Left err) -> (H.assert ((H.contains "write failed" (H.show err)) && (H.eq (B.events observed) ((:) (Write "hello\n") []))) (H.show observed)); (Right _) -> (H.fail "output failure was swallowed") }) } }) ((:) ((,) "IO: unknown target primitive is rejected" (case (XP.parseTerm "<unknown primitive>" "primitive unsafePerformIO()") of { (Left err) -> (H.assert (H.contains "unknown primitive" err) err); (Right _) -> (H.fail "unknown primitive parsed") })) ((:) (law "left identity" "bind (return 42) f" "f 42" ((:) (Write "42\n") ((:) (Write "done\n") []))) ((:) (law "right identity" "bind action return" "action" ((:) (Write "action\n") ((:) (Write "7\n") []))) ((:) (law "associativity" "bind (bind action f) g" "bind action (\\x -> bind (f x) g)" ((:) (Write "action\n") ((:) (Write "7\n") ((:) (Write "done\n") ((:) (Write "end\n") []))))) [])))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))
