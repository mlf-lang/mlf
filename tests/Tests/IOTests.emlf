module Tests.IOTests where
import Bootstrap.Types
import qualified Bootstrap.Std as S
import qualified Package.OS as OS
import qualified Tests.Helpers as H
import Tests.Helpers (Quint(..), Sext(..))
import Tests.Backends
import qualified Tests.Backends as B
import Bootstrap.Compiler
import qualified Bootstrap.Data as D
import qualified Bootstrap.Primitive as P
import qualified Bootstrap.X.Check as C
import qualified Bootstrap.X.Parser as XP
import Bootstrap.X.Pretty (prettyTerm)
import qualified Bootstrap.X.Syntax as X
import qualified Bootstrap.X.Type as T

checked : String -> IO (Pair (Compilation) (XTerm))
checked source = do { result <- (H.right (compile "<IO test>" source)); do { term <- (H.right (XP.parseTerm "<IO xMLF>" (prettyTerm (compiledTerm result)))); do { ty <- (H.right (C.checkClosed term)); do { (H.assert (T.alphaEq ty (inferredType result)) "IO round trip changed the type"); do { (H.assert (H.eq (X.erase term) (X.erase (compiledTerm result))) "IO round trip changed erasure"); (return (Pair result term)) } } } } }

runsOn : B.Backends -> String -> String -> (List ( String )) -> (List ( B.Event )) -> Pair String (IO Unit)
runsOn backends label source inputs expected = (Pair (H.append "IO: " label) do { (Pair _ term) <- (checked source); do { (Pair result trace) <- (B.capture backends term inputs); do { (H.right result); (H.assert (H.eq trace expected) (H.append "expected " (H.append (H.show expected) (H.append ", got " (H.show trace))))) } } })

hasType : String -> String -> XType -> Pair String (IO Unit)
hasType label source expected = (Pair (H.append "IO type: " label) do { (Pair result _) <- (checked source); (H.assert (T.alphaEq (inferredType result) expected) (H.append "wrong type: " (sourceType result))) })

rejects : String -> String -> String -> Pair String (IO Unit)
rejects label source reason = (Pair (H.append "IO rejection: " label) (case (compile "<invalid IO>" source) of { (Left err) -> (H.assert ((H.eq (phase err) Inference) && (H.contains reason (diagnostic err))) (H.show err)); (Right result) -> (H.fail (H.append "unexpected acceptance: " (sourceType result))) }))

targetRejectsOn : B.Backends -> String -> XTerm -> String -> Pair String (IO Unit)
targetRejectsOn backends label term reason = (Pair (H.append "IO target: " label) do { observed <- (B.execute backends IOEntry (Input "" false) term); (case (B.outcome observed) of { (Left err) -> (H.assert ((H.contains reason (H.show err)) && (H.null (B.events observed))) (H.show err)); (Right Unit) -> (H.fail "invalid target accepted by both backends") }) })

int : XType
int = (XCon "Int" Nil)

string : XType
string = (XCon "String" Nil)

unit : XType
unit = (XCon "Unit" Nil)

io : XType -> XType
io t = (XCon "IO" (Cons t Nil))

monadIO : String
monadIO = (H.append "class Monad (m : * -> *) where { return : forall a. a -> m a; bind : forall a b. m a -> (a -> m b) -> m b }; " "instance Monad IO where { return = ioReturn; bind = ioBind }; ")

ioTests : B.Backends -> (List ( Pair String (IO Unit) ))
ioTests backends = (let { runs = (runsOn backends) } in (let { capture = (B.capture backends) } in (let { targetRejects = (targetRejectsOn backends) } in (let { law label left rightExpression expected = (Pair (H.append "IO monad law: " label) (let { prefix = (H.append "let action = do { putStrLn \"action\"; return 7 } in " (H.append "let f = \\n -> do { printInt n; return \"done\" } in " "let g = \\s -> do { putStrLn s; return \"end\" } in ")) } in (let { finish expression = (H.append prefix (H.append "bind (" (H.append expression (H.append ") " (if (H.eq label "right identity") then "printInt" else "putStrLn"))))) } in do { (Pair _ a) <- (checked (finish left)); do { (Pair _ b) <- (checked (finish rightExpression)); do { (Pair resultA traceA) <- (capture a Nil); do { (Pair resultB traceB) <- (capture b Nil); do { (H.right resultA); do { (H.right resultB); (H.assert ((H.eq traceA expected) && (H.eq traceB expected)) (H.show (Pair traceA traceB))) } } } } } }))) } in (Cons (hasType "string literal" "\"hello\"" string) (Cons (hasType "unit literal" "()" unit) (Cons (hasType "unit constructor" "Unit" unit) (Cons (hasType "unit type alias" "return () : IO ()" (io unit)) (Cons (hasType "getLine" "getLine" (io string)) (Cons (hasType "putStrLn" "putStrLn \"hello\"" (io unit)) (Cons (hasType "return" "return 42 : IO Int" (io int)) (Cons (hasType "IO-specific return" "ioReturn 42" (io int)) (Cons (hasType "pure" "pure true" (io (XCon "Bool" Nil))) (Cons (runs "greeting and input order" "do { putStr \"Name: \"; name <- getLine; putStrLn (concatString \"Hello, \" name) }" (Cons "Ada" Nil) (Cons (Write "Name: ") (Cons ReadLine (Cons (Write "Hello, Ada\n") Nil)))) (Cons (runs "integer printing and string conversion" "do { printInt (-42); putStrLn (showInt 123456789012345678901234567890) }" Nil (Cons (Write "-42\n") (Cons (Write "123456789012345678901234567890\n") Nil))) (Cons (runs "integer arithmetic is signed and unbounded" "do { printInt (addInt (-7) 3); printInt (subInt 3 7); printInt (addInt 999999999999999999999999999999 1) }" Nil (Cons (Write "-4\n") (Cons (Write "-4\n") (Cons (Write "1000000000000000000000000000000\n") Nil)))) (Cons (runs "integer equality and strict ordering" (H.append "let report = \\b -> printInt (ifThenElse b 1 0) in do { " (H.append "report (eqInt (-3) (-3)); report (eqInt (-3) 3); " "report (ltInt (-3) 3); report (ltInt 3 3); report (ltInt 4 3) }")) Nil (S.map Write (Cons "1\n" (Cons "0\n" (Cons "1\n" (Cons "0\n" (Cons "0\n" Nil))))))) (Cons (runs "string equality respects case, empty strings, and Unicode" (H.append "let report = \\b -> printInt (ifThenElse b 1 0) in do { " (H.append "report (eqString \"\" \"\"); report (eqString \"w\" \"W\"); " "report (eqString \"你好\" \"你好\"); report (eqString \"a\" \"ab\") }")) Nil (S.map Write (Cons "1\n" (Cons "0\n" (Cons "1\n" (Cons "0\n" Nil)))))) (Cons (runs "primitives are curried ordinary values" "let increment = addInt 1 in let choose = ifThenElse false in printInt (choose 0 (increment 41))" Nil (Cons (Write "42\n") Nil)) (Cons (runs "conditional executes only the chosen IO branch" "do { ifThenElse true (putStrLn \"yes\") (bind getLine putStrLn); ifThenElse false (bind getLine putStrLn) (putStrLn \"no\") }" Nil (Cons (Write "yes\n") (Cons (Write "no\n") Nil))) (Cons (runs "conditional preserves a polymorphic branch" "let id = ifThenElse true (\\x -> x) (\\x -> x) in do { printInt (id 42); putStrLn (id \"ok\") }" Nil (Cons (Write "42\n") (Cons (Write "ok\n") Nil))) (Cons (runs "local bindings shadow arithmetic primitives" "let addInt = \\x y -> subInt x y in printInt (addInt 7 3)" Nil (Cons (Write "4\n") Nil)) (Cons (Pair "IO: conditional does not force an unselected pure branch" do { (Pair _ term) <- (checked (H.append "data Loop a = Loop (Loop a -> a); " (H.append "let spin : Int = let go = \\r -> case r of { Loop f -> f r } in go (Loop go) in " "do { printInt (ifThenElse true 1 spin); printInt (ifThenElse false spin 2) }"))); do { (Pair result trace) <- (capture term Nil); do { (H.right result); (H.assert (H.eq trace (Cons (Write "1\n") (Cons (Write "2\n") Nil))) (H.show trace)) } } }) (Cons (runs "string escapes and unicode" "putStrLn \"你好\\n\\\"quoted\\\"\\t\\\\\"" Nil (Cons (Write "你好\n\"quoted\"\t\\\n") Nil)) (Cons (runs "an action can be executed more than once" "let input = getLine in do { a <- input; b <- input; putStrLn (concatString a b) }" (Cons "first" (Cons "second" Nil)) (Cons ReadLine (Cons ReadLine (Cons (Write "firstsecond\n") Nil)))) (Cons (runs "constructing unused actions has no effects" "let ignored = putStrLn \"wrong\" in return () : IO Unit" Nil Nil) (Cons (runs "return does not execute its argument" "return (putStrLn \"wrong\") : IO (IO Unit)" Nil Nil) (Cons (runs "extracting a nested action still needs sequencing" "do { action <- return (putStrLn \"once\"); action }" Nil (Cons (Write "once\n") Nil)) (Cons (runs "unit pattern" "do { () <- putStrLn \"one\"; return () }" Nil (Cons (Write "one\n") Nil)) (Cons (runs "polymorphic function returned by IO" "do { id <- return (\\x -> x); printInt (id 42) }" Nil (Cons (Write "42\n") Nil)) (Cons (runs "local bindings shadow IO primitives" "let putStrLn = \\x -> ioReturn x in ioBind (putStrLn \"quiet\") (\\x -> ioReturn ())" Nil Nil) (Cons (runs "data fields can contain IO actions" "data Box a = Box a; case Box (putStrLn \"field\") of { Box action -> action }" Nil (Cons (Write "field\n") Nil)) (Cons (runs "unselected case branch has no effects" "data Choice = First | Second; case First of { First -> putStrLn \"first\"; Second -> putStrLn \"wrong\" }" Nil (Cons (Write "first\n") Nil)) (Cons (runs "constructor and case evaluation" "data Pair a b = Pair a b; let pair = Pair 42 in case pair true of { Pair number flag -> printInt number }" Nil (Cons (Write "42\n") Nil)) (Cons (runs "recursive dictionary methods" (H.append "data List a = Nil | Cons a (List a); class PrintList a where { printList : List a -> IO Unit }; " (H.append "instance PrintList Int where { printList = \\xs -> case xs of { Nil -> return (); Cons n rest -> do { printInt n; printList rest } } }; " "printList (Cons 1 (Cons 2 Nil))")) Nil (Cons (Write "1\n") (Cons (Write "2\n") Nil))) (Cons (runs "generic Monad IO bind" (H.append monadIO "let twice : forall (m : * -> *) a. Monad m => m a -> m a = \\action -> do { action; value <- action; return value } in twice (putStrLn \"again\")") Nil (Cons (Write "again\n") (Cons (Write "again\n") Nil))) (Cons (runs "generic Monad IO input" (H.append monadIO "let echo : forall (m : * -> *). Monad m => m String -> (String -> m Unit) -> m Unit = \\input output -> do { line <- input; output line } in echo getLine putStrLn") (Cons "generic" Nil) (Cons ReadLine (Cons (Write "generic\n") Nil))) (Cons (rejects "IO cannot be redefined" "data IO a = Fake a; Fake 42" "cannot redefine a primitive type") (Cons (rejects "String cannot be redefined" "data String = Text; Text" "cannot redefine a primitive type") (Cons (rejects "Unit cannot be redefined" "data Unit = Unit; Unit" "cannot redefine a primitive type") (Cons (rejects "Unit constructor cannot be forged" "data Fake = Unit; Unit" "cannot redefine a primitive constructor") (Cons (rejects "putStrLn expects a string" "putStrLn 42" "type constructor mismatch") (Cons (rejects "arithmetic expects integers" "addInt 1 \"2\"" "type constructor mismatch") (Cons (rejects "comparison expects integers" "ltInt false 1" "type constructor mismatch") (Cons (rejects "string equality expects strings" "eqString 1 1" "type constructor mismatch") (Cons (rejects "conditional requires a Boolean" "ifThenElse 1 2 3" "type constructor mismatch") (Cons (rejects "conditional branches must agree" "ifThenElse true 42 \"wrong\"" "type constructor mismatch") (Cons (rejects "printInt expects an integer" "printInt \"42\"" "type constructor mismatch") (Cons (rejects "getLine is an action rather than a function" "getLine ()" "type constructor mismatch") (Cons (rejects "IO action cannot be used as a pure string" "putStrLn getLine" "type constructor mismatch") (Cons (rejects "bind continuation must return an action" "bind getLine (\\line -> line)" "type constructor mismatch") (Cons (rejects "IO has a fixed arity" "(\\x -> x) : IO -> IO" "invalid type constructor arity") (Cons (rejects "IO cannot take two parameters" "(\\x -> x) : IO Int Bool -> IO Int Bool" "kind * cannot be applied") (Cons (targetRejects "primitive type arity" (XPrimitive PIOReturn Nil) "primitive type argument arity mismatch") (Cons (targetRejects "primitive type kind" (XPrimitive PIOReturn (Cons (XCon "IO" Nil) Nil)) "primitive type argument kind mismatch") (Cons (targetRejects "primitive type scope" (XPrimitive PIOReturn (Cons (XVar (XTyVar 0)) Nil)) "unbound type variable") (Cons (targetRejects "primitive value argument type" (XApp (XPrimitive PPutStrLn Nil) (XIntTerm 42)) "application type mismatch") (Cons (targetRejects "conditional type argument arity" (XPrimitive PIfThenElse Nil) "primitive type argument arity mismatch") (Cons (targetRejects "conditional branch type checked independently" (XApp (XApp (XApp (XPrimitive PIfThenElse (Cons int Nil)) (XBoolTerm true)) (XIntTerm 1)) (XStringTerm "wrong")) "application type mismatch") (Cons (targetRejects "no IO constructor" (XConstructor "IO" (Cons int Nil)) "unknown data constructor") (Cons (targetRejects "target IO type cannot be forged" (XWithData (Cons (DataDecl "IO" (Cons "a" Nil) (Cons (ConstructorDecl "Fake" (Cons (Parameter "a") Nil)) Nil)) Nil) (XConstructor "Fake" (Cons int Nil))) "cannot redefine a primitive type") (Cons (Pair "IO: pure programs are not executable entry points" do { (Pair _ term) <- (checked "42"); do { (Pair outcome trace) <- (capture term Nil); (case outcome of { (Left err) -> (H.assert ((H.contains "must have type IO" (H.show err)) && (H.null trace)) (H.show (Pair err trace))); (Right _) -> (H.fail "pure program was executed") }) } }) (Cons (Pair "IO: target verification happens before any effects" (let { printTerm = (XApp (XPrimitive PPutStrLn Nil) (XStringTerm "must not print")) } in (let { bad = (XApp (XApp (XPrimitive PIOBind (Cons unit (Cons unit Nil))) printTerm) (XAbs (XName 0 "x") unit (XIntTerm 42))) } in do { (Pair outcome trace) <- (capture bad Nil); (case outcome of { (Left err) -> (H.assert ((H.contains "target verification failed" (H.show err)) && (H.null trace)) (H.show (Pair err trace))); (Right _) -> (H.fail "ill-typed IO reached execution") }) }))) (Cons (Pair "IO: EOF is reported and stops the continuation" do { (Pair _ term) <- (checked "do { line <- getLine; putStrLn line }"); do { (Pair outcome trace) <- (capture term Nil); (case outcome of { (Left err) -> (H.assert ((H.contains "test input exhausted" (H.show err)) && (H.eq trace (Cons ReadLine Nil))) (H.show (Pair err trace))); (Right _) -> (H.fail "EOF did not fail") }) } }) (Cons (Pair "IO: backend output errors are reported" do { (Pair _ term) <- (checked "putStrLn \"hello\""); do { observed <- (B.execute backends IOEntry (Input "" true) term); (case (B.outcome observed) of { (Left err) -> (H.assert ((H.contains "write failed" (H.show err)) && (H.eq (B.events observed) (Cons (Write "hello\n") Nil))) (H.show observed)); (Right _) -> (H.fail "output failure was swallowed") }) } }) (Cons (Pair "IO: unknown target primitive is rejected" (case (XP.parseTerm "<unknown primitive>" "primitive unsafePerformIO()") of { (Left err) -> (H.assert (H.contains "unknown primitive" err) err); (Right _) -> (H.fail "unknown primitive parsed") })) (Cons (law "left identity" "bind (return 42) f" "f 42" (Cons (Write "42\n") (Cons (Write "done\n") Nil))) (Cons (law "right identity" "bind action return" "action" (Cons (Write "action\n") (Cons (Write "7\n") Nil))) (Cons (law "associativity" "bind (bind action f) g" "bind action (\\x -> bind (f x) g)" (Cons (Write "action\n") (Cons (Write "7\n") (Cons (Write "done\n") (Cons (Write "end\n") Nil))))) Nil)))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))
