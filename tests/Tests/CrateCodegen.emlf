module Tests.CrateCodegen where
-- Select the standard Monad used by shared Either; retain legacy guest syntax.
import Prelude hiding (Monad, return, bind)
import MLF.Primitive (Monad, return, bind)

import Bootstrap.Types
import qualified Package.OS as O
import qualified Bootstrap.Std as S
import qualified Bootstrap.Compiler as Compiler
import qualified Bootstrap.Parser as Parser
import qualified Bootstrap.Crate as Crate
import qualified Bootstrap.CrateArtifact as Artifact
import qualified Bootstrap.Separate as Separate
import qualified Bootstrap.CrateCodegen as Cache
import qualified Bootstrap.LLVM as LLVM
import qualified Bootstrap.X.Checked as Checked
import qualified Tests.Helpers as H
import qualified Tests.System as System

suite : [] ((,) String (IO ()))
suite = (:) ((,) "code generation query agrees with uncached checked emission" agreement)
  ((:) ((,) "erased query reuses alpha and annotation changes" annotationReuse)
  ((:) ((,) "optimized query reuses changed unused bodies" unusedReuse)
  ((:) ((,) "code generation cache separates IO and constructor ABIs" abiSeparation)
  ((:) ((,) "corrupt cached LLVM is rebuilt" corruption)
  ((:) ((,) "prepared entries and stale crate dependencies retain visibility" opaque) [])))))

emit : String -> Bool -> Checked.CheckedTerm -> IO Cache.CodegenResult
emit directory requireIO checked = do
  result <- Cache.emitChecked directory requireIO checked
  H.right result
sameCode : [] String -> Cache.CodegenResult -> IO ()
sameCode expected actual = H.assert (eqString (S.concatStrings expected) (S.concatStrings (Cache.codeChunks actual))) "cached LLVM differs from checked emission"
identityTerm : Int -> XType -> XTerm
identityTerm identity ty = XLet (XName identity "private") (XAbs (XName (identity+1) "argument") ty (XVarTerm (XName (identity+1) "argument"))) (XIntTerm 42)
deadTerm : Int -> XTerm
deadTerm value = XLet (XName 9 "unused") (XIntTerm value) (XIntTerm 42)

agreement : IO ()
agreement = System.withScratch (\directory -> do
  keyCompatibility
  checked <- H.right (Checked.check (identityTerm 10 (XCon "Int" [])))
  expected <- H.right (LLVM.emitCheckedChunks false checked)
  first <- emit directory false checked
  second <- emit directory false checked
  sameCode expected first
  sameCode expected second
  H.assert (Cache.inputReused second) "repeat checked emission did not reuse its erased query")

-- Fixed wire-format examples predate the chunk serializer. Their scalar
-- lengths include an astral character and NUL; the large golden crosses
-- several decimal frame widths and a long declaration spine.
keyCompatibility : IO ()
keyCompatibility = do
  let fixtures = (:) ((,) (XEVar (XName 7 "free")) "8:variable1:7")
    ((:) ((,) (XEAbs (XName 80 "x") (XEVar (XName 80 "x"))) "6:lambda1:013:8:variable1:0")
    ((:) ((,) (XEApp (XEPrimitive PAddInt) (XEInt (-3))) "11:application19:9:primitive6:addInt13:7:integer2:-3")
    ((:) ((,) (XELet (XName 91 "x") (XEString "λ😀\0:") (XEVar (XName 91 "x"))) "3:let1:014:6:string4:λ😀\0:13:8:variable1:0")
    ((:) ((,) (XELetRec ((:) ((,) (XName 20 "rec") (XEAbs (XName 21 "x") (XEApp (XEVar (XName 20 "rec")) (XEVar (XName 21 "x"))))) []) (XEVar (XName 20 "rec"))) "9:recursive69:66:1:060:6:lambda1:146:11:application13:8:variable1:013:8:variable1:113:8:variable1:0")
    ((:) ((,) (XEDouble (doubleFromBits 1)) "6:double1:1")
    ((:) ((,) (XEBool true) "7:boolean4:true")
    ((:) ((,) (XEConstructor "Box") "11:constructor3:Box")
    ((:) ((,) (XEEvidenceHole 5) "4:hole1:5")
    ((:) ((,) (XECase (XEConstructor "Box") ((:) (XErasedAlternative (XConstructorPattern "Box" ((:) Nothing ((:) (Just (XName 7 "field")) []))) (XEVar (XName 7 "field"))) ((:) (XErasedAlternative (XDefaultPattern (Just (XName 8 "other"))) (XEVar (XName 8 "other"))) []))) "4:case19:11:constructor3:Box103:58:39:11:constructor3:Box17:4:none9:4:some1:013:8:variable1:039:20:7:default9:4:some1:113:8:variable1:1") ([]))))))))))
  S.mapM_ (\((,) term expected) -> H.assert (eqString (LLVM.canonicalErasedKey term) expected) "code generation key framing changed") fixtures
  let large = S.foldr (\i body -> XELet (XName i "value") (XEInt i) body) (XEInt 42) (S.range 0 1999)
  let encoded = LLVM.canonicalErasedKey large
  H.assert (stringLength encoded == 67465 && eqString (Separate.fingerprint encoded) "339481977-767634940") "large code generation key differs from its frozen framing"

annotationReuse : IO ()
annotationReuse = System.withScratch (\directory -> do
  original <- H.right (Checked.check (identityTerm 10 (XCon "Int" [])))
  annotated <- H.right (Checked.check (identityTerm 1000 (XCon "Bool" [])))
  first <- emit directory false original
  second <- emit directory false annotated
  H.assert (Cache.inputReused second) "alpha-equivalent erasure reran code generation"
  H.assert (eqString (Cache.inputDigest first) (Cache.inputDigest second)) "type annotations changed the erased runtime key"
  sameCode (Cache.codeChunks first) second)

unusedReuse : IO ()
unusedReuse = System.withScratch (\directory -> do
  original <- H.right (Checked.check (deadTerm 1))
  changed <- H.right (Checked.check (deadTerm 2))
  first <- emit directory false original
  second <- emit directory false changed
  H.assert (S.not (Cache.inputReused second)) "changed runtime input incorrectly reused its first query"
  H.assert (Cache.optimizedReused second) "unchanged optimized program reran LLVM generation"
  sameCode (Cache.codeChunks first) second
  crateInputDependencies (directory ++ "/entry"))

crateKey : XTerm -> IO String
crateKey term = do
  checked <- H.right (Checked.check term)
  H.right (LLVM.crateInputKey false checked)
crateKeyAgreement : String -> Bool -> XTerm -> XTerm -> IO ()
crateKeyAgreement label equal original changed = do
  before <- crateKey original
  after <- crateKey changed
  H.assert (H.eq (eqString before after) equal) label
entryRecursive : Int -> Bool -> XTerm
entryRecursive delta useDead =
  let int = XCon "Int" [] in
  let dead = XName 10 "dead" in let live = XName 20 "live" in let argument = XName 30 "argument" in let liveArgument = XName 40 "liveArgument" in
  let advance = XApp (XApp (XPrimitive PAddInt []) (XVarTerm argument)) (XIntTerm delta) in
  XLetRec ((:) ((,,) dead (XArrow int int) (XAbs argument int (XApp (XVarTerm dead) advance)))
    ((:) ((,,) live (XArrow int int) (XAbs liveArgument int (XVarTerm liveArgument))) []))
    (XApp (XVarTerm (if useDead then dead else live)) (XIntTerm 42))
entryMutual : Int -> XTerm
entryMutual value =
  let int = XCon "Int" [] in let f = XName 1 "f" in let g = XName 2 "g" in let x = XName 3 "x" in let y = XName 4 "y" in
  XLetRec ((:) ((,,) f (XArrow int int) (XAbs x int (XApp (XVarTerm g) (XVarTerm x))))
    ((:) ((,,) g (XArrow int int) (XAbs y int (XApp (XVarTerm f) (XIntTerm value)))) []))
    (XApp (XVarTerm f) (XIntTerm 0))
entryCapture : Int -> Bool -> XTerm
entryCapture value shadow =
  let int = XCon "Int" [] in let outer = XName 1 "x" in let f = XName 2 "f" in let argument = XName 3 "argument" in
  XLet outer (XIntTerm value)
    (XLet f (XAbs (if shadow then outer else argument) int (XVarTerm outer))
      (XApp (XVarTerm f) (XIntTerm 42)))
crateInputDependencies : String -> IO ()
crateInputDependencies directory = do
  crateKeyAgreement "unreachable recursive body invalidates the entry key" true (entryRecursive 1 false) (entryRecursive 2 false)
  crateKeyAgreement "reachable recursive body is omitted from the entry key" false (entryRecursive 1 true) (entryRecursive 2 true)
  crateKeyAgreement "entry selection aliases an unused declaration" false (entryRecursive 1 false) (entryRecursive 1 true)
  crateKeyAgreement "transitive group dependency is omitted from the entry key" false (entryMutual 42) (entryMutual 43)
  crateKeyAgreement "captured dependency is omitted from the entry key" false (entryCapture 7 false) (entryCapture 8 false)
  H.reject (Checked.check (entryCapture 7 true))
  let int = XCon "Int" []
  let unused = XName 1 "unused"
  let live = XName 2 "live"
  let nested = XName 3 "nested"
  let spine = \rhs -> XLet unused rhs (XLet live (XIntTerm 42) (XVarTerm live))
  crateKeyAgreement "irrelevant binder allocation moves live entry identities" true (spine (XIntTerm 1)) (spine (XLet nested (XIntTerm 2) (XVarTerm nested)))
  let patternScope = \value -> XLet unused (XIntTerm value) (XCase (XIntTerm 42) int ((:) (XAlternative (XDefaultPattern (Just unused)) (XVarTerm unused)) []))
  H.reject (Checked.check (patternScope 1))
  let branchCapture = \value -> XLet unused (XIntTerm value) (XAbs nested (XCon "Bool" []) (XCase (XVarTerm nested) int ((:) (XAlternative (XDefaultPattern Nothing) (XVarTerm unused)) [])))
  crateKeyAgreement "branch capture is omitted from the entry key" false (branchCapture 1) (branchCapture 2)
  original <- H.right (Checked.check (entryRecursive 1 false))
  changed <- H.right (Checked.check (entryRecursive 2 false))
  firstResult <- Cache.emitCrateChecked directory false original
  first <- H.right firstResult
  expected <- H.right (LLVM.emitCheckedChunks false original)
  sameCode expected first
  secondResult <- Cache.emitCrateChecked directory false changed
  second <- H.right secondResult
  H.assert (Cache.inputReused second) "entry-independent recursive body reran the optimizer"
  sameCode (Cache.codeChunks first) second
  key <- H.right (LLVM.crateInputKey false original)
  H.assert (H.contains "MLF-CODEGEN-CRATE-INPUT-COMPACT-2" key && H.contains "compact-bdwgc-v1" key) "entry key omits the fixed compact ABI"
  H.reject (LLVM.crateInputKey true original)
  let withData = \name -> XWithData ((:) (DataDecl name [] ((:) (ConstructorDecl name []) [])) []) (XIntTerm 42)
  crateKeyAgreement "entry key omits unused constructor ABI entries" false (withData "First") (withData "Second")
  writeFile (directory ++ "/objects/" ++ Cache.optimizedDigest first ++ ".ll") "corrupted LLVM output"
  repairedResult <- Cache.emitCrateChecked directory false changed
  repaired <- H.right repairedResult
  H.assert (S.not (Cache.inputReused repaired)) "entry query trusted corrupt LLVM"
  direct <- H.right (LLVM.emitCheckedChunks false changed)
  sameCode direct repaired

abiSeparation : IO ()
abiSeparation = System.withScratch (\directory -> do
  pure <- H.right (Checked.check (XApp (XPrimitive PPanic ((:) (XCon "Int" []) [])) (XStringTerm "entry")))
  action <- H.right (Checked.check (XApp (XPrimitive PPanic ((:) (XCon "IO" ((:) (XCon "Int" []) [])) [])) (XStringTerm "entry")))
  ordinary <- emit directory false pure
  io <- emit directory true action
  H.assert (S.not (Cache.inputReused io) && S.not (Cache.optimizedReused io)) "IO execution ABI reused a pure entry"
  H.assert (S.not (eqString (S.concatStrings (Cache.codeChunks ordinary)) (S.concatStrings (Cache.codeChunks io)))) "IO execution flag did not affect emitted entry"
  rejected <- Cache.emitChecked directory true pure
  H.reject rejected
  let declaration = \name -> DataDecl name [] ((:) (ConstructorDecl name []) [])
  firstLayout <- H.right (Checked.check (XWithData ((:) (declaration "First") []) (XConstructor "Unit" [])))
  secondLayout <- H.right (Checked.check (XWithData ((:) (declaration "Second") []) (XConstructor "Unit" [])))
  _ <- emit directory false firstLayout
  different <- emit directory false secondLayout
  H.assert (S.not (Cache.inputReused different) && S.not (Cache.optimizedReused different)) "different nominal constructor tables reused a code generation ABI")

corruption : IO ()
corruption = System.withScratch (\directory -> do
  checked <- H.right (Checked.check (XIntTerm 42))
  first <- emit directory false checked
  writeFile (directory ++ "/objects/" ++ Cache.optimizedDigest first ++ ".ll") "corrupted LLVM output"
  second <- emit directory false checked
  H.assert (S.not (Cache.inputReused second) && S.not (Cache.optimizedReused second)) "corrupted output was accepted by a cache query"
  expected <- H.right (LLVM.emitCheckedChunks false checked)
  sameCode expected second
  repaired <- emit directory false checked
  H.assert (Cache.inputReused repaired) "rebuilt cache output was not reusable")

opaque : IO ()
opaque = System.withScratch (\directory -> do
  let path = directory ++ "/Main.emlf"
  writeFile path "module Main where\nimport qualified Bootstrap.LLVM as Private\nmain = Private.PreparedEntry\n"
  result <- Compiler.compileFile (O.words "libraries/mlf-foundation libraries/mlf-language-core libraries/mlf-frontend libraries/mlf-xmlf libraries/mlf-inference libraries/mlf-interpreter libraries/mlf-llvm libraries/mlf-crates") path
  case result of
    Left (CompileError ModuleResolution message) -> H.assert (H.contains "not in scope" message || H.contains "not exported" message) message
    _ -> H.fail "private prepared entry constructor escaped module resolution"
  staleVisibility directory)

compileFixture : String -> String -> String -> [] String -> String -> String -> String -> IO ()
compileFixture directory identity entry dependencies prefix moduleName text = do
  let path = prefix ++ ".emlf"
  writeFile path text
  source <- H.right (Parser.parseModule path text)
  loaded <- Artifact.loadInterfaces dependencies
  interfaces <- H.right loaded
  let spec = Crate.CrateSpec identity entry NoImplicitPrelude ((:) ((,) moduleName path) []) dependencies (directory ++ "/queries/" ++ identity) (directory ++ "/builtin")
  compiled <- Crate.compileSources spec ((:) source []) interfaces prefix
  _ <- H.right compiled
  metadata <- Artifact.readInterface (prefix ++ ".mlfci")
  iface <- H.right metadata
  input <- readFile (prefix ++ ".mlfco")
  object <- H.right (Artifact.decodeObject iface input)
  let fragments = Artifact.objectFragments object
  H.assert (eqString input (Artifact.encodeObject object)) "pooled crate object changed on roundtrip"
  let aggregate = Separate.fingerprint (Artifact.encodePooledPayload fragments)
  H.assert (eqString aggregate (Artifact.fragmentFingerprint fragments)) "pooled crate fingerprint differs from its canonical aggregate"
  let legacyAggregate = Separate.fingerprint (Separate.pack (S.map Artifact.encodeFragment fragments))
  H.assert (eqString legacyAggregate (Artifact.legacyFragmentFingerprint fragments)) "legacy streaming crate fingerprint differs from its canonical aggregate"
  let legacyInterface = Artifact.withObjectFingerprint iface legacyAggregate
  let legacy = Artifact.LegacyCrateObject legacyInterface fragments
  let legacyInput = Artifact.encodeObject legacy
  restoredLegacy <- H.right (Artifact.decodeObject legacyInterface legacyInput)
  H.assert (eqString legacyInput (Artifact.encodeObject restoredLegacy)) "legacy crate object changed on roundtrip"
  pooledFailures prefix iface (Artifact.encodePooledPayload fragments)
  H.reject (Artifact.decodeObject iface ("0" ++ input))
  return ()

pooledPacket : Artifact.CrateInterface -> String -> (,) Artifact.CrateInterface String
pooledPacket iface payload =
  let declared = Artifact.withObjectFingerprint iface (Separate.fingerprint payload) in
  (,) declared (Separate.pack ((:) "MLFCO-2" ((:) (Artifact.crateId declared) ((:) (Separate.fingerprint (Artifact.encodeInterface declared)) ((:) payload [])))))
rejectPooledBecause : String -> Artifact.CrateInterface -> String -> IO ()
rejectPooledBecause expected iface payload = case pooledPacket iface payload of
  (,) declared packet -> case Artifact.decodeObject declared packet of
    Left message -> H.assert (H.contains expected message) message
    Right _ -> H.fail ("pooled object accepted: " ++ expected)
poisonContext : [] String -> Either String (Maybe ([] String))
poisonContext records = case records of
  [] -> Right Nothing
  (:) record rest -> do
    fields <- Artifact.canonicalFields record
    case fields of
      (:) header ((:) body ((:) contents [])) ->
        if S.not (eqString body "") then Right (Just ((:) (Separate.pack ((:) "" ((:) body ((:) contents [])))) rest))
        else do
          changed <- poisonContext rest
          case changed of {Nothing -> Right Nothing; Just tail -> Right (Just ((:) record tail))}
      _ -> Left "invalid test pool record"
pooledFailures : String -> Artifact.CrateInterface -> String -> IO ()
pooledFailures prefix iface payload = do
  fields <- H.right (Artifact.canonicalFields payload)
  case fields of
    (:) pool ((:) bodies []) -> do
      declarations <- H.right (Artifact.canonicalFields pool)
      records <- H.right (Artifact.canonicalFields bodies)
      -- All fixture identities are ASCII; this sorts after them without
      -- shifting any used index. The outer checksum is recomputed below.
      let unused = S.snoc declarations "data ΩPooledUnused = ΩPooledUnused;"
      _ <- H.right (Artifact.decodeTypePool (Separate.pack unused))
      rejectPooledBecause "noncanonical pooled crate object" iface (Separate.pack ((:) (Separate.pack unused) ((:) bodies [])))
      case declarations of
        [] -> return ()
        (:) first rest -> rejectPooledBecause "duplicate crate pooled datatype" iface (Separate.pack ((:) (Separate.pack (S.sortBy compareString ((:) first declarations))) ((:) bodies [])))
      case records of
        [] -> return ()
        (:) record rest -> do
          recordFields <- H.right (Artifact.canonicalFields record)
          case recordFields of
            (:) header ((:) body ((:) contents [])) -> do
              let outside = Separate.pack ((:) (Separate.pack ((:) "999999999" [])) ((:) body ((:) contents [])))
              rejectPooledBecause "datatype pool reference is out of bounds" iface (Separate.pack ((:) pool ((:) (Separate.pack ((:) outside rest)) [])))
              compact <- H.right (Artifact.canonicalFields contents)
              case compact of
                (:) "MLFF-2" ((:) metadata ((:) text [])) -> do
                  let damaged = Separate.pack ((:) "MLFF-2" ((:) metadata ((:) (text ++ " ") [])))
                  let changed = Separate.pack ((:) header ((:) body ((:) damaged [])))
                  rejectPooledBecause "contextual fragment body checksum mismatch" iface (Separate.pack ((:) pool ((:) (Separate.pack ((:) changed rest)) [])))
                _ -> H.fail "invalid contextual test fragment"
            _ -> H.fail "invalid pooled test fragment"
      poisoned <- H.right (poisonContext records)
      case poisoned of
        Nothing -> return ()
        Just changed -> case pooledPacket iface (Separate.pack ((:) pool ((:) (Separate.pack changed) []))) of
          (,) declared packet -> do
            _ <- H.right (Artifact.decodeObject declared packet)
            let forged = prefix ++ ".bad-context"
            writeFile (forged ++ ".mlfci") (Artifact.encodeInterface declared)
            writeFile (forged ++ ".mlfco") packet
            linked <- Artifact.linkCheckedFile (forged ++ ".mlfci")
            case linked of
              Left message -> H.assert (H.contains "datatype context mismatch" message) message
              Right _ -> H.fail "pooled decoding repaired a forged header/payload context mismatch"
    _ -> H.fail "invalid pooled object test fixture"

visibilityLibrary : String -> String -> String -> String
visibilityLibrary exports value hidden = "module A (" ++ exports ++ ") where\ndata Box = Box Int\nclass Render a where { render : a -> Int }\ninstance Render Int where { render x = x }\nf = " ++ value ++ "\nhidden = " ++ hidden ++ "\n"
linkFixture : String -> IO ()
linkFixture path = do
  result <- Artifact.linkCheckedFile path
  _ <- H.right result
  return ()
rejectStaleFixture : String -> IO ()
rejectStaleFixture path = do
  result <- Artifact.linkCheckedFile path
  case result of
    Left message -> H.assert (H.contains "stale crate dependency interface" message) ("unexpected stale dependency failure: " ++ message)
    Right _ -> H.fail "source-free link accepted a removed source export"

staleVisibility : String -> IO ()
staleVisibility directory = do
  let library = directory ++ "/library"
  let consumer = directory ++ "/consumer"
  let dependency = library ++ ".mlfci"
  let public = "f, Box(..), Render(..)"
  let buildLibrary = \exports value hidden -> compileFixture directory "visibility-library" "" [] library "A" (visibilityLibrary exports value hidden)
  buildLibrary public "42" "0"
  compileFixture directory "visibility-consumer" "Main" ((:) dependency []) consumer "Main"
    "module Main where\nimport A\nmain = case Box (render f) of { Box x -> x }\n"
  linkFixture (consumer ++ ".mlfci")
  -- These change implementation objects and a private scheme, while every
  -- consumed public scheme, layout and source permission remains unchanged.
  buildLibrary public "43" "true"
  linkFixture (consumer ++ ".mlfci")
  -- Keep the definitions, schemes and layouts. Only source visibility changes;
  -- constructor references have no imported term parameter to check instead.
  S.mapM_ (\exports -> do
    buildLibrary exports "43" "true"
    rejectStaleFixture (consumer ++ ".mlfci"))
    ((:) "Box(..), Render(..)" ((:) "f, Box, Render(..)" ((:) "f, Box(..), Render" [])))
  buildLibrary public "43" "true"
  let facade = directory ++ "/facade"
  let facadeConsumer = directory ++ "/facade-consumer"
  compileFixture directory "visibility-facade" "" ((:) dependency []) facade "Facade"
    "module Facade (f, Box(..), Render(..)) where\nimport A\n"
  compileFixture directory "visibility-facade-consumer" "Main" ((:) (facade ++ ".mlfci") []) facadeConsumer "Main"
    "module Main where\nimport Facade\nmain = case Box (render f) of { Box x -> x }\n"
  linkFixture (facadeConsumer ++ ".mlfci")
  buildLibrary public "44" "false"
  linkFixture (facadeConsumer ++ ".mlfci")
