module Tests.Typeclasses where
import Bootstrap.Types
import qualified Bootstrap.Std as S
import qualified Package.OS as OS
import qualified Tests.Helpers as H
import Tests.Helpers (Quint(..), Sext(..))
import qualified Tests.Map as Map
import Bootstrap.Compiler
import qualified Bootstrap.Data as D
import Bootstrap.Evidence (resolveDictionary)
import Bootstrap.Kind
import qualified Bootstrap.X.Check as C
import qualified Bootstrap.X.Parser as P
import Bootstrap.X.Pretty (prettyTerm, prettyType)
import qualified Bootstrap.X.Syntax as X
import qualified Bootstrap.X.Type as T

checked : String -> IO Compilation
checked source = do { result <- (H.right (compile "<class test>" source)); do { parsed <- (H.right (P.parseTerm "<class xMLF>" (prettyTerm (compiledTerm result)))); do { ty <- (H.right (C.checkClosed parsed)); do { (H.assert (T.alphaEq ty (inferredType result)) "class xMLF round trip changed type"); do { (H.assert (H.eq (X.erase parsed) (X.erase (compiledTerm result))) "class xMLF round trip changed erasure"); (return result) } } } } }

hasType : String -> String -> XType -> Pair String (IO Unit)
hasType label source expected = (Pair (H.append "class: " label) do { result <- (checked source); (H.assert (T.alphaEq (inferredType result) expected) (H.append "expected " (H.append (prettyType expected) (H.append ", got " (sourceType result))))) })

rejects : String -> String -> Phase -> String -> Pair String (IO Unit)
rejects label source expectedPhase reason = (Pair (H.append "class rejection: " label) (case (compile "<class rejection>" source) of { (Left err) -> do { (H.assert (H.eq (phase err) expectedPhase) (H.append "wrong rejection phase: " (H.show err))); (H.assert (H.contains reason (diagnostic err)) (H.append "wrong rejection reason: " (H.show err))) }; (Right result) -> (H.fail (H.append "unexpected acceptance: " (sourceType result))) }))

targetRejects : String -> XTerm -> String -> Pair String (IO Unit)
targetRejects label term reason = (Pair (H.append "class target: " label) (case (C.checkClosed term) of { (Left err) -> (H.assert (H.contains reason err) (H.append "wrong target rejection: " err)); (Right ty) -> (H.fail (H.append "unexpected target type: " (prettyType ty))) }))

int : XType
int = (XCon "Int" Nil)

bool : XType
bool = (XCon "Bool" Nil)

inspectClass : String
inspectClass = "class Inspect a where { inspect : a -> Bool }; "

inspectBool : String
inspectBool = "instance Inspect Bool where { inspect = \\x -> x }; "

inspectInt : String
inspectInt = "instance Inspect Int where { inspect = \\x -> true }; "

maybeDecl : String
maybeDecl = "data Maybe a = Nothing | Just a; "

functorClass : String
functorClass = "class Functor (f : * -> *) where { fmap : forall a b. (a -> b) -> f a -> f b }; "

maybeFunctor : String
maybeFunctor = "instance Functor Maybe where { fmap = \\f value -> case value of { Nothing -> Nothing; Just x -> Just (f x) } }; "

typeclassTests : (List ( Pair String (IO Unit) ))
typeclassTests = (H.append singleParameterTests multiParameterTests)

singleParameterTests : (List ( Pair String (IO Unit) ))
singleParameterTests = (Cons (hasType "concrete method" (H.append inspectClass (H.append inspectBool "inspect true")) bool) (Cons (hasType "inferred constrained let at distinct instances" (H.append inspectClass (H.append inspectBool (H.append inspectInt "let f = \\x -> inspect x in let b = f true in f 42"))) bool) (Cons (hasType "implicit method quantification" "class Keep a where { keep : a -> b -> a }; instance Keep Int where { keep = \\x ignored -> x }; keep 42 true" int) (Cons (hasType "explicit qualified function" (H.append inspectClass (H.append inspectBool "let f : forall a. Inspect a => a -> Bool = \\x -> inspect x in f true")) bool) (Cons (hasType "qualified expression in function position" (H.append inspectClass (H.append inspectBool "((\\x -> inspect x) : forall a. Inspect a => a -> Bool) true")) bool) (Cons (hasType "qualified function parameter" (H.append inspectClass (H.append inspectBool (H.append inspectInt "(\\(f : forall a. Inspect a => a -> Bool) -> let n = f 42 in f true) ((\\x -> inspect x) : forall a. Inspect a => a -> Bool)"))) bool) (Cons (hasType "two givens of the same class" (H.append inspectClass (H.append inspectBool (H.append inspectInt "let both : forall a b. (Inspect a, Inspect b) => a -> b -> Bool = \\x y -> (\\first -> inspect y) (inspect x) in both 42 true"))) bool) (Cons (hasType "concrete call inside a generic constraint" (H.append inspectClass (H.append inspectBool (H.append inspectInt "let both : forall a. Inspect a => a -> Bool = \\x -> (\\fixed -> inspect x) (inspect true) in both 42"))) bool) (Cons (hasType "lambda shadows method" (H.append inspectClass "(\\inspect -> inspect 42) (\\x -> x)") int) (Cons (hasType "let shadows method" (H.append inspectClass "let inspect = \\x -> x in inspect 42") int) (Cons (hasType "pattern shadows method" (H.append inspectClass "data Box a = Box a; case Box 42 of { Box inspect -> inspect }") int) (Cons (hasType "higher-kinded method" (H.append maybeDecl (H.append functorClass (H.append maybeFunctor "fmap (\\x -> true) (Just 42)"))) (XCon "Maybe" (Cons bool Nil))) (Cons (hasType "partial type constructor instance" (H.append "data Either e a = Left e | Right a; " (H.append functorClass (H.append "instance Functor (Either e) where { fmap = \\f value -> case value of { Left err -> Left err; Right x -> Right (f x) } }; " "fmap (\\x -> true) (Right 42 : Either Int Int)"))) (XCon "Either" (Cons int (Cons bool Nil)))) (Cons (hasType "instance definitions are order independent" (H.append inspectClass (H.append "class Inspect a => Test a where { test : a -> Bool }; " (H.append "instance Test Bool where { test = \\x -> inspect x }; " (H.append inspectBool "test true")))) bool) (Cons (hasType "superclass given without concrete instances" (H.append inspectClass (H.append "class Inspect a => Test a where { test : a -> Bool }; " "let f : forall a. Test a => a -> Bool = \\x -> inspect x in 42")) int) (Cons (hasType "mutually recursive methods" "class Loop a where { first : a -> a; second : a -> a }; instance Loop Int where { first = \\x -> second x; second = \\x -> first x }; first 42" int) (Cons (hasType "higher-kinded datatype application" (H.append maybeDecl "data Wrap (f : * -> *) a = Wrap (f a); case Wrap (Just 42) of { Wrap value -> value }") (XCon "Maybe" (Cons int Nil))) (Cons (hasType "higher-kinded annotation" (H.append maybeDecl "let id : forall (f : * -> *) a. f a -> f a = \\x -> x in id (Just 42)") (XCon "Maybe" (Cons int Nil))) (Cons (Pair "class: Monad hierarchy example" do { source <- (readFile "examples/monad-maybe.emlf"); do { result <- (checked source); (H.assert (T.alphaEq (inferredType result) (XCon "Maybe" (Cons int Nil))) "wrong Monad example result") } }) (Cons (Pair "class: contextual recursive instance example" do { source <- (readFile "examples/contextual-instance.emlf"); do { result <- (checked source); (H.assert (T.alphaEq (inferredType result) bool) "wrong contextual example result") } }) (Cons (Pair "class: qualified result is displayed using its class name" do { result <- (checked (H.append inspectClass "(\\x -> inspect x) : forall a. Inspect a => a -> Bool")); do { (H.assert ((H.contains "Inspect " (sourceType result)) && (H.contains "=>" (sourceType result))) (H.append "missing source constraint: " (sourceType result))); (H.assert (S.not (H.contains "DictInspect" (sourceType result))) "internal dictionary name leaked") } }) (Cons (rejects "missing concrete instance" (H.append inspectClass "inspect 42") Resolution "no instance or given constraint") (Cons (rejects "does not pick the only instance for an unknown type" (H.append inspectClass (H.append inspectBool "inspect")) Resolution "ambiguous") (Cons (rejects "wrong instance body" (H.append inspectClass "instance Inspect Bool where { inspect = \\x -> 42 }; true") Inference "type constructor mismatch") (Cons (rejects "method body is checked polymorphically" "class Keep a where { keep : forall b. a -> b -> b }; instance Keep Int where { keep = \\x ignored -> 42 }; true" Inference "Skolem") (Cons (rejects "missing method" (H.append inspectClass "instance Inspect Bool where {}; true") Inference "missing [\"inspect\"]") (Cons (rejects "extra method" (H.append inspectClass "instance Inspect Bool where { inspect = \\x -> x; extra = true }; true") Inference "unexpected [\"extra\"]") (Cons (rejects "duplicate method implementation" (H.append inspectClass "instance Inspect Bool where { inspect = \\x -> x; inspect = \\x -> x }; true") Inference "duplicate instance method") (Cons (rejects "duplicate class" (H.append inspectClass (H.append inspectClass "true")) Inference "duplicate class") (Cons (rejects "methods share a global namespace" (H.append inspectClass "class Other a where { inspect : a -> Int }; true") Inference "duplicate class method") (Cons (rejects "method must mention its class parameter" "class Ambiguous a where { number : Int }; true" Inference "ambiguous class method") (Cons (rejects "unknown class" "instance Missing Bool where {}; true" Inference "unknown class") (Cons (rejects "duplicate instance" (H.append inspectClass (H.append inspectBool (H.append inspectBool "true"))) Inference "overlapping instances") (Cons (rejects "overlapping generic and concrete instances" (H.append maybeDecl (H.append inspectClass "instance Inspect (Maybe a) where { inspect = \\x -> true }; instance Inspect (Maybe Int) where { inspect = \\x -> false }; true")) Inference "overlapping instances") (Cons (rejects "variable instance head" (H.append inspectClass "instance Inspect a where { inspect = \\x -> true }; true") Inference "named type constructor") (Cons (rejects "nondecreasing instance context" (H.append inspectClass "instance Inspect Bool => Inspect Bool where { inspect = \\x -> x }; true") Inference "structurally smaller") (Cons (rejects "instance context variable absent from head" (H.append inspectClass "instance Inspect a => Inspect Bool where { inspect = \\x -> x }; true") Inference "variable absent from the head") (Cons (rejects "cyclic superclasses" "class B a => A a where {}; class A a => B a where {}; true" Inference "cyclic superclass hierarchy") (Cons (rejects "missing superclass instance" (H.append inspectClass "class Inspect a => Test a where { test : a -> Bool }; instance Test Bool where { test = \\x -> x }; true") Resolution "no instance or given constraint") (Cons (rejects "class instance kind" (H.append functorClass "instance Functor Int where { fmap = \\f x -> x }; true") Inference "class parameter kind mismatch") (Cons (rejects "class context kind" (H.append functorClass "let f : forall a. Functor a => a -> a = \\x -> x in true") Inference "class parameter kind mismatch") (Cons (rejects "higher-kinded argument must have the declared kind" "data Wrap (f : * -> *) a = Wrap (f a); (\\x -> x) : Wrap Int Bool -> Wrap Int Bool" Inference "kind mismatch") (Cons (rejects "ordinary type variable cannot be applied" "(\\x -> x) : forall f a. f a -> f a" Inference "kind * cannot be applied") (Cons (rejects "method constraints require supported signatures" (H.append inspectClass "class Nested a where { nested : Inspect a => a -> Bool }; true") Inference "constraints") (Cons (targetRejects "recursive dictionary body has wrong declared type" (XLetRec (Cons (Triple (XName 0 "d") bool (XIntTerm 1)) Nil) (XVarTerm (XName 0 "d"))) "declared type") (Cons (targetRejects "recursive binders must be unique" (XLetRec (Cons (Triple (XName 0 "d") bool (XBoolTerm true)) (Cons (Triple (XName 0 "d") bool (XBoolTerm false)) Nil)) (XBoolTerm true)) "duplicate recursive binder") (Cons (targetRejects "recursive binding cannot reuse an outer binder" (XAbs (XName 0 "d") bool (XLetRec (Cons (Triple (XName 0 "d") bool (XBoolTerm true)) Nil) (XBoolTerm true))) "already in scope") (Cons (targetRejects "term annotation has kind star" (XTypeAbs (XTyVar 0) (XBotKind (KArrow Star Star)) (XAbs (XName 1 "x") (XVar (XTyVar 0)) (XVarTerm (XName 1 "x")))) "kind *") (Cons (targetRejects "constructor checks the kind of a type argument" (XWithData (Cons (DataDeclK "Wrap" (Cons (Pair "f" (KArrow Star Star)) Nil) (Cons (ConstructorDecl "Wrap" Nil) Nil)) Nil) (XConstructor "Wrap" (Cons int Nil))) "type argument kind mismatch") (Cons (Pair "class target: compact and general application spines agree" (let { applied = (XApply (XCon "Box" Nil) int) } in do { (H.assert (T.alphaEq applied (XCon "Box" (Cons int Nil))) "equivalent application representations differ"); do { (H.assert (S.not (T.alphaEq applied (XCon "Box" (Cons bool Nil)))) "different arguments were equated"); (H.assert (T.alphaEq XBot (XBotKind Star)) "explicit kind * changed bottom") } })) (Cons (Pair "class target: Inst-Bot cannot change kinds" (case (C.checkComputation Map.empty (XBottom int) (XBotKind (KArrow Star Star))) of { (Left err) -> (H.assert (H.contains "kind mismatch" err) err); (Right _) -> (H.fail "ill-kinded type computation was accepted") })) (Cons (Pair "class evidence: chooses the given by its type" do { ds <- (H.right (D.validateDeclarations (Cons (DataDecl "Dict" (Cons "a" Nil) (Cons (ConstructorDecl "MkDict" Nil) Nil)) Nil))); (let { first = (XName 1 "first") } in (let { second = (XName 2 "second") } in (let { evidence = (Cons (Triple GivenEvidence first (XCon "Dict" (Cons int Nil))) (Cons (Triple GivenEvidence second (XCon "Dict" (Cons bool Nil))) Nil)) } in do { term <- (H.right (resolveDictionary ds Map.empty evidence (XCon "Dict" (Cons bool Nil)))); (H.assert (H.eq term (XVarTerm second)) "selected the wrong same-class dictionary") }))) }) Nil))))))))))))))))))))))))))))))))))))))))))))))))))))

convertClass : String
convertClass = "class Convert a b where { convert : a -> b }; "

convertIntBool : String
convertIntBool = "instance Convert Int Bool where { convert = \\x -> true }; "

multiParameterTests : (List ( Pair String (IO Unit) ))
multiParameterTests = (Cons (hasType "two parameters" (H.append convertClass (H.append convertIntBool "convert 42 : Bool")) bool) (Cons (hasType "instances with the same first parameter are disjoint" (H.append convertClass (H.append convertIntBool "instance Convert Int Int where { convert = \\x -> x }; convert 42 : Int")) int) (Cons (hasType "instances with the same second parameter are disjoint" (H.append convertClass (H.append convertIntBool "instance Convert Bool Bool where { convert = \\x -> x }; convert true : Bool")) bool) (Cons (hasType "repeated variables are shared across instance arguments" (H.append convertClass (H.append "instance Convert a a where { convert = \\x -> x }; " (H.append convertIntBool "let first = convert true : Bool in convert 42 : Bool"))) bool) (Cons (hasType "class parameter substitution is simultaneous" (H.append convertClass "instance Convert b Bool where { convert = \\x -> true }; convert 42 : Bool") bool) (Cons (hasType "inferred multiparameter constraint" (H.append convertClass (H.append convertIntBool "let f = \\x -> convert x in f 42 : Bool")) bool) (Cons (hasType "explicit multiparameter constraint" (H.append convertClass (H.append convertIntBool "let f : forall a b. Convert a b => a -> b = \\x -> convert x in f 42 : Bool")) bool) (Cons (hasType "three parameters" "class Choose a b c where { choose : a -> b -> c }; instance Choose Int Bool Bool where { choose = \\x y -> y }; choose 42 true : Bool" bool) (Cons (hasType "superclass can discard a parameter" (H.append inspectClass (H.append "class Inspect b => Two a b where { two : a -> b -> Bool }; " "let f : forall a b. Two a b => a -> b -> Bool = \\x y -> inspect y in 42")) int) (Cons (hasType "superclass can reorder parameters" (H.append convertClass (H.append "class Convert b a => Reverse a b where { reverse : a -> b -> Bool }; " "let f : forall a b. Reverse a b => b -> a = \\x -> convert x in 42")) int) (Cons (hasType "same class givens with different second arguments" (H.append convertClass (H.append convertIntBool (H.append "instance Convert Int Int where { convert = \\x -> x }; " "let f : forall a b c. (Convert a b, Convert a c) => a -> b -> c = \\x ignored -> convert x in f 42 true : Int"))) int) (Cons (Pair "class: recursive multiparameter instance example" do { source <- (readFile "examples/multiparameter.emlf"); do { result <- (checked source); (H.assert (T.alphaEq (inferredType result) (XCon "Box" (Cons (XCon "Box" (Cons bool Nil)) Nil))) "wrong conversion result") } }) (Cons (Pair "class: multi-parameter constraint display" do { result <- (checked (H.append convertClass "(\\x -> convert x) : forall a b. Convert a b => a -> b")); do { (H.assert ((H.contains "Convert " (sourceType result)) && (H.contains "=>" (sourceType result))) (sourceType result)); (H.assert (S.not (H.contains "DictConvert" (sourceType result))) "dictionary name leaked") } }) (Cons (rejects "instance is missing a parameter" (H.append convertClass "instance Convert Int where { convert = \\x -> x }; true") Inference "arity mismatch") (Cons (rejects "instance has an extra parameter" (H.append convertClass "instance Convert Int Bool Int where { convert = \\x -> true }; true") Inference "arity mismatch") (Cons (rejects "constraint is missing a parameter" (H.append convertClass "let f : forall a. Convert a => a -> Bool = \\x -> true in true") Inference "arity mismatch") (Cons (rejects "duplicate class parameter" "class Relation a a where { relate : a -> a }; true" Inference "duplicate class parameter") (Cons (rejects "method omits a class parameter" "class Relation a b where { relate : a -> Bool }; true" Inference "ambiguous class method") (Cons (rejects "does not infer an output parameter from the only instance" (H.append convertClass (H.append convertIntBool "convert 42")) Resolution "ambiguous") (Cons (rejects "matches every repeated parameter" (H.append convertClass "instance Convert a a where { convert = \\x -> x }; convert 42 : Bool") Resolution "no instance or given constraint") (Cons (rejects "overlap needs joint unification across parameters" (H.append convertClass "instance Convert a a where { convert = \\x -> x }; instance Convert Int Int where { convert = \\x -> x }; true") Inference "overlapping instances") (Cons (rejects "overlapping variable and concrete argument" (H.append convertClass (H.append "instance Convert a Bool where { convert = \\x -> true }; " (H.append convertIntBool "true"))) Inference "overlapping instances") (Cons (rejects "context must decrease across the whole argument tuple" (H.append convertClass "instance Convert b a => Convert a b where { convert = \\x -> convert x }; true") Inference "structurally smaller") (Cons (rejects "context cannot duplicate a variable" (H.append "data Box a = Box a; " (H.append convertClass "instance Convert a a => Convert (Box a) Bool where { convert = \\x -> true }; true")) Inference "structurally smaller") (Cons (rejects "later parameter kind is checked" "class Relation a (f : * -> *) where { relate : a -> f a }; instance Relation Int Bool where { relate = \\x -> true }; true" Inference "class parameter kind mismatch") (Cons (Pair "class evidence: superclass projection preserves caller variable identities" do { ds <- (H.right (D.validateDeclarations (Cons (DataDecl "PairDict" (Cons "a" (Cons "b" Nil)) (Cons (ConstructorDecl "MkPairDict" Nil) Nil)) (Cons (DataDecl "OneDict" (Cons "a" Nil) (Cons (ConstructorDecl "MkOneDict" Nil) Nil)) Nil)))); (let { a = (XTyVar 0) } in (let { b = (XTyVar 1) } in (let { given = (XName 1 "given") } in (let { super = (XName 2 "super") } in (let { pair x y = (XCon "PairDict" (Cons x (Cons y Nil))) } in (let { one x = (XCon "OneDict" (Cons x Nil)) } in (let { superType = (XForall a XBot (XForall b XBot (XArrow (pair (XVar a) (XVar b)) (one (XVar b))))) } in (let { givenType = (pair (XVar b) (XVar a)) } in (let { wanted = (one (XVar a)) } in (let { gamma = (Map.fromList (Cons (Pair a XBot) (Cons (Pair b XBot) Nil))) } in (let { candidates = (Cons (Triple GivenEvidence given givenType) (Cons (Triple SuperclassEvidence super superType) Nil)) } in do { proof <- (H.right (resolveDictionary ds gamma candidates wanted)); do { actual <- (H.right (C.inferWithData ds (XEnv gamma (Map.fromList (Cons (Pair given givenType) (Cons (Pair super superType) Nil)))) proof)); (H.assert (T.alphaEq actual wanted) "superclass projection changed a parameter identity") } }))))))))))) }) Nil))))))))))))))))))))))))))
