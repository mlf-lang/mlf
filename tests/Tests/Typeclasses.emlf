module Tests.Typeclasses where
import Bootstrap.Types
import qualified Bootstrap.Std as S
import qualified Package.OS as OS
import qualified Tests.Helpers as H
import Tests.Helpers (Quint(..), Sext(..))
import qualified Tests.Map as Map
import Bootstrap.Compiler
import qualified Bootstrap.Data as D
import Bootstrap.Evidence (resolveDictionary)
import Bootstrap.Kind
import qualified Bootstrap.X.Check as C
import qualified Bootstrap.X.Parser as P
import Bootstrap.X.Pretty (prettyTerm, prettyType)
import qualified Bootstrap.X.Syntax as X
import qualified Bootstrap.X.Type as T

checked : String -> IO Compilation
checked source = do { result <- (H.right (compile "<class test>" source)); do { parsed <- (H.right (P.parseTerm "<class xMLF>" (prettyTerm (compiledTerm result)))); do { ty <- (H.right (C.checkClosed parsed)); do { (H.assert (T.alphaEq ty (inferredType result)) "class xMLF round trip changed type"); do { (H.assert (H.eq (X.erase parsed) (X.erase (compiledTerm result))) "class xMLF round trip changed erasure"); (return result) } } } } }

hasType : String -> String -> XType -> (,) String (IO ())
hasType label source expected = ((,) (H.append "class: " label) do { result <- (checked source); (H.assert (T.alphaEq (inferredType result) expected) (H.append "expected " (H.append (prettyType expected) (H.append ", got " (sourceType result))))) })

rejects : String -> String -> Phase -> String -> (,) String (IO ())
rejects label source expectedPhase reason = ((,) (H.append "class rejection: " label) (case (compile "<class rejection>" source) of { (Left err) -> do { (H.assert (H.eq (phase err) expectedPhase) (H.append "wrong rejection phase: " (H.show err))); (H.assert (H.contains reason (diagnostic err)) (H.append "wrong rejection reason: " (H.show err))) }; (Right result) -> (H.fail (H.append "unexpected acceptance: " (sourceType result))) }))

targetRejects : String -> XTerm -> String -> (,) String (IO ())
targetRejects label term reason = ((,) (H.append "class target: " label) (case (C.checkClosed term) of { (Left err) -> (H.assert (H.contains reason err) (H.append "wrong target rejection: " err)); (Right ty) -> (H.fail (H.append "unexpected target type: " (prettyType ty))) }))

int : XType
int = (XCon "Int" [])

bool : XType
bool = (XCon "Bool" [])

inspectClass : String
inspectClass = "class Inspect a where { inspect : a -> Bool }; "

inspectBool : String
inspectBool = "instance Inspect Bool where { inspect = \\x -> x }; "

inspectInt : String
inspectInt = "instance Inspect Int where { inspect = \\x -> true }; "

maybeDecl : String
maybeDecl = "data Maybe a = Nothing | Just a; "

functorClass : String
functorClass = "class Functor (f : * -> *) where { fmap : forall a b. (a -> b) -> f a -> f b }; "

maybeFunctor : String
maybeFunctor = "instance Functor Maybe where { fmap = \\f value -> case value of { Nothing -> Nothing; Just x -> Just (f x) } }; "

typeclassTests : ([] ( (,) String (IO ()) ))
typeclassTests = (H.append singleParameterTests multiParameterTests)

singleParameterTests : ([] ( (,) String (IO ()) ))
singleParameterTests = ((:) (hasType "concrete method" (H.append inspectClass (H.append inspectBool "inspect true")) bool) ((:) (hasType "inferred constrained let at distinct instances" (H.append inspectClass (H.append inspectBool (H.append inspectInt "let f = \\x -> inspect x in let b = f true in f 42"))) bool) ((:) (hasType "implicit method quantification" "class Keep a where { keep : a -> b -> a }; instance Keep Int where { keep = \\x ignored -> x }; keep 42 true" int) ((:) (hasType "explicit qualified function" (H.append inspectClass (H.append inspectBool "let f : forall a. Inspect a => a -> Bool = \\x -> inspect x in f true")) bool) ((:) (hasType "qualified expression in function position" (H.append inspectClass (H.append inspectBool "((\\x -> inspect x) : forall a. Inspect a => a -> Bool) true")) bool) ((:) (hasType "qualified function parameter" (H.append inspectClass (H.append inspectBool (H.append inspectInt "(\\(f : forall a. Inspect a => a -> Bool) -> let n = f 42 in f true) ((\\x -> inspect x) : forall a. Inspect a => a -> Bool)"))) bool) ((:) (hasType "two givens of the same class" (H.append inspectClass (H.append inspectBool (H.append inspectInt "let both : forall a b. (Inspect a, Inspect b) => a -> b -> Bool = \\x y -> (\\first -> inspect y) (inspect x) in both 42 true"))) bool) ((:) (hasType "concrete call inside a generic constraint" (H.append inspectClass (H.append inspectBool (H.append inspectInt "let both : forall a. Inspect a => a -> Bool = \\x -> (\\fixed -> inspect x) (inspect true) in both 42"))) bool) ((:) (hasType "lambda shadows method" (H.append inspectClass "(\\inspect -> inspect 42) (\\x -> x)") int) ((:) (hasType "let shadows method" (H.append inspectClass "let inspect = \\x -> x in inspect 42") int) ((:) (hasType "pattern shadows method" (H.append inspectClass "data Box a = Box a; case Box 42 of { Box inspect -> inspect }") int) ((:) (hasType "higher-kinded method" (H.append maybeDecl (H.append functorClass (H.append maybeFunctor "fmap (\\x -> true) (Just 42)"))) (XCon "Maybe" ((:) bool []))) ((:) (hasType "partial type constructor instance" (H.append "data Either e a = Left e | Right a; " (H.append functorClass (H.append "instance Functor (Either e) where { fmap = \\f value -> case value of { Left err -> Left err; Right x -> Right (f x) } }; " "fmap (\\x -> true) (Right 42 :: Either Int Int)"))) (XCon "Either" ((:) int ((:) bool [])))) ((:) (hasType "instance definitions are order independent" (H.append inspectClass (H.append "class Inspect a => Test a where { test : a -> Bool }; " (H.append "instance Test Bool where { test = \\x -> inspect x }; " (H.append inspectBool "test true")))) bool) ((:) (hasType "superclass given without concrete instances" (H.append inspectClass (H.append "class Inspect a => Test a where { test : a -> Bool }; " "let f : forall a. Test a => a -> Bool = \\x -> inspect x in 42")) int) ((:) (hasType "mutually recursive methods" "class Loop a where { first : a -> a; second : a -> a }; instance Loop Int where { first = \\x -> second x; second = \\x -> first x }; first 42" int) ((:) (hasType "higher-kinded datatype application" (H.append maybeDecl "data Wrap (f : * -> *) a = Wrap (f a); case Wrap (Just 42) of { Wrap value -> value }") (XCon "Maybe" ((:) int []))) ((:) (hasType "higher-kinded annotation" (H.append maybeDecl "let id : forall (f : * -> *) a. f a -> f a = \\x -> x in id (Just 42)") (XCon "Maybe" ((:) int []))) ((:) ((,) "class: Monad hierarchy example" do { source <- (readFile "examples/monad-maybe.emlf"); do { result <- (checked source); (H.assert (T.alphaEq (inferredType result) (XCon "Maybe" ((:) int []))) "wrong Monad example result") } }) ((:) ((,) "class: contextual recursive instance example" do { source <- (readFile "examples/contextual-instance.emlf"); do { result <- (checked source); (H.assert (T.alphaEq (inferredType result) bool) "wrong contextual example result") } }) ((:) ((,) "class: qualified result is displayed using its class name" do { result <- (checked (H.append inspectClass "(\\x -> inspect x) : forall a. Inspect a => a -> Bool")); do { (H.assert ((H.contains "Inspect " (sourceType result)) && (H.contains "=>" (sourceType result))) (H.append "missing source constraint: " (sourceType result))); (H.assert (S.not (H.contains "DictInspect" (sourceType result))) "internal dictionary name leaked") } }) ((:) (rejects "missing concrete instance" (H.append inspectClass "inspect 42") Resolution "no instance or given constraint") ((:) (rejects "does not pick the only instance for an unknown type" (H.append inspectClass (H.append inspectBool "inspect")) Resolution "ambiguous") ((:) (rejects "wrong instance body" (H.append inspectClass "instance Inspect Bool where { inspect = \\x -> 42 }; true") Inference "type constructor mismatch") ((:) (rejects "method body is checked polymorphically" "class Keep a where { keep : forall b. a -> b -> b }; instance Keep Int where { keep = \\x ignored -> 42 }; true" Inference "Skolem") ((:) (rejects "missing method" (H.append inspectClass "instance Inspect Bool where {}; true") Inference "missing [\"inspect\"]") ((:) (rejects "extra method" (H.append inspectClass "instance Inspect Bool where { inspect = \\x -> x; extra = true }; true") Inference "unexpected [\"extra\"]") ((:) (rejects "duplicate method implementation" (H.append inspectClass "instance Inspect Bool where { inspect = \\x -> x; inspect = \\x -> x }; true") Inference "duplicate instance method") ((:) (rejects "duplicate class" (H.append inspectClass (H.append inspectClass "true")) Inference "duplicate class") ((:) (rejects "methods share a global namespace" (H.append inspectClass "class Other a where { inspect : a -> Int }; true") Inference "duplicate class method") ((:) (rejects "method must mention its class parameter" "class Ambiguous a where { number : Int }; true" Inference "ambiguous class method") ((:) (rejects "unknown class" "instance Missing Bool where {}; true" Inference "unknown class") ((:) (rejects "duplicate instance" (H.append inspectClass (H.append inspectBool (H.append inspectBool "true"))) Inference "overlapping instances") ((:) (rejects "overlapping generic and concrete instances" (H.append maybeDecl (H.append inspectClass "instance Inspect (Maybe a) where { inspect = \\x -> true }; instance Inspect (Maybe Int) where { inspect = \\x -> false }; true")) Inference "overlapping instances") ((:) (rejects "variable instance head" (H.append inspectClass "instance Inspect a where { inspect = \\x -> true }; true") Inference "named type constructor") ((:) (rejects "nondecreasing instance context" (H.append inspectClass "instance Inspect Bool => Inspect Bool where { inspect = \\x -> x }; true") Inference "structurally smaller") ((:) (rejects "instance context variable absent from head" (H.append inspectClass "instance Inspect a => Inspect Bool where { inspect = \\x -> x }; true") Inference "variable absent from the head") ((:) (rejects "cyclic superclasses" "class B a => A a where {}; class A a => B a where {}; true" Inference "cyclic superclass hierarchy") ((:) (rejects "missing superclass instance" (H.append inspectClass "class Inspect a => Test a where { test : a -> Bool }; instance Test Bool where { test = \\x -> x }; true") Resolution "no instance or given constraint") ((:) (rejects "class instance kind" (H.append functorClass "instance Functor Int where { fmap = \\f x -> x }; true") Inference "class parameter kind mismatch") ((:) (rejects "class context kind" (H.append functorClass "let f : forall a. Functor a => a -> a = \\x -> x in true") Inference "class parameter kind mismatch") ((:) (rejects "higher-kinded argument must have the declared kind" "data Wrap (f : * -> *) a = Wrap (f a); (\\x -> x) : Wrap Int Bool -> Wrap Int Bool" Inference "kind mismatch") ((:) (rejects "ordinary type variable cannot be applied" "(\\x -> x) : forall f a. f a -> f a" Inference "kind * cannot be applied") ((:) (rejects "method constraints require supported signatures" (H.append inspectClass "class Nested a where { nested : Inspect a => a -> Bool }; true") Inference "constraints") ((:) (targetRejects "recursive dictionary body has wrong declared type" (XLetRec ((:) ((,,) (XName 0 "d") bool (XIntTerm 1)) []) (XVarTerm (XName 0 "d"))) "declared type") ((:) (targetRejects "recursive binders must be unique" (XLetRec ((:) ((,,) (XName 0 "d") bool (XBoolTerm true)) ((:) ((,,) (XName 0 "d") bool (XBoolTerm false)) [])) (XBoolTerm true)) "duplicate recursive binder") ((:) (targetRejects "recursive binding cannot reuse an outer binder" (XAbs (XName 0 "d") bool (XLetRec ((:) ((,,) (XName 0 "d") bool (XBoolTerm true)) []) (XBoolTerm true))) "already in scope") ((:) (targetRejects "term annotation has kind star" (XTypeAbs (XTyVar 0) (XBotKind (KArrow Star Star)) (XAbs (XName 1 "x") (XVar (XTyVar 0)) (XVarTerm (XName 1 "x")))) "kind *") ((:) (targetRejects "constructor checks the kind of a type argument" (XWithData ((:) (DataDeclK "Wrap" ((:) ((,) "f" (KArrow Star Star)) []) ((:) (ConstructorDecl "Wrap" []) [])) []) (XConstructor "Wrap" ((:) int []))) "type argument kind mismatch") ((:) ((,) "class target: compact and general application spines agree" (let { applied = (XApply (XCon "Box" []) int) } in do { (H.assert (T.alphaEq applied (XCon "Box" ((:) int []))) "equivalent application representations differ"); do { (H.assert (S.not (T.alphaEq applied (XCon "Box" ((:) bool [])))) "different arguments were equated"); (H.assert (T.alphaEq XBot (XBotKind Star)) "explicit kind * changed bottom") } })) ((:) ((,) "class target: Inst-Bot cannot change kinds" (case (C.checkComputation Map.empty (XBottom int) (XBotKind (KArrow Star Star))) of { (Left err) -> (H.assert (H.contains "kind mismatch" err) err); (Right _) -> (H.fail "ill-kinded type computation was accepted") })) ((:) ((,) "class evidence: chooses the given by its type" do { ds <- (H.right (D.validateDeclarations ((:) (DataDecl "Dict" ((:) "a" []) ((:) (ConstructorDecl "MkDict" []) [])) []))); (let { first = (XName 1 "first") } in (let { second = (XName 2 "second") } in (let { evidence = ((:) ((,,) GivenEvidence first (XCon "Dict" ((:) int []))) ((:) ((,,) GivenEvidence second (XCon "Dict" ((:) bool []))) [])) } in do { term <- (H.right (resolveDictionary ds Map.empty evidence (XCon "Dict" ((:) bool [])))); (H.assert (H.eq term (XVarTerm second)) "selected the wrong same-class dictionary") }))) }) []))))))))))))))))))))))))))))))))))))))))))))))))))))

convertClass : String
convertClass = "class Convert a b where { convert : a -> b }; "

convertIntBool : String
convertIntBool = "instance Convert Int Bool where { convert = \\x -> true }; "

multiParameterTests : ([] ( (,) String (IO ()) ))
multiParameterTests = ((:) (hasType "two parameters" (H.append convertClass (H.append convertIntBool "convert 42 :: Bool")) bool) ((:) (hasType "instances with the same first parameter are disjoint" (H.append convertClass (H.append convertIntBool "instance Convert Int Int where { convert = \\x -> x }; convert 42 :: Int")) int) ((:) (hasType "instances with the same second parameter are disjoint" (H.append convertClass (H.append convertIntBool "instance Convert Bool Bool where { convert = \\x -> x }; convert true :: Bool")) bool) ((:) (hasType "repeated variables are shared across instance arguments" (H.append convertClass (H.append "instance Convert a a where { convert = \\x -> x }; " (H.append convertIntBool "let first = convert true :: Bool in convert 42 :: Bool"))) bool) ((:) (hasType "class parameter substitution is simultaneous" (H.append convertClass "instance Convert b Bool where { convert = \\x -> true }; convert 42 :: Bool") bool) ((:) (hasType "inferred multiparameter constraint" (H.append convertClass (H.append convertIntBool "let f = \\x -> convert x in f 42 :: Bool")) bool) ((:) (hasType "explicit multiparameter constraint" (H.append convertClass (H.append convertIntBool "let f : forall a b. Convert a b => a -> b = \\x -> convert x in f 42 :: Bool")) bool) ((:) (hasType "three parameters" "class Choose a b c where { choose : a -> b -> c }; instance Choose Int Bool Bool where { choose = \\x y -> y }; choose 42 true :: Bool" bool) ((:) (hasType "superclass can discard a parameter" (H.append inspectClass (H.append "class Inspect b => Two a b where { two : a -> b -> Bool }; " "let f : forall a b. Two a b => a -> b -> Bool = \\x y -> inspect y in 42")) int) ((:) (hasType "superclass can reorder parameters" (H.append convertClass (H.append "class Convert b a => Reverse a b where { reverse : a -> b -> Bool }; " "let f : forall a b. Reverse a b => b -> a = \\x -> convert x in 42")) int) ((:) (hasType "same class givens with different second arguments" (H.append convertClass (H.append convertIntBool (H.append "instance Convert Int Int where { convert = \\x -> x }; " "let f : forall a b c. (Convert a b, Convert a c) => a -> b -> c = \\x ignored -> convert x in f 42 true :: Int"))) int) ((:) ((,) "class: recursive multiparameter instance example" do { source <- (readFile "examples/multiparameter.emlf"); do { result <- (checked source); (H.assert (T.alphaEq (inferredType result) (XCon "Box" ((:) (XCon "Box" ((:) bool [])) []))) "wrong conversion result") } }) ((:) ((,) "class: multi-parameter constraint display" do { result <- (checked (H.append convertClass "(\\x -> convert x) : forall a b. Convert a b => a -> b")); do { (H.assert ((H.contains "Convert " (sourceType result)) && (H.contains "=>" (sourceType result))) (sourceType result)); (H.assert (S.not (H.contains "DictConvert" (sourceType result))) "dictionary name leaked") } }) ((:) (rejects "instance is missing a parameter" (H.append convertClass "instance Convert Int where { convert = \\x -> x }; true") Inference "arity mismatch") ((:) (rejects "instance has an extra parameter" (H.append convertClass "instance Convert Int Bool Int where { convert = \\x -> true }; true") Inference "arity mismatch") ((:) (rejects "constraint is missing a parameter" (H.append convertClass "let f : forall a. Convert a => a -> Bool = \\x -> true in true") Inference "arity mismatch") ((:) (rejects "duplicate class parameter" "class Relation a a where { relate : a -> a }; true" Inference "duplicate class parameter") ((:) (rejects "method omits a class parameter" "class Relation a b where { relate : a -> Bool }; true" Inference "ambiguous class method") ((:) (rejects "does not infer an output parameter from the only instance" (H.append convertClass (H.append convertIntBool "convert 42")) Resolution "ambiguous") ((:) (rejects "matches every repeated parameter" (H.append convertClass "instance Convert a a where { convert = \\x -> x }; convert 42 :: Bool") Resolution "no instance or given constraint") ((:) (rejects "overlap needs joint unification across parameters" (H.append convertClass "instance Convert a a where { convert = \\x -> x }; instance Convert Int Int where { convert = \\x -> x }; true") Inference "overlapping instances") ((:) (rejects "overlapping variable and concrete argument" (H.append convertClass (H.append "instance Convert a Bool where { convert = \\x -> true }; " (H.append convertIntBool "true"))) Inference "overlapping instances") ((:) (rejects "context must decrease across the whole argument tuple" (H.append convertClass "instance Convert b a => Convert a b where { convert = \\x -> convert x }; true") Inference "structurally smaller") ((:) (rejects "context cannot duplicate a variable" (H.append "data Box a = Box a; " (H.append convertClass "instance Convert a a => Convert (Box a) Bool where { convert = \\x -> true }; true")) Inference "structurally smaller") ((:) (rejects "later parameter kind is checked" "class Relation a (f : * -> *) where { relate : a -> f a }; instance Relation Int Bool where { relate = \\x -> true }; true" Inference "class parameter kind mismatch") ((:) ((,) "class evidence: superclass projection preserves caller variable identities" do { ds <- (H.right (D.validateDeclarations ((:) (DataDecl "PairDict" ((:) "a" ((:) "b" [])) ((:) (ConstructorDecl "MkPairDict" []) [])) ((:) (DataDecl "OneDict" ((:) "a" []) ((:) (ConstructorDecl "MkOneDict" []) [])) [])))); (let { a = (XTyVar 0) } in (let { b = (XTyVar 1) } in (let { given = (XName 1 "given") } in (let { super = (XName 2 "super") } in (let { pair x y = (XCon "PairDict" ((:) x ((:) y []))) } in (let { one x = (XCon "OneDict" ((:) x [])) } in (let { superType = (XForall a XBot (XForall b XBot (XArrow (pair (XVar a) (XVar b)) (one (XVar b))))) } in (let { givenType = (pair (XVar b) (XVar a)) } in (let { wanted = (one (XVar a)) } in (let { gamma = (Map.fromList ((:) ((,) a XBot) ((:) ((,) b XBot) []))) } in (let { candidates = ((:) ((,,) GivenEvidence given givenType) ((:) ((,,) SuperclassEvidence super superType) [])) } in do { proof <- (H.right (resolveDictionary ds gamma candidates wanted)); do { actual <- (H.right (C.inferWithData ds (XEnv gamma (Map.fromList ((:) ((,) given givenType) ((:) ((,) super superType) [])))) proof)); (H.assert (T.alphaEq actual wanted) "superclass projection changed a parameter identity") } }))))))))))) }) []))))))))))))))))))))))))))
