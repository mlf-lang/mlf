module Tests.DoNotation where
import Bootstrap.Types
import qualified Bootstrap.Std as S
import qualified Package.OS as OS
import qualified Tests.Helpers as H
import Tests.Helpers (Quint(..), Sext(..))
import Bootstrap.Compiler
import Bootstrap.Desugar (desugarDo)
import Bootstrap.Parser (parseExpr)
import qualified Bootstrap.X.Check as C
import qualified Bootstrap.X.Parser as P
import Bootstrap.X.Pretty (prettyTerm, prettyType)
import qualified Bootstrap.X.Syntax as X
import qualified Bootstrap.X.Type as T

checked : String -> IO Compilation
checked source = do { result <- (H.right (compile "<do test>" source)); do { parsed <- (H.right (P.parseTerm "<do xMLF>" (prettyTerm (compiledTerm result)))); do { ty <- (H.right (C.checkClosed parsed)); do { (H.assert (T.alphaEq ty (inferredType result)) "do xMLF round trip changed type"); do { (H.assert (H.eq (X.erase parsed) (X.erase (compiledTerm result))) "do xMLF round trip changed erasure"); (return result) } } } } }

hasType : String -> String -> XType -> (,) String (IO ())
hasType label source expected = ((,) (H.append "do: " label) do { result <- (checked source); (H.assert (T.alphaEq (inferredType result) expected) (H.append "expected " (H.append (prettyType expected) (H.append ", got " (sourceType result))))) })

rejects : String -> String -> Phase -> String -> (,) String (IO ())
rejects label source expectedPhase reason = ((,) (H.append "do rejection: " label) (case (compile "<invalid do>" source) of { (Left err) -> do { (H.assert (H.eq (phase err) expectedPhase) (H.append "wrong rejection phase: " (H.show err))); (H.assert (H.contains reason (diagnostic err)) (H.append "wrong rejection reason: " (H.show err))) }; (Right result) -> (H.fail (H.append "unexpected acceptance: " (sourceType result))) }))

rejectsMissingMonadFail : String -> (,) String (IO ())
rejectsMissingMonadFail source = ((,) "do rejection: refutable pattern requires canonical MonadFail" (case compile "<missing MonadFail>" source of { Left err -> H.assert ((H.eq (phase err) Resolution) && (H.contains "no instance or given constraint" (diagnostic err)) && (H.contains "MonadFail" (diagnostic err))) (H.show err); Right result -> H.fail (H.append "unexpected acceptance: " (sourceType result)) }))

int : XType
int = (XCon "Int" [])

bool : XType
bool = (XCon "Bool" [])

maybeT : XType -> XType
maybeT t = (XCon "Maybe" ((:) t []))

maybeDecl : String
maybeDecl = "data Maybe a = Nothing | Just a; "

maybeBind : String
maybeBind = "instance Functor Maybe where { fmap f value = case value of { Nothing -> Nothing; Just x -> Just (f x) } }; instance Applicative Maybe where { pure = Just; (<*>) functions values = case functions of { Nothing -> Nothing; Just f -> case values of { Nothing -> Nothing; Just x -> Just (f x) } } }; instance Monad Maybe where { (>>=) value next = case value of { Nothing -> Nothing; Just x -> next x } }; "

withoutSites : SExpr -> SExpr
withoutSites expression = case expression of {
  SCallSite _ _ value -> withoutSites value;
  SApp f x -> SApp (withoutSites f) (withoutSites x);
  SLam n t body -> SLam n t (withoutSites body);
  SLet n value body -> SLet n (withoutSites value) (withoutSites body);
  SSharedBind pattern action body binding failure -> SSharedBind pattern (withoutSites action) (withoutSites body) (withoutSites binding) (withoutSites failure);
  _ -> expression
}

sourceBind : SExpr -> String -> SExpr -> SExpr
sourceBind action name body = SSharedBind (SDefaultPattern (Just name)) action body (SVar "$MLF.Primitive.>>=") (SApp (SVar "$MLF.Primitive.fail") (SApp (SPrimitive PTextToChars) (SStringLit "Pattern match failure in do expression")))

doTests : ([] ( (,) String (IO ()) ))
doTests = (let { prefix = (H.append maybeDecl maybeBind) } in ((:) (hasType "single expression" "do { 42 }" int) ((:) (hasType "local let needs no bind" "do { let x = 42; x }" int) ((:) (hasType "binding" (H.append prefix "do { x <- Just 42; return x }") (maybeT int)) ((:) (hasType "sequencing" (H.append prefix "do { Just true; Just 42 }") (maybeT int)) ((:) (hasType "wildcard binding" (H.append prefix "do { _ <- Just true; Just 42 }") (maybeT int)) ((:) (hasType "optional trailing semicolon" (H.append prefix "do { x <- Just 42; return x; }") (maybeT int)) ((:) (hasType "nested blocks" (H.append prefix "do { x <- do { y <- Just 42; return y }; return x }") (maybeT int)) ((:) (hasType "bind statement sees the outer binding" (H.append prefix "let x = 42 in do { x <- return x; return x }") (maybeT int)) ((:) (hasType "distinct do-let binder sees the outer binding" (H.append prefix "let x = 42 in do { let y = return x; y }") (maybeT int)) ((:) (hasType "local let is generalized" (H.append prefix "do { let id = \\x -> x; let n = id 42; return (id true) }") (maybeT bool)) ((:) (hasType "local let annotation" (H.append prefix "do { let id : forall a. a -> a = \\x -> x; let n = id 42; return (id true) }") (maybeT bool)) ((:) (hasType "let-in expression is an action" (H.append prefix "do { let x = 42 in return x; return true }") (maybeT bool)) ((:) (hasType "do expression used as an argument" (H.append prefix "(\\x -> x) (do { x <- Just 42; return x })") (maybeT int)) ((:) (hasType "do expression annotation" (H.append prefix "do { x <- Just 42; return x } :: Maybe Int") (maybeT int)) ((:) (hasType "constructor pattern" (H.append maybeDecl (H.append "data Pair a b = Pair a b; " (H.append maybeBind "do { Pair n b <- Just (Pair 42 true); return n }"))) (maybeT int)) ((:) (hasType "constructor wildcard field" (H.append maybeDecl (H.append "data Pair a b = Pair a b; " (H.append maybeBind "do { Pair _ b <- Just (Pair 42 true); return b }"))) (maybeT bool)) ((:) (hasType "discarded action cannot capture an outer name" (H.append prefix "let doValue0 = true in do { Just 42; return doValue0 }") (maybeT bool)) ((:) (hasType "pattern temporary cannot capture an outer name" (H.append maybeDecl (H.append "data Box a = Box a; " (H.append maybeBind "let doValue0 = true in do { Box n <- Just (Box 42); return doValue0 }"))) (maybeT bool)) ((:) (hasType "explicit bind remains lexical" "let bind = \\action next -> next action in bind 42 (\\x -> x)" int) ((:) (rejects "lexical bind cannot intercept do" "let bind = \\action next -> next action in do { x <- 42; x }" Inference "type constructor mismatch") ((:) (rejects "same-name do-let is recursive, not an outer reference" (H.append prefix "let x = 42 in do { let x = return x; x }") Parsing "requires an explicit closed signature") ((:) (hasType "annotated recursive do-let keeps its own binding" "do { let loop : Int -> Int = \\n -> if n < 1 then 42 else loop (n - 1); loop 2 }" int) ((:) (rejects "empty block" "do {}" Parsing "unexpected") ((:) (rejects "final statement must be an expression" (H.append prefix "do { x <- Just 42 }") Parsing "must end with an expression") ((:) (rejects "cannot end with a local declaration" "do { let x = 42 }" Parsing "must end with an expression") ((:) (rejects "statements need separators" (H.append prefix "do { x <- Just 42 return x }") Parsing "must end with an expression") ((:) (rejects "default IO bind requires an action" "do { 42; 43 }" Inference "type constructor mismatch") ((:) (rejects "bound variable cannot escape" (H.append prefix "let result = do { x <- Just 42; return x } in x") Inference "unbound variable: x") ((:) (rejects "binding is not recursive" (H.append prefix "do { x <- return x; return x }") Inference "unbound variable: x") ((:) (rejects "later binding is unavailable" (H.append prefix "do { x <- return y; y <- Just 42; return x }") Inference "unbound variable: y") ((:) (rejects "action type mismatch" (H.append prefix "do { x <- 42; return x }") Inference "type constructor mismatch") ((:) (rejects "final action has the right monadic type" (H.append prefix "do { x <- Just 42; x }") Inference "type constructor mismatch") ((:) (rejectsMissingMonadFail (H.append prefix "do { Just x <- Just (Just 42); return x }")) ((:) (rejects "pattern binder duplicates" (H.append maybeDecl (H.append "data Pair a b = Pair a b; " (H.append maybeBind "do { Pair x x <- Just (Pair 1 2); return x }"))) Inference "duplicate pattern variable") ((:) ((,) "do: parser preserves statement forms" do { parsed <- (H.right (parseExpr "<do syntax>" "do { x <- action; let y = x; finish y }")); (let { expected = (sourceBind (SVar "action") "x" (SLet "y" (SVar "x") (SApp (SVar "finish") (SVar "y")))) } in (H.assert (H.eq (withoutSites parsed) expected) (H.append "unexpected do AST: " (H.show parsed)))) }) ((:) ((,) "do: lowering preserves binding order and the final action" do { parsed <- (H.right (parseExpr "<do lowering>" "do { x <- first; y <- second x; finish y }")); (let { makeSourceBind action name body = (sourceBind action name body) } in (let { expected = (makeSourceBind (SVar "first") "x" (makeSourceBind (SApp (SVar "second") (SVar "x")) "y" (SApp (SVar "finish") (SVar "y")))) } in (H.assert (H.eq (withoutSites (desugarDo parsed)) expected) "do did not lower to the expected nested bind applications"))) }) ((:) ((,) "do: multiparameter MonadState example" do { source <- (readFile "examples/monad-state-do.emlf"); do { result <- (checked source); (H.assert (T.alphaEq (inferredType result) (XCon "Pair" ((:) int ((:) int [])))) "wrong State result") } }) []))))))))))))))))))))))))))))))))))))))
