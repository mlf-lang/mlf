module Tests.SolverIndexAudit where
import Bootstrap.Types
import qualified Bootstrap.Std as L
import qualified Bootstrap.IntMap as IM
import qualified Bootstrap.IntSet as IS
import qualified Bootstrap.Graph as G
import qualified Bootstrap.Graph.Solver as S
import qualified Tests.DenseNormalization as N
import qualified Tests.Helpers as H

suite : [] ((,) String (IO ()))
suite = (:) ((,) "incremental index audit agrees with independent reconstruction" audits) []

-- Keep the previous reconstruction algorithm as an independent oracle.
reference solver = G.bindE (G.validateGraph (S.graph solver)) (\ignored ->
 let rebuilt = L.foldlStrict S.addNode (S.mkSolver (S.graph solver) IM.empty IM.empty (S.indexScopes (S.graph solver))) (IM.toList (G.nodes (S.graph solver))) in
 if IM.eqIntMap IS.eqIntSet (S.structuralParents solver) (S.structuralParents rebuilt) && IM.eqIntMap IS.eqIntSet (S.bindingChildren solver) (S.bindingChildren rebuilt) && S.equalScopes (S.scopeIndex solver) (S.scopeIndex rebuilt)
 then Right (S.graph solver) else Left "incremental graph index disagrees with the graph")

sizeWrong (IntMap tree) = IntMap (case tree of
 MapEmpty -> MapNode 1 0 IS.empty MapEmpty MapEmpty
 MapNode count key value left right -> MapNode (count + 1) key value left right)
setSizeWrong (IntSet tree) = IntSet (case tree of
 MapEmpty -> MapNode 1 0 () MapEmpty MapEmpty
 MapNode count key value left right -> MapNode (count + 1) key value left right)
variants index = case IM.toList index of
 [] -> (:) index []
 (:) ((,) key values) rest ->
  (:) index ((:) (IM.delete key index) ((:) (IM.insert key IS.empty index)
  ((:) (IM.insert key (IS.insert 999999 values) index)
  ((:) (IM.insert 999999 values index) ((:) (sizeWrong index)
  ((:) (IM.insert key (setSizeWrong values) index)
  ((:) (IntMap (MapNode 2 key values MapEmpty (MapNode 1 key values MapEmpty MapEmpty))) [])))))))

check solver = H.assert (H.eq (S.finish solver) (reference solver)) "incremental index audit changed acceptance or returned graph"
audits : IO ()
audits = L.mapM_ (\scale -> L.mapM_ (\shift -> do
 let input = N.rename (\n -> shift + scale * n) (N.fixture 7)
 prepared <- H.right (S.prepare input)
 let graph = S.graph prepared
 let parents = S.structuralParents prepared
 let descendants = S.bindingChildren prepared
 let scopes = S.scopeIndex prepared
 let parentVariants = variants parents
 let descendantVariants = variants descendants
 H.assert (L.length parentVariants == 8 && L.length descendantVariants == 8) "index corruption classes changed"
 check (Solver graph parents descendants scopes)
 L.mapM_ (\p -> check (Solver graph p descendants scopes)) (L.tail parentVariants)
 L.mapM_ (\d -> check (Solver graph parents d scopes)) (L.tail descendantVariants)
 check (Solver graph parents descendants (ScopeIndex IM.empty []))
 check (Solver (Graph IM.empty IM.empty 0) parents descendants scopes))
 ((:) 0 ((:) 340282366920938463463374607431768211456 ((:) (-340282366920938463463374607431768211456) [])))) ((:) 1 ((:) 100003 []))
