module Tests.PackageReleases where
import Bootstrap.Types
import qualified Bootstrap.Std as S
import qualified Package.OS as O
import qualified Package.Json as J
import qualified Tests.Basic as H

data Context = Context String String String
directory : Context -> String
directory (Context d _ _) = d
manager : Context -> String
manager (Context _ m _) = m
compiler : Context -> String
compiler (Context _ _ c) = c
obj = J.Object
pair = Pair
invoke : Context -> String -> String -> List String -> Bool -> String -> IO String
invoke c manifest build args success reason = do
 let stem = directory c ++ "/release-command"
 let prefix = Cons (manager c) (Cons "--manifest" (Cons manifest (Cons "--compiler" (Cons (compiler c) (Cons "--build-dir" (Cons build Nil))))))
 code <- O.exec (directory c) (S.append prefix args) "" (stem ++ ".out") (stem ++ ".err") 1800
 out <- readFile (stem ++ ".out")
 err <- readFile (stem ++ ".err")
 H.assert (H.eq (code == 0) success && (success || stringLength err > 0) && (eqString reason "" || H.contains reason err)) ("release command failed (" ++ showInt code ++ "): " ++ err)
 ioReturn out
export : Context -> String -> String -> String -> IO String
export c source build destination = invoke c (source ++ "/mlf-package.json") build (Cons "release" (Cons destination Nil)) true ""
dependency : String -> String -> J.Json
dependency path digest = obj (Cons (pair "release" (J.str path)) (Cons (pair "sha256" (J.str digest)) Nil))
setDependencies : String -> List (Pair String J.Json) -> IO Unit
setDependencies path entries = do
 value <- J.read path
 J.write path (J.set "dependencies" (obj entries) value)
checked : String -> IO Unit
checked label = putStrLn ("PASS checked release: " ++ label)
githubDependency : String -> String -> String -> String -> J.Json
githubDependency manifest asset tag name = obj (Cons (pair "github" (obj (Cons (pair "repository" (J.str "mlf-tests/fixtures")) (Cons (pair "tag" (J.str tag)) (Cons (pair "asset" (J.str name)) Nil))))) (Cons (pair "sha256" (J.str manifest)) (Cons (pair "asset_sha256" (J.str asset)) Nil)))
githubFixture : List String -> IO Unit
githubFixture args = case args of
 Cons "release" (Cons "download" (Cons _ (Cons "--repo" (Cons _ (Cons "--pattern" (Cons _ (Cons "--output" (Cons output Nil)))))))) -> do
  callPath <- getEnv "MLF_TEST_GH_CALLS"
  argsPath <- getEnv "MLF_TEST_GH_ARGS"
  asset <- getEnv "MLF_TEST_GH_ASSET"
  failure <- getEnv "MLF_TEST_GH_FAIL"
  O.require (stringLength callPath > 0 && stringLength argsPath > 0 && stringLength asset > 0) "GitHub fixture environment is missing"
  calls <- O.readOptional callPath
  writeFile callPath (calls ++ "x")
  writeFile argsPath (S.intercalate "\n" args ++ "\n")
  if eqString failure "1" then do { writeFile output "partial"; exitWith 42 } else O.copy asset output
 _ -> O.fatal "invalid GitHub fixture arguments"

-- Each IO scenario is a separate checked declaration so a cold build does
-- not infer one deeply nested bind expression for the entire suite.
githubPack : Context -> String -> String -> IO String
githubPack c app bundle = do
 let dir = directory c
 let asset = dir ++ "/greeting.mlfr"
 let secondAsset = dir ++ "/greeting-second.mlfr"
 let build = dir ++ "/github build"
 invoke c app build (Cons "pack" (Cons bundle (Cons asset Nil))) true ""
 invoke c app build (Cons "pack" (Cons (dir ++ "/second release") (Cons secondAsset Nil))) true ""
 assetHash <- fileDigest asset
 secondHash <- fileDigest secondAsset
 H.assert (eqString assetHash secondHash) "packed release depends on its directory"
 invoke c app build (Cons "pack" (Cons bundle (Cons asset Nil))) false "already exists"
 unchanged <- fileDigest asset
 H.assert (eqString assetHash unchanged) "existing packed release was replaced"
 checked "packed releases are deterministic and immutable"
 ioReturn assetHash

githubOfflineMiss : Context -> String -> String -> String -> IO Unit
githubOfflineMiss c app digest assetHash = do
 let dir = directory c
 let build = dir ++ "/github build"
 let cache = dir ++ "/github cache"
 let args = Cons "--cache-dir" (Cons cache Nil)
 let source = githubDependency digest assetHash "v1.0.0" "greeting.mlfr"
 setDependencies app (Cons (pair "greeting" source) Nil)
 invoke c app build (S.append args (O.words "--offline plan")) false "offline cache miss"
 let downloaded = cache ++ "/.downloads/" ++ assetHash
 published <- directoryExists downloaded
 H.assert (S.not published) "offline cache miss published a download"
 checked "cold offline resolution fails without a partial cache"

githubSetup : Context -> IO String
githubSetup c = do
 let dir = directory c
 let asset = dir ++ "/greeting.mlfr"
 let fake = dir ++ "/fake gh"
 let calls = dir ++ "/gh.calls"
 let arguments = dir ++ "/gh.arguments"
 O.mkdir fake
 runner <- getExecutablePath
 gh <- O.executable (fake ++ "/gh")
 O.copy runner gh
 windows <- O.isWindows
 if windows then S.mapM_ (\name -> do
   let input = O.parent runner ++ "/" ++ name
   present <- fileExists input
   if present then O.copy input (fake ++ "/" ++ name) else ioReturn Unit) (O.words "libgmp-10.dll libgc-1.dll libwinpthread-1.dll mlf-host.exe") else ioReturn Unit
 oldPath <- getEnv "PATH"
 setEnv "PATH" (fake ++ (if windows then ";" else ":") ++ oldPath)
 setEnv "MLF_TEST_GH_ASSET" asset
 setEnv "MLF_TEST_GH_CALLS" calls
 setEnv "MLF_TEST_GH_ARGS" arguments
 setEnv "MLF_TEST_GH_FAIL" "0"
 ioReturn oldPath

githubColdWarm : Context -> String -> String -> IO (Pair J.Json String)
githubColdWarm c app assetHash = do
 let dir = directory c
 let build = dir ++ "/github build"
 let cache = dir ++ "/github cache"
 let args = Cons "--cache-dir" (Cons cache Nil)
 let downloaded = cache ++ "/.downloads/" ++ assetHash
 let calls = dir ++ "/gh.calls"
 let arguments = dir ++ "/gh.arguments"
 invoke c app build (S.append args (Cons "lock" Nil)) true ""
 observed <- readFile arguments
 H.assert (eqString observed ("release\ndownload\nv1.0.0\n--repo\ngithub.com/mlf-tests/fixtures\n--pattern\ngreeting.mlfr\n--output\n" ++ downloaded ++ ".work/package.mlfr\n")) "GitHub download did not use exact repository, tag, and asset argv"
 coldCalls <- readFile calls
 H.assert (eqString coldCalls "x") "cold resolution did not download exactly once"
 lock <- J.read (O.parent app ++ "/mlf.lock")
 H.assert (S.not (H.contains cache (J.render lock))) "GitHub lock contains a machine-local cache path"
 invoke c app build (S.append args (O.words "--locked test")) true ""
 checked "pinned GitHub download supports locked source-free execution"
 setEnv "MLF_TEST_GH_FAIL" "1"
 invoke c app build (S.append args (O.words "--offline --locked test")) true ""
 warmCalls <- readFile calls
 H.assert (eqString coldCalls warmCalls) "warm offline build invoked gh"
 checked "warm offline builds need no downloader"
 ioReturn (Pair lock warmCalls)

githubRepair : Context -> String -> String -> String -> IO Unit
githubRepair c app assetHash warmCalls = do
 let dir = directory c
 let build = dir ++ "/github build"
 let cache = dir ++ "/github cache"
 let args = Cons "--cache-dir" (Cons cache Nil)
 let downloaded = cache ++ "/.downloads/" ++ assetHash
 let calls = dir ++ "/gh.calls"
 manifest <- J.read (downloaded ++ "/bundle/release.json")
 let root = J.getText "root" "" manifest
 writeFile (downloaded ++ "/bundle/crates/" ++ root ++ "/unit.mlfco") "broken extraction"
 invoke c app build (S.append args (O.words "--offline --locked test")) true ""
 repairedCalls <- readFile calls
 H.assert (eqString warmCalls repairedCalls) "extraction repair downloaded an already retained asset"
 checked "offline extraction repair uses the verified retained asset"
 writeFile (downloaded ++ "/package.mlfr") "broken download"
 invoke c app build (S.append args (O.words "--offline plan")) false "offline cache miss"
 setEnv "MLF_TEST_GH_FAIL" "0"
 invoke c app build (S.append args (O.words "--locked plan")) true ""
 repairedAsset <- fileDigest (downloaded ++ "/package.mlfr")
 H.assert (eqString repairedAsset assetHash) "online refetch did not restore the pinned asset"
 checked "corrupt retained downloads fail offline and refetch online"

githubRelocation : Context -> String -> J.Json -> IO Unit
githubRelocation c app lock = do
 let dir = directory c
 let build = dir ++ "/github build"
 let movedCache = dir ++ "/other github cache"
 invoke c app build (Cons "--cache-dir" (Cons movedCache (O.words "--locked plan"))) true ""
 savedLock <- J.read (O.parent app ++ "/mlf.lock")
 H.assert (J.equal lock savedLock) "changing cache directories changed the dependency lock"
 checked "GitHub dependency locks survive cache relocation"

githubSelectors : Context -> String -> String -> String -> IO Unit
githubSelectors c app digest assetHash = do
 let dir = directory c
 let build = dir ++ "/github build"
 let cache = dir ++ "/github cache"
 let args = Cons "--cache-dir" (Cons cache Nil)
 let downloaded = cache ++ "/.downloads/" ++ assetHash
 let source = githubDependency digest assetHash "v1.0.0" "greeting.mlfr"
 setDependencies app (Cons (pair "greeting" (githubDependency digest assetHash "v1.0.1" "greeting.mlfr")) Nil)
 invoke c app build (S.append args (O.words "--offline --locked plan")) false "mlf.lock is stale"
 setDependencies app (Cons (pair "greeting" source) Nil)
 checked "locked resolution rejects changed release locators"
 let zero = S.concatMapString (\_ -> "0") (S.range 0 63)
 setDependencies app (Cons (pair "greeting" (githubDependency zero assetHash "v1.0.0" "greeting.mlfr")) Nil)
 invoke c app build (S.append args (Cons "plan" Nil)) false "manifest SHA-256"
 preserved <- fileDigest (downloaded ++ "/bundle/release.json")
 H.assert (eqString preserved digest) "wrong manifest pin replaced a valid cached bundle"
 setDependencies app (Cons (pair "greeting" (githubDependency digest zero "v1.0.0" "greeting.mlfr")) Nil)
 invoke c app build (S.append args (Cons "plan" Nil)) false "asset SHA-256"
 rejected <- directoryExists (cache ++ "/.downloads/" ++ zero)
 H.assert (S.not rejected) "wrong asset pin was published"
 checked "both digest pins are enforced before cache publication"
 setDependencies app (Cons (pair "greeting" (githubDependency digest assetHash "--latest" "greeting.mlfr")) Nil)
 invoke c app build (S.append args (Cons "plan" Nil)) false "explicit tag"
 setDependencies app (Cons (pair "greeting" (githubDependency digest assetHash "v1.0.0" "*.mlfr")) Nil)
 invoke c app build (S.append args (Cons "plan" Nil)) false "literal .mlfr"
 checked "GitHub selectors reject option and glob syntax"

githubRetry : Context -> String -> String -> String -> IO Unit
githubRetry c app digest assetHash = do
 let dir = directory c
 let build = dir ++ "/github build"
 let source = githubDependency digest assetHash "v1.0.0" "greeting.mlfr"
 setDependencies app (Cons (pair "greeting" source) Nil)
 let failedCache = dir ++ "/failed github cache"
 setEnv "MLF_TEST_GH_FAIL" "1"
 invoke c app build (Cons "--cache-dir" (Cons failedCache (Cons "plan" Nil))) false "download failed"
 failedPublished <- directoryExists (failedCache ++ "/.downloads/" ++ assetHash)
 H.assert (S.not failedPublished) "failed download published a cache entry"
 setEnv "MLF_TEST_GH_FAIL" "0"
 invoke c app build (Cons "--cache-dir" (Cons failedCache (Cons "plan" Nil))) true ""
 checked "failed partial downloads remain unusable and can be retried"

githubMalformed : Context -> String -> String -> IO Unit
githubMalformed c app digest = do
 let dir = directory c
 let build = dir ++ "/github build"
 let cache = dir ++ "/github cache"
 let args = Cons "--cache-dir" (Cons cache Nil)
 let asset = dir ++ "/greeting.mlfr"
 envelope <- J.read asset
 let entries = J.values (J.get "crates" envelope)
 let first = S.head entries
 let malformed = Cons (Pair "invalid release asset crate key" (J.Array (Cons (J.set "key" (J.str "../escaped") first) (S.tail entries)))) (Cons (Pair "inventory mismatch" (J.Array (Cons first entries))) (Cons (Pair "inventory mismatch" (J.Array (S.tail entries))) Nil))
 S.mapM_ (\(Pair reason crates) -> do
   let badAsset = dir ++ "/malformed.mlfr"
   J.write badAsset (J.set "crates" crates envelope)
   hash <- fileDigest badAsset
   setEnv "MLF_TEST_GH_ASSET" badAsset
   setDependencies app (Cons (pair "greeting" (githubDependency digest hash "v1.0.0" "malformed.mlfr")) Nil)
   invoke c app build (S.append args (Cons "plan" Nil)) false reason
   present <- directoryExists (cache ++ "/.downloads/" ++ hash)
   H.assert (S.not present) "malformed release envelope was published") malformed
 escaped <- fileExists (cache ++ "/.downloads/escaped")
 H.assert (S.not escaped) "release envelope escaped its fixed extraction paths"
 checked "unsafe keys and duplicate or incomplete inventories are rejected"

githubTests : Context -> String -> String -> String -> IO Unit
githubTests c app bundle digest = do
 assetHash <- githubPack c app bundle
 githubOfflineMiss c app digest assetHash
 oldPath <- githubSetup c
 Pair lock warmCalls <- githubColdWarm c app assetHash
 githubRepair c app assetHash warmCalls
 githubRelocation c app lock
 githubSelectors c app digest assetHash
 githubRetry c app digest assetHash
 githubMalformed c app digest
 let source = githubDependency digest assetHash "v1.0.0" "greeting.mlfr"
 setEnv "PATH" oldPath
 unsetEnv "MLF_TEST_GH_ASSET"
 unsetEnv "MLF_TEST_GH_CALLS"
 unsetEnv "MLF_TEST_GH_ARGS"
 unsetEnv "MLF_TEST_GH_FAIL"
 setDependencies app (Cons (pair "greeting" source) Nil)

releaseSetup : Context -> String -> IO (Pair String String)
releaseSetup c root = do
 let dir = directory c
 let consumer = dir ++ "/consumer"
 let app = consumer ++ "/mlf-package.json"
 let build = dir ++ "/consumer build"
 let producer = dir ++ "/producer"
 let bundle = dir ++ "/published greeting"
 let message = dir ++ "/published message"
 O.run "" (S.append (O.words "/bin/cp -R") (Cons (root ++ "/examples/packages") (Cons producer Nil)))
 O.run "" (S.append (O.words "/bin/cp -R") (Cons producer (Cons consumer Nil)))
 export c (producer ++ "/greeting") (dir ++ "/producer build") bundle
 export c (producer ++ "/message") (dir ++ "/message build") message
 digest <- fileDigest (bundle ++ "/release.json")
 messageDigest <- fileDigest (message ++ "/release.json")
 let savedGreeting = dependency "../published greeting" digest
 setDependencies app (Cons (pair "greeting" savedGreeting) Nil)
 -- A different source location must produce the same portable release bytes.
 export c (consumer ++ "/greeting") (dir ++ "/other producer build") (dir ++ "/second release")
 secondDigest <- fileDigest (dir ++ "/second release/release.json")
 H.assert (eqString digest secondDigest) "release depends on producer source/build paths"
 checked "deterministic export from another source/build directory"
 ioReturn (Pair digest messageDigest)

releaseImmutability : Context -> String -> IO Unit
releaseImmutability c digest = do
 let dir = directory c
 let producer = dir ++ "/producer"
 let bundle = dir ++ "/published greeting"
 invoke c (producer ++ "/greeting/mlf-package.json") (dir ++ "/producer build") (Cons "release" (Cons bundle Nil)) false ""
 afterRefusal <- fileDigest (bundle ++ "/release.json")
 H.assert (eqString digest afterRefusal) "existing immutable release was replaced"
 refusedReport <- J.read (dir ++ "/producer build/build-report.json")
 H.assert (S.not (J.getBool "complete" true refusedReport)) "failed release publication reported success"
 checked "existing release is preserved"

releaseSourceFree : Context -> IO Unit
releaseSourceFree c = do
 let dir = directory c
 let consumer = dir ++ "/consumer"
 let app = consumer ++ "/mlf-package.json"
 let build = dir ++ "/consumer build"
 let producer = dir ++ "/producer"
 O.remove producer
 O.remove (dir ++ "/producer build")
 O.remove (dir ++ "/message build")
 O.remove (dir ++ "/other producer build")
 O.remove (consumer ++ "/greeting")
 O.remove (consumer ++ "/message")
 invoke c app build (Cons "plan" Nil) true ""
 invoke c app build (Cons "lock" Nil) true ""
 invoke c app build (O.words "--locked test") true ""
 initial <- J.read (build ++ "/build-report.json")
 H.assert (S.length (J.values (J.get "releases" initial)) == 1) "release import missing from build report"
 H.assert (S.all (\row -> S.not (H.contains "greeting/" (J.getText "crate" "" row)) && S.not (H.contains "message/" (J.getText "crate" "" row))) (J.values (J.get "crates" initial))) "dependency source was recompiled"
 H.assert (J.equal (J.get "backends" (S.head (J.values (J.get "tests" initial)))) (J.stringArray (O.words "interpreter llvm"))) "release missed an execution backend"
 checked "source-free locked consumer executes through interpreter and LLVM"

releaseWarm : Context -> IO J.Json
releaseWarm c = do
 let dir = directory c
 let consumer = dir ++ "/consumer"
 let app = consumer ++ "/mlf-package.json"
 let build = dir ++ "/consumer build"
 invoke c app build (Cons "test" Nil) true ""
 reused <- J.read (build ++ "/build-report.json")
 H.assert (S.all (J.getBool "cached" false) (J.values (J.get "builds" reused))) "unchanged release consumer missed the artifact cache"
 checked "unchanged consumer reuses all build artifacts"
 ioReturn reused

releaseMixedSources : Context -> String -> J.Json -> IO Unit
releaseMixedSources c root savedGreeting = do
 let dir = directory c
 let consumer = dir ++ "/consumer"
 let app = consumer ++ "/mlf-package.json"
 let build = dir ++ "/consumer build"
 -- This source crate is built before the imported release and generates the
 -- ordinary shared Prelude location first.
 O.mkdir (consumer ++ "/helper")
 writeFile (consumer ++ "/helper/Helper.emlf") "module Helper where\nidentity x = x\n"
 writeFile (consumer ++ "/helper/mlf-package.json") "{\"format\":1,\"name\":\"a-helper\",\"version\":\"0.1.0\",\"library\":{\"modules\":{\"Helper\":\"Helper.emlf\"}}}\n"
 setDependencies app (Cons (pair "a-helper" (obj (Cons (pair "path" (J.str "helper")) Nil))) (Cons (pair "greeting" savedGreeting) Nil))
 invoke c app (dir ++ "/mixed source build") (Cons "test" Nil) true ""
 checked "source and release dependencies share the canonical Prelude"
 O.run "" (S.append (O.words "/bin/cp -R") (Cons (root ++ "/examples/packages/message") (Cons (consumer ++ "/source-message") Nil)))
 setDependencies app (Cons (pair "greeting" savedGreeting) (Cons (pair "message" (obj (Cons (pair "path" (J.str "source-message")) Nil))) Nil))
 invoke c app build (Cons "build" Nil) false "duplicate crate identity"
 checked "conflicting source and bundled crate identities are rejected"

releaseVisibility : Context -> J.Json -> String -> IO Unit
releaseVisibility c savedGreeting messageDigest = do
 let dir = directory c
 let consumer = dir ++ "/consumer"
 let app = consumer ++ "/mlf-package.json"
 let build = dir ++ "/consumer build"
 -- Independent release bundles carry the same Message and Prelude crates.
 setDependencies app (Cons (pair "greeting" savedGreeting) (Cons (pair "message" (dependency "../published message" messageDigest)) Nil))
 invoke c app build (Cons "test" Nil) true ""
 checked "two releases share their transitive checked dependencies"
 source <- readFile (consumer ++ "/Main.emlf")
 writeFile (consumer ++ "/Main.emlf") ("module Main where\nimport Message\nmain = putStrLn (render (Message \"Hello, local packages!\"))\n")
 invoke c app build (Cons "test" Nil) true ""
 setDependencies app (Cons (pair "greeting" savedGreeting) Nil)
 invoke c app build (Cons "plan" Nil) false "direct dependency"
 writeFile (consumer ++ "/Main.emlf") source
 checked "bundled transitive dependencies do not widen import visibility"

releaseLock : Context -> J.Json -> String -> IO Unit
releaseLock c savedGreeting messageDigest = do
 let dir = directory c
 let consumer = dir ++ "/consumer"
 let app = consumer ++ "/mlf-package.json"
 let build = dir ++ "/consumer build"
 invoke c app build (Cons "lock" Nil) true ""
 setDependencies app (Cons (pair "greeting" savedGreeting) (Cons (pair "message" (dependency "../published message" messageDigest)) Nil))
 invoke c app build (O.words "--locked build") false "mlf.lock is stale"
 setDependencies app (Cons (pair "greeting" savedGreeting) Nil)
 checked "locked builds reject changed release dependencies"

releaseLocalRepair : Context -> J.Json -> IO Unit
releaseLocalRepair c reused = do
 let dir = directory c
 let consumer = dir ++ "/consumer"
 let app = consumer ++ "/mlf-package.json"
 let build = dir ++ "/consumer build"
 -- Corruption of a local installation must be repaired from the verified bundle.
 let metadata = J.getText "metadata" "" (S.head (J.values (J.get "releases" reused)))
 writeFile (O.parent metadata ++ "/unit.mlfco") "corrupt local object"
 invoke c app build (Cons "test" Nil) true ""
 checked "corrupt installed objects are repaired"

releasePins : Context -> J.Json -> IO Unit
releasePins c savedGreeting = do
 let dir = directory c
 let consumer = dir ++ "/consumer"
 let app = consumer ++ "/mlf-package.json"
 let build = dir ++ "/consumer build"
 let wrong = S.concatMapString (\_ -> "0") (S.range 0 63)
 setDependencies app (Cons (pair "greeting" (dependency "../published greeting" wrong)) Nil)
 invoke c app build (Cons "build" Nil) false "SHA-256"
 setDependencies app (Cons (pair "greeting" savedGreeting) Nil)
 checked "manifest digest pin is mandatory and checked"

releaseCompatibility : Context -> J.Json -> IO (Pair String J.Json)
releaseCompatibility c savedGreeting = do
 let dir = directory c
 let consumer = dir ++ "/consumer"
 let app = consumer ++ "/mlf-package.json"
 let build = dir ++ "/consumer build"
 let bundle = dir ++ "/published greeting"
 let wrong = S.concatMapString (\_ -> "0") (S.range 0 63)
 originalManifest <- readFile (bundle ++ "/release.json")
 release <- J.read (bundle ++ "/release.json")
 J.write (bundle ++ "/release.json") (J.set "compiler_sha256" (J.str wrong) release)
 incompatible <- fileDigest (bundle ++ "/release.json")
 setDependencies app (Cons (pair "greeting" (dependency "../published greeting" incompatible)) Nil)
 invoke c app build (Cons "build" Nil) false "compiler"
 writeFile (bundle ++ "/release.json") originalManifest
 setDependencies app (Cons (pair "greeting" savedGreeting) Nil)
 checked "incompatible compiler releases are rejected"
 appData <- J.read app
 let hello = J.get "hello" (J.get "executables" appData)
 J.write app (J.set "executables" (J.set "hello" (J.set "no-prelude" (J.Boolean true) hello) (J.get "executables" appData)) appData)
 invoke c app build (Cons "build" Nil) false "Prelude"
 J.write app appData
 checked "incompatible Prelude modes are rejected"
 ioReturn (Pair originalManifest release)

releaseObjectIntegrity : Context -> J.Json -> String -> J.Json -> IO Unit
releaseObjectIntegrity c savedGreeting originalManifest release = do
 let dir = directory c
 let consumer = dir ++ "/consumer"
 let app = consumer ++ "/mlf-package.json"
 let build = dir ++ "/consumer build"
 let bundle = dir ++ "/published greeting"
 -- A producer-controlled manifest and new pin cannot turn malformed object
 -- bytes into a locally checked receipt.
 let rootKey = J.getText "root" "" release
 let crates = bundle ++ "/crates/"
 let rootRow = S.fromMaybe (panic "missing release root") (S.find (\row -> eqString (J.getText "key" "" row) rootKey) (J.values (J.get "crates" release)))
 let objectPath = crates ++ rootKey ++ "/unit.mlfco"
 savedObject <- readFile objectPath
 writeFile objectPath "forged release object"
 invoke c app build (Cons "build" Nil) false "digest mismatch"
 checked "bundle artifact hashes are verified even after a cache hit"
 forgedHash <- fileDigest objectPath
 let forgedKey = J.getText "metadata_sha256" "" rootRow ++ forgedHash
 O.move (crates ++ rootKey) (crates ++ forgedKey)
 let forgedRow = J.set "key" (J.str forgedKey) (J.set "object_sha256" (J.str forgedHash) rootRow)
 let forgedManifest = J.set "root" (J.str forgedKey) (J.set "crates" (J.Array (S.map (\row -> if eqString (J.getText "key" "" row) rootKey then forgedRow else row) (J.values (J.get "crates" release)))) release)
 J.write (bundle ++ "/release.json") forgedManifest
 forgedDigest <- fileDigest (bundle ++ "/release.json")
 setDependencies app (Cons (pair "greeting" (dependency "../published greeting" forgedDigest)) Nil)
 invoke c app build (Cons "build" Nil) false "malformed crate object framing"
 O.move (crates ++ forgedKey) (crates ++ rootKey)
 writeFile objectPath savedObject
 writeFile (bundle ++ "/release.json") originalManifest
 setDependencies app (Cons (pair "greeting" savedGreeting) Nil)
 checked "recomputed producer digests cannot bypass object checking"

releaseRelocation : Context -> String -> IO Unit
releaseRelocation c digest = do
 let dir = directory c
 let consumer = dir ++ "/consumer"
 let app = consumer ++ "/mlf-package.json"
 let build = dir ++ "/consumer build"
 let bundle = dir ++ "/published greeting"
 -- Moving the entire bundle must not retain producer or installation paths.
 O.move bundle (dir ++ "/relocated greeting")
 setDependencies app (Cons (pair "greeting" (dependency "../relocated greeting" digest)) Nil)
 invoke c app (dir ++ "/fresh relocated build") (Cons "test" Nil) true ""
 checked "bundle and cache relocation preserve source-free execution"

runReleases : String -> IO Unit
runReleases dir = do
 root <- canonicalPath "."
 tool <- getEnv "MLF_PACKAGE_MANAGER"
 seed <- getEnv "MLF_BOOTSTRAP_COMPILER"
 let c = Context dir tool seed
 Pair digest messageDigest <- releaseSetup c root
 let savedGreeting = dependency "../published greeting" digest
 releaseImmutability c digest
 releaseSourceFree c
 reused <- releaseWarm c
 releaseMixedSources c root savedGreeting
 releaseVisibility c savedGreeting messageDigest
 releaseLock c savedGreeting messageDigest
 releaseLocalRepair c reused
 releasePins c savedGreeting
 Pair originalManifest release <- releaseCompatibility c savedGreeting
 releaseObjectIntegrity c savedGreeting originalManifest release
 releaseRelocation c digest
 githubTests c (dir ++ "/consumer/mlf-package.json") (dir ++ "/relocated greeting") digest
 putStrLn "28 checked package release cases passed"

main : IO Unit
main = H.withScratch runReleases
