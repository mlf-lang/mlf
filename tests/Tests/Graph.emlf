module Tests.Graph
 (Build(..), runBuild, emptyGraph, freshId, newNode, setNode, nodeAt, resolve,
  children, reachable, underBinder, inert, permission, unify, expand,
  expandWithScopes, normalize, validateGraph, orderedBelow, genRoot, kindAt,
  bottomTag, nodes, links, nextId, tag, binder, flag, get, put, lift) where
-- Use standard classes for shared values and the test graph state action.
import Prelude hiding (Monad, return, bind, pure)
import MLF.Primitive (Functor, fmap, Applicative, pure, (<*>), Monad, (>>=), return, bind)
import Bootstrap.Types
import qualified Bootstrap.Std as S
import qualified Bootstrap.Graph as G

data Build a = Build (Graph -> Either String ((,) a Graph))
runBuild : forall a. Graph -> Build a -> Either String ((,) a Graph)
runBuild g (Build f) = f g
returnBuild x = Build (\g -> Right ((,) x g))
bindBuild : forall a b. Build a -> (a -> Build b) -> Build b
bindBuild (Build f) next = Build (\g -> S.eitherBind (f g) (\((,) a changed) -> runBuild changed (next a)))
instance Functor Build where { fmap f action = bindBuild action (\x -> returnBuild (f x)) }
instance Applicative Build where {
 pure = returnBuild;
 (<*>) functions arguments = bindBuild functions (\f -> bindBuild arguments (\x -> returnBuild (f x)))
}
instance Monad Build where { (>>=) = bindBuild }
get : Build Graph
get = Build (\g -> Right ((,) g g))
put : Graph -> Build ()
put g = Build (\old -> Right ((,) () g))
lift : forall a. Either String a -> Build a
lift x = Build (\g -> S.mapEither (\a -> (,) a g) x)
unify equations = Build (\g -> S.mapEither ((,) ()) (G.unify equations g))
expand source destination = Build (G.expand source destination)
freshId : Build Int
freshId = Build (\g -> Right (G.freshId g))
newNode t b f = Build (\g -> Right (G.newNode t b f g))
setNode n v = Build (\g -> Right ((,) () (G.setNode n v g)))
nodes = G.nodes
links = G.links
nextId = G.nextId
tag = G.tag
binder = G.binder
flag = G.flag
emptyGraph = G.emptyGraph
resolve = G.resolve
nodeAt = G.nodeAt
children = G.children
bottomTag = G.bottomTag
genRoot = G.genRoot
kindAt = G.kindAt
reachable = G.reachable
underBinder = G.underBinder
inert = G.inert
permission = G.permission
validateGraph = G.validateGraph
expandWithScopes scopes source destination = Build (G.expandWithScopes scopes source destination)
normalize = G.normalize
orderedBelow = G.orderedBelow
