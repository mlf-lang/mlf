module Tests.Graph
 (Build(..), runBuild, emptyGraph, freshId, newNode, setNode, nodeAt, resolve,
  children, reachable, underBinder, inert, permission, unify, expand,
  expandWithScopes, normalize, validateGraph, orderedBelow, genRoot, kindAt,
  bottomTag, nodes, links, nextId, tag, binder, flag, get, put, lift) where
import Bootstrap.Types
import qualified Bootstrap.Std as S
import qualified Bootstrap.Graph as G

data Build a = Build (Graph -> Either String (Pair a Graph))
runBuild : forall a. Graph -> Build a -> Either String (Pair a Graph)
runBuild g (Build f) = f g
returnBuild x = Build (\g -> Right (Pair x g))
bindBuild : forall a b. Build a -> (a -> Build b) -> Build b
bindBuild (Build f) next = Build (\g -> S.eitherBind (f g) (\(Pair a changed) -> runBuild changed (next a)))
instance Monad Build where { return = returnBuild; bind = bindBuild }
get : Build Graph
get = Build (\g -> Right (Pair g g))
put : Graph -> Build Unit
put g = Build (\old -> Right (Pair Unit g))
lift : forall a. Either String a -> Build a
lift x = Build (\g -> S.mapEither (\a -> Pair a g) x)
unify equations = Build (\g -> S.mapEither (Pair Unit) (G.unify equations g))
expand source destination = Build (G.expand source destination)
freshId : Build Int
freshId = Build (\g -> Right (G.freshId g))
newNode t b f = Build (\g -> Right (G.newNode t b f g))
setNode n v = Build (\g -> Right (Pair Unit (G.setNode n v g)))
nodes = G.nodes
links = G.links
nextId = G.nextId
tag = G.tag
binder = G.binder
flag = G.flag
strictPair = G.strictPair
