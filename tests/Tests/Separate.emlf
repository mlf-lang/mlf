module Tests.Separate where
import Bootstrap.Types
import qualified Bootstrap.Std as S
import qualified Package.OS as OS
import qualified Tests.Helpers as H
import Tests.Helpers (Quint(..), Sext(..))
import qualified Tests.Map as M
import Bootstrap.Module
import Bootstrap.Parser (parseModule)
import Bootstrap.Separate
import qualified Bootstrap.X.Check as Check
import qualified Bootstrap.X.Syntax as X
import qualified Bootstrap.X.Type as T
import Tests.Modules (modulePrograms, moduleRejections, ModuleRejection(..))

separatePrograms : (List ( (Quint String PreludeMode (List (Pair String String)) String String) ))
separatePrograms = (H.append modulePrograms (H.append (Cons (Quint "inferred overloaded export" ImplicitPrelude (Cons (Pair "Render" (S.unlines (Cons "module Render (Render(..), renderTwice) where" (Cons "class Render a where" (Cons "  render : a -> String" (Cons "instance Render Int where" (Cons "  render = showInt" (Cons "renderTwice x = render x ++ render x" Nil)))))))) Nil) "module Main where\nimport Render\nmain = putStrLn (renderTwice 4)\n" "44\n") (Cons (Quint "rank-n constructor field" ImplicitPrelude (Cons (Pair "Poly" "module Poly where\ndata Poly = Poly (forall a. a -> a)\npoly = Poly (\\x -> x)\n") Nil) "module Main where\nimport Poly\nmain = case poly of\n  Poly f -> do\n    let id = (\\x -> x) (f : forall a. a -> a)\n    printInt (id 42)\n    putStrLn (id \"polymorphic\")\n" "42\npolymorphic\n") (Cons (Quint "class-free bounded annotation rules" NoImplicitPrelude (Cons (Pair "Poly" "module Poly where\ndata Poly = Poly (forall a. a -> a)\npoly = Poly (\\x -> x)\n") Nil) "module Main where\nimport Poly\nmain = case poly of\n  Poly f -> let id = f : forall a. a -> a in ioBind (printInt (id 42)) (\\ignored -> putStrLn (id \"polymorphic\"))\n" "42\npolymorphic\n") (Cons (Quint "unexported nominal type in inferred signature" ImplicitPrelude (Cons (Pair "Secret" "module Secret (make, reveal) where\ndata Hidden = Hidden Int\nmake = Hidden\nreveal (Hidden x) = x\n") Nil) "module Main where\nimport Secret\nmain = printInt (reveal (make 42))\n" "42\n") (Cons (Quint "mutually recursive module values" ImplicitPrelude (Cons (Pair "Parity" (S.unlines (Cons "module Parity (even) where" (Cons "even : Int -> Bool" (Cons "even n = if n == 0 then true else odd (n-1)" (Cons "odd : Int -> Bool" (Cons "odd n = if n == 0 then false else even (n-1)" Nil))))))) Nil) "module Main where\nimport Parity\nmain = printInt (if even 42 then 42 else 0)\n" "42\n") (Cons (Quint "Unicode interface identity" ImplicitPrelude (Cons (Pair "Unicode" "module Unicode (λ) where\nλ = 42\n") Nil) "module Main where\nimport Unicode\nmain = printInt λ\n" "42\n") (Cons (Quint "nominal global cannot capture local binder" ImplicitPrelude (Cons (Pair "A" "module A where\nx = 41\n") Nil) "module Main where\nimport A\nf module_65_z_120_ = x + module_65_z_120_\nmain = printInt (f 1)\n" "42\n") Nil))))))) (Cons (Quint "imported entry binding" ImplicitPrelude (Cons (Pair "Entry" "module Entry (main) where\nmain = printInt 42\n") Nil) "module Main where\nimport Entry\n" "42\n") Nil)))

compileSeparateProgram : PreludeMode -> (List ( (Pair (String) (String)) )) -> String -> Either String (List ( UnitObject ))
compileSeparateProgram mode libraries source = do { root <- (parseModule "Main.emlf" source); do { modules <- (loadModuleMap (M.fromList (S.concatMap (\(Pair n s) -> (Cons (Pair n (Pair (H.append n ".emlf") s)) Nil)) libraries)) root); do { prelude <- builtinPrelude; (let { initial = (M.singleton "Prelude" prelude) } in (let { iface (UnitObject i _) = i } in (let { dependencies known m = (let rec { closure : List UnitObject -> List String -> Either String (List UnitObject); closure done Nil = (Right done); closure done (Cons n ns) = (if (S.any (S.compose (\section1 -> (H.eq section1 n)) (S.compose unitName iface)) done) then (closure done ns) else (if true then do { o <- (S.maybe (Left (H.append "missing dependency " n)) Right (M.lookup n known)); do { earlier <- (closure done (S.map S.fst (unitDependencies (iface o)))); (closure (H.append earlier (Cons o Nil)) ns) } } else (panic "non-exhaustive test guard"))) } in (closure Nil (S.map importedModule (importsFor mode m)))) } in (let { compileOne (Pair known objects) m = do { deps <- (dependencies known m); do { object <- (compileUnit mode (S.map iface deps) m); (case object of { (UnitObject i _) -> do { i' <- (decodeInterface (encodeInterface i)); do { checked <- (decodeObject i' (encodeObject object)); (return (Pair (M.insert (unitName i) checked known) (H.append objects (Cons checked Nil)))) } } }) } } } in do { (Pair known _) <- (S.foldM compileOne (Pair initial Nil) modules); do { deps <- (dependencies known root); do { object <- (S.maybe (Left "missing entry") Right (M.lookup (moduleIdentity root) known)); (return (H.append deps (Cons object Nil))) } } })))) } } }

separateTests : (List ( (Pair (String) (IO Unit)) ))
separateTests = (let { expect reason result = (case result of { (Left message) -> (H.assert (H.contains reason message) message); (Right _) -> (H.fail (H.append "accepted forged object: " reason)) }) } in (H.append (S.concatMap (\(Quint name mode libraries source _) -> (Cons (Pair (H.append "separate modules: " name) do { objects <- (H.right (compileSeparateProgram mode libraries source)); do { term <- (H.right (linkObjects objects "Main")); do { ty <- (H.right (Check.checkClosed term)); (H.assert (T.alphaEq ty (XCon "IO" (Cons (XCon "Unit" Nil) Nil))) (H.append "module entry retained unresolved arguments: " (H.show ty))) } } }) Nil)) separatePrograms) (H.append (S.concatMap (\comprehension2 -> case comprehension2 of { (ModuleRejection name libraries source _ _) -> (let { mode = ImplicitPrelude } in (Cons (Pair (H.append "separate rejects: " name) (case (compileSeparateProgram mode libraries source) of { (Left _) -> (return Unit); (Right _) -> (H.fail (H.append "accepted invalid modules: " name)) })) Nil)); _ -> Nil }) moduleRejections) (Cons (Pair "separate interface version rejection" (H.assert (S.either (S.const true) (S.const false) (decodeInterface "6:MLFI-9")) "accepted unknown format")) (Cons (Pair "separate object export scheme is independently checked" do { source <- (H.right (parseModule "Main.emlf" "module Main where\nmain = printInt 42\n")); do { (UnitObject iface term) <- (H.right (compileUnit NoImplicitPrelude Nil source)); (let { forged = (UnitObject (setInterfaceBindings iface (S.concatMap (\(Pair n _) -> (Cons (Pair n (XCon "Bool" Nil)) Nil)) (unitBindings iface))) term) } in (expect "export type mismatch" (linkObjects (Cons forged Nil) "Main"))) } }) (Cons (Pair "separate object datatype layout is independently checked" do { source <- (H.right (parseModule "Main.emlf" "module Main where\ndata Hidden = Hidden Int\nmain = printInt 42\n")); do { (UnitObject iface term) <- (H.right (compileUnit NoImplicitPrelude Nil source)); (let { forged = (UnitObject iface (case term of { (XWithData _ body) -> body; _ -> term })) } in do { _ <- (H.right (Check.checkClosed (objectTerm forged))); (expect "datatype interface mismatch" (linkObjects (Cons forged Nil) "Main")) }) } }) (Cons (Pair "separate object dependency parameters are checked even when unused" do { source <- (H.right (parseModule "Main.emlf" "module Main where\nmain = printInt 42\n")); do { prelude <- (H.right builtinPrelude); (case prelude of { (UnitObject imported _) -> do { (UnitObject iface term) <- (H.right (compileUnit ImplicitPrelude (Cons imported Nil) source)); (let rec { strip : XTerm -> XTerm; strip (XAbs _ _ body) = (strip body); strip body = body } in (let { forged = (UnitObject iface (case term of { (XWithData ds body) -> (XWithData ds (strip body)); _ -> (strip term) })) } in do { _ <- (H.right (Check.checkClosed (objectTerm forged))); (expect "dependency parameter mismatch" (linkObjects (Cons prelude (Cons forged Nil)) "Main")) })) } }) } }) Nil)))))))

setInterfaceBindings (UnitInterface a b c d e f g h) bindings = UnitInterface a b c d e f bindings h
