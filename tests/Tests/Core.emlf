v : Int -> XType
v = (S.compose XVar XTyVar)

allT : Int -> XType -> XType -> XType
allT = (S.compose XForall XTyVar)

int : XType
int = (XCon "Int" Nil)

bool : XType
bool = (XCon "Bool" Nil)

identity : XType
identity = (allT 0 XBot (XArrow (v 0) (v 0)))

chooseId : XType
chooseId = (allT 1 identity (XArrow (v 1) (v 1)))

choosePrefix : String
choosePrefix = "let choose = ((\\x y -> x) : forall a. a -> a -> a) in let id = \\x -> x in "

sameType : XType -> XType -> IO Unit
sameType actual expected = (H.assert (T.alphaEq actual expected) (H.append "expected " (H.append (prettyType expected) (H.append ", got " (prettyType actual)))))

compileOK : String -> IO Compilation
compileOK source = do { result <- (H.right (compile "<test>" source)); do { parsed <- (H.right (XP.parseTerm "<generated xMLF>" (prettyTerm (compiledTerm result)))); do { (H.assert (H.eq (X.erase parsed) (X.erase (compiledTerm result))) "printed output changed erasure"); do { ty <- (H.right (C.checkClosed parsed)); do { (sameType ty (inferredType result)); (return result) } } } } }

hasType : String -> String -> XType -> Pair String (IO Unit)
hasType label source ty = (Pair label (bind (compileOK source) (\r -> (sameType (inferredType r) ty))))

accepts : String -> String -> Pair String (IO Unit)
accepts label source = (Pair label (bind (compileOK source) (\ignored -> (return Unit))))

rejects : String -> String -> Pair String (IO Unit)
rejects label source = (Pair label (case (compile "<test>" source) of { (Left (CompileError Inference _)) -> (return Unit); (Left err) -> (H.fail (H.append "error at the wrong phase: " (H.show err))); (Right r) -> (H.fail (H.append "unexpected type: " (prettyType (inferredType r)))) }))

compilerTests : (List ( Pair String (IO Unit) ))
compilerTests = (Cons (hasType "identity" "\\x -> x" identity) (Cons (hasType "constant 42" "42" int) (Cons (hasType "boolean" "true" bool) (Cons (hasType "identity self-application" "(\\x -> x) (\\y -> y)" identity) (Cons (hasType "let polymorphism" "let id = \\x -> x in let number = id 42 in id true" bool) (Cons (hasType "lambda scope is not generalized" "\\x -> let y = x in y" identity) (Cons (hasType "lexical shadowing" "let x = true in (\\x -> x) 42" int) (Cons (hasType "let RHS sees outer binding" "let x = true in let x = x in x" bool) (Cons (hasType "application under an unannotated lambda" "\\f x -> f x" (allT 0 XBot (allT 1 XBot (XArrow (XArrow (v 0) (v 1)) (XArrow (v 0) (v 1)))))) (Cons (hasType "K preserves its polymorphic return bound" "\\x y -> x" (allT 0 XBot (allT 1 (allT 2 XBot (XArrow (v 2) (v 0))) (XArrow (v 0) (v 1))))) (Cons (hasType "g g" (H.append choosePrefix "let g = choose id in g g") chooseId) (Cons (hasType "g g applied to identity" (H.append choosePrefix "let g = choose id in g g id 42") int) (Cons (rejects "g g retains its identity lower bound" (H.append choosePrefix "let g = choose id in g g 42")) (Cons (hasType "closed annotation" "(\\x -> x) : forall a. a -> a" identity) (Cons (hasType "let annotation" "let id : forall a. a -> a = \\x -> x in id" identity) (Cons (hasType "bounded annotation" "(\\x -> x) : forall (a >= forall b. b -> b). a -> a" chooseId) (Cons (hasType "annotated self-application" "\\(f : forall a. a -> a) -> f f" (allT 1 identity (XArrow identity (v 1)))) (Cons (hasType "polymorphic parameter at distinct instances" "(\\(f : forall a. a -> a) -> let a = f 42 in f true) (\\x -> x)" bool) (Cons (hasType "impredicative result" "(\\(f : forall a. a -> a) -> f f) (\\x -> x)" identity) (Cons (hasType "partial annotation" "((\\x -> \\y -> y) : exists a. a -> (forall b. b -> b)) 42" identity) (Cons (hasType "existential root" "(\\x -> x) : exists a. a" identity) (Cons (hasType "existential annotation shares both sides" "(\\x -> x) : exists a. a -> a" identity) (Cons (hasType "alias bounds normalized before xMLF" "(\\x -> x) : forall a (b >= a). b -> b" identity) (Cons (hasType "inert bounds inlined" "(\\x -> x) : forall (a >= Int). a -> a" (XArrow int int)) (Cons (hasType "unused bounds disappear" "(\\x -> x) : forall unused a. a -> a" identity) (Cons (hasType "forall a.a equivalent to its bound" "(\\x -> x) : forall (a >= forall b. b -> b). a" identity) (Cons (hasType "annotation alpha-renaming" "(\\x -> x) : forall z. z -> z" identity) (Cons (hasType "parameterized type constructor" "(\\x -> x) : forall a. List a -> List a" (allT 0 XBot (XArrow (XCon "List" (Cons (v 0) Nil)) (XCon "List" (Cons (v 0) Nil))))) (Cons (accepts "rigid polymorphic bound" "(\\x -> x) : forall (a = forall b. b -> b). a -> a") (Cons (accepts "multiple quantified variables" "(\\x y -> x) : forall a b. a -> b -> a") (Cons (accepts "shared type has independent lexical binders" "let id = let id = \\x -> x in id in \\ignored -> (\\x y -> x) (\\x -> true)") (Cons (accepts "arbitrary-rank annotation" "\\(f : ((forall a. a -> a) -> Int) -> Int) -> f (\\(id : forall a. a -> a) -> id 42)") (Cons (rejects "unannotated self-application" "\\x -> x x") (Cons (rejects "inconsistent monomorphic argument" "\\f -> let a = f 42 in f true") (Cons (rejects "integer is not a function" "42 true") (Cons (rejects "cannot satisfy universal identity with an integer result" "(\\x -> 42) : forall a. a -> a") (Cons (rejects "distinct skolems cannot merge" "(\\x -> x) : forall a b. a -> b") (Cons (rejects "wrong closed annotation" "42 : Bool") (Cons (rejects "cannot invent a polymorphic value" "42 : forall a. a") (Cons (rejects "free source variable" "missing") (Cons (rejects "recursive let is not implicit" "let x = x in x") (Cons (rejects "type annotation has a free variable" "(\\x -> x) : a -> a") (Cons (rejects "constructor arity" "42 : Int Bool") (Cons (Pair "trailing input is rejected" (H.reject (parseExpr "<test>" "42 )"))) (Cons (Pair "parser handles nested comments" do { r <- (compileOK "{- outer {- inner -} -} let id = \\x -> x in -- a comment\n id 42"); (sameType (inferredType r) int) }) (Cons (Pair "generated computations are necessary" do { r <- (compileOK "(\\x -> x) 42"); (H.reject (C.checkClosed (stripComputations (compiledTerm r)))) }) Nil))))))))))))))))))))))))))))))))))))))))))))))

graphTests : (List ( Pair String (IO Unit) ))
graphTests = (Cons (Pair "expansion resets scheme flag and binding" do { c <- (H.right (bind (parseExpr "<test>" "\\x -> x") generate)); do { g <- (H.right (solve c)); (let { gen = (generalization (skeleton c)) } in (let { s = (G.genRoot g gen) } in do { (Pair (Triple r _ es) expanded) <- (H.right (G.runBuild g (G.expand gen gen))); do { (H.assert (H.eq (G.flag (G.nodeAt g s)) Rigid) "scheme root not normalized"); do { (H.assert (H.eq (G.flag (G.nodeAt expanded r)) Flexible) "flag was not reset"); do { (H.assert (H.null es) "closed identity has a frontier"); (let { locals = (S.concatMap (\(Pair n vn) -> (if (H.eq (G.binder vn) (Just r)) then (Cons n Nil) else Nil)) (IM.toList (G.nodes expanded))) } in (H.assert (H.eq (H.length locals) 1) "generalized variable was not rebound to expansion root")) } } } })) } }) (Cons (Pair "all inert nodes normalized" do { r <- (compileOK "\\f x -> f x"); (let { g = (presolution r) } in ((H.forM_ (IM.toList (G.nodes g))) (\(Pair n vn) -> (case (G.tag vn) of { (GGen _) -> (return Unit); _ -> (S.when (G.inert g n) (H.assert (H.eq (G.flag vn) Rigid) "inert flexible node escaped")) })))) }) (Cons (Pair "well-domination enforced" (let { g = (Graph (IM.fromList (Cons (Pair 0 (Node (GGen 1) Nothing Flexible)) (Cons (Pair 1 (Node (GArr 2 3) (Just 0) Rigid)) (Cons (Pair 2 (Node (GArr 3 3) (Just 1) Rigid)) (Cons (Pair 3 (Node GBot (Just 2) Flexible)) Nil))))) IM.empty 4) } in (H.reject (G.validateGraph g)))) Nil)))

oracleTest : IO Unit
oracleTest = do
 let exhaustive = closedTerms 6
 let seeded = generatedTerms 5000
 let unique = distinctTermCases seeded
 let terms = S.append (S.zip (S.range 1 1712) exhaustive) (S.map (\(Pair seed e) -> Pair (1712 + seed) e) unique)
 let cases = S.map (\(Pair i e) -> Triple i e (hmTypable e)) terms
 H.assert (S.length exhaustive == 1712 && S.length seeded == 5000 && S.length unique == 4991) "independent HM corpus coverage changed"
 let typed = S.length (S.filter (\(Triple _ _ expected) -> expected) cases)
 H.assert (typed > 100 && typed < S.length cases) "oracle corpus lacks positive or negative cases"
 Coverage.forCounted "core" "hm-executed" cases (\(Triple i e expected) -> case compileExpr e of
  Right _ -> H.assert expected ("accepted non-ML term " ++ H.show i ++ ": " ++ H.show e)
  Left err -> do
   H.assert (H.eq (phase err) Inference) ("compiler failure on " ++ H.show e ++ ": " ++ H.show err)
   H.assert (S.not expected) ("rejected ML term " ++ H.show i ++ ": " ++ H.show e ++ "\n" ++ H.show err))
 putStrLn ("Oracle: 6712 cases; 6703 executions (1712 exhaustive, 4991 distinct of 5000 seeded); " ++ H.show typed ++ " typable")
 Coverage.metric "core" "hm-prescribed" (S.length exhaustive + S.length seeded)
 Coverage.metric "core" "hm-exhaustive" (S.length exhaustive)
 Coverage.metric "core" "hm-generated" (S.length seeded)
 Coverage.metric "core" "hm-distinct-generated" (S.length unique)
 Coverage.metric "core" "hm-typable" typed

annotationCorpus : IO Unit
annotationCorpus = (let { identityExpr = (SLam "x" Nothing (SVar "x")) } in (let { identityType = (SForall Flexible "a" SBottom (SArrow (STVar "a") (STVar "a"))) } in (let { types = (Cons SBottom (Cons (SCon "Int" Nil) (Cons (SCon "Bool" Nil) (Cons identityType (Cons (SForall Flexible "a" SBottom (SCon "List" (Cons (STVar "a") Nil))) (Cons (SForall Flexible "a" identityType (SArrow (STVar "a") (STVar "a"))) Nil)))))) } in (let { nested = (H.append types (S.concatMap (\a -> (S.concatMap (\b -> (Cons (SArrow a b) Nil)) types)) types)) } in (let { programs = (S.concat (S.concatMap (\t -> (Cons (Cons (SAnn identityExpr (SAnnotation Nil (SArrow t t))) (Cons (SLam "x" (Just (SAnnotation Nil t)) (SVar "x")) (Cons (SLet "f" (SAnn identityExpr (SAnnotation Nil (SArrow t t))) (SVar "f")) Nil))) Nil)) nested)) } in do { ((Coverage.forCounted "core" "annotation-executed" programs) (\e -> (case (compileExpr e) of { (Left err) -> (H.fail (H.append "failed annotated identity " (H.append (H.show e) (H.append "\n" (H.show err))))); (Right r) -> do { parsed <- (H.right (XP.parseTerm "<annotation xMLF>" (prettyTerm (compiledTerm r)))); do { ty <- (H.right (C.checkClosed parsed)); (sameType ty (inferredType r)) } } }))); (putStrLn (H.append "Annotations: " (H.append (H.show (H.length programs)) " typed programs"))) })))))

examplesTest : IO Unit
examplesTest = do { files <- (H.fmap (S.compose H.sort (S.filter (\section1 -> (H.contains ".emlf" section1)))) (listDirectory "examples")); do { (H.assert ((H.length files) >= 6) "example files are missing"); ((H.forM_ files) (\file -> (bind (bind (readFile (H.append "examples/" file)) compileOK) (\ignored -> (return Unit))))) } }

stripComputations : XTerm -> XTerm
stripComputations t = (case t of { (XTypeApp a _) -> (stripComputations a); (XAbs n ty b) -> (XAbs n ty (stripComputations b)); (XApp a b) -> (XApp (stripComputations a) (stripComputations b)); (XTypeAbs a ty b) -> (XTypeAbs a ty (stripComputations b)); (XLet n a b) -> (XLet n (stripComputations a) (stripComputations b)); (XLetRec ds b) -> (XLetRec (S.concatMap (\(Triple n ty a) -> (Cons (Triple n ty (stripComputations a)) Nil)) ds) (stripComputations b)); (XWithData ds b) -> (XWithData ds (stripComputations b)); (XCase a ty bs) -> (XCase (stripComputations a) ty (S.concatMap (\comprehension2 -> case comprehension2 of { (XAlternative p b) -> (Cons (XAlternative p (stripComputations b)) Nil); _ -> Nil }) bs)); _ -> t })
suite : List (Pair String (IO Unit))
suite = S.append OptimizerUses.suite (S.append CrateCodegen.suite (S.append crateQueryTests (S.append ComponentProjection.suite (S.append (S.append (S.append IntSetUnions.suite IndexEdges.suite) (S.append ProjectionRanks.suite ProjectionChanges.suite)) (S.append StrictWrappers.suite (S.append SolverIndexAudit.suite (S.append DenseNormalization.suite (S.append CheckedEmission.suite (S.append SolverAllocation.suite originalSuite)))))))))

originalSuite = S.concat (Cons compilerTests (Cons computationTests (Cons hygieneTests (Cons graphTests (Cons graphValidationTests (Cons graphUnificationTests (Cons graphSolverTests (Cons embeddingPruningTests (Cons datatypeTests (Cons typeclassTests (Cons doTests (Cons surfaceSyntaxTests (Cons readabilityTests (Cons moduleTests (Cons separateTests (Cons stateTypeTests (Cons (Cons (Pair "independent ML typability oracle" oracleTest) (Cons (Pair "annotation corpus" annotationCorpus) (Cons (Pair "example files" examplesTest) Nil))) Nil)))))))))))))))))
