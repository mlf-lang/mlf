module Tests.SeparateBackends where
import Bootstrap.Types
import qualified Bootstrap.Std as S
import qualified Package.OS as OS
import qualified Tests.Helpers as H
import Tests.Helpers (Quint(..), Sext(..))
import qualified Tests.Map as M
import Tests.Backends
import Bootstrap.Separate
import Bootstrap.Module (loadModuleMap)
import Bootstrap.Module (moduleIdentity)
import Bootstrap.Parser (parseModule)
import qualified Bootstrap.X.Parser as XP
import Tests.Modules ()
import Tests.Separate (separatePrograms, compileSeparateProgram)
import qualified Tests.Backends as B
import Tests.System
import qualified Package.OS as O
import Prelude hiding (listDirectory)

separateBackendTests : B.Backends -> (List ( (Pair (String) (IO Unit)) ))
separateBackendTests backends = (H.append (S.concatMap (\(Quint label mode libraries source expected) -> (Cons (Pair (H.append "separate runtime: " label) do { objects <- (S.either H.fail return (compileSeparateProgram mode libraries source)); do { term <- (S.either H.fail return (linkObjects objects "Main")); do { observed <- (execute backends IOEntry (Input "" false) term); do { (S.either (S.compose H.fail H.show) return (outcome observed)); (S.unless (H.eq (output observed) expected) (H.fail (H.show observed))) } } } }) Nil)) separatePrograms) (H.append (S.concatMap (\fixture -> case fixture of { (Quint label _ _ _ _) -> (Cons (Pair (H.append "separate CLI: " label) (cliProgram backends fixture)) Nil) }) separatePrograms) (Cons (Pair "separate runtime: interface-only CLI and invalidation" (cliTests backends)) Nil)))

selectedCompiler : IO String
selectedCompiler = do { configured <- (lookupEnv "MLF_BOOTSTRAP_COMPILER"); do { nativeDrivers <- (H.fmap (S.any (\section1 -> (S.not (H.eq section1 Nothing)))) (S.mapM lookupEnv (Cons "MLF_BOOTSTRAP_INTERPRETER" (Cons "MLF_BOOTSTRAP_LLVM" Nil)))); do { selected <- (case configured of { (Just candidate) -> (return candidate); Nothing -> do { (S.unless (S.not nativeDrivers) (H.fail "Native separate-module tests require MLF_BOOTSTRAP_COMPILER")); (return "emlf") } }); (bind (findExecutable selected) (S.maybe (H.fail "Cannot find module compiler") canonicalizePath)) } } }

cliProgram : B.Backends -> (Quint String PreludeMode (List (Pair String String)) String String) -> IO Unit
cliProgram backends (Quint _ mode libraries source expected) = (withScratch (\directory -> do { compiler <- selectedCompiler; do { root <- (S.either H.fail return (parseModule "Main.emlf" source)); do { graph <- (S.either H.fail return (loadModuleMap (M.fromList (S.concatMap (\(Pair n s) -> (Cons (Pair n (Pair (H.append n ".emlf") s)) Nil)) libraries)) root)); (let { originals = (M.insert "Main" source (M.fromList libraries)) } in (let { prefix name = (O.join directory (H.stringMap (\c -> (if (H.eq c 46) then 47 else c)) name)) } in (let { options = (case mode of { ImplicitPrelude -> Nil; NoImplicitPrelude -> (Cons "--no-prelude" Nil) }) } in (let { command args = do { (Triple code out err) <- (readProcessWithExitCode compiler (H.append options (H.append (Cons "-i" (Cons directory Nil)) args)) ""); do { (S.unless ((H.eq code ExitSuccess) && (H.null err)) (H.fail (H.show (Quad args code out err)))); (return out) } } } in do { ((H.forM_ graph) (\m -> (let { name = (moduleIdentity m) } in (let { file = (H.append (prefix name) ".emlf") } in do { text <- (S.maybe (H.fail (H.append "fixture missing " name)) return (M.lookup name originals)); do { (createDirectoryIfMissing true (O.parent file)); do { (writeFile file text); do { _ <- (command (Cons "--compile-module" (Cons file (Cons "-o" (Cons (prefix name) Nil))))); (removeFile file) } } } })))); do { target <- (command (Cons "--link-module" (Cons (H.append (prefix "Main") ".mlfi") Nil))); do { term <- (S.either H.fail return (XP.parseTerm "<separate CLI corpus>" target)); do { observed <- (execute backends IOEntry (Input "" false) term); do { (S.either (S.compose H.fail H.show) return (outcome observed)); (S.unless (H.eq (output observed) expected) (H.fail (H.show observed))) } } } } })))) } } }))

cliTests : B.Backends -> IO Unit
cliTests backends = (withScratch (\directory -> do { compiler <- selectedCompiler; (let { library = (O.join directory "compiled libraries") } in (let { source = (O.join directory "Library.emlf") } in (let { entry = (O.join directory "Main.emlf") } in (let { prefix = (O.join library "Library") } in (let { mainPrefix = (O.join directory "Main") } in (let { command args = do { (Triple code out err) <- (readProcessWithExitCode compiler args ""); do { (S.unless ((H.eq code ExitSuccess) && (H.null err)) (H.fail (H.show (Quad args code out err)))); (return out) } } } in (let { reject args reason = do { (Triple code out err) <- (readProcessWithExitCode compiler args ""); (S.unless ((S.not (H.eq code ExitSuccess)) && ((H.null out) && (H.contains reason err))) (H.fail (H.show (Triple code out err)))) } } in (let { librarySource value = (S.unlines (Cons "module Library (Box(..), identity, answer) where" (Cons "data Box a = Box a" (Cons "identity x = x" (Cons (H.append "answer = " value) Nil))))) } in (let { buildLib value = do { (writeFile source (librarySource value)); do { _ <- (command (Cons "--compile-module" (Cons source (Cons "-o" (Cons prefix Nil))))); (removeFile source) } } } in (let { link = (command (Cons "-i" (Cons library (Cons "--link-module" (Cons (H.append mainPrefix ".mlfi") Nil))))) } in (let { runTarget expected target = do { term <- (S.either H.fail return (XP.parseTerm "<separate CLI>" target)); do { observed <- (execute backends IOEntry (Input "" false) term); do { (S.either (S.compose H.fail H.show) return (outcome observed)); (S.unless (H.eq (output observed) expected) (H.fail (H.show observed))) } } } } in do { (createDirectory library); do { (buildLib "42"); do { nativeInterface <- (bind (readFile (H.append prefix ".mlfi")) (S.compose (S.either H.fail return) decodeInterface)); do { _ <- (bind (readFile (H.append prefix ".mlfo")) (S.compose (S.either H.fail return) (decodeObject nativeInterface))); do { sourceModule <- (S.either H.fail return (parseModule source (librarySource "42"))); do { (UnitObject prelude _) <- (S.either H.fail return builtinPrelude); do { seedObject <- (S.either H.fail return (compileUnit ImplicitPrelude (Cons prelude Nil) sourceModule)); (case seedObject of { (UnitObject seedInterface _) -> do { (writeFile (H.append prefix ".mlfo") (encodeObject seedObject)); do { (writeFile (H.append prefix ".mlfi") (encodeInterface seedInterface)); do { originalInterface <- (readFile (H.append prefix ".mlfi")); do { originalObject <- (readFile (H.append prefix ".mlfo")); do { (seq (seq (H.length originalInterface) (H.length originalObject)) (return Unit)); do { (renameFile (H.append prefix ".mlfo") (H.append prefix ".saved")); do { (writeFile entry (S.unlines (Cons "module Main where" (Cons "import Library" (Cons "main = case identity (Box answer) of" (Cons "  Box n -> printInt n" Nil)))))); do { _ <- (command (Cons "-i" (Cons library (Cons "--compile-module" (Cons entry (Cons "-o" (Cons mainPrefix Nil))))))); do { (removeFile entry); do { (reject (Cons "-i" (Cons library (Cons "--link-module" (Cons (H.append mainPrefix ".mlfi") Nil)))) ".mlfo"); do { (renameFile (H.append prefix ".saved") (H.append prefix ".mlfo")); do { target <- link; do { (runTarget "42\n" target); do { direct <- (command (Cons "-i" (Cons library (Cons "--module-to-llvm" (Cons (H.append mainPrefix ".mlfi") Nil))))); do { (Triple code llvm errors) <- (readProcessWithExitCode compiler (Cons "--xmlf-to-llvm" Nil) target); do { (S.unless ((H.eq code ExitSuccess) && ((H.null errors) && (H.eq direct llvm))) (H.fail "separate LLVM emission differs from checked target emission")); do { (buildLib "43"); do { (bind link (runTarget "43\n")); do { (buildLib "\"changed type\""); do { (reject (Cons "-i" (Cons library (Cons "--link-module" (Cons (H.append mainPrefix ".mlfi") Nil)))) "stale dependency interface"); do { (writeFile (H.append prefix ".mlfi") originalInterface); do { (writeFile (H.append prefix ".mlfo") (H.append originalObject "corrupt")); do { (reject (Cons "-i" (Cons library (Cons "--link-module" (Cons (H.append mainPrefix ".mlfi") Nil)))) "artifact"); do { (writeFile (H.append prefix ".mlfo") originalObject); do { (writeFile (H.append prefix ".mlfi") "6:MLFI-9"); do { (reject (Cons "-i" (Cons library (Cons "--link-module" (Cons (H.append mainPrefix ".mlfi") Nil)))) "unsupported"); do { (writeFile (H.append prefix ".mlfi") originalInterface); (bind link (runTarget "42\n")) } } } } } } } } } } } } } } } } } } } } } } } } } } } }) } } } } } } }))))))))))) }))
