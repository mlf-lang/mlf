module Tests.SeparateBackends where
import Bootstrap.Types
import qualified Bootstrap.Std as S
import qualified Package.OS as O
import qualified Package.Json as J
import qualified Tests.Helpers as H
import Tests.Helpers (Quint(..))
import qualified Tests.Map as M
import Tests.Backends
import qualified Tests.Backends as B
import qualified Bootstrap.Separate as Framing
import qualified Bootstrap.CrateArtifact as Artifact
import Bootstrap.Module (loadModuleMap, moduleIdentity)
import Bootstrap.Parser (parseModule)
import qualified Bootstrap.X.Parser as XP
import Tests.Modules ()
import Tests.Separate (separatePrograms, compileSeparateProgram, fixtureIdentity)
import Tests.System
import Prelude hiding (listDirectory)

separateBackendTests : B.Backends -> [] ((,) String (IO ()))
separateBackendTests backends = S.append
  (S.map (\(Quint label mode libraries source expected) -> (,) ("crate runtime: " ++ label) do
    result <- compileSeparateProgram mode libraries source
    objects <- H.right result
    term <- H.right (Artifact.linkObjects objects fixtureIdentity)
    observed <- execute backends IOEntry (Input "" false) term
    H.right (outcome observed)
    H.assert (H.eq (output observed) expected) (H.show observed)) separatePrograms)
  (S.append (S.map (\fixture -> case fixture of {Quint label _ _ _ _ -> (,) ("crate CLI: " ++ label) (cliProgram backends fixture)}) separatePrograms)
    ((:) ((,) "crate runtime: source-free metadata and semantic invalidation" (cliTests backends)) []))

selectedCompiler : IO String
selectedCompiler = do
  configured <- lookupEnv "MLF_BOOTSTRAP_COMPILER"
  selected <- case configured of {Just candidate -> return candidate; Nothing -> H.fail "Native crate tests require MLF_BOOTSTRAP_COMPILER"}
  bind (findExecutable selected) (S.maybe (H.fail "Cannot find crate compiler") canonicalizePath)

command compiler args = do
  (,,) code out err <- readProcessWithExitCode compiler args ""
  H.assert (H.eq code ExitSuccess && H.null err) (H.show ((,,,) args code out err))
  return out
reject compiler args reason = do
  (,,) code out err <- readProcessWithExitCode compiler args ""
  H.assert (H.notEqual code ExitSuccess && H.null out && H.contains reason err) (H.show ((,,,) args code out err))

writeSpec directory identity entry mode sources dependencies prefix = do
  O.mkdir (O.parent prefix)
  let fields = (:) "MLF-CRATE-1" ((:) identity ((:) entry
        ((:) (case mode of {ImplicitPrelude -> "false"; NoImplicitPrelude -> "true"})
        ((:) (Framing.pack (S.map Framing.pairEncoding sources))
        ((:) (Framing.pack dependencies) ((:) (prefix ++ ".queries-cache") ((:) (directory ++ "/builtin/unit") [])))))))
  let file = prefix ++ ".spec"
  writeFile file (Framing.pack fields)
  return file
compileSpec compiler file prefix = do
  _ <- command compiler ((:) "--compile-crate" ((:) file ((:) "-o" ((:) prefix []))))
  return ()
runTarget backends expected text = do
  term <- H.right (XP.parseTerm "<crate CLI>" text)
  observed <- execute backends IOEntry (Input "" false) term
  H.right (outcome observed)
  H.assert (H.eq (output observed) expected) (H.show observed)

cliProgram : B.Backends -> Quint String PreludeMode ([] ((,) String String)) String String -> IO ()
cliProgram backends (Quint _ mode libraries source expected) = withScratch (\directory -> do
  compiler <- selectedCompiler
  root <- H.right (parseModule "Main.emlf" source)
  graph <- H.right (loadModuleMap (M.fromList (S.map (\((,) n text) -> (,) n ((,) (n ++ ".emlf") text)) libraries)) root)
  let originals = M.insert "Main" source (M.fromList libraries)
  paths <- S.mapM (\m -> do
    let name = moduleIdentity m
    let path = directory ++ "/sources/" ++ H.stringMap (\c -> if c == 46 then 47 else c) name ++ ".emlf"
    text <- S.maybe (H.fail ("fixture missing " ++ name)) return (M.lookup name originals)
    O.mkdir (O.parent path)
    writeFile path text
    return ((,) name path)) graph
  let prefix = directory ++ "/main"
  spec <- writeSpec directory fixtureIdentity "Main" mode paths [] prefix
  compileSpec compiler spec prefix
  iface <- bind (readFile (prefix ++ ".mlfci")) (S.compose H.right Artifact.decodeInterface)
  _ <- bind (readFile (prefix ++ ".mlfco")) (S.compose H.right (Artifact.decodeObject iface))
  S.mapM_ (\((,) _ path) -> removeFile path) paths
  target <- command compiler ((:) "--link-crate" ((:) (prefix ++ ".mlfci") []))
  runTarget backends expected target)

cliTests : B.Backends -> IO ()
cliTests backends = withScratch (\directory -> do
  compiler <- selectedCompiler
  let source = directory ++ "/Library.emlf"
  let entry = directory ++ "/Main.emlf"
  let prefix = directory ++ "/compiled libraries/Library"
  let mainPrefix = directory ++ "/Main"
  let librarySource value = "module Library (Box(..), identity, answer) where\ndata Box a = Box a\nidentity x = x\nanswer = " ++ value ++ "\n"
  librarySpec <- writeSpec directory "fixture:library" "" ImplicitPrelude ((:) ((,) "Library" source) []) [] prefix
  let buildLibrary value = do
        writeFile source (librarySource value)
        compileSpec compiler librarySpec prefix
        removeFile source
  let entrySource = "module Main where\nimport Library\nmain = case identity (Box answer) of { Box n -> printInt n }\n"
  mainSpec <- writeSpec directory "fixture:application" "Main" ImplicitPrelude ((:) ((,) "Main" entry) []) ((:) (prefix ++ ".mlfci") []) mainPrefix
  let compileMain = do
        writeFile entry entrySource
        compileSpec compiler mainSpec mainPrefix
        removeFile entry
  let link = command compiler ((:) "--link-crate" ((:) (mainPrefix ++ ".mlfci") []))
  buildLibrary "42"
  originalInterface <- readFile (prefix ++ ".mlfci")
  originalObject <- readFile (prefix ++ ".mlfco")
  _ <- H.right (Artifact.decodeInterface originalInterface)
  seq (stringLength originalObject) (return ())
  -- Downstream inference consumes generated metadata with both upstream source
  -- and implementation absent. Linking still requires the checked object.
  renameFile (prefix ++ ".mlfco") (prefix ++ ".saved")
  compileMain
  reject compiler ((:) "--link-crate" ((:) (mainPrefix ++ ".mlfci") [])) ".mlfco"
  renameFile (prefix ++ ".saved") (prefix ++ ".mlfco")
  target <- link
  runTarget backends "42\n" target
  direct <- command compiler ((:) "--crate-to-llvm" ((:) (mainPrefix ++ ".mlfci") []))
  -- The target-input command receives stdin explicitly through the process
  -- adapter, since ordinary crate commands have no source stdin.
  (,,) llvmCode serializedLLVM llvmErrors <- readProcessWithExitCode compiler ((:) "--xmlf-to-llvm" []) target
  H.assert (H.eq llvmCode ExitSuccess && H.null llvmErrors && H.eq direct serializedLLVM) "crate LLVM emission differs from checked target emission"
  buildLibrary "43"
  changed <- link
  runTarget backends "43\n" changed
  compileMain
  report <- J.read (mainPrefix ++ ".queries")
  let groups = J.values (J.get "groups" report)
  H.assert (J.equal (J.get "inferred_groups" report) (J.num 0) && S.not (S.null groups) && S.all (J.getBool "cached" false) groups) "unchanged upstream semantic schemes invalidated downstream inference"
  buildLibrary "\"changed type\""
  reject compiler ((:) "--link-crate" ((:) (mainPrefix ++ ".mlfci") [])) "stale crate dependency interface"
  writeFile (prefix ++ ".mlfci") originalInterface
  writeFile (prefix ++ ".mlfco") (originalObject ++ "corrupt")
  reject compiler ((:) "--link-crate" ((:) (mainPrefix ++ ".mlfci") [])) "malformed crate object framing"
  writeFile (prefix ++ ".mlfco") originalObject
  writeFile (prefix ++ ".mlfci") "7:MLFCI-9"
  reject compiler ((:) "--link-crate" ((:) (mainPrefix ++ ".mlfci") [])) "unsupported"
  writeFile (prefix ++ ".mlfci") originalInterface
  restored <- link
  runTarget backends "42\n" restored)
