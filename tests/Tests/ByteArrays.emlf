module Tests.ByteArrays where
import Bootstrap.Types
import qualified Bootstrap.Std as S
import qualified Package.OS as OS
import qualified Tests.Helpers as H
import Tests.Helpers (Quint(..), Sext(..))
import qualified Tests.Bytes as BS
import qualified Tests.Char8 as ASCII
import Tests.Backends
import qualified Tests.Backends as B
import Bootstrap.Compiler (compile, compiledTerm)
import Bootstrap.LLVM (emitLLVMIO)
import qualified Bootstrap.Primitive as P
import qualified Bootstrap.X.Parser as XP
import Bootstrap.X.Pretty (prettyTerm)
import qualified Bootstrap.X.Syntax as X
import qualified Bootstrap.X.Type as T
import qualified Tests.Bytes as Bytes

checked : String -> IO XTerm
checked source = do { term <- (H.fmap compiledTerm (H.right (compile "<byte-array test>" source))); do { parsed <- (H.right (XP.parseTerm "<byte-array xMLF>" (prettyTerm term))); do { (S.unless (H.eq (X.erase term) (X.erase parsed)) (H.fail "byte-array round trip changed erasure")); (return parsed) } } }

byteArrayTests : B.Backends -> (List ( (Pair (String) (IO Unit)) ))
byteArrayTests backends = (H.append (S.concatMap (\(Triple label source expected) -> (Cons (Pair (H.append "bytes: " label) do { term <- (checked source); do { result <- (B.execute backends IOEntry (Input "" false) term); do { (H.right (B.outcome result)); (S.unless (H.eq (B.outputBytes result) expected) (H.fail (H.show result))) } } }) Nil)) programs) (H.append (S.concatMap (\(Triple label source message) -> (Cons (Pair (H.append "byte failure: " label) do { term <- (checked (H.append "do { putStrLn \"before\"; " (H.append source " }"))); do { result <- (B.execute backends IOEntry (Input "" false) term); (let guardSubject1 = (B.outcome result) in (let guardNext3 = \ignored -> (let guardNext2 = \ignored -> (panic "non-exhaustive test case") in (case guardSubject1 of { _ -> (H.fail (H.show result)) })) in (case guardSubject1 of { (Left err) -> (if ((H.contains message (H.show err)) && (H.eq (B.output result) "before\n")) then (return Unit) else (guardNext3 Unit)); _ -> (guardNext3 Unit) }))) } }) Nil)) failures) (Cons (Pair "bytes: native loop emits every byte without Unicode conversion" do { term <- (checked (H.append recursion (H.append "let fill : ByteArray -> Int -> IO Unit = fix (\\again a i -> " (H.append "ifThenElse (ltInt i 256) (do { writeByteArray a i i; again a (addInt i 1) }) (return ())) in " "do { a <- newByteArray 256 0; fill a 0; putBytes a 0 256 }")))); do { llvm <- (H.right (emitLLVMIO term)); do { (S.unless ((H.contains "define private ptr @mlf.numeric." llvm) && (H.contains "store i8" llvm)) (H.fail "byte loop did not use native byte storage")); do { result <- (B.execute backends IOEntry (Input "" false) term); do { (H.right (B.outcome result)); (S.unless (H.eq (B.outputBytes result) (BS.pack (S.range 0 255))) (H.fail (H.show result))) } } } } }) (Cons (Pair "bytes: bulk copy preserves offsets, empty ranges and forward overlap" (let { copy = (H.append recursion (H.append "let move : ByteArray -> ByteArray -> Int -> Int -> Int -> IO Unit = " (H.append "fix (\\again source dest end offset index -> ifThenElse (ltInt index end) " (H.append "(do { b <- readByteArray source index; writeByteArray dest (addInt offset index) b; " "again source dest end offset (addInt index 1) }) (return ())) in ")))) } in (let { cases = (Cons (Quint false 6 2 1 "012bcdef89") (Cons (Quint true 5 1 0 "aaaaaa") (Cons (Quint true 6 0 0 "abcdef") (Cons (Quint true 6 (0 - 2) 2 "cdefef") (Cons (Quint false 2 (H.power 2 100) 99 "0123456789") (Cons (Quint false 0 0 0 "0123456789") Nil)))))) } in ((H.forM_ cases) (\(Quint alias end offset start expected) -> do { term <- (checked (H.append copy (H.append "do { a <- byteArrayFromString \"abcdef\"; b <- " (H.append (if alias then "return a" else "byteArrayFromString \"0123456789\"") (H.append "; move a b " (H.append (H.show end) (H.append " (" (H.append (H.show offset) (H.append ") (" (H.append (H.show start) "); move a b 0 0 0; n <- lengthByteArray b; putBytes b 0 n }")))))))))); do { llvm <- (H.right (emitLLVMIO term)); do { (S.unless (H.contains "call void @llvm.memmove" llvm) (H.fail "copy idiom was not exercised")); do { result <- (B.execute backends IOEntry (Input "" false) term); do { (H.right (B.outcome result)); (S.unless (H.eq (B.output result) expected) (H.fail (H.show result))) } } } } }))))) (Cons (Pair "bytes: bulk copy fallback retains bounds failures" ((H.forM_ (Cons (Triple 7 0 0) (Cons (Triple 3 5 0) (Cons (Triple 3 0 (0 - 1)) (Cons (Triple (H.power 2 100) 0 0) Nil))))) (\(Triple end offset start) -> do { term <- (checked (H.append recursion (H.append "let move : ByteArray -> ByteArray -> Int -> Int -> Int -> IO Unit = " (H.append "fix (\\again source dest end offset index -> ifThenElse (ltInt index end) " (H.append "(do { b <- readByteArray source index; writeByteArray dest (addInt offset index) b; " (H.append "again source dest end offset (addInt index 1) }) (return ())) in " (H.append "do { a <- byteArrayFromString \"abcdef\"; move a a 0 0 0; putStrLn \"before\"; " (H.append "move a a " (H.append (H.show end) (H.append " (" (H.append (H.show offset) (H.append ") (" (H.append (H.show start) ") }"))))))))))))); do { result <- (B.execute backends IOEntry (Input "" false) term); (let guardSubject13 = (B.outcome result) in (let guardNext15 = \ignored -> (let guardNext14 = \ignored -> (panic "non-exhaustive test case") in (case guardSubject13 of { _ -> (H.fail (H.show result)) })) in (case guardSubject13 of { (Left err) -> (if ((H.contains "array index out of bounds" (H.show err)) && (H.eq (B.output result) "before\n")) then (return Unit) else (guardNext15 Unit)); _ -> (guardNext15 Unit) }))) } }))) (Cons (Pair "bytes: native stores check bounds before byte range" ((H.forM_ (Cons (Triple 0 256 "byte value must be between 0 and 255") (Cons (Triple 0 (0 - 1) "byte value must be between 0 and 255") (Cons (Triple 0 4611686018427387904 "byte value must be between 0 and 255") (Cons (Triple 0 (0 - 4611686018427387905) "byte value must be between 0 and 255") (Cons (Triple 1 256 "array index out of bounds") (Cons (Triple 2147483647 256 "array index out of bounds") (Cons (Triple 2147483648 256 "array index out of bounds") (Cons (Triple 4611686018427387904 256 "array index out of bounds") Nil))))))))) (\(Triple index value message) -> do { term <- (checked (H.append recursion (H.append "let write : ByteArray -> Int -> Int -> Int -> IO Unit = " (H.append "fix (\\again a i x n -> ifThenElse (eqInt n 0) (return ()) " (H.append "(do { writeByteArray a i x; again a i x (subInt n 1) })) in " (H.append "do { a <- newByteArray 1 0; putStrLn \"before\"; write a " (H.append (H.show index) (H.append " (" (H.append (H.show value) ") 1 }"))))))))); do { llvm <- (H.right (emitLLVMIO term)); do { (S.unless ((H.contains "define private ptr @mlf.numeric." llvm) && (H.contains "store i8" llvm)) (H.fail "byte failure did not exercise native storage")); do { result <- (B.execute backends IOEntry (Input "" false) term); (let guardSubject10 = (B.outcome result) in (let guardNext12 = \ignored -> (let guardNext11 = \ignored -> (panic "non-exhaustive test case") in (case guardSubject10 of { _ -> (H.fail (H.show result)) })) in (case guardSubject10 of { (Left err) -> (if ((H.contains message (H.show err)) && (H.eq (B.output result) "before\n")) then (return Unit) else (guardNext12 Unit)); _ -> (guardNext12 Unit) }))) } } } }))) (Cons (Pair "bytes: write failures stop continuation and preserve raw output" do { term <- (checked "do { a <- newByteArray 2 255; putBytes a 0 2; getLine; return () }"); do { result <- (B.execute backends IOEntry (Input "unused\n" true) term); (let guardSubject7 = (B.outcome result) in (let guardNext9 = \ignored -> (let guardNext8 = \ignored -> (panic "non-exhaustive test case") in (case guardSubject7 of { _ -> (H.fail (H.show result)) })) in (case guardSubject7 of { (Left err) -> (if ((H.eq (H.show err) "IO error: write failed") && ((H.eq (B.outputBytes result) (BS.pack (Cons 255 (Cons 255 Nil)))) && (H.eq (B.remaining result) "unused\n"))) then (return Unit) else (guardNext9 Unit)); _ -> (guardNext9 Unit) }))) } }) (Cons (Pair "bytes: nominal types reject invalid operations" ((H.forM_ (Cons "data ByteArray = Forged; Forged" (Cons "newByteArray 1 1.0" (Cons "do { a <- newIntArray 1 0; readByteArray a 0 }" (Cons "do { a <- newByteArray 1 0; writeByteArray a 0 true }" (Cons "putBytes \"text\" 0 1" (Cons "byteArrayFromString 42" (Cons "do { a <- newByteArray 1 0; printInt (readByteArray a 0) }" Nil)))))))) (\source -> (case (compile "<invalid bytes>" source) of { (Left _) -> (return Unit); (Right _) -> (H.fail (H.append "accepted " source)) })))) (Cons (Pair "bytes: forged surrogate is rejected before encoding by both backends" (let { term = (XApp (XPrimitive PIOReturn (Cons (XCon "String" Nil) Nil)) (XStringTerm "")) } in do { let source = OS.replace "\"\"" "\"\\55296\"" (prettyTerm term); result <- (B.executeSerialized backends IOEntry (Input "" false) source); (let guardSubject4 = (B.outcome result) in (let guardNext6 = \ignored -> (let guardNext5 = \ignored -> (panic "non-exhaustive test case") in (case guardSubject4 of { _ -> (H.fail (H.show result)) })) in (case guardSubject4 of { (Left err) -> (if ((H.contains "invalid Unicode scalar" (H.show err)) && (H.null (B.events result))) then (return Unit) else (guardNext6 Unit)); _ -> (guardNext6 Unit) }))) })) (Cons (Pair "numeric region: integer-to-Double conversion preserves rounding" do { term <- (checked (H.append recursion (H.append "let convert : IntArray -> DoubleArray -> Int -> IO Unit = fix (\\again a b n -> " (H.append "ifThenElse (eqInt n 0) (return ()) (do { x <- readIntArray a 0; " (H.append "writeDoubleArray b 0 (intToDouble x); again a b (subInt n 1) })) in " (H.append "do { a <- newIntArray 1 9007199254740995; b <- newDoubleArray 1 0.0; convert a b 1; " (H.append "x <- readDoubleArray b 0; putStrLn (formatDouble 0 x); " (H.append "writeIntArray a 0 (-4611686018427388672); convert a b 1; y <- readDoubleArray b 0; " (H.append "putStrLn (formatDouble 0 y); writeIntArray a 0 " (H.append (H.show (H.power 10 400)) "; convert a b 1; z <- readDoubleArray b 0; putStrLn (formatDouble 0 z) }")))))))))); do { llvm <- (H.right (emitLLVMIO term)); do { (S.unless (H.contains "sitofp i64" llvm) (H.fail "conversion did not enter native numeric code")); do { result <- (B.execute backends IOEntry (Input "" false) term); do { (H.right (B.outcome result)); (S.unless (H.eq (B.output result) "9007199254740996\n-4611686018427388928\nInfinity\n") (H.fail (H.show result))) } } } } }) (Cons (Pair "bytes: fasta empty, single-base and upstream fixture" do { term <- (bind (readFile "benchmarks/fasta/mlf/main.emlf") checked); do { fixture <- (BS.readFile "benchmarks/fasta/expected-1000.txt"); ((H.forM_ (Cons (Pair 0 (ASCII.pack ">ONE Homo sapiens alu\n>TWO IUB ambiguity codes\n>THREE Homo sapiens frequency\n")) (Cons (Pair 1 (ASCII.pack ">ONE Homo sapiens alu\nGG\n>TWO IUB ambiguity codes\nctt\n>THREE Homo sapiens frequency\ntgagc\n")) (Cons (Pair 1000 fixture) Nil)))) (\(Pair n expected) -> do { result <- (B.execute backends IOEntry (Input (H.append (H.show n) "\n") false) term); do { (H.right (B.outcome result)); (S.unless ((H.eq (B.outputBytes result) expected) && (H.null (B.remaining result))) (H.fail (H.show result))) } })) } }) (Cons (Pair "bytes: mandelbrot packed pixels, partial rows and upstream fixture" do { term <- (bind (readFile "benchmarks/mandelbrot/mlf/main.emlf") checked); do { fixture <- (BS.readFile "benchmarks/mandelbrot/expected-200.pbm"); (let { small = (Cons (Pair 1 (Cons 0 Nil)) (Cons (Pair 2 (Cons 0 (Cons 192 Nil))) (Cons (Pair 7 (Cons 0 (Cons 4 (Cons 30 (Cons 126 (Cons 126 (Cons 30 (Cons 4 Nil)))))))) (Cons (Pair 8 (Cons 2 (Cons 0 (Cons 15 (Cons 47 (Cons 255 (Cons 47 (Cons 15 (Cons 0 Nil))))))))) (Cons (Pair 9 (Cons 0 (Cons 0 (Cons 2 (Cons 0 (Cons 7 (Cons 128 (Cons 15 (Cons 128 (Cons 63 (Cons 128 (Cons 63 (Cons 128 (Cons 15 (Cons 128 (Cons 7 (Cons 128 (Cons 2 (Cons 0 Nil))))))))))))))))))) Nil))))) } in (let { samples = (H.append (S.concatMap (\(Pair n pixels) -> (Cons (Pair n (H.append (ASCII.pack (H.append "P4\n" (H.append (H.show n) (H.append " " (H.append (H.show n) "\n"))))) (BS.pack pixels))) Nil)) small) (Cons (Pair 200 fixture) Nil)) } in ((H.forM_ samples) (\(Pair n expected) -> do { result <- (B.execute backends IOEntry (Input (H.append (H.show n) "\n") false) term); do { (H.right (B.outcome result)); (S.unless ((H.eq (B.outputBytes result) expected) && (H.null (B.remaining result))) (H.fail (H.show result))) } })))) } }) Nil))))))))))))

programs : (List ( (Triple (String) (String) (Bytes.Bytes)) ))
programs = (Cons (Triple "raw high bytes, NUL and text retain order" (H.append "do { a <- newByteArray 4 0; writeByteArray a 1 127; writeByteArray a 2 128; writeByteArray a 3 255; " "putStr \"A\"; putBytes a 0 4; putStrLn \"Z\" }") (BS.pack (Cons 65 (Cons 0 (Cons 127 (Cons 128 (Cons 255 (Cons 90 (Cons 10 Nil))))))))) (Cons (Triple "UTF-8 source strings produce byte lengths and fresh mutable buffers" (H.append "let new = byteArrayFromString \"λ😀\\0\" in do { a <- new; b <- new; n <- lengthByteArray a; " "printInt n; writeByteArray a 0 65; putBytes b 0 n; putBytes a 0 1 }") (BS.pack (Cons 55 (Cons 10 (Cons 206 (Cons 187 (Cons 240 (Cons 159 (Cons 152 (Cons 128 (Cons 0 (Cons 65 Nil)))))))))))) (Cons (Triple "shared reads are snapshots and shared outputs read current contents" (H.append "do { a <- newByteArray 2 65; let read = readByteArray a 0; let write = putBytes a 0 2; " "x <- read; write; writeByteArray a 0 255; y <- read; write; printInt x; printInt y }") (H.append (BS.pack (Cons 65 (Cons 65 (Cons 255 (Cons 65 Nil))))) (ASCII.pack "65\n255\n"))) (Cons (Triple "generic primitive applications preserve slicing" (H.append "do { new <- return newByteArray; write <- return writeByteArray; read <- return readByteArray; " (H.append "len <- return lengthByteArray; from <- return byteArrayFromString; put <- return putBytes; " (H.append "a <- new 3 65; write a 1 255; x <- read a 1; n <- len a; b <- from \"BC\"; " "put a 1 2; put b 0 2; printInt x; printInt n }"))) (H.append (BS.pack (Cons 255 (Cons 65 (Cons 66 (Cons 67 Nil))))) (ASCII.pack "255\n3\n"))) (Cons (Triple "empty slices and unused failing actions remain lazy" (H.append "do { a <- newByteArray 0 0; putBytes a 0 0; let bad = putBytes a (-1) (quotInt 1 0); " "return bad; b <- byteArrayFromString \"ab\"; putBytes b 2 0; putBytes b 1 1 }") (ASCII.pack "b")) (Cons (Triple "byte buffers and pending slices survive collection" (H.append recursion (H.append "let churn : Int -> IO Unit = fix (\\again n -> ifThenElse (eqInt n 0) (return ()) " (H.append "(do { ignored <- newByteArray 100 255; again (subInt n 1) })) in " "do { a <- byteArrayFromString \"retained\"; let action = putBytes a 0 8; churn 300; action }"))) (ASCII.pack "retained")) Nil))))))

failures : (List ( (Triple (String) (String) (String)) ))
failures = (Cons (Triple "negative length" "newByteArray (-1) 0" "invalid array length") (Cons (Triple "huge length" "newByteArray 999999999999999999999 0" "invalid array length") (Cons (Triple "negative initial value" "newByteArray 1 (-1)" "byte value must be between 0 and 255") (Cons (Triple "initial value outside byte" "newByteArray 0 256" "byte value must be between 0 and 255") (Cons (Triple "huge write value" "do { a <- newByteArray 1 0; writeByteArray a 0 999999999999999999999 }" "byte value must be between 0 and 255") (Cons (Triple "negative write value" "do { a <- newByteArray 1 0; writeByteArray a 0 (-1) }" "byte value must be between 0 and 255") (Cons (Triple "negative read" "do { a <- newByteArray 1 0; readByteArray a (-1) }" "array index out of bounds") (Cons (Triple "GMP index" "do { a <- newByteArray 1 0; readByteArray a 4611686018427387904 }" "array index out of bounds") (Cons (Triple "write checks bounds before value" "do { a <- newByteArray 1 0; writeByteArray a 1 (quotInt 1 0) }" "array index out of bounds") (Cons (Triple "empty array still demands index" "do { a <- newByteArray 0 0; readByteArray a (quotInt 1 0) }" "integer division by zero") (Cons (Triple "negative slice" "do { a <- newByteArray 1 0; putBytes a (-1) 0 }" "byte slice out of bounds") (Cons (Triple "negative count" "do { a <- newByteArray 1 0; putBytes a 0 (-1) }" "byte slice out of bounds") (Cons (Triple "slice past end" "do { a <- newByteArray 2 0; putBytes a 1 2 }" "byte slice out of bounds") (Cons (Triple "huge count" "do { a <- newByteArray 2 0; putBytes a 0 999999999999999999999 }" "byte slice out of bounds") (Cons (Triple "offset checked before count" "do { a <- newByteArray 1 0; putBytes a 2 (quotInt 1 0) }" "byte slice out of bounds") (Cons (Triple "write demands value" "do { a <- newByteArray 1 0; writeByteArray a 0 (quotInt 1 0) }" "integer division by zero") Nil))))))))))))))))

recursion : String
recursion = (H.append "data Rec a = Rec (Rec a -> a); let fix : forall a. (a -> a) -> a = \\f -> " "let go = \\r -> case r of { Rec next -> f (next r) } in go (Rec go) in ")
