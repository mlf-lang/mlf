checked : String -> IO XTerm
checked source = do { term <- (H.fmap compiledTerm (H.right (compile "<byte-array test>" source))); do { parsed <- (H.right (XP.parseTerm "<byte-array xMLF>" (prettyTerm term))); do { (S.unless (H.eq (X.erase term) (X.erase parsed)) (H.fail "byte-array round trip changed erasure")); (return parsed) } } }

byteArrayTests : B.Backends -> ([] ( ((,) (String) (IO ())) ))
byteArrayTests backends = (H.append (S.concatMap (\((,,) label source expected) -> ((:) ((,) (H.append "bytes: " label) do { term <- (checked source); do { result <- (B.execute backends IOEntry (Input "" false) term); do { (H.right (B.outcome result)); (S.unless (H.eq (B.outputBytes result) expected) (H.fail (H.show result))) } } }) [])) programs) (H.append (S.concatMap (\((,,) label source message) -> ((:) ((,) (H.append "byte failure: " label) do { term <- (checked (H.append "do { putStrLn \"before\"; " (H.append source " }"))); do { result <- (B.execute backends IOEntry (Input "" false) term); (let guardSubject1 = (B.outcome result) in (let guardNext3 = \ignored -> (let guardNext2 = \ignored -> (panic "non-exhaustive test case") in (case guardSubject1 of { _ -> (H.fail (H.show result)) })) in (case guardSubject1 of { (Left err) -> (if ((H.contains message (H.show err)) && (H.eq (B.output result) "before\n")) then (return ()) else (guardNext3 ())); _ -> (guardNext3 ()) }))) } }) [])) failures) ((:) ((,) "bytes: native loop emits every byte without Unicode conversion" do { term <- (checked (H.append recursion (H.append "let fill : ByteArray -> Int -> IO Unit = fix (\\again a i -> " (H.append "ifThenElse (ltInt i 256) (do { writeByteArray a i i; again a (addInt i 1) }) (return ())) in " "do { a <- newByteArray 256 0; fill a 0; putBytes a 0 256 }")))); do { llvm <- (H.right (emitLLVMIO term)); do { (S.unless ((H.contains "define private ptr @mlf.numeric." llvm) && (H.contains "store i8" llvm)) (H.fail "byte loop did not use native byte storage")); do { result <- (B.execute backends IOEntry (Input "" false) term); do { (H.right (B.outcome result)); (S.unless (H.eq (B.outputBytes result) (BS.pack (S.range 0 255))) (H.fail (H.show result))) } } } } }) ((:) ((,) "bytes: bulk copy preserves offsets, empty ranges and forward overlap" (let { copy = (H.append recursion (H.append "let move : ByteArray -> ByteArray -> Int -> Int -> Int -> IO Unit = " (H.append "fix (\\again source dest end offset index -> ifThenElse (ltInt index end) " (H.append "(do { b <- readByteArray source index; writeByteArray dest (addInt offset index) b; " "again source dest end offset (addInt index 1) }) (return ())) in ")))) } in (let { cases = ((:) (Quint false 6 2 1 "012bcdef89") ((:) (Quint true 5 1 0 "aaaaaa") ((:) (Quint true 6 0 0 "abcdef") ((:) (Quint true 6 (0 - 2) 2 "cdefef") ((:) (Quint false 2 (H.power 2 100) 99 "0123456789") ((:) (Quint false 0 0 0 "0123456789") [])))))) } in ((H.forM_ cases) (\(Quint alias end offset start expected) -> do { term <- (checked (H.append copy (H.append "do { a <- byteArrayFromString \"abcdef\"; b <- " (H.append (if alias then "return a" else "byteArrayFromString \"0123456789\"") (H.append "; move a b " (H.append (H.show end) (H.append " (" (H.append (H.show offset) (H.append ") (" (H.append (H.show start) "); move a b 0 0 0; n <- lengthByteArray b; putBytes b 0 n }")))))))))); do { llvm <- (H.right (emitLLVMIO term)); do { (S.unless (H.contains "call void @llvm.memmove" llvm) (H.fail "copy idiom was not exercised")); do { result <- (B.execute backends IOEntry (Input "" false) term); do { (H.right (B.outcome result)); (S.unless (H.eq (B.output result) expected) (H.fail (H.show result))) } } } } }))))) ((:) ((,) "bytes: bulk copy fallback retains bounds failures" ((H.forM_ ((:) ((,,) 7 0 0) ((:) ((,,) 3 5 0) ((:) ((,,) 3 0 (0 - 1)) ((:) ((,,) (H.power 2 100) 0 0) []))))) (\((,,) end offset start) -> do { term <- (checked (H.append recursion (H.append "let move : ByteArray -> ByteArray -> Int -> Int -> Int -> IO Unit = " (H.append "fix (\\again source dest end offset index -> ifThenElse (ltInt index end) " (H.append "(do { b <- readByteArray source index; writeByteArray dest (addInt offset index) b; " (H.append "again source dest end offset (addInt index 1) }) (return ())) in " (H.append "do { a <- byteArrayFromString \"abcdef\"; move a a 0 0 0; putStrLn \"before\"; " (H.append "move a a " (H.append (H.show end) (H.append " (" (H.append (H.show offset) (H.append ") (" (H.append (H.show start) ") }"))))))))))))); do { result <- (B.execute backends IOEntry (Input "" false) term); (let guardSubject13 = (B.outcome result) in (let guardNext15 = \ignored -> (let guardNext14 = \ignored -> (panic "non-exhaustive test case") in (case guardSubject13 of { _ -> (H.fail (H.show result)) })) in (case guardSubject13 of { (Left err) -> (if ((H.contains "array index out of bounds" (H.show err)) && (H.eq (B.output result) "before\n")) then (return ()) else (guardNext15 ())); _ -> (guardNext15 ()) }))) } }))) ((:) ((,) "bytes: native stores check bounds before byte range" ((H.forM_ ((:) ((,,) 0 256 "byte value must be between 0 and 255") ((:) ((,,) 0 (0 - 1) "byte value must be between 0 and 255") ((:) ((,,) 0 4611686018427387904 "byte value must be between 0 and 255") ((:) ((,,) 0 (0 - 4611686018427387905) "byte value must be between 0 and 255") ((:) ((,,) 1 256 "array index out of bounds") ((:) ((,,) 2147483647 256 "array index out of bounds") ((:) ((,,) 2147483648 256 "array index out of bounds") ((:) ((,,) 4611686018427387904 256 "array index out of bounds") []))))))))) (\((,,) index value message) -> do { term <- (checked (H.append recursion (H.append "let write : ByteArray -> Int -> Int -> Int -> IO Unit = " (H.append "fix (\\again a i x n -> ifThenElse (eqInt n 0) (return ()) " (H.append "(do { writeByteArray a i x; again a i x (subInt n 1) })) in " (H.append "do { a <- newByteArray 1 0; putStrLn \"before\"; write a " (H.append (H.show index) (H.append " (" (H.append (H.show value) ") 1 }"))))))))); do { llvm <- (H.right (emitLLVMIO term)); do { (S.unless ((H.contains "define private ptr @mlf.numeric." llvm) && (H.contains "store i8" llvm)) (H.fail "byte failure did not exercise native storage")); do { result <- (B.execute backends IOEntry (Input "" false) term); (let guardSubject10 = (B.outcome result) in (let guardNext12 = \ignored -> (let guardNext11 = \ignored -> (panic "non-exhaustive test case") in (case guardSubject10 of { _ -> (H.fail (H.show result)) })) in (case guardSubject10 of { (Left err) -> (if ((H.contains message (H.show err)) && (H.eq (B.output result) "before\n")) then (return ()) else (guardNext12 ())); _ -> (guardNext12 ()) }))) } } } }))) ((:) ((,) "bytes: write failures stop continuation and preserve raw output" do { term <- (checked "do { a <- newByteArray 2 255; putBytes a 0 2; getLine; return () }"); do { result <- (B.execute backends IOEntry (Input "unused\n" true) term); (let guardSubject7 = (B.outcome result) in (let guardNext9 = \ignored -> (let guardNext8 = \ignored -> (panic "non-exhaustive test case") in (case guardSubject7 of { _ -> (H.fail (H.show result)) })) in (case guardSubject7 of { (Left err) -> (if ((H.eq (H.show err) "IO error: write failed") && ((H.eq (B.outputBytes result) (BS.pack ((:) 255 ((:) 255 [])))) && (H.eq (B.remaining result) "unused\n"))) then (return ()) else (guardNext9 ())); _ -> (guardNext9 ()) }))) } }) ((:) ((,) "bytes: nominal types reject invalid operations" ((H.forM_ ((:) "data ByteArray = Forged; Forged" ((:) "newByteArray 1 1.0" ((:) "do { a <- newIntArray 1 0; readByteArray a 0 }" ((:) "do { a <- newByteArray 1 0; writeByteArray a 0 true }" ((:) "putBytes \"text\" 0 1" ((:) "byteArrayFromString 42" ((:) "do { a <- newByteArray 1 0; printInt (readByteArray a 0) }" [])))))))) (\source -> (case (compile "<invalid bytes>" source) of { (Left _) -> (return ()); (Right _) -> (H.fail (H.append "accepted " source)) })))) ((:) ((,) "bytes: forged surrogate is rejected before encoding by both backends" (let { term = (XApp (XPrimitive PIOReturn ((:) (XCon "String" []) [])) (XStringTerm "")) } in do { let source = OS.replace "\"\"" "\"\\55296\"" (prettyTerm term); result <- (B.executeSerialized backends IOEntry (Input "" false) source); (let guardSubject4 = (B.outcome result) in (let guardNext6 = \ignored -> (let guardNext5 = \ignored -> (panic "non-exhaustive test case") in (case guardSubject4 of { _ -> (H.fail (H.show result)) })) in (case guardSubject4 of { (Left err) -> (if ((H.contains "invalid Unicode scalar" (H.show err)) && (H.null (B.events result))) then (return ()) else (guardNext6 ())); _ -> (guardNext6 ()) }))) })) ((:) ((,) "numeric region: integer-to-Double conversion preserves rounding" do { term <- (checked (H.append recursion (H.append "let convert : IntArray -> DoubleArray -> Int -> IO Unit = fix (\\again a b n -> " (H.append "ifThenElse (eqInt n 0) (return ()) (do { x <- readIntArray a 0; " (H.append "writeDoubleArray b 0 (intToDouble x); again a b (subInt n 1) })) in " (H.append "do { a <- newIntArray 1 9007199254740995; b <- newDoubleArray 1 0.0; convert a b 1; " (H.append "x <- readDoubleArray b 0; putStrLn (formatDouble 0 x); " (H.append "writeIntArray a 0 (-4611686018427388672); convert a b 1; y <- readDoubleArray b 0; " (H.append "putStrLn (formatDouble 0 y); writeIntArray a 0 " (H.append (H.show (H.power 10 400)) "; convert a b 1; z <- readDoubleArray b 0; putStrLn (formatDouble 0 z) }")))))))))); do { llvm <- (H.right (emitLLVMIO term)); do { (S.unless (H.contains "sitofp i64" llvm) (H.fail "conversion did not enter native numeric code")); do { result <- (B.execute backends IOEntry (Input "" false) term); do { (H.right (B.outcome result)); (S.unless (H.eq (B.output result) "9007199254740996\n-4611686018427388928\nInfinity\n") (H.fail (H.show result))) } } } } }) ((:) ((,) "bytes: fasta empty, single-base and upstream fixture" do { term <- (bind (readFile "benchmarks/fasta/mlf/main.emlf") checked); do { fixture <- (BS.readFile "benchmarks/fasta/expected-1000.txt"); ((H.forM_ ((:) ((,) 0 (ASCII.pack ">ONE Homo sapiens alu\n>TWO IUB ambiguity codes\n>THREE Homo sapiens frequency\n")) ((:) ((,) 1 (ASCII.pack ">ONE Homo sapiens alu\nGG\n>TWO IUB ambiguity codes\nctt\n>THREE Homo sapiens frequency\ntgagc\n")) ((:) ((,) 1000 fixture) [])))) (\((,) n expected) -> do { result <- (B.execute backends IOEntry (Input (H.append (H.show n) "\n") false) term); do { (H.right (B.outcome result)); (S.unless ((H.eq (B.outputBytes result) expected) && (H.null (B.remaining result))) (H.fail (H.show result))) } })) } }) ((:) ((,) "bytes: mandelbrot packed pixels, partial rows and upstream fixture" do { term <- (bind (readFile "benchmarks/mandelbrot/mlf/main.emlf") checked); do { fixture <- (BS.readFile "benchmarks/mandelbrot/expected-200.pbm"); (let { small = ((:) ((,) 1 ((:) 0 [])) ((:) ((,) 2 ((:) 0 ((:) 192 []))) ((:) ((,) 7 ((:) 0 ((:) 4 ((:) 30 ((:) 126 ((:) 126 ((:) 30 ((:) 4 [])))))))) ((:) ((,) 8 ((:) 2 ((:) 0 ((:) 15 ((:) 47 ((:) 255 ((:) 47 ((:) 15 ((:) 0 []))))))))) ((:) ((,) 9 ((:) 0 ((:) 0 ((:) 2 ((:) 0 ((:) 7 ((:) 128 ((:) 15 ((:) 128 ((:) 63 ((:) 128 ((:) 63 ((:) 128 ((:) 15 ((:) 128 ((:) 7 ((:) 128 ((:) 2 ((:) 0 []))))))))))))))))))) []))))) } in (let { samples = (H.append (S.concatMap (\((,) n pixels) -> ((:) ((,) n (H.append (ASCII.pack (H.append "P4\n" (H.append (H.show n) (H.append " " (H.append (H.show n) "\n"))))) (BS.pack pixels))) [])) small) ((:) ((,) 200 fixture) [])) } in ((H.forM_ samples) (\((,) n expected) -> do { result <- (B.execute backends IOEntry (Input (H.append (H.show n) "\n") false) term); do { (H.right (B.outcome result)); (S.unless ((H.eq (B.outputBytes result) expected) && (H.null (B.remaining result))) (H.fail (H.show result))) } })))) } }) []))))))))))))

programs : ([] ( ((,,) (String) (String) (Bytes.Bytes)) ))
programs = ((:) ((,,) "raw high bytes, NUL and text retain order" (H.append "do { a <- newByteArray 4 0; writeByteArray a 1 127; writeByteArray a 2 128; writeByteArray a 3 255; " "putStr \"A\"; putBytes a 0 4; putStrLn \"Z\" }") (BS.pack ((:) 65 ((:) 0 ((:) 127 ((:) 128 ((:) 255 ((:) 90 ((:) 10 []))))))))) ((:) ((,,) "UTF-8 source strings produce byte lengths and fresh mutable buffers" (H.append "let new = byteArrayFromString \"λ😀\\0\" in do { a <- new; b <- new; n <- lengthByteArray a; " "printInt n; writeByteArray a 0 65; putBytes b 0 n; putBytes a 0 1 }") (BS.pack ((:) 55 ((:) 10 ((:) 206 ((:) 187 ((:) 240 ((:) 159 ((:) 152 ((:) 128 ((:) 0 ((:) 65 [])))))))))))) ((:) ((,,) "shared reads are snapshots and shared outputs read current contents" (H.append "do { a <- newByteArray 2 65; let read = readByteArray a 0; let write = putBytes a 0 2; " "x <- read; write; writeByteArray a 0 255; y <- read; write; printInt x; printInt y }") (H.append (BS.pack ((:) 65 ((:) 65 ((:) 255 ((:) 65 []))))) (ASCII.pack "65\n255\n"))) ((:) ((,,) "generic primitive applications preserve slicing" (H.append "do { new <- return newByteArray; write <- return writeByteArray; read <- return readByteArray; " (H.append "len <- return lengthByteArray; from <- return byteArrayFromString; put <- return putBytes; " (H.append "a <- new 3 65; write a 1 255; x <- read a 1; n <- len a; b <- from \"BC\"; " "put a 1 2; put b 0 2; printInt x; printInt n }"))) (H.append (BS.pack ((:) 255 ((:) 65 ((:) 66 ((:) 67 []))))) (ASCII.pack "255\n3\n"))) ((:) ((,,) "empty slices and unused failing actions remain lazy" (H.append "do { a <- newByteArray 0 0; putBytes a 0 0; let bad = putBytes a (-1) (quotInt 1 0); " "return bad; b <- byteArrayFromString \"ab\"; putBytes b 2 0; putBytes b 1 1 }") (ASCII.pack "b")) ((:) ((,,) "byte buffers and pending slices survive collection" (H.append recursion (H.append "let churn : Int -> IO Unit = fix (\\again n -> ifThenElse (eqInt n 0) (return ()) " (H.append "(do { ignored <- newByteArray 100 255; again (subInt n 1) })) in " "do { a <- byteArrayFromString \"retained\"; let action = putBytes a 0 8; churn 300; action }"))) (ASCII.pack "retained")) []))))))

failures : ([] ( ((,,) (String) (String) (String)) ))
failures = ((:) ((,,) "negative length" "newByteArray (-1) 0" "invalid array length") ((:) ((,,) "huge length" "newByteArray 9223372036854775807 0" "invalid array length") ((:) ((,,) "negative initial value" "newByteArray 1 (-1)" "byte value must be between 0 and 255") ((:) ((,,) "initial value outside byte" "newByteArray 0 256" "byte value must be between 0 and 255") ((:) ((,,) "huge write value" "do { a <- newByteArray 1 0; writeByteArray a 0 9223372036854775807 }" "byte value must be between 0 and 255") ((:) ((,,) "negative write value" "do { a <- newByteArray 1 0; writeByteArray a 0 (-1) }" "byte value must be between 0 and 255") ((:) ((,,) "negative read" "do { a <- newByteArray 1 0; readByteArray a (-1) }" "array index out of bounds") ((:) ((,,) "GMP index" "do { a <- newByteArray 1 0; readByteArray a 4611686018427387904 }" "array index out of bounds") ((:) ((,,) "write checks bounds before value" "do { a <- newByteArray 1 0; writeByteArray a 1 (quotInt 1 0) }" "array index out of bounds") ((:) ((,,) "empty array still demands index" "do { a <- newByteArray 0 0; readByteArray a (quotInt 1 0) }" "integer division by zero") ((:) ((,,) "negative slice" "do { a <- newByteArray 1 0; putBytes a (-1) 0 }" "byte slice out of bounds") ((:) ((,,) "negative count" "do { a <- newByteArray 1 0; putBytes a 0 (-1) }" "byte slice out of bounds") ((:) ((,,) "slice past end" "do { a <- newByteArray 2 0; putBytes a 1 2 }" "byte slice out of bounds") ((:) ((,,) "huge count" "do { a <- newByteArray 2 0; putBytes a 0 9223372036854775807 }" "byte slice out of bounds") ((:) ((,,) "offset checked before count" "do { a <- newByteArray 1 0; putBytes a 2 (quotInt 1 0) }" "byte slice out of bounds") ((:) ((,,) "write demands value" "do { a <- newByteArray 1 0; writeByteArray a 0 (quotInt 1 0) }" "integer division by zero") []))))))))))))))))

recursion : String
recursion = (H.append "data Rec a = Rec (Rec a -> a); let fix : forall a. (a -> a) -> a = \\f -> " "let go = \\r -> case r of { Rec next -> f (next r) } in go (Rec go) in ")
