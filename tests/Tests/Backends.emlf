module Tests.Backends
 (Backends, Entry(..), Event(..), Input(..), Observation(..), RuntimeError(..),
  withBackends, withExecutionTimeout, withInterpreterTimeout, inCase, auditBackends, execute,
  executeWithArguments, executeSerialized, capture, outcome, events, remaining,
  output, outputBytes, stderrOutput) where
import Bootstrap.Types
import qualified Bootstrap.Std as S
import qualified Bootstrap.Map as M
import qualified Bootstrap.IntSet as IS
import qualified Bootstrap.X.Syntax as X
import qualified Bootstrap.X.Pretty as Pretty
import qualified Tests.Helpers as H
import qualified Tests.Bytes as Bytes
import qualified Package.OS as O
import qualified Package.Json as J

data Entry = IOEntry | ProgramEntry
data Event = ReadLine | Write String | WriteBytes Bytes.Bytes | WriteError String
data Input = Input String Bool | RawInput Bytes.Bytes Bool
data RuntimeError = RuntimeError String
data Observation = Observation (Either RuntimeError Unit) (List Event) String
data Backends = Backends String Bool IntArray Int Int Int
instance H.Eq RuntimeError where { eq (RuntimeError a) (RuntimeError b) = eqString a b }
instance H.Show RuntimeError where { show (RuntimeError a) = a }
instance H.Eq Event where
  eq ReadLine ReadLine = true
  eq (Write a) (Write b) = eqString a b
  eq (WriteBytes a) (WriteBytes b) = H.eq a b
  eq (WriteError a) (WriteError b) = eqString a b
  eq _ _ = false
instance H.Show Event where
  show ReadLine = "ReadLine"
  show (Write a) = "Write " ++ a
  show (WriteBytes a) = "WriteBytes " ++ Bytes.hex a
  show (WriteError a) = "WriteError " ++ a
instance H.Eq Observation where
  eq (Observation a b c) (Observation x y z) = H.eq a x && H.eq b y && eqString c z
instance H.Show Observation where
  show (Observation a b c) = H.show a ++ " " ++ H.show b ++ " remaining=" ++ c
outcome (Observation a _ _) = a
events (Observation _ a _) = a
remaining (Observation _ _ a) = a
outputBytes observed = Bytes.concat (S.map (\event -> case event of { Write text -> Bytes.encode text; WriteBytes bytes -> bytes; _ -> Bytes.empty }) (events observed))
output observed = Bytes.decodeText (outputBytes observed)
stderrOutput observed = S.concatStrings (S.map (\event -> case event of { WriteError text -> text; _ -> "" }) (events observed))
encodedInput input = case input of { Input text _ -> Bytes.encode text; RawInput bytes _ -> bytes }
failWrites input = case input of { Input _ fail -> fail; RawInput _ fail -> fail }
decodeInput input bytes = case input of { Input _ _ -> Bytes.decodeText bytes; RawInput _ _ -> Bytes.latin1 bytes }
directory (Backends d _ _ _ _ _) = d
compact (Backends _ b _ _ _ _) = b
serial (Backends _ _ s _ _ _) = s
budget (Backends _ _ _ n _ _) = n
candidateBudget (Backends _ _ _ _ n _) = n
interpreterBudget (Backends _ _ _ _ _ n) = n
withExecutionTimeout seconds (Backends d b s _ candidate interpreter) = Backends d b s seconds candidate interpreter
withInterpreterTimeout seconds (Backends d b s native candidate _) = Backends d b s native candidate seconds
withBackends : forall a. (Backends -> IO a) -> IO a
withBackends action = do
  work <- getEnv "MLF_TEST_WORK"
  abi <- O.envDefault "MLF_LLVM_TEST_ABI" "standard"
  seconds <- O.envDefault "MLF_BOOTSTRAP_TIMEOUT_SECONDS" "60"
  let candidate = readInt seconds
  O.require (candidate > 0 && candidate <= 2147483647) "invalid bootstrap candidate timeout"
  O.require (stringLength work > 0 && (eqString abi "standard" || eqString abi "compact-gc")) "invalid backend configuration"
  let dir = work ++ "/matrix-" ++ abi
  O.mkdir dir
  names <- O.entries dir
  S.mapM_ (\name -> if O.starts "program-" name then do
    let path = dir ++ "/" ++ name
    present <- fileExists path
    if present then O.remove path else return Unit
    else return Unit) names
  writeFile (dir ++ "/rows.jsonl") ""
  writeFile (dir ++ "/current-label") "<unlabelled>"
  count <- newIntArray 1 0
  action (Backends dir (eqString abi "compact-gc") count 60 candidate candidate)
inCase context label action = do { writeFile (directory context ++ "/current-label") label; action }
auditBackends context = do
  count <- readIntArray (serial context) 0
  text <- readFile (directory context ++ "/rows.jsonl")
  rows <- S.mapM (\line -> H.right (J.parse line)) (O.nonempty (H.lines text))
  H.assert (count > 0 && S.length rows == count) "missing backend executions"
  H.assert (S.all (\row -> J.equal (J.get "backends" row) (J.stringArray (Cons "interpreter" (Cons "llvm" Nil)))) rows) "incomplete backend row"
  H.assert (S.length (S.nubBy eqInt (S.map ((\row -> readInt (case J.get "index" row of { J.Number text -> text; _ -> "-1" }))) rows)) == count) "duplicate backend row"
  putStrLn ("Backend matrix: " ++ showInt count ++ " rows x 2 backends; no missing executions")
  ioReturn count
capture context term inputs = do
  observed <- execute context IOEntry (Input (S.unlines inputs) false) term
  H.assert (eqString (remaining observed) "") ("unused input: " ++ remaining observed)
  ioReturn (Pair (outcome observed) (events observed))
execute context entry input term = executeWithArguments context Nil entry input term
executeWithArguments context arguments entry input term = executeSerializedWithArguments context arguments entry input (Pretty.prettyTerm (transportNames term))
-- Invalid scalar literals cannot inhabit a native MLF String. Inject their
-- escaped target representation at the transport boundary and exercise both
-- drivers, including the ordinary status, trace, and coverage checks.
executeSerialized : Backends -> Entry -> Input -> String -> IO Observation
executeSerialized context entry input source = executeSerializedWithArguments context Nil entry input source
executeSerializedWithArguments context arguments entry input source = do
  index <- readIntArray (serial context) 0
  writeIntArray (serial context) 0 (index + 1)
  let stem = directory context ++ "/case-" ++ showInt index
  writeFile (stem ++ ".xmlf") source
  interpreter <- getEnv "MLF_BOOTSTRAP_INTERPRETER"
  let mode = case entry of { IOEntry -> "--run-xmlf"; ProgramEntry -> "--run-program-xmlf" }
  first <- observe (withExecutionTimeout (interpreterBudget context) context) (stem ++ "-interpreter") (S.append (Cons interpreter (Cons mode (Cons (stem ++ ".xmlf") (Cons "--" Nil)))) arguments) input
  second <- native context stem arguments entry input
  H.assert (H.eq first second) ("backend mismatch\ninterpreter: " ++ H.show first ++ "\nLLVM: " ++ H.show second)
  label <- readFile (directory context ++ "/current-label")
  log <- readFile (directory context ++ "/rows.jsonl")
  let row = J.Object (Cons (Pair "label" (J.str label)) (Cons (Pair "index" (J.num index)) (Cons (Pair "backends" (J.stringArray (Cons "interpreter" (Cons "llvm" Nil)))) Nil)))
  writeFile (directory context ++ "/rows.jsonl") (log ++ J.render row ++ "\n")
  ioReturn first
native : Backends -> String -> List String -> Entry -> Input -> IO Observation
native context stem arguments entry input = do
  emitter <- getEnv "MLF_BOOTSTRAP_LLVM"
  let mode = (case entry of { IOEntry -> "--xmlf-to-llvm-io"; ProgramEntry -> "--xmlf-to-llvm" }) ++ (if compact context then "-gc" else "")
  code <- O.exec "" (Cons emitter (Cons mode (Cons (stem ++ ".xmlf") Nil))) "" (stem ++ ".ll") (stem ++ ".emit.err") (candidateBudget context)
  error <- readFile (stem ++ ".emit.err")
  if code == 1 then ioReturn (Observation (Left (RuntimeError (normalize (stripFinalNewline error)))) Nil (decodeInput input (encodedInput input))) else do
    H.assert (code == 0 && eqString error "") ("LLVM emitter failed: " ++ error)
    hash <- fileDigest (stem ++ ".ll")
    let program = directory context ++ "/program-" ++ hash
    cached <- fileExists program
    if cached then ioReturn Unit else do
      flagsFile <- getEnv "MLF_TEST_LINK_FLAGS_FILE"
      flags <- readFile flagsFile
      root <- getEnv "MLF_TEST_ROOT"
      let runtime = directory context ++ "/runtime.o"
      let argv = S.append (Cons "clang" (Cons "-O2" (Cons "-Wno-override-module" (Cons (stem ++ ".ll") (Cons runtime (Cons (root ++ "/trace.o") Nil)))))) (S.append (O.unpack flags) (Cons "-lm" (Cons "-o" (Cons program Nil))))
      O.run "" argv
    observe context (stem ++ "-llvm") (Cons program arguments) input
observe : Backends -> String -> List String -> Input -> IO Observation
observe context stem argv input = do
  Bytes.writeFile (stem ++ ".stdin") (encodedInput input)
  setEnv "MLF_TEST_TRACE" (stem ++ ".trace")
  if failWrites input then setEnv "MLF_TEST_FAIL_WRITE" "1" else unsetEnv "MLF_TEST_FAIL_WRITE"
  host <- getEnv "MLF_TEST_HOST_SUPPORT"
  let sample = stem ++ ".status.json"
  supervisor <- O.exec "" (S.append (Cons host (Cons "measure" (Cons (showInt (budget context)) (Cons (stem ++ ".stdin") (Cons (stem ++ ".stdout") (Cons (stem ++ ".stderr") Nil)))))) argv) "" sample (sample ++ ".stderr") (budget context + 5)
  unsetEnv "MLF_TEST_TRACE"
  unsetEnv "MLF_TEST_FAIL_WRITE"
  H.assert (supervisor == 0) "backend supervisor failed or was interrupted"
  status <- J.read sample
  H.assert (S.not (J.getBool "timed_out" false status || J.getBool "interrupted" false status)) "backend timed out or was interrupted"
  let signal = case J.get "termination_signal" status of {J.Number text -> readInt text; _ -> -1}
  H.assert (signal == 0) ("backend crashed with signal " ++ showInt signal)
  let code = case J.get "exit_code" status of {J.Number text -> readInt text; _ -> -1}
  diagnostics <- readFile (stem ++ ".stderr")
  H.assert (code >= 0 && code <= 255) ("backend timed out or crashed: " ++ showInt code ++ ": " ++ diagnostics)
  H.assert (S.not (H.contains "Sanitizer" diagnostics || H.contains "runtime error:" diagnostics)) diagnostics
  trace <- readFile (stem ++ ".trace")
  Pair recorded unused <- parseTrace input trace
  bytes <- Bytes.readFile (stem ++ ".stdout")
  let observed = Observation (Right Unit) recorded unused
  H.assert (H.eq bytes (outputBytes observed)) "stdout and write trace disagree"
  let written = stderrOutput observed
  H.assert (O.starts written diagnostics) "stderr and write trace disagree"
  let error = O.drop (stringLength written) diagnostics
  let result = if code == 0 then (if eqString error "" then Right Unit else Left error) else
        if code == 1 && O.starts "Runtime: " error then Left (normalize (stripFinalNewline (O.drop 9 error))) else
          if code > 0 && code <= 255 && eqString error "" then Left ("exit status " ++ showInt code) else Left ("process failed " ++ showInt code ++ ": " ++ error)
  ioReturn (Observation (S.mapLeft RuntimeError result) recorded unused)
stripFinalNewline text = if O.ends "\n" text then stringSlice text 0 (stringLength text - 1) else text
normalize message = let text = if O.starts "LLVM " message then O.drop 5 message else message in
  if H.contains "test input exhausted" text || H.contains "getLine reached EOF" text then "IO error: test input exhausted" else
    if H.contains "invalid UTF-8 input" text then "IO error: invalid UTF-8 input" else
      if H.contains "cyclic evaluation" text then "cyclic evaluation of a recursive binding" else
        if eqString text "IO error: file write failed" then text else
          if H.contains "write failed" text || H.contains "output failed" text then "IO error: write failed" else text
parseTrace input text = traceLoop input Nil (O.nonempty (H.lines text))
traceLoop : Input -> List Event -> List String -> IO (Pair (List Event) String)
traceLoop input accumulated lines = case lines of
  Cons line Nil -> if O.starts "U " line then ioReturn (Pair (S.reverse accumulated) (decodeInput input (Bytes.fromHex (O.drop 2 line)))) else H.fail ("malformed trace: " ++ line)
  Cons line rest -> if eqString line "R" then traceLoop input (Cons ReadLine accumulated) rest else
    if O.starts "W " line then traceLoop input (Cons (bytesEvent (Bytes.fromHex (O.drop 2 line))) accumulated) rest else
      if O.starts "E " line then traceLoop input (Cons (WriteError (Bytes.decodeText (Bytes.fromHex (O.drop 2 line)))) accumulated) rest else H.fail ("malformed trace: " ++ line)
  Nil -> H.fail "empty native event trace"
bytesEvent bytes = case Bytes.decode bytes of { Right text -> Write text; Left error -> WriteBytes bytes }
transportNames term = let identities = IS.toList (IS.fromList (collectNames term)) in rewriteNames (M.fromList S.compareInt (S.zip identities (S.range 0 (S.length identities - 1)))) term
collectNames : XTerm -> List Int
collectNames term = case term of
  XVarTerm n -> Cons (S.nameId n) Nil
  XAbs n _ b -> Cons (S.nameId n) (collectNames b)
  XApp f a -> S.append (collectNames f) (collectNames a)
  XTypeAbs _ _ b -> collectNames b
  XTypeApp a _ -> collectNames a
  XLet n a b -> Cons (S.nameId n) (S.append (collectNames a) (collectNames b))
  XLetRec ds b -> S.append (S.concatMap (\(Triple n _ a) -> Cons (S.nameId n) (collectNames a)) ds) (collectNames b)
  XCase a _ bs -> S.append (collectNames a) (S.concatMap (\(XAlternative p b) -> S.append (S.map S.nameId (X.patternNames p)) (collectNames b)) bs)
  XWithData _ b -> collectNames b
  _ -> Nil
transportName table (XName identity hint) = XName (M.get S.compareInt identity table) (if printableHint hint then hint else "v")
printableHint hint = stringLength hint > 0 && H.isAlpha (stringCodeAt hint 0) && S.all (\i -> let c = stringCodeAt hint i in H.isAlphaNum c || c == 95 || c == 39) (S.range 1 (stringLength hint - 1))
transportPattern table pattern = case pattern of
  XDefaultPattern n -> XDefaultPattern (S.mapOptional (transportName table) n)
  XConstructorPattern c ns -> XConstructorPattern c (S.map (S.mapOptional (transportName table)) ns)
rewriteNames : Map Int Int -> XTerm -> XTerm
rewriteNames table term = case term of
  XVarTerm n -> XVarTerm (transportName table n)
  XAbs n t b -> XAbs (transportName table n) t (rewriteNames table b)
  XApp f a -> XApp (rewriteNames table f) (rewriteNames table a)
  XTypeAbs a t b -> XTypeAbs a t (rewriteNames table b)
  XTypeApp a c -> XTypeApp (rewriteNames table a) c
  XLet n a b -> XLet (transportName table n) (rewriteNames table a) (rewriteNames table b)
  XLetRec ds b -> XLetRec (S.map (\(Triple n t a) -> Triple (transportName table n) t (rewriteNames table a)) ds) (rewriteNames table b)
  XCase a t bs -> XCase (rewriteNames table a) t (S.map (\(XAlternative p b) -> XAlternative (transportPattern table p) (rewriteNames table b)) bs)
  XWithData ds b -> XWithData ds (rewriteNames table b)
  _ -> term
