module Tests.ModuleBackends where
import Bootstrap.Types
import qualified Bootstrap.Std as S
import qualified Package.OS as OS
import qualified Tests.Helpers as H
import Tests.Helpers (Quint(..), Sext(..))
import Tests.Backends
import Bootstrap.Compiler
import qualified Bootstrap.X.Parser as X
import Tests.Modules (modulePrograms, checkModule)
import qualified Tests.Backends as B
import Tests.System
import qualified Package.OS as O
import Prelude hiding (listDirectory)

moduleBackendTests : B.Backends -> ([] ( ((,) (String) (IO ())) ))
moduleBackendTests backends = (H.append (S.concatMap (\(Quint label mode libraries input expected) -> ((:) ((,) (H.append "modules runtime: " label) do { compiled <- (checkModule mode libraries input); do { observed <- (execute backends IOEntry (Input "" false) (compiledTerm compiled)); do { (S.either (S.compose H.fail H.show) return (outcome observed)); (S.unless (H.eq (output observed) expected) (H.fail (H.append "unexpected output: " (H.show (output observed))))) } } }) [])) modulePrograms) ((:) ((,) "modules runtime: multi-file example" do { compiled <- (bind (compileFile [] "examples/modules/Main.emlf") (S.either (S.compose H.fail H.show) return)); do { observed <- (execute backends IOEntry (Input "" false) (compiledTerm compiled)); do { (S.either (S.compose H.fail H.show) return (outcome observed)); (S.unless (H.eq (output observed) "25\n") (H.fail (H.show observed))) } } }) ((:) ((,) "modules runtime: CLI imports and output paths" (cliTests backends)) [])))

cliTests : B.Backends -> IO ()
cliTests backends = (withScratch (\directory -> do { configured <- (lookupEnv "MLF_BOOTSTRAP_COMPILER"); do { nativeDrivers <- (H.fmap (S.any (\section1 -> (S.not (H.eq section1 Nothing)))) (S.mapM lookupEnv ((:) "MLF_BOOTSTRAP_INTERPRETER" ((:) "MLF_BOOTSTRAP_LLVM" [])))); do { selected <- (case configured of { (Just candidate) -> (return candidate); Nothing -> do { (S.unless (S.not nativeDrivers) (H.fail "Native backend CLI tests require MLF_BOOTSTRAP_COMPILER; refusing seed fallback")); (return "emlf") } }); do { compiler <- (bind (findExecutable selected) (S.maybe (H.fail (H.append "Cannot execute selected module CLI compiler: " selected)) canonicalizePath)); do { (putStrLn (H.append "Module CLI compiler: " compiler)); (let { libraries = (O.join directory "library files") } in (let { entry = (O.join directory "Main.emlf") } in (let { command args input = do { ((,,) status text errors) <- (readProcessWithExitCode compiler args input); do { (S.unless (H.eq status ExitSuccess) (H.fail (H.append (H.show args) (H.append "\n" (H.append text errors))))); (return text) } } } in (let { equal expected actual = (S.unless (H.eq actual expected) (H.fail (H.append "unexpected CLI output: " (H.show actual)))) } in (let { runTarget source = do { term <- (S.either H.fail return (X.parseTerm "<CLI xMLF>" source)); do { observed <- (execute backends IOEntry (Input "" false) term); do { (S.either (S.compose H.fail H.show) return (outcome observed)); (equal "42\n" (output observed)) } } } } in (let { reject args reason = do { ((,,) status text errors) <- (readProcessWithExitCode compiler args ""); (S.unless ((S.not (H.eq status ExitSuccess)) && ((H.null text) && (H.contains reason errors))) (H.fail (H.show ((,,) status text errors)))) } } in do { (createDirectory libraries); do { (writeFile (O.join libraries "Helpers.emlf") "module Helpers (inc) where\ninc x = x + 1\n"); do { (writeFile entry "module Main where\nimport Helpers (inc)\nmain = printInt (inc 41)\n"); do { (bind (command ((:) "-i" ((:) libraries ((:) "--type" ((:) entry [])))) "") (equal "IO Unit\n")); do { (bind (command ((:) "-i" ((:) (O.join directory "missing search root") ((:) "-i" ((:) libraries ((:) "--type" ((:) entry [])))))) "") (equal "IO Unit\n")); do { target <- (command ((:) "-i" ((:) libraries ((:) entry []))) ""); do { (runTarget target); do { (bind (command ((:) "--check" []) target) (equal "IO Unit\n")); do { direct <- (command ((:) (H.append "-i" libraries) ((:) "--emit-llvm" ((:) entry []))) ""); do { (bind (command ((:) "--xmlf-to-llvm" []) target) (equal direct)); do { (bind (command ((:) "-i" ((:) libraries ((:) "--run" ((:) entry [])))) "") (equal "42\n")); do { (bind (command ((:) "-i" ((:) (O.join (O.join libraries "..") "library files") ((:) "--run" ((:) entry [])))) "") (equal "42\n")); (let { alias = (O.join directory "module alias") } in do { (createDirectoryLink libraries alias); do { (bind (command ((:) "-i" ((:) alias ((:) "--run" ((:) entry [])))) "") (equal "42\n")); (let { hierarchy = (O.join libraries "Geometry") } in (let { nestedEntry = (O.join hierarchy "Main.emlf") } in do { (createDirectory hierarchy); do { (writeFile (O.join hierarchy "Support.emlf") "module Geometry.Support (inc) where\ninc x = x + 1\n"); do { (writeFile nestedEntry "module Geometry.Main where\nimport Geometry.Support\nmain = printInt (inc 41)\n"); do { (bind (command ((:) "--run" ((:) nestedEntry [])) "") (equal "42\n")); do { (bind (command ((:) "--run-xmlf" []) target) (equal "42\n")); (let { expression = "import Helpers (inc)\nprintInt (inc 41)" } in do { (bind (command ((:) "-i" ((:) libraries ((:) "--expr" ((:) expression [])))) "") runTarget); do { (bind (command ((:) "-i" ((:) libraries [])) expression) runTarget); do { (bind (command ((:) "-i" ((:) libraries ((:) "--type" ((:) "-" [])))) expression) (equal "IO Unit\n")); do { (bind (command ((:) "--no-prelude" ((:) "-i" ((:) libraries ((:) "--type" ((:) "--expr" ((:) "import Prelude (Monad(..), IO, Int)\n(return 42 : IO Int)" [])))))) "") (equal "IO Int\n")); do { (reject ((:) "--type" ((:) entry [])) "cannot find module Helpers"); do { (reject ((:) "-i" ((:) (O.join directory "missing search root") ((:) "--type" ((:) entry [])))) "ModuleResolution: cannot find module Helpers"); (reject ((:) "-i" []) "-i requires a module search directory") } } } } } }) } } } } })) } }) } } } } } } } } } } } })))))) } } } } }))
