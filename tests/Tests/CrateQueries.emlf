module Tests.CrateQueries (crateQueryTests) where

import Bootstrap.Types
import Bootstrap.Std
import qualified Bootstrap.Map as M
import qualified Bootstrap.Dependency as Dependency
import qualified Bootstrap.Desugar as Desugar
import qualified Bootstrap.Surface as Surface
import qualified Bootstrap.InferenceUnit as Inference
import qualified Bootstrap.CrateQuery as Query
import qualified Bootstrap.Separate as Separate
import qualified Bootstrap.Data as D
import qualified Bootstrap.X.Type as T
import qualified Bootstrap.X.Syntax as X
import qualified Bootstrap.X.Checked as Checked
import qualified Package.OS as OS
import qualified Tests.Helpers as H

scratch name = do
  root <- canonicalPath "."
  let path = root ++ "/.mlf-build/test-crate-queries/" ++ name
  present <- directoryExists path
  if present then OS.remove path else ioReturn ()
  OS.mkdir path
  ioReturn path
query label directory datatypes values = do
  result <- Query.compileGroups label directory [] datatypes values
  H.right result
counts inferred reused report = H.assert (Query.inferredCount report == inferred && Query.reusedCount report == reused) "unexpected inferred/reused declaration groups"
equivalent a b = length a == length b && eqList (\x y -> X.equalErased (X.erase (Separate.objectTerm x)) (X.erase (Separate.objectTerm y))) a b
values name extra =
  let rhs = SLam name Nothing (if extra then SLet "unused" (SIntLit 1) (SVar name) else SVar name) in
  (:) ((,,) "g" Nothing rhs) ((:) ((,,) "f" Nothing (SVar "g")) ((:) ((,,) "h" Nothing (SIntLit 42)) []))
identityType = XForall (XTyVar 0) XBot (XArrow (XVar (XTyVar 0)) (XVar (XTyVar 0)))
scheme name object = case lookup eqString name (Separate.unitBindings (Separate.objectInterface object)) of {Just ty -> ty; Nothing -> panic ("missing test scheme: " ++ name)}

orderedSCC = do
  let edges = (:) ((,) "f" ((:) "g" [])) ((:) ((,) "g" []) ((:) ((,) "h" []) []))
  let expected = (:) ((:) "g" []) ((:) ((:) "f" []) ((:) ((:) "h" []) []))
  H.assert (eqList (eqList eqString) (Dependency.components edges) expected) "value dependencies must precede their users"
  H.assert (eqList (eqList eqString) (Dependency.components (reverse edges)) expected) "SCC order depends on source inventory order"
mutualSCC = do
  let edges = (:) ((,) "f" ((:) "g" [])) ((:) ((,) "g" ((:) "f" [])) ((:) ((,) "h" []) []))
  H.assert (eqList (eqList eqString) (Dependency.components edges) ((:) ((:) "f" ((:) "g" [])) ((:) ((:) "h" []) []))) "an unrelated declaration joined a recursive group"
chain : Int -> [] ((,) String ([] String))
chain n = if n < 0 then [] else (:) ((,) (showInt n) (if n == 0 then [] else (:) (showInt (n-1)) [])) (chain (n-1))
chainOrder : Int -> [] ([] String) -> Bool
chainOrder n groups = case groups of {[] -> true; (:) names rest -> eqList eqString names ((:) (showInt n) []) && chainOrder (n+1) rest}
largeSCC =
  let groups = Dependency.components (chain 1999) in
  H.assert (length groups == 2000 && chainOrder 0 groups) "large indexed declaration chain lost members or dependency order"
observations = do
  let expression = SAnn (SLam "x" Nothing (SVar "x")) (SAnnotation [] (SQualified ((:) (SPredicate "C" ((:) (SCon "T" []) [])) []) (SCon "U" [])))
  let observed = Dependency.normalize (Dependency.observeExpression expression)
  H.assert (null (Dependency.valueNames observed) && eqList eqString (Dependency.typeNames observed) ((:) "T" ((:) "U" [])) && eqList eqString (Dependency.classNames observed) ((:) "C" [])) "type/class observations contaminated value dependencies or lost lexical scope"
  let constructor = Dependency.normalize (Dependency.observeExpression (SCase (SVar "input") ((:) (SAlternative (SConstructorPattern "Box" ((:) (Just "field") [])) (SVar "field")) [])))
  H.assert (eqList eqString (Dependency.valueNames constructor) ((:) "input" []) && eqList eqString (Dependency.constructorNames constructor) ((:) "Box" [])) "pattern constructor dependency or local binder was lost"
  let recursive = SLetRec ((:) ((,,) "f" InferRecursive (SApp (SVar "g") (SVar "input"))) ((:) ((,,) "g" (CheckRecursive (SAnnotation [] (SCon "T" []))) (SVar "f")) [])) (SVar "g")
  let recursiveObserved = Dependency.normalize (Dependency.observeExpression recursive)
  H.assert (eqList eqString (Dependency.valueNames recursiveObserved) ((:) "input" []) && eqList eqString (Dependency.typeNames recursiveObserved) ((:) "T" [])) "recursive mode observations invented a signature or lost group scope"

principalInference = do
  first <- H.right (Inference.compileLoweredGroup "Identity" [] [] ((:) ((,,) "identity" Nothing (SLam "x" Nothing (SVar "x"))) []))
  H.assert (T.alphaEq (scheme "identity" first) identityType) "group did not retain the principal identity scheme"
  second <- H.right (Inference.compileLoweredGroup "Uses" ((:) (Separate.objectInterface first) []) [] ((:) ((,,) "integer" Nothing (SApp (SVar "identity") (SIntLit 42))) ((:) ((,,) "boolean" Nothing (SApp (SVar "identity") (SBoolLit true))) [])))
  H.assert (T.alphaEq (scheme "integer" second) (XCon "Int" []) && T.alphaEq (scheme "boolean" second) (XCon "Bool" [])) "cross-group polymorphic uses shared a monomorphic instance"
  let chooseSignature = Just (SAnnotation [] (SForall Flexible "a" SBottom (SArrow (STVar "a") (SArrow (STVar "a") (STVar "a")))))
  choose <- H.right (Inference.compileLoweredGroup "Choose" [] [] ((:) ((,,) "choose" chooseSignature (SLam "x" Nothing (SLam "y" Nothing (SVar "x")))) []))
  bounded <- H.right (Inference.compileLoweredGroup "Bounded" ((:) (Separate.objectInterface first) ((:) (Separate.objectInterface choose) [])) [] ((:) ((,,) "g" Nothing (SApp (SVar "choose") (SVar "identity"))) []))
  applied <- H.right (Inference.compileLoweredGroup "Impredicative" ((:) (Separate.objectInterface bounded) []) [] ((:) ((,,) "gg" Nothing (SApp (SVar "g") (SVar "g"))) []))
  let expected = XForall (XTyVar 1) identityType (XArrow (XVar (XTyVar 1)) (XVar (XTyVar 1)))
  H.assert (T.alphaEq (scheme "g" bounded) expected && T.alphaEq (scheme "gg" applied) expected) "cross-group g g lost its principal first-class polymorphic bound"
recursiveInference = do
  let signature = Just (SAnnotation [] (SForall Flexible "a" SBottom (SArrow (STVar "a") (STVar "a"))))
  let members = (:) ((,,) "f" signature (SLam "x" Nothing (SApp (SVar "g") (SVar "x")))) ((:) ((,,) "g" signature (SLam "x" Nothing (SApp (SVar "f") (SVar "x")))) [])
  object <- H.right (Inference.compileLoweredGroup "Recursive" [] [] members)
  H.assert (length (Separate.unitBindings (Separate.objectInterface object)) == 2 && T.alphaEq (scheme "f" object) identityType && T.alphaEq (scheme "g" object) identityType) "signed recursive schemes changed across a group boundary"
  let unsigned = map (\((,,) n _ body) -> (,,) n Nothing body) members
  inferred <- H.right (Inference.compileLoweredGroup "Unsigned" [] [] unsigned)
  let divergent = XForall (XTyVar 0) XBot (XForall (XTyVar 1) XBot (XArrow (XVar (XTyVar 0)) (XVar (XTyVar 1))))
  H.assert (T.alphaEq (scheme "f" inferred) divergent && T.alphaEq (scheme "g" inferred) divergent) "unsigned recursive schemes were not generalized after the component"
  converted <- H.right (Surface.recursiveValues members)
  H.assert (all (\((,,) _ mode _) -> case mode of {CheckRecursive (SAnnotation [] _) -> true; _ -> false}) converted) "closed signatures lost their explicit recursive checking mode"
  H.reject (Surface.recursiveValues ((:) ((,,) "f" (Just (SAnnotation ((:) "a" []) (STVar "a"))) (SVar "f")) []))
  let mixed = (:) ((,,) "f" InferRecursive (SVar "f")) ((:) ((,,) "g" (CheckRecursive (SAnnotation [] (SCon "Int" []))) (SIntLit 1)) [])
  extracted <- H.right (Inference.extractLoweredDeclarations (SLetRec mixed (SConstructor "()")))
  H.assert (case extracted of {(:) ((,,) "f" Nothing _) ((:) ((,,) "g" (Just (SAnnotation [] (SCon "Int" []))) _) []) -> true; _ -> false}) "declaration extraction confused inferred and checked recursive modes"
  let expected = SLetRec mixed (SVar "g")
  H.assert (H.eq (Desugar.desugarDo (SDo ((:) (SDoLetRec mixed) []) (SVar "g"))) expected) "do desugaring changed recursive modes"
  lowered <- H.right (Surface.lowerExpression expected)
  H.assert (H.eq lowered expected) "surface lowering changed recursive modes"
  hygienic <- H.right (Separate.hygiene expected)
  H.assert (case hygienic of {SLetRec ((:) ((,,) _ InferRecursive _) ((:) ((,,) _ (CheckRecursive _) _) [])) _ -> true; _ -> false}) "hygiene changed recursive modes"
openEnvironment = do
  let imported = Separate.UnitInterface "Open" [] [] [] [] [] ((:) ((,) "input" (XVar (XTyVar 0))) []) "parameters"
  H.assert (case Inference.compileLoweredGroup "UseOpen" ((:) imported []) [] ((:) ((,,) "f" Nothing (SVar "input")) []) of {Left message -> H.contains "open type" message; Right _ -> false}) "query generalized an open imported type variable"

cacheNoop = do
  directory <- scratch "noop"
  let nested = directory ++ "/λ cache ; literal"
  created <- Query.ensureDirectory nested
  _ <- H.right created
  firstWrite <- Query.writeAtomic (nested ++ "/entry") "first"
  _ <- H.right firstWrite
  replaced <- Query.writeAtomic (nested ++ "/entry") "replacement λ\n"
  _ <- H.right replaced
  contents <- readFile (nested ++ "/entry")
  H.assert (eqString contents "replacement λ\n") "atomic query cache publication did not replace exact bytes"
  (,) original first <- query "Cache" directory [] (values "x" false)
  counts 3 0 first
  (,) same second <- query "Cache" directory [] (values "x" false)
  counts 0 3 second
  H.assert (equivalent original same) "cache reuse changed checked erasure"
  mapM_ (\object -> H.assert (case object of {Separate.CheckedUnitObject _ _ -> true; _ -> false}) "query discarded its opaque checked result") (append original same)
  writeFile (directory ++ "/" ++ head (Query.queryKeys second) ++ ".mlfq") "corrupt"
  (,) recovered third <- query "Cache" directory [] (values "x" false)
  counts 1 2 third
  H.assert (equivalent original recovered) "corrupt cache recovery changed the compiled program"
cacheImplementation = do
  directory <- scratch "implementation"
  (,) _ _ <- query "Cache" directory [] (values "x" false)
  (,) changed update <- query "Cache" directory [] (values "y" true)
  counts 1 2 update
  (,) renamed alpha <- query "Cache" directory [] (values "renamed" true)
  counts 0 3 alpha
  H.assert (equivalent changed renamed) "lexical alpha cache reuse changed erasure"
  cleanDirectory <- scratch "implementation-clean"
  (,) clean cleanReport <- query "Cache" cleanDirectory [] (values "y" true)
  counts 3 0 cleanReport
  H.assert (equivalent changed clean) "clean and incremental compilation differ"
cacheScheme = do
  directory <- scratch "scheme"
  (,) _ _ <- query "Cache" directory [] (values "x" false)
  let changed = (:) ((,,) "g" Nothing (SLam "x" Nothing (SIntLit 1))) ((:) ((,,) "f" Nothing (SVar "g")) ((:) ((,,) "h" Nothing (SIntLit 42)) []))
  (,) objects report <- query "Cache" directory [] changed
  counts 2 1 report
  H.assert (case find (\object -> any (\entry -> eqString (fst entry) "f") (Separate.unitBindings (Separate.objectInterface object))) objects of {Just object -> not (T.alphaEq (scheme "f" object) identityType); Nothing -> false}) "consumer retained an obsolete polymorphic scheme"
cacheTypes = do
  directory <- scratch "types"
  (,) _ _ <- query "Cache" directory [] (values "x" false)
  let unused = DataDecl "Unused" [] ((:) (ConstructorDecl "UnusedValue" ((:) (Applied "Bool" []) [])) [])
  (,) _ unaffected <- query "Cache" directory ((:) unused []) (values "x" false)
  counts 0 3 unaffected
  let boxInt = DataDecl "Box" [] ((:) (ConstructorDecl "MakeBox" ((:) (Applied "Int" []) [])) [])
  let boxBool = DataDecl "Box" [] ((:) (ConstructorDecl "MakeBox" ((:) (Applied "Bool" []) [])) [])
  let boxed = (:) ((,,) "boxed" Nothing (SApp (SConstructor "MakeBox") (SIntLit 1))) []
  (,) _ _ <- query "BoxCache" (directory ++ "/box") ((:) boxInt []) boxed
  invalidated <- Query.compileGroups "BoxCache" (directory ++ "/box") [] ((:) boxBool []) boxed
  H.assert (case invalidated of {Left _ -> true; Right _ -> false}) "changed constructor fields incorrectly reused inference"
  needed <- H.right (Query.requiredData ((:) boxInt []) ((:) ((,,) "f" Nothing (SVar "imported")) []) ((:) ((,) "imported" (XArrow (XCon "Box" []) (XCon "Int" []))) []))
  H.assert (eqList eqString (map D.datatypeName needed) ((:) "Box" [])) "external schemes did not contribute nominal datatype dependencies"

classCandidates = do
  directory <- scratch "classes"
  let klass = SClassDecl "C" ((:) ((,) "a" Star) []) [] ((:) ((,) "methodC" (SArrow (STVar "a") (SCon "Int" []))) [])
  let intInstance = SInstanceDecl [] [] "C" ((:) (SCon "Int" []) []) ((:) ((,) "methodC" (SLam "x" Nothing (SVar "x"))) [])
  let boolInstance = SInstanceDecl [] [] "C" ((:) (SCon "Bool" []) []) ((:) ((,) "methodC" (SLam "x" Nothing (SIntLit 1))) [])
  let members = (:) ((,,) "signedAnswer" (Just (SAnnotation [] (SCon "Int" []))) (SApp (SVar "methodC") (SIntLit 42))) []
  let oldScope = IntSet (M.singleton 0 ())
  let newScope = IntSet (M.fromList compareInt ((:) ((,) 0 ()) ((:) ((,) 1 ()) [])))
  before <- H.right (Inference.lowerDeclarations [] ((:) klass []) ((:) ((,) "instanceCInt" intInstance) []) (M.singleton "signedAnswer" oldScope) ((:) oldScope []) members)
  after <- H.right (Inference.lowerDeclarations [] ((:) klass []) ((:) ((,) "instanceCInt" intInstance) ((:) ((,) "instanceCBool" boolInstance) [])) (M.singleton "signedAnswer" newScope) ((:) newScope ((:) newScope [])) members)
  (,) _ _ <- query "ClassCache" directory (Inference.loweredData before) (Inference.loweredValues before)
  (,) _ report <- query "ClassCache" directory (Inference.loweredData after) (Inference.loweredValues after)
  counts 2 2 report
canonicalKeys = do
  let first = (,,) "evidence" Nothing (SLam "givenDictionary1" Nothing (SWanted "Dict_C" ((:) ((,) GivenEvidence "givenDictionary1") [])))
  let renamed = (,,) "evidence" Nothing (SLam "givenDictionary99" Nothing (SWanted "Dict_C" ((:) ((,) GivenEvidence "givenDictionary99") [])))
  H.assert (eqString (Query.queryKey "Alpha" "compiler" ((:) first []) [] []) (Query.queryKey "Alpha" "compiler" ((:) renamed []) [] [])) "given evidence names leaked into query identity"
  H.assert (not (eqString (Query.encodeType (SForall Flexible "a" SBottom (STVar "a"))) (Query.encodeType (SForall Rigid "a" SBottom (STVar "a"))))) "query encoding lost the quantifier flag"
  H.assert (eqString (Query.encodeBinding ((,) "x" (XCon "List" ((:) (XCon "Int" []) [])))) (Query.encodeBinding ((,) "x" (XApply (XCon "List" []) (XCon "Int" []))))) "equivalent type applications invalidate semantic query inputs"
  let checked = (,,) "f" (CheckRecursive (SAnnotation [] (SCon "Int" []))) (SVar "f")
  let inferred = (,,) "f" InferRecursive (SVar "f")
  H.assert (eqString (Query.encodeRecursive checked) "9:recursive1:f39:10:annotation0:21:11:constructor3:Int0:13:8:variable1:f") "signed recursive query encoding changed"
  H.assert (not (eqString (Query.encodeRecursive checked) (Query.encodeRecursive inferred))) "query encoding conflated inferred and checked recursion"
  H.assert (not (H.eq (SLetRec ((:) checked []) (SVar "f")) (SLetRec ((:) inferred []) (SVar "f")))) "source equality conflated inferred and checked recursion"
  H.assert (not (H.eq (SDo ((:) (SDoLetRec ((:) checked [])) []) (SVar "f")) (SDo ((:) (SDoLetRec ((:) inferred [])) []) (SVar "f")))) "statement equality conflated inferred and checked recursion"
  let firstRecursive = (,,) "entry" Nothing (SLetRec ((:) inferred []) (SVar "f"))
  let renamedRecursive = (,,) "entry" Nothing (SLetRec ((:) ((,,) "renamed" InferRecursive (SVar "renamed")) []) (SVar "renamed"))
  H.assert (eqString (Query.queryKey "AlphaRecursive" "compiler" ((:) firstRecursive []) [] []) (Query.queryKey "AlphaRecursive" "compiler" ((:) renamedRecursive []) [] [])) "unsigned recursive binder names leaked into query identity"
  H.assert (not (eqString (Query.queryKey "AlphaRecursive" "compiler-before" ((:) firstRecursive []) [] []) (Query.queryKey "AlphaRecursive" "compiler-after" ((:) firstRecursive []) [] []))) "compiler identity change reused a recursive query key"
  let checkedRecursive = (,,) "entry" Nothing (SLetRec ((:) checked []) (SVar "f"))
  H.assert (not (eqString (Query.queryKey "AlphaRecursive" "compiler" ((:) firstRecursive []) [] []) (Query.queryKey "AlphaRecursive" "compiler" ((:) checkedRecursive []) [] []))) "canonical query identity erased recursive checking mode"
  let signedRecursive = \name variable -> (,,) "entry" Nothing (SLetRec ((:) ((,,) name (CheckRecursive (SAnnotation [] (SForall Flexible variable SBottom (SArrow (STVar variable) (STVar variable))))) (SLam "value" (Just (SAnnotation [] (STVar variable))) (SApp (SVar name) (SVar "value")))) []) (SVar name))
  H.assert (eqString (Query.queryKey "SignedAlphaRecursive" "compiler" ((:) (signedRecursive "f" "a") []) [] []) (Query.queryKey "SignedAlphaRecursive" "compiler" ((:) (signedRecursive "renamed" "other") []) [] [])) "signed recursive scoped type names leaked into query identity"
cacheBoundary = do
  object <- H.right (Inference.compileLoweredGroup "CacheBoundary" [] [] ((:) ((,,) "identity" Nothing (SLam "x" Nothing (SVar "x"))) []))
  let original = Separate.objectInterface object
  let forged = Separate.UnitInterface "CacheBoundary" [] [] [] [] [] ((:) ((,) "identity" (XCon "Int" [])) []) (Separate.unitObjectFingerprint original)
  proof <- H.right (Separate.objectChecked object)
  H.reject (Query.validateCached "CacheBoundary" [] [] ((:) "identity" []) (Separate.CheckedUnitObject forged proof))
  let encoded = Query.encodeCached "key" (Separate.UnitObject forged (Separate.objectTerm object))
  H.assert (case Query.decodeCached "key" "CacheBoundary" [] [] ((:) "identity" []) encoded of {Left _ -> true; Right _ -> false}) "cache trusted interface schemes without independently checking the body"

crateQueryTests : [] ((,) String (IO ()))
crateQueryTests = (:) ((,) "declaration SCC order and inventory permutation" orderedSCC)
  ((:) ((,) "recursive SCC excludes unrelated declarations" mutualSCC)
  ((:) ((,) "indexed SCC traversal handles 2000 declarations" largeSCC)
  ((:) ((,) "term, type, class and constructor observations remain distinct" observations)
  ((:) ((,) "checked group inference preserves principal polymorphism" principalInference)
  ((:) ((,) "closed-signature recursion remains checked across groups" recursiveInference)
  ((:) ((,) "inference rejects an open imported environment" openEnvironment)
  ((:) ((,) "persistent no-op reuse and corrupt-cache recovery" cacheNoop)
  ((:) ((,) "implementation edits preserve consumer caches and clean equivalence" cacheImplementation)
  ((:) ((,) "changed schemes invalidate actual consumers" cacheScheme)
  ((:) ((,) "datatype closure invalidates relevant changes only" cacheTypes)
  ((:) ((,) "instance candidate visibility participates in query keys" classCandidates)
  ((:) ((,) "query encodings preserve semantics and normalize lexical names" canonicalKeys)
  ((:) ((,) "cache schemes are checked against stored implementations" cacheBoundary) [])))))))))))))
