module Tests.Regex where
import Bootstrap.Types
import qualified Bootstrap.Std as S
import qualified Bootstrap.Regex as R

regex : String -> R.Regex
regex text = case R.compile text of { Left error -> panic error; Right value -> value }
assert : Bool -> String -> IO Unit
assert condition message = if condition then return Unit else panic ("regex test: " ++ message)
match : String -> String -> Int -> Int -> IO Unit
match pattern subject start end = assert (case R.find (regex pattern) subject 0 of { Nothing -> false; Just (Pair a b) -> a == start && b == end }) ("unexpected match for " ++ pattern)
reject : String -> IO Unit
reject pattern = assert (case R.compile pattern of { Left error -> stringLength error > 0; Right value -> false }) ("invalid pattern accepted: " ++ pattern)
main : IO Unit
main = do
 S.mapM_ reject (Cons "[" (Cons "(" (Cons "a)" (Cons "*a" (Cons "a**" (Cons "a+?" (Cons "[z-a]" (Cons "[]" (Cons "\\" (Cons "\\1" (Cons "\\b" (Cons "(?=a)" (Cons "a{2,1}" (Cons "a{1001}" (Cons "a{1,x}" (Cons "[\\d-z]" (Cons "(a{1000}){1000}" Nil)))))))))))))))))
 reject "((){1000}){1000}"
 match "ab|a" "ab" 0 2
 match "a|ab" "ab" 0 1
 match "a.*z|b" "a--b--z" 0 7
 match "a.*z|b" "a--b--" 3 4
 match "a*ab" "aaaab" 0 5
 match "a+" "baaaac" 1 5
 match "ab?c" "ac" 0 2
 match "a{2,4}" "aaaaa" 0 4
 match "a{2,}" "aaaaa" 0 5
 match "a{3}" "baaaa" 1 4
 match "[a-c]+" "xcabz" 1 4
 match "[^a-c]+" "abXYZc" 2 5
 match "[\\D]+" "12xyz3" 2 5
 match "[^\\D]+" "ab123c" 2 5
 match "\\w+\\s\\d+" "!a_1 23?" 1 7
 match "[\\]\\-]+" "x]-y" 1 3
 match "^a..$" "abc" 0 3
 match "(a?)*" "aaa" 0 3
 match "(a*)*b" "aaab" 0 4
 match "(|a)*b" "aaab" 0 4
 match "(|a)*" "aaa" 0 0
 match "(a?|b)*" "b" 0 0
 match "(^|.)*" "a" 0 0
 match "(a?|.)*" "ab" 0 1
 match "(a|aa)*b" (S.concatStrings (S.replicate 200 "a") ++ "b") 0 201
 assert (case R.find (regex "(a|aa)*b") (S.concatStrings (S.replicate 200 "a")) 0 of { Nothing -> true; Just result -> false }) "ambiguous failure did not terminate"
 match "[α-ω]+" "xαβω!" 1 4
 match "." (stringFromCode 0) 0 1
 assert (case R.find (regex ".") "\n" 0 of { Nothing -> true; Just result -> false }) "dot matched newline"
 assert (case R.find (regex "^b") "ab" 1 of { Nothing -> true; Just result -> false }) "offset changed beginning anchor"
 assert (case R.find (regex "$") "ab" 3 of { Nothing -> true; Just result -> false }) "out-of-range search accepted"
 assert (case R.find (regex "a") "a" (-1) of { Nothing -> true; Just result -> false }) "negative search accepted"
 assert (R.countMatches (regex "aa") "aaaaa" == 2) "matches overlapped"
 assert (R.countMatches (regex "") "αβ" == 3 && R.countMatches (regex "(a?)*") "bb" == 3 && R.countMatches (regex "a*") "aaa" == 2) "empty-match advancement changed"
 assert (eqString (R.replaceAll (regex "a+") "$1\\tail" "caaad") "c$1\\taild") "replacement was not literal"
 assert (eqString (R.replaceAll (regex "") "-" "αβ") "-α-β-" && eqString (R.replaceAll (regex "a*") "x" "aaa") "xx") "empty replacement skipped subject characters"
 assert (eqString (R.replaceAll (regex "(a|ab)") "x" "abab") "xbxb") "replacement changed alternative priority"
 assert (eqString (R.replaceAll (regex ">[^\n]*\n|\n") "" ">ONE\nAC\nGT\n>TWO\nTA\n") "ACGTTA") "FASTA cleaning differs"
 putStrLn "regular-expression tests passed"
