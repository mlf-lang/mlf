module Tests.PreludeTests where
import Bootstrap.Types
import qualified Bootstrap.Std as S
import qualified Package.OS as OS
import qualified Tests.Helpers as H
import Tests.Helpers (Quint(..), Sext(..))
import Tests.Backends
import qualified Tests.Backends as B
import Bootstrap.Compiler
import Bootstrap.Parser (parseExpr, parseProgram)
import qualified Bootstrap.X.Check as C
import qualified Bootstrap.X.Parser as XP
import Bootstrap.X.Pretty (prettyTerm)
import qualified Bootstrap.X.Syntax as X
import qualified Bootstrap.X.Type as T

checked : String -> IO Compilation
checked source = do { result <- (H.right (compile "<prelude>" source)); do { parsed <- (H.right (XP.parseTerm "<prelude xMLF>" (prettyTerm (compiledTerm result)))); do { ty <- (H.right (C.checkClosed parsed)); do { (H.assert (T.alphaEq ty (inferredType result)) "prelude xMLF changed type"); do { (H.assert (H.eq (X.erase parsed) (X.erase (compiledTerm result))) "prelude xMLF changed erasure"); (return result) } } } } }

hasType : String -> String -> XType -> (,) String (IO ())
hasType label source ty = ((,) (H.append "prelude: " label) do { result <- (checked source); (H.assert (T.alphaEq ty (inferredType result)) (sourceType result)) })

rejects : String -> String -> Phase -> String -> (,) String (IO ())
rejects label source expectedPhase reason = ((,) (H.append "prelude rejection: " label) (case (compile "<invalid prelude use>" source) of { (Left err) -> (H.assert ((H.eq (phase err) expectedPhase) && (H.contains reason (diagnostic err))) (H.show err)); (Right result) -> (H.fail (H.append "unexpected acceptance: " (sourceType result))) }))

runsOn : B.Backends -> String -> String -> ([] ( String )) -> String -> (,) String (IO ())
runsOn backends label source inputs expected = ((,) (H.append "prelude runtime: " label) do { result <- (checked source); do { term <- (H.right (XP.parseTerm "<prelude runtime>" (prettyTerm (compiledTerm result)))); do { ((,) outcome trace) <- (B.capture backends term inputs); do { (H.right outcome); (let { actual = (H.concat (S.concatMap (\comprehension1 -> case comprehension1 of { (Write text) -> ((:) text []); _ -> [] }) trace)) } in (H.assert (H.eq actual expected) (H.show actual))) } } } })

int : XType
int = (XCon "Int" [])

bool : XType
bool = (XCon "Bool" [])

maybeDecl : String
maybeDecl = "data Maybe a = Nothing | Just a; "

maybeInstance : String
maybeInstance = "instance Functor Maybe where { fmap f value = case value of { Nothing -> Nothing; Just x -> Just (f x) } }; instance Applicative Maybe where { pure = Just; (<*>) functions values = case functions of { Nothing -> Nothing; Just f -> case values of { Nothing -> Nothing; Just x -> Just (f x) } } }; instance Monad Maybe where { (>>=) value next = case value of { Nothing -> Nothing; Just x -> next x } }; "

twice : String
twice = (H.append "let twice : forall (m : * -> *) a. Monad m => m a -> m a = " "\\action -> do { action; value <- action; return value } in ")

explicitMonad : String
explicitMonad = (H.append "class Monad (m : * -> *) where { return : forall a. a -> m a; " "bind : forall a b. m a -> (a -> m b) -> m b }; ")

preludeTests : B.Backends -> ([] ( (,) String (IO ()) ))
preludeTests backends = (let { runs = (runsOn backends) } in (H.append ((:) (runs "IO sequencing without declarations" "do { putStr \"Name: \"; line <- getLine; putStrLn line }" ((:) "Ada" []) "Name: Ada\n") ((:) (runs "qualified generic IO function" (H.append twice "twice (putStrLn \"again\")") [] "again\nagain\n") ((:) (runs "one generic function at IO and a user instance" (H.append maybeDecl (H.append maybeInstance (H.append twice "do { twice (putStrLn \"twice\"); case twice (Just 42) of { Nothing -> printInt 0; Just n -> printInt n } }"))) [] "twice\ntwice\n42\n") ((:) (runs "ordinary equality shadows but string patterns use canonical Eq" "let (==) = \\x y -> false in do { printInt (if (\"a\" :: String) == (\"a\" :: String) then 1 else 0); printInt (case (\"a\" :: String) of { \"a\" -> 42; _ -> 0 }) }" [] "0\n42\n") ((:) (runs "legacy refutable do dispatches failure and skips continuation" (H.append maybeDecl (H.append maybeInstance "instance MonadFail Maybe where { fail _ = Nothing }; case (do { Just x <- Just Nothing; pure (panic \"continuation ran\") }) of { Nothing -> printInt 42; Just n -> printInt n }")) [] "42\n") ((:) (runs "legacy matching do bypasses fail" (H.append maybeDecl (H.append maybeInstance "instance MonadFail Maybe where { fail _ = panic \"fail ran\" }; case (do { Just x <- Just (Just 42); pure x }) of { Nothing -> printInt 0; Just n -> printInt n }")) [] "42\n") ((:) (hasType "user Monad instance needs no class declaration" (H.append maybeDecl (H.append maybeInstance "do { x <- Just 42; return x }")) (XCon "Maybe" ((:) int []))) ((:) (hasType "inferred constraints use the imported methods" (H.append maybeDecl (H.append maybeInstance "let roundTrip = \\value -> bind value return in roundTrip (Just 42)")) (XCon "Maybe" ((:) int []))) ((:) (hasType "qualified annotation alone imports the class" "let identityM : forall (m : * -> *) a. Monad m => m a -> m a = \\x -> x in identityM (ioReturn 42)" (XCon "IO" ((:) int []))) ((:) (hasType "superclass alone imports Monad" "class Monad m => Marker (m : * -> *) where { mark : forall a. m a -> m a }; true" bool) ((:) (hasType "instance context alone imports Monad" (H.append "data Wrapped (m : * -> *) a = Wrapped (m a); " (H.append "class Tag (m : * -> *) where { tag : forall a. m a -> Bool }; " "instance forall (m : * -> *). Monad m => Tag (Wrapped m) where { tag = \\x -> true }; true")) bool) ((:) (runs "prelude implementation uses primitive identities" (H.append "class Hijack a where { ioReturn : a -> IO a }; " (H.append "instance Hijack Int where { ioReturn = \\x -> do { printInt 0; pure x } }; " "do { x <- return 42; printInt x }")) [] "42\n") ((:) (runs "given dictionary and lexical shadowing coexist" (H.append twice "let return = \\x -> x in do { twice (putStrLn \"ok\"); printInt (return 42) }") [] "ok\nok\n42\n") ((:) (runs "local class method shadows only the imported method" (H.append "class Keep a where { return : a -> a }; instance Keep Int where { return = \\x -> x }; " "do { printInt (return 42); putStrLn \"done\" }") [] "42\ndone\n") ((:) (rejects "import shadowing does not allow duplicate local methods" (H.append "class Keep a where { return : a -> a }; class Other a where { return : a -> a }; " "do { putStrLn \"one\"; putStrLn \"two\" }") Inference "duplicate class method") ((:) (hasType "local Monad declaration shadows the imported class" "class Monad a where { tag : a -> Bool }; instance Monad Int where { tag = \\x -> true }; tag 42" bool) ((:) (runs "local Monad cannot hide canonical IO do instance" (H.append explicitMonad "do { putStrLn \"one\"; putStrLn \"two\" }") [] "one\ntwo\n") ((:) (rejects "custom Monad instance cannot satisfy canonical do" (H.append explicitMonad "data Box a = Box a; instance Monad Box where { return = Box; bind value next = case value of { Box x -> next x } }; do { x <- Box 42; Box x }") Resolution "no instance or given constraint") ((:) (rejects "duplicate imported instance" "instance Monad IO where { (>>=) = ioBind }; true" Inference "overlapping instances") ((:) (rejects "user instance is still checked" (H.append maybeDecl "instance Functor Maybe where { fmap = \\f x -> true }; true") Inference "type constructor mismatch") ((:) (rejects "missing user instance" (H.append maybeDecl "return 42 :: Maybe Int") Resolution "no instance or given constraint") ((:) (rejects "no implicit monad defaulting" "return 42" Resolution "ambiguous uses need a type annotation") ((:) ((,) "prelude: every compiler API imports the prelude" (let { source = "do { putStrLn \"one\"; putStrLn \"two\" }" } in do { textResult <- (checked source); do { ast <- (H.right (parseExpr "<prelude AST>" source)); do { astResult <- (H.right (compileExpr ast)); do { program <- (H.right (parseProgram "<prelude program>" source)); do { programResult <- (H.right (compileProgram program)); ((H.forM_ ((:) astResult ((:) programResult []))) (\result -> (H.assert (H.eq (compiledTerm result) (compiledTerm textResult)) "compiler entry points disagree"))) } } } } })) ((:) ((,) "prelude: every compiler API supports explicit opt-out" (let { source = "ioReturn 42" } in do { textResult <- (H.right (compileWithPrelude NoImplicitPrelude "<no prelude>" source)); do { ast <- (H.right (parseExpr "<no prelude AST>" source)); do { astResult <- (H.right (compileExprWithPrelude NoImplicitPrelude ast)); do { program <- (H.right (parseProgram "<no prelude program>" source)); do { programResult <- (H.right (compileProgramWithPrelude NoImplicitPrelude program)); ((H.forM_ ((:) textResult ((:) astResult ((:) programResult [])))) (\result -> do { (H.assert (T.alphaEq (inferredType result) (XCon "IO" ((:) int []))) "opt-out lost primitive IO defaults"); (H.assert (H.eq (compiledTerm result) (compiledTerm textResult)) "opt-out entry points disagree") })) } } } } })) ((:) ((,) "prelude: opt-out removes implicit class declarations" (case (compileWithPrelude NoImplicitPrelude "<no prelude class>" (H.append maybeDecl "instance Monad Maybe where { (>>=) x f = x }; Just 42")) of { (Left err) -> (H.assert ((H.eq (phase err) Inference) && (H.contains "unknown class: Monad" (diagnostic err))) (H.show err)); (Right _) -> (H.fail "Monad was imported despite opt-out") })) []))))))))))))))))))))) (S.concatMap (\((,) label source) -> ((:) ((,) (H.append "prelude: unused imports preserve " label) do { ordinary <- (checked source); do { explicit <- (H.right (compileWithPrelude NoImplicitPrelude "<unused prelude>" source)); do { (H.assert (H.eq (compiledTerm ordinary) (compiledTerm explicit)) "unused prelude changed xMLF"); (H.assert (H.eq (presolution ordinary) (presolution explicit)) "unused prelude changed the graph") } } }) [])) ((:) ((,) "pure programs" "let id = \\x -> x in id 42") ((:) ((,) "lambda shadowing" "(\\return -> return 42) (\\x -> x)") ((:) ((,) "pattern shadowing" "data Box a = Box a; case Box 42 of { Box return -> return }") ((:) ((,) "ordinary bind shadowing in do-let" "do { let bind = \\x f -> f x; let return = \\x -> x; bind 42 return }") ((:) ((,) "ordinary bind continuation shadows return" "let bind = \\x f -> f x in bind (\\x -> x) (\\return -> return 42)") ((:) ((,) "single-expression do" "do { 42 }") ((:) ((,) "unrelated class method" "class Keep a where { return : a -> a }; instance Keep Int where { return = \\x -> x }; return 42") []))))))))))))))
