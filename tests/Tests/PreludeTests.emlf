module Tests.PreludeTests where
import Bootstrap.Types
import qualified Bootstrap.Std as S
import qualified Package.OS as OS
import qualified Tests.Helpers as H
import Tests.Helpers (Quint(..), Sext(..))
import Tests.Backends
import qualified Tests.Backends as B
import Bootstrap.Compiler
import Bootstrap.Parser (parseExpr, parseProgram)
import qualified Bootstrap.X.Check as C
import qualified Bootstrap.X.Parser as XP
import Bootstrap.X.Pretty (prettyTerm)
import qualified Bootstrap.X.Syntax as X
import qualified Bootstrap.X.Type as T

checked : String -> IO Compilation
checked source = do { result <- (H.right (compile "<prelude>" source)); do { parsed <- (H.right (XP.parseTerm "<prelude xMLF>" (prettyTerm (compiledTerm result)))); do { ty <- (H.right (C.checkClosed parsed)); do { (H.assert (T.alphaEq ty (inferredType result)) "prelude xMLF changed type"); do { (H.assert (H.eq (X.erase parsed) (X.erase (compiledTerm result))) "prelude xMLF changed erasure"); (return result) } } } } }

hasType : String -> String -> XType -> Pair String (IO Unit)
hasType label source ty = (Pair (H.append "prelude: " label) do { result <- (checked source); (H.assert (T.alphaEq ty (inferredType result)) (sourceType result)) })

rejects : String -> String -> Phase -> String -> Pair String (IO Unit)
rejects label source expectedPhase reason = (Pair (H.append "prelude rejection: " label) (case (compile "<invalid prelude use>" source) of { (Left err) -> (H.assert ((H.eq (phase err) expectedPhase) && (H.contains reason (diagnostic err))) (H.show err)); (Right result) -> (H.fail (H.append "unexpected acceptance: " (sourceType result))) }))

runsOn : B.Backends -> String -> String -> (List ( String )) -> String -> Pair String (IO Unit)
runsOn backends label source inputs expected = (Pair (H.append "prelude runtime: " label) do { result <- (checked source); do { term <- (H.right (XP.parseTerm "<prelude runtime>" (prettyTerm (compiledTerm result)))); do { (Pair outcome trace) <- (B.capture backends term inputs); do { (H.right outcome); (let { actual = (H.concat (S.concatMap (\comprehension1 -> case comprehension1 of { (Write text) -> (Cons text Nil); _ -> Nil }) trace)) } in (H.assert (H.eq actual expected) (H.show actual))) } } } })

int : XType
int = (XCon "Int" Nil)

bool : XType
bool = (XCon "Bool" Nil)

maybeDecl : String
maybeDecl = "data Maybe a = Nothing | Just a; "

maybeInstance : String
maybeInstance = (H.append "instance Monad Maybe where { return = Just; " "bind = \\value next -> case value of { Nothing -> Nothing; Just x -> next x } }; ")

twice : String
twice = (H.append "let twice : forall (m : * -> *) a. Monad m => m a -> m a = " "\\action -> do { action; value <- action; return value } in ")

explicitMonad : String
explicitMonad = (H.append "class Monad (m : * -> *) where { return : forall a. a -> m a; " "bind : forall a b. m a -> (a -> m b) -> m b }; ")

preludeTests : B.Backends -> (List ( Pair String (IO Unit) ))
preludeTests backends = (let { runs = (runsOn backends) } in (H.append (Cons (runs "IO sequencing without declarations" "do { putStr \"Name: \"; line <- getLine; putStrLn line }" (Cons "Ada" Nil) "Name: Ada\n") (Cons (runs "qualified generic IO function" (H.append twice "twice (putStrLn \"again\")") Nil "again\nagain\n") (Cons (runs "one generic function at IO and a user instance" (H.append maybeDecl (H.append maybeInstance (H.append twice "do { twice (putStrLn \"twice\"); case twice (Just 42) of { Nothing -> printInt 0; Just n -> printInt n } }"))) Nil "twice\ntwice\n42\n") (Cons (hasType "user Monad instance needs no class declaration" (H.append maybeDecl (H.append maybeInstance "do { x <- Just 42; return x }")) (XCon "Maybe" (Cons int Nil))) (Cons (hasType "inferred constraints use the imported methods" (H.append maybeDecl (H.append maybeInstance "let roundTrip = \\value -> bind value return in roundTrip (Just 42)")) (XCon "Maybe" (Cons int Nil))) (Cons (hasType "qualified annotation alone imports the class" "let identityM : forall (m : * -> *) a. Monad m => m a -> m a = \\x -> x in identityM (ioReturn 42)" (XCon "IO" (Cons int Nil))) (Cons (hasType "superclass alone imports Monad" "class Monad m => Marker (m : * -> *) where { mark : forall a. m a -> m a }; true" bool) (Cons (hasType "instance context alone imports Monad" (H.append "data Wrapped (m : * -> *) a = Wrapped (m a); " (H.append "class Tag (m : * -> *) where { tag : forall a. m a -> Bool }; " "instance forall (m : * -> *). Monad m => Tag (Wrapped m) where { tag = \\x -> true }; true")) bool) (Cons (runs "prelude implementation uses primitive identities" (H.append "class Hijack a where { ioReturn : a -> IO a }; " (H.append "instance Hijack Int where { ioReturn = \\x -> do { printInt 0; pure x } }; " "do { x <- return 42; printInt x }")) Nil "42\n") (Cons (runs "given dictionary and lexical shadowing coexist" (H.append twice "let return = \\x -> x in do { twice (putStrLn \"ok\"); printInt (return 42) }") Nil "ok\nok\n42\n") (Cons (runs "local class method shadows only the imported method" (H.append "class Keep a where { return : a -> a }; instance Keep Int where { return = \\x -> x }; " "do { printInt (return 42); putStrLn \"done\" }") Nil "42\ndone\n") (Cons (rejects "import shadowing does not allow duplicate local methods" (H.append "class Keep a where { return : a -> a }; class Other a where { return : a -> a }; " "do { putStrLn \"one\"; putStrLn \"two\" }") Inference "duplicate class method") (Cons (hasType "local Monad declaration shadows the imported class" "class Monad a where { tag : a -> Bool }; instance Monad Int where { tag = \\x -> true }; tag 42" bool) (Cons (rejects "local Monad also hides imported IO instance" (H.append explicitMonad "do { putStrLn \"one\"; putStrLn \"two\" }") Resolution "no instance or given constraint") (Cons (rejects "duplicate imported instance" "instance Monad IO where { return = ioReturn; bind = ioBind }; true" Inference "overlapping instances") (Cons (rejects "user instance is still checked" (H.append maybeDecl "instance Monad Maybe where { return = \\x -> true; bind = \\x f -> x }; true") Inference "type constructor mismatch") (Cons (rejects "missing user instance" (H.append maybeDecl "return 42 : Maybe Int") Resolution "no instance or given constraint") (Cons (rejects "no implicit monad defaulting" "return 42" Resolution "ambiguous uses need a type annotation") (Cons (Pair "prelude: every compiler API imports the prelude" (let { source = "do { putStrLn \"one\"; putStrLn \"two\" }" } in do { textResult <- (checked source); do { ast <- (H.right (parseExpr "<prelude AST>" source)); do { astResult <- (H.right (compileExpr ast)); do { program <- (H.right (parseProgram "<prelude program>" source)); do { programResult <- (H.right (compileProgram program)); ((H.forM_ (Cons astResult (Cons programResult Nil))) (\result -> (H.assert (H.eq (compiledTerm result) (compiledTerm textResult)) "compiler entry points disagree"))) } } } } })) (Cons (Pair "prelude: every compiler API supports explicit opt-out" (let { source = "return 42" } in do { textResult <- (H.right (compileWithPrelude NoImplicitPrelude "<no prelude>" source)); do { ast <- (H.right (parseExpr "<no prelude AST>" source)); do { astResult <- (H.right (compileExprWithPrelude NoImplicitPrelude ast)); do { program <- (H.right (parseProgram "<no prelude program>" source)); do { programResult <- (H.right (compileProgramWithPrelude NoImplicitPrelude program)); ((H.forM_ (Cons textResult (Cons astResult (Cons programResult Nil)))) (\result -> do { (H.assert (T.alphaEq (inferredType result) (XCon "IO" (Cons int Nil))) "opt-out lost primitive IO defaults"); (H.assert (H.eq (compiledTerm result) (compiledTerm textResult)) "opt-out entry points disagree") })) } } } } })) (Cons (Pair "prelude: opt-out removes implicit class declarations" (case (compileWithPrelude NoImplicitPrelude "<no prelude class>" (H.append maybeDecl (H.append maybeInstance "Just 42"))) of { (Left err) -> (H.assert ((H.eq (phase err) Inference) && (H.contains "unknown class: Monad" (diagnostic err))) (H.show err)); (Right _) -> (H.fail "Monad was imported despite opt-out") })) Nil))))))))))))))))))))) (S.concatMap (\(Pair label source) -> (Cons (Pair (H.append "prelude: unused imports preserve " label) do { ordinary <- (checked source); do { explicit <- (H.right (compileWithPrelude NoImplicitPrelude "<unused prelude>" source)); do { (H.assert (H.eq (compiledTerm ordinary) (compiledTerm explicit)) "unused prelude changed xMLF"); (H.assert (H.eq (presolution ordinary) (presolution explicit)) "unused prelude changed the graph") } } }) Nil)) (Cons (Pair "pure programs" "let id = \\x -> x in id 42") (Cons (Pair "lambda shadowing" "(\\return -> return 42) (\\x -> x)") (Cons (Pair "pattern shadowing" "data Box a = Box a; case Box 42 of { Box return -> return }") (Cons (Pair "do-let shadowing" "do { let bind = \\x f -> f x; let return = \\x -> x; n <- 42; return n }") (Cons (Pair "do-pattern shadowing" "let bind = \\x f -> f x in do { return <- (\\x -> x); return 42 }") (Cons (Pair "single-expression do" "do { 42 }") (Cons (Pair "unrelated class method" "class Keep a where { return : a -> a }; instance Keep Int where { return = \\x -> x }; return 42") Nil))))))))))
