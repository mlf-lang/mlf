module Tests.ReleaseSuite where
import Bootstrap.Types
import qualified Tests.Coverage as Coverage
import qualified Bootstrap.Std as S
import qualified Package.Json as J
import qualified Package.OS as O
import qualified Package.Verification as V
import qualified Tests.Basic as H
replaceHead : (J.Json -> J.Json) -> J.Json -> J.Json
replaceHead f array = J.Array (case J.values array of { [] -> []; (:) x xs -> (:) (f x) xs })
set : String -> J.Json -> J.Json -> J.Json
set key value = J.set key value
path : String -> (J.Json -> J.Json) -> J.Json -> J.Json
path keys f = V.update (O.words keys) f
validate : J.Json -> J.Json -> Either String ()
validate evidence manifest = V.validateEvidence (J.get "bootstrap" evidence) (J.get "backends" evidence) (J.get "benchmarks" evidence) "compiler-hash" manifest
reject : J.Json -> J.Json -> IO ()
reject evidence manifest = H.assert (S.isLeft (validate evidence manifest)) "damaged release evidence accepted"
fixture : String -> J.Json -> J.Json -> IO J.Json
fixture directory evidence manifest = do
 let package = directory ++ "/package"
 O.mkdir (package ++ "/evidence")
 O.mkdir (package ++ "/runtime")
 S.mapM_ (\name -> do { writeFile (package ++ "/" ++ name) "test executable\n"; O.run "" ((:) "/bin/chmod" ((:) "+x" ((:) (package ++ "/" ++ name) []))) }) (O.words "emlf emlf-compile")
 hash <- fileDigest (package ++ "/emlf")
 writeFile (package ++ "/runtime/mlf_runtime.c") "runtime\n"
 let changed = O.replace "compiler-hash" hash (J.render evidence)
 evidence <- H.right (J.parse changed)
 S.mapM_ (\name -> J.write (package ++ "/evidence/" ++ name ++ ".json") (J.get name evidence)) (O.words "bootstrap backends benchmarks")
 J.write (package ++ "/evidence/manifest.json") manifest
 files <- V.packageFiles package
 host <- V.hostIdentity directory
 writeFile (package ++ "/evidence/mlf-tests.log") "Tests passed\n"
 logHash <- fileDigest (package ++ "/evidence/mlf-tests.log")
 runtimeHash <- fileDigest (package ++ "/runtime/mlf_runtime.c")
 bootstrap <- J.read (package ++ "/evidence/bootstrap.json")
 J.write (package ++ "/evidence/bootstrap.json") (J.set "runtime_sources" (J.Object ((:) ((,) "runtime/mlf_runtime.c" (J.str runtimeHash)) [])) bootstrap)
 files <- V.packageFiles package
 let steps = J.Array (S.map (\name -> J.Object ((:) ((,) "name" (J.str name)) ((:) ((,) "exit_code" (J.num 0)) ((:) ((,) "log_sha256" (J.str logHash)) [])))) (O.words "mlf-tests bootstrap backends benchmarks"))
 let report = J.Object ((:) ((,) "schema_version" (J.num 1)) ((:) ((,) "complete" (J.Boolean true)) ((:) ((,) "compiler_sha256" (J.str hash)) ((:) ((,) "host" host) ((:) ((,) "smoke" (J.Object ((:) ((,) "backends" (J.stringArray (O.words "interpreter llvm"))) ((:) ((,) "outside_checkout" (J.Boolean true)) [])))) ((:) ((,) "steps" steps) ((:) ((,) "package_files" files) [])))))))
 J.write (directory ++ "/verification.json") report
 return report
main : IO ()
main = do
 evidence <- J.read "tests/golden/release-evidence.json"
 manifest <- J.read "benchmarks/manifest.json"
 evidenceChecks evidence manifest
 stepChecks
 installationChecks evidence manifest

evidenceChecks : J.Json -> J.Json -> IO ()
evidenceChecks evidence manifest = do
 H.right (validate evidence manifest)
 Coverage.passed "harness" "test_complete_stage3_evidence_passes"
 putStrLn "PASS test_complete_stage3_evidence_passes"
 reject (path "bootstrap parity compiler" (\_ -> J.str "/verified/emlf-stage2") evidence) manifest
 Coverage.passed "harness" "test_stage2_parity_cannot_certify_stage3"
 putStrLn "PASS test_stage2_parity_cannot_certify_stage3"
 S.mapM_ (\mutation -> reject (mutation evidence) manifest)
  ((:) (path "bootstrap fixed_point" (\_ -> J.Boolean false))
  ((:) (path "bootstrap stages" (\xs -> J.Array (S.init (J.values xs))))
  ((:) (path "bootstrap stages" (replaceHead (set "reused_seed_compilation" (J.Boolean true))))
  ((:) (path "bootstrap stages" (\xs -> J.Array (S.map (\row -> if V.int "stage" row == 2 then set "llvm_sha256" (J.str "different") row else row) (J.values xs))))
  ((:) (path "bootstrap candidate stage" (\_ -> J.num 2)) [])))))
 Coverage.passed "harness" "test_fixed_point_and_fresh_stages_are_required"
 putStrLn "PASS test_fixed_point_and_fresh_stages_are_required"
 S.mapM_ (\mutation -> reject (mutation evidence) manifest)
  ((:) (path "backends matrices" (V.remove "compact-gc"))
  ((:) (path "backends matrices compact-gc backends" (\_ -> J.num 1))
  ((:) (path "backends matrices compact-gc rows" (\_ -> J.num 0))
  ((:) (path "backends matrices compact-gc cli_compiler" (\_ -> J.str "seed"))
  ((:) (path "backends matrices compact-gc environment MLF_LLVM_TEST_ABI" (\_ -> J.str "standard")) [])))))
 reject (path "backends matrices standard" (\_ -> J.empty) evidence) manifest
 Coverage.passed "harness" "test_compact_matrix_and_both_backends_are_required"
 putStrLn "PASS test_compact_matrix_and_both_backends_are_required"
 let first = path "benchmarks results"
 let entry = \keys f -> first (replaceHead (path keys f))
 S.mapM_ (\mutation -> reject (mutation evidence) manifest)
  ((:) (first (\xs -> J.Array (S.init (J.values xs))))
  ((:) (first (\xs -> J.Array ((:) (S.index (J.values xs) 1) (S.tail (J.values xs)))))
  ((:) (path "benchmarks performance_checks" (\xs -> J.Array (S.init (J.values xs))))
  ((:) (entry "languages" (V.remove "rust"))
  ((:) (entry "languages mlf compilation samples" (\_ -> J.Array []))
  ((:) (entry "languages mlf correctness" (\_ -> J.Array []))
  ((:) (entry "languages mlf correctness" (replaceHead (\_ -> J.empty)))
  ((:) (path "benchmarks configuration size_override" (\_ -> J.num 1))
  ((:) (entry "input" (\_ -> J.num 1))
  ((:) (path "benchmarks configuration runtime_only" (\_ -> J.Boolean true))
  ((:) (path "benchmarks toolchain emlf sha256" (\_ -> J.str "seed")) [])))))))))))
 reject (first (\xs -> J.Array (S.filter (\row -> S.not (eqString (V.text "benchmark" row) "regex-redux")) (J.values xs))) evidence) manifest
 reject (path "benchmarks performance_checks" (\xs -> J.Array (S.filter (\row -> S.not (eqString (V.text "benchmark" row) "regex-redux")) (J.values xs))) evidence) manifest
 Coverage.passed "harness" "test_benchmark_coverage_and_samples_cannot_be_faked_by_pass_status"
 putStrLn "PASS test_benchmark_coverage_and_samples_cannot_be_faked_by_pass_status"
 let samples n = J.Array (S.replicate 5 (J.Object ((:) ((,) "wall_seconds" n) [])))
 reject (entry "languages mlf compilation" (\row -> set "median_wall_seconds" (J.num 6) (set "samples" (samples (J.num 6)) row)) evidence) manifest
 Coverage.passed "harness" "test_ratios_are_recomputed_from_measurements"
 putStrLn "PASS test_ratios_are_recomputed_from_measurements"
 S.mapM_ (\value -> reject (entry "languages c compilation samples" (\_ -> samples value) evidence) manifest) ((:) (J.num 6) ((:) (J.num 0) ((:) (J.num (-1)) ((:) (J.Number "NaN") ((:) (J.Number "Infinity") [])))))
 Coverage.passed "harness" "test_medians_are_recomputed_and_bad_samples_fail"
 putStrLn "PASS test_medians_are_recomputed_and_bad_samples_fail"

stepChecks : IO ()
stepChecks = do
 H.withScratch (\directory -> do
  let report = J.Object ((:) ((,) "complete" (J.Boolean false)) ((:) ((,) "steps" (J.Array [])) []))
  failed <- V.step directory report "failure" (S.append (O.words "/bin/sh -c") ((:) "exit 9" []))
  H.assert (S.isLeft failed) "failed release step succeeded"
  saved <- J.read (directory ++ "/verification.json")
  log <- fileExists (directory ++ "/failure.log")
  H.assert (S.not (J.getBool "complete" true saved) && V.int "exit_code" (S.head (V.array "steps" saved)) == 9 && log) "failed step lost its evidence")
 Coverage.passed "harness" "test_failed_step_preserves_failure_and_never_completes_release"
 putStrLn "PASS test_failed_step_preserves_failure_and_never_completes_release"
 H.withScratch (\directory -> do
  let names = O.words "MLF_BOOTSTRAP_COMPILER MLF_LLVM_TEST_ABI MLF_TEST_FAIL_WRITE GC_INITIAL_HEAP_SIZE MLF_TEST_UNKNOWN_OVERRIDE"
  prior <- S.mapM (\name -> do { value <- getEnv name; setEnv name "wrong"; return ((,) name value) }) names
  exe <- getExecutablePath
  passed <- V.step directory (J.Object ((:) ((,) "complete" (J.Boolean false)) ((:) ((,) "steps" (J.Array [])) []))) "environment" ((:) exe ((:) "--check-clean-environment" names))
  H.assert (S.isRight passed) "release gate inherited compiler or collector override"
  S.mapM_ (\((,) name value) -> if eqString value "" then unsetEnv name else setEnv name value) prior)
 Coverage.passed "harness" "test_gate_does_not_inherit_compiler_or_collector_overrides"
 putStrLn "PASS test_gate_does_not_inherit_compiler_or_collector_overrides"

installationChecks : J.Json -> J.Json -> IO ()
installationChecks evidence manifest = do
 H.withScratch (\directory -> do
  report <- fixture directory evidence manifest
  checked <- V.verify directory
  H.right checked
  J.write (directory ++ "/verification.json") (set "complete" (J.Boolean false) report)
  incomplete <- V.verify directory
  H.assert (S.isLeft incomplete) "incomplete release installable"
  J.write (directory ++ "/verification.json") report
  writeFile (directory ++ "/package/runtime/mlf_runtime.c") "changed"
  invalid <- V.installWithSmoke directory (directory ++ "/prefix") (\_ -> return ())
  present <- directoryExists (directory ++ "/prefix")
  H.assert (S.isLeft invalid && S.not present) "changed release was installed")
 Coverage.passed "harness" "test_incomplete_or_changed_packages_are_not_installable"
 putStrLn "PASS test_incomplete_or_changed_packages_are_not_installable"
 H.withScratch (\directory -> do
  fixture directory evidence manifest
  let prefix = directory ++ "/prefix with spaces"
  count <- newIntArray 1 0
  let smoke = \_ -> do { n <- readIntArray count 0; writeIntArray count 0 (n + 1) }
  first <- V.installWithSmoke directory prefix smoke
  H.right first
  n <- readIntArray count 0
  H.assert (n == 1) "installation smoke was skipped or repeated"
  second <- V.installWithSmoke directory prefix smoke
  H.right second
  a <- canonicalPath (prefix ++ "/bin/emlf")
  b <- canonicalPath (prefix ++ "/bin/emlf-compile")
  H.assert (eqString (O.parent a) (O.parent b)) "installed commands target different packages"
  let moved = directory ++ "/relocated"
  O.move prefix moved
  present <- fileExists (moved ++ "/bin/emlf")
  H.assert present "installation is not relocatable"
  H.removeFile (moved ++ "/bin/emlf")
  writeFile (moved ++ "/bin/emlf") "other compiler"
  rejected <- V.installWithSmoke directory moved smoke
  original <- readFile (moved ++ "/bin/emlf")
  H.assert (S.isLeft rejected && eqString original "other compiler") "unrelated installed command overwritten")
 Coverage.passed "harness" "test_installation_is_relocatable_and_does_not_replace_unrelated_files"
 putStrLn "PASS test_installation_is_relocatable_and_does_not_replace_unrelated_files"
