module HarnessMain where
import Bootstrap.Types
import qualified Bootstrap.Std as S
import qualified Package.OS as O
import qualified Tests.Basic as H
import qualified Tests.BootstrapSuite as Boot
import qualified Tests.ReleaseSuite as Release
import qualified Tests.BenchmarkSuite as Bench
waitFor : String -> Int -> IO Unit
waitFor path attempts = do
 present <- fileExists path
 if present then return Unit else if attempts == 0 then H.fail "independent phases did not overlap" else do
  O.run "" (O.words "/bin/sleep 0.01")
  waitFor path (attempts - 1)
mockCompiler args = do
 failure <- getEnv "MLF_MOCK_FAIL"
 if eqString failure "1" then exitWith 9 else do
  calls <- getEnv "MLF_MOCK_CALLS"
  prior <- readFile calls
  writeFile calls (prior ++ S.intercalate " " args ++ "\n")
  case args of
   Cons "--help" Nil -> putStrLn "Usage: emlf [--type] [FILE | --expr SOURCE]"
   Cons "--llvm-runtime" Nil -> do { runtime <- getEnv "MLF_MOCK_RUNTIME"; putStrLn runtime }
   _ -> exitWith 9
outputPath args = case S.dropWhile (\arg -> S.not (eqString arg "-o")) args of
 Cons _ (Cons path _) -> path
 _ -> panic "mock tool missing output argument"
mockBuild args = if S.elem eqString "--emit-llvm" args || S.elem eqString "--module-to-llvm" args then do
 writeFile "frontend.started" ""
 waitFor "runtime.started" 300
 O.run "" (O.words "/bin/sleep 0.1")
 putStrLn "IR"
 else if S.elem eqString "-c" args then do
  present <- fileExists "cache.o"
  H.assert (S.not present) "runtime output directory reused"
  writeFile "cache.o" ""
  writeFile "runtime.started" ""
  waitFor "frontend.started" 300
  writeFile (outputPath args) "object"
  else do
   object <- readFile "runtime.o"
   ir <- readFile "program.ll"
   H.assert (eqString object "object" && eqString (O.trim ir) "IR") "link started before independent phases completed"
   writeFile (outputPath args) "binary"
main : IO Unit
main = do
 args <- O.allArguments
 mock <- getEnv "MLF_MOCK_COMPILER"
 build <- getEnv "MLF_MOCK_BUILD"
 if eqString mock "1" then mockCompiler args else if eqString build "1" then mockBuild args else case args of
  Cons "--check-clean-environment" names -> do
   values <- S.mapM getEnv names
   H.assert (S.all (\value -> eqString value "") values) "gate inherited compiler or collector overrides"
  Nil -> do { Boot.main; Release.main; Bench.main; putStrLn "53 native benchmark/bootstrap/release harness tests passed" }
  _ -> exitWith 2
