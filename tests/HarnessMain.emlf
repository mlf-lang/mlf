module HarnessMain where
import Bootstrap.Types
import qualified Tests.Coverage as Coverage
import qualified Tests.Selection as Selection
import qualified Package.Json as J
import qualified Bootstrap.Std as S
import qualified Package.OS as O
import qualified Tests.Basic as H
import qualified Tests.BootstrapSuite as Boot
import qualified Tests.ReleaseSuite as Release
import qualified Tests.BenchmarkSuite as Bench
import qualified Tests.RegexRedux as RegexRedux
import qualified Tests.TestSourceCache as SourceCache
import qualified Tests.TestDriverCache as DriverCache
waitFor : String -> Int -> IO ()
waitFor path attempts = do
 present <- fileExists path
 if present then return () else if attempts == 0 then H.fail "independent phases did not overlap" else do
  O.run "" (O.words "/bin/sleep 0.01")
  waitFor path (attempts - 1)
mockCompiler args = do
 failure <- getEnv "MLF_MOCK_FAIL"
 if eqString failure "1" then exitWith 9 else do
  calls <- getEnv "MLF_MOCK_CALLS"
  prior <- readFile calls
  writeFile calls (prior ++ S.intercalate " " args ++ "\n")
  case args of
   (:) "--help" [] -> putStrLn "Usage: emlf [--type] [FILE | --expr SOURCE]"
   (:) "--llvm-runtime" [] -> do { runtime <- getEnv "MLF_MOCK_RUNTIME"; putStrLn runtime }
   _ -> exitWith 9
outputPath args = case S.dropWhile (\arg -> S.not (eqString arg "-o")) args of
 (:) _ ((:) path _) -> path
 _ -> panic "mock tool missing output argument"
mockBuild args = if S.any (\flag -> S.elem eqString flag args) (O.words "--emit-llvm --emit-llvm-gc --crate-to-llvm --crate-to-llvm-gc") then do
 writeFile "frontend.started" ""
 fast <- getEnv "MLF_MOCK_FAST_FRONTEND"
 streaming <- getEnv "MLF_BENCH_STREAM_LLVM"
 if eqString fast "1" then return () else do
  waitFor "runtime.started" 300
  if eqString streaming "1" then waitFor "llvm.launched" 300 else return ()
  linking <- getEnv "MLF_BENCH_STREAM_LINK"
  if eqString linking "1" then waitFor "link.launched" 300 else return ()
  O.run "" (O.words "/bin/sleep 0.1")
 putStrLn "IR"
 else if S.elem eqString "-c" args && S.any (O.ends "program.ll") args then do
  if S.elem eqString "--mlf-stream-ir" args then do
   writeFile "llvm.launched" ""
   fast <- getEnv "MLF_MOCK_FAST_FRONTEND"
   if eqString fast "1" then O.run "" (O.words "/bin/sleep 0.05") else return ()
   code <- O.exec "" (O.words "/bin/cat program.ll.pipe") "" "program.ll" "stream-read.err" 5
   H.assert (code == 0) "streaming LLVM archive failed"
   else return ()
  ir <- readFile "program.ll"
  H.assert (eqString (O.trim ir) "IR") "LLVM compilation started before emission completed"
  writeFile "llvm.started" ""
  writeFile (outputPath args) "code"
 else if S.elem eqString "-c" args then do
  present <- fileExists "cache.o"
  H.assert (S.not present) "runtime output directory reused"
  writeFile "cache.o" ""
  writeFile "runtime.started" ""
  failure <- getEnv "MLF_MOCK_FAIL_RUNTIME"
  if eqString failure "1" then exitWith 9 else return ()
  waitFor "frontend.started" 300
  waitFor "llvm.started" 300
  writeFile (outputPath args) "object"
  else do
   streaming <- getEnv "MLF_BENCH_STREAM_LINK"
   if eqString streaming "1" then do
    writeFile "link.launched" ""
    waitFor "program.o.ready" 300
    waitFor "runtime.o.ready" 300
    else return ()
   object <- readFile "runtime.o"
   code <- readFile "program.o"
   H.assert (eqString object "object" && eqString code "code") "link started before independent phases completed"
   writeFile (outputPath args) "binary"
-- The registry contains deferred original actions. Listing IDs does not load
-- fixture files, start tools, or execute any assertion.
caseIdentity label = "harness/" ++ O.replace "_" "-" (if O.starts "test_" label then O.drop 5 label else label)
families : J.Json -> J.Json -> [] ((,) String (IO ()))
families manifest evidence = S.concat
 ((:) ((:) ((,) "harness/matrix-evidence" Boot.matrixChecks)
  ((:) ((,) "harness/corpus-evidence" Boot.parityChecks) []))
 ((:) ((:) ((,) "harness/source-dependency-cache" (do { SourceCache.main; Coverage.passed "harness" "test_source_dependency_cache_controls" }))
  ((:) ((,) "harness/native-driver-cache" (do { DriverCache.main; Coverage.passed "harness" "test_checked_native_driver_cache" })) []))
 ((:) ((:) ((,) "harness/release-evidence" (Release.evidenceChecks evidence manifest))
  ((:) ((,) "harness/release-steps" Release.stepChecks)
  ((:) ((,) "harness/release-installation" (Release.installationChecks evidence manifest)) [])))
 ((:) (S.map (\((,) label action) -> (,) (caseIdentity label) action) (Bench.cases manifest))
 ((:) ((:) ((,) "harness/regex-redux-execution" RegexRedux.main) []) [])))))
manifestFamilies = O.words "harness/release-evidence harness/release-installation harness/all-workloads-have-complete-provenance-and-fixtures harness/dna-inputs-match-pinned-fasta-fixtures harness/vendored-adaptation-patches-reconstruct-build-sources harness/pin-tampering-fails"
releaseFamilies = O.words "harness/release-evidence harness/release-installation"
runFamilies : [] String -> IO ()
runFamilies args = do
 let available = S.map S.fst (families J.empty J.empty)
 if Selection.listing args then putStr (S.unlines available) else do
  (,) full selected <- case Selection.choose available args of
   Left error -> do { putErr (error ++ "\n"); exitWith 2 }
   Right value -> return value
  Coverage.begin "harness" full
  Selection.begin "harness" full selected
  manifest <- if S.any (\name -> S.elem eqString name manifestFamilies) selected then J.read "benchmarks/manifest.json" else return J.empty
  evidence <- if S.any (\name -> S.elem eqString name releaseFamilies) selected then J.read "tests/golden/release-evidence.json" else return J.empty
  S.mapM_ (\((,) name action) -> if S.elem eqString name selected then do
   action
   Selection.passed "harness" name
   if eqString name "harness/native-driver-cache" && S.elem eqString "harness/source-dependency-cache" selected then putStrLn "2 native cache regression checks passed" else return ()
   else return ()) (families manifest evidence)
  if full then putStrLn "Native benchmark/bootstrap/release harness tests passed" else putStrLn (showInt (S.length selected) ++ " harness families; 0 failures")
  Coverage.finish "harness"
  Selection.finish "harness"
main : IO ()
main = do
 args <- O.allArguments
 mock <- getEnv "MLF_MOCK_COMPILER"
 build <- getEnv "MLF_MOCK_BUILD"
 if eqString mock "1" then mockCompiler args else if eqString build "1" then mockBuild args else case args of
  (:) "--check-clean-environment" names -> do
   values <- S.mapM getEnv names
   H.assert (S.all (\value -> eqString value "") values) "gate inherited compiler or collector overrides"
  (:) "--driver-cache-case" ((:) compiler []) -> DriverCache.run compiler
  _ -> runFamilies args
