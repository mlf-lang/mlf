module PackagesMain where
import Bootstrap.Types
import qualified Package.OS as O
import qualified Tests.Packages as P
import qualified Tests.PackageResolver as R
import qualified Tests.PackageReleases as Releases
main : IO Unit
main = do
 args <- O.allArguments
 case args of
  Cons "--fail-command" Nil -> exitWith 17
  Cons "--package-gc-check" (Cons prefix (Cons binary Nil)) -> P.checkGC prefix binary
  Cons "--releases" Nil -> Releases.main
  Cons "release" _ -> Releases.githubFixture args
  Nil -> do { R.main; P.integration; Releases.main }
  _ -> O.fatal "invalid package test arguments"
