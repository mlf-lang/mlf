module Main where
import Bootstrap.Types
import qualified Async.Process as P
import qualified Async.Task as T

answer : T.Task Int
answer = T.bind (T.sleep 0) (\_ ->
  T.bind (T.spawn (T.pure 41)) (\fiber ->
    T.map (\value -> value + 1) (T.await fiber)))

main : IO ()
main = do
  processResult <- P.withProcessScope P.defaultOptions (\_ -> ioReturn (Right ()))
  case processResult of
    Left _ -> exitWith 1
    Right () -> do
      taskResult <- T.run T.defaultOptions answer
      case taskResult of
        T.Succeeded value -> if value == 42 then printInt value else exitWith 1
        T.Failed _ -> exitWith 1
        T.Cancelled _ -> exitWith 1
